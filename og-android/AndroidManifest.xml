<?xml version="1.0" encoding="utf-8"?>
<!--
    Пробная сборка на OpenGothic (docs/PROGRESS.md, 2026-10-21): отдельное приложение, не трогает
    основное. Игра читается прямо из папки игрока - как в основном приложении, targetSdk 28 и
    разрешение «Файлы» (tools/build-opengothic.sh задаёт TEMPEST_ANDROID_TARGET_SDK=28).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="Gothic II · проба"
        android:icon="@mipmap/gothic_icon"
        android:hasCode="true"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="Gothic2Notr" />
        </activity>
    </application>
</manifest>
