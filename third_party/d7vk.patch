+      DirtyDDrawSurfaceAndMipChain();
 
       d3d9::IDirect3DDevice9* d3d9Device = m_commonSurf->RefreshD3D9Device();
       if (unlikely(m_shadowSurf != nullptr && d3d9Device != nullptr)) {
@@ -1396,6 +1396,10 @@ namespace dxvk {
 
     Logger::debug(str::format("DDraw7Surface::UploadSurfaceData: Uploading nr. [[7-", m_surfCount, "]]"));
 
+    // Gothic II Mobile: cleared before reading, so a mip unlocked during the upload
+    // (or one that could not be read because the loader held it) dirties the chain again
+    m_commonSurf->UnDirtyDDrawSurface();
+
     // Cube maps will also get marked as textures, so need to be handled first
     if (unlikely(m_commonSurf->IsCubeMap())) {
       // In theory we won't know which faces have been generated,
@@ -1445,9 +1449,23 @@ namespace dxvk {
                                                              m_commonSurf->IsDXTFormat());
     }
 
-    m_commonSurf->UnDirtyDDrawSurface();
-
     return DD_OK;
   }
 
+  // Gothic II Mobile: textures are uploaded only when the top level is dirty, but games
+  // (Gothic II's resource loader thread) lock and unlock every mip level on its own surface.
+  // Mips written after the first upload never reached the GPU and stayed black, which is
+  // what distant objects sample. Propagate the dirty state up the mip chain instead.
+  void DDraw7Surface::DirtyDDrawSurfaceAndMipChain() {
+    m_commonSurf->DirtyDDrawSurface();
+
+    DDraw7Surface* surf = this;
+    while (surf->m_parentSurf != nullptr
+        && surf->m_commonSurf->IsTextureMip()
+        && surf->m_parentSurf->GetCommonSurface()->IsTextureOrCubeMap()) {
+      surf = surf->m_parentSurf;
+      surf->GetCommonSurface()->DirtyDDrawSurface();
+    }
+  }
+
 }
