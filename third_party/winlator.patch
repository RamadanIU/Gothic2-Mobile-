+    /**
+     * Gothic II Mobile: программы внутри rootfs собраны с путём {@link #ORIGINAL_PATH} (в том числе
+     * интерпретатор ELF и ld.so.cache). Наше приложение называется иначе, поэтому при распаковке
+     * этот путь заменяется строкой той же длины, ведущей в наш каталог: лишние «/» в пути
+     * ничего не меняют. Каталог rootfs — {@code <dataDir>/r}, чтобы путь поместился.
+     */
+    public static final String ORIGINAL_PATH = "/data/data/com.winlator/files/rootfs";
+    private static final String ROOT_DIR_NAME = "r";
+    private static volatile String relocatedPath;
+
     public static RootFS find(Context context) {
-        File legacyDir = new File(context.getFilesDir(), "imagefs");
-        File rootDir = new File(context.getFilesDir(), "rootfs");
-        if (legacyDir.isDirectory()) legacyDir.renameTo(rootDir);
+        File rootDir = new File(context.getDataDir(), ROOT_DIR_NAME);
+        relocatedPath = relocatedPath(context.getPackageName());
         return new RootFS(rootDir);
     }
 
+    /** Путь той же длины, что {@link #ORIGINAL_PATH}, ведущий в rootfs пакета {@code packageName}. */
+    public static String relocatedPath(String packageName) {
+        String head = "/data/data/" + packageName;
+        int pad = ORIGINAL_PATH.length() - head.length() - ROOT_DIR_NAME.length();
+        if (pad < 1) throw new IllegalStateException("Имя пакета слишком длинное для пути rootfs: " + packageName);
+        StringBuilder sb = new StringBuilder(head);
+        for (int i = 0; i < pad; i++) sb.append('/');
+        return sb.append(ROOT_DIR_NAME).toString();
+    }
+
+    /** Замена пути для распаковки, или null, если {@link #find} ещё не вызывался. */
+    public static String getRelocatedPath() {
+        return relocatedPath;
+    }
+
     public File getRootDir() {
         return rootDir;
     }
