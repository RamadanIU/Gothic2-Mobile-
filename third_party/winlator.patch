@@ -0,0 +1,36 @@
+package com.winlator.core;
+
+import com.winlator.R;
+
+import java.lang.reflect.Field;
+import java.util.HashMap;
+
+/**
+ * Gothic II Mobile: Winlator собирается как библиотека, а в библиотеке идентификаторы ресурсов
+ * не константы, и switch по R.id не компилируется. Такие switch переписаны на имена ресурсов
+ * вида "id/menu_item_exit"; здесь — обратное отображение идентификатора в имя.
+ */
+public final class ResNames {
+    private static final Class<?>[] TYPES = {R.id.class, R.string.class, R.layout.class, R.drawable.class, R.menu.class};
+    private static HashMap<Integer, String> names;
+
+    private ResNames() {}
+
+    public static synchronized String of(int id) {
+        if (names == null) {
+            names = new HashMap<>();
+            for (Class<?> type : TYPES) {
+                String prefix = type.getSimpleName() + "/";
+                for (Field field : type.getFields()) {
+                    if (field.getType() != int.class) continue;
+                    try {
+                        names.put(field.getInt(null), prefix + field.getName());
+                    }
+                    catch (IllegalAccessException ignored) {}
+                }
+            }
+        }
+        String name = names.get(id);
+        return name != null ? name : "";
+    }
+}
