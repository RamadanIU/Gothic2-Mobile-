+
+/**
+ * Gothic II Mobile: потоковая замена байтовой строки на строку той же длины (путь rootfs
+ * Winlator на путь нашего приложения, см. RootFS.ORIGINAL_PATH). Длина не меняется, поэтому
+ * смещения в ELF и прочих двоичных файлах остаются верными.
+ */
+public final class PathRelocator {
+    private final byte[] from;
+    private final byte[] to;
+
+    public PathRelocator(String from, String to) {
+        this.from = from.getBytes(StandardCharsets.UTF_8);
+        this.to = to.getBytes(StandardCharsets.UTF_8);
+        if (this.from.length != this.to.length || this.from.length == 0) {
+            throw new IllegalArgumentException("Строки замены должны быть одной ненулевой длины");
+        }
+    }
+
+    public String relocate(String value) {
+        return value == null ? null : value.replace(new String(from, StandardCharsets.UTF_8), new String(to, StandardCharsets.UTF_8));
+    }
+
+    /** Копирует поток, заменяя все вхождения; совпадения на границе блоков тоже находятся. */
+    public boolean copy(InputStream in, OutputStream out) {
+        final int keep = from.length - 1;
+        byte[] buf = new byte[StreamUtils.BUFFER_SIZE + keep];
+        int filled = 0;
+        try {
+            int n;
+            while ((n = in.read(buf, filled, buf.length - filled)) != -1) {
+                filled += n;
+                replaceAll(buf, filled);
+                // Хвост короче шаблона может быть началом совпадения — оставляем его до следующего чтения.
+                int flush = filled - keep;
+                if (flush > 0) {
+                    out.write(buf, 0, flush);
+                    System.arraycopy(buf, flush, buf, 0, keep);
+                    filled = keep;
+                }
+            }
+            out.write(buf, 0, filled);
+            return true;
+        }
+        catch (IOException e) {
+            return false;
+        }
+    }
+
+    private void replaceAll(byte[] buf, int length) {
+        int last = length - from.length;
+        outer:
+        for (int i = 0; i <= last; i++) {
+            if (buf[i] != from[0]) continue;
+            for (int j = 1; j < from.length; j++) {
+                if (buf[i + j] != from[j]) continue outer;
+            }
+            System.arraycopy(to, 0, buf, i, to.length);
+            i += from.length - 1;
+        }
+    }
+}
diff --git a/app/src/main/java/com/winlator/core/RemoteAssets.java b/app/src/main/java/com/winlator/core/RemoteAssets.java
new file mode 100644
index 0000000..54f1295
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/RemoteAssets.java
@@ -0,0 +1,171 @@
+package com.winlator.core;
+
+import android.content.Context;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileNotFoundException;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Gothic II Mobile: крупные архивы Winlator (*.tzst, ≈140 МБ) не кладутся в APK — иначе его не
+ * передать пользователю. Их список с размерами и SHA-256 лежит в assets/remote_assets.txt
+ * (создаётся при сборке из закреплённого коммита Winlator), а сами файлы скачиваются с GitHub
+ * того же коммита при первой надобности и проверяются по SHA-256.
+ */
+public final class RemoteAssets {
+    public static final String MANIFEST = "remote_assets.txt";
+    private static final String CACHE_DIR = "remote-assets";
+    private static final int ATTEMPTS = 3;
+    private static List<Entry> entries;
+    private static String baseUrl;
+
+    public interface Progress {
+        void onProgress(long done, long total);
+    }
+
+    public static final class Entry {
+        public final String path;
+        public final long size;
+        public final String sha256;
+
+        Entry(String path, long size, String sha256) {
+            this.path = path;
+            this.size = size;
+            this.sha256 = sha256;
+        }
+    }
+
+    private RemoteAssets() {}
+
+    /** Файл из APK, а если его там нет — из кэша загрузок (скачивается при необходимости). */
+    public static InputStream open(Context context, String path) throws IOException {
+        try {
+            return context.getAssets().open(path);
+        }
+        catch (FileNotFoundException e) {
+            Entry entry = find(context, path);
+            if (entry == null) throw e;
+            File file = ensure(context, entry, null);
+            return new BufferedInputStream(new FileInputStream(file), StreamUtils.BUFFER_SIZE);
+        }
+    }
+
+    public static synchronized List<Entry> entries(Context context) {
+        if (entries != null) return entries;
+        ArrayList<Entry> list = new ArrayList<>();
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(context.getAssets().open(MANIFEST), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                String[] parts = line.trim().split(" ");
+                if (parts.length == 2 && parts[0].equals("base")) baseUrl = parts[1];
+                else if (parts.length == 3) list.add(new Entry(parts[0], Long.parseLong(parts[1]), parts[2]));
+            }
+        }
+        catch (IOException | NumberFormatException e) {
+            list.clear();
+        }
+        entries = Collections.unmodifiableList(list);
+        return entries;
+    }
+
+    public static Entry find(Context context, String path) {
+        for (Entry entry : entries(context)) if (entry.path.equals(path)) return entry;
+        return null;
+    }
+
+    public static boolean isAvailable(Context context, Entry entry) {
+        File file = cacheFile(context, entry);
+        File marker = new File(file.getPath() + ".sha256");
+        return file.isFile() && file.length() == entry.size && marker.isFile() && entry.sha256.equals(FileUtils.readString(marker).trim());
+    }
+
+    /** Удалить скачанный файл, когда он больше не нужен (например, rootfs после установки). */
+    public static void evict(Context context, Entry entry) {
+        File file = cacheFile(context, entry);
+        FileUtils.delete(new File(file.getPath() + ".sha256"));
+        FileUtils.delete(file);
+    }
+
+    /** Скачать файл, если его ещё нет; возвращает путь к проверенному файлу. */
+    public static synchronized File ensure(Context context, Entry entry, Progress progress) throws IOException {
+        File file = cacheFile(context, entry);
+        if (isAvailable(context, entry)) return file;
+        if (baseUrl == null) throw new IOException("Нет адреса загрузки компонентов");
+
+        File parent = file.getParentFile();
+        if (parent != null && !parent.isDirectory() && !parent.mkdirs()) throw new IOException("Не удалось создать " + parent);
+        File part = new File(file.getPath() + ".part");
+        IOException last = null;
+        for (int attempt = 0; attempt < ATTEMPTS; attempt++) {
+            try {
+                download(baseUrl + entry.path, part, entry, progress);
+                FileUtils.delete(file);
+                if (!part.renameTo(file)) throw new IOException("Не удалось сохранить " + entry.path);
+                FileUtils.writeString(new File(file.getPath() + ".sha256"), entry.sha256);
+                return file;
+            }
+            catch (IOException e) {
+                last = e;
+                FileUtils.delete(part);
+            }
+        }
+        throw last;
+    }
+
+    private static void download(String url, File destination, Entry entry, Progress progress) throws IOException {
+        HttpURLConnection connection = (HttpURLConnection)(new URL(url)).openConnection();
+        connection.setConnectTimeout(20_000);
+        connection.setReadTimeout(60_000);
+        connection.setInstanceFollowRedirects(true);
+        try {
+            int code = connection.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) throw new IOException("HTTP " + code + " для " + entry.path);
+            MessageDigest digest;
+            try {
+                digest = MessageDigest.getInstance("SHA-256");
+            }
+            catch (NoSuchAlgorithmException e) {
+                throw new IOException(e);
+            }
+            long done = 0;
+            byte[] buffer = new byte[64 * 1024];
+            try (InputStream in = new BufferedInputStream(connection.getInputStream(), StreamUtils.BUFFER_SIZE);
+                 OutputStream out = new FileOutputStream(destination)) {
+                int n;
+                while ((n = in.read(buffer)) != -1) {
+                    if (done + n > entry.size) throw new IOException("Файл больше ожидаемого: " + entry.path);
+                    out.write(buffer, 0, n);
+                    digest.update(buffer, 0, n);
+                    done += n;
+                    if (progress != null) progress.onProgress(done, entry.size);
+                }
+            }
+            if (done != entry.size) throw new IOException("Загрузка прервалась: " + entry.path);
+            StringBuilder hex = new StringBuilder();
+            for (byte b : digest.digest()) hex.append(String.format("%02x", b));
+            if (!hex.toString().equals(entry.sha256)) throw new IOException("Контрольная сумма не совпала: " + entry.path);
+        }
+        finally {
+            connection.disconnect();
+        }
+    }
+
+    private static File cacheFile(Context context, Entry entry) {
+        return new File(new File(context.getFilesDir(), CACHE_DIR), entry.path);
+    }
+}
