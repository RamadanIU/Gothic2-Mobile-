+void TouchInput::loadLayout() {
+  // Строки: «scale 1.1», «alpha 0.8», «btn potion 12.5 -30 1.2» (сдвиг в dp, размер)
+  std::FILE* f = std::fopen("touch_layout.ini","r");
+  if(f==nullptr)
+    return;
+  char line[128] = {};
+  while(std::fgets(line,sizeof(line),f)!=nullptr) {
+    char  key[32] = {};
+    float a = 0, b = 0, k = 1;
+    if(std::sscanf(line,"scale %f",&a)==1)
+      layScale = std::clamp(a,0.6f,1.6f);
+    else if(std::sscanf(line,"alpha %f",&a)==1)
+      layAlpha = std::clamp(a,0.3f,1.f);
+    else if(std::sscanf(line,"btn %31s %f %f %f",key,&a,&b,&k)==4) {
+      for(uint8_t i=C_Main; i<C_Count; ++i) {
+        if(!isMovable(Ctl(i)) || std::strcmp(key,ctlKey(Ctl(i)))!=0)
+          continue;
+        place[i].dx    = std::clamp(a,-2000.f,2000.f);
+        place[i].dy    = std::clamp(b,-2000.f,2000.f);
+        place[i].scale = std::clamp(k,0.6f,1.8f);
+        }
+      }
+    }
+  std::fclose(f);
+  }
+
+void TouchInput::saveLayout() const {
+  // Во временный файл и замена одним шагом: оборванная запись не портит раскладку
+  std::FILE* f = std::fopen("touch_layout.ini.tmp","w");
+  if(f==nullptr) {
+    Tempest::Log::e("[g2m] touch layout: unable to save");
+    return;
+    }
+  std::fprintf(f,"scale %.3f\nalpha %.3f\n",double(layScale),double(layAlpha));
+  for(uint8_t i=C_Main; i<C_Count; ++i) {
+    const auto& pl = place[i];
+    if(!isMovable(Ctl(i)) || (pl.dx==0 && pl.dy==0 && pl.scale==1))
+      continue;
+    std::fprintf(f,"btn %s %.1f %.1f %.3f\n",ctlKey(Ctl(i)),double(pl.dx),double(pl.dy),double(pl.scale));
+    }
+  std::fclose(f);
+  std::rename("touch_layout.ini.tmp","touch_layout.ini");
+  }
+
+void TouchInput::openEditor() {
+  if(editOpen)
+    return;
+  // Пальцы отпускаются при смене экрана (paintEvent); вызов идёт из release - здесь их не трогать
+  if(wheel!=Wheel::None)
+    closeWheel();
+  // Посреди игры (просьба с экрана запуска) - сначала меню паузы: пока настраивают, мир стоит
+  if(owner.touchMode()==MainWindow::TouchMode::World && !mapOpen && !confirmOpen)
+    owner.touchMenu(KeyCodec::Escape);
+  editOpen   = true;
+  editSel    = C_None;
+  editFinger = -1;
+  update();
+  }
+
+void TouchInput::closeEditor() {
+  if(!editOpen)
+    return;
+  editOpen   = false;
+  editSel    = C_None;
+  editFinger = -1;
+  for(auto& f:fingers)
+    f = Finger();
+  saveLayout();
+  Gothic::inst().onPrint(toCp1251("Раскладка кнопок сохранена"));
+  update();
+  }
+
+Rect TouchInput::editPanel() const {
+  // Слева, где в игре только джойстик: справа и вверху - кнопки, их нужно видеть и двигать («Красться» - у
+  // самого края, панель правее)
+  const float d  = dp();
+  const int   x  = int(16*d + 100*d);
+  const int   pw = std::clamp(w()/2 - int(8*d) - x, int(260*d), std::min(int(400*d), w()-x-int(16*d)));
+  const int   ph = int(16*d + 24*d + 22*d + 3*(40*d + 8*d) + 8*d);
+  return Rect(x, (h()-ph)/2, pw, ph);
+  }
+
+Rect TouchInput::editButton(int k) const {
+  // Три ряда по две: «Меньше»/«Больше», «Прозрачнее»/«Ярче», «Сбросить»/«Готово»
+  const float d   = dp();
+  const auto  r   = editPanel();
+  const int   pad = int(12*d), gap = int(8*d), bh = int(40*d);
+  const int   bw  = (r.w-2*pad-gap)/2;
+  const int   y0  = r.y + int(16*d + 24*d + 22*d);
+  return Rect(r.x+pad+(k%2)*(bw+gap), y0+(k/2)*(bh+gap), bw, bh);
+  }
+
+TouchInput::Ctl TouchInput::editHit(Point p) const {
+  // Сверху - то, что нарисовано последним; запас - палец крупнее круга
+  const int slop = int(6*dp());
+  for(int i=int(C_Count)-1; i>=int(C_Main); --i) {
+    const Ctl c = Ctl(i);
+    if(!isMovable(c))
+      continue;
+    const auto b  = buttonOf(c);
+    const int  dx = p.x-b.c.x, dy = p.y-b.c.y, r = b.r+slop;
+    if(dx*dx+dy*dy<=r*r)
+      return c;
+    }
+  return C_None;
+  }
+
+void TouchInput::editDown(int id, Point p) {
+  if(editPanel().contains(p) || editFinger>=0)
+    return;
+  const Ctl c = editHit(p);
+  if(c==C_None)
+    return;
+  editSel    = c;
+  editFinger = id;
+  editGrab   = p-buttonOf(c).c;
+  }
+
+void TouchInput::editDrag(int id, Point p) {
+  if(id!=editFinger || editSel==C_None)
+    return;
+  // Новый центр - под пальцем; сдвиг хранится от места по умолчанию (с общим размером), в dp
+  const float d  = dp();
+  const auto  b  = buttonOf(editSel);
+  const auto  s  = scaledCenter(baseButtonOf(editSel));
+  const float r  = float(b.r);
+  const float cx = std::clamp(float(p.x-editGrab.x), r, std::max(r, float(w())-r));
+  const float cy = std::clamp(float(p.y-editGrab.y), r, std::max(r, float(h())-r));
+  place[editSel].dx = (cx-float(s.x))/d;
+  place[editSel].dy = (cy-float(s.y))/d;
+  }
+
+void TouchInput::editUp(int id, Point p, bool moved) {
+  if(id==editFinger) {
+    editFinger = -1;
+    return;
+    }
+  if(moved)
+    return;
+  if(editPanel().contains(p)) {
+    editTap(p);
+    return;
+    }
+  // Касание мимо кнопок - настраиваются все сразу
+  if(editHit(p)==C_None)
+    editSel = C_None;
+  }
+
+void TouchInput::editTap(Point p) {
+  int k = -1;
+  for(int i=0; i<6; ++i)
+    if(editButton(i).contains(p))
+      k = i;
+  switch(k) {
+    case 0:
+    case 1: {
+      const float f = (k==0 ? 1.f/1.1f : 1.1f);
+      if(editSel!=C_None)
+        place[editSel].scale = std::clamp(place[editSel].scale*f, 0.6f, 1.8f); else
+        layScale = std::clamp(layScale*f, 0.6f, 1.6f);
+      break;
+      }
+    case 2:
+      layAlpha = std::max(0.3f, layAlpha-0.1f);
+      break;
+    case 3:
+      layAlpha = std::min(1.f, layAlpha+0.1f);
+      break;
+    case 4:
+      if(editSel!=C_None) {
+        place[editSel] = Place();
+        } else {
+        place    = {};
+        layScale = 1;
+        layAlpha = 1;
+        }
+      break;
+    case 5:
+      closeEditor();
+      break;
+    default:
+      break;
+    }
+  }
+
+void TouchInput::drawEditor(Painter& p) {
+  const float d = dp();
+  p.setBrush(Color(0.f,0.f,0.f,0.45f));
+  p.drawRect(0,0,w(),h());
+
+  for(uint8_t i=C_Main; i<C_Count; ++i) {
+    const Ctl c = Ctl(i);
+    if(!isMovable(c))
+      continue;
+    const auto b   = buttonOf(c);
+    const bool sel = (c==editSel);
+    drawRound(p,b,ctlIcon(c),false,sel || editSel==C_None,1.f);
+    // Подпись - под кнопкой, у нижнего края - над ней
+    const int ly = b.c.y > h()*3/4 ? b.c.y-b.r-int(9*d) : b.c.y+b.r+int(9*d);
+    drawLabel(p,toCp1251(ctlName(c)),Point(b.c.x,ly),sel,0.7f);
+    }
+
+  const auto r = editPanel();
+  drawPanel(p,r);
+  const int pad = int(12*d);
+  drawText(p,fit(toCp1251("Кнопки: перетащи пальцем, коснись - выбрать"),r.w-2*pad,1.f),r.x+pad,r.y+int(10*d),true,1.f);
+  char buf[160] = {};
+  if(editSel!=C_None)
+    std::snprintf(buf,sizeof(buf),"«%s»: размер %d %%. Видимость %d %%",ctlName(editSel),
+                  int(std::lround(place[editSel].scale*100.f)),int(std::lround(layAlpha*100.f))); else
+    std::snprintf(buf,sizeof(buf),"Все кнопки: размер %d %%. Видимость %d %%",
+                  int(std::lround(layScale*100.f)),int(std::lround(layAlpha*100.f)));
+  drawText(p,fit(toCp1251(buf),r.w-2*pad,0.8f),r.x+pad,r.y+int(16*d+24*d),false,0.8f);
+
+  static const char* const names[6] = {"Меньше","Больше","Прозрачнее","Ярче","Сбросить","Готово"};
+  static const TouchIcons::Icon ic[6] = {TouchIcons::I_Down,TouchIcons::I_Up,TouchIcons::I_Left,
+                                         TouchIcons::I_Right,TouchIcons::I_Back,TouchIcons::I_Ok};
+  const float saved = paintAlpha;
+  paintAlpha = 1;
+  for(int i=0; i<6; ++i)
+    drawPill(p,editButton(i),ic[i],toCp1251(names[i]),false);
+  paintAlpha = saved;
   }
