+void GameScript::storyPrepare(Npc& player, Npc& npc) {
+  // Gothic II Mobile: общие темы безымянных жителей (стража, горожане, крестьяне: «Что нового?», «Как вступить в
+  // ополчение?», «Где найти…?») скрипты привязывают к жителю в начале ZS_Talk - то же, что делает ZS_Talk, без
+  // поворотов и анимаций: с жителем говорят через модель, ZS_Talk у него нет
+  if(int32_t(npc.guild())>=scriptConst("GIL_SEPERATOR_HUM",16))
+    return;
+  ScopeVar self (*vm.global_self(),  npc.handlePtr());
+  ScopeVar other(*vm.global_other(), player.handlePtr());
+  const Npc* prev = storyTalker;
+  storyTalker = &npc;
+  auto call = [&](std::string_view name) {
+    auto* fn = vm.find_symbol_by_name(name);
+    if(fn!=nullptr && fn->type()==zenkit::DaedalusDataType::FUNCTION)
+      vm.call_function<void>(fn,npc.handlePtr());
+    };
+  auto test = [&](std::string_view name) {
+    auto* fn = vm.find_symbol_by_name(name);
+    if(fn==nullptr || fn->type()!=zenkit::DaedalusDataType::FUNCTION)
+      return false;
+    return vm.call_function<int>(fn,npc.handlePtr())!=0;
+    };
+  const int32_t type = int32_t(npc.handle().type);
+  // Нет константы (другая версия скриптов) - нет и такого вида жителей
+  if(type==scriptConst("NPCTYPE_AMBIENT",0)       || type==scriptConst("NPCTYPE_OCAMBIENT",-100) ||
+     type==scriptConst("NPCTYPE_BL_AMBIENT",-100) || type==scriptConst("NPCTYPE_TAL_AMBIENT",-100)) {
+    call("B_ASSIGNAMBIENTINFOS");
+    if(test("C_NPCBELONGSTOCITY"))
+      call("B_ASSIGNCITYGUIDE");
+    }
+  const int32_t tough = scriptConst("AIV_TOUGHGUYNEWSOVERRIDE",-1);
+  if(test("C_NPCISTOUGHGUY") && (tough<0 || uint32_t(tough)>=zenkit::INpc::aivar_count ||
+                                 npc.handle().aivar[size_t(tough)]==0))
+    call("B_ASSIGNTOUGHGUYNEWS");
+  if(test("C_NPCHASAMBIENTNEWS"))
+    call("B_ASSIGNAMBIENTNEWS");
+  storyTalker = prev;
+  }
