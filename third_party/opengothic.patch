+      g.seg({0.43f,0.28f},{0.43f,0.44f},0.13f);
+      g.seg({0.56f,0.28f},{0.56f,0.44f},0.13f);
+      g.seg({0.69f,0.31f},{0.69f,0.44f},0.13f);
+      g.seg({0.37f,0.56f},{0.63f,0.56f},0.30f);
+      g.seg({0.5f,0.70f},{0.5f,0.88f},0.26f);
+      g.cut();
+      g.seg({0.365f,0.24f},{0.365f,0.45f},0.026f);
+      g.seg({0.495f,0.22f},{0.495f,0.45f},0.026f);
+      g.seg({0.625f,0.24f},{0.625f,0.45f},0.026f);
+      g.seg({0.22f,0.465f},{0.78f,0.465f},0.026f);
+      g.line({{0.21f,0.50f},{0.36f,0.60f},{0.60f,0.60f}},0.026f);
+      g.seg({0.30f,0.71f},{0.70f,0.71f},0.026f);
+      g.add();
+      break;
+    case TouchIcons::I_Bow:
+      g.arc({0.80f,0.5f},0.46f,122,238,0.075f);
+      g.seg({0.556f,0.11f},{0.556f,0.89f},0.022f);
+      g.seg({0.16f,0.5f},{0.80f,0.5f},0.035f);
