+Npc* AiNpc::addressee(const Npc& player, Npc* candidate) const {
+  if(!AiLink::enabled())
+    return nullptr;
+  // Выбранный касанием или тот, на кого смотрит герой: человек в сознании рядом - живой житель
+  if(candidate!=nullptr && candidate!=&player && !candidate->isMonster() && !candidate->isDead() &&
+     !candidate->isUnconscious() && player.qDistTo(*candidate)<SayDist*SayDist) {
+    if(candidate!=geralt || !talking)
+      return candidate;
+    }
+  // Мир сменился, а tick ещё не нашёл Геральта заново - указатель от прежнего мира
+  if(geralt==nullptr || geraltWorld!=Gothic::inst().world() || talking)
+    return nullptr;
+  if(geralt->isDead() || geralt->isUnconscious())
+    return nullptr;
+  return player.qDistTo(*geralt)<SayDist*SayDist ? geralt : nullptr;
+  }
+
+void AiNpc::heroSpeak(Npc& to) {
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr)
+    return;
+  // Слушает: стоящий без дела поворачивается к герою (на ходу, в бою и сидя - как есть)
+  Npc* pl = w->player();
+  if(to.isAiQueueEmpty() && !to.isAttack() && to.interactive()==nullptr && to.bodyStateMasked()==BS_STAND)
+    to.aiPush(AiQueue::aiTurnToNpc(pl));
+  to.aiPush(AiQueue::aiLookAtNpc(pl));
+  // free - без диалога: слова героя и ответ - субтитрами над миром; target - кому (self - Геральт)
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"ev","listen");
+  put(j,"free",1);
+  put(j,"target",&to==geralt ? std::string("self") : refOf(to));
+  put(j,"name",fromCp1251(to.displayName()));
+  j.EndObject();
+  AiLink::send(buf.GetString());
+  }
