+// Gothic II Mobile: напарники.
+// В диалоге с безымянным человеком (NPCTYPE_*AMBIENT) - «Пойдём со мной». Нанятый получает флаг
+// AIV_PARTYMEMBER и распорядок TA_Follow_Player на весь день, как напарники из скриптов игры:
+// ZS_Follow_Player сам дерётся с врагами, а опыт за убитых им ZS_Dead отдаёт герою.
+// Цена - 10 золотых за уровень, напарник называет её озвученной фразой ($GOLD_*).
+// Пока он напарник - не погибает (только теряет сознание), не обирает побеждённых, лечится своими
+// зельями, а на привале (ждёт или герой долго стоит) занят случайными делами.
+
+static const size_t MaxHired = 6;
+// Приказ «не нападать» хранится в свободной ячейке aivar (скрипты игры используют 0..80 и 88):
+// сохраняется и загружается вместе с NPC
+static const size_t AivStance = 95;
+// Смена мира: идущие с героем ближе этого переходят с ним, см
+static const float SquadCarryDist = 5000.f;
+// Герой столько стоит на месте - отряд отдыхает рядом с ним
+static const uint64_t HeroIdleDelay = 25000;
+
+// Занятия на привале - анимации бездействия из распорядков игры (TA_Smoke_Joint, TA_Stand_Eating, ...)
+enum IdleAct : uint8_t {
+  IdleNone = 0,
+  IdleArms,     // руки на груди, чешется, потягивается
+  IdleGuard,    // руки за спиной, оглядывается
+  IdleLook,     // осматривается, чешет затылок
+  IdleSmoke,
+  IdleEat,
+  IdleApple,    // подкидывает яблоко
+  IdleDrink,
+  IdleLute,
+  IdleSword,    // упражняется с оружием
+  IdleInspect,  // рассматривает оружие
+  IdleMagic,    // упражняется в магии (послушники и маги)
+  IdleSit,      // сидит на земле (ждущий - и у костра рядом)
+  IdleBench,    // садится на скамью или стул рядом
+  IdlePee,      // отходит в сторонку (только на отдыхе рядом с героем: из лагеря никуда не уходят)
+  IdleTalk,     // беседа двух напарников
+  IdleCount
+  };
+
+static bool isAmbient(const zenkit::INpc& h) {
+  switch(h.type) {
+    case zenkit::NpcType::G2_AMBIENT:
+    case zenkit::NpcType::G2_OC_AMBIENT:
+    case zenkit::NpcType::G2_BL_AMBIENT:
+    case zenkit::NpcType::G2_TAL_AMBIENT:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+static bool isOneHanded(const Item& it) {
+  const auto fl = uint32_t(it.handle().flags);
+  return (fl & (ITM_SWD|ITM_AXE))!=0 && (fl & (ITM_2HD_SWD|ITM_2HD_AXE))==0;
+  }
+
+int32_t GameScript::scriptConst(std::string_view name, int32_t def) {
+  auto* s = vm.find_symbol_by_name(name);
+  return s!=nullptr ? s->get_int() : def;
+  }
+
+bool GameScript::isPartyMember(Npc& npc) {
+  const int32_t id = scriptConst("AIV_PARTYMEMBER",15);
+  return id>=0 && uint32_t(id)<zenkit::INpc::aivar_count && npc.handle().aivar[size_t(id)]!=0;
+  }
+
+bool GameScript::isHired(Npc& npc) {
+  // Призванные монстры и сюжетные напарники - тоже AIV_PARTYMEMBER, но у них свои скрипты
+  auto& h = npc.handle();
+  if(Gothic::inst().version().game!=2 || h.guild>=GIL_SEPERATOR_HUM || !isPartyMember(npc))
+    return false;
+  // Пошедшие с героем по своей воле (живые жители и Геральт, ainpc.cpp) - такие же напарники: строй, след
+  // героя, телепорт отставших, без смерти, зелья, привал, приказы отряда
+  return isAmbient(h) || aiNpcPtr->isAiFollower(npc);
+  }
+
+bool GameScript::squadFull() {
+  return hiredCount()>=MaxHired;
+  }
+
+void GameScript::squadJoin(Npc& npc) {
+  // AIV_PARTYMEMBER, приказ отряда (новичок слушает тот же), ZS_Follow_Player на весь день; ход в строю и привал -
+  // с чистого листа. Дальше им ведёт отряд (tickSquad): строй, след героя, телепорт отставших, зелья
+  auto&         h        = npc.handle();
+  const int32_t aivParty = scriptConst("AIV_PARTYMEMBER",15);
+  if(aivParty>=0 && uint32_t(aivParty)<zenkit::INpc::aivar_count)
+    h.aivar[size_t(aivParty)] = 1;
+  setStance(npc,squadPassive());
+  npc.companionIdle   = Npc::CompanionIdle();
+  npc.companionFollow = Npc::CompanionFollow();
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  if(zsFollow==size_t(-1))
+    return;
+  auto wp = npc.currentTaPoint();
+  npc.setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+  }
+
+size_t GameScript::hiredCount() {
+  auto&  w = world();
+  size_t n = 0;
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc!=nullptr && !npc->isDead() && isHired(*npc))
+      ++n;
+    }
+  return n;
+  }
+
+int32_t GameScript::hirePrice(Npc& npc) const {
+  // Шаг цены - как у озвученных сумм: до 100 - по 10, дальше - по 50
+  int32_t p = std::clamp(npc.handle().level*10, 10, 1000);
+  if(p<=100)
+    p = (p+9)/10*10; else
+    p = (p+49)/50*50;
+  return std::min(p,1000);
+  }
+
+void GameScript::companionSay(Npc& npc, Npc& player, std::string_view svm) {
+  npc.aiPush(AiQueue::aiOutputSvm(player,svm,aiOutOrderId));
+  ++aiOutOrderId;
+  }
