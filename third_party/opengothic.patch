+// Поворот тела вокруг точки (мир, м)
+void rotateAbout(btTransform& t, const btVector3& at, const btQuaternion& q) {
+  t.setOrigin(at + quatRotate(q, t.getOrigin()-at));
+  t.setRotation(q*t.getRotation());
+  }
