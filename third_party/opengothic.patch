+const char* MainWindow::touchQuickSave() {
+  auto& g  = Gothic::inst();
+  auto  pl = g.player();
+  if(g.checkLoading()!=Gothic::LoadState::Idle)
+    return "Сохранение уже идёт";
+  if(!g.isInGameAndAlive() || pl==nullptr || g.isPause() || dialogs.isActive() || inventory.isActive() || document.isActive())
+    return "Сейчас нельзя сохраниться";
+  if(auto w = g.world(); w==nullptr || w->currentCs()!=nullptr)
+    return "Сейчас нельзя сохраниться";
+  if(pl->isDown() || player.travelMode()==PlayerControl::TravelMode::Instant)
+    return "Сейчас нельзя сохраниться";
+  if(pl->isInAir() || pl->isFalling() || pl->isJump())
+    return "Нельзя сохраниться в прыжке";
+  // В бою - нет: случайное касание не должно записать быстрое сохранение за миг до гибели
+  if(player.isHeroAttacked())
+    return "Нельзя сохраниться во время боя";
+  g.quickSave();
+  return nullptr;
+  }
