+// Плавное приближение к цели: за tau секунд проходит ~63 % пути
+float approach(float v, float to, float dt, float tau) {
+  if(tau<=0.f)
+    return to;
+  return v + (to-v)*(1.f-std::exp(-dt/tau));
+  }
