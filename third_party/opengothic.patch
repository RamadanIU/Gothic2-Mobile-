+bool PlayerControl::isAttacked(Npc& pl) const {
+  auto w     = Gothic::inst().world();
+  bool found = false;
+  w->detectNpc(pl.position(), 1500, [&](Npc& o) {
+    if(&o!=&pl && !o.isDown() && o.isAttack() && o.target()==&pl)
+      found = true;
+    });
+  return found;
+  }
+
+// Квадрат расстояния по горизонтали: центр героя выше лежащего тела и предмета на земле
+static float qDistXZ(const Tempest::Vec3& a, const Tempest::Vec3& b) {
+  const float dx = a.x-b.x, dz = a.z-b.z;
+  return dx*dx+dz*dz;
+  }
+
+bool PlayerControl::isGatherable(Npc& pl, Item& it) const {
+  auto& h = it.handle();
+  if(h.owner_guild!=0 || it.isTorchBurn())
+    return false;
+  if(h.owner<=0 || uint32_t(h.owner)==pl.handle().symbol_index())
+    return true;
+  // Выпавшее оружие помечено владением того, кто его уронил. Хозяина нет в живых (убитый враг) -
+  // это не кража, собрать можно; хозяин жив, хоть и без сознания, - чужое
+  auto w = Gothic::inst().world();
+  for(size_t i=0; ; ++i) {
+    auto o = w->findNpcByInstance(size_t(h.owner),i);
+    if(o==nullptr)
+      return true;
+    if(!o->isDead())
+      return false;
+    }
+  }
+
+float PlayerControl::gatherReach(Npc& pl, Npc& body) const {
+  // AI_GoToNpc останавливает героя на дистанции удара кулаком (FightAlgo::prefferedAttackDistance): у тела
+  // человека - 1,7 м, крысы - 2,8 м. Сбор ждал подхода на 1,6 м и стоял до таймаута, тело пропускалось
+  auto& gv = Gothic::inst().world()->script().guildVal();
+  const int32_t base = gv.fight_range_base[body.guild()] + gv.fight_range_base[pl.guild()] + gv.fight_range_fist[pl.guild()];
+  return std::max(160.f, float(base)+60.f);
+  }
+
+bool PlayerControl::gatherSees(Npc& pl, const Tempest::Vec3& at) const {
+  // Видно ли цель с места героя: из глаз, а если заслоняет ствол, куст или забор - чуть сбоку или сверху
+  const Tempest::Vec3 eye = pl.position()+Tempest::Vec3(0.f,160.f,0.f);
+  Tempest::Vec3 dir = at-eye;
+  dir.y = 0;
+  const float len = dir.length();
+  const Tempest::Vec3 side = len>1.f ? Tempest::Vec3(-dir.z,0.f,dir.x)*(100.f/len) : Tempest::Vec3(100.f,0.f,0.f);
+  const Tempest::Vec3 from[] = {eye, eye+side, eye-side, eye+Tempest::Vec3(0.f,150.f,0.f)};
+  for(auto& f:from)
+    if(pl.canRayHitPoint(f,at,180.f,2500.f))
+      return true;
+  return false;
+  }
+
+const WayPoint* PlayerControl::gatherWayPoint(Npc& pl, const Tempest::Vec3& at) const {
+  // Точка сети путей игры в 8 м от цели, откуда её видно: туда AI_GoToPoint проведёт в обход стен и деревьев
+  auto w = Gothic::inst().world();
+  return w->findWayPoint(at,[&](const WayPoint& wp) {
+    const auto p = wp.position();
+    if(qDistXZ(p,at)>800.f*800.f || std::abs(p.y-at.y)>300.f)
+      return false;
+    return pl.canRayHitPoint(p+Tempest::Vec3(0.f,120.f,0.f),at,180.f,5000.f);
+    });
+  }
+
+bool PlayerControl::gatherReachable(Npc& pl, const Tempest::Vec3& at) const {
+  return gatherSees(pl,at) || gatherWayPoint(pl,at)!=nullptr;
+  }
+
+void PlayerControl::gatherGo(Npc& pl, bool route) {
+  // К цели: видно - напрямик; нет (или упёрся) - через точку сети путей рядом с ней
+  const auto at = gatherItem!=nullptr ? gatherItem->midPosition() : gatherBody->position()+Tempest::Vec3(0.f,40.f,0.f);
+  pl.clearAiQueue();
+  if(route || !pl.canRayHitPoint(pl.position()+Tempest::Vec3(0.f,160.f,0.f),at,180.f,2500.f)) {
+    if(auto wp = gatherWayPoint(pl,at)) {
+      pl.aiPush(AiQueue::aiGoToPoint(*wp));
+      gatherRouted = true;
+      }
+    }
+  if(gatherItem!=nullptr)
+    pl.aiPush(AiQueue::aiGotoItem(*gatherItem)); else
+    pl.aiPush(AiQueue::aiGoToNpc(gatherBody));
+  gatherMovePos = pl.position();
+  gatherMoveAt  = Gothic::inst().world()->tickCount();
+  }
+
+bool PlayerControl::findGatherTarget(Npc& pl, Item*& item, Npc*& body) const {
+  auto w = Gothic::inst().world();
+  item = nullptr;
+  body = nullptr;
+  float best = 0;
+  auto  skip = [this](const void* p) {
+    return std::find(gatherSkip.begin(),gatherSkip.end(),p)!=gatherSkip.end();
+    };
+  const auto pos = pl.position();
+  // Перепад высоты - с запасом на склон, но не этаж выше
+  auto  high = [&pos](const Tempest::Vec3& p, float base) {
+    return std::abs(p.y-pos.y) > base + 0.3f*std::sqrt(qDistXZ(p,pos));
+    };
+  // Только бесхозное: чужое (владелец или гильдия) берётся вручную, осознанно - это кража.
+  // Не только то, что видно из глаз: за деревом, кустом, углом - если туда можно дойти
+  w->detectItem(pos, gatherRadius, [&](Item& it) {
+    if(skip(&it) || high(it.position(),160.f) || !isGatherable(pl,it))
+      return;
+    const float qd = pl.qDistTo(it);
+    if((item!=nullptr || body!=nullptr) && qd>=best)
+      return;
+    if(!pl.canSeeItem(it,true) && !gatherReachable(pl,it.midPosition()))
+      return;
+    item = &it;
+    body = nullptr;
+    best = qd;
+    });
+  // Мёртвые (не оглушённые): то, что даёт обыск
+  w->detectNpc(pos, gatherRadius, [&](Npc& n) {
+    if(&n==&pl || !n.isDead() || skip(&n))
+      return;
+    if(!n.inventory().iterator(Inventory::T_Ransack).isValid())
+      return;
+    if(high(n.position(),200.f))
+      return;
+    const float qd = pl.qDistTo(n);
+    if((item!=nullptr || body!=nullptr) && qd>=best)
+      return;
+    if(!pl.canSeeNpc(n,true) && !gatherReachable(pl,n.position()+Tempest::Vec3(0.f,40.f,0.f)))
+      return;
+    item = nullptr;
+    body = &n;
+    best = qd;
+    });
+  return item!=nullptr || body!=nullptr;
+  }
+
+void PlayerControl::startGather() {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr || gatherOn)
+    return;
+  gatherOn    = true;
+  gatherTaken = 0;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherSkip.clear();
+  gatherDeadline = w->tickCount()+7000;
+  Tempest::Log::i("[g2m] gather: start");
+  }
+
+void PlayerControl::stopGather(bool report) {
+  if(!gatherOn)
+    return;
+  gatherOn    = false;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherAvail = false;
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl!=nullptr && !pl->isAiQueueEmpty())
+    pl->clearAiQueue();
+  Tempest::Log::i("[g2m] gather: stop, taken=", int(gatherTaken));
+  if(!report && gatherTaken==0)
+    return;
+  if(gatherTaken>0)
+    Gothic::inst().onPrint(toCp1251("Собрано: ") + std::to_string(gatherTaken));
+  else
+    Gothic::inst().onPrint(toCp1251("Нечего собрать"));
+  }
+
+void PlayerControl::tickGather(Npc& pl) {
+  auto           w   = Gothic::inst().world();
+  const uint64_t now = w->tickCount();
+  if(!gatherOn) {
+    // Кнопка «Собрать» видна, только если рядом есть что взять и на героя не нападают
+    if(now>=gatherScanTime) {
+      gatherScanTime = now+350;
+      Item* it = nullptr;
+      Npc*  bd = nullptr;
+      gatherAvail = !pl.isDown() && !pl.isSwim() && !pl.isDive() && pl.interactive()==nullptr &&
+                    !dlg.isActive() && findGatherTarget(pl,it,bd) && !isAttacked(pl);
+      }
+    return;
+    }
+
+  // Игрок взялся за управление, напали, открылось окно - сбор прекращается
+  if(pl.isDown() || dlg.isActive() || inv.isActive() || pl.isSwim() || pl.isDive() || pl.interactive()!=nullptr ||
+     touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle || touchAttack || touchBlock || isAttacked(pl)) {
+    // прервали - итог, только если что-то уже собрано
+    stopGather(gatherTaken>0);
+    return;
+    }
+  if(pl.weaponState()!=WeaponState::NoWeapon) {
+    // Сначала убрать оружие: с ним в руках вещи не поднять
+    wctrl[WeaponClose] = true;
+    gatherDeadline     = now+7000;
+    return;
+    }
+
+  if(gatherItem!=nullptr) {
+    Focus f;
+    f.item     = gatherItem;
+    gatherItem = w->validateFocus(f).item;
+    }
+  if(gatherBody!=nullptr) {
+    Focus f;
+    f.npc      = gatherBody;
+    gatherBody = w->validateFocus(f).npc;
+    if(gatherBody!=nullptr && !gatherBody->inventory().iterator(Inventory::T_Ransack).isValid())
+      gatherBody = nullptr;
+    }
+
+  if(gatherItem==nullptr && gatherBody==nullptr) {
+    if(!pl.isAiQueueEmpty() || pl.isAiBusy()) {
+      // доигрывается подбор или обыск
+      if(now>gatherDeadline)
+        pl.clearAiQueue();
+      return;
+      }
+    if(!findGatherTarget(pl,gatherItem,gatherBody)) {
+      stopGather(true);
+      return;
+      }
+    // До 20 м: время на дорогу - по расстоянию, в обход - с запасом
+    const auto tg = gatherItem!=nullptr ? gatherItem->position() : gatherBody->position();
+    gatherDeadline = now+7000+uint64_t(std::sqrt(qDistXZ(tg,pl.position()))*6.f);
+    gatherRouted   = false;
+    gatherGo(pl,false);
+    return;
+    }
+
+  if(now>gatherDeadline) {
+    // Не дойти (стена, обрыв) - пропустить
+    gatherSkip.push_back(gatherItem!=nullptr ? static_cast<const void*>(gatherItem) : static_cast<const void*>(gatherBody));
+    gatherItem = nullptr;
+    gatherBody = nullptr;
+    pl.clearAiQueue();
+    return;
+    }
+
+  // По горизонтали: тело лежит, предмет на земле - центр героя выше, расстояние в 3D не сходилось.
+  // К телу AI_GoToNpc подводит только на дистанцию удара - этого хватает для обыска
+  const float reach = gatherItem!=nullptr ? 90.f : gatherReach(pl,*gatherBody);
+  const float qd    = qDistXZ(pl.position(), gatherItem!=nullptr ? gatherItem->position() : gatherBody->position());
+  const bool  stop  = gatherBody!=nullptr && pl.isAiQueueEmpty() && qd<=(reach+120.f)*(reach+120.f);
+  if(qd>reach*reach && !stop) {
+    // Ещё идёт. Упёрся (дерево, забор, угол) на 2,5 с - в обход по сети путей; и там застрял - пропустить
+    if(qDistXZ(pl.position(),gatherMovePos)>60.f*60.f) {
+      gatherMovePos = pl.position();
+      gatherMoveAt  = now;
+      }
+    else if(now>gatherMoveAt+2500) {
+      if(!gatherRouted) {
+        Tempest::Log::i("[g2m] gather: blocked, route by waypoints");
+        gatherGo(pl,true);
+        if(gatherRouted)
+          return;
+        }
+      gatherSkip.push_back(gatherItem!=nullptr ? static_cast<const void*>(gatherItem) : static_cast<const void*>(gatherBody));
+      gatherItem = nullptr;
+      gatherBody = nullptr;
+      pl.clearAiQueue();
+      }
+    return;
+    }
+  if(!pl.isAiQueueEmpty())
+    pl.clearAiQueue(); // дошёл
+  if(pl.isAiBusy())
+    return;
+  if(pl.bodyStateMasked()==BS_RUN || pl.bodyStateMasked()==BS_WALK)
+    pl.setAnim(Npc::Anim::Idle); // подобрать можно только стоя (Npc::takeItem)
+
+  if(gatherItem!=nullptr) {
+    // Подбор - как вручную: анимация, проверка кражи скриптами
+    if(pl.takeItem(*gatherItem)!=nullptr) {
+      ++gatherTaken;
+      gatherItem = nullptr;
+      }
+    return;
+    }
+
+  // Обыск тела: всё, что показал бы обыск (как «Взять всё»)
+  std::vector<std::pair<size_t,size_t>> loot;
+  for(auto it = gatherBody->inventory().iterator(Inventory::T_Ransack); it.isValid(); ++it)
+    loot.emplace_back(it->clsId(), it.count());
+  for(auto& [cls,count]:loot)
+    pl.addItem(cls,*gatherBody,count);
+  gatherTaken += loot.size();
+  gatherSkip.push_back(gatherBody);
+  gatherBody     = nullptr;
+  gatherDeadline = now+3000;
+  pl.aiPush(AiQueue::aiPlayAnim("T_PLUNDER"));
+  }
+
+void PlayerControl::applyTouchMove() {
+  // Удар и выход из серии сбрасывают движение (movement.reset) - палец на джойстике возвращает его.
+  // Пока держат «Удар» или «Блок», герой стоит: серия и блок не срываются бегом.
+  const bool hold = touchAttack || touchBlock;
+  if(touchFwdAct==Action::Idle && touchSideAct==Action::Idle && !hold)
+    return;
+  movement.forwardBackward.main   [1] = !hold && touchFwdAct ==Action::Forward;
+  movement.forwardBackward.reverse[1] = !hold && touchFwdAct ==Action::Back;
+  movement.strafeRightLeft.main   [1] = !hold && touchSideAct==Action::Right;
+  movement.strafeRightLeft.reverse[1] = !hold && touchSideAct==Action::Left;
+  movement.turnRightLeft.main     [1] = !hold && touchSideAct==Action::RotateR;
+  movement.turnRightLeft.reverse  [1] = !hold && touchSideAct==Action::RotateL;
+  }
+
+void PlayerControl::tickTouchAttack(Npc& pl) {
+  const auto ws = pl.weaponState();
+  if(ws!=WeaponState::Fist && ws!=WeaponState::W1H && ws!=WeaponState::W2H)
+    return;
+  if(touchBlock) {
+    actrl[ActBack] = true;
+    return;
+    }
+  if(!touchAttack)
+    return;
+  // Как удержание «действия»: цель зафиксирована, герой доворачивается к ней
+  ctrl [Action::ActionGeneric] = true;
+  actrl[ActGeneric]            = true;
+  if(pl.isAttackAnim() && !pl.isComboWindow())
+    return; // ждём окна серии: удар раньше времени сорвал бы комбо
+  // Добить оглушённого - только новым нажатием: удержание «Удара» никого не убивает само
+  if(auto tg = pl.target(); touchFresh && tg!=nullptr && !pl.isAttackAnim() && pl.canFinish(*tg))
+    actrl[ActKill] = true;
+  else if(touchSideAtk<0)
+    actrl[ActLeft] = true;
+  else if(touchSideAtk>0)
+    actrl[ActRight] = true;
+  else
+    actrl[ActForward] = true;
+  touchSideAtk = 0;
+  touchFresh   = false;
+  }
+
+Npc* PlayerControl::findAutoFightTarget(Npc& pl) const {
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return nullptr;
+  // Нападающий на героя - издалека; хищник, который ещё не напал, - только вблизи
+  static const float attackerDist = 1500.f;
+  static const float monsterDist  = 700.f;
+  auto isEnemy = [&pl](Npc& npc) {
+    if(&npc==&pl || npc.isDown())
+      return false;
+    const float qd = pl.qDistTo(npc);
+    if(npc.target()==&pl && npc.isAttack())
+      return qd<attackerDist*attackerDist;
+    if(npc.isMonster() && npc.isEnemy(pl))
+      return qd<monsterDist*monsterDist;
+    return false;
+    };
+
+  if(auto tg = pl.target(); tg!=nullptr && isEnemy(*tg))
+    return tg; // не перескакивать между врагами без причины
+
+  Npc*  ret  = nullptr;
+  float best = 0;
+  for(uint32_t i=0; i<w->npcCount(); ++i) {
+    auto npc = w->npcById(i);
+    if(npc==nullptr || !isEnemy(*npc))
+      continue;
+    const float qd = pl.qDistTo(*npc);
+    if(ret==nullptr || qd<best) {
+      ret  = npc;
+      best = qd;
+      }
+    }
+  return ret;
+  }
+
+bool PlayerControl::tickAutoFight(Npc& pl) {
+  // Палец на джойстике или кнопке боя - герой слушается игрока; отпустил - автобой продолжает
+  const bool manual = touchAttack || touchBlock || touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle ||
+                      movement.forwardBackward.any() || movement.strafeRightLeft.any() || movement.turnRightLeft.any();
+  Npc* tg = nullptr;
+  if(autoFight && !manual && !dlg.isActive() && !pl.isSwim() && !pl.isDive())
+    tg = findAutoFightTarget(pl);
+
+  const auto ws    = pl.weaponState();
+  const bool melee = (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+  if(tg!=nullptr && ws==WeaponState::NoWeapon) {
+    // Оружие достаём, только если на героя уже напали: убранный меч - тоже решение игрока
+    if(tg->target()==&pl && tg->isAttack())
+      wctrl[WeaponMele] = true;
+    tg = nullptr;
+    }
+
+  if(tg==nullptr || !melee) {
+    if(autoFightOn) {
+      autoFightOn = false;
+      pl.setAutoFight(false);
+      Tempest::Log::i("[g2m] autofight: idle");
+      }
+    return false;
+    }
+
+  if(!autoFightOn || pl.target()!=tg)
+    Tempest::Log::i("[g2m] autofight: target=", tg->displayName(), " tactic=", pl.fightTactic());
+  autoFightOn = true;
+  pl.setTarget(tg);
