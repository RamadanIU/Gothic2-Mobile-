+#pragma once
+
+#include <Tempest/Matrix4x4>
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+class btRigidBody;
+class btCollisionShape;
+class btTypedConstraint;
+
+class DynamicWorld;
+class Skeleton;
+
+// Gothic II Mobile: тело убитого или потерявшего сознание - тряпичная кукла (регдолл) на физике Bullet.
+// Схема куклы строится по скелету модели (Layout): таз, позвоночник, голова, руки, ноги, хвост - капсулы вдоль
+// костей; у людей и человекоподобных колени и локти - шарниры, сгибаются только в свою сторону, остальные
+// суставы - конусы с пределами. Кукла ведёт мировые матрицы своих костей; остальные кости (пальцы, ключицы,
+// слоты оружия) идут за ними по иерархии скелета (Pose::setRagdoll). Улёгшееся тело застывает: тела убираются
+// из физики, поза остаётся (и пишется в сохранение) - процессор лежащие тела не тратят.
+//
+// Бюджет (физика на телефоне не бесплатна): кукла живёт в физике не дольше LiveTime после падения - потом
+// застывает, где лежит (с SettleTime движение плавно гасится, чтобы остановка не была рывком); в физике
+// одновременно не больше MaxSimulated кукол - лишние застывают, начиная с самых дальних и старых; далеко от
+// героя и камеры кукла не начинается и застывает (Npc::tickRagdoll). Застывшая кукла стоит не больше
+// обычной позы анимации.
+class Ragdoll final {
+  public:
+    enum State : uint8_t {
+      S_Dead        = 0,
+      S_Unconscious = 1,
+      S_Fall        = 2, // живой и в сознании: долго падает или отброшен ударом - встанет сам (Npc::tickRagdollFall)
+      };
+
+    static constexpr size_t   MaxSimulated = 4;     // кукол в физике одновременно (и кукла героя сверх них)
+    static constexpr uint64_t LiveTime     = 3000;  // мс в физике после падения: дальше тело застывает
+    static constexpr uint64_t SettleTime   = 2200;  // мс: с этого времени движение гасится сильнее
+    static constexpr uint64_t AirTime      = 6000;  // мс: тело ещё летит (обрыв) - ждать, пока долетит, но не дольше
+    static constexpr uint64_t CalmTime     = 700;   // мс почти без движения - тело улеглось, застывает раньше
+    static constexpr uint64_t SettleMinTime= 800;   // мс: раньше тело ещё падает - ради места в физике его не останавливать
+    static constexpr uint64_t FallMaxTime  = 10000; // мс: живой падающий - дольше не бывает
+    static constexpr float    StartDist    = 3500;  // см от героя или камеры: дальше падают анимацией
+    static constexpr float    FreezeDist   = 4500;  // см: дальше кукла застывает (с запасом от StartDist)
+
+    struct Hit final {
+      Tempest::Vec3 at    = {}; // точка удара, см
+      Tempest::Vec3 dir   = {}; // куда толкает удар
+      float         power = 0;  // скорость, которую удар сообщает задетой части тела, м/с
+      };
+
+    struct Layout;
+
+    ~Ragdoll();
+
+    // Кукла для скелета: bones - мировые матрицы всех костей (поза в момент падения); nullptr - скелет не подходит
+    // или в физике нет места (reserve). viewDist, keep - как у setViewDistance
+    static std::unique_ptr<Ragdoll> create(DynamicWorld& owner, const Skeleton& sk, const Tempest::Matrix4x4* bones, size_t count, State st,
+                                           float viewDist = 0, bool keep = false);
+    // Застывшая кукла (из сохранения): мировые матрицы ведомых костей, тела в физику не добавляются
+    static std::unique_ptr<Ragdoll> createFrozen(DynamicWorld& owner, const Skeleton& sk, const std::vector<uint16_t>& boneId,
+                                                 const std::vector<Tempest::Matrix4x4>& world, State st);
+
+    State                 state() const { return st; }
+    void                  setState(State s);
+
+    bool                  isSimulated() const { return !body.empty(); }
+    bool                  wake();
+    void                  freeze();
+
+    void                  setVelocity(const Tempest::Vec3& v); // скорость всего тела (бег, падение), м/с
+    void                  hit(const Hit& h);                    // застывшее тело оживает
+
+    // Расстояние до героя или камеры (ближнее), см: дальние куклы считаются проще и застывают первыми.
+    // keep - кукла героя: застывает последней
+    void                  setViewDistance(float cm, bool keep);
+    float                 viewDistance() const { return viewDist; }
+    // Тело ещё падает (таз летит вниз быстрее 2 м/с)
+    bool                  isAirborne() const;
+    // Тело улеглось: почти не движется не меньше ms
+    bool                  isCalm(uint64_t ms) const { return calmTime>=ms; }
