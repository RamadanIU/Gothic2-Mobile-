diff --git a/common/game/fightbody.cpp b/common/game/fightbody.cpp
new file mode 100644
index 0000000..260c37f
--- /dev/null
+++ b/common/game/fightbody.cpp
@@ -0,0 +1,770 @@
+#include "fightbody.h"
+
+#include "graphics/mesh/limbik.h"
+
+#include <algorithm>
+#include <cmath>
+
+using namespace Tempest;
+
+// Gothic II Mobile: бой телом - процедурные ходы (fightbody.h). Позы - в системе персонажа (x - влево, y - вверх,
+// z - вперёд) в сантиметрах человека с тазом на высоте 95 см; в мир - через Frame (масштаб по скелету)
+
+namespace {
+
+constexpr float PelH = 95.f;  // высота таза стандартного человека, см
+
+float smooth(float t) {
+  t = std::clamp(t,0.f,1.f);
+  return t*t*(3.f-2.f*t);
+  }
+
+Vec3 horizontal(Vec3 v) {
+  v.y = 0;
+  const float l = v.length();
+  return l>1e-4f ? v/l : Vec3();
+  }
+
+Vec3 nrm(const Vec3& v, const Vec3& def = Vec3()) {
+  const float l = v.length();
+  return l>1e-5f ? v/l : def;
+  }
+
+Vec3 rot(const Vec3& v, const Vec3& ax, float a) {
+  return LimbIk::rotate(v,ax,std::cos(a),std::sin(a));
+  }
+
+Vec3 lerp(const Vec3& a, const Vec3& b, float w) {
+  return a + (b-a)*w;
+  }
+
+Vec3 nlerp(const Vec3& a, const Vec3& b, float w) {
+  if(a.length()<1e-5f)
+    return b;
+  if(b.length()<1e-5f)
+    return a;
+  return nrm(a*(1.f-w) + b*w, b);
+  }
+
+float strikeDur(FightBody::Weapon w) {
+  switch(w) {
+    case FightBody::W_Fist: return 0.11f;
+    case FightBody::W_1H:   return 0.17f;
+    case FightBody::W_2H:   return 0.24f;
+    }
+  return 0.17f;
+  }
+
+// стойка ступней: левая впереди, правая сзади и развёрнута наружу (x, z - см; yaw носка - рад, + влево)
+struct FootStance { float x, z, yaw; };
+void stanceOf(FightBody::Weapon w, FootStance st[2]) {
+  st[0] = {14, 12, 0.15f};
+  st[1] = {-14,-15,-0.45f};
+  switch(w) {
+    case FightBody::W_Fist:
+      st[0] = {13, 11, 0.15f};
+      st[1] = {-12,-12,-0.40f};
+      break;
+    case FightBody::W_1H:
+      st[0] = {14, 12, 0.15f};
+      st[1] = {-14,-15,-0.45f};
+      break;
+    case FightBody::W_2H:
+      st[0] = {16, 15, 0.12f};
+      st[1] = {-16,-21,-0.55f};
+      break;
+    }
+  }
+
+// виды ударов: куда идёт кисть в миг удара (система персонажа)
+enum StrikeKind : uint8_t {
+  K_Over   = 0, // сверху вниз
+  K_DiagF  = 1, // справа сверху - влево вниз
+  K_DiagB  = 2, // слева сверху - вправо вниз
+  K_HorF   = 3, // справа налево
+  K_HorB   = 4, // слева направо
+  K_Thrust = 5, // прямой (укол, кулак)
+  K_Stab   = 6, // вниз в лежащего
+  };
+
+}
+
+Vec3 FightBody::Frame::toLocal(const Vec3& w) const {
+  const Vec3 d = (w-O)/k;
+  return Vec3(Vec3::dotProduct(d,L), Vec3::dotProduct(d,U), Vec3::dotProduct(d,F));
+  }
+
+Vec3 FightBody::Frame::dirLocal(const Vec3& w) const {
+  return Vec3(Vec3::dotProduct(w,L), Vec3::dotProduct(w,U), Vec3::dotProduct(w,F));
+  }
+
+void FightBody::reset() {
+  for(auto& f:foot)
+    f = Foot();
+  str      = Strike();
+  hasShown = false;
+  lastMove = M_Guard;
+  lastId   = 0;
+  blend    = 1;
+  arcNow   = -1;
+  strikeOn = false;
+  blockW   = 0;
+  pelInit  = false;
+  }
+
+void FightBody::plantFeet(const Vec3& l, const Vec3& r) {
+  foot[0].at = l; foot[0].u = -1; foot[0].init = true;
+  foot[1].at = r; foot[1].u = -1; foot[1].init = true;
+  }
+
+float FightBody::hitPower(Weapon w, float bladeSpeed) {
+  const float v = bladeSpeed/100.f;
+  float p = std::clamp(0.22f*v + 0.8f, 1.2f, 4.2f);
+  if(w==W_2H)
+    p *= 1.25f;
+  if(w==W_Fist)
+    p *= 0.75f;
+  return p;
+  }
+
+FightBody::Key FightBody::mix(const Key& a, const Key& b, float w) {
+  Key r;
+  r.pel   = lerp(a.pel,b.pel,w);
+  r.drop  = a.drop  + (b.drop -a.drop )*w;
+  r.yaw   = a.yaw   + (b.yaw  -a.yaw  )*w;
+  r.pitch = a.pitch + (b.pitch-a.pitch)*w;
+  r.roll  = a.roll  + (b.roll -a.roll )*w;
+  r.flex  = a.flex  + (b.flex -a.flex )*w;
+  r.side  = a.side  + (b.side -a.side )*w;
+  r.twist = a.twist + (b.twist-a.twist)*w;
+  for(int i=0; i<2; ++i) {
+    r.hand[i]  = lerp(a.hand[i],b.hand[i],w);
+    r.pole[i]  = nlerp(a.pole[i],b.pole[i],w);
+    r.axis[i]  = nlerp(a.axis[i],b.axis[i],w);
+    r.palm[i]  = nlerp(a.palm[i],b.palm[i],w);
+    r.shrug[i] = a.shrug[i] + (b.shrug[i]-a.shrug[i])*w;
+    r.step[i]  = lerp(a.step[i],b.step[i],w);
+    }
+  return r;
+  }
+
+FightBody::Key FightBody::guardKey(const Input& in) const {
+  Key k;
+  switch(in.weapon) {
+    case W_Fist:
+      k.drop  = 5;
+      k.yaw   = -0.25f;
+      k.twist = -0.08f;
+      k.flex  = 0.12f;
+      k.hand[1] = Vec3(-11,140,30); k.pole[1] = Vec3(-0.6f,-1,0);
+      k.hand[0] = Vec3( 12,145,36); k.pole[0] = Vec3( 0.6f,-1,0);
+      break;
+    case W_1H:
+      k.drop  = 6;
+      k.yaw   = -0.3f;
+      k.twist = -0.1f;
+      k.flex  = 0.08f;
+      k.hand[1] = Vec3(-16,112,34); k.pole[1] = Vec3(-1,-0.6f,0);
+      k.axis[1] = Vec3(0.12f,0.55f,0.83f);
+      k.hand[0] = Vec3( 17,106,18); k.pole[0] = Vec3( 1,-0.6f,-0.2f);
+      break;
+    case W_2H:
+      k.drop  = 8;
+      k.yaw   = -0.35f;
+      k.twist = -0.15f;
+      k.flex  = 0.1f;
+      k.hand[1] = Vec3(-6,110,36);  k.pole[1] = Vec3(-1,-0.7f,0);
+      k.axis[1] = Vec3(0.05f,0.6f,0.8f);
+      k.pole[0] = Vec3(1,-0.7f,0);
+      break;
+    }
+  if(!in.inHand && in.weapon!=W_Fist) {
+    // оружие ещё (уже) в ножнах: руки опущены
+    k.hand[1] = Vec3(-22,96,6);  k.pole[1] = Vec3(-0.3f,0,-1); k.axis[1] = Vec3();
+    k.hand[0] = Vec3( 22,96,6);  k.pole[0] = Vec3( 0.3f,0,-1);
+    }
+  return k;
+  }
+
+void FightBody::planStrike(const BodyRig& rig, const Input& in, const Frame& fr) {
+  // Удар этой стадии: вид (по ходу, номеру в серии, оружию); точку и дугу считает aimStrike - до замаха каждый кадр
+  const auto& ck  = in.clock;
+  const bool  fist = (in.weapon==W_Fist);
+  uint8_t kind = K_DiagF;
+  int8_t  hand = 1;
+  switch(ck.move) {
+    case M_Attack:
+      if(fist) {
+        static const uint8_t fk[3] = {K_Thrust, K_Thrust, K_HorF};
+        kind = fk[ck.stage%3];
+        hand = (ck.stage%3==0) ? 0 : 1;
+        } else {
+        static const uint8_t wk[4] = {K_DiagF, K_DiagB, K_Over, K_HorF};
+        kind = wk[ck.stage%4];
+        }
+      break;
+    case M_AttackL:
+      kind = K_HorF;
+      break;
+    case M_AttackR:
+      kind = K_HorB;
+      if(fist) hand = 0;
+      break;
+    case M_AttackRun:
+      kind = fist ? K_Thrust : K_Over;
+      break;
+    case M_Finish:
+      kind = K_Stab;
+      break;
+    default:
+      break;
+    }
+  Strike s;
+  s.id     = ck.id;
+  s.kind   = kind;
+  s.hand2  = hand;
+  s.thrust = (kind==K_Thrust || kind==K_Stab);
+  Vec3 v;
+  switch(kind) {
+    case K_Over:   v = Vec3(0,-1,0.25f);        s.wind = -2.0f; s.follow = 0.9f; break;
+    case K_DiagF:  v = Vec3(0.75f,-0.6f,0.1f);  s.wind = -1.9f; s.follow = 1.0f; break;
+    case K_DiagB:  v = Vec3(-0.75f,-0.55f,0.1f);s.wind = -1.8f; s.follow = 0.9f; break;
+    case K_HorF:   v = Vec3(1,-0.12f,0);        s.wind = fist ? -1.2f : -1.7f; s.follow = fist ? 0.6f : 1.0f; break;
+    case K_HorB:   v = Vec3(-1,-0.12f,0);       s.wind = fist ? -1.2f : -1.6f; s.follow = fist ? 0.6f : 0.9f; break;
+    case K_Thrust: v = Vec3(0,0,1);             s.wind = -1.f;  s.follow = 0.25f; break;
+    case K_Stab:   v = Vec3(0,-1,0);            s.wind = -1.f;  s.follow = 0.2f;  break;
+    }
+  if(in.weapon==W_2H && !s.thrust)
+    s.wind *= 1.1f;
+  s.v      = nrm(v);
+  s.twistK = (in.weapon==W_2H ? 0.55f : 0.45f)*s.v.x;
+  s.flexK  = 0.25f*std::max(-s.v.y,0.f);
+  str = s;
+  // замах - от позы, в которой застала стадия (стойка или конец прошлого удара серии)
+  stageKey = hasShown ? shown : guardKey(in);
+  aimStrike(rig,in,fr);
+  }
+
+void FightBody::aimStrike(const BodyRig& rig, const Input& in, const Frame& fr) {
+  // Куда бить (до разгона - каждый кадр: цель двигается): точка на цели, кисть в миг удара - на 0,7 клинка от неё
+  // (клинок проходит сквозь цель), не дальше руки от плеча; не дотянуться - выпад
+  auto&       s    = str;
+  const bool  fist = (in.weapon==W_Fist);
+  const float side = (s.hand2==0 ? 1.f : -1.f);
+  Vec3 S = Vec3(18.f*side, 148.f, 2.f);
+  Vec3 P = Vec3(0,128,140);
+  if(in.target) {
+    const Vec3 head  = fr.toLocal(in.tHead);
+    const Vec3 chest = fr.toLocal(in.tChest);
+    switch(s.kind) {
+      case K_Over:   P = head*0.6f + chest*0.4f + Vec3(0,6,0); break;
+      case K_DiagF:  P = (head+chest)*0.5f + Vec3(-10,0,0);    break;
+      case K_DiagB:  P = chest + Vec3(10,4,0);                  break;
+      case K_HorF:   P = chest + Vec3(-8,0,0);                  break;
+      case K_HorB:   P = chest + Vec3(8,0,0);                   break;
+      case K_Thrust: P = fist ? head*0.65f+chest*0.35f : chest; break;
+      case K_Stab:   P = chest;                                 break;
+      }
+    // у каждого удара чуть своё место
+    const uint32_t h = s.id*2654435761u;
+    P += Vec3(float(int(h%11u)-5), float(int((h>>8)%9u)-4), 0);
+    } else {
+    switch(s.kind) {
+      case K_Over:   P = Vec3(0,150,130);  break;
+      case K_Stab:   P = Vec3(0,20,80);    break;
+      default:       break;
+      }
+    }
+  const float reach = rig.armLength()*in.scale/fr.k;
+  const float bl    = fist ? 0.f : in.bladeLen/fr.k;
+  const float maxR  = 0.93f*reach, minR = 0.35f*reach;
+  float       bite  = fist ? 4.f : 0.72f*bl;
+  // далеко: клинок войдёт в цель неглубоко - концом
+  if(!fist)
+    bite = std::clamp((P-S).length()-maxR-45.f, bite, 0.92f*bl);
+  {
+  const float want = (P-S).length()-bite;
+  s.lunge = std::clamp(want-maxR, 0.f, 45.f);
+  S.z += 0.8f*s.lunge;
+  }
+  const Vec3  d   = P-S;
+  const float len = std::max(d.length(),1.f);
+  s.hand  = S + d*(std::clamp(len-bite, minR, maxR)/len);
+  s.blade = nrm(P-s.hand, Vec3(0,0,1));
+  s.axis  = nrm(Vec3::crossProduct(s.hand-S, s.v), Vec3(1,0,0));
+  if(s.kind==K_Stab) {
+    // добить: кисть над целью, клинок вниз, корпус склоняется
+    s.hand  = Vec3(P.x-4.f, std::max(P.y+40.f, 70.f), std::min(P.z, 60.f));
+    s.blade = Vec3(0,-1,0.15f);
+    }
+  s.shoulder = S;
+  s.aimW     = fr.toWorld(P);
+  s.vW       = fr.dir(s.v);
+  }
+
+bool FightBody::strikeAim(Vec3& at, Vec3& dir) const {
+  if(!str.active)
+    return false;
+  at  = str.aimW;
+  dir = str.vW;
+  return true;
+  }
+
+FightBody::Key FightBody::arcKey(const Input& in, const Key& g, float a) const {
+  // поза на дуге удара: a - угол (рад) от мига удара (<0 - замах, >0 - проводка); у прямого удара a - доля -1..1
+  Key  k = g;
+  const int  h = str.hand2;
+  const Vec3 S = str.shoulder;
+  Vec3 hand, blade;
+  if(str.thrust) {
+    // прямой: кисть оттянута к плечу, удар - по прямой и чуть дальше
+    const Vec3 r = str.hand-S;
+    const float u = std::clamp(a,-1.f,1.f);
+    if(u<0.f)
+      hand = S + r*(1.f+0.62f*u) + Vec3(0,-6,-6)*(-u); else
+      hand = S + r*(1.f+0.12f*u);
+    blade = str.blade;
+    if(in.clock.move==M_Finish && u<0.f) {
+      hand  = str.hand + Vec3(0,45,-8)*(-u);
+      blade = nlerp(str.blade, Vec3(0,-0.3f,1), -u);
+      }
+    k.twist += (h==1 ? 0.35f : -0.35f)*std::clamp(u,0.f,1.f) - (h==1 ? 0.2f : -0.2f)*std::max(-u,0.f);
+    k.flex  += 0.12f*std::max(u,0.f) + (in.clock.move==M_Finish ? 0.5f : 0.f);
+    } else {
+    hand  = S + rot(str.hand-S, str.axis, a);
+    blade = rot(str.blade, str.axis, 1.35f*a);
+    k.twist += str.twistK*a;
+    k.flex  += str.flexK*a;
+    k.yaw   += 0.3f*str.twistK*a;
+    }
+  k.hand[h] = hand;
+  if(in.weapon!=W_Fist)
+    k.axis[h] = blade;
+  // локоть - наружу и вниз от дуги
+  k.pole[h] = nrm(Vec3(h==1 ? -1.f : 1.f, -0.7f, -0.2f));
+  k.shrug[h] = std::clamp((hand.y-150.f)/30.f, 0.f, 1.f);
+  // свободная рука (одноручное) - для равновесия против хода корпуса
+  if(in.weapon==W_1H) {
+    k.hand[0] = g.hand[0] + Vec3(4.f, 0, -10.f)*std::clamp(-str.twistK*a*2.f, -1.f, 1.f);
+    }
+  // выпад: передняя нога шагает, таз и корпус - вперёд, пока идёт удар
+  if(str.lunge>0.f) {
+    const float w = smooth((a-str.wind)/std::max(0.3f-str.wind,0.1f));
+    k.step[0] += Vec3(0,0,str.lunge)*w;
+    k.pel.z   += 0.6f*str.lunge*w;
+    k.flex    += 0.1f*w;
+    }
+  return k;
+  }
+
+FightBody::Key FightBody::attackKey(const BodyRig& rig, const Input& in, const Frame& fr, float& arc) {
+  const auto& ck = in.clock;
+  if(ck.id!=str.id)
+    planStrike(rig,in,fr);
+  str.active = true;
+  const Key   g  = guardKey(in);
+  const float a0 = ck.stageFrom;
+  const float b  = std::max(ck.stageTo, a0+0.1f);
+  float       o  = ck.strike;
+  if(o<=a0 || o>=b)
+    o = a0 + 0.55f*(b-a0);
+  const float D  = strikeDur(in.weapon);
+  float       ws = std::max(o-D, a0+0.1f);
+  if(ws>=o)
+    ws = a0 + 0.5f*(o-a0);
+  const float t  = ck.t;
+  if(t<ws)
+    aimStrike(rig,in,fr);
+  const float hitEnd = o+0.05f;
+  const float fHit   = str.follow*0.35f;
+  float a = 0;
+  if(t<ws) {
+    // замах: от позы начала стадии к замаху (не по дуге - дуга проходила бы через цель)
+    a = str.wind;
+    strikePow = 0;
+    strikeOn  = false;
+    strikeNo  = str.id;
+    arc       = a;
+    return mix(stageKey, arcKey(in,g,a), smooth((t-a0)/std::max(ws-a0,0.05f)));
+    }
+  else if(t<hitEnd) {
+    const float u = std::clamp((t-ws)/std::max(hitEnd-ws,0.02f), 0.f, 1.f);
+    a = str.wind + (fHit-str.wind)*std::pow(u,1.5f);
+    strikePow = std::clamp(0.4f+0.6f*u, 0.f, 1.f);
+    }
+  else {
+    const float u = smooth((t-hitEnd)/std::max(b-hitEnd,0.05f));
+    a = fHit + (str.follow-fHit)*u;
+    strikePow = std::max(0.f, 1.f-u*1.5f);
+    }
+  // разит: с середины разгона до проводки (кукла отстаёт от позы на 0,05-0,15 с); попадание - ещё и по скорости
+  // клинка (Npc::tickBlade): медленный клинок не ранит
+  strikeOn = (t>=ws+0.3f*(o-ws) && t<=o+0.3f);
+  strikeNo = str.id;
+  arc = a;
+  return arcKey(in,g,a);
+  }
+
+FightBody::Key FightBody::paradeKey(const BodyRig& rig, const Input& in, const Frame& fr) const {
+  // Блок: клинок поперёк пути клинка противника перед телом; противник ещё не бьёт - высокий блок
+  Key k = guardKey(in);
+  k.drop += 3;
+  if(in.weapon==W_Fist) {
+    // кулаки к лицу, предплечья - щитом
+    k.hand[1] = Vec3(-9,150,26);  k.pole[1] = Vec3(-0.4f,-1,0.3f);
+    k.hand[0] = Vec3( 9,152,30);  k.pole[0] = Vec3( 0.4f,-1,0.3f);
+    k.flex   += 0.08f;
+    return k;
+    }
+  const float bl = in.bladeLen/fr.k;
+  Vec3 hand = Vec3(-20,150,36);
+  Vec3 ax   = nrm(Vec3(1,0.3f,0.15f));
+  if(in.threatAimed) {
+    // удар противника телом: знаем, куда он придётся и куда идёт клинок - клинок поперёк его пути, ближе к нему
+    const Vec3 chest = Vec3(0,135,0);
+    Vec3 P = fr.toLocal(in.threatAt);
+    P.y = std::clamp(P.y, 95.f, 180.f);
+    Vec3 toA = nrm(Vec3(P.x*0.5f, 0, std::max(P.z, 20.f)), Vec3(0,0,1));
+    Vec3 C   = P + toA*20.f;
+    // не ближе 30 см перед грудью
+    if(C.z<30.f)
+      C.z = 30.f;
+    (void)chest;
+    const Vec3 V  = nrm(fr.dirLocal(in.threatDir), Vec3(0,-1,0));
+    Vec3 Db = nrm(Vec3::crossProduct(V, Vec3(0,0,1)), Vec3(1,0,0));
+    if(std::abs(Db.y)>0.7f) {
+      if(Db.y<0.f) Db = Db*-1.f;
+      } else if(Db.x<0.f) {
+      Db = Db*-1.f;
+      }
+    // клинок блока - наискось, остриём чуть вверх: так удар соскальзывает, а не рубит кисть
+    Db = nrm(Db + Vec3(0,0.25f,0));
+    hand = C - Db*(0.3f*bl);
+    ax   = Db;
+    }
+  else if(in.threat) {
+    const Vec3 chest = Vec3(0,135,0);
+    const Vec3 M     = fr.toLocal((in.threatA+in.threatB)*0.5f + in.threatVel*0.08f);
+    Vec3       dirT  = nrm(M-chest, Vec3(0,0,1));
+    if(dirT.z<0.2f)
+      dirT = nrm(Vec3(dirT.x, dirT.y, 0.2f));
+    Vec3 C = chest + dirT*42.f;
+    C.y = std::clamp(C.y, 95.f, 175.f);
+    const Vec3 V  = fr.dirLocal(in.threatVel);
+    const Vec3 Tb = nrm(fr.dirLocal(in.threatB-in.threatA), Vec3(0,1,0));
+    Vec3 Db = (V.length()>100.f) ? Vec3::crossProduct(nrm(V),dirT) : Vec3::crossProduct(Tb,dirT);
+    Db = nrm(Db, Vec3(1,0,0));
+    // остриё - вверх или влево (держит правой, клинок поперёк)
+    if(std::abs(Db.y)>0.7f) {
+      if(Db.y<0.f) Db = Db*-1.f;
+      } else if(Db.x<0.f) {
+      Db = Db*-1.f;
+      }
+    hand = C - Db*(0.3f*bl);
+    ax   = Db;
+    }
+  // не дальше руки от плеча
+  {
+  const Vec3  S = Vec3(-18,148,2);
+  const float r = 0.92f*rig.armLength()*in.scale/fr.k;
+  Vec3 d = hand-S;
+  if(d.length()>r)
+    hand = S + d*(r/d.length());
+  if(hand.z<14.f)
+    hand.z = 14.f;
+  }
+  k.hand[1] = hand;
+  k.axis[1] = ax;
+  k.pole[1] = nrm(Vec3(-1,-0.5f,0));
+  k.shrug[1] = std::clamp((hand.y-150.f)/30.f, 0.f, 1.f);
+  k.twist   = 0.05f;
+  return k;
+  }
+
+FightBody::Key FightBody::drawKey(const Input& in, const Frame& fr, bool draw) const {
+  // Достать: правая к ножнам, в миг смены (swap) оружие в руке - к стойке. Убрать - наоборот, потом рука вниз
+  Input armed = in;   armed.inHand = true;
+  Input bare  = in;   bare.inHand  = false;
+  const Key   ready = guardKey(armed);
+  const Key   rest  = guardKey(bare);
+  const auto& ck    = in.clock;
+  const float T     = std::max(ck.total, 0.2f);
+  const float ts    = (ck.swap>0.f && ck.swap<T) ? ck.swap : T*0.45f;
+  Vec3 sh = in.hasSheath ? fr.toLocal(in.sheath) : Vec3(12,92,4);
+  Key at = rest;
+  at.hand[1] = sh + Vec3(-2,4,6);
+  at.pole[1] = Vec3(-1,-0.3f,0.2f);
+  at.axis[1] = nrm(Vec3(-0.2f,-0.4f,-0.9f));
+  at.twist   = sh.x>0.f ? 0.3f : -0.35f;
+  if(in.weapon==W_Fist)
+    return mix(rest,ready,smooth(ck.t/T));
+  const float t = ck.t;
+  if(draw) {
+    if(t<ts)
+      return mix(rest,at,smooth(t/ts));
+    return mix(at,ready,smooth((t-ts)/std::max(T-ts,0.1f)));
+    }
+  if(t<ts)
+    return mix(ready,at,smooth(t/ts));
+  return mix(at,rest,smooth((t-ts)/std::max(T-ts,0.1f)));
+  }
+
+void FightBody::tickFeet(const BodyRig& rig, const Input& in, const Frame& fr, const Key& k, float dt) {
+  // Шаги: ступня стоит, пока место для неё в стойке (с упреждением по скорости) не ушло дальше порога, - тогда шагает
+  // дугой туда; одна нога за раз (на бегу следующая отрывается, когда первая почти встала)
+  FootStance st[2];
+  stanceOf(in.weapon,st);
+  const Vec3  vel   = Vec3(in.vel.x,0,in.vel.z);
+  const float speed = vel.length();
+  const float ankH  = rig.ankleHeight()*in.scale;
+  auto groundY = [&](const Vec3& p) {
+    return in.ground ? in.ground(p) : in.root.y;
+    };
+  Vec3 want[2], toe[2];
+  for(int s=0; s<2; ++s) {
+    const Vec3 loc = Vec3(st[s].x, 0, st[s].z) + k.step[s];
+    want[s] = fr.toWorld(loc);
+    toe[s]  = rot(fr.F, fr.U, st[s].yaw + k.yaw*0.3f);
+    if(!foot[s].init) {
+      foot[s].at   = want[s];
+      foot[s].at.y = groundY(want[s]) + ankH;
+      foot[s].toe  = toe[s];
+      foot[s].init = true;
+      }
+    }
+  const float lead   = std::clamp(speed/300.f, 0.f, 1.f)*0.22f;
+  const float dur    = std::clamp(0.32f - 0.035f*speed/100.f, 0.17f, 0.32f);
+  const float thr    = speed>30.f ? 5.f*fr.k : 9.f*fr.k;
+  const bool  run    = speed>230.f;
+  for(int s=0; s<2; ++s) {
+    auto& f = foot[s];
+    if(f.u>=0.f) {
+      f.u += dt/f.dur;
+      // в шаге цель идёт за телом: NPC продолжает двигаться
+      f.to = want[s] + vel*(f.dur*(1.f-std::min(f.u,1.f))*0.5f + lead*0.5f);
+      f.to.y = f.from.y;
+      if(f.u>=1.f) {
+        f.u   = -1;
+        f.at  = f.to;
+        f.at.y = groundY(f.to) + ankH;
+        f.toe = f.toeTo;
+        } else {
+        const float w = smooth(f.u);
+        f.at  = lerp(f.from,f.to,w);
+        const float gy = groundY(f.at)+ankH;
+        f.at.y = std::max(f.from.y + (gy-f.from.y)*w, gy) + f.lift*fr.k*std::sin(float(M_PI)*f.u);
+        f.toe = nlerp(f.toeFrom,f.toeTo,w);
+        }
+      }
+    }
+  // какая нога шагает
+  auto err = [&](int s) {
+    const Vec3 tgt = want[s] + vel*lead;
+    Vec3 d = foot[s].at-tgt;
+    d.y = 0;
+    const float yawErr = 1.f - Vec3::dotProduct(horizontal(foot[s].toe), horizontal(toe[s]));
+    return d.length() + 40.f*fr.k*std::max(yawErr,0.f);
+    };
+  const bool swinging = foot[0].u>=0.f || foot[1].u>=0.f;
+  bool canStart = !swinging;
+  if(run && swinging) {
+    for(int s=0; s<2; ++s)
+      if(foot[s].u>=0.6f)
+        canStart = true;
+    }
+  if(canStart) {
+    int   best = -1;
+    float be   = thr;
+    for(int s=0; s<2; ++s) {
+      if(foot[s].u>=0.f)
+        continue;
+      float e = err(s);
+      // по очереди: та, что шагала прошлой, - во вторую очередь
+      if(s==lastStep)
+        e *= 0.8f;
+      if(e>be) {
+        be   = e;
+        best = s;
+        }
+      }
+    if(best>=0) {
+      auto& f   = foot[best];
+      f.from    = f.at;
+      f.toeFrom = f.toe;
+      f.toeTo   = toe[best];
+      f.to      = want[best] + vel*(lead+dur*0.5f);
+      f.dur     = dur*std::clamp(be/(30.f*fr.k), 0.75f, 1.f);
+      f.lift    = std::min(5.f + 2.5f*speed/100.f, 13.f);
+      f.u       = 0;
+      lastStep  = best;
+      }
+    }
+  // ступня далеко (телепорт, рывок) - сразу на место
+  for(int s=0; s<2; ++s) {
+    Vec3 d = foot[s].at-want[s];
+    d.y = 0;
+    if(d.length()>120.f*fr.k) {
+      foot[s].at   = want[s];
+      foot[s].at.y = groundY(want[s])+ankH;
+      foot[s].toe  = toe[s];
+      foot[s].u    = -1;
+      }
+    }
+  bob = 0;
+  for(int s=0; s<2; ++s)
+    if(foot[s].u>=0.f)
+      bob = std::max(bob, std::sin(float(M_PI)*foot[s].u));
+  }
+
+void FightBody::toSpec(const BodyRig& rig, const Input& in, const Frame& fr, const Key& k, BodyRig::Spec& out) const {
+  FootStance st[2];
+  stanceOf(in.weapon,st);
+  const float pelH = rig.pelvisHeight()*in.scale/fr.k;
+  const Vec3  nomMid = Vec3((st[0].x+st[1].x)*0.5f, 0, (st[0].z+st[1].z)*0.5f);
+  Vec3 pl = Vec3(nomMid.x*0.3f, pelH - k.drop + 1.6f*bob, nomMid.z*0.3f) + k.pel;
+  Vec3 pw = fr.toWorld(pl);
+  // вес - чуть к стоящим ступням (на шаге таз над опорной ногой)
+  {
+  Vec3 feet = (foot[0].at+foot[1].at)*0.5f;
+  Vec3 nom  = fr.toWorld(nomMid);
+  Vec3 d    = feet-nom;
+  d.y = 0;
+  if(d.length()<60.f*fr.k)
+    pw += d*0.35f;
+  for(int s=0; s<2; ++s)
+    if(foot[s].u>=0.f) {
+      const Vec3 other = foot[1-s].at;
+      Vec3 dd = other-pw;
+      dd.y = 0;
+      pw += dd*(0.12f*std::sin(float(M_PI)*foot[s].u));
+      }
+  }
+  // таз: поворот, наклон вперёд, крен
+  Vec3 F = rot(fr.F, fr.U, k.yaw);
+  Vec3 L = Vec3::normalize(Vec3::crossProduct(fr.U,F));
+  Vec3 U = fr.U;
+  F = rot(F,L,k.pitch);
+  U = rot(U,L,k.pitch);
+  U = rot(U,F,-k.roll);
+  out.pelvis = pw;
+  out.fwd    = F;
+  out.up     = U;
+  out.flex   = k.flex;
+  out.side   = k.side;
+  out.twist  = k.twist - k.yaw;   // корпус к противнику, таз развёрнут стойкой
+  if(in.target) {
+    out.look = in.tHead - fr.toWorld(Vec3(0,160,0));
+    } else {
+    out.look = fr.F;
+    }
+  out.shrug[0] = k.shrug[0];
+  out.shrug[1] = k.shrug[1];
+  for(int a=0; a<2; ++a) {
+    auto& o = out.arm[a];
+    o.grip = fr.toWorld(k.hand[a]);
+    o.pole = fr.dir(k.pole[a]);
+    o.axis = fr.dir(k.axis[a]);
+    o.palm = fr.dir(k.palm[a]);
+    o.axisLocal = Vec3();
+    }
+  if(in.weapon!=W_Fist && in.inHand)
+    out.arm[1].axisLocal = in.bladeLocal;
+  if(in.weapon==W_2H && in.inHand && out.arm[1].axis.length()>1e-3f) {
+    // двуручное: левая - на рукояти ниже правой
+    const Vec3 ax = Vec3::normalize(out.arm[1].axis);
+    out.arm[0].grip = out.arm[1].grip - ax*(9.f*fr.k);
+    out.arm[0].axis = ax;
+    out.arm[0].pole = fr.dir(Vec3(1,-0.7f,0));
+    }
+  for(int s=0; s<2; ++s) {
+    auto& o  = out.leg[s];
+    o.ankle  = foot[s].at;
+    o.toe    = foot[s].toe;
+    o.pole   = nrm(horizontal(foot[s].toe) + fr.U*0.1f);
+    o.pitch  = foot[s].u>=0.f ? 0.25f*std::sin(float(M_PI)*foot[s].u) : 0.f;
+    }
+  }
+
+void FightBody::tick(const BodyRig& rig, const Input& in, float dt, BodyRig::Spec& out) {
+  Frame fr;
+  fr.F = horizontal(in.fwd);
+  if(fr.F.length()<0.5f)
+    fr.F = Vec3(0,0,1);
+  fr.U = Vec3(0,1,0);
+  fr.L = Vec3::normalize(Vec3::crossProduct(fr.U,fr.F));
+  fr.O = in.root;
+  fr.k = std::max(in.scale*rig.pelvisHeight()/PelH, 0.1f);
+
+  // поза хода - чуть вперёд по времени: мышцы куклы отстают от цели, удар должен прийтись в миг удара игры
+  Input inL = in;
+  if(inL.clock.move!=M_Guard && inL.clock.move!=M_Hit)
+    inL.clock.t = std::min(inL.clock.t+in.lead, std::max(inL.clock.total, inL.clock.t));
+  const Input& inp = inL;
+  const auto&  ck  = inp.clock;
+  strikeOn   = false;
+  str.active = false;
+  Key   k;
+  float arc = -100.f;
+  switch(ck.move) {
+    case M_Attack:
+    case M_AttackL:
+    case M_AttackR:
+    case M_AttackRun:
+    case M_Finish:
+      k = attackKey(rig,inp,fr,arc);
+      break;
+    case M_Parade:
+      k = paradeKey(rig,inp,fr);
+      break;
+    case M_Draw:
+    case M_Sheath:
+      k = drawKey(inp,fr,ck.move==M_Draw);
+      break;
+    case M_JumpBack:
+      k = guardKey(inp);
+      k.flex  += 0.12f;
+      k.drop  += 4.f;
+      break;
+    case M_Guard:
+    case M_Hit:
+      k = guardKey(inp);
+      break;
+    }
+  blockW = (ck.move==M_Parade) ? std::min(1.f, blockW+dt/0.1f) : std::max(0.f, blockW-dt/0.15f);
+
+  // на ходу: корпус вперёд по скорости, таз ниже
+  {
+  const float vf = Vec3::dotProduct(Vec3(in.vel.x,0,in.vel.z), fr.F)/100.f;
+  const float sp = Vec3(in.vel.x,0,in.vel.z).length()/100.f;
+  k.flex += 0.06f*std::clamp(vf,-1.f,3.5f);
+  k.drop += 3.f*std::min(sp,3.5f)/3.5f;
+  }
+
+  // переход между ходами - плавно (кукла и так сгладит, но цель не должна прыгать)
+  const bool newMove = (ck.move!=lastMove) || (ck.id!=lastId && ck.move!=M_Attack);
+  if(hasShown && newMove) {
+    blendFrom = shown;
+    blend     = 0;
+    switch(ck.move) {
+      case M_Parade:   blendDur = 0.1f;  break;
+      case M_Attack:
+      case M_AttackL:
+      case M_AttackR:
+      case M_AttackRun:
+      case M_Finish:   blendDur = 0.12f; break;
+      default:         blendDur = 0.22f; break;
+      }
+    }
+  arcNow = arc;
+  lastMove = ck.move;
+  lastId   = ck.id;
+  if(blend<1.f) {
+    blend = std::min(1.f, blend+dt/blendDur);
+    k = mix(blendFrom,k,smooth(blend));
+    }
+  shown    = k;
+  hasShown = true;
+
+  tickFeet(rig,in,fr,k,dt);
+  toSpec(rig,in,fr,k,out);
+  }
diff --git a/common/game/fightbody.h b/common/game/fightbody.h
new file mode 100644
index 0000000..e0154fc
--- /dev/null
+++ b/common/game/fightbody.h
@@ -0,0 +1,188 @@
+#pragma once
+
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <functional>
+
+#include "graphics/mesh/bodyrig.h"
+
+// Gothic II Mobile: бой телом (регдолл в бою). Ни одной записанной анимации на экране: стойка, шаги, замах, удар,
+// блок, доставание оружия - процедурная поза (BodyRig), к которой тянутся мышцы куклы (Ragdoll, S_Active в режиме
+// боя). Анимации игры остаются часами: ИИ, комбо, окна блока и перемещение NPC идут, как в Gothic, а на экран
+// идёт тело куклы. Что делает ход, решает его вид и время в анимации (Clock: стадия комбо, миг удара -
+// OPTIMAL_FRAME), куда бить - цель (грудь, голова), куда ставить блок - клинок противника.
+//
+// Удар - дуга кисти вокруг плеча: замах назад по дуге (корпус закручивается, вес назад), разгон через точку удара
+// (клинок проходит сквозь цель на 0,7 своей длины), проводка дальше; кисть доворачивает клинок быстрее руки (как
+// кистевой хлёст). Не дотянуться - выпад: передняя нога шагает, таз и корпус - вперёд. Блок - клинок поперёк
+// пути клинка противника перед телом (или высокий блок, если тот ещё не бьёт). Ноги - шаги: ступня стоит, пока
+// NPC не ушёл от неё дальше порога, потом шагает дугой туда, где будет нужна (с упреждением по скорости).
+//
+// Попадание считает не анимация, а клинок куклы (Npc::tickBlade): окно удара - striking().
+class FightBody final {
+  public:
+    enum Weapon : uint8_t {
+      W_Fist = 0,
+      W_1H   = 1,
+      W_2H   = 2,
+      };
+    enum Move : uint8_t {
+      M_Guard     = 0,  // стойка, ходьба и бег в бою, развороты
+      M_Attack    = 1,  // вперёд - серия (стадии комбо)
+      M_AttackL   = 2,  // слева
+      M_AttackR   = 3,  // справа
+      M_AttackRun = 4,  // с разбега
+      M_Finish    = 5,  // добить лежащего
+      M_Parade    = 6,  // блок
+      M_JumpBack  = 7,  // отскок назад
+      M_Draw      = 8,  // достать оружие
+      M_Sheath    = 9,  // убрать
+      M_Hit       = 10, // отшатнуться (анимация удара по себе - её делает физика)
+      };
+
+    // Часы анимации игры (Npc::fightClock): какой ход и где он сейчас, с
+    struct Clock final {
+      Move     move      = M_Guard;
+      float    t         = 0;   // с начала анимации
+      float    total     = 0;   // длина анимации
+      float    stageFrom = 0;   // стадия серии (у одиночного удара - вся анимация)
+      float    stageTo   = 0;
+      float    strike    = -1;  // миг удара (OPTIMAL_FRAME) в стадии; <0 - нет
+      int      stage     = 0;
+      uint32_t id        = 0;   // новый ход или новая стадия - новый номер
+      float    swap      = -1;  // доставание/убирание: миг, когда оружие переходит в руку или в ножны
+      };
+
+    struct Input final {
+      Weapon        weapon   = W_1H;
+      Clock         clock;
+      Tempest::Vec3 root     = {};      // NPC на земле (мир, см)
+      Tempest::Vec3 fwd      = {0,0,1}; // куда смотрит NPC
+      Tempest::Vec3 vel      = {};      // скорость NPC, см/с
+      float         scale    = 1;       // масштаб модели
+      // цель удара
+      bool          target   = false;
+      Tempest::Vec3 tChest   = {}, tHead = {}, tPelvis = {};
+      bool          tDown    = false;   // лежит (добить)
+      // угроза - клинок (или кулак) противника, мир; скорость его середины, см/с
+      bool          threat   = false;
+      Tempest::Vec3 threatA  = {}, threatB = {}, threatVel = {};
+      // противник бьёт телом (его FightBody): куда придётся удар и куда идёт клинок - блок ставится навстречу
+      bool          threatAimed = false;
+      Tempest::Vec3 threatAt = {}, threatDir = {};
+      // ножны - где висит оружие (доставание и убирание), мир; нет - у правого бедра
+      bool          hasSheath= false;
+      Tempest::Vec3 sheath   = {};
+      float         bladeLen = 90;      // см от хвата до острия
+      Tempest::Vec3 bladeLocal = {};    // ось клинка в системе кисти (BodyRig::gripAxisInHand); 0 - по умолчанию
+      bool          inHand   = true;    // оружие в руке (не в ножнах)
+      float         lead     = 0.07f;   // с: поза хода берётся на столько вперёд - кукла отстаёт от цели мышц
+      std::function<float(const Tempest::Vec3&)> ground; // высота земли под точкой (шаги); пусто - root.y
+      };
+
+    // Поза этого кадра (цель мышц): dt - с
+    void          tick(const BodyRig& rig, const Input& in, float dt, BodyRig::Spec& out);
+    // Клинок сейчас разит: попадание засчитывается одно на удар (strikeId)
+    bool          striking()  const { return strikeOn; }
+    uint32_t      strikeId()  const { return strikeNo; }
+    // Насколько удар сейчас разгонён (0..1): сила попадания и отдача
+    float         strikePower() const { return strikePow; }
+    // Куда придётся удар (мир) и куда идёт кисть в миг удара - для блока противника; false - не бьёт
+    bool          strikeAim(Tempest::Vec3& at, Tempest::Vec3& dir) const;
+    // Блок поставлен (клинок в блоке, а не в стойке)
+    bool          blocking()  const { return blockW>0.5f; }
+    void          reset();
+
+    // Поза «стоит в бою» из нынешней позы тела (для начала): ступни - там, где стоят
+    void          plantFeet(const Tempest::Vec3& left, const Tempest::Vec3& right);
+
+    // Сила удара для отклика тела задетого (Ragdoll::Hit::power, м/с) по скорости клинка, см/с
+    static float  hitPower(Weapon w, float bladeSpeed);
+
+    // Поза в системе персонажа (x - влево, y - вверх, z - вперёд; см стандартного человека, масштаб - потом)
+    struct Key final {
+      Tempest::Vec3 pel   = {0,0,0};  // сдвиг таза от его места в стойке
+      float         drop  = 0;        // таз ниже, см
+      float         yaw   = 0, pitch = 0, roll = 0; // таз, рад (pitch + - вперёд)
+      float         flex  = 0, side = 0, twist = 0; // корпус
+      Tempest::Vec3 hand[2]  = {};     // хват (слот)
+      Tempest::Vec3 pole[2]  = {};
+      Tempest::Vec3 axis[2]  = {};     // ось хвата (у правой с оружием - клинок)
+      Tempest::Vec3 palm[2]  = {};
+      float         shrug[2] = {0,0};
+      Tempest::Vec3 step[2]  = {};     // ступни от места в стойке (выпад), см
+      };
+
+  private:
+    struct Foot final {
+      Tempest::Vec3 at    = {};    // лодыжка на земле, мир
+      Tempest::Vec3 toe   = {};    // куда носок
+      Tempest::Vec3 from  = {}, to = {}, toeFrom = {}, toeTo = {};
+      float         u     = -1;    // <0 - стоит, иначе доля шага
+      float         dur   = 0.3f;
+      float         lift  = 6;
+      bool          init  = false;
+      };
+
+    struct Frame final {
+      Tempest::Vec3 F, L, U, O;    // оси персонажа и точка на земле
+      float         k = 1;         // см стандартного человека -> мир
+      Tempest::Vec3 toWorld(const Tempest::Vec3& v) const { return O + (L*v.x + U*v.y + F*v.z)*k; }
+      Tempest::Vec3 dir(const Tempest::Vec3& v) const { return L*v.x + U*v.y + F*v.z; }
+      Tempest::Vec3 toLocal(const Tempest::Vec3& w) const;
+      Tempest::Vec3 dirLocal(const Tempest::Vec3& w) const;
+      };
+
+    // удар этой стадии: точка удара, дуга
+    struct Strike final {
+      uint32_t      id     = 0;
+      Tempest::Vec3 aimW   = {};     // точка удара (мир)
+      Tempest::Vec3 vW     = {};     // куда идёт кисть в миг удара (мир)
+      bool          active = false;
+      uint8_t       kind   = 0;
+      Tempest::Vec3 v      = {};     // куда идёт кисть в миг удара (система персонажа)
+      bool          thrust = false;
+      Tempest::Vec3 shoulder = {};   // система персонажа
+      Tempest::Vec3 hand   = {};     // хват в миг удара
+      Tempest::Vec3 blade  = {};     // клинок в миг удара
+      Tempest::Vec3 axis   = {};     // ось дуги (единичная)
+      float         wind   = -1.9f;  // рад: замах
+      float         follow = 1.0f;   // проводка
+      float         twistK = 0.45f;  // корпус за дугой
+      float         flexK  = 0;
+      float         lunge  = 0;      // см: выпад
+      int8_t        hand2  = 1;      // 0 - левая (кулак), 1 - правая
+      };
+
+    Key           guardKey(const Input& in) const;
+    Key           attackKey(const BodyRig& rig, const Input& in, const Frame& fr, float& arc);
+    Key           paradeKey(const BodyRig& rig, const Input& in, const Frame& fr) const;
+    Key           drawKey(const Input& in, const Frame& fr, bool draw) const;
+    void          planStrike(const BodyRig& rig, const Input& in, const Frame& fr);
+    void          aimStrike(const BodyRig& rig, const Input& in, const Frame& fr);
+    Key           arcKey(const Input& in, const Key& guard, float a) const;
+    void          tickFeet(const BodyRig& rig, const Input& in, const Frame& fr, const Key& k, float dt);
+    void          toSpec(const BodyRig& rig, const Input& in, const Frame& fr, const Key& k, BodyRig::Spec& out) const;
+    static Key    mix(const Key& a, const Key& b, float w);
+
+    Foot          foot[2];
+    Strike        str;
+    Key           shown;            // поза прошлого кадра (переходы между ходами - плавно)
+    bool          hasShown  = false;
