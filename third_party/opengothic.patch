+void TouchInput::openTravelMap() {
+  auto w  = Gothic::inst().world();
+  auto pl = w!=nullptr ? w->player() : nullptr;
+  if(pl==nullptr)
+    return;
+  mapTabs = TravelPoints::mapsOf(w->name());
+  std::vector<TravelPoints::Spot> spots;
+  if(!mapTabs.empty())
+    TravelPoints::resolve(*w,spots);
+  if(spots.empty()) {
+    Gothic::inst().onPrint(toCp1251("Здесь некуда отправиться"));
+    return;
+    }
+  mapSpots.clear();
+  for(auto& sp:spots) {
+    MapSpot ms;
+    ms.spot = sp;
+    ms.name = toCp1251(sp.point->name);
+    ms.pos  = sp.at->position();
+    mapSpots.push_back(std::move(ms));
+    }
+  mapOpen     = true;
+  mapFinger   = -1;
+  mapStatus.clear();
+  // Вкладка - там, где герой: в городе - карта города
+  mapTab = mapTabs[0];
+  for(auto m:mapTabs) {
+    if(m!=TravelPoints::M_City)
+      continue;
+    const auto uv = TravelPoints::toMap(m,pl->position());
+    if(uv.x>0.08f && uv.x<0.92f && uv.y>0.08f && uv.y<0.92f)
+      mapTab = m;
+    }
+  setMapTab(mapTab);
+  // Куда шли в прошлый раз - выбрано: продолжить путь - одно касание
+  for(size_t i=0; i<mapSpots.size(); ++i)
+    if(mapSpots[i].spot.point==lastTravel) {
+      setMapTab(lastTravel->map);
+      selectSpot(int(i));
+      }
+  Gothic::inst().pushPause();
+  Tempest::Log::i("[g2m] travel: map, ", int(mapSpots.size()), " points");
+  update();
+  }
+
+void TouchInput::closeTravelMap() {
+  if(!mapOpen)
+    return;
+  mapOpen   = false;
+  mapFinger = -1;
+  mapRoute.clear();
+  Gothic::inst().popPause();
+  update();
+  }
+
+void TouchInput::setMapTab(TravelPoints::Map m) {
+  mapTab    = m;
+  mapScroll = 0;
+  if(mapSel>=0 && (size_t(mapSel)>=mapSpots.size() || mapSpots[size_t(mapSel)].spot.point->map!=m))
+    selectSpot(-1);
+  }
+
+std::vector<int> TouchInput::mapRows() const {
+  std::vector<int> ret;
+  for(size_t i=0; i<mapSpots.size(); ++i)
+    if(mapSpots[i].spot.point->map==mapTab)
+      ret.push_back(int(i));
+  return ret;
+  }
+
+void TouchInput::selectSpot(int id) {
+  mapSel      = (id>=0 && size_t(id)<mapSpots.size()) ? id : -1;
+  mapStatus.clear();
+  mapRoute.clear();
+  mapRouteLen = -1;
+  auto w  = Gothic::inst().world();
+  auto pl = w!=nullptr ? w->player() : nullptr;
+  if(mapSel<0 || pl==nullptr)
+    return;
+  // Путь бегом - тот же поиск по сети путей, что у героя в пути
+  auto&      sp   = mapSpots[size_t(mapSel)].spot;
+  const auto from = pl->position();
+  const auto path = w->wayTo(*pl,*sp.way).points();
+  const auto wpos = sp.way->position();
+  const float dxw = wpos.x-from.x, dzw = wpos.z-from.z;
+  if(path.empty() && dxw*dxw+dzw*dzw>2000.f*2000.f &&
+     !pl->canRayHitPoint(wpos+Tempest::Vec3(0.f,60.f,0.f),true,6000.f))
+    return; // дороги нет
+  mapRoute.push_back(from);
+  for(auto wp:path)
+    mapRoute.push_back(wp->position());
+  if(path.empty())
+    mapRoute.push_back(wpos);
+  if(sp.at!=sp.way)
+    mapRoute.push_back(sp.at->position());
+  mapRouteLen = 0;
+  for(size_t i=1; i<mapRoute.size(); ++i) {
+    const float dx = mapRoute[i].x-mapRoute[i-1].x, dz = mapRoute[i].z-mapRoute[i-1].z;
+    mapRouteLen += std::sqrt(dx*dx+dz*dz);
+    }
+  // Выбранное - видно в списке
+  const auto l    = mapLayout();
+  const auto rows = mapRows();
+  for(size_t i=0; i<rows.size(); ++i) {
+    if(rows[i]!=mapSel)
+      continue;
+    const int y = int(i)*l.rowH;
+    if(y<mapScroll)
+      mapScroll = y;
+    if(y+l.rowH>mapScroll+l.list.h)
+      mapScroll = y+l.rowH-l.list.h;
+    }
+  }
+
+void TouchInput::travelTo(bool instant) {
+  if(mapSel<0) {
+    mapStatus = toCp1251("Сначала выбери место");
+    return;
+    }
+  if(!instant && mapRouteLen<0) {
+    mapStatus = toCp1251("Туда нет дороги - только мгновенно");
+    return;
+    }
+  if(auto why = ctrl.travelBlocked(instant)) {
+    mapStatus = toCp1251(why);
+    return;
+    }
+  const auto& sp = mapSpots[size_t(mapSel)].spot;
+  lastTravel = sp.point;
+  closeTravelMap();
+  PlayerControl::TravelOptions opt;
+  opt.fight = mapFight;
+  opt.loot  = mapLoot;
+  ctrl.startTravel(*sp.at,*sp.way,sp.point->name,instant,opt);
+  }
+
+TouchInput::MapLayout TouchInput::mapLayout() const {
+  MapLayout   l;
+  const float d = dp();
+  const int   m = int(12*d);
+  const int   W = w(), H = h();
+  auto&       mi = TravelPoints::info(mapTab);
+  // Карта - во всю высоту, с пропорциями мира (игра растягивала текстуру карты на экран 4:3), справа - список
+  const float aspect = float(mi.right-mi.left)/float(std::max(1,mi.top-mi.bottom));
+  int mh = H-2*m;
+  int mw = int(float(mh)*aspect);
+  const int maxW = W-3*m-int(300*d);
+  if(mw>maxW) {
+    mw = std::max(1,maxW);
+    mh = int(float(mw)/aspect);
+    }
+  l.map   = Rect(m, (H-mh)/2, mw, mh);
+  const int px = l.map.x+mw+m;
+  l.panel = Rect(px, m, W-px-m, H-2*m);
+
+  const int pad = int(12*d);
+  l.closeR = int(17*d);
+  l.close  = Point(l.panel.x+l.panel.w-pad-l.closeR, l.panel.y+pad+l.closeR);
+  int y = l.panel.y+pad+2*l.closeR+int(8*d);
+  l.tabs = mapTabs.size()>1 ? std::min<size_t>(mapTabs.size(),2) : 0;
+  if(l.tabs>0) {
+    const int tw = (l.panel.w-2*pad-int(8*d))/2;
+    for(size_t i=0; i<l.tabs; ++i)
+      l.tab[i] = Rect(l.panel.x+pad+int(i)*(tw+int(8*d)), y, tw, int(32*d));
+    y += int(32*d)+int(8*d);
+    }
+  const int bh = int(44*d);
+  const int bw = (l.panel.w-2*pad-int(8*d))/2;
+  l.run   = Rect(l.panel.x+pad,             l.panel.y+l.panel.h-pad-bh, bw, bh);
+  l.inst  = Rect(l.panel.x+pad+bw+int(8*d), l.panel.y+l.panel.h-pad-bh, bw, bh);
+  l.infoY = l.run.y-int(10*d);
+  // Галочки для пути бегом - над строкой о пути
+  const int oh = int(30*d);
+  const int oy = l.infoY-int(24*d)-oh;
+  l.opt[0] = Rect(l.panel.x+pad,             oy, bw, oh);
+  l.opt[1] = Rect(l.panel.x+pad+bw+int(8*d), oy, bw, oh);
+  l.rowH  = int(28*d);
+  const int listBottom = oy-int(8*d);
+  l.list  = Rect(l.panel.x+pad, y, l.panel.w-2*pad, std::max(l.rowH, listBottom-y));
+  return l;
+  }
+
+Point TouchInput::mapToScreen(const MapLayout& l, const Tempest::Vec3& pos) const {
+  const auto uv = TravelPoints::toMap(mapTab,pos);
+  return Point(l.map.x+int(uv.x*float(l.map.w)), l.map.y+int(uv.y*float(l.map.h)));
+  }
+
+static Tempest::Vec3 cityCenter() {
+  auto& ci = TravelPoints::info(TravelPoints::M_City);
+  return Tempest::Vec3(float(ci.left+ci.right)*0.5f, 0.f, float(ci.top+ci.bottom)*0.5f);
+  }
+
+void TouchInput::mapTap(Point p) {
+  const auto  l    = mapLayout();
+  const float d    = dp();
+  const int   slop = int(8*d);
+  {
+  const int dx = p.x-l.close.x, dy = p.y-l.close.y, r = l.closeR+slop;
+  if(dx*dx+dy*dy<=r*r) {
+    closeTravelMap();
+    return;
+    }
+  }
+  for(size_t i=0; i<l.tabs; ++i)
+    if(l.tab[i].contains(p)) {
+      setMapTab(mapTabs[i]);
+      return;
+      }
+  if(l.opt[0].contains(p)) {
+    mapFight = !mapFight;
+    return;
+    }
+  if(l.opt[1].contains(p)) {
+    mapLoot = !mapLoot;
+    return;
+    }
+  if(Rect(l.run.x-slop/2,l.run.y-slop/2,l.run.w+slop,l.run.h+slop).contains(p)) {
+    travelTo(false);
+    return;
+    }
+  if(Rect(l.inst.x-slop/2,l.inst.y-slop/2,l.inst.w+slop,l.inst.h+slop).contains(p)) {
+    travelTo(true);
+    return;
+    }
+  if(l.list.contains(p)) {
+    const auto rows = mapRows();
+    const int  row  = (p.y-l.list.y+mapScroll)/std::max(1,l.rowH);
+    if(row>=0 && size_t(row)<rows.size())
+      selectSpot(rows[size_t(row)]);
+    return;
+    }
+  if(!l.map.contains(p))
+    return;
+  // Город на карте острова - открыть карту города
+  const bool hasCity = std::find(mapTabs.begin(),mapTabs.end(),TravelPoints::M_City)!=mapTabs.end();
+  const int  pick    = int(26*d);
+  if(mapTab==TravelPoints::M_Island && hasCity) {
+    const auto c  = mapToScreen(l,cityCenter());
+    const int  dx = p.x-c.x, dy = p.y-c.y;
+    if(dx*dx+dy*dy<=pick*pick) {
+      setMapTab(TravelPoints::M_City);
+      return;
+      }
+    }
+  int best = -1, bestD = pick*pick;
+  for(int id:mapRows()) {
+    const auto c  = mapToScreen(l,mapSpots[size_t(id)].pos);
+    const int  dx = p.x-c.x, dy = p.y-c.y;
+    if(dx*dx+dy*dy<bestD) {
+      bestD = dx*dx+dy*dy;
+      best  = id;
+      }
+    }
+  if(best>=0)
+    selectSpot(best);
+  }
+
+void TouchInput::drawPanel(Painter& p, const Rect& r) {
+  // Тёмная кожа с рамкой старой бронзы
+  const int b = std::max(1, int(1.5f*dp()));
+  p.setBrush(Color(0.36f,0.27f,0.16f,0.95f));
+  p.drawRect(r.x-b, r.y-b, r.w+2*b, r.h+2*b);
+  p.setBrush(Color(0.07f,0.055f,0.045f,0.94f));
+  p.drawRect(r.x, r.y, r.w, r.h);
+  }
+
+void TouchInput::drawText(Painter& p, std::string_view txt, int x, int y, bool hi, float scale) {
+  // y - верх строки
+  auto&      fnt = Resources::font(hi ? Resources::FontType::Hi : Resources::FontType::Normal, Gothic::interfaceScale(this)*scale);
+  const auto sz  = fnt.textSize(txt);
+  fnt.drawText(p, x, y+sz.h, txt);
+  }
+
+void TouchInput::drawTravelMap(Painter& p) {
+  auto        wr = Gothic::inst().world();
+  auto        pl = wr!=nullptr ? wr->player() : nullptr;
+  const auto  l  = mapLayout();
+  const float d  = dp();
+  auto&       mi = TravelPoints::info(mapTab);
+
+  // Мир под картой - темнее; сама карта - текстура из игры
+  p.setBrush(Color(0.f,0.f,0.f,0.75f));
+  p.drawRect(0,0,w(),h());
+  if(auto tex = Resources::loadTexture(mi.texture)) {
+    p.setBrush(Brush(*tex,Color(1.f)));
+    p.drawRect(l.map.x,l.map.y,l.map.w,l.map.h, 0,0,tex->w(),tex->h());
+    } else {
+    p.setBrush(Color(0.55f,0.45f,0.30f,1.f));
+    p.drawRect(l.map);
+    }
+
+  auto& fnt = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this)*0.72f);
+  auto  tag = [&](std::string_view txt, Point c, int off, bool hi) {
+    // подпись места справа от метки на тёмной подложке - читается на светлом пергаменте
+    auto&      f  = hi ? Resources::font(Resources::FontType::Hi, Gothic::interfaceScale(this)*0.78f) : fnt;
+    const auto ts = f.textSize(txt);
+    int x = c.x+off;
+    if(x+ts.w+int(4*d)>l.map.x+l.map.w)
+      x = c.x-off-ts.w; // у правого края - слева от метки
+    p.setBrush(Color(0.f,0.f,0.f,0.55f));
+    p.drawRect(x-int(3*d), c.y-ts.h/2-int(2*d), ts.w+int(6*d), ts.h+int(4*d));
+    f.drawText(p, x, c.y+ts.h/2, txt);
+    };
+
+  // Путь бегом к выбранному месту - золотые точки
+  if(mapRoute.size()>1) {
+    const float step = 9*d;
+    float       acc  = 0;
+    for(size_t i=1; i<mapRoute.size(); ++i) {
+      const auto  a  = mapToScreen(l,mapRoute[i-1]);
+      const auto  b  = mapToScreen(l,mapRoute[i]);
+      const float dx = float(b.x-a.x), dy = float(b.y-a.y);
+      const float sl = std::sqrt(dx*dx+dy*dy);
+      while(acc<=sl) {
+        const float t = sl>0 ? acc/sl : 0.f;
+        drawGlyph(p, TouchIcons::I_Dot, Point(a.x+int(dx*t), a.y+int(dy*t)), std::max(4,int(5*d)), GoldBright);
+        acc += step;
+        }
+      acc -= sl;
+      }
+    }
+
+  // Город на карте острова: одна метка - коснуться, чтобы открыть карту города
+  const bool hasCity = std::find(mapTabs.begin(),mapTabs.end(),TravelPoints::M_City)!=mapTabs.end();
+  if(mapTab==TravelPoints::M_Island && hasCity) {
+    Button cb;
+    cb.c = mapToScreen(l,cityCenter());
+    cb.r = int(13*d);
+    drawRound(p, cb, TouchIcons::I_City, false, false, 1.f);
+    tag(toCp1251("Город"), cb.c, cb.r+int(4*d), false);
+    }
+
+  const auto rows = mapRows();
+  for(int id:rows) {
+    auto&      ms    = mapSpots[size_t(id)];
+    const bool sel   = (id==mapSel);
+    const bool major = ms.spot.point->major;
+    Button     b;
+    b.c = mapToScreen(l,ms.pos);
+    b.r = int((major ? 9.f : 6.5f)*d) + (sel ? int(3*d) : 0);
+    const int ds = int(float(2*b.r)/0.88f);
+    if(sel) {
+      const int gs = int(float(ds)*1.6f);
+      drawGlow(p, Rect(b.c.x-gs/2, b.c.y-gs/2, gs, gs), ds, 0.9f);
+      }
+    auto& disc = icons.disc(ds);
+    p.setBrush(Brush(disc,Color(1.f)));
+    p.drawRect(b.c.x-ds/2, b.c.y-ds/2, ds, ds, 0,0,disc.w(),disc.h());
+    drawGlyph(p, TouchIcons::I_Dot, b.c, int(float(b.r)*0.9f), sel ? GoldBright : (major ? GoldIdle : GoldDim));
+    if(major || sel)
+      tag(ms.name, b.c, b.r+int(4*d), sel);
+    }
+
+  // Герой - стрелка, как на карте игры
+  if(pl!=nullptr) {
+    const auto c   = mapToScreen(l,pl->position());
+    auto       cur = Resources::loadTexture("U.TGA");
+    if(cur!=nullptr && l.map.contains(c)) {
+      const int sz = int(24*d);
+      p.setBrush(*cur);
+      p.pushState();
+      p.translate(c.x,c.y);
+      p.rotate(-pl->rotation()-90);
+      p.drawRect(-sz/2,-sz/2,sz,sz, 0,0,cur->w(),cur->h());
+      p.popState();
+      }
+    }
+
+  // Справа - название карты, вкладки, список мест, кнопки
+  drawPanel(p, l.panel);
+  const int pad = int(12*d);
+  drawText(p, toCp1251(mi.title), l.panel.x+pad, l.panel.y+pad+int(6*d), true, 1.f);
+  {
+  Button cb;
+  cb.c = l.close;
+  cb.r = l.closeR;
+  drawRound(p, cb, TouchIcons::I_Stop, false, false, 1.f);
+  }
+  for(size_t i=0; i<l.tabs; ++i) {
+    const bool city = mapTabs[i]==TravelPoints::M_City;
+    drawPill(p, l.tab[i], city ? TouchIcons::I_City : TouchIcons::I_Map, toCp1251(city ? "Город" : "Остров"), mapTabs[i]==mapTab);
+    }
+
+  p.pushState();
+  p.setScissor(l.list);
+  auto& rf = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this)*0.85f);
+  auto& rh = Resources::font(Resources::FontType::Hi,     Gothic::interfaceScale(this)*0.85f);
+  for(size_t i=0; i<rows.size(); ++i) {
+    const int y = l.list.y+int(i)*l.rowH-mapScroll;
+    if(y+l.rowH<l.list.y || y>l.list.y+l.list.h)
+      continue;
+    auto&      ms  = mapSpots[size_t(rows[i])];
+    const bool sel = (rows[i]==mapSel);
+    if(sel) {
+      p.setBrush(Color(0.85f,0.62f,0.30f,0.22f));
+      p.drawRect(l.list.x, y+int(2*d), l.list.w, l.rowH-int(4*d));
+      }
+    const int gs = int(8*d);
+    drawGlyph(p, TouchIcons::I_Dot, Point(l.list.x+int(8*d), y+l.rowH/2), gs,
+              sel ? GoldBright : (ms.spot.point->major ? GoldIdle : GoldDim));
+    std::string dist;
+    if(pl!=nullptr) {
+      const float dx = ms.pos.x-pl->position().x, dz = ms.pos.z-pl->position().z;
+      dist = distText(std::sqrt(dx*dx+dz*dz));
+      }
+    auto&      f    = sel ? rh : rf;
+    const auto dw   = rf.textSize(dist).w;
+    const int  tx   = l.list.x+int(20*d);
+    const auto name = fit(ms.name, l.list.w-int(20*d)-dw-int(12*d), 0.85f);
+    const auto ts   = f.textSize(name);
+    f.drawText(p, tx, y+(l.rowH+ts.h)/2, name);
+    rf.drawText(p, l.list.x+l.list.w-dw-int(4*d), y+(l.rowH+ts.h)/2, dist);
+    }
+  p.popState();
+  p.setScissor(0,0,w(),h());
+
+  // Что будет: длина пути бегом или почему нельзя
+  std::string info;
+  if(!mapStatus.empty())
+    info = mapStatus;
+  else if(mapSel<0)
+    info = toCp1251("Выбери место на карте или в списке");
+  else if(mapRouteLen<0)
+    info = toCp1251("Дороги нет - только мгновенно");
+  else
+    info = toCp1251("Бегом по дороге: ") + distText(mapRouteLen);
+  drawText(p, fit(info, l.panel.w-2*pad, 0.8f), l.panel.x+pad, l.infoY-int(18*d), false, 0.8f);
+
+  drawPill(p, l.opt[0], mapFight ? TouchIcons::I_BoxOn : TouchIcons::I_BoxOff, toCp1251("Сражаться"),    mapFight);
+  drawPill(p, l.opt[1], mapLoot  ? TouchIcons::I_BoxOn : TouchIcons::I_BoxOff, toCp1251("Собирать лут"), mapLoot);
+
+  const bool canRun = mapSel>=0 && mapRouteLen>=0;
+  drawPill(p, l.run,  TouchIcons::I_Run,      toCp1251("Бегом"),     false);
+  drawPill(p, l.inst, TouchIcons::I_Teleport, toCp1251("Мгновенно"), false);
+  // Недоступное - притушено
+  p.setBrush(Color(0.f,0.f,0.f,0.5f));
+  if(!canRun)
+    p.drawRect(l.run);
+  if(mapSel<0)
+    p.drawRect(l.inst);
+  }
