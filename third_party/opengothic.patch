+int DialogMenu::touchChoiceAt(Point p) const {
+  // Gothic II Mobile: та же раскладка, что в paintChoice
+  if(!isChoiceMenuActive())
+    return -1;
+  const float scale = Gothic::interfaceScale(this);
+  const int   padd  = int(20*scale);
+  const int   dw    = std::min(w(),int(600*scale));
+  auto        fnt   = Resources::dialogFont(scale);
+
+  std::vector<int> rows;
+  int dh = padd*2;
+  for(auto& c:choice) {
+    const int ch = fnt.textSize(dw-padd, c.title).h;
+    rows.push_back(ch);
+    dh += ch;
+    }
+  const int x = (w()-dw)/2;
+  const int y = h()-dh-int(20*scale);
+  if(p.x<x || p.x>=x+dw)
+    return -1;
+  // Шрифт рисует первую строку над точкой вывода, остальные - ниже неё
+  int off = padd;
+  for(size_t i=0; i<rows.size(); ++i) {
+    const int top = y+padd+off-fnt.pixelSize();
+    if(p.y>=top && p.y<top+rows[i])
+      return int(i);
+    off += rows[i];
+    }
+  return -1;
+  }
