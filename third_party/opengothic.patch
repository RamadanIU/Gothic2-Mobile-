+Vec3 originOf(const Matrix4x4& m) {
+  return Vec3(m.at(3,0), m.at(3,1), m.at(3,2));
+  }
+
+Vec3 axisOf(const Matrix4x4& m, int c) {
+  return Vec3(m.at(c,0), m.at(c,1), m.at(c,2));
+  }
+
+Matrix4x4 inverseOf(Matrix4x4 m) {
+  m.inverse();
+  return m;
+  }
+
+// Ортонормированная система координат: x - заданное направление, y - ближе всего к подсказке
+Matrix4x4 mkFrame(const Vec3& at, Vec3 x, const Vec3& hintY, const Vec3& hintZ) {
+  x = Vec3::normalize(x);
+  Vec3 y = hintY - x*Vec3::dotProduct(hintY,x);
+  if(y.length()<0.2f*hintY.length() || y.length()<1e-4f)
+    y = hintZ - x*Vec3::dotProduct(hintZ,x);
+  if(y.length()<1e-4f)
+    y = std::abs(x.y)<0.9f ? Vec3(0,1,0) - x*x.y : Vec3(1,0,0) - x*x.x;
+  y = Vec3::normalize(y);
+  Vec3 z = Vec3::crossProduct(x,y);
+
+  Matrix4x4 m = Matrix4x4::mkIdentity();
+  m.set(0,0,x.x);  m.set(0,1,x.y);  m.set(0,2,x.z);
+  m.set(1,0,y.x);  m.set(1,1,y.y);  m.set(1,2,y.z);
+  m.set(2,0,z.x);  m.set(2,1,z.y);  m.set(2,2,z.z);
+  m.set(3,0,at.x); m.set(3,1,at.y); m.set(3,2,at.z);
+  return m;
+  }
+
+btTransform toBt(const Matrix4x4& m) {
+  btVector3 x(m.at(0,0), m.at(0,1), m.at(0,2));
+  btVector3 y(m.at(1,0), m.at(1,1), m.at(1,2));
+  x.normalize();
+  y = y - x*x.dot(y);
+  y.normalize();
+  btVector3 z = x.cross(y);
+  btMatrix3x3 basis(x.x(), y.x(), z.x(),
+                    x.y(), y.y(), z.y(),
+                    x.z(), y.z(), z.z());
+  return btTransform(basis, btVector3(m.at(3,0), m.at(3,1), m.at(3,2))*0.01f);
+  }
+
+Matrix4x4 fromBt(const btTransform& t) {
+  Matrix4x4 m;
+  t.getOpenGLMatrix(reinterpret_cast<btScalar*>(&m));
+  m.set(3,0,m.at(3,0)*100.f);
+  m.set(3,1,m.at(3,1)*100.f);
+  m.set(3,2,m.at(3,2)*100.f);
+  return m;
+  }
+
+float segmentDistance(const Vec3& p1, const Vec3& q1, const Vec3& p2, const Vec3& q2) {
+  // расстояние между отрезками (Ericson, Real-Time Collision Detection, 5.1.9)
+  const Vec3  d1 = q1-p1, d2 = q2-p2, r = p1-p2;
+  const float a  = Vec3::dotProduct(d1,d1), e = Vec3::dotProduct(d2,d2), f = Vec3::dotProduct(d2,r);
+  float s = 0, t = 0;
+  if(a<=1e-6f && e<=1e-6f)
+    return (p1-p2).length();
+  if(a<=1e-6f) {
+    t = std::clamp(f/e, 0.f, 1.f);
+    } else {
+    const float c = Vec3::dotProduct(d1,r);
+    if(e<=1e-6f) {
+      s = std::clamp(-c/a, 0.f, 1.f);
+      } else {
+      const float b     = Vec3::dotProduct(d1,d2);
+      const float denom = a*e-b*b;
+      s = denom>1e-6f ? std::clamp((b*f-c*e)/denom, 0.f, 1.f) : 0.f;
+      t = (b*s+f)/e;
+      if(t<0.f) {
+        t = 0.f;
+        s = std::clamp(-c/a, 0.f, 1.f);
+        }
+      else if(t>1.f) {
+        t = 1.f;
+        s = std::clamp((b-c)/a, 0.f, 1.f);
+        }
+      }
+    }
+  return ((p1+d1*s)-(p2+d2*t)).length();
+  }
+
+// Ближайшие точки отрезков p1-q1 и p2-q2 (как segmentDistance), м
+void closestOnSegments(const btVector3& p1, const btVector3& q1, const btVector3& p2, const btVector3& q2,
+                       btVector3& c1, btVector3& c2) {
+  const btVector3 d1 = q1-p1, d2 = q2-p2, r = p1-p2;
+  const float a = float(d1.dot(d1)), e = float(d2.dot(d2)), f = float(d2.dot(r));
+  float s = 0, t = 0;
+  if(a<=1e-8f && e<=1e-8f) {
+    s = 0; t = 0;
+    }
+  else if(a<=1e-8f) {
+    t = std::clamp(f/e, 0.f, 1.f);
+    }
+  else {
+    const float c = float(d1.dot(r));
+    if(e<=1e-8f) {
+      s = std::clamp(-c/a, 0.f, 1.f);
+      } else {
+      const float b     = float(d1.dot(d2));
+      const float denom = a*e-b*b;
+      s = denom>1e-8f ? std::clamp((b*f-c*e)/denom, 0.f, 1.f) : 0.f;
+      t = (b*s+f)/e;
+      if(t<0.f) {
+        t = 0.f;
+        s = std::clamp(-c/a, 0.f, 1.f);
+        }
+      else if(t>1.f) {
+        t = 1.f;
+        s = std::clamp((b-c)/a, 0.f, 1.f);
+        }
+      }
+    }
+  c1 = p1+d1*s;
+  c2 = p2+d2*t;
+  }
+
+// Мягкий упор тела a в b (b == nullptr - в неподвижное, ведомое анимацией) в точке at, n - нормаль от b к a, depth -
+// насколько вошло, м. Как контакт решателя: скорость сближения гасится, вошедшее выталкивается не быстрее 0,8 м/с
+// (без рывка), трение гасит скольжение
+void softContact(btRigidBody& a, btRigidBody* b, const btVector3& at, const btVector3& n, float depth, float dt) {
+  const btVector3 ra = at - a.getCenterOfMassPosition();
+  btVector3       v  = a.getVelocityInLocalPoint(ra);
+  btVector3       rb = btVector3(0,0,0);
+  if(b!=nullptr) {
+    rb  = at - b->getCenterOfMassPosition();
+    v  -= b->getVelocityInLocalPoint(rb);
+    }
+  const float vn   = float(v.dot(n));
+  const float want = std::min(0.25f*depth/dt, 0.8f);
+  if(vn>=want)
+    return;
+  const float kn = float(a.computeImpulseDenominator(at,n)) + (b!=nullptr ? float(b->computeImpulseDenominator(at,n)) : 0.f);
+  if(kn<1e-6f)
+    return;
+  const float jn  = (want-vn)/kn;
+  btVector3   imp = n*jn;
+  btVector3   vt  = v - n*vn;
+  const float vtl = float(vt.length());
+  if(vtl>1e-4f) {
+    const btVector3 t  = vt/vtl;
+    const float     kt = float(a.computeImpulseDenominator(at,t)) + (b!=nullptr ? float(b->computeImpulseDenominator(at,t)) : 0.f);
+    if(kt>1e-6f)
+      imp -= t*std::min(vtl/kt, 0.5f*jn);
+    }
+  a.activate();
+  a.applyImpulse(imp, ra);
+  if(b!=nullptr) {
+    b->activate();
+    b->applyImpulse(-imp, rb);
+    }
+  }
