+void AiNpc::teachBegin(Npc& player) {
+  if(!teachStarted) {
+    teachStarted = true;
+    teachLearned.clear();
+    for(size_t i=0; i<std::size(Attrs); ++i)
+      teachBefore.atr[i] = player.attribute(Attrs[i].atr);
+    for(size_t i=0; i<std::size(Weapons); ++i)
+      teachBefore.hit[i] = player.hitChance(Weapons[i].talent);
+    teachBefore.circle = player.talentSkill(TALENT_MAGE);
+    teachBefore.hack   = hackChance();
+    }
+  teachPage = TeachPage::Main;
+  }
+
+int32_t AiNpc::teachCall(std::string_view fn, Npc& player, std::initializer_list<int32_t> args) {
+  if(geralt==nullptr)
+    return -1;
+  // Цена урока списывается функцией игры - на время вызова очков с запасом, потом прежние: урок даром
+  auto&         h  = player.handle();
+  const int32_t lp = h.lp;
+  h.lp = 1000000;
+  owner.quests.skipRepeats = true;
+  const int32_t ret = owner.invokeTeach(fn,*geralt,player,args);
+  owner.quests.skipRepeats = false;
+  h.lp = lp;
+  if(ret<0)
+    Log::e("[g2m] ai: teach - no ",fn," in scripts");
+  return ret;
+  }
+
+bool AiNpc::listExists(size_t list) {
+  if(list>=L_Count)
+    return false;
+  auto* fn = owner.findSymbol(Lists[list].fn);
+  if(fn==nullptr || fn->type()!=zenkit::DaedalusDataType::FUNCTION)
+    return false;
+  return Lists[list].known==nullptr || owner.findSymbol(Lists[list].known)!=nullptr;
+  }
+
+bool AiNpc::lessonKnown(Npc& player, size_t list, size_t lesson) {
+  const LessonList& l  = Lists[list];
+  const int32_t     id = owner.scriptConst(l.items[lesson].sym,-1);
+  if(id<0)
+    return true; // в этой версии скриптов такого умения нет - учить нечему
+  if(l.known==nullptr)
+    return id<TALENT_MAX_G2 && player.talentSkill(Talent(id))>0;
+  auto* arr = owner.findSymbol(l.known);
+  if(arr==nullptr || uint32_t(id)>=arr->count())
+    return true;
+  return arr->get_int(uint16_t(id))!=0;
+  }
+
+void AiNpc::unlearned(Npc& player, size_t list, std::vector<size_t>& out) {
+  out.clear();
+  if(!listExists(list))
+    return;
+  for(size_t i=0; i<Lists[list].count; ++i)
+    if(!lessonKnown(player,list,i))
+      out.push_back(i);
+  }
+
+size_t AiNpc::learnAll(Npc& player, size_t list) {
+  std::vector<size_t> todo;
+  unlearned(player,list,todo);
+  size_t n = 0;
+  for(auto i:todo) {
+    const int32_t id = owner.scriptConst(Lists[list].items[i].sym,-1);
+    if(teachCall(Lists[list].fn,player,{id})<0)
+      break;
+    if(lessonKnown(player,list,i)) {
+      teachLearned.push_back(Lists[list].items[i].title);
+      ++n;
+      }
+    }
+  return n;
+  }
+
+void AiNpc::teachAttr(Npc& player, size_t attr, int32_t points) {
+  const AttrLesson& a   = Attrs[attr];
+  const int32_t     cur = player.attribute(a.atr);
+  points = std::min(points,a.max-cur);
+  if(points<=0)
+    return;
+  if(a.atr==ATR_HITPOINTSMAX) {
+    // Учителей здоровья в игре нет: B_RaiseAttribute - как эликсир жизни (надпись «Здоровье +…»); раны не лечит
+    auto& h = player.handle();
+    if(teachCall("B_RAISEATTRIBUTE",player,{int32_t(a.atr),points})<0)
+      h.attribute[ATR_HITPOINTSMAX] += points;
+    h.attribute[ATR_HITPOINTS] = std::min(h.attribute[ATR_HITPOINTS]+points,h.attribute[ATR_HITPOINTSMAX]);
+    return;
+    }
+  teachCall("B_TEACHATTRIBUTEPOINTS",player,{int32_t(a.atr),points,a.max});
+  }
+
+void AiNpc::teachWeapon(Npc& player, int32_t talent, int32_t points) {
+  const int32_t cur = player.hitChance(Talent(talent));
+  points = std::min(points,WeaponMax-cur);
+  if(points<=0)
+    return;
+  teachCall("B_TEACHFIGHTTALENTPERCENT",player,{talent,points,WeaponMax});
+  // Скрипт тянет за одноручным и двуручное (и лук за арбалетом), если отстаёт на 30 - выше 100 % не пускать
+  auto& h = player.handle();
+  for(auto& w:Weapons)
+    h.hitchance[w.talent] = std::min(h.hitchance[w.talent],WeaponMax);
+  }
+
+void AiNpc::teachCircle(Npc& player, int32_t upTo) {
+  for(int32_t c=player.talentSkill(TALENT_MAGE)+1; c<=std::min(upTo,CircleMax); ++c)
+    if(teachCall("B_TEACHMAGICCIRCLE",player,{c})<=0)
+      break;
+  }
+
+int32_t AiNpc::hackChance() const {
+  // Добыча золота (аддон): глобальная HERO_HACKCHANCE; в классике её нет
+  auto* s = owner.findSymbol("HERO_HACKCHANCE");
+  if(s==nullptr || s->type()!=zenkit::DaedalusDataType::INT || owner.findSymbol("B_UPGRADE_HERO_HACKCHANCE")==nullptr)
+    return -1;
+  return s->get_int();
+  }
+
+void AiNpc::teachHack(Npc& player, int32_t points) {
+  const int32_t cur = hackChance();
+  if(cur<0)
+    return;
+  points = std::min(points,HackMax-cur);
+  if(points>0)
+    teachCall("B_UPGRADE_HERO_HACKCHANCE",player,{points});
+  }
+
+void AiNpc::teachAllSkills(Npc& player) {
+  for(auto& w:Weapons)
+    teachWeapon(player,w.talent,WeaponMax);
+  for(size_t l=0; l<L_Count; ++l)
+    learnAll(player,l);
+  teachCircle(player,CircleMax);
+  teachHack(player,HackMax);
+  Gothic::inst().onPrint(toCp1251("Геральт научил тебя всем умениям"));
+  }
+
+void AiNpc::teachChoices(Npc& player, std::vector<GameScript::DlgChoice>& out) {
+  int32_t sort = 0;
+  auto add = [&](uint32_t code, const std::string& title) {
+    GameScript::DlgChoice ch;
+    ch.title    = toCp1251(title);
+    ch.scriptFn = TeachChoice | (code & 0xFFFFu);
+    ch.sort     = ++sort;
+    out.push_back(std::move(ch));
+    };
+
+  switch(teachPage) {
+    case TeachPage::None:
+      break;
+    case TeachPage::Main: {
+      add(T_Attr,"Сила, ловкость, мана, здоровье");
+      add(T_Weapons,"Владение оружием");
+      for(size_t l:{L_Thief, L_Trophy, L_Alchemy, L_Smith})
+        if(listExists(l))
+          add(T_List+uint32_t(l),Lists[l].title);
+      add(T_Magic,"Магия: круги и руны");
+      if(listExists(L_Language) || listExists(L_Wisp) || hackChance()>=0)
+        add(T_Other,"Прочее: язык зодчих, огонек, добыча золота");
+      add(T_AllSkills,"Научи меня всем умениям сразу");
+      add(T_Back,"Назад");
+      break;
+      }
+    case TeachPage::Attr: {
+      for(size_t i=0; i<std::size(Attrs); ++i)
+        add(T_AttrOne+uint32_t(i),std::string(Attrs[i].name)+" (сейчас "+num(player.attribute(Attrs[i].atr))+")");
+      add(T_Back,"Назад");
+      break;
+      }
+    case TeachPage::AttrOne: {
+      const AttrLesson& a    = Attrs[teachAttrId];
+      const int32_t     cur  = player.attribute(a.atr);
+      const int32_t     left = a.max-cur;
+      if(left<=0) {
+        add(T_Back,std::string(a.name)+" уже "+num(cur)+" - больше не научу. Назад");
+        break;
+        }
+      bool first = true;
+      for(size_t i=0; i<std::size(a.steps); ++i) {
+        if(a.steps[i]<=0 || a.steps[i]>left)
+          continue;
+        std::string t = "+"+num(a.steps[i])+" "+a.to;
+        if(first)
+          t += " (сейчас "+num(cur)+")";
+        first = false;
+        add(T_AttrStep+uint32_t(i),t);
+        }
+      add(T_AttrMax,std::string(a.name)+" до "+num(a.max));
+      add(T_Back,"Назад");
+      break;
+      }
+    case TeachPage::Weapons: {
+      bool any = false;
+      for(size_t i=0; i<std::size(Weapons); ++i) {
+        const int32_t cur = player.hitChance(Weapons[i].talent);
+        if(cur>=WeaponMax)
+          continue;
+        any = true;
+        add(T_Weapon+uint32_t(i*2),  std::string(Weapons[i].name)+" +"+num(std::min(WeaponStep,WeaponMax-cur))+
+                                    "% (сейчас "+num(cur)+"%)");
+        add(T_Weapon+uint32_t(i*2+1),std::string(Weapons[i].name)+" до "+num(WeaponMax)+"%");
+        }
+      if(any)
+        add(T_AllWeapons,"Все оружие до "+num(WeaponMax)+"%");
+      add(T_Back,any ? "Назад" : "Всем оружием ты уже владеешь на 100%. Назад");
+      break;
+      }
+    case TeachPage::List: {
+      std::vector<size_t> todo;
+      unlearned(player,teachListId,todo);
+      if(todo.empty()) {
+        add(T_Back,std::string(Lists[teachListId].title)+": ты уже знаешь все. Назад");
+        break;
+        }
+      if(todo.size()>1)
+        add(T_ListAll,std::string(Lists[teachListId].title)+": все сразу");
+      if(teachFrom>=todo.size())
+        teachFrom = 0;
+      for(size_t i=teachFrom; i<todo.size() && i<teachFrom+ListPage; ++i)
+        add(T_Lesson+uint32_t(todo[i]),Lists[teachListId].items[todo[i]].title);
+      if(todo.size()>ListPage)
+        add(T_ListMore,"Дальше...");
+      add(T_Back,"Назад");
+      break;
+      }
+    case TeachPage::Magic: {
+      const int32_t circle = player.talentSkill(TALENT_MAGE);
+      if(circle<CircleMax)
+        add(T_NextCircle,"Круг магии "+num(circle+1)+" (сейчас "+num(circle)+")");
+      if(circle+1<CircleMax)
+        add(T_AllCircles,"Все круги магии, до "+num(CircleMax)+"-го");
+      if(listExists(L_Runes))
+        add(T_List+uint32_t(L_Runes),Lists[L_Runes].title);
+      add(T_Back,"Назад");
+      break;
+      }
+    case TeachPage::Other: {
+      for(size_t l:{L_Language, L_Wisp})
+        if(listExists(l))
+          add(T_List+uint32_t(l),Lists[l].title);
+      const int32_t hack = hackChance();
+      if(hack>=0 && hack<HackMax) {
+        add(T_HackStep,"Добыча золота +"+num(std::min(HackStep,HackMax-hack))+"% (сейчас "+num(hack)+"%)");
+        add(T_HackMax,"Добыча золота до "+num(HackMax)+"%");
+        }
+      add(T_Back,"Назад");
+      break;
+      }
+    }
+  }
+
+bool AiNpc::execTeach(uint32_t code, Npc& player) {
+  if(geralt==nullptr || teachPage==TeachPage::None)
+    return false;
+
+  if(code==T_Back) {
+    switch(teachPage) {
+      case TeachPage::Main:    teachPage = TeachPage::None; break;
+      case TeachPage::AttrOne: teachPage = TeachPage::Attr; break;
+      case TeachPage::List:    teachPage = teachListBack;   break;
+      default:                 teachPage = TeachPage::Main; break;
+      }
+    return true;
+    }
+
+  auto openList = [&](size_t l) {
+    if(l>=L_Count)
+      return;
+    teachListBack = teachPage;
+    teachListId   = l;
+    teachFrom     = 0;
+    teachPage     = TeachPage::List;
+    };
+
+  if(code==T_Attr)       { teachPage = TeachPage::Attr;    return true; }
+  if(code==T_Weapons)    { teachPage = TeachPage::Weapons; return true; }
+  if(code==T_Magic)      { teachPage = TeachPage::Magic;   return true; }
+  if(code==T_Other)      { teachPage = TeachPage::Other;   return true; }
+  if(code==T_AllSkills)  { teachAllSkills(player);         return true; }
+  if(code==T_NextCircle) { teachCircle(player,player.talentSkill(TALENT_MAGE)+1); return true; }
+  if(code==T_AllCircles) { teachCircle(player,CircleMax);  return true; }
+  if(code==T_HackStep)   { teachHack(player,HackStep);     return true; }
+  if(code==T_HackMax)    { teachHack(player,HackMax);      return true; }
+  if(code==T_AllWeapons) {
+    for(auto& w:Weapons)
+      teachWeapon(player,w.talent,WeaponMax);
+    return true;
+    }
+  if(code==T_ListAll) {
+    const size_t n = learnAll(player,teachListId);
+    if(n>1)
+      Gothic::inst().onPrint(toCp1251(std::string(Lists[teachListId].title)+": изучено "+num(int32_t(n))));
+    return true;
+    }
+  if(code==T_ListMore) {
+    teachFrom += ListPage;
+    return true;
+    }
+  if(code>=T_AttrOne && code<T_AttrOne+std::size(Attrs)) {
+    teachAttrId = code-T_AttrOne;
+    teachPage   = TeachPage::AttrOne;
+    return true;
+    }
+  if(code>=T_AttrStep && code<T_AttrStep+4 && teachAttrId<std::size(Attrs)) {
+    teachAttr(player,teachAttrId,Attrs[teachAttrId].steps[code-T_AttrStep]);
+    return true;
+    }
+  if(code==T_AttrMax && teachAttrId<std::size(Attrs)) {
+    teachAttr(player,teachAttrId,Attrs[teachAttrId].max);
+    return true;
+    }
+  if(code>=T_Weapon && code<T_Weapon+std::size(Weapons)*2) {
+    const auto& w = Weapons[(code-T_Weapon)/2];
+    teachWeapon(player,w.talent,((code-T_Weapon)%2)==0 ? WeaponStep : WeaponMax);
+    return true;
+    }
+  if(code>=T_List && code<T_List+uint32_t(L_Count)) {
+    openList(code-T_List);
+    return true;
+    }
+  if(code>=T_Lesson && teachPage==TeachPage::List) {
+    const size_t i = code-T_Lesson;
+    const auto&  l = Lists[teachListId];
+    if(i>=l.count || lessonKnown(player,teachListId,i))
+      return true;
+    teachCall(l.fn,player,{owner.scriptConst(l.items[i].sym,-1)});
+    if(lessonKnown(player,teachListId,i))
+      teachLearned.push_back(l.items[i].title);
+    return true;
+    }
+  return true;
+  }
