+void MainWindow::perfReport(uint64_t now) {
+  if(perf.start==0) {
+    perf = PerfWindow();
+    perf.start = now;
+    return;
+    }
+  if(now-perf.start<10000 || perf.frames==0)
+    return;
+
+  const double n      = double(perf.frames);
+  const double fpsAvg = perf.interval>0 ? 1000.0*n/perf.interval : 0.0;
+  const auto   st     = MobilePerf::thermalStatus();
+  const float  head   = MobilePerf::thermalHeadroom();
+  // регдолл: сколько тел было в физике и сколько стоил шаг физики с ними (в среднем по кадрам с куклами)
+  const uint32_t ragPeak   = PerfStats::ragdollPeak.exchange(0);
+  const uint32_t ragUs     = PerfStats::ragdollUs.exchange(0);
+  const uint32_t ragFrames = PerfStats::ragdollFrames.exchange(0);
+  char buf[360] = {};
+  std::snprintf(buf, sizeof(buf),
+                "[perf] fps=%.1f frame=%.1fms max=%.0fms | logic=%.1f anim=%.1f render=%.1f gpu-wait=%.1f present=%.1f"
+                " | npc %u/%u wind %u/%u rag %u max %u phys %.1fms x%u | thermal=%d headroom=%.2f hints=%d cap=%d",
+                fpsAvg, perf.frame/n, perf.frameMax, perf.logic/n, perf.anim/n, perf.record/n, perf.gpuWait/n, perf.present/n,
+                PerfStats::npcAnimated.load(), PerfStats::npcTotal.load(),
+                PerfStats::windUpdated.load(), PerfStats::windTotal.load(), PerfStats::ragdolls.load(),
+                ragPeak, ragFrames>0 ? double(ragUs)/1000.0/double(ragFrames) : 0.0, ragFrames,
+                int(st), std::isnan(head) ? -1.0 : double(head), MobilePerf::hasHints() ? 1 : 0, effectiveFps());
+  Log::i(buf);
+
+  // Охлаждение: сильный нагрев - не больше 30 кадров, пока не остынет до «лёгкого»
+  if(st>=MobilePerf::T_Severe && thermalCap==0) {
+    thermalCap = 30;
+    Log::i("[perf] overheat (thermal=",int(st),"): fps limited to ",thermalCap);
+    }
+  else if(st!=MobilePerf::T_Unknown && st<=MobilePerf::T_Light && thermalCap>0) {
+    thermalCap = 0;
+    Log::i("[perf] cooled down (thermal=",int(st),"): fps limit restored");
+    }
+
+  perf = PerfWindow();
+  perf.start = now;
+  }
+#endif
