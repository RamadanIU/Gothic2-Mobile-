+void Npc::ragdollReact(int32_t damage) {
+  // Удар по живому, устоявшему на ногах (активный регдолл, как в Euphoria): импульс в точке удара, рефлексы всем
+  // телом, тонус мышц проседает и возвращается за ~1 с; сильный удар (или серия) - пошатывание с шагами, ИИ ждёт,
+  // пока тело не поймает равновесие; не устоял - сбит с ног (tickRagdollActive)
+  const uint64_t now = owner.tickCount();
+  if(ragHit.time!=now || ragHit.power<=0.f)
+    return;
+  if(ragdoll!=nullptr && ragBlendStart==0 && ragdoll->state()==Ragdoll::S_GetUp && ragdoll->isSimulated()) {
+    // встаёт телом - удар валит снова: лежит и встаёт заново (tickRagdollFall)
+    ragKnock = true;
+    ragdoll->setState(Ragdoll::S_Fall);
+    applyRagdollHit();
+    ragGetUpUntil = 0;
+    ragRiseAt     = 0;
+    ragPushedVer  = 0;
+    ragFollowVer  = 0;
+    Log::i("[g2m] ragdoll: \"",displayName(),"\" knocked down while getting up");
+    return;
+    }
+  if(ragdoll!=nullptr && (ragdoll->state()!=Ragdoll::S_Active || ragBlendStart!=0))
+    return; // лежит, ловит равновесие (удар уже толкнул тело - takeDamage) или встаёт - своё
+  if(ragdoll==nullptr && !startRagdollActive())
+    return;
+  ragFadeStart  = 0;
+  ragReactUntil = now+RagdollReactTime;
+
+  const float hpMax = float(std::max(attribute(ATR_HITPOINTSMAX),1));
+  // пошатнуть (шаги назад) может удар по любому; героя - только снявший четверть здоровья и больше (иначе в драке
+  // он не успевает ответить). Сбить с ног - если включено «Сильные удары сбивают с ног» (tickRagdollActive)
+  bool stagger = true;
+  if(isPlayer() && float(damage)*4.f<hpMax)
+    stagger = false;
+  Ragdoll::Hit h;
+  h.at       = ragHit.at;
+  h.dir      = ragHit.dir;
+  h.power    = ragHit.power;
+  h.damage   = float(damage)/hpMax;
+  h.kind     = ragHit.kind;
+  h.freeArms = ragdollFreeArms();
+  ragdoll->hitActive(h, stagger);
+  ragHit.power = 0;
+  // шатается - ИИ ждёт, пока ноги поймают тело (и не бьёт посреди пошатывания)
+  if(const uint64_t st = ragdoll->staggerTime(); st>0)
+    implAniWait(st);
+  }
+
+uint8_t Npc::ragdollFreeArms() const {
+  // свободные руки (бит 0 - левая, бит 1 - правая): ими прикрываются и держатся за рану. Одноручное оружие - в
+  // правой, двуручное, лук, арбалет и заклинание - в обеих
+  switch(weaponState()) {
+    case WeaponState::NoWeapon:
+      return 3;
+    case WeaponState::Fist:
+    case WeaponState::W1H:
+      return 1;
+    case WeaponState::W2H:
+    case WeaponState::Bow:
+    case WeaponState::CBow:
+    case WeaponState::Mage:
+      return 0;
+    }
+  return 0;
+  }
+
+void Npc::noteWound(const Vec3& at, float damage) {
+  // Ранен (как в Euphoria): свободная рука тянется к ране и держится за неё, удар в ногу - хромает. Только люди
+  // рядом с героем или камерой и не герой (его тело ведёт игрок)
+  if(isPlayer() || damage<=0.f || !Gothic::options().ragdoll || !Gothic::options().ragdollActive)
+    return;
+  float dist = 0;
+  bool  keep = false;
+  if(!ragdollViewDistance(dist,keep) || dist>Ragdoll::StartDist)
+    return;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+  auto rig = InjuryRig::of(*sk);
+  if(rig==nullptr)
+    return;
+  auto& pose = visual.pose();
+  InjuryRig::Wound w;
+  if(!rig->woundAt(pose.transform(),pose.boneCount(),at,w))
+    return;
+  const uint64_t now = owner.tickCount();
+  const int8_t   arm = rig->reachArm(w,ragdollFreeArms());
+  // царапина - рука не тянется: в драке каждый удар превращал бы бой в суету
+  if(arm>=0 && damage>=0.04f) {
+    const bool fight = weaponState()!=WeaponState::NoWeapon;
+    WoundReach::Wound wr;
+    wr.bone   = w.bone;
+    wr.arm    = arm;
+    wr.zone   = w.zone;
+    wr.local  = w.local;
+    wr.normal = w.normal;
+    // в бою - короче (рука нужна для драки), без оружия - дольше; дольше и от сильной раны
+    wound.add(wr, int64_t(now), int64_t(fight ? 1500.f + 3000.f*damage : 2200.f + 6000.f*damage));
+    }
+  // боль: тело сгибается к ране - чем сильнее удар, тем глубже и дольше (рана на ноге - корпус к ней вперёд)
+  {
+  const float c = painNow(now);
+  const float p = std::max(std::clamp(0.3f + 2.5f*damage, 0.3f, 1.f), c);
+  // удар поверх боли - без провала: огибающая продолжается с нынешнего уровня
+  painPower = p;
+  painAt    = now - uint64_t(450.f*c/p);
+  painSide  = (w.zone==InjuryRig::Z_Leg) ? 0.f : (w.side==0 ? 1.f : -1.f)*(w.zone==InjuryRig::Z_Arm ? 0.4f : 0.7f);
+  }
+  if(w.zone==InjuryRig::Z_Leg && damage>=0.08f) {
+    const float p = std::clamp(damage*2.5f, 0.3f, 1.f);
+    limpPower = std::max(limpNow(now), p);
+    limpLeg   = w.side;
+    limpFrom  = now;
+    limpUntil = now + uint64_t(std::min(8000.f + 40000.f*damage, 30000.f));
+    }
+  }
+
+float Npc::painNow(uint64_t now) const {
+  // согнуться от боли: нарастает 0,45 с, держит (дольше от сильного удара), отходит 1,6 с
+  if(painPower<=0.f || now<painAt)
+    return 0.f;
+  const float t = float(now-painAt)/1000.f;
+  return painPower*LimbIk::envelope(t, 0.45f, 0.3f+1.2f*painPower, 1.6f);
+  }
+
+Vec3 Npc::meleeHitPoint(const Npc& other) const {
+  // Куда пришёлся удар ближнего боя (регдолл, рука к ране, боль). Сама игра точку удара не считает:
+  // MdlVisual::mapWeaponBone для меча и кулака - это ноги нападающего, и каждый удар выходил ударом по голени.
+  // Высота - того, чем бьют: правая кисть (меч, кулак) у людей и орков, у зверей - голова (зубы); точка - на теле
+  // задетого со стороны нападающего, по высоте - от бёдер до макушки, вбок - как кисть от оси нападающего
+  Vec3 by = other.visual.mapHeadBone();
+  if(other.isHuman() || other.weaponState()==WeaponState::W1H || other.weaponState()==WeaponState::W2H) {
+    if(auto sk = other.visual.visualSkeleton()) {
+      size_t id = sk->findNode("ZS_RIGHTHAND");
+      if(id==size_t(-1))
+        id = sk->findNode("BIP01 R HAND");
+      if(id!=size_t(-1))
+        by = other.visual.mapBone(id);
+      }
+    }
+  const Vec3  me    = position();
+  const float footY = me.y;
+  const float headY = std::max(visual.mapHeadBone().y, footY+40.f);
+  const float top   = headY + 0.06f*(headY-footY);
+  const float h     = top-footY;
+  Vec3 dir = Vec3(other.x-x, 0, other.z-z);
+  if(dir.length()<1.f)
+    dir = Vec3(std::sin(angle*float(M_PI)/180.f), 0, std::cos(angle*float(M_PI)/180.f));
+  dir = Vec3::normalize(dir);
+  const Vec3  side = Vec3(-dir.z, 0, dir.x);
+  const float r    = 0.11f*h;
+  const float lat  = std::clamp(Vec3::dotProduct(by-other.position(), side)*0.5f, -r, r);
+  const float y    = std::clamp(by.y, footY+0.4f*h, top-0.04f*h);
+  return Vec3(me.x, y, me.z) + dir*r + side*lat;
+  }
