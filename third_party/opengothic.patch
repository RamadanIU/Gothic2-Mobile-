+// Квадрат расстояния по горизонтали: центр героя выше лежащего тела и предмета на земле
+static float qDistXZ(const Tempest::Vec3& a, const Tempest::Vec3& b) {
+  const float dx = a.x-b.x, dz = a.z-b.z;
+  return dx*dx+dz*dz;
+  }
+
+bool PlayerControl::isGatherable(Npc& pl, Item& it) const {
+  auto& h = it.handle();
+  if(h.owner_guild!=0 || it.isTorchBurn())
+    return false;
+  if(h.owner<=0 || uint32_t(h.owner)==pl.handle().symbol_index())
+    return true;
+  // Выпавшее оружие помечено владением того, кто его уронил. Хозяина нет в живых (убитый враг) -
+  // это не кража, собрать можно; хозяин жив, хоть и без сознания, - чужое
+  auto w = Gothic::inst().world();
+  for(size_t i=0; ; ++i) {
+    auto o = w->findNpcByInstance(size_t(h.owner),i);
+    if(o==nullptr)
+      return true;
+    if(!o->isDead())
+      return false;
+    }
+  }
+
+float PlayerControl::gatherReach(Npc& pl, Npc& body) const {
+  // AI_GoToNpc останавливает героя на дистанции удара кулаком (FightAlgo::prefferedAttackDistance): у тела
+  // человека - 1,7 м, крысы - 2,8 м. Сбор ждал подхода на 1,6 м и стоял до таймаута, тело пропускалось
+  auto& gv = Gothic::inst().world()->script().guildVal();
+  const int32_t base = gv.fight_range_base[body.guild()] + gv.fight_range_base[pl.guild()] + gv.fight_range_fist[pl.guild()];
+  return std::max(160.f, float(base)+60.f);
+  }
+
+bool PlayerControl::gatherSees(Npc& pl, const Tempest::Vec3& at) const {
+  // Видно ли цель с места героя: из глаз, а если заслоняет ствол, куст или забор - чуть сбоку или сверху
+  const Tempest::Vec3 eye = pl.position()+Tempest::Vec3(0.f,160.f,0.f);
+  Tempest::Vec3 dir = at-eye;
+  dir.y = 0;
+  const float len = dir.length();
+  const Tempest::Vec3 side = len>1.f ? Tempest::Vec3(-dir.z,0.f,dir.x)*(100.f/len) : Tempest::Vec3(100.f,0.f,0.f);
+  const Tempest::Vec3 from[] = {eye, eye+side, eye-side, eye+Tempest::Vec3(0.f,150.f,0.f)};
+  for(auto& f:from)
+    if(pl.canRayHitPoint(f,at,180.f,2500.f))
+      return true;
+  return false;
+  }
+
+const WayPoint* PlayerControl::gatherWayPoint(Npc& pl, const Tempest::Vec3& at) const {
+  // Точка сети путей игры в 8 м от цели, откуда её видно: туда AI_GoToPoint проведёт в обход стен и деревьев
+  auto w = Gothic::inst().world();
+  return w->findWayPoint(at,[&](const WayPoint& wp) {
+    const auto p = wp.position();
+    if(qDistXZ(p,at)>800.f*800.f || std::abs(p.y-at.y)>300.f)
+      return false;
+    return pl.canRayHitPoint(p+Tempest::Vec3(0.f,120.f,0.f),at,180.f,5000.f);
+    });
+  }
+
+bool PlayerControl::gatherReachable(Npc& pl, const Tempest::Vec3& at) const {
+  return gatherSees(pl,at) || gatherWayPoint(pl,at)!=nullptr;
+  }
+
+void PlayerControl::gatherGo(Npc& pl, bool route) {
+  // К цели: видно - напрямик; нет (или упёрся) - через точку сети путей рядом с ней
+  const auto at = gatherItem!=nullptr ? gatherItem->midPosition() : gatherBody->position()+Tempest::Vec3(0.f,40.f,0.f);
+  pl.clearAiQueue();
+  if(route || !pl.canRayHitPoint(pl.position()+Tempest::Vec3(0.f,160.f,0.f),at,180.f,2500.f)) {
+    if(auto wp = gatherWayPoint(pl,at)) {
+      pl.aiPush(AiQueue::aiGoToPoint(*wp));
+      gatherRouted = true;
+      }
+    }
+  if(gatherItem!=nullptr)
+    pl.aiPush(AiQueue::aiGotoItem(*gatherItem)); else
+    pl.aiPush(AiQueue::aiGoToNpc(gatherBody));
+  gatherMovePos = pl.position();
+  gatherMoveAt  = Gothic::inst().world()->tickCount();
+  }
+
+bool PlayerControl::findGatherTarget(Npc& pl, Item*& item, Npc*& body, float radius) const {
+  auto w = Gothic::inst().world();
+  item = nullptr;
+  body = nullptr;
+  float best = 0;
+  // Пропуск: что уже не удалось взять в этом сборе, а в пути - и в прошлых
+  auto  skip = [this](const void* p) {
+    return std::find(gatherSkip.begin(),gatherSkip.end(),p)!=gatherSkip.end() ||
+           std::find(travelSkip.begin(),travelSkip.end(),p)!=travelSkip.end();
+    };
+  const auto pos = pl.position();
+  // Перепад высоты - с запасом на склон, но не этаж выше
+  auto  high = [&pos](const Tempest::Vec3& p, float base) {
+    return std::abs(p.y-pos.y) > base + 0.3f*std::sqrt(qDistXZ(p,pos));
+    };
+  // Только бесхозное: чужое (владелец или гильдия) берётся вручную, осознанно - это кража.
+  // Не только то, что видно из глаз: за деревом, кустом, углом - если туда можно дойти
+  w->detectItem(pos, radius, [&](Item& it) {
+    if(skip(&it) || high(it.position(),160.f) || !isGatherable(pl,it))
+      return;
+    const float qd = pl.qDistTo(it);
+    if((item!=nullptr || body!=nullptr) && qd>=best)
+      return;
+    if(!pl.canSeeItem(it,true) && !gatherReachable(pl,it.midPosition()))
+      return;
+    item = &it;
+    body = nullptr;
+    best = qd;
+    });
+  // Мёртвые (не оглушённые): то, что даёт обыск
+  w->detectNpc(pos, radius, [&](Npc& n) {
+    if(&n==&pl || !n.isDead() || skip(&n))
+      return;
+    if(!n.inventory().iterator(Inventory::T_Ransack).isValid())
+      return;
+    if(high(n.position(),200.f))
+      return;
+    const float qd = pl.qDistTo(n);
+    if((item!=nullptr || body!=nullptr) && qd>=best)
+      return;
+    if(!pl.canSeeNpc(n,true) && !gatherReachable(pl,n.position()+Tempest::Vec3(0.f,40.f,0.f)))
+      return;
+    item = nullptr;
+    body = &n;
+    best = qd;
+    });
+  return item!=nullptr || body!=nullptr;
+  }
+
+void PlayerControl::startGather() {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr || gatherOn)
+    return;
+  gatherOn    = true;
+  gatherTaken = 0;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherSkip.clear();
+  gatherDeadline = w->tickCount()+7000;
+  Tempest::Log::i("[g2m] gather: start");
+  }
+
+void PlayerControl::stopGather(bool report) {
+  if(!gatherOn)
+    return;
+  gatherOn    = false;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherAvail = false;
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl!=nullptr && !pl->isAiQueueEmpty())
+    pl->clearAiQueue();
+  Tempest::Log::i("[g2m] gather: stop, taken=", int(gatherTaken));
+  // В пути: что не удалось взять, больше не манит с дороги
+  if(travelOn==TravelMode::Run)
+    travelSkip.insert(travelSkip.end(),gatherSkip.begin(),gatherSkip.end());
+  gatherRange = gatherRadius;
+  gatherQuiet = false;
+  if(!report && gatherTaken==0)
+    return;
+  if(gatherTaken>0)
+    Gothic::inst().onPrint(toCp1251("Собрано: ") + std::to_string(gatherTaken));
+  else
+    Gothic::inst().onPrint(toCp1251("Нечего собрать"));
+  }
+
+void PlayerControl::tickGather(Npc& pl) {
+  auto           w   = Gothic::inst().world();
+  const uint64_t now = w->tickCount();
+  if(!gatherOn) {
+    // Кнопка «Собрать» видна, только если рядом есть что взять и на героя не нападают
+    if(now>=gatherScanTime) {
+      gatherScanTime = now+350;
+      Item* it = nullptr;
+      Npc*  bd = nullptr;
+      gatherAvail = !pl.isDown() && !pl.isSwim() && !pl.isDive() && pl.interactive()==nullptr &&
+                    !dlg.isActive() && findGatherTarget(pl,it,bd,gatherRadius) && !isAttacked(pl);
+      }
+    return;
+    }
+
+  // Игрок взялся за управление, напали, открылось окно - сбор прекращается
+  if(pl.isDown() || dlg.isActive() || inv.isActive() || pl.isSwim() || pl.isDive() || pl.interactive()!=nullptr ||
+     touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle || touchAttack || touchBlock || isAttacked(pl)) {
+    // прервали - итог, только если что-то уже собрано
+    stopGather(gatherTaken>0);
+    return;
+    }
+  if(pl.weaponState()!=WeaponState::NoWeapon) {
+    // Сначала убрать оружие: с ним в руках вещи не поднять
+    wctrl[WeaponClose] = true;
+    gatherDeadline     = now+7000;
+    return;
+    }
+
+  if(gatherItem!=nullptr) {
+    Focus f;
+    f.item     = gatherItem;
+    gatherItem = w->validateFocus(f).item;
+    }
+  if(gatherBody!=nullptr) {
+    Focus f;
+    f.npc      = gatherBody;
+    gatherBody = w->validateFocus(f).npc;
+    if(gatherBody!=nullptr && !gatherBody->inventory().iterator(Inventory::T_Ransack).isValid())
+      gatherBody = nullptr;
+    }
+
+  if(gatherItem==nullptr && gatherBody==nullptr) {
+    if(!pl.isAiQueueEmpty() || pl.isAiBusy()) {
+      // доигрывается подбор или обыск
+      if(now>gatherDeadline)
+        pl.clearAiQueue();
+      return;
+      }
+    if(!findGatherTarget(pl,gatherItem,gatherBody,gatherRange)) {
+      stopGather(!gatherQuiet);
+      return;
+      }
+    // До 20 м: время на дорогу - по расстоянию, в обход - с запасом
+    const auto tg = gatherItem!=nullptr ? gatherItem->position() : gatherBody->position();
+    gatherDeadline = now+7000+uint64_t(std::sqrt(qDistXZ(tg,pl.position()))*6.f);
+    gatherRouted   = false;
+    gatherGo(pl,false);
+    return;
+    }
+
+  if(now>gatherDeadline) {
+    // Не дойти (стена, обрыв) - пропустить
+    gatherSkip.push_back(gatherItem!=nullptr ? static_cast<const void*>(gatherItem) : static_cast<const void*>(gatherBody));
+    gatherItem = nullptr;
+    gatherBody = nullptr;
+    pl.clearAiQueue();
+    return;
+    }
+
+  // По горизонтали: тело лежит, предмет на земле - центр героя выше, расстояние в 3D не сходилось.
+  // К телу AI_GoToNpc подводит только на дистанцию удара - этого хватает для обыска
+  const float reach = gatherItem!=nullptr ? 90.f : gatherReach(pl,*gatherBody);
+  const float qd    = qDistXZ(pl.position(), gatherItem!=nullptr ? gatherItem->position() : gatherBody->position());
+  const bool  stop  = gatherBody!=nullptr && pl.isAiQueueEmpty() && qd<=(reach+120.f)*(reach+120.f);
+  if(qd>reach*reach && !stop) {
+    // Ещё идёт. Упёрся (дерево, забор, угол) на 2,5 с - в обход по сети путей; и там застрял - пропустить
+    if(qDistXZ(pl.position(),gatherMovePos)>60.f*60.f) {
+      gatherMovePos = pl.position();
+      gatherMoveAt  = now;
+      }
+    else if(now>gatherMoveAt+2500) {
+      if(!gatherRouted) {
+        Tempest::Log::i("[g2m] gather: blocked, route by waypoints");
+        gatherGo(pl,true);
+        if(gatherRouted)
+          return;
+        }
+      gatherSkip.push_back(gatherItem!=nullptr ? static_cast<const void*>(gatherItem) : static_cast<const void*>(gatherBody));
+      gatherItem = nullptr;
+      gatherBody = nullptr;
+      pl.clearAiQueue();
+      }
+    return;
+    }
+  if(!pl.isAiQueueEmpty())
+    pl.clearAiQueue(); // дошёл
+  if(pl.isAiBusy())
+    return;
+  if(pl.bodyStateMasked()==BS_RUN || pl.bodyStateMasked()==BS_WALK)
+    pl.setAnim(Npc::Anim::Idle); // подобрать можно только стоя (Npc::takeItem)
+
+  if(gatherItem!=nullptr) {
+    // Подбор - как вручную: анимация, проверка кражи скриптами
+    if(pl.takeItem(*gatherItem)!=nullptr) {
+      ++gatherTaken;
+      gatherItem = nullptr;
+      }
+    return;
+    }
+
+  // Обыск тела: всё, что показал бы обыск (как «Взять всё»)
+  std::vector<std::pair<size_t,size_t>> loot;
+  for(auto it = gatherBody->inventory().iterator(Inventory::T_Ransack); it.isValid(); ++it)
+    loot.emplace_back(it->clsId(), it.count());
+  for(auto& [cls,count]:loot)
+    pl.addItem(cls,*gatherBody,count);
+  gatherTaken += loot.size();
+  gatherSkip.push_back(gatherBody);
+  gatherBody     = nullptr;
+  gatherDeadline = now+3000;
+  pl.aiPush(AiQueue::aiPlayAnim("T_PLUNDER"));
+  }
+
+// Gothic II Mobile: «Путь» - быстрое перемещение к точке на карте (docs/CONTROLS.md, «Путь»)
+static const uint64_t TravelFadeOut  = 450;
+static const uint64_t TravelFadeHold = 450;
+static const uint64_t TravelFadeIn   = 650;
+
+const char* PlayerControl::travelBlocked(bool instant) const {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr || pl->isDead())
+    return "Сейчас нельзя";
+  if(pl->isDown())
+    return "Сначала нужно прийти в себя";
+  if(pl->isSwim() || pl->isDive())
+    return "Сначала выберись из воды";
+  if(pl->isInAir() || pl->isFalling() || pl->isJump())
+    return "Сейчас нельзя";
+  if(pl->interactive()!=nullptr)
+    return "Сначала встань";
+  if(dlg.isActive())
+    return "Сначала закончи разговор";
+  if(instant && isAttacked(*pl))
+    return "На тебя нападают - мгновенно не уйти";
+  return nullptr;
+  }
+
+bool PlayerControl::startTravel(const WayPoint& at, const WayPoint& way, std::string_view name, bool instant,
+                                const TravelOptions& opt) {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr)
+    return false;
+  if(auto why = travelBlocked(instant)) {
+    Gothic::inst().onPrint(toCp1251(why));
+    return false;
+    }
+  stopTravel(nullptr);
+  stopGather(false);
+  const uint64_t now = w->tickCount();
+  travelOn       = instant ? TravelMode::Instant : TravelMode::Run;
+  travelOpt      = opt;
+  travelNo++;
+  travelWorld    = w;
+  travelAt       = &at;
+  travelWay      = &way;
+  travelLabel    = std::string(name);
+  travelRoute.clear();
+  travelIdx      = 0;
+  travelPushed   = false;
+  travelFinal    = false;
+  travelPushAt   = 0;
+  travelStuck    = 0;
+  travelFoe      = nullptr;
+  travelTalk     = nullptr;
+  travelTalks    = 0;
+  travelHealAt   = 0;
+  travelHealing  = false;
+  travelHealIdle = 0;
+  travelHealMiss = 0;
+  travelWide     = false;
+  travelIgnore.clear();
+  travelSkip.clear();
+  travelMovePos  = pl->position();
+  travelStuckPos = pl->position();
+  travelMoveAt   = now;
+  travelLootAt   = now+1500;
+  travelSetState(instant ? TravelState::Fade : TravelState::Go, now);
+  if(!instant) {
+    // В пути - бегом: шаг и подкрадывание - для прогулки, не для дороги
+    pl->setWalkMode(WalkBit::WM_Run);
+    }
+  Tempest::Log::i("[g2m] travel: ", instant ? "instant" : "run", " to \"", travelLabel, "\" (", at.name, ")",
+                  instant ? "" : (opt.fight ? " fight" : " no-fight"), instant ? "" : (opt.loot ? " loot" : " no-loot"));
+  return true;
+  }
+
+void PlayerControl::stopTravel(const char* why) {
+  if(travelOn==TravelMode::None)
+    return;
+  const bool run = (travelOn==TravelMode::Run);
+  travelOn = TravelMode::None;
+  if(run) {
+    if(gatherOn)
+      stopGather(false);
+    auto w  = Gothic::inst().world();
+    auto pl = w ? w->player() : nullptr;
+    if(pl!=nullptr && w==travelWorld && !pl->isAiQueueEmpty())
+      pl->clearAiQueue();
+    }
+  travelRoute.clear();
+  travelSkip.clear();
+  travelIgnore.clear();
+  travelFoe  = nullptr;
+  travelTalk = nullptr;
+  Tempest::Log::i("[g2m] travel: stop", why!=nullptr ? " - " : "", why!=nullptr ? why : "");
+  if(why!=nullptr)
+    Gothic::inst().onPrint(toCp1251(why));
+  }
+
+void PlayerControl::travelSetState(TravelState st, uint64_t now) {
+  travelSt      = st;
+  travelStateAt = now;
+  }
+
+float PlayerControl::travelLeft() const {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(travelOn!=TravelMode::Run || pl==nullptr || w!=travelWorld)
+    return 0;
+  Tempest::Vec3 prev = pl->position();
+  float         sum  = 0;
+  for(size_t i=travelIdx; i<travelRoute.size(); ++i) {
+    const auto p = travelRoute[i]->position();
+    sum += std::sqrt(qDistXZ(prev,p));
+    prev = p;
+    }
+  return sum + std::sqrt(qDistXZ(prev,travelAt->position()));
+  }
+
+float PlayerControl::travelFade() const {
+  auto w = Gothic::inst().world();
+  if(travelOn!=TravelMode::Instant || w==nullptr)
+    return 0.f;
+  const uint64_t t = w->tickCount()-travelStateAt;
+  if(!travelFinal)
+    return std::clamp(float(t)/float(TravelFadeOut), 0.f, 1.f);
+  if(t<TravelFadeHold)
+    return 1.f;
+  return std::clamp(1.f-float(t-TravelFadeHold)/float(TravelFadeIn), 0.f, 1.f);
+  }
+
+void PlayerControl::onSaveGame() {
+  // Ход героя по очереди ИИ (путь, сбор) сохранился бы с ним: после загрузки, без нашего хода, герой шёл бы
+  // сам и не слушался джойстика. Путь продолжится заново, когда сохранение кончится
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr)
+    return;
+  if(gatherOn)
+    stopGather(false);
+  if(travelOn==TravelMode::Run) {
+    if(!pl->isAiQueueEmpty())
+      pl->clearAiQueue();
+    travelPushed = false;
+    }
+  }
+
+bool PlayerControl::isHeroAttacked() const {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  return pl!=nullptr && isAttacked(*pl);
+  }
+
+bool PlayerControl::travelIgnored(const Npc& npc, uint64_t now) const {
+  for(auto& i:travelIgnore)
+    if(i.first==&npc && i.second>now)
+      return true;
+  return false;
+  }
+
+Npc* PlayerControl::travelEnemy(Npc& pl, bool& guard) const {
+  // Враг в пути: нападает на героя или напарника (до 15 м), враждебный зверь или орк рядом (9 м, видно).
+  // Нападает не враг по гильдии (стража, горожанин) - с ним не драться: путь прерывается (guard)
+  auto w = Gothic::inst().world();
+  const uint64_t now  = w->tickCount();
+  auto&          sc   = w->script();
+  Npc*           ret  = nullptr;
+  Npc*           cur  = nullptr;
+  float          best = 0;
+  guard = false;
+  w->detectNpc(pl.position(), 1500, [&](Npc& o) {
+    if(&o==&pl || o.isDown() || o.isDead() || sc.isHired(o) || travelIgnored(o,now))
+      return;
+    const float qd  = pl.qDistTo(o);
+    Npc*        tg  = o.target();
+    if(o.isAttack() && tg==&pl) {
+      if(o.isHuman() && !o.isEnemy(pl)) {
+        guard = true;
+        return;
+        }
+      }
+    else if(o.isAttack() && tg!=nullptr && !tg->isDown() && sc.isHired(*tg)) {
+      if(o.isHuman() && !o.isEnemy(pl))
+        return; // напарник дерётся с мирным - не наше дело в пути
+      }
+    else if(o.isHuman() || !o.isEnemy(pl) || qd>900.f*900.f ||
+            std::abs(o.position().y-pl.position().y)>400.f || !pl.canSeeNpc(o,true)) {
+      return;
+      }
+    if(&o==pl.target())
+      cur = &o;
+    if(ret==nullptr || qd<best) {
+      ret  = &o;
+      best = qd;
+      }
+    });
+  // Не перескакивать между врагами без причины
+  return cur!=nullptr ? cur : ret;
+  }
+
+void PlayerControl::tickTravel(Npc& pl) {
+  if(travelOn==TravelMode::None)
+    return;
+  auto w = Gothic::inst().world();
+  if(w!=travelWorld || pl.isDead()) {
+    stopTravel(nullptr);
+    return;
+    }
+  const uint64_t now = w->tickCount();
+  if(travelOn==TravelMode::Instant)
+    tickTravelFade(pl,now); else
+    tickTravelRun(pl,now);
+  }
+
+void PlayerControl::tickTravelFade(Npc& pl, uint64_t now) {
+  const uint64_t t = now-travelStateAt;
+  if(!travelFinal) {
+    if(t<TravelFadeOut)
+      return;
+    // Экран чёрный: перенос героя, отряд - рядом
+    pl.clearAiQueue();
+    pl.setPosition(travelAt->position());
+    const auto dir = travelAt->direction();
+    if(dir.x*dir.x+dir.z*dir.z>0.01f)
+      pl.setDirection(dir);
+    pl.updateTransform();
+    if(auto c = Gothic::inst().camera())
+      c->reset(&pl);
+    travelWorld->script().squadArrive();
+    travelFinal   = true;
+    travelPushed  = false;
+    travelStateAt = now;
+    Tempest::Log::i("[g2m] travel: arrived (instant) \"", travelLabel, "\"");
+    return;
+    }
+  if(t>=TravelFadeHold && !travelPushed) {
+    travelPushed = true;
+    Gothic::inst().onPrint(toCp1251("Ты на месте: " + travelLabel));
+    }
+  if(t>=TravelFadeHold+TravelFadeIn)
+    stopTravel(nullptr);
+  }
+
+void PlayerControl::tickTravelRun(Npc& pl, uint64_t now) {
+  auto w = Gothic::inst().world();
+  // Игрок взялся за управление (кнопки и джойстик прерывают путь сами, здесь - клавиатура и геймпад)
+  if(movement.forwardBackward.any() || movement.strafeRightLeft.any() || movement.turnRightLeft.any()) {
+    stopTravel("Путь прерван");
+    return;
+    }
+  if(pl.isDown()) {
+    stopTravel("Путь прерван");
+    return;
+    }
+  if(inv.isActive())
+    return; // сумка, сундук, торговля: путь ждёт
+
+  // Разговор: кто-то заговорил по дороге. Стража не пропускает - путь прерван; иначе - дальше
+  if(dlg.isActive()) {
+    if(travelSt!=TravelState::Talk) {
+      if(gatherOn)
+        stopGather(false);
+      // Остановиться: разговор начинается и с бегущим героем. Очередь ИИ - не трогать, в ней реплики героя
+      pl.clearGoTo();
+      travelTalk   = dlg.touchPartner();
+      travelPushed = false;
+      travelSetState(TravelState::Talk,now);
+      }
+    return;
+    }
+  if(travelSt==TravelState::Talk) {
+    Focus f;
+    f.npc = travelTalk;
+    Npc* who = travelTalk!=nullptr ? w->validateFocus(f).npc : nullptr;
+    travelTalk = nullptr;
+    // Страж прохода (ворота города, верхний квартал, перевал, замок): пропустил он или нет, дальше игрок решает сам
+    const size_t zsGuard = w->script().findSymbolIndex("ZS_GUARD_PASSAGE");
+    if(who!=nullptr && zsGuard!=size_t(-1) && (who->isInState(zsGuard) || who->hasRoutineState(zsGuard))) {
+      stopTravel("Разговор со стражей - путь прерван");
+      return;
+      }
+    if(travelTalkAt!=0 && now<travelTalkAt+60000 && qDistXZ(pl.position(),travelTalkPos)<1500.f*1500.f)
+      ++travelTalks; else
+      travelTalks = 1;
+    travelTalkAt  = now;
+    travelTalkPos = pl.position();
+    if(travelTalks>=3) {
+      stopTravel("Тебя всё время останавливают - путь прерван");
+      return;
+      }
+    travelSetState(TravelState::Go,now);
+    travelPushAt = now+800; // постоять мгновение после разговора
+    travelMoveAt = now+800;
+    return;
+    }
+
+  // Враг: бой ведёт автобой (tickAutoFight). Не одолеть за 45 с (на скале, над водой) - дальше своей дорогой.
+  // Без «Сражаться» - бежать дальше, не останавливаясь (напарники дерутся сами)
+  bool guard = false;
+  Npc* foe   = (pl.isSwim() || pl.isDive()) ? nullptr : travelEnemy(pl,guard);
+  if(guard) {
+    stopTravel("На тебя напали - путь прерван");
+    return;
+    }
+  const bool threat = (foe!=nullptr);
+  if(!travelOpt.fight) {
+    foe = nullptr;
+    // Не дерётся - и не погибает молча: за ним гонятся, а здоровья меньше четверти - остановиться и выпить зелье
+    // (travelHeal ниже: в погоне - только зелья, еда и травы - долго), зелий нет - решает игрок
+    HealKind kind = HealKind::Potion;
+    if(threat && pl.attribute(ATR_HITPOINTS)*4<pl.attribute(ATR_HITPOINTSMAX) &&
+       travelHealItem(pl,true,1,kind)==size_t(-1)) {
+      stopTravel("Мало здоровья и нет зелий - путь прерван");
+      return;
+      }
+    }
+  if(foe!=nullptr) {
+    travelCalmAt = now;
+    if(travelSt!=TravelState::Fight) {
+      if(gatherOn)
+        stopGather(false);
+      if(!pl.isAiQueueEmpty())
+        pl.clearAiQueue();
+      travelPushed = false;
+      travelSetState(TravelState::Fight,now);
+      Tempest::Log::i("[g2m] travel: fight \"", foe->displayName(), "\"");
+      }
+    if(foe!=travelFoe) {
+      travelFoe   = foe;
+      travelFoeAt = now;
+      }
+    else if(now>travelFoeAt+45000) {
+      travelIgnore.emplace_back(foe,now+60000);
+      travelFoe = nullptr;
+      Tempest::Log::i("[g2m] travel: give up \"", foe->displayName(), "\"");
+      }
+    return;
+    }
+  if(travelSt==TravelState::Fight) {
+    // Врагов нет 1,2 с: обобрать побеждённых (в 20 м), подлечиться, дальше
+    if(now<travelCalmAt+1200 || pl.isAttackAnim())
+      return;
+    travelFoe    = nullptr;
+    travelSetState(TravelState::Go,now);
+    travelLootAt = now;
+    travelWide   = true;
+    }
+
+  if(travelSt==TravelState::Loot) {
+    if(gatherOn)
+      return; // идёт сбор (tickGather)
+    travelSetState(TravelState::Go,now);
+    travelLootAt = now+2500;
+    travelPushed = false;
+    return;
+    }
+  if(gatherOn) {
+    // «Собрать» нажали в пути - сначала сбор
+    travelSetState(TravelState::Loot,now);
+    travelPushed = false;
+    return;
+    }
+
+  // Оружие в руках (после боя) - убрать: с ним бег медленнее, а добычу не поднять
+  if(pl.weaponState()!=WeaponState::NoWeapon) {
+    if(!pl.isAiQueueEmpty())
+      pl.clearAiQueue();
+    wctrl[WeaponClose] = true;
+    travelPushed = false;
+    travelMoveAt = now;
+    return;
+    }
+
+  // Подлечиться: здоровья меньше 70 % - привал, лечиться до 85 %: зелья, нет зелий - лечебные травы, нет трав -
+  // еда. Нечем, а здоровья меньше четверти - дальше не идти (travelHeal)
+  if(travelHeal(pl,now,threat))
+    return;
+
+  // Добыча у дороги: по пути - в 12 м, после боя - в 20 м (тела побеждённых). Без «Собирать лут» - мимо
+  if(travelOpt.loot && now>=travelLootAt && !pl.isSwim() && !pl.isDive()) {
+    travelLootAt = now+800;
+    const float r = travelWide ? gatherRadius : 1200.f;
+    travelWide = false;
+    Item* it = nullptr;
+    Npc*  bd = nullptr;
+    if(findGatherTarget(pl,it,bd,r)) {
+      if(!pl.isAiQueueEmpty())
+        pl.clearAiQueue();
+      travelPushed = false;
+      startGather();
+      gatherRange = r;
+      gatherQuiet = true;
+      travelSetState(TravelState::Loot,now);
+      Tempest::Log::i("[g2m] travel: loot");
+      return;
+      }
+    }
+
+  travelGo(pl,now);
+  }
+
+size_t PlayerControl::travelHealItem(Npc& pl, bool potionsOnly, int need, HealKind& kind) const {
+  // Чем лечиться: зелья, нет зелий - лечебные травы (и другие лечащие растения: грибы, ягоды), нет трав - еда.
+  // Зелья - сначала слабые: сильные остаются на крайний случай (как в автобое); травы и еда - то, чего хватит до
+  // цели (need), нет такого - самое сытное. Не трогать: предметы заданий, всё, что даёт постоянную прибавку или
+  // особое свойство (королевский щавель, похлёбка Теклы, пиво Корагона) - у таких есть другие строки описания
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return size_t(-1);
+  auto& sc    = w->script();
+  auto* hpTxt = sc.findSymbol("NAME_BONUS_HP");
+  if(hpTxt==nullptr)
+    return size_t(-1);
+  std::string_view allowed[3] = {hpTxt->get_string()};
+  if(auto* s = sc.findSymbol("NAME_BONUS_MANA"))
+    allowed[1] = s->get_string();
+  if(auto* s = sc.findSymbol("NAME_VALUE"))
+    allowed[2] = s->get_string();
+  const size_t fullHeal = sc.findSymbolIndex("ITPO_HEALTH_ADDON_04"); // «Чистое здоровье» - полное лечение
+  const int    hpMax    = std::max(1, pl.attribute(ATR_HITPOINTSMAX));
+
+  size_t best     = size_t(-1);
+  int    bestHeal = 0;
+  int    bestRank = 3;
+  for(auto it=pl.inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it) {
+    const Item&    itm  = *it;
+    const auto&    h    = itm.handle();
+    const uint32_t main = uint32_t(itm.mainFlag());
+    if((uint32_t(itm.itemFlag()) & ITM_MISSION) || !(main & (ITM_CAT_POTION | ITM_CAT_FOOD)) || itm.isEquipped())
+      continue;
+    int  heal = 0;
+    bool odd  = false;
+    for(size_t k=0; k<zenkit::IItem::text_count; ++k) {
+      const auto& t = h.text[k];
+      if(t.empty())
+        continue;
+      if(t==allowed[0])
+        heal = std::max(heal,h.count[k]);
+      else if(t!=allowed[1] && t!=allowed[2])
+        odd = true;
+      }
+    if(itm.clsId()==fullHeal) {
+      heal = hpMax;
+      odd  = false;
+      }
+    if(heal<=0 || odd)
+      continue;
+    auto* sym = sc.findSymbol(itm.clsId());
+    const bool plant = sym!=nullptr && sym->name().size()>5 &&
+                       (sym->name().compare(0,5,"ITPL_")==0 || sym->name().compare(0,5,"ItPl_")==0);
+    const HealKind k    = (main & ITM_CAT_POTION) ? HealKind::Potion : plant ? HealKind::Herb : HealKind::Food;
+    const int      rank = int(k);
+    if(potionsOnly && k!=HealKind::Potion)
+      continue;
+    bool better = false;
+    if(best==size_t(-1) || rank<bestRank)
+      better = true;
+    else if(rank==bestRank) {
+      if(k==HealKind::Potion)
+        better = heal<bestHeal; // слабое - раньше
+      else if(heal>=need)
+        better = bestHeal<need || heal<bestHeal; // хватит до цели - самое скромное из таких
+      else
+        better = bestHeal<need && heal>bestHeal;  // не хватит ничего - самое сытное
+      }
+    if(better) {
+      best     = itm.clsId();
+      bestHeal = heal;
+      bestRank = rank;
+      kind     = k;
+      }
+    }
+  return best;
+  }
+
+bool PlayerControl::travelHeal(Npc& pl, uint64_t now, bool threat) {
+  // Привал на лечение: здоровья меньше 70 % - остановиться и лечиться до 85 %, по предмету за раз (каждый ждёт
+  // конца своей анимации). В погоне (без «Сражаться») - только зелья и только когда здоровья меньше четверти, до 40 %
+  const int hp     = pl.attribute(ATR_HITPOINTS);
+  const int hpMax  = std::max(1, pl.attribute(ATR_HITPOINTSMAX));
+  const int lowPct = threat ? 25 : 70;
+  const int topPct = threat ? 40 : 85;
+  if(travelHealing && now<travelHealAt)
+    return true; // ест или пьёт
+  if(travelHealing && pl.bodyStateMasked()!=BS_STAND && now<travelHealAt+4000)
+    return true; // анимация предмета ещё идёт (еда - дольше зелья)
+  if(!travelHealing && hp*100>=hpMax*lowPct)
+    return false;
+  if(travelHealing && hp*100>=hpMax*topPct) {
+    travelHealing = false;
+    Tempest::Log::i("[g2m] travel: healed ", hp, "/", hpMax);
+    return false;
+    }
+  if(!travelHealing && now<travelHealIdle)
+    return false;
+  if(pl.isInAir() || pl.isFalling() || pl.isSwim() || pl.isDive() || pl.interactive()!=nullptr)
+    return false;
+
+  HealKind     kind = HealKind::Potion;
+  const size_t cls  = travelHealItem(pl,threat,hpMax*topPct/100-hp,kind);
+  if(cls==size_t(-1)) {
+    if(travelHealing)
+      Tempest::Log::i("[g2m] travel: nothing more to heal with, hp ", hp, "/", hpMax);
+    travelHealing  = false;
+    travelHealIdle = now+5000;
+    if(hp*4<hpMax) {
+      stopTravel(threat ? "Мало здоровья и нет зелий - путь прерван" : "Мало здоровья и нечем лечиться - путь прерван");
+      return true;
+      }
+    return false; // нечем, но здоровья хватает - дальше
+    }
+
+  // Остановиться: предмет берётся только стоя
+  if(travelPushed || !pl.isAiQueueEmpty()) {
+    if(gatherOn)
+      stopGather(false);
+    pl.clearAiQueue();
+    pl.clearGoTo();
+    travelPushed = false;
+    }
+  if(!travelHealing) {
+    travelHealing  = true;
+    travelHealMiss = 0;
+    Tempest::Log::i("[g2m] travel: heal start, hp ", hp, "/", hpMax);
+    }
+  travelPushAt = now+800; // постоять мгновение после еды
+  travelMoveAt = now+800;
+  if(pl.bodyStateMasked()!=BS_STAND) {
+    travelHealAt = now+150; // ещё бежит или встаёт
+    if(++travelHealMiss>40) {
+      travelHealing  = false;
+      travelHealIdle = now+5000;
+      }
+    return true;
+    }
+  // Действие предмета - сразу (скрипт предмета), сам предмет исчезает из сумки по ходу анимации: взялся ли - по
+  // здоровью или начатой анимации, а не по числу в сумке (иначе второй вызов оборвал бы анимацию)
+  pl.useItem(cls);
+  if(pl.attribute(ATR_HITPOINTS)<=hp && pl.bodyStateMasked()==BS_STAND) {
+    travelHealAt = now+300; // не взялся - чуть позже ещё раз
+    if(++travelHealMiss>20) {
+      travelHealing  = false;
+      travelHealIdle = now+5000;
+      }
+    return true;
+    }
+  travelHealMiss = 0;
+  travelHealAt   = now+(kind==HealKind::Potion ? 900 : 1500);
+  auto* sym = Gothic::inst().world()->script().findSymbol(cls);
+  Tempest::Log::i("[g2m] travel: heal with ", sym!=nullptr ? sym->name() : std::string_view("?"),
+                  kind==HealKind::Potion ? " (potion)" : kind==HealKind::Herb ? " (herb)" : " (food)",
+                  ", hp ", hp, "/", hpMax);
+  return true;
+  }
+
+void PlayerControl::travelGo(Npc& pl, uint64_t now) {
+  auto       w    = Gothic::inst().world();
+  const auto pos  = pl.position();
+  const auto goal = travelAt->position();
+  if(qDistXZ(pos,goal)<300.f*300.f && std::abs(goal.y-pos.y)<400.f) {
+    const std::string name = travelLabel;
+    stopTravel(nullptr);
+    Gothic::inst().onPrint(toCp1251("Ты на месте: " + name));
+    return;
+    }
+  if(now<travelPushAt)
+    return;
+  travelProgress(pl);
+  if(travelUnstuck(pl,now))
+    return;
+
+  if(!travelPushed || pl.isAiQueueEmpty()) {
+    // Путь от того места, где герой сейчас: в начале, после боя, сбора, разговора или когда ход кончился
+    if(!travelPushed) {
+      travelMovePos = pos;
+      travelMoveAt  = now;
+      }
+    travelPushAt = now+1500;
+    if(!pl.isAiQueueEmpty())
+      pl.clearAiQueue();
+    if(travelAt!=travelWay && (travelFinal || qDistXZ(pos,travelWay->position())<400.f*400.f)) {
+      // От сети путей - к самому месту (метка разработчиков, свободная точка)
+      travelFinal = true;
+      pl.goToPos(goal);
+      }
+    else {
+      travelRoute = w->wayTo(pl,*travelWay).points();
+      travelIdx   = 0;
+      if(!travelRoute.empty()) {
+        pl.aiPush(AiQueue::aiGoToPoint(*travelWay));
+        }
+      else if(pl.canRayHitPoint(travelWay->position()+Tempest::Vec3(0.f,60.f,0.f),true,6000.f)) {
+        pl.goToPos(travelWay->position());
+        }
+      else {
+        stopTravel("Туда нет дороги");
+        return;
+        }
+      }
+    travelPushed = true;
+    }
+  }
+
+void PlayerControl::travelProgress(Npc& pl) {
+  const auto   pos = pl.position();
+  const size_t end = std::min(travelRoute.size(), travelIdx+8);
+  for(size_t i=travelIdx; i<end; ++i)
+    if(qDistXZ(pos,travelRoute[i]->position())<400.f*400.f)
+      travelIdx = i+1;
+  }
+
+bool PlayerControl::travelUnstuck(Npc& pl, uint64_t now) {
+  // Застрял (4 с почти на месте): путь заново -> через следующую точку пути -> перенос на шаг к ней, если её
+  // видно (не сквозь стену и не за запертые ворота) -> стоп
+  const auto pos = pl.position();
+  if(!travelPushed || pl.isInAir() || pl.isFalling() || pl.isSwim() || pl.isDive()) {
+    travelMovePos = pos;
+    travelMoveAt  = now;
+    return false;
+    }
+  if(qDistXZ(pos,travelMovePos)>150.f*150.f) {
+    travelMovePos = pos;
+    travelMoveAt  = now;
+    if(qDistXZ(pos,travelStuckPos)>800.f*800.f) {
+      travelStuck    = 0;
+      travelStuckPos = pos;
+      }
+    return false;
+    }
+  if(now<travelMoveAt+4000)
+    return false;
+  travelMoveAt = now;
+  ++travelStuck;
+  Tempest::Log::i("[g2m] travel: stuck ", int(travelStuck));
+
+  if(travelFinal && qDistXZ(pos,travelAt->position())<2000.f*2000.f) {
+    // У самого места: метка не на земле или за оградой - пришёл
+    const std::string name = travelLabel;
+    stopTravel(nullptr);
+    Gothic::inst().onPrint(toCp1251("Ты на месте: " + name));
+    return true;
+    }
+
+  const WayPoint* next  = travelIdx<travelRoute.size()   ? travelRoute[travelIdx]   : nullptr;
+  const WayPoint* next2 = travelIdx+1<travelRoute.size() ? travelRoute[travelIdx+1] : next;
+  switch(travelStuck) {
+    case 1:
+      travelPushed = false;
+      travelPushAt = now;
+      break;
+    case 2:
+      // Через точку пути за следующей: дальше путь заново, когда герой до неё дойдёт
+      if(next2!=nullptr && next2!=travelWay) {
+        pl.clearAiQueue();
+        pl.aiPush(AiQueue::aiGoToPoint(*next2));
+        travelPushed = true;
+        travelPushAt = now+1500;
+        } else {
+        travelPushed = false;
+        travelPushAt = now;
+        }
+      break;
+    case 3: {
+      const auto np = next!=nullptr ? next->position() : Tempest::Vec3();
+      if(next!=nullptr && qDistXZ(pos,np)<1200.f*1200.f && std::abs(np.y-pos.y)<300.f &&
+         pl.canRayHitPoint(np+Tempest::Vec3(0.f,100.f,0.f),true,1500.f)) {
+        pl.clearAiQueue();
+        pl.setPosition(np);
+        pl.updateTransform();
+        Tempest::Log::i("[g2m] travel: hop to ", next->name);
+        }
+      travelPushed = false;
+      travelPushAt = now;
+      break;
+      }
+    default:
+      stopTravel("Дальше не пройти - путь прерван");
+      return true;
+    }
+  return true;
+  }
+
+void PlayerControl::applyTouchMove() {
+  // Удар и выход из серии сбрасывают движение (movement.reset) - палец на джойстике возвращает его.
+  // Пока держат «Удар» или «Блок», герой стоит: серия и блок не срываются бегом.
+  const bool hold = touchAttack || touchBlock;
+  if(touchFwdAct==Action::Idle && touchSideAct==Action::Idle && !hold)
+    return;
+  movement.forwardBackward.main   [1] = !hold && touchFwdAct ==Action::Forward;
+  movement.forwardBackward.reverse[1] = !hold && touchFwdAct ==Action::Back;
+  movement.strafeRightLeft.main   [1] = !hold && touchSideAct==Action::Right;
+  movement.strafeRightLeft.reverse[1] = !hold && touchSideAct==Action::Left;
+  movement.turnRightLeft.main     [1] = !hold && touchSideAct==Action::RotateR;
+  movement.turnRightLeft.reverse  [1] = !hold && touchSideAct==Action::RotateL;
+  }
+
+void PlayerControl::tickTouchAttack(Npc& pl) {
+  const auto ws = pl.weaponState();
+  if(ws!=WeaponState::Fist && ws!=WeaponState::W1H && ws!=WeaponState::W2H)
+    return;
+  if(touchBlock) {
+    actrl[ActBack] = true;
+    return;
+    }
+  if(!touchAttack)
+    return;
+  // Как удержание «действия»: цель зафиксирована, герой доворачивается к ней
+  ctrl [Action::ActionGeneric] = true;
+  actrl[ActGeneric]            = true;
+  if(pl.isAttackAnim() && !pl.isComboWindow())
+    return; // ждём окна серии: удар раньше времени сорвал бы комбо
+  // Добить оглушённого - только новым нажатием: удержание «Удара» никого не убивает само
+  if(auto tg = pl.target(); touchFresh && tg!=nullptr && !pl.isAttackAnim() && pl.canFinish(*tg))
+    actrl[ActKill] = true;
+  else if(touchSideAtk<0)
+    actrl[ActLeft] = true;
+  else if(touchSideAtk>0)
+    actrl[ActRight] = true;
+  else
+    actrl[ActForward] = true;
+  touchSideAtk = 0;
+  touchFresh   = false;
+  }
+
+Npc* PlayerControl::findAutoFightTarget(Npc& pl) const {
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return nullptr;
+  // Нападающий на героя - издалека; хищник, который ещё не напал, - только вблизи
+  static const float attackerDist = 1500.f;
+  static const float monsterDist  = 700.f;
+  auto isEnemy = [&pl](Npc& npc) {
+    if(&npc==&pl || npc.isDown())
+      return false;
+    const float qd = pl.qDistTo(npc);
+    if(npc.target()==&pl && npc.isAttack())
+      return qd<attackerDist*attackerDist;
+    if(npc.isMonster() && npc.isEnemy(pl))
+      return qd<monsterDist*monsterDist;
+    return false;
+    };
+
+  if(auto tg = pl.target(); tg!=nullptr && isEnemy(*tg))
+    return tg; // не перескакивать между врагами без причины
+
+  Npc*  ret  = nullptr;
+  float best = 0;
+  for(uint32_t i=0; i<w->npcCount(); ++i) {
+    auto npc = w->npcById(i);
+    if(npc==nullptr || !isEnemy(*npc))
+      continue;
+    const float qd = pl.qDistTo(*npc);
+    if(ret==nullptr || qd<best) {
+      ret  = npc;
+      best = qd;
+      }
+    }
+  return ret;
+  }
+
+bool PlayerControl::tickAutoFight(Npc& pl) {
+  // Палец на джойстике или кнопке боя - герой слушается игрока; отпустил - автобой продолжает
+  const bool manual = touchAttack || touchBlock || touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle ||
+                      movement.forwardBackward.any() || movement.strafeRightLeft.any() || movement.turnRightLeft.any();
+  // В пути («Путь» бегом) герой дерётся сам, даже если автобой выключен: с напавшими и зверями у дороги
+  const bool travel = (travelOn==TravelMode::Run && travelSt==TravelState::Fight);
+  Npc* tg = nullptr;
+  if((autoFight || travel) && !manual && !dlg.isActive() && !pl.isSwim() && !pl.isDive()) {
+    bool guard = false;
+    tg = travel ? travelEnemy(pl,guard) : findAutoFightTarget(pl);
+    }
+
+  const auto ws    = pl.weaponState();
+  const bool melee = (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+  if(tg!=nullptr && ws==WeaponState::NoWeapon) {
+    // Оружие достаём, только если на героя уже напали: убранный меч - тоже решение игрока. В пути - сразу
+    if(travel || (tg->target()==&pl && tg->isAttack()))
+      wctrl[WeaponMele] = true;
+    tg = nullptr;
+    }
+  else if(tg!=nullptr && travel && !melee) {
+    // В пути с луком или руной в руках - на ближний бой: автобой ведёт только его
+    wctrl[WeaponMele] = true;
+    }
+
+  if(tg==nullptr || !melee) {
+    if(autoFightOn) {
+      autoFightOn = false;
+      pl.setAutoFight(false);
+      Tempest::Log::i("[g2m] autofight: idle");
+      }
+    return false;
+    }
+
+  if(!autoFightOn || pl.target()!=tg)
+    Tempest::Log::i("[g2m] autofight: target=", tg->displayName(), " tactic=", pl.fightTactic());
+  autoFightOn = true;
+  pl.setTarget(tg);
+  pl.setAutoFight(true);
+
+  // Здоровья меньше четверти (в пути - меньше трети: бой там не выбирали) - зелье, не чаще раза в 4 с
+  const uint64_t now = Gothic::inst().world()->tickCount();
+  if(pl.attribute(ATR_HITPOINTS)*(travel ? 3 : 4)<pl.attribute(ATR_HITPOINTSMAX) && now>autoHealTime) {
+    autoHealTime = now+4000;
+    drinkHealPotion();
+    }
+
+  rotMouse     = 0;
+  rotMouseY    = 0;
+  runAngleDest = 0;
+  return true;
   }
 
