+MenuTouchInfo GameMenu::touchInfo() {
+  MenuTouchInfo ret;
+  if(logView!=nullptr) {
+    ret.nav = true;
+    ret.sub = true;
+    return ret;
+    }
+  if(logList!=nullptr) {
+    ret.nav    = true;
+    ret.sub    = true;
+    ret.action = "Открыть";
+    return ret;
+    }
+
+  int num = 0;
+  for(auto& it:hItems)
+    if(it.handle!=nullptr && it.visible && isSelectable(it.handle) && isEnabled(it.handle))
+      ++num;
+  ret.nav = num>1;
+
+  auto sel = selectedItem();
+  if(sel==nullptr || sel->handle==nullptr || !isSelectable(sel->handle) || !isEnabled(sel->handle))
+    return ret;
+  ret.action = "Выбрать";
+  if(chainOf(*sel,zenkit::MenuItemType::SLIDER)!=nullptr) {
+    ret.hor    = true;
+    ret.action = nullptr; // ползунок - стрелками и пальцем вбок
+    }
+  else if(chainOf(*sel,zenkit::MenuItemType::CHOICEBOX)!=nullptr) {
+    ret.hor    = true;
+    ret.action = "Изменить";
+    }
+
+  for(size_t i=0; i<zenkit::IMenuItem::select_action_count; ++i) {
+    const auto& str = sel->handle->on_sel_action_s[i];
+    if(str=="SAVEGAME_SAVE")
+      ret.action = "Сохранить";
+    else if(str=="SAVEGAME_LOAD")
+      ret.action = sel->savHdr.version!=0 ? "Загрузить" : nullptr;
+    else if(str.find("EFFECTS ")==0) {
+      // Раздел журнала: открыть список, если в нём что-то есть
+      auto list = visibleList();
+      ret.action = (list!=nullptr && numQuests(Gothic::inst().questLog(),toStatus(list->handle->user_string[0]))>0) ?
+                   "Открыть" : nullptr;
+      }
+    }
+  return ret;
+  }
