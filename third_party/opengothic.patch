+bool TouchInput::isShown(Ctl c) const {
+  const auto ui = currentUi();
+  auto  pl      = Gothic::inst().player();
+  const auto ws = pl!=nullptr ? pl->weaponState() : WeaponState::NoWeapon;
+  switch(c) {
+    case C_Main:
+    case C_Jump:
+    case C_Weapon:
+    case C_Auto:
+    case C_Sneak:
+    case C_Bag:
+    case C_Map:
+    case C_Log:
+    case C_Hero:
+    case C_Menu:
+      return ui==Ui::World;
+    case C_Block:
+      return ui==Ui::World && (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+    case C_Potion:
+      return ui==Ui::World && (ctrl.potionCount(false)>0 || ctrl.potionCount(true)>0);
+    case C_Gather:
+      return ui==Ui::World && (ctrl.canGather() || ctrl.isGathering());
+    case C_Squad:
+      return ui==Ui::World && !squad.empty();
+    case C_Up:
+    case C_Down:
+      return ui==Ui::Dialog && owner.touchDialogChoices();
+    case C_Select:
+      if(ui==Ui::Dialog)
+        return owner.touchDialogChoices();
+      if(ui==Ui::Inventory)
+        return owner.touchInventoryAction()!=InventoryMenu::TouchAction::None;
+      return false;
+    case C_Back:
+      if(ui==Ui::Dialog)
+        return owner.touchDialogTalking();
+      return ui==Ui::Inventory || ui==Ui::Document || ui==Ui::LockPick;
+    case C_TakeAll:
+      return ui==Ui::Inventory && owner.touchCanTakeAll();
+    case C_Left:
+    case C_Right:
+      return ui==Ui::LockPick;
+    case C_Skip:
+      return ui==Ui::Skip;
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_List:
+    case C_Absorb:
+    case C_Count:
+      break;
+    }
+  return false;
+  }
