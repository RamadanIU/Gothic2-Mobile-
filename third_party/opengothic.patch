diff --git a/common/game/ailink.cpp b/common/game/ailink.cpp
new file mode 100644
index 0000000..7df68b4
--- /dev/null
+++ b/common/game/ailink.cpp
@@ -0,0 +1,102 @@
+#include "ailink.h"
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+#ifdef __ANDROID__
+#include <jni.h>
+#include <pthread.h>
+#endif
+
+// Gothic II Mobile: строки идут байтами UTF-8 (byte[]), а не jstring: NewStringUTF роняет приложение на
+// неверном «modified UTF-8», а Java сама заменяет битые последовательности при разборе.
+
+namespace {
+  std::mutex               mtx;
+  std::vector<std::string> inbox;
+  std::atomic<bool>        isOn{false};
+  // Очередь не растёт без конца, если игра долго не тикает (загрузка, пауза)
+  const size_t             MaxInbox = 512;
+
+#ifdef __ANDROID__
+  JavaVM*   jvm     = nullptr;
+  jclass    jcls    = nullptr;
+  jmethodID onEvent = nullptr;
+  // Поток, подключённый к Java, обязан отключиться перед концом - иначе ART роняет процесс:
+  // отключение - в деструкторе ключа потока
+  pthread_key_t  detachKey;
+  pthread_once_t detachOnce = PTHREAD_ONCE_INIT;
+
+  void detachThread(void*) {
+    if(jvm!=nullptr)
+      jvm->DetachCurrentThread();
+    }
+
+  void makeDetachKey() {
+    pthread_key_create(&detachKey,detachThread);
+    }
+#endif
+  }
+
+bool AiLink::enabled() {
+  return isOn.load();
+  }
+
+void AiLink::poll(std::vector<std::string>& out) {
+  std::lock_guard<std::mutex> guard(mtx);
+  for(auto& s:inbox)
+    out.push_back(std::move(s));
+  inbox.clear();
+  }
+
+void AiLink::send(const std::string& json) {
+#ifdef __ANDROID__
+  if(jvm==nullptr || jcls==nullptr || onEvent==nullptr)
+    return;
+  JNIEnv* env = nullptr;
+  if(jvm->GetEnv(reinterpret_cast<void**>(&env),JNI_VERSION_1_6)!=JNI_OK) {
+    // Поток игры подключается к Java один раз и отключается, когда кончится
+    if(jvm->AttachCurrentThread(&env,nullptr)!=JNI_OK)
+      return;
+    pthread_once(&detachOnce,makeDetachKey);
+    pthread_setspecific(detachKey,env);
+    }
+  jbyteArray arr = env->NewByteArray(jsize(json.size()));
+  if(arr==nullptr) {
+    env->ExceptionClear();
+    return;
+    }
+  env->SetByteArrayRegion(arr,0,jsize(json.size()),reinterpret_cast<const jbyte*>(json.data()));
+  env->CallStaticVoidMethod(jcls,onEvent,arr);
+  if(env->ExceptionCheck())
+    env->ExceptionClear();
+  env->DeleteLocalRef(arr);
+#else
+  (void)json;
+#endif
+  }
+
+#ifdef __ANDROID__
+extern "C" JNIEXPORT void JNICALL Java_gothic2_mobile_og_ai_AiBridge_nativeAttach(JNIEnv* env, jclass cls, jboolean enable) {
+  env->GetJavaVM(&jvm);
+  if(jcls==nullptr)
+    jcls = reinterpret_cast<jclass>(env->NewGlobalRef(cls));
+  onEvent = env->GetStaticMethodID(jcls,"onEngineEvent","([B)V");
+  if(onEvent==nullptr)
+    env->ExceptionClear();
+  isOn = (enable==JNI_TRUE);
+  }
+
+extern "C" JNIEXPORT void JNICALL Java_gothic2_mobile_og_ai_AiBridge_nativeCommand(JNIEnv* env, jclass, jbyteArray cmd) {
+  if(cmd==nullptr)
+    return;
+  const jsize n = env->GetArrayLength(cmd);
+  std::string s(size_t(n),'\0');
+  env->GetByteArrayRegion(cmd,0,n,reinterpret_cast<jbyte*>(s.data()));
+  std::lock_guard<std::mutex> guard(mtx);
+  if(inbox.size()>=MaxInbox)
+    inbox.erase(inbox.begin());
+  inbox.push_back(std::move(s));
+  }
+#endif
diff --git a/common/game/ailink.h b/common/game/ailink.h
new file mode 100644
index 0000000..29cac87
--- /dev/null
+++ b/common/game/ailink.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+// Gothic II Mobile: связь движка с приложением для живого NPC (docs/AI_NPC.md). Приложение (Java,
+// gothic2.mobile.og.ai.AiBridge) шлёт команды строкой JSON в UTF-8, движок отвечает событиями тоже JSON.
+// Команды копятся в очереди и разбираются в главном потоке игры (AiNpc::tick). Без приложения - пусто.
+namespace AiLink {
+  // Приложение подключилось и включило живого NPC в настройках
+  bool enabled();
+  // Забрать накопившиеся команды
+  void poll(std::vector<std::string>& out);
+  // Событие приложению (из главного потока игры)
+  void send(const std::string& json);
+  }
