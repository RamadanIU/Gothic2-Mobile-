+void Ragdoll::nudge(const Vec3& at, const Vec3& dv) {
+  // Клинок о клинок, отдача в кисть: задетая часть получает скорость, её родитель - 40 % (рука тяжелее кисти);
+  // не больше 6 м/с - иначе решатель дёрнет сустав
+  if(!isSimulated() || st==S_Dead)
+    return;
+  const size_t part = hitPart(at);
+  if(part>=body.size())
+    return;
+  btVector3 v = btVector3(dv.x,dv.y,dv.z);
+  if(v.length()>6.f)
+    v = v.normalized()*6.f;
+  auto& rb = *body[part].rb;
+  rb.setLinearVelocity(rb.getLinearVelocity()+v);
+  rb.activate(true);
+  const size_t pp = lay->parts[part].parent;
+  if(pp<body.size() && !lay->parts[pp].pinned) {
+    auto& rp = *body[pp].rb;
+    rp.setLinearVelocity(rp.getLinearVelocity()+v*0.4f);
+    rp.activate(true);
+    }
+  }
+
+Vec3 Ragdoll::velocityAt(const Vec3& at) const {
+  if(!isSimulated())
+    return Vec3();
+  const size_t part = hitPart(at);
+  if(part>=body.size())
+    return Vec3();
+  const auto&     rb = *body[part].rb;
+  const btVector3 v  = rb.getVelocityInLocalPoint(btv(at)-rb.getCenterOfMassPosition());
+  return Vec3(v.x(),v.y(),v.z());
+  }
