+bool PlayerControl::isAttacked(Npc& pl) const {
+  auto w     = Gothic::inst().world();
+  bool found = false;
+  w->detectNpc(pl.position(), 1500, [&](Npc& o) {
+    if(&o!=&pl && !o.isDown() && o.isAttack() && o.target()==&pl)
+      found = true;
+    });
+  return found;
+  }
