+void TouchInput::drawTravelBanner(Painter& p) {
+  if(ctrl.travelMode()!=PlayerControl::TravelMode::Run)
+    return;
+  // Внизу посередине, между джойстиком и кнопками: куда, сколько осталось, что сейчас
+  const float d = dp();
+  TouchIcons::Icon ic = TouchIcons::I_Run;
+  std::string      txt = toCp1251(ctrl.travelName());
+  switch(ctrl.travelState()) {
+    case PlayerControl::TravelState::Go:
+      txt += "  " + distText(ctrl.travelLeft());
+      break;
+    case PlayerControl::TravelState::Fight:
+      ic   = TouchIcons::I_Sword;
+      txt += toCp1251(" - бой");
+      break;
+    case PlayerControl::TravelState::Loot:
+      ic   = TouchIcons::I_Gather;
+      txt += toCp1251(" - сбор добычи");
+      break;
+    case PlayerControl::TravelState::Talk:
+      ic   = TouchIcons::I_Talk;
+      txt += toCp1251(" - разговор");
+      break;
+    case PlayerControl::TravelState::Fade:
+      break;
+    }
+  const int  bh  = int(34*d);
+  const int  maxW = std::min(int(420*d), w()-int(440*d));
+  if(maxW<int(120*d))
+    return;
+  auto&      fnt = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this));
+  txt = fit(txt, maxW-bh-int(30*d), 1.f);
+  const int  bw  = std::min(maxW, fnt.textSize(txt).w+bh+int(30*d));
+  drawPill(p, Rect((w()-bw)/2, h()-int(16*d)-bh, bw, bh), ic, txt, false);
+  }
+
+Rect TouchInput::confirmRect() const {
+  const float d  = dp();
+  const int   cw = std::min(w()-int(32*d), int(400*d));
+  const int   ch = int(170*d);
+  return Rect((w()-cw)/2, (h()-ch)/2, cw, ch);
+  }
+
+Rect TouchInput::confirmButton(bool yes) const {
+  const float d   = dp();
+  const auto  r   = confirmRect();
+  const int   pad = int(14*d);
+  const int   bw  = (r.w-2*pad-int(10*d))/2;
+  const int   bh  = int(44*d);
+  return Rect(r.x+pad+(yes ? 0 : bw+int(10*d)), r.y+r.h-pad-bh, bw, bh);
+  }
+
+void TouchInput::openConfirm() {
+  std::string info;
+  if(!owner.touchQuickSaveInfo(info)) {
+    Gothic::inst().onPrint(toCp1251("Быстрого сохранения нет"));
+    return;
+    }
+  confirmInfo = toCp1251(info);
+  confirmOpen = true;
+  Gothic::inst().pushPause();
+  update();
+  }
+
+void TouchInput::closeConfirm() {
+  if(!confirmOpen)
+    return;
+  confirmOpen = false;
+  Gothic::inst().popPause();
+  update();
+  }
+
+void TouchInput::confirmTap(Point p) {
+  if(confirmButton(true).contains(p)) {
+    closeConfirm();
+    owner.touchQuickLoad();
+    return;
+    }
+  if(confirmButton(false).contains(p) || !confirmRect().contains(p))
+    closeConfirm();
+  }
+
+void TouchInput::drawConfirm(Painter& p) {
+  const float d   = dp();
+  const auto  r   = confirmRect();
+  const int   pad = int(14*d);
+  p.setBrush(Color(0.f,0.f,0.f,0.6f));
+  p.drawRect(0,0,w(),h());
+  drawPanel(p, r);
+  drawText(p, fit(toCp1251("Загрузить быстрое сохранение?"), r.w-2*pad, 1.f), r.x+pad, r.y+pad, true, 1.f);
+  drawText(p, fit(confirmInfo, r.w-2*pad, 0.8f), r.x+pad, r.y+pad+int(34*d), false, 0.8f);
+  drawText(p, fit(toCp1251("Всё, что после него, будет потеряно"), r.w-2*pad, 0.8f), r.x+pad, r.y+pad+int(58*d), false, 0.8f);
+  drawPill(p, confirmButton(true),  TouchIcons::I_Load, toCp1251("Загрузить"), false);
+  drawPill(p, confirmButton(false), TouchIcons::I_Back, toCp1251("Отмена"),    false);
+  }
