+bool AiNpc::isGeraltNpc(const Npc& npc) {
+  // По экземпляру скрипта, а не по указателю: с выключенным ИИ указатель не ищется
+  if(thorusSym==size_t(-1))
+    thorusSym = owner.findSymbolIndex("VLK_2000_THORUS");
+  return thorusSym!=size_t(-1) && size_t(npc.instanceSymbol())==thorusSym;
+  }
