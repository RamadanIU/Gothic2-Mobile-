+    b.c = Point(int(x),int(y));
+    b.r = int(r);
+    return b;
+    };
+  auto arc = [&](float rad, float deg, float r) {
+    const float a = deg*Pi/180.f;
+    return round(mx + rad*std::cos(a), my - rad*std::sin(a), r);
+    };
+  auto pill = [](float x, float y, float pw, float ph) {
+    Button b;
+    b.rect = Rect(int(x),int(y),int(pw),int(ph));
