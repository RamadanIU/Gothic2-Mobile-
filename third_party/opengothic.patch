+
+void PlayerControl::stopGather(bool report) {
+  if(!gatherOn)
+    return;
+  gatherOn    = false;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherAvail = false;
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl!=nullptr && !pl->isAiQueueEmpty())
+    pl->clearAiQueue();
+  Tempest::Log::i("[g2m] gather: stop, taken=", int(gatherTaken));
+  if(!report && gatherTaken==0)
+    return;
+  if(gatherTaken>0)
+    Gothic::inst().onPrint(toCp1251("Собрано: ") + std::to_string(gatherTaken));
+  else
+    Gothic::inst().onPrint(toCp1251("Нечего собрать"));
+  }
+
+void PlayerControl::tickGather(Npc& pl) {
+  auto           w   = Gothic::inst().world();
+  const uint64_t now = w->tickCount();
+  if(!gatherOn) {
+    // Кнопка «Собрать» видна, только если рядом есть что взять и на героя не нападают
+    if(now>=gatherScanTime) {
+      gatherScanTime = now+350;
+      Item* it = nullptr;
+      Npc*  bd = nullptr;
+      gatherAvail = !pl.isDown() && !pl.isSwim() && !pl.isDive() && pl.interactive()==nullptr &&
+                    !dlg.isActive() && findGatherTarget(pl,it,bd) && !isAttacked(pl);
+      }
+    return;
+    }
+
+  // Игрок взялся за управление, напали, открылось окно - сбор прекращается
+  if(pl.isDown() || dlg.isActive() || inv.isActive() || pl.isSwim() || pl.isDive() || pl.interactive()!=nullptr ||
+     touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle || touchAttack || touchBlock || isAttacked(pl)) {
+    // прервали - итог, только если что-то уже собрано
+    stopGather(gatherTaken>0);
+    return;
+    }
+  if(pl.weaponState()!=WeaponState::NoWeapon) {
+    // Сначала убрать оружие: с ним в руках вещи не поднять
+    wctrl[WeaponClose] = true;
+    gatherDeadline     = now+7000;
+    return;
+    }
+
+  if(gatherItem!=nullptr) {
+    Focus f;
+    f.item     = gatherItem;
+    gatherItem = w->validateFocus(f).item;
+    }
+  if(gatherBody!=nullptr) {
+    Focus f;
+    f.npc      = gatherBody;
+    gatherBody = w->validateFocus(f).npc;
+    if(gatherBody!=nullptr && !gatherBody->inventory().iterator(Inventory::T_Ransack).isValid())
+      gatherBody = nullptr;
+    }
+
+  if(gatherItem==nullptr && gatherBody==nullptr) {
+    if(!pl.isAiQueueEmpty() || pl.isAiBusy()) {
+      // доигрывается подбор или обыск
+      if(now>gatherDeadline)
+        pl.clearAiQueue();
+      return;
+      }
+    if(!findGatherTarget(pl,gatherItem,gatherBody)) {
+      stopGather(true);
+      return;
+      }
+    gatherDeadline = now+7000;
+    if(gatherItem!=nullptr)
+      pl.aiPush(AiQueue::aiGotoItem(*gatherItem)); else
+      pl.aiPush(AiQueue::aiGoToNpc(gatherBody));
+    return;
+    }
+
+  if(now>gatherDeadline) {
+    // Не дойти (стена, обрыв) - пропустить
+    gatherSkip.push_back(gatherItem!=nullptr ? static_cast<const void*>(gatherItem) : static_cast<const void*>(gatherBody));
+    gatherItem = nullptr;
+    gatherBody = nullptr;
+    pl.clearAiQueue();
+    return;
+    }
+
+  const float reach = gatherItem!=nullptr ? 110.f : 160.f;
+  const float qd    = gatherItem!=nullptr ? pl.qDistTo(*gatherItem) : pl.qDistTo(*gatherBody);
+  if(qd>reach*reach)
+    return; // ещё идёт
+  if(!pl.isAiQueueEmpty())
+    pl.clearAiQueue(); // дошёл
+  if(pl.isAiBusy())
+    return;
+
+  if(gatherItem!=nullptr) {
+    // Подбор - как вручную: анимация, проверка кражи скриптами
+    if(pl.takeItem(*gatherItem)!=nullptr) {
+      ++gatherTaken;
+      gatherItem = nullptr;
+      }
+    return;
+    }
+
+  // Обыск тела: всё, что показал бы обыск (как «Взять всё»)
+  std::vector<std::pair<size_t,size_t>> loot;
+  for(auto it = gatherBody->inventory().iterator(Inventory::T_Ransack); it.isValid(); ++it)
+    loot.emplace_back(it->clsId(), it.count());
+  for(auto& [cls,count]:loot)
+    pl.addItem(cls,*gatherBody,count);
+  gatherTaken += loot.size();
+  gatherSkip.push_back(gatherBody);
+  gatherBody     = nullptr;
+  gatherDeadline = now+3000;
+  pl.aiPush(AiQueue::aiPlayAnim("T_PLUNDER"));
+  }
+
+void PlayerControl::applyTouchMove() {
+  // Удар и выход из серии сбрасывают движение (movement.reset) - палец на джойстике возвращает его.
+  // Пока держат «Удар» или «Блок», герой стоит: серия и блок не срываются бегом.
+  const bool hold = touchAttack || touchBlock;
+  if(touchFwdAct==Action::Idle && touchSideAct==Action::Idle && !hold)
+    return;
+  movement.forwardBackward.main   [1] = !hold && touchFwdAct ==Action::Forward;
+  movement.forwardBackward.reverse[1] = !hold && touchFwdAct ==Action::Back;
+  movement.strafeRightLeft.main   [1] = !hold && touchSideAct==Action::Right;
+  movement.strafeRightLeft.reverse[1] = !hold && touchSideAct==Action::Left;
+  movement.turnRightLeft.main     [1] = !hold && touchSideAct==Action::RotateR;
+  movement.turnRightLeft.reverse  [1] = !hold && touchSideAct==Action::RotateL;
+  }
+
+void PlayerControl::tickTouchAttack(Npc& pl) {
+  const auto ws = pl.weaponState();
+  if(ws!=WeaponState::Fist && ws!=WeaponState::W1H && ws!=WeaponState::W2H)
+    return;
+  if(touchBlock) {
+    actrl[ActBack] = true;
+    return;
+    }
+  if(!touchAttack)
+    return;
+  // Как удержание «действия»: цель зафиксирована, герой доворачивается к ней
+  ctrl [Action::ActionGeneric] = true;
+  actrl[ActGeneric]            = true;
+  if(pl.isAttackAnim() && !pl.isComboWindow())
+    return; // ждём окна серии: удар раньше времени сорвал бы комбо
+  // Добить оглушённого - только новым нажатием: удержание «Удара» никого не убивает само
+  if(auto tg = pl.target(); touchFresh && tg!=nullptr && !pl.isAttackAnim() && pl.canFinish(*tg))
+    actrl[ActKill] = true;
+  else if(touchSideAtk<0)
+    actrl[ActLeft] = true;
+  else if(touchSideAtk>0)
+    actrl[ActRight] = true;
+  else
+    actrl[ActForward] = true;
+  touchSideAtk = 0;
+  touchFresh   = false;
+  }
+
+Npc* PlayerControl::findAutoFightTarget(Npc& pl) const {
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return nullptr;
+  // Нападающий на героя - издалека; хищник, который ещё не напал, - только вблизи
+  static const float attackerDist = 1500.f;
+  static const float monsterDist  = 700.f;
+  auto isEnemy = [&pl](Npc& npc) {
+    if(&npc==&pl || npc.isDown())
+      return false;
+    const float qd = pl.qDistTo(npc);
+    if(npc.target()==&pl && npc.isAttack())
+      return qd<attackerDist*attackerDist;
+    if(npc.isMonster() && npc.isEnemy(pl))
+      return qd<monsterDist*monsterDist;
+    return false;
+    };
+
+  if(auto tg = pl.target(); tg!=nullptr && isEnemy(*tg))
+    return tg; // не перескакивать между врагами без причины
+
+  Npc*  ret  = nullptr;
+  float best = 0;
+  for(uint32_t i=0; i<w->npcCount(); ++i) {
+    auto npc = w->npcById(i);
+    if(npc==nullptr || !isEnemy(*npc))
+      continue;
+    const float qd = pl.qDistTo(*npc);
+    if(ret==nullptr || qd<best) {
+      ret  = npc;
+      best = qd;
+      }
