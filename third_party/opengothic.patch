+TouchInput::Ui TouchInput::currentUi() const {
+  using M = MainWindow::TouchMode;
+  if(editOpen)
+    return Ui::Edit;
+  const auto m = owner.touchMode();
+  if(m==M::Hidden)
+    return Ui::Hidden;
+  if(m==M::Skip)
+    return Ui::Skip;
+  if(m==M::KillCam)
+    return Ui::KillCam;
+  if(m==M::Menu)
+    return Ui::Menu;
+  if(owner.touchIsLockPick())
+    return Ui::LockPick;
+  if(m==M::World) {
+    if(ctrl.travelMode()==PlayerControl::TravelMode::Instant)
+      return Ui::Fade;
+    if(confirmOpen)
+      return Ui::Confirm;
+    if(mapOpen)
+      return Ui::Travel;
+    return Ui::World;
+    }
+  // Торговля открывается поверх диалога - сначала сумка
+  if(owner.touchIsInventory())
+    return Ui::Inventory;
+  if(owner.touchIsDialog())
+    return Ui::Dialog;
+  return Ui::Document;
+  }
