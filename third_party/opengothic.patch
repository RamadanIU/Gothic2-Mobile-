+int32_t GameScript::invokeTeach(std::string_view name, Npc& teacher, Npc& student, std::initializer_list<int32_t> args) {
+  // Gothic II Mobile: урок у Геральта (ainpc / aiteach.cpp) - теми же функциями, что у учителей игры: умение, дневник,
+  // надписи на экране - как в родном диалоге обучения
+  auto* fn = vm.find_symbol_by_name(name);
+  if(fn==nullptr || fn->type()!=zenkit::DaedalusDataType::FUNCTION || fn->count()<args.size())
+    return -1;
+  const size_t   npcs = fn->count()-args.size();
+  const int32_t* a    = args.begin();
+  const size_t   n    = args.size();
+  auto call = [&](auto... p) -> int32_t {
+    if(fn->has_return())
+      return vm.call_function<int>(fn, p...);
+    vm.call_function<void>(fn, p...);
+    return 1;
+    };
+  ScopeCtx ctx  (*this, teacher.processPolicy());
+  ScopeVar self (*vm.global_self(),  teacher.handlePtr());
+  ScopeVar other(*vm.global_other(), student.handlePtr());
+  try {
+    if(npcs==2 && n==1)
+      return call(teacher.handlePtr(), student.handlePtr(), a[0]);
+    if(npcs==2 && n==3)
+      return call(teacher.handlePtr(), student.handlePtr(), a[0], a[1], a[2]);
+    if(npcs==1 && n==2)
+      return call(student.handlePtr(), a[0], a[1]);
+    if(npcs==0 && n==1)
+      return call(a[0]);
+    }
+  catch(const std::exception& e) {
+    Tempest::Log::e("[g2m] teach: ",name,": ",e.what());
+    }
+  return -1;
+  }
