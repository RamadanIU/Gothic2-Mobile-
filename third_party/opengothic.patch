diff --git a/common/game/companions.cpp b/common/game/companions.cpp
new file mode 100644
index 00000000..bd6c3ef5
--- /dev/null
+++ b/common/game/companions.cpp
@@ -0,0 +1,175 @@
+#include "gamescript.h"
+
+#include <Tempest/Log>
+
+#include <algorithm>
+
+#include "world/objects/npc.h"
+#include "world/aiqueue.h"
+#include "world/world.h"
+#include "utils/cp1251.h"
+#include "utils/string_frm.h"
+#include "gothic.h"
+
+// Gothic II Mobile: напарники.
+// В диалоге с безымянным человеком (NPCTYPE_*AMBIENT) - «Пойдём со мной». Нанятый получает флаг
+// AIV_PARTYMEMBER и распорядок TA_Follow_Player на весь день, как напарники из скриптов игры:
+// ZS_Follow_Player сам дерётся с врагами, а опыт за убитых им ZS_Dead отдаёт герою.
+// Цена - 10 золотых за уровень, напарник называет её озвученной фразой ($GOLD_*).
+
+static const size_t MaxHired = 3;
+
+static bool isAmbient(const zenkit::INpc& h) {
+  switch(h.type) {
+    case zenkit::NpcType::G2_AMBIENT:
+    case zenkit::NpcType::G2_OC_AMBIENT:
+    case zenkit::NpcType::G2_BL_AMBIENT:
+    case zenkit::NpcType::G2_TAL_AMBIENT:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+int32_t GameScript::scriptConst(std::string_view name, int32_t def) {
+  auto* s = vm.find_symbol_by_name(name);
+  return s!=nullptr ? s->get_int() : def;
+  }
+
+bool GameScript::isPartyMember(Npc& npc) {
+  const int32_t id = scriptConst("AIV_PARTYMEMBER",15);
+  return id>=0 && uint32_t(id)<zenkit::INpc::aivar_count && npc.handle().aivar[size_t(id)]!=0;
+  }
+
+bool GameScript::isHired(Npc& npc) {
+  // Призванные монстры и сюжетные напарники - тоже AIV_PARTYMEMBER, но у них свои скрипты
+  auto& h = npc.handle();
+  return isAmbient(h) && h.guild<GIL_SEPERATOR_HUM && isPartyMember(npc);
+  }
+
+size_t GameScript::hiredCount() {
+  auto&  w = world();
+  size_t n = 0;
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc!=nullptr && !npc->isDead() && isHired(*npc))
+      ++n;
+    }
+  return n;
+  }
+
+int32_t GameScript::hirePrice(Npc& npc) const {
+  // Шаг цены - как у озвученных сумм: до 100 - по 10, дальше - по 50
+  int32_t p = std::clamp(npc.handle().level*10, 10, 1000);
+  if(p<=100)
+    p = (p+9)/10*10; else
+    p = (p+49)/50*50;
+  return std::min(p,1000);
+  }
+
+void GameScript::companionSay(Npc& npc, Npc& player, std::string_view svm) {
+  npc.aiPush(AiQueue::aiOutputSvm(player,svm,aiOutOrderId));
+  ++aiOutOrderId;
+  }
+
+void GameScript::companionChoices(Npc& player, Npc& npc, std::vector<DlgChoice>& out) {
+  if(Gothic::inst().version().game!=2 || &player==&npc || npc.isDown())
+    return;
+  auto& h = npc.handle();
+  if(!isAmbient(h) || h.guild>=GIL_SEPERATOR_HUM)
+    return;
+
+  auto add = [&out](uint32_t id, const std::string& title) {
+    DlgChoice ch;
+    ch.title    = title;
+    ch.scriptFn = id;
+    ch.sort     = 998; // перед «Конец» (nr 999)
+    out.push_back(std::move(ch));
+    };
+
+  if(isHired(npc)) {
+    if(npc.hasRoutineState(findSymbolIndex("ZS_FOLLOW_PLAYER")))
+      add(CompanionWait,  toCp1251("Подожди меня здесь."));
+    else
+      add(CompanionFollow,toCp1251("Пойдём дальше вместе."));
+    add(CompanionDismiss, toCp1251("Дальше я сам. Спасибо за помощь!"));
+    return;
+    }
+
+  if(isPartyMember(npc))
+    return;
+  const auto att = personAttitude(npc,player);
+  if(att==ATT_HOSTILE || att==ATT_ANGRY)
+    return;
+  // Стража у прохода остаётся на посту: иначе ворота открылись бы сами
+  if(npc.hasRoutineState(findSymbolIndex("ZS_GUARD_PASSAGE")))
+    return;
+  if(hiredCount()>=MaxHired)
+    return;
+
+  const int32_t price = hirePrice(npc);
+  add(CompanionHire, toCp1251("Пойдём со мной — поможешь в бою? (") + std::to_string(price) + toCp1251(" золотых)"));
+  }
+
+void GameScript::execCompanion(const DlgChoice& dlg, Npc& player, Npc& npc) {
+  auto& h        = npc.handle();
+  const int32_t aivParty  = scriptConst("AIV_PARTYMEMBER",15);
+  const size_t  zsFollow  = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  auto          setParty  = [&](bool v) {
+    if(aivParty>=0 && uint32_t(aivParty)<zenkit::INpc::aivar_count)
+      h.aivar[size_t(aivParty)] = v ? 1 : 0;
+    };
+  auto          follow    = [&]() {
+    if(zsFollow==size_t(-1))
+      return;
+    auto wp = npc.currentTaPoint();
+    npc.setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+    };
+  auto          endTalk   = [&]() {
+    npc.aiPush(AiQueue::aiStopProcessInfo(aiOutOrderId));
+    ++aiOutOrderId;
+    };
+
+  switch(dlg.scriptFn) {
+    case CompanionHire: {
+      const size_t  gold  = findSymbolIndex("ITMI_GOLD");
+      const int32_t price = hirePrice(npc);
+      if(gold==size_t(-1) || player.itemCount(gold)<size_t(price)) {
+        // Называет цену своим голосом и ждёт денег; диалог продолжается
+        companionSay(npc,player,string_frm("$GOLD_",int(price)));
+        return;
+        }
+      npc.addItem(gold,player,size_t(price));
+      companionSay(npc,player,"$ITookYourGold");
+      setParty(true);
+      follow();
+      Tempest::Log::i("[g2m] companion: hired \"",npc.displayName(),"\" level=",h.level," price=",price);
+      endTalk();
+      break;
+      }
+    case CompanionWait: {
+      const size_t zsStand = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+      auto         wp      = world().findWayPoint(npc.position());
+      if(zsStand!=size_t(-1) && wp!=nullptr)
+        npc.setRoutineAllDay(zsStand, wp->name);
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+      }
+    case CompanionFollow:
+      follow();
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+    case CompanionDismiss:
+      setParty(false);
+      if(h.daily_routine>0)
+        npc.excRoutine(size_t(h.daily_routine));
+      companionSay(npc,player,"$ABS_GOOD");
+      Tempest::Log::i("[g2m] companion: dismissed \"",npc.displayName(),"\"");
+      endTalk();
+      break;
+    default:
+      break;
+    }
+  }
