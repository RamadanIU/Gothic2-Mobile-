@@ -0,0 +1,271 @@
+#include "travelcamera.h"
+
+#include <Tempest/Application>
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+#include "physics/dynamicworld.h"
+#include "world/objects/npc.h"
+#include "world/waypoint.h"
+#include "world/world.h"
+#include "camera.h"
+#include "gothic.h"
+
+using namespace Tempest;
+
+static const float Pi = 3.14159265f;
+
+static float angleMod(float a) {
+  a = std::fmod(a,360.f);
+  if(a<-180.f)
+    a += 360.f;
+  if(a>180.f)
+    a -= 360.f;
+  return a;
+  }
+
+// Направление взгляда по курсу (градусы, как Npc::rotation)
+static Vec3 dirOf(float yaw) {
+  const float a = yaw*Pi/180.f;
+  return Vec3(std::cos(a),0.f,std::sin(a));
+  }
+
+// Высокая камера не цепляется за кроны у героя, но и не уходит в гору: над землёй (крышей, кроной) в своей
+// точке - не ниже clearance
+static Vec3 aboveGround(Vec3 p, float clearance) {
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return p;
+  const auto top = w->physic()->landRay(Vec3(p.x, p.y+5000.f, p.z), 10000.f);
+  if(top.hasCol && top.v.y+clearance>p.y)
+    p.y = top.v.y+clearance;
+  return p;
+  }
+
+static float distXZ(const Vec3& a, const Vec3& b) {
+  const float dx = a.x-b.x, dz = a.z-b.z;
+  return std::sqrt(dx*dx+dz*dz);
+  }
+
+const char* TravelCamera::name(Mode m) {
+  switch(m) {
+    case M_Free:        return "Свободная";
+    case M_Far:         return "Издалека";
+    case M_Bird:        return "С высоты";
+    case M_Side:        return "Сбоку";
+    case M_FirstPerson: return "От первого лица";
+    case M_Cinema:      return "Кино";
+    case M_Count:       break;
+    }
+  return "";
+  }
+
+void TravelCamera::setMode(Mode m) {
+  cur      = (m<M_Count) ? m : M_Free;
+  yawOff   = 0;
+  pitchOff = 0;
+  shotLen  = 0; // «кино» - с нового плана
+  cut      = true;
+  }
+
+void TravelCamera::start(const Npc& pl) {
+  heading  = pl.rotation();
+  yawOff   = 0;
+  pitchOff = 0;
+  hasLast  = false;
+  shotLen  = 0;
+  cut      = true;
+  rng.seed(uint32_t(Application::tickCount()));
+  }
+
+void TravelCamera::resume() {
+  hasLast = false;
+  cut     = true;
+  }
+
+void TravelCamera::look(float dx, float dy) {
+  // Как обычная камера: палец вбок - поворот, вниз - выше и взгляд вниз
+  yawOff   = angleMod(yawOff-dx);
+  pitchOff = std::clamp(pitchOff+dy, -60.f, 75.f);
+  }
+
+Vec3 TravelCamera::orbit(const Vec3& at, float yaw, float pitch, float dist) const {
+  // Камера смотрит на at по курсу yaw, сверху вниз под углом pitch (меньше нуля - снизу вверх)
+  const float p = pitch*Pi/180.f;
+  return at - dirOf(yaw)*(dist*std::cos(p)) + Vec3(0.f, dist*std::sin(p), 0.f);
+  }
+
+void TravelCamera::tick(Camera& cam, const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, uint64_t dt) {
+  const float dtF = float(dt)/1000.f;
+  const Vec3  pos = pl.position();
+  // Курс - по движению героя и плавно: на поворотах дороги камера не дёргается, в бою (на месте) - как был
+  if(hasLast && dtF>0.f) {
+    Vec3 dv = pos-lastPos;
+    dv.y = 0;
+    if(dv.length()>60.f*dtF) {
+      const float a = std::atan2(dv.z,dv.x)*180.f/Pi;
+      heading = angleMod(heading + angleMod(a-heading)*std::min(1.f, 2.5f*dtF));
+      }
+    }
+  lastPos = pos;
+  hasLast = true;
+
+  const Vec3 chest   = pos+Vec3(0.f,130.f,0.f);
+  Vec3       from    = chest;
+  Vec3       at      = chest;
+  bool       collide = true;
+  bool       rigid   = false;
+  auto       pitch   = [this](float base, float lo, float hi) {
+    return std::clamp(base+pitchOff, lo, hi);
+    };
+
+  switch(cur) {
+    case M_Free:
+      from = orbit(chest, heading+yawOff, pitch(14.f,-20.f,85.f), 380.f);
+      break;
+    case M_Far:
+      from = orbit(chest, heading+yawOff, pitch(26.f,-10.f,85.f), 1100.f);
+      break;
+    case M_Bird:
+      // Над кронами: столкновения с деревьями опустили бы камеру в листву
+      at      = pos+Vec3(0.f,60.f,0.f);
+      from    = aboveGround(orbit(at, heading+yawOff, pitch(68.f,35.f,89.f), 2400.f), 400.f);
+      collide = false;
+      break;
+    case M_Side:
+      from = orbit(chest, heading+90.f+yawOff, pitch(6.f,-20.f,85.f), 560.f);
+      break;
+    case M_FirstPerson: {
+      // Глаза героя: чуть впереди головы, как первое лицо движка; смотреть по сторонам - пальцем
+      const float yaw = heading+yawOff;
+      const float p   = std::clamp(pitchOff,-60.f,60.f)*Pi/180.f;
+      const Vec3  dir = dirOf(yaw)*std::cos(p) - Vec3(0.f,std::sin(p),0.f);
+      from    = pl.cameraBone(true) + Vec3(0.f,8.f,0.f) + dirOf(yaw)*22.f;
+      at      = from+dir*1000.f;
+      collide = false;
+      rigid   = true;
+      break;
+      }
+    case M_Cinema: {
+      shotT += dtF;
+      bool next = (shotT>=shotLen);
+      if(shot==S_Track) {
+        // Камера у дороги: держится, пока герой не пробежит мимо и не удалится
+        const float d = distXZ(pos,trackPos);
+        shotNear = std::min(shotNear,d);
+        next = next || (shotNear<1500.f && d>shotNear+700.f) || d>5000.f;
+        }
+      if(next)
+        nextShot(pl,path,idx);
+      const float t = shotT;
+      switch(shot) {
+        case S_Chase: from = orbit(chest, heading+yawOff,                            8.f,  330.f); break;
+        case S_Front: from = orbit(chest, heading+180.f+25.f*std::sin(t*0.35f)+yawOff, 10.f, 470.f); break;
+        case S_SideL: from = orbit(chest, heading+90.f+yawOff,                       5.f,  540.f); break;
+        case S_SideR: from = orbit(chest, heading-90.f+yawOff,                       5.f,  540.f); break;
+        case S_Crane: from = orbit(chest, heading+30.f+t*7.f+yawOff,                 34.f, 950.f); break;
+        case S_Low:   from = orbit(chest, heading+150.f+yawOff,                      -10.f, 270.f); break;
+        case S_Bird:
+          at      = pos+Vec3(0.f,60.f,0.f);
+          from    = aboveGround(orbit(at, heading+t*6.f+yawOff, 66.f, 2100.f), 400.f);
+          collide = false;
+          break;
+        case S_Track:
+          from    = trackPos;
+          collide = false;
+          break;
+        case S_Count:
+          break;
+        }
+      break;
+      }
+    case M_Count:
+      break;
+    }
+
+  cam.setDirector(from, at, cut || rigid, collide);
+  cut = false;
+  }
+
+void TravelCamera::nextShot(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx) {
+  // Следующий план - по долям, не тот же, что сейчас; камера у дороги - если нашлось место, откуда видно путь
+  static const uint8_t weight[S_Count] = {2, 2, 1, 1, 2, 1, 1, 3};
+  uint32_t total = 0;
+  for(auto w:weight)
+    total += w;
+  Shot s  = S_Chase;
+  bool ok = false;
+  for(int attempt=0; attempt<8 && !ok; ++attempt) {
+    uint32_t r = uint32_t(rng()%total);
+    for(uint8_t i=0; i<S_Count; ++i) {
+      if(r<weight[i]) {
+        s = Shot(i);
+        break;
+        }
+      r -= weight[i];
+      }
+    if(s==shot && shotLen>0)
+      continue;
+    if(s==S_Track && !findTrackside(pl,path,idx,trackPos))
+      continue;
+    ok = true;
+    }
+  if(!ok)
+    s = (shot==S_Chase) ? S_Crane : S_Chase;
+  shot     = s;
+  shotT    = 0;
+  shotNear = 1e9f;
+  shotLen  = (s==S_Track) ? 14.f : 6.f+float(rng()%40)/10.f;
+  yawOff   = 0;
+  pitchOff = 0;
+  cut      = true;
+  }
+
+bool TravelCamera::findTrackside(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, Vec3& out) {
+  auto w = Gothic::inst().world();
+  if(w==nullptr || idx>=path.size())
+    return false;
+  // Точка пути в 20 м впереди по дороге и направление дороги там
+  Vec3            prev = pl.position();
+  float           acc  = 0;
+  const WayPoint* wp   = nullptr;
+  Vec3            dir;
+  for(size_t i=idx; i<path.size(); ++i) {
+    const Vec3 p = path[i]->position();
+    Vec3       d = p-prev;
+    d.y = 0;
+    const float l = d.length();
+    acc += l;
+    if(acc>=2000.f && l>1.f) {
+      wp  = path[i];
+      dir = d/l;
+      break;
+      }
+    prev = p;
+    }
+  if(wp==nullptr)
+    return false;
+
+  // Сбоку от дороги на 5 м, на высоте глаз над землёй; дорогу оттуда должно быть видно
+  const Vec3  p     = wp->position();
+  const Vec3  side  = Vec3(-dir.z,0.f,dir.x);
+  const bool  first = (rng()&1u)!=0;
+  auto&       phys  = *w->physic();
+  for(int k=0; k<2; ++k) {
+    const float s = ((k==0)==first) ? 1.f : -1.f;
+    Vec3 c = p + side*(s*500.f) + dir*150.f;
+    const auto land = phys.landRay(c+Vec3(0.f,400.f,0.f), 1500.f);
+    if(!land.hasCol)
+      continue;
+    c.y = land.v.y+160.f;
+    if(std::abs(c.y-p.y)>500.f)
+      continue; // обрыв или скала
+    if(phys.ray(c, p+Vec3(0.f,120.f,0.f)).hasCol)
+      continue;
+    out = c;
+    return true;
+    }
+  return false;
+  }
diff --git a/common/game/travelcamera.h b/common/game/travelcamera.h
