+Rect GameMenu::chainRect(const Item& p) const {
+  // Пункт с IT_EFFECTS_NEXT - одна строка с соседом (подпись и переключатель): касаться можно любой части
+  Rect  r  = itemRect(p);
+  auto* it = &p;
+  for(int i=0; i<zenkit::IMenu::item_count && (it->handle->flags & zenkit::MenuItemFlag::EFFECTS); ++i) {
+    auto next = const_cast<GameMenu*>(this)->selectedNextItem(const_cast<Item*>(it));
+    if(next==nullptr || next==&p)
+      break;
+    const Rect n  = itemRect(*next);
+    const int  x0 = std::min(r.x,n.x), y0 = std::min(r.y,n.y);
+    const int  x1 = std::max(r.x+r.w,n.x+n.w), y1 = std::max(r.y+r.h,n.y+n.h);
+    r  = Rect(x0,y0,x1-x0,y1-y0);
+    it = next;
+    }
+  return r;
+  }
+
+GameMenu::Item* GameMenu::chainOf(Item& p, zenkit::MenuItemType type) {
+  auto* it = &p;
+  for(int i=0; i<zenkit::IMenu::item_count && it!=nullptr; ++i) {
+    if(it->handle!=nullptr && it->handle->type==type)
+      return it;
+    if(!(it->handle->flags & zenkit::MenuItemFlag::EFFECTS))
+      break;
+    auto next = selectedNextItem(it);
+    if(next==&p)
+      break;
+    it = next;
+    }
+  return nullptr;
+  }
