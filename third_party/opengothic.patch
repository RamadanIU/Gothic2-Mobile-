+int Ragdoll::balanceSteps() const {
+  return beh!=nullptr ? beh->bal.steps : 0;
+  }
+
+float Ragdoll::getUpError() const {
+  return beh!=nullptr ? beh->getUp.err : 0.f;
+  }
+
+float Ragdoll::reaction() const {
+  if(!isSimulated())
+    return 0;
+  if(beh==nullptr)
+    return 0;
+  float r = (beh->pushAt>=0.f || beh->stepping) ? 1.f : 0.f;
+  r = std::max(r, beh->armsW);
+  for(auto& x:beh->reflex)
+    r = std::max(r, x.env(beh->now));
+  for(size_t i=0; i<drive.size(); ++i)
+    r = std::max(r, 1.f-toneOf(i));
+  return r;
+  }
+
+void Ragdoll::activePose(std::vector<Matrix4x4>& rel, Stance& stance) const {
+  // корпус, голова, руки - физика относительно цели таза (Pose ставит их на таз со стойкой); таз и ноги - стойка
+  // поведения поверх анимации. Относительно цели, а не тела таза: тело таза держится за целью с малой дрожью, и её
+  // поворот на экране раскачивал бы весь корпус и руки
+  Matrix4x4 inv = boneWorld[0];
+  if(st==S_Active && drive.size()==body.size() && !drive.empty()) {
+    const auto& d = drive[0];
+    btTransform g = d.goal;
+    g.setOrigin(g.getOrigin() + d.tLin*targetAge);
+    g.setRotation(rotOf(d.tAng*targetAge)*g.getRotation());
+    inv = fromBt(g)*lay->parts[0].boneInBody;
+    }
+  inv.inverse();
+  rel.resize(boneWorld.size());
+  for(size_t i=0; i<boneWorld.size(); ++i)
+    rel[i] = inv*boneWorld[i];
+  stance = Stance();
+  if(beh==nullptr || !beh->stance || st!=S_Active)
+    return;
+  const auto& b = *beh;
+  stance.shift  = cmv(b.pelShift);
+  stance.rot    = Vec3(b.pelRot.x(),b.pelRot.y(),b.pelRot.z());
+  stance.weight = 1.f;
+  if(lay->stance)
+    for(int k=0; k<2; ++k) {
+      stance.foot[k]  = cmv(b.footAt[k]);
+      stance.footW[k] = b.footW[k];
+      }
+  }
+
+// ---- Полный регдолл на ногах после толчка (S_Balance)
+
+void Ragdoll::massCenter(btVector3& com, btVector3& vel) const {
+  com = btVector3(0,0,0);
+  vel = btVector3(0,0,0);
+  float M = 0;
+  for(size_t i=0; i<body.size(); ++i) {
+    const float m = lay->parts[i].mass;
+    com += body[i].rb->getCenterOfMassPosition()*m;
+    vel += body[i].rb->getLinearVelocity()*m;
+    M   += m;
+    }
+  if(M>0.f) {
+    com /= M;
+    vel /= M;
+    }
+  }
+
+float Ragdoll::groundAt(const btVector3& at, float fallback) const {
+  const Vec3 p = cmv(at);
+  const auto r = owner->ray(p+Vec3(0,60,0), p-Vec3(0,250,0));
+  return r.hasCol ? r.v.y*0.01f : fallback;
+  }
