@@ -0,0 +1,162 @@
+#include "travelpoints.h"
+
+#include <Tempest/Log>
+
+#include <cctype>
+#include <iterator>
+
+#include "world/waypoint.h"
+#include "world/world.h"
+
+using namespace Tempest;
+
+// Gothic II Mobile: карты - те же текстуры и координаты, что у карт-предметов в скриптах игры
+// (ItWr_Map_NewWorld, ItWr_Map_NewWorld_City, ItWr_Map_OldWorld, ItWr_Map_AddonWorld)
+static const TravelPoints::MapInfo maps[TravelPoints::M_Count] = {
+  {"newworld.zen",   "Map_NewWorld.tga",      -28000, 50500, 95500, -42500, "Хоринис"},
+  {"newworld.zen",   "Map_NewWorld_City.tga",  -6900, 11800, 21600,  -9400, "Город Хоринис"},
+  {"oldworld.zen",   "Map_OldWorld.tga",      -78500, 47500, 54000, -53000, "Долина Рудников"},
+  {"addonworld.zen", "Map_AddonWorld.tga",    -47783, 36300, 43949, -32300, "Яркендар"},
+  };
+
+using P = TravelPoints;
+
+// Порядок не важен: точки ищутся по имени при каждом открытии карты
+static const TravelPoints::Point points[] = {
