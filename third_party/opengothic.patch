diff --git a/common/utils/mobileperf.cpp b/common/utils/mobileperf.cpp
new file mode 100644
index 0000000..527dac3
--- /dev/null
+++ b/common/utils/mobileperf.cpp
@@ -0,0 +1,116 @@
+#include "mobileperf.h"
+
+#include <Tempest/Log>
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#if defined(__ANDROID__)
+#include <dlfcn.h>
+#include <unistd.h>
+#endif
+
+using namespace Tempest;
+
+MobilePerf& MobilePerf::inst() {
+  static MobilePerf p;
+  return p;
+  }
+
+MobilePerf::MobilePerf() {
+#if defined(__ANDROID__)
+  lib = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+  if(lib==nullptr)
+    return;
+  getManager   = reinterpret_cast<GetManagerFn> (dlsym(lib, "APerformanceHint_getManager"));
+  createSess   = reinterpret_cast<CreateFn>     (dlsym(lib, "APerformanceHint_createSession"));
+  updateTarget = reinterpret_cast<UpdateFn>     (dlsym(lib, "APerformanceHint_updateTargetWorkDuration"));
+  reportActual = reinterpret_cast<ReportFn>     (dlsym(lib, "APerformanceHint_reportActualWorkDuration"));
+  auto acquire = reinterpret_cast<ThermalAcqFn> (dlsym(lib, "AThermal_acquireManager"));
+  thermalStat  = reinterpret_cast<ThermalStatFn>(dlsym(lib, "AThermal_getCurrentThermalStatus"));
+  thermalHead  = reinterpret_cast<ThermalHeadFn>(dlsym(lib, "AThermal_getThermalHeadroom"));
+  if(acquire!=nullptr)
+    thermal = acquire();
+#endif
+  }
+
+int32_t MobilePerf::currentThreadId() {
+#if defined(__ANDROID__)
+  return int32_t(gettid());
+#else
+  return 0;
+#endif
+  }
+
+void MobilePerf::registerThread() {
+  auto& p = inst();
+  std::lock_guard<std::mutex> guard(p.sync);
+  p.threads.push_back(currentThreadId());
+  }
+
+bool MobilePerf::hasHints() {
+  return inst().session!=nullptr;
+  }
+
+void MobilePerf::createSession(int64_t targetNs) {
+  std::vector<int32_t> tids;
+  {
+    std::lock_guard<std::mutex> guard(sync);
+    tids = threads;
+  }
+  if(getManager==nullptr || createSess==nullptr || reportActual==nullptr || tids.empty()) {
+    failed = true;
+    Log::i("[perf] performance hints: not available");
+    return;
+    }
+  hintMgr = getManager();
+  if(hintMgr!=nullptr)
+    session = createSess(hintMgr, tids.data(), tids.size(), targetNs);
+  if(session==nullptr) {
+    failed = true;
+    Log::i("[perf] performance hints: no session");
+    return;
+    }
+  target = targetNs;
+  Log::i("[perf] performance hints: ", int(tids.size()), " threads, target ", int(targetNs/1000), "us");
+  }
+
+void MobilePerf::reportFrame(int64_t actualNs, int64_t targetNs) {
+  auto& p = inst();
+  if(p.failed || targetNs<=0)
+    return;
+  // Рабочие потоки создаются при первых кадрах мира - сессия после того, как они записались (или,
+  // если их всё нет, через ~30 с - с одним главным потоком)
+  if(p.session==nullptr) {
+    ++p.frames;
+    size_t count = 0;
+    {
+      std::lock_guard<std::mutex> guard(p.sync);
+      count = p.threads.size();
+    }
+    if(p.frames<120 || (count<2 && p.frames<1800))
+      return;
+    p.createSession(targetNs);
+    if(p.session==nullptr)
+      return;
+    }
+  if(targetNs!=p.target && p.updateTarget!=nullptr) {
+    p.updateTarget(p.session, targetNs);
+    p.target = targetNs;
+    }
+  p.reportActual(p.session, std::max<int64_t>(actualNs, 1));
+  }
+
+MobilePerf::Thermal MobilePerf::thermalStatus() {
+  auto& p = inst();
+  if(p.thermal==nullptr || p.thermalStat==nullptr)
+    return T_Unknown;
+  return Thermal(p.thermalStat(p.thermal));
+  }
+
+float MobilePerf::thermalHeadroom() {
+  auto& p = inst();
+  if(p.thermal==nullptr || p.thermalHead==nullptr)
+    return std::numeric_limits<float>::quiet_NaN();
+  return p.thermalHead(p.thermal, 0);
+  }
diff --git a/common/utils/mobileperf.h b/common/utils/mobileperf.h
new file mode 100644
index 0000000..bf88d71
--- /dev/null
+++ b/common/utils/mobileperf.h
@@ -0,0 +1,70 @@
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+// Gothic II Mobile: возможности Android для игр, которых нет в Tempest.
+//  - подсказки планировщику (ADPF, Android 13+): сколько времени процессора кадр занял и сколько ему
+//    положено - система сама держит частоты ядер не выше нужного (меньше нагрев), а при нехватке
+//    поднимает их раньше (меньше рывков);
+//  - состояние перегрева (Android 10+/11+): в журнал и для снижения частоты кадров при сильном нагреве.
+// Функции берутся из libandroid.so по имени: приложение ставится и на Android 9, где их нет.
+class MobilePerf final {
+  public:
+    // Состояния перегрева - как AThermalStatus
+    enum Thermal : int32_t {
+      T_Unknown  = -1,
+      T_None     = 0,
+      T_Light    = 1,
+      T_Moderate = 2,
+      T_Severe   = 3,
+      T_Critical = 4,
+      T_Emergency= 5,
+      T_Shutdown = 6,
+      };
+
+    static int32_t currentThreadId();
+
+    // Потоки, чью работу видит подсказка (главный и рабочие); вызывать из этих потоков
+    static void    registerThread();
+
+    // Конец работы кадра: actualNs - время процессора на кадр, targetNs - бюджет (1/FPS)
+    static void    reportFrame(int64_t actualNs, int64_t targetNs);
+
+    static Thermal thermalStatus();
+    // Запас до перегрева: 1.0 - начнётся снижение частот; NaN - неизвестно (не чаще раза в секунду)
+    static float   thermalHeadroom();
+    static bool    hasHints();
+
+  private:
+    static MobilePerf& inst();
+    MobilePerf();
+
+    void           createSession(int64_t targetNs);
+
+    void*          lib       = nullptr;
+    void*          hintMgr   = nullptr;
+    void*          session   = nullptr;
+    void*          thermal   = nullptr;
+    int64_t        target    = 0;
+    bool           failed    = false;
+    uint32_t       frames    = 0;
+    std::mutex     sync;
+    std::vector<int32_t> threads;
+
+    using GetManagerFn  = void*   (*)();
+    using CreateFn      = void*   (*)(void*, const int32_t*, size_t, int64_t);
+    using UpdateFn      = int     (*)(void*, int64_t);
+    using ReportFn      = int     (*)(void*, int64_t);
+    using ThermalAcqFn  = void*   (*)();
+    using ThermalStatFn = int     (*)(void*);
+    using ThermalHeadFn = float   (*)(void*, int);
+
+    GetManagerFn  getManager    = nullptr;
+    CreateFn      createSess    = nullptr;
+    UpdateFn      updateTarget  = nullptr;
+    ReportFn      reportActual  = nullptr;
+    ThermalStatFn thermalStat   = nullptr;
+    ThermalHeadFn thermalHead   = nullptr;
+  };
