+int32_t Npc::fightTactic() const {
+  if(!isPlayer())
+    return hnpc->fight_tactic;
+  // Gothic II Mobile: у героя своей тактики нет - берём человеческую по владению оружием
+  const auto ws    = weaponState();
+  const auto skill = talentSkill(ws==WeaponState::W2H ? TALENT_2H : TALENT_1H);
+  const char* names[] = {"FAI_HUMAN_MASTER", "FAI_HUMAN_STRONG", "FAI_HUMAN_NORMAL"};
+  for(size_t i=(skill>=2 ? 0 : (skill==1 ? 1 : 2)); i<std::size(names); ++i) {
+    if(auto s = owner.script().findSymbol(names[i]))
+      return s->get_int();
+    }
+  return hnpc->fight_tactic;
+  }
