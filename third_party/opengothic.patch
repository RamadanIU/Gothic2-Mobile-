+bool Ragdoll::chestPoint(const Skeleton& sk, const Matrix4x4* bones, size_t count, Vec3& at) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || bones==nullptr || lay->chest>=lay->parts.size())
+    return false;
+  auto& p = lay->parts[lay->chest];
+  if(p.bone>=count)
+    return false;
+  at = originOf(bones[p.bone]*p.bodyInBone);
+  return true;
+  }
