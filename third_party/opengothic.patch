+    case C_Block:   return arc(92*d,  180, 27*d);
+    case C_Potion:  return arc(154*d, 102, 22*d);
+    case C_Auto:    return arc(154*d, 128, 22*d);
+    case C_Gather:  return arc(154*d, 154, 22*d);
+    case C_Squad:   return arc(154*d, 180, 22*d);
+    case C_Sneak:   return round(m + 22*d, H*0.5f, 22*d);
+    case C_Bag:     return top(0);
+    case C_Map:     return top(1);
+    case C_Log:     return top(2);
+    case C_Hero:    return top(3);
+    case C_Menu:    return top(4);
