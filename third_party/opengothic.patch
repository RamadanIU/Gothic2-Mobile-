+void TouchInput::paintEvent(PaintEvent& e) {
+  const uint8_t m = currentMode();
+  if(m!=lastMode) {
+    // Экран сменился (открылся диалог, сумка, меню) - всё, что держали пальцы, отпускается
+    releaseAll();
+    lastMode = m;
+    }
+  if(MainWindow::TouchMode(m)==MainWindow::TouchMode::Hidden)
+    return;
+
   Painter p(e);
+  for(uint8_t i=C_Attack; i<C_Count; ++i) {
+    const Ctl c = Ctl(i);
+    if(!isShown(c))
+      continue;
+    bool pressed = false;
+    for(auto& f:fingers)
+      if(f.ctl==c)
+        pressed = true;
+    drawButton(p, c, pressed, c==C_Auto && ctrl.isAutoFight());
+    }
+  if(MainWindow::TouchMode(m)==MainWindow::TouchMode::World)
+    drawJoystick(p);
+  }
