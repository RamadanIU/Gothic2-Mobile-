+void AiNpc::setActivity(Npc& npc, std::string_view zs) {
+  // Распорядок на весь день с точкой-меткой лагеря: стоит или занят делом там, где оказался, к точкам
+  // распорядка игры не уходит (как лагерь отряда «Ждать здесь»)
