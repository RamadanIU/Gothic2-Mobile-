+TouchInput::Button TouchInput::buttonOf(Ctl c) const {
+  // Место по умолчанию, затем настройка игрока: общий размер - от ближнего угла экрана (дуга под пальцем
+  // остаётся в углу и растёт вся), сдвиг и размер кнопки; кнопка не уходит за край
+  Button b = baseButtonOf(c);
+  if(!isMovable(c) || b.r<=0)
+    return b;
+  const float d  = dp();
+  const auto  s  = scaledCenter(b);
+  const auto& pl = place[c];
+  const float r  = std::clamp(float(b.r)*layScale*pl.scale, 10*d, 90*d);
+  const float cx = std::clamp(float(s.x)+pl.dx*d, r, std::max(r, float(w())-r));
+  const float cy = std::clamp(float(s.y)+pl.dy*d, r, std::max(r, float(h())-r));
+  b.c = Point(int(cx),int(cy));
+  b.r = int(r);
+  return b;
+  }
+
+Point TouchInput::scaledCenter(const Button& b) const {
+  const float W  = float(w()), H = float(h());
+  const float bx = float(b.c.x), by = float(b.c.y);
+  // Кнопка посередине (камера в пути) остаётся посередине
+  const float ax = std::abs(bx-W*0.5f)<W*0.05f ? bx : (bx<W*0.5f ? 0.f : W);
+  const float ay = std::abs(by-H*0.5f)<H*0.05f ? by : (by<H*0.5f ? 0.f : H);
+  return Point(int(ax+(bx-ax)*layScale), int(ay+(by-ay)*layScale));
+  }
+
+TouchInput::Button TouchInput::baseButtonOf(Ctl c) const {
+  const float d = dp();
+  const float W = float(w());
+  const float H = float(h());
+  const float m = 16*d;
+
+  // Главная кнопка под большим пальцем, остальные - на двух дугах вокруг неё
+  const float mx = W - 66*d, my = H - 60*d;
+  auto round = [](float x, float y, float r) {
+    Button b;
+    b.c = Point(int(x),int(y));
+    b.r = int(r);
+    return b;
+    };
+  auto arc = [&](float rad, float deg, float r) {
+    const float a = deg*Pi/180.f;
+    return round(mx + rad*std::cos(a), my - rad*std::sin(a), r);
+    };
+  auto pill = [](float x, float y, float pw, float ph) {
+    Button b;
+    b.rect = Rect(int(x),int(y),int(pw),int(ph));
+    b.c    = Point(int(x+pw*0.5f),int(y+ph*0.5f));
+    return b;
+    };
+  // Ряд системных кнопок справа вверху; самая нужная - «Сумка» - ближе к краю, «Путь» - рядом с «Картой»,
+  // «Сохранить» - рядом с «Меню»
+  auto top = [&](int k) {
+    return round(W - m - 19*d - float(k)*44*d, 12*d + 19*d, 19*d);
+    };
+
+  const float pw = 150*d, ph = 42*d;
+  switch(c) {
+    case C_Main:    return round(mx, my, 40*d);
+    case C_Weapon:  return arc(92*d,   90, 27*d);
+    case C_Jump:    return arc(92*d,  135, 27*d);
+    case C_Block:   return arc(92*d,  180, 27*d);
+    case C_Potion:  return arc(154*d, 102, 22*d);
+    case C_Auto:    return arc(154*d, 128, 22*d);
+    case C_Gather:  return arc(154*d, 154, 22*d);
+    case C_Squad:   return arc(154*d, 180, 22*d);
+    // Над «Оружием», у правого края: подпись - над кнопкой
+    case C_Say:     return arc(154*d,  76, 22*d);
+    case C_Sneak:   return round(m + 22*d, H*0.5f, 22*d);
+    case C_Bag:     return top(0);
+    case C_Map:     return top(1);
+    case C_Travel:  return top(2);
+    case C_Log:     return top(3);
+    case C_Hero:    return top(4);
+    case C_Save:    return top(5);
+    case C_Menu:    return top(6);
+    // Над строкой «В пути» внизу посередине: справа обзор, слева джойстик - мимо кнопки не прервать путь
+    case C_Camera:  return round(W*0.5f, H - 16*d - 34*d - 10*d - 22*d, 22*d);
+    case C_Back:    return pill(m, H - m - ph, pw*0.9f, ph);
+    case C_Select:  return pill(W - m - pw, H - m - ph, pw, ph);
+    // Над сеткой сундука, рядом с его названием: внизу справа - сетка сумки героя
+    case C_TakeAll: return pill(m + 112*d, 10*d, pw, ph);
+    case C_Skip:    return pill(W - m - pw, 12*d, pw, ph);
+    // Справа вверху, над пунктами меню; шире - подпись длинная
+    case C_App:     return pill(W - m - pw*1.25f, 12*d, pw*1.25f, ph);
+    case C_Edit:    return pill(W - m - pw*1.25f - 10*d - pw*0.9f, 12*d, pw*0.9f, ph);
+    case C_Up:      return round(m + 26*d, H - m - ph - 16*d - 26*d - 62*d, 26*d);
+    case C_Down:    return round(m + 26*d, H - m - ph - 16*d - 26*d, 26*d);
+    // Взлом - слева внизу; в меню игры (ползунки, переключатели) - над «Выбрать», под правым пальцем
+    case C_Left:
+      if(currentUi()==Ui::Menu)
+        return round(W - m - pw + 30*d, H - m - ph - 16*d - 30*d, 30*d);
+      return round(m + 36*d,         H - m - ph - 20*d - 36*d, 36*d);
+    case C_Right:
+      if(currentUi()==Ui::Menu)
+        return round(W - m - 30*d,      H - m - ph - 16*d - 30*d, 30*d);
+      return round(m + 36*d + 88*d,  H - m - ph - 20*d - 36*d, 36*d);
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_List:
+    case C_Absorb:
+    case C_Count:
+      break;
+    }
+  return Button();
+  }
+
+bool TouchInput::isShown(Ctl c) const {
+  const auto ui = currentUi();
+  auto  pl      = Gothic::inst().player();
+  const auto ws = pl!=nullptr ? pl->weaponState() : WeaponState::NoWeapon;
+  switch(c) {
+    case C_Main:
+    case C_Jump:
+    case C_Weapon:
+    case C_Auto:
+    case C_Sneak:
+    case C_Bag:
+    case C_Map:
+    case C_Log:
+    case C_Hero:
