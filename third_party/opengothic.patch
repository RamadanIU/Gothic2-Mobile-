+void TouchInput::drawBadge(Painter& p, const Button& b, size_t n) {
+  if(n==0)
+    return;
+  const int  r  = int(9*dp());
+  const auto c  = Point(b.c.x+int(float(b.r)*0.72f), b.c.y+int(float(b.r)*0.72f));
+  const int  ds = int(float(2*r)/0.88f);
+  auto&      d  = icons.disc(ds);
+  p.setBrush(Brush(d,Color(1.f)));
+  p.drawRect(c.x-ds/2, c.y-ds/2, ds, ds, 0,0,d.w(),d.h());
+  drawLabel(p, std::to_string(std::min<size_t>(n,99)), c, true, 0.75f);
+  }
