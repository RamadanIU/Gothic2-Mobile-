+      case C_TakeAll:
+        drawPill(p,b.rect,TouchIcons::I_TakeAll,toCp1251("Взять всё"),pressed);
+        break;
+      case C_Skip:
+        drawPill(p,b.rect,TouchIcons::I_Skip,toCp1251("Пропустить"),pressed);
+        break;
+      case C_App:
+        drawPill(p,b.rect,TouchIcons::I_Menu,toCp1251("Приложение"),pressed);
+        break;
+      case C_Edit:
+        drawPill(p,b.rect,TouchIcons::I_Hand,toCp1251("Кнопки"),pressed);
+        break;
+      case C_None:
+      case C_Joy:
+      case C_Look:
+      case C_List:
+      case C_Absorb:
+      case C_Count:
+        break;
+      }
+    }
+
+  // Долгие нажатия: кольцо заполняется, пока держат
+  const uint64_t now = Application::tickCount();
+  for(auto& f:fingers) {
+    if(f.held || f.moved)
+      continue;
+    if(f.ctl==C_Save && now-f.downAt>150)
+      drawHoldRing(p,buttonOf(C_Save),float(now-f.downAt-150)/550.f);
+    if(f.ctl==C_Potion && now-f.downAt>150 && ctrl.potionCount(true)>0)
+      drawHoldRing(p,buttonOf(C_Potion),float(now-f.downAt-150)/300.f);
+    }
+
+  if(wheel!=Wheel::None)
+    drawWheel(p);
+  }
