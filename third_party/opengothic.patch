+TouchInput::Ctl TouchInput::editHit(Point p) const {
+  // Сверху - то, что нарисовано последним; запас - палец крупнее круга
+  const int slop = int(6*dp());
+  for(int i=int(C_Count)-1; i>=int(C_Main); --i) {
+    const Ctl c = Ctl(i);
+    if(!isMovable(c))
+      continue;
+    const auto b  = buttonOf(c);
+    const int  dx = p.x-b.c.x, dy = p.y-b.c.y, r = b.r+slop;
+    if(dx*dx+dy*dy<=r*r)
+      return c;
+    }
+  return C_None;
+  }
