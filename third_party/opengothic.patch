+const QuestLog::Quest* GameMenu::questOf(const Item& list, int32_t id) const {
+  auto ql = Gothic::inst().questLog();
+  if(ql==nullptr || list.handle==nullptr)
+    return nullptr;
+  const auto st  = toStatus(list.handle->user_string[0]);
+  int32_t    num = 0;
+  for(size_t i=0; i<ql->questCount(); ++i) {
+    auto& quest = ql->quest(ql->questCount()-i-1);
+    if(!isCompatible(quest,st))
+      continue;
+    if(num==id)
+      return &quest;
+    ++num;
+    }
+  return nullptr;
+  }
+
+bool GameMenu::openLogList(Item& list) {
+  const int32_t num = numQuests(Gothic::inst().questLog(),toStatus(list.handle->user_string[0]));
+  if(num<=0)
+    return false;
+  if(logList!=&list) {
+    if(logList==nullptr)
+      logPrev = curItem;
+    logList    = &list;
+    freeScroll = nullptr;
+    curItem    = indexOf(list); // подсветка строки - у выделенного списка (drawQuestList)
+    }
+  list.value = std::clamp(list.value,0,num-1);
+  update();
+  return true;
+  }
+
+void GameMenu::openLogEntry() {
+  if(logList==nullptr)
+    return;
+  auto* view  = selectedContentItem(logList);
+  auto* quest = questOf(*logList,logList->value);
+  if(view==nullptr || quest==nullptr)
+    return;
+  std::string text;
+  for(size_t i=0; i<quest->entry.size(); ++i) {
+    text += quest->entry[i];
+    if(i+1<quest->entry.size())
+      text+="\n---\n";
+    }
+  view->scroll          = 0;
+  view->handle->text[0] = text;
+  view->visible         = true;
+  logView               = view;
+  curItem               = indexOf(*view);
+  update();
+  }
+
+bool GameMenu::closeSubView() {
+  if(logView!=nullptr) {
+    logView->visible = false;
+    logView          = nullptr;
+    curItem          = logList!=nullptr ? indexOf(*logList) : logPrev;
+    update();
+    return true;
+    }
+  if(logList!=nullptr) {
+    logList    = nullptr;
+    freeScroll = nullptr;
+    curItem    = logPrev;
+    update();
+    return true;
+    }
+  return false;
+  }
