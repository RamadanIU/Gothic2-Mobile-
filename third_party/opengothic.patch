+void TouchInput::applyWheel(int id) {
+  if(id<0 || size_t(id)>=wheelItems.size() || !wheelItems[size_t(id)].enabled)
+    return;
+  const auto& it = wheelItems[size_t(id)];
+  if(wheel==Wheel::Weapon) {
+    ctrl.touchDrawWeapon(it.action);
