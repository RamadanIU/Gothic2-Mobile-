+  pl.setAutoFight(true);
+
+  // Здоровья меньше четверти - зелье, не чаще раза в 4 с
+  const uint64_t now = Gothic::inst().world()->tickCount();
+  if(pl.attribute(ATR_HITPOINTS)*4<pl.attribute(ATR_HITPOINTSMAX) && now>autoHealTime) {
+    autoHealTime = now+4000;
+    drinkHealPotion();
+    }
+
+  rotMouse     = 0;
+  rotMouseY    = 0;
+  runAngleDest = 0;
+  return true;
   }
 
