+  }
+
+std::vector<float> rasterize(const std::vector<Shape>& shapes, int size) {
+  std::vector<float> cov(size_t(size*size), 0.f);
+  const float px = 1.f/float(size);
+  for(int y=0; y<size; ++y) {
+    for(int x=0; x<size; ++x) {
+      const P p = P{(float(x)+0.5f)*px, (float(y)+0.5f)*px};
+      float   c = 0;
+      for(auto& s:shapes) {
+        const float k = std::clamp(0.5f - sdf(s,p)/px, 0.f, 1.f);
+        if(s.erase)
+          c *= (1.f-k); else
+          c = std::max(c,k);
+        }
+      cov[size_t(y*size+x)] = c;
+      }
+    }
+  return cov;
+  }
+
+Texture2d toTexture(const std::vector<float>& rgba, int w, int h) {
+  Pixmap pm(uint32_t(w),uint32_t(h),TextureFormat::RGBA8);
+  auto*  dst = reinterpret_cast<uint8_t*>(pm.data());
+  for(size_t i=0; i<rgba.size(); ++i)
+    dst[i] = uint8_t(std::clamp(rgba[i],0.f,1.f)*255.f+0.5f);
+  return Resources::loadTexturePm(pm);
+  }
+
+Texture2d alphaTexture(const std::vector<float>& a, int w, int h, float r, float g, float b) {
+  std::vector<float> rgba(a.size()*4);
+  for(size_t i=0; i<a.size(); ++i) {
+    rgba[i*4+0] = r;
+    rgba[i*4+1] = g;
+    rgba[i*4+2] = b;
+    rgba[i*4+3] = a[i];
+    }
+  return toTexture(rgba,w,h);
+  }
+
+struct Rgba {
+  float r = 0, g = 0, b = 0, a = 0;
+  };
+
+static Rgba over(Rgba src, Rgba dst) {
+  const float a = src.a + dst.a*(1.f-src.a);
+  if(a<=0.f)
+    return Rgba();
+  auto mix = [&](float s, float d) { return (s*src.a + d*dst.a*(1.f-src.a))/a; };
+  return Rgba{mix(src.r,dst.r), mix(src.g,dst.g), mix(src.b,dst.b), a};
+  }
+
+static float lerp(float a, float b, float t) { return a+(b-a)*t; }
+
+// Подложка: тень снаружи, полупрозрачная тёмная кожа с отсветом сверху, кольцо старой бронзы с бликом.
+// dist - расстояние со знаком до края кнопки в пикселях (меньше нуля - внутри), ny - высота 0..1, rad - радиус
+Rgba plate(float dist, float ny, float rad, float pad) {
+  Rgba c;
+  if(dist>0.f) {
+    const float k = std::clamp(1.f - dist/pad, 0.f, 1.f);
+    c = Rgba{0,0,0, 0.38f*k*k};
+    }
+
+  const float fill  = std::clamp(0.5f - dist, 0.f, 1.f);
+  const float depth = std::clamp(-dist/rad, 0.f, 1.f);
+  const float tone  = 0.05f + 0.10f*std::pow(depth,0.7f) + 0.05f*(1.f-ny);
+  Rgba body = Rgba{tone*1.35f, tone*1.05f, tone*0.72f, 0.62f*fill};
+  c = over(body,c);
+
+  const float ringW = std::max(1.5f, rad*0.075f);
+  const float rd    = std::abs(dist + ringW*0.5f) - ringW*0.5f;
+  const float ring  = std::clamp(0.5f - rd, 0.f, 1.f);
+  if(ring>0.f) {
+    // свет сверху: светлое золото вверху, тёмная бронза внизу
+    const float t = std::clamp(ny, 0.f, 1.f);
+    Rgba m = Rgba{lerp(0.92f,0.46f,t), lerp(0.76f,0.32f,t), lerp(0.44f,0.15f,t), ring};
+    c = over(m,c);
+    }
+  // тонкая тёмная линия под кольцом - кольцо «утоплено» в кожу
+  const float ld   = std::abs(dist + ringW + 0.6f) - 0.6f;
+  const float line = std::clamp(0.5f - ld, 0.f, 1.f)*0.7f;
+  if(line>0.f)
+    c = over(Rgba{0.02f,0.015f,0.01f,line},c);
+  return c;
+  }
+
+}
+
+const Texture2d& TouchIcons::cached(uint64_t key, const std::function<Texture2d()>& make) {
+  auto it = cache.find(key);
+  if(it!=cache.end())
+    return *it->second;
+  auto t = std::make_unique<Texture2d>(make());
+  auto& ret = *t;
+  cache[key] = std::move(t);
+  return ret;
+  }
+
+const Texture2d& TouchIcons::icon(Icon i, int size) {
+  size = std::clamp(size,4,512);
+  const uint64_t key = (uint64_t(1)<<40) | (uint64_t(i)<<16) | uint64_t(size);
+  return cached(key,[i,size](){
+    auto g = glyph(i);
+    return alphaTexture(rasterize(g.shapes,size),size,size,1.f,1.f,1.f);
+    });
+  }
+
+const Texture2d& TouchIcons::shadow(Icon i, int size) {
+  size = std::clamp(size,4,512);
+  const uint64_t key = (uint64_t(2)<<40) | (uint64_t(i)<<16) | uint64_t(size);
+  return cached(key,[i,size](){
+    auto  g   = glyph(i);
+    auto  a   = rasterize(g.shapes,size);
+    // размытие квадратом в два прохода
+    const int r = std::max(1, size/28);
+    std::vector<float> tmp(a.size(),0.f);
+    for(int y=0; y<size; ++y)
+      for(int x=0; x<size; ++x) {
+        float s = 0;
+        for(int k=-r; k<=r; ++k)
+          s += a[size_t(y*size+std::clamp(x+k,0,size-1))];
+        tmp[size_t(y*size+x)] = s/float(2*r+1);
+        }
+    for(int y=0; y<size; ++y)
+      for(int x=0; x<size; ++x) {
+        float s = 0;
+        for(int k=-r; k<=r; ++k)
+          s += tmp[size_t(std::clamp(y+k,0,size-1)*size+x)];
+        a[size_t(y*size+x)] = std::min(1.f, 1.6f*s/float(2*r+1));
+        }
+    return alphaTexture(a,size,size,0.f,0.f,0.f);
+    });
+  }
+
+const Texture2d& TouchIcons::disc(int size) {
+  size = std::clamp(size,8,1024);
+  const uint64_t key = (uint64_t(3)<<40) | uint64_t(size);
+  return cached(key,[size](){
+    const float R   = float(size)*0.5f;
+    const float pad = std::max(2.f, float(size)*0.06f);
+    const float rad = R-pad;
+    std::vector<float> rgba(size_t(size*size*4));
+    for(int y=0; y<size; ++y)
+      for(int x=0; x<size; ++x) {
+        const float dx = float(x)+0.5f-R, dy = float(y)+0.5f-R;
+        const float d  = std::sqrt(dx*dx+dy*dy) - rad;
+        const Rgba  c  = plate(d, (float(y)+0.5f)/float(size), rad, pad);
+        float* o = &rgba[size_t((y*size+x)*4)];
+        o[0] = c.r; o[1] = c.g; o[2] = c.b; o[3] = c.a;
+        }
+    return toTexture(rgba,size,size);
+    });
+  }
+
+const Texture2d& TouchIcons::pill(int w, int h) {
+  w = std::clamp(w,8,2048);
+  h = std::clamp(h,8,1024);
+  const uint64_t key = (uint64_t(4)<<40) | (uint64_t(w)<<16) | uint64_t(h);
+  return cached(key,[w,h](){
+    const float R   = float(h)*0.5f;
+    const float pad = std::max(2.f, float(h)*0.08f);
+    const float rad = R-pad;
+    // скругление углов - треть высоты, как у панелей игры
+    const float cr  = rad*0.55f;
+    std::vector<float> rgba(size_t(w*h*4));
+    for(int y=0; y<h; ++y)
+      for(int x=0; x<w; ++x) {
+        const float px = float(x)+0.5f, py = float(y)+0.5f;
+        // скруглённый прямоугольник с отступом pad
+        const float qx = std::abs(px-float(w)*0.5f) - (float(w)*0.5f-pad-cr);
+        const float qy = std::abs(py-float(h)*0.5f) - (float(h)*0.5f-pad-cr);
+        const float ox = std::max(qx,0.f), oy = std::max(qy,0.f);
+        const float d  = std::sqrt(ox*ox+oy*oy) + std::min(std::max(qx,qy),0.f) - cr;
+        const Rgba  c  = plate(d, py/float(h), rad, pad);
+        float* o = &rgba[size_t((y*w+x)*4)];
+        o[0] = c.r; o[1] = c.g; o[2] = c.b; o[3] = c.a;
+        }
+    return toTexture(rgba,w,h);
+    });
+  }
+
+const Texture2d& TouchIcons::glow(int size) {
+  size = std::clamp(size,8,1024);
+  const uint64_t key = (uint64_t(5)<<40) | uint64_t(size);
+  return cached(key,[size](){
+    // Холст на 30% больше кнопки: свечение выходит за кольцо
+    const float S   = float(size)*1.3f;
+    const int   n   = int(S);
+    const float R   = S*0.5f;
+    const float rad = float(size)*0.5f - std::max(2.f, float(size)*0.06f);
+    const float wid = rad*0.16f;
+    std::vector<float> a(size_t(n*n));
+    for(int y=0; y<n; ++y)
+      for(int x=0; x<n; ++x) {
+        const float dx = float(x)+0.5f-R, dy = float(y)+0.5f-R;
+        const float d  = (std::sqrt(dx*dx+dy*dy) - rad)/wid;
+        a[size_t(y*n+x)] = std::exp(-d*d)*0.9f;
+        }
+    // Цвет умножен на прозрачность: сложение (ONE, ONE) прозрачность не учитывает, и белый цвет
+    // в прозрачных углах лёг бы на экран квадратом
+    std::vector<float> rgba(a.size()*4);
+    for(size_t i=0; i<a.size(); ++i) {
+      rgba[i*4+0] = a[i];
+      rgba[i*4+1] = a[i];
+      rgba[i*4+2] = a[i];
+      rgba[i*4+3] = a[i];
+      }
+    return toTexture(rgba,n,n);
+    });
+  }
