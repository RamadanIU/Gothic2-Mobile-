+void TouchInput::drawReticle(Painter& p) {
+  // Лук и арбалет: прицел (PlayerControl::tickRangedAim). Точка - куда целится герой (с автонаведением - грудь цели в
+  // фокусе, иначе - середина экрана); круг - куда может уйти стрела: его радиус - разброс по умению (100 % - только
+  // точка). Круг - в мире у точки прицела: вблизи шире, вдали уже
+  const auto& aim = ctrl.rangedAim();
+  auto        cam = Gothic::inst().camera();
+  auto        pl  = Gothic::inst().player();
+  if(!aim.on || cam==nullptr || pl==nullptr || !pl->hasAmmunition())
+    return;
+  const auto vp = cam->viewProj();
+  auto toScreen = [&](Vec3 v, PointF& out) {
+    float pw = 1.f;
+    vp.project(v.x,v.y,v.z,pw);
+    if(pw<=0.f)
+      return false;
+    v /= pw;
+    out = PointF((0.5f*v.x+0.5f)*float(w()), (0.5f*v.y+0.5f)*float(h()));
+    return true;
+    };
+  PointF c;
+  if(!toScreen(aim.at,c))
+    return;
+  const float d    = dp();
+  const Color cl   = aim.locked ? GoldBright : GoldIdle;
+  const Vec3  view = aim.at - cam->originLwc();
+  Vec3        side = Vec3::crossProduct(view, Vec3(0,1,0));
+  float       rad  = 0;
+  if(side.length()>1e-3f && aim.spread>0.f) {
+    const float r = (aim.at-aim.from).length()*std::tan(aim.spread*Pi/180.f);
+    PointF e;
+    if(toScreen(aim.at + Vec3::normalize(side)*r, e))
+      rad = std::sqrt((e.x-c.x)*(e.x-c.x) + (e.y-c.y)*(e.y-c.y));
+    }
+  rad = std::min(rad, float(std::max(w(),h())));
+  const int cx = int(c.x), cy = int(c.y);
+  if(rad>=4*d) {
+    const int lw = std::max(1, int(1.6f*d));
+    const int ds = int(2.f*rad) + 2*(lw+int(std::max(1.f,float(lw)*0.6f))+2);
+    auto& t = icons.ring(ds, lw);
+    p.setBrush(Brush(t,Color(cl.r(),cl.g(),cl.b(),0.85f),Painter::Alpha));
+    p.drawRect(cx-ds/2, cy-ds/2, ds, ds, 0,0,t.w(),t.h());
+    }
+  drawGlyph(p, TouchIcons::I_Dot, Point(cx,cy), std::max(4, int(7*d)), cl);
+  }
+
+void TouchInput::drawSquad(Painter& p) {
+  if(squad.empty())
+    return;
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return;
+  // Под полосками героя: имя, здоровье, приказ
+  const float d    = dp();
+  const int   x0   = 10; // как полоски игры
+  const int   y0   = owner.touchHudBottom() + int(8*d);
+  const int   gs   = int(13*d);
+  const int   barW = int(70*d);
+  const int   barH = std::max(2, int(3*d));
+  auto&       fnt  = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this)*0.8f);
+  // До шести напарников: строки ужимаются до высоты текста, а если и так не влезают над «Красться» -
+  // второй столбец
+  const auto  sneak = buttonOf(C_Sneak);
+  const int   yMax  = sneak.c.y - sneak.r - int(6*d);
+  const int   n     = int(squad.size());
+  int         rowH  = int(22*d);
+  if(y0+rowH*n>yMax)
+    rowH = std::max(fnt.textSize("A").h+barH+int(4*d), (yMax-y0)/std::max(n,1));
+  const int   perCol = std::max(1, (yMax-y0)/std::max(rowH,1));
+  const int   colW   = gs+int(5*d)+barW+int(30*d)+int(8*d);
+  auto& sc = w->script();
+  for(int i=0; i<n; ++i) {
+    Npc* npc = squad[size_t(i)];
+    const int x = x0 + (i/perCol)*colW;
+    const int y = y0 + (i%perCol)*rowH;
+    TouchIcons::Icon ic = sc.squadIsWaiting(*npc) ? TouchIcons::I_Wait : TouchIcons::I_Follow;
+    if(sc.isPassive(*npc) && !sc.squadIsWaiting(*npc))
+      ic = TouchIcons::I_Passive;
+    drawGlyph(p, ic, Point(x+gs/2, y+gs/2), gs, GoldIdle);
+
+    const auto name = fit(std::string(npc->displayName()), barW+int(30*d), 0.8f);
+    const auto ts   = fnt.textSize(name);
+    fnt.drawText(p, x+gs+int(5*d), y+ts.h-int(2*d), name);
+
+    const float hp = float(npc->attribute(ATR_HITPOINTS))/float(std::max(1,npc->attribute(ATR_HITPOINTSMAX)));
+    const int   by = y+ts.h+int(1*d);
+    p.setBrush(Color(0.f,0.f,0.f,0.5f));
+    p.drawRect(x+gs+int(5*d), by, barW, barH);
+    p.setBrush(Color(0.78f,0.16f,0.10f,0.9f));
+    p.drawRect(x+gs+int(5*d), by, int(float(barW)*std::clamp(hp,0.f,1.f)), barH);
+    }
+  }
