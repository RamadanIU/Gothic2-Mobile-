+bool Npc::isCompanionIdle() const {
+  // Только в том состоянии, в котором занятие начато, и не дольше его конца + 10 с - распорядок не застрянет
+  return companionIdle.act!=0 && aiState.funcIni.ptr==companionIdle.state &&
+         owner.tickCount()<companionIdle.until+10000;
+  }
