+void Ragdoll::setState(State s) {
+  if(s==st)
+    return;
+  const bool wasActive = (st==S_Active);
+  const bool wasUp     = (st==S_Balance || st==S_GetUp);
+  st = s;
+  if(wasUp && isSimulated()) {
+    // ловил равновесие или вставал - и упал (или убит): ступни и руки больше ничего не держат, срок - с падения
+    removeAnchors();
+    releaseGrip(0);
+    releaseGrip(1);
+    if(beh!=nullptr) {
+      beh->bal.on   = false;
+      beh->getUp.on = false;
+      }
+    for(auto& d:drive) {
+      d.hasOverride = false;
+      d.dip0        = 0;
+      }
+    setActiveCollisions(false);
+    balanceLost = false;
+    airTime     = 0;
+    groundTime  = 0;
+    simTime     = 0;
+    calmTime    = 0;
+    fallPeak    = 0;
+    impact      = 0;
+    damping     = 0;
+    for(auto& b:body)
+      b.rb->setDamping(0.05f,0.25f);
+    setSolverIterations(solverIt);
+    return;
+    }
+  if(!wasActive || !isSimulated())
+    return;
+  // упал с ног (равновесие, смерть, без сознания): суставы с пределами от позы в этот миг, столкновения как у
+  // тряпичной куклы, срок в физике - заново, с падения. Толчок (S_Balance) - то же: всё тело - физика
+  removeJoints();
+  createJoints();
+  setActiveCollisions(false);
+  if(s==S_Balance)
+    for(auto& b:body)
+      b.rb->setActivationState(DISABLE_DEACTIVATION);
+  for(auto& d:drive) {
+    d.hasOverride = false;
+    d.dip         = 0;
+    d.dip0        = 0;
+    }
+  if(beh!=nullptr) {
+    auto& b = *beh;
+    // не устоял после толчка: ноги заплетаются, корпус уходит дальше - тело валится по толчку
+    if(s==S_Fall && b.pushVel>0.1f) {
+      const btVector3 v = b.push*std::max(b.pushVel,0.8f);
+      for(size_t i=0; i<body.size(); ++i) {
+        const auto& p = lay->parts[i];
+        const bool  low = (p.kind==K_Thigh || p.kind==K_Calf);
+        body[i].rb->setLinearVelocity(body[i].rb->getLinearVelocity() + (low ? -v*0.1f : v*0.3f));
+        }
+      }
+    b.reflex.clear();
+    b.pushAt   = -1;
+    b.pushVel  = 0;
+    b.stepping = false;
+    b.stance   = false;
+    b.armsW    = 0;
+    b.rootMove = btVector3(0,0,0);
+    }
+  balanceLost = false;
+  airTime     = 0;
+  groundTime  = 0;
+  simTime     = 0;
+  calmTime    = 0;
+  fallPeak    = 0;
+  impact      = 0;
+  damping     = 0;
+  for(auto& b:body)
+    b.rb->setDamping(0.05f,0.25f);
+  }
