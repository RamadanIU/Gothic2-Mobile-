+bool InjuryRig::woundAt(const Matrix4x4* world, size_t count, const Vec3& at, Wound& out) const {
+  if(count<parent.size())
+    return false;
+  struct Seg { size_t bone; Vec3 a, b; float r; Zone zone; int8_t side; };
+  std::vector<Seg> seg;
+  const float S = (origin(world[head]) - (origin(world[foot[0]])+origin(world[foot[1]]))*0.5f).length();
+  auto o = [&](size_t i) { return origin(world[i]); };
+  for(size_t k=0; k<spine.size(); ++k) {
+    const Vec3 b = (k+1<spine.size()) ? o(spine[k+1]) : (neck<count ? o(neck) : o(head));
+    seg.push_back({spine[k], o(spine[k]), b, 0.075f*S, Z_Torso, -1});
+    }
+  seg.push_back({pelvis, o(thigh[0]), o(thigh[1]), 0.08f*S, Z_Torso, -1});
+  {
+  const Vec3 nb = neck<count ? o(neck) : o(spine.back());
+  const Vec3 top = o(head) + Vec3::normalize(o(head)-nb)*(0.1f*S);
+  seg.push_back({head, o(head), top, 0.06f*S, Z_Head, -1});
+  }
+  for(int8_t s=0; s<2; ++s) {
+    seg.push_back({upper[s], o(upper[s]), o(fore[s]), 0.04f*S, Z_Arm, s});
+    seg.push_back({fore[s],  o(fore[s]),  o(hand[s]), 0.032f*S, Z_Arm, s});
+    seg.push_back({thigh[s], o(thigh[s]), o(calf[s]), 0.05f*S, Z_Leg, s});
+    seg.push_back({calf[s],  o(calf[s]),  o(foot[s]), 0.038f*S, Z_Leg, s});
+    }
+  float best = 1e9f;
+  for(auto& s:seg) {
+    const Vec3  c = closestOnSegment(at,s.a,s.b);
+    const float d = (at-c).length() - s.r;
+    if(d>=best)
+      continue;
+    best = d;
+    Vec3 n = at-c;
+    if(n.length()<1e-3f)
+      n = transformDir(world[s.bone],Vec3(0,0,1));
+    n = Vec3::normalize(n);
+    const Vec3 p = c + n*s.r;
+    Matrix4x4 inv = world[s.bone];
+    inv.inverse();
+    Vec3 lp = p, ln = p+n;
+    inv.project(lp);
+    inv.project(ln);
+    out.bone   = uint16_t(s.bone);
+    out.local  = lp;
+    out.normal = Vec3::normalize(ln-lp);
+    out.zone   = s.zone;
+    out.side   = s.side;
+    if(s.side<0) {
+      // корпус и голова: сторона - по тому, ближе к какому плечу рана
+      const Vec3 left = o(upper[0])-o(upper[1]);
+      out.side = Vec3::dotProduct(p-(o(upper[0])+o(upper[1]))*0.5f, left)>=0.f ? 0 : 1;
+      }
+    }
+  return best<1e8f;
+  }
+
+int8_t InjuryRig::reachArm(const Wound& w, uint8_t free) const {
+  auto isFree = [free](int a) { return (free>>a)&1; };
+  if(w.zone==Z_Arm) {
+    const int other = 1-w.side;
+    return isFree(other) ? int8_t(other) : int8_t(-1);
+    }
+  const int same = w.side>=0 ? w.side : 0;
+  if(isFree(same))
+    return int8_t(same);
+  if(isFree(1-same))
+    return int8_t(1-same);
+  return -1;
+  }
+
+void InjuryRig::rebuild(Work& w) const {
+  for(auto i:order) {
+    const size_t p = parent[i];
+    if(p<parent.size())
+      w.w[i] = w.w[p]*w.local[i];
+    }
+  }
+
+void InjuryRig::setWorld(Work& w, size_t bone, const Matrix4x4& m) const {
+  w.w[bone] = m;
+  const size_t p = parent[bone];
+  w.local[bone] = (p<parent.size()) ? relative(w.w[p],m) : m;
+  }
+
+void InjuryRig::apply(const Injury& inj, const Matrix4x4& obj, Matrix4x4* world, size_t count) const {
+  if(!inj.isActive() || count<parent.size())
+    return;
+  Work w;
+  w.w = world;
+  w.local.resize(parent.size());
+  for(size_t i=0; i<parent.size(); ++i) {
+    const size_t p = parent[i];
+    w.local[i] = (p<parent.size()) ? relative(world[p],world[i]) : world[i];
+    }
+  // размер модели (NPC бывают крупнее и мельче): смещения в см - с его масштабом
+  w.scale = std::clamp(axis(obj,1).length(), 0.3f, 3.f);
+
+  Vec3 fwd = horizontal(axis(obj,2));
+  if(fwd.length()<0.5f)
+    fwd = Vec3(0,0,1);
+
+  if(inj.pain>0.001f)
+    applyPain(inj, w, fwd);
+  if(inj.hunch>0.001f)
+    applyHunch(inj.hunch, w, Vec3::crossProduct(Vec3(0,1,0),fwd));
+  if(inj.leg>=0 && inj.limp>0.001f)
+    applyLimp(inj, w, fwd);
+  if(inj.arm>=0 && inj.reach>0.001f && inj.bone<parent.size())
+    applyReach(inj, w, fwd);
+  if(inj.brace>0.001f)
+    applyBrace(inj, w, fwd);
+  }
+
+void InjuryRig::applyStance(const Stance& st, const Matrix4x4& obj, Matrix4x4* world, size_t count) const {
+  if(!st.isActive() || count<parent.size())
+    return;
+  Work w;
+  w.w = world;
+  w.local.resize(parent.size());
+  for(size_t i=0; i<parent.size(); ++i) {
+    const size_t p = parent[i];
+    w.local[i] = (p<parent.size()) ? relative(world[p],world[i]) : world[i];
+    }
+  Vec3 fwd = horizontal(axis(obj,2));
+  if(fwd.length()<0.5f)
+    fwd = Vec3(0,0,1);
+  const float     k = std::clamp(st.weight,0.f,1.f);
+  const Matrix4x4 footA[2] = {world[foot[0]], world[foot[1]]};
+  {
+  Matrix4x4   m   = world[pelvis];
+  const float ang = st.rot.length();
+  if(ang>1e-5f)
+    rotateBasis(m,st.rot/ang,ang*k);
+  setOrigin(m, origin(m)+st.shift*k);
+  setWorld(w,pelvis,m);
+  rebuild(w);
+  }
+  for(int i=0; i<2; ++i) {
+    const float fw = std::clamp(st.footW[i],0.f,1.f)*k;
+    const Vec3  at = origin(footA[i]) + (st.foot[i]-origin(footA[i]))*fw;
+    Matrix4x4 t = w.w[thigh[i]], c = w.w[calf[i]], f = w.w[foot[i]];
+    solve(t,c,f,at,fwd);
+    Matrix4x4 fa = footA[i];
+    setOrigin(fa,origin(f));
+    setWorld(w,thigh[i],t);
+    setWorld(w,calf[i],c);
+    setWorld(w,foot[i],fa);
+    }
+  rebuild(w);
+  }
+
+void InjuryRig::applyHunch(float a, Work& w, const Vec3& left) const {
+  // сгорбиться: верх корпуса - вперёд (поворот вокруг оси «влево» уводит верх вперёд), голова - вниз
+  const float total = deg(12.f)*std::clamp(a,0.f,1.f);
+  const float each  = total/float(bendable.size());
+  for(auto s:bendable) {
+    Matrix4x4 m = w.w[s];
+    rotateBasis(m,left,each);
+    setWorld(w,s,m);
+    rebuild(w);
+    }
+  if(head<parent.size()) {
+    Matrix4x4 m = w.w[head];
+    rotateBasis(m,left,0.4f*total);
+    setWorld(w,head,m);
+    rebuild(w);
+    }
+  }
+
+void InjuryRig::applyPain(const Injury& inj, Work& w, const Vec3& fwd) const {
+  // Согнулся от боли (как в Euphoria): колени подгибаются - таз ниже и чуть назад, наклонён вперёд (ступни где в
+  // анимации, IK ног), корпус сгибается вперёд и к ране, голова опускается. Держится секунды после удара - и в
+  // драке, без физики (Npc::painNow)
+  const float s    = smooth(std::clamp(inj.pain,0.f,1.f));
+  const float k    = w.scale;
+  const Vec3  up   = Vec3(0,1,0);
+  const Vec3  left = Vec3::crossProduct(up,fwd); // поворот вокруг «влево» уводит верх вперёд
+  const Matrix4x4 footA[2] = {w.w[foot[0]], w.w[foot[1]]};
+  {
+  Matrix4x4 m = w.w[pelvis];
+  rotateBasis(m,left,deg(8.f)*s);
+  setOrigin(m, origin(m) - up*(7.f*k*s) - fwd*(3.f*k*s));
+  setWorld(w,pelvis,m);
+  rebuild(w);
+  }
+  {
+  const float n    = float(std::max<size_t>(bendable.size(),1));
+  const float bow  = deg(26.f)*s/n;
+  const float lean = -deg(8.f)*s*std::clamp(inj.painSide,-1.f,1.f)/n; // + вокруг «вперёд» уводит верх вправо
+  for(auto b:bendable) {
+    Matrix4x4 m = w.w[b];
+    rotateBasis(m,left,bow);
+    rotateBasis(m,fwd,lean);
+    setWorld(w,b,m);
+    rebuild(w);
+    }
+  }
+  if(head<parent.size()) {
+    Matrix4x4 m = w.w[head];
+    rotateBasis(m,left,deg(16.f)*s);
+    setWorld(w,head,m);
+    rebuild(w);
+    }
+  for(int i=0; i<2; ++i) {
+    Matrix4x4 t = w.w[thigh[i]], c = w.w[calf[i]], f = w.w[foot[i]];
+    solve(t,c,f,origin(footA[i]),fwd);
+    Matrix4x4 fa = footA[i];
+    setOrigin(fa,origin(f));
+    setWorld(w,thigh[i],t);
+    setWorld(w,calf[i],c);
+    setWorld(w,foot[i],fa);
+    }
+  rebuild(w);
+  }
+
+void InjuryRig::applyLimp(const Injury& inj, Work& w, const Vec3& fwd) const {
+  // Хромота: ступни - где в анимации; когда больная нога несёт вес (её ступня ниже здоровой), таз опускается и
+  // заваливается на больную сторону, корпус качнётся к ней; в остальное время вес - на здоровой ноге
+  const int   L  = inj.leg, H = 1-inj.leg;
+  const float s  = std::clamp(inj.limp,0.f,1.f);
+  const float k  = w.scale;
+  const Matrix4x4 footA[2] = {w.w[foot[0]], w.w[foot[1]]};
+  const Vec3  up = Vec3(0,1,0);
+
+  const float st   = smooth((origin(footA[H]).y - origin(footA[L]).y)/(8.f*k) + 0.5f);
+  const float bear = std::max(0.f, 2.f*st-1.f); // 0..1: опора только на больную ногу
+  Vec3 sideV = horizontal(origin(w.w[thigh[L]]) - origin(w.w[thigh[H]]));
+  if(sideV.length()<0.5f)
+    sideV = Vec3::crossProduct(up,fwd)*(L==0 ? 1.f : -1.f);
+
+  const float drop  = s*(2.f + 8.f*bear)*k;
+  const float shift = s*3.f*(1.f-bear)*k;
+  const float roll  = deg(s*(3.f + 6.f*bear));
+  const float lurch = deg(s*(2.f + 10.f*bear));
+  // знак поворота вокруг «вперёд», при котором больная сторона опускается
+  const float rollSign  = Vec3::dotProduct(Vec3::crossProduct(fwd,sideV),up)>0.f ? -1.f : 1.f;
+  // и при котором верх корпуса уходит к больной стороне
+  const float lurchSign = Vec3::dotProduct(Vec3::crossProduct(fwd,up),sideV)>0.f ? 1.f : -1.f;
+
+  {
+  Matrix4x4 m = w.w[pelvis];
+  rotateBasis(m,fwd,rollSign*roll);
+  setOrigin(m, origin(m) - up*drop - sideV*shift);
+  setWorld(w,pelvis,m);
+  rebuild(w);
+  }
+  // корпус: таз завалился - верх выпрямить обратно и качнуть к больной ноге; больно - чуть вперёд
+  {
+  const Vec3  left = Vec3::crossProduct(up,fwd);
+  const float each = (-rollSign*roll*0.8f + lurchSign*lurch)/float(bendable.size());
+  const float bow  = deg(s*(3.f + 4.f*bear))/float(bendable.size());
+  for(auto b:bendable) {
+    Matrix4x4 m = w.w[b];
+    rotateBasis(m,fwd,each);
+    rotateBasis(m,left,bow);
+    setWorld(w,b,m);
+    rebuild(w);
+    }
+  }
+  // ноги - к прежним ступням: колени сгибаются; ступни повёрнуты как в анимации
+  for(int i=0; i<2; ++i) {
+    Matrix4x4 t = w.w[thigh[i]], c = w.w[calf[i]], f = w.w[foot[i]];
+    solve(t,c,f,origin(footA[i]),fwd);
+    Matrix4x4 fa = footA[i];
+    setOrigin(fa,origin(f));
+    setWorld(w,thigh[i],t);
+    setWorld(w,calf[i],c);
+    setWorld(w,foot[i],fa);
+    }
+  rebuild(w);
+  }
+
+void InjuryRig::applyReach(const Injury& inj, Work& w, const Vec3& fwd) const {
+  // Рука к ране: кисть ложится на тело у раны (пальцы - на рану), до низкой раны тянется наклоном корпуса
+  const int   a  = inj.arm;
+  const float r  = smooth(inj.reach);
+  const float k  = w.scale;
+  const Vec3  up = Vec3(0,1,0);
+
+  auto woundPoint = [&]() {
+    Vec3 p = inj.local;
+    w.w[inj.bone].project(p);
+    return p;
+    };
+  auto woundNormal = [&]() {
+    return Vec3::normalize(transformDir(w.w[inj.bone],inj.normal));
+    };
+  const float l1 = (origin(w.w[fore[a]]) - origin(w.w[upper[a]])).length();
+  const float l2 = (origin(w.w[hand[a]]) - origin(w.w[fore[a]])).length();
+  const float reachMax = 0.96f*(l1+l2);
+
+  auto handTarget = [&]() {
+    const Vec3 p = woundPoint(), n = woundNormal();
+    const Vec3 s = origin(w.w[upper[a]]);
+    // запястье - чуть над телом и ближе к плечу: на ране лежат пальцы и ладонь
+    return p + n*(3.f*k) + Vec3::normalize(s-p)*(6.f*k);
+    };
+
+  // наклон корпуса к ране, если не дотянуться (рана на бедре, на голени - ещё и колени)
+  if(inj.bone!=upper[a] && inj.bone!=fore[a] && inj.bone!=hand[a]) {
+    const Vec3 base = origin(w.w[bendable.front()]);
+    Vec3 t = handTarget();
+    Vec3 s = origin(w.w[upper[a]]);
+    if((t-s).length()>reachMax) {
+      Vec3 ax = Vec3::crossProduct(s-base, t-base);
+      if(ax.length()>1e-3f) {
+        // тянется к бедру - больше вперёд, чем вбок (поворот вокруг оси «влево» уводит верх вперёд)
+        ax = Vec3::normalize(Vec3::normalize(ax) + Vec3::crossProduct(up,fwd)*0.9f);
+        // угол, при котором плечо оказывается в пределах руки (половинным делением), не больше 45 градусов
+        float lo = 0, hi = deg(45.f);
+        for(int it=0; it<10; ++it) {
+          const float m  = 0.5f*(lo+hi);
+          const Vec3  sr = base + rotate(s-base,ax,std::cos(m),std::sin(m));
+          if((t-sr).length()>reachMax) lo = m; else hi = m;
+          }
+        const float each = hi*r/float(bendable.size());
+        for(auto b:bendable) {
+          Matrix4x4 m = w.w[b];
+          rotateBasis(m,ax,each);
+          setWorld(w,b,m);
+          rebuild(w);
+          }
+        }
+      }
+    }
+
+  const Vec3 handNow = origin(w.w[hand[a]]);
+  const Vec3 target  = handNow + (handTarget()-handNow)*r;
+  const Vec3 sideA   = horizontal(origin(w.w[upper[a]]) - origin(w.w[upper[1-a]]));
+  const Vec3 pole    = up*(-0.6f) + sideA*0.6f - fwd*0.2f;
+
+  Matrix4x4 u = w.w[upper[a]], f = w.w[fore[a]], h = w.w[hand[a]];
+  solve(u,f,h,target,pole);
+  // кисть - пальцами к ране (запястье считаем прямым: кисть - продолжение предплечья)
+  {
+  const Vec3 want = woundPoint() - origin(h);
+  if(want.length()>1e-3f) {
+    const Vec3 cur  = Vec3::normalize(origin(h)-origin(f));
+    const Vec3 to   = Vec3::normalize(cur*(1.f-r) + Vec3::normalize(want)*r);
+    rotateBasis(h,cur,to);
+    }
+  }
+  setWorld(w,upper[a],u);
+  setWorld(w,fore[a],f);
+  setWorld(w,hand[a],h);
+  rebuild(w);
+  }
+
+void InjuryRig::applyBrace(const Injury& inj, Work& w, const Vec3& fwd) const {
+  // Толчок с разбега (Npc::tickShove). Плечом: корпус развёрнут ведущим плечом вперёд и чуть наклонён, голова
+  // смотрит вперёд (поворот корпуса - обратно), подбородок вниз, ведущая рука прижата к груди (кулак у другой груди),
+  // другая - чуть назад и в сторону. Руками: кисти к груди того, в кого врезается (две - по сторонам груди), локти
+  // согнуты, пока не врезался; врезался - руки разгибаются, корпус подаётся вперёд. Ноги - как в анимации бега
+  const float b   = smooth(std::clamp(inj.brace,0.f,1.f));
+  const float hit = smooth(std::clamp(inj.braceHit,0.f,1.f));
+  const float k   = w.scale;
+  const int   s   = inj.braceSide==1 ? 1 : 0;
+  const Vec3  up   = Vec3(0,1,0);
+  const Vec3  left = Vec3::crossProduct(up,fwd); // поворот вокруг «влево» уводит верх вперёд
+  const float n    = float(std::max<size_t>(bendable.size(),1));
+
+  // корпус: поворот (левое плечо вперёд - по часовой, если смотреть сверху: угол вокруг «вверх» < 0), наклон вперёд
+  float twist = 0, bow = 0;
+  if(inj.braceKind==Injury::B_Shoulder) {
+    twist = deg(34.f)*b*(s==0 ? -1.f : 1.f);
+    bow   = deg(12.f)*b - deg(6.f)*hit;     // удар в плечо корпус принимает - пружинит назад
+    } else {
+    twist = inj.braceKind==Injury::B_Push1 ? deg(14.f)*b*(s==0 ? -1.f : 1.f) : 0.f;
+    bow   = deg(8.f)*b + deg(8.f)*hit;      // толкает - подаётся вперёд
+    }
+  for(auto bn:bendable) {
+    Matrix4x4 m = w.w[bn];
+    rotateBasis(m,up,twist/n);
+    rotateBasis(m,left,bow/n);
+    setWorld(w,bn,m);
+    rebuild(w);
+    }
+  if(head<parent.size()) {
+    Matrix4x4 m = w.w[head];
+    rotateBasis(m,up,-0.75f*twist);
+    rotateBasis(m,left,-0.6f*bow + (inj.braceKind==Injury::B_Shoulder ? deg(12.f)*b : 0.f));
+    setWorld(w,head,m);
+    rebuild(w);
+    }
+
+  auto arm = [&](int a, const Vec3& target, const Vec3& pole, float wgt) {
+    if(wgt<=0.001f)
+      return;
+    const Vec3 handNow = origin(w.w[hand[a]]);
+    const Vec3 to      = handNow + (target-handNow)*wgt;
+    Matrix4x4 u = w.w[upper[a]], f = w.w[fore[a]], h = w.w[hand[a]];
+    solve(u,f,h,to,pole);
+    // кисть - продолжение предплечья (кулак или ладонь вперёд)
+    {
+    const Vec3 cur  = Vec3::normalize(origin(h)-origin(f));
+    const Vec3 prev = Vec3::normalize(origin(w.w[hand[a]])-origin(w.w[fore[a]]));
+    rotateBasis(h,prev,cur);
+    }
+    setWorld(w,upper[a],u);
+    setWorld(w,fore[a],f);
+    setWorld(w,hand[a],h);
+    rebuild(w);
+    };
+  const Vec3 chest = spine.empty() ? origin(w.w[pelvis]) : origin(w.w[spine.back()]);
+  if(inj.braceKind==Injury::B_Shoulder) {
+    // ведущая рука прижата: кулак у груди со стороны другого плеча, локоть вниз и к боку
+    const int  o     = 1-s;
+    const Vec3 sideS = horizontal(origin(w.w[upper[s]]) - origin(w.w[upper[o]]));
+    arm(s, chest + fwd*(14.f*k) - sideS*(6.f*k) - up*(6.f*k), -up*0.7f + sideS*0.5f + fwd*0.2f, b);
+    // другая - чуть назад и в сторону, для равновесия
+    arm(o, origin(w.w[upper[o]]) - up*(42.f*k) - fwd*(14.f*k) - sideS*(14.f*k), fwd*0.6f - sideS*0.4f, 0.7f*b);
+    return;
+    }
+  // руками: к груди того (две руки - по сторонам груди), не дальше вытянутой руки; локти чуть согнуты до удара
+  for(int a=0; a<2; ++a) {
+    if(inj.braceKind==Injury::B_Push1 && a!=s)
+      continue;
+    const Vec3  sideA = horizontal(origin(w.w[upper[a]]) - origin(w.w[upper[1-a]]));
+    const Vec3  sh    = origin(w.w[upper[a]]);
+    Vec3        at    = inj.braceAt + sideA*((inj.braceKind==Injury::B_Push2 ? 11.f : 4.f)*k);
+    const float l1    = (origin(w.w[fore[a]]) - sh).length();
+    const float l2    = (origin(w.w[hand[a]]) - origin(w.w[fore[a]])).length();
+    Vec3        d     = at-sh;
+    // до удара - локти согнуты (руки на 75 % длины), удар - руки разгибаются
+    const float reach = (l1+l2)*(0.75f + 0.2f*hit);
+    if(d.length()>reach)
+      d = Vec3::normalize(d)*reach;
+    arm(a, sh+d, -up*0.6f + sideA*0.7f, b);
+    }
+  }
