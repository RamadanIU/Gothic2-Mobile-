+void AiNpc::storyInfos(Npc& npc, std::vector<zenkit::IInfo*>& out) {
+  out.clear();
+  const int32_t inst = int32_t(npc.handle().symbol_index());
+  for(auto& i:owner.dialogsInfo)
+    if(i!=nullptr && i->npc==inst)
+      out.push_back(i.get());
+  std::stable_sort(out.begin(),out.end(),[](auto* a, auto* b){ return a->nr<b->nr; });
+  }
