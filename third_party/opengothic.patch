+// Сила за шаг физики dt, если за 1/60 с действует s (одинаково при любом числе шагов за кадр)
+float perStep(float s, float dt) {
+  s = std::clamp(s,0.f,0.98f);
+  return 1.f - std::pow(1.f-s, dt*60.f);
+  }
+
+// Очередь на застывание при нехватке места в физике: дальние и дольше падающие - раньше (1 с - как 5 м);
+// живой падающий и тем более герой - последними
+float evictScore(float viewDist, uint64_t simTime, Ragdoll::State st, bool keep) {
+  float s = viewDist + float(simTime)*0.5f;
+  if(st==Ragdoll::S_Active)
+    s += 1e6f; // реакция на удар - украшение: уступает место первой
+  if(st==Ragdoll::S_Fall || st==Ragdoll::S_Balance || st==Ragdoll::S_GetUp)
+    s -= 1e6f; // живой падает, ловит равновесие или встаёт - застыть посреди движения нельзя
+  if(keep)
+    s -= 1e7f;
+  return s;
+  }
