+static bool sameWorld(std::string_view a, std::string_view b) {
+  if(a.size()!=b.size())
+    return false;
+  for(size_t i=0; i<a.size(); ++i)
+    if(std::tolower(uint8_t(a[i]))!=std::tolower(uint8_t(b[i])))
+      return false;
+  return true;
+  }
+
+const TravelPoints::MapInfo& TravelPoints::info(Map m) {
+  return maps[m<M_Count ? m : M_Island];
+  }
+
+std::vector<TravelPoints::Map> TravelPoints::mapsOf(std::string_view world) {
+  std::vector<Map> ret;
+  for(uint8_t i=0; i<M_Count; ++i)
+    if(sameWorld(maps[i].world,world))
+      ret.push_back(Map(i));
+  return ret;
+  }
+
+Vec2 TravelPoints::toMap(Map m, const Vec3& pos) {
+  auto& mi = info(m);
+  return Vec2((pos.x-float(mi.left))/float(mi.right-mi.left),
+              (pos.z-float(mi.top)) /float(mi.bottom-mi.top));
+  }
+
+void TravelPoints::resolve(World& w, std::vector<Spot>& out) {
+  out.clear();
+  for(auto& pt:points) {
+    if(!sameWorld(info(pt.map).world,w.name()))
+      continue;
+    const WayPoint* at = nullptr;
+    for(auto name:pt.wp) {
+      if(name==nullptr)
+        break;
+      if((at = w.findPoint(name,false))!=nullptr)
+        break;
+      }
+    if(at==nullptr) {
+      Log::i("[g2m] travel: no point for \"",pt.name,"\" (",pt.wp[0],")");
+      continue;
+      }
+    // Бегом ведёт сеть путей: метка разработчиков или свободная точка в ней не состоит - к ближайшей точке сети
+    const WayPoint* way = at;
+    if(!at->isConnected() || at->isFreePoint()) {
+      const auto p = at->position();
+      way = w.findWayPoint(p,[&p](const WayPoint& wp) {
+        return wp.isConnected() && wp.qDistTo(p)<2000.f*2000.f;
+        });
+      if(way==nullptr)
+        way = w.findWayPoint(p,[](const WayPoint& wp) { return wp.isConnected(); });
+      }
+    Spot s;
+    s.point = &pt;
+    s.at    = at;
+    s.way   = way;
+    out.push_back(s);
+    }
+  }
diff --git a/common/game/travelpoints.h b/common/game/travelpoints.h
new file mode 100644
index 0000000..915c632
--- /dev/null
+++ b/common/game/travelpoints.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <Tempest/Point>
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+class World;
+class WayPoint;
+
+// Gothic II Mobile: точки быстрого перемещения («Путь», docs/CONTROLS.md). Имена точек мира - метки
+// разработчиков, которые знает телепорт Marvin («перед монастырём», «южные ворота»), точки рун телепорта и
+// распорядков NPC из скриптов игры. Берётся первое имя, которое нашлось в мире; ненайденные точки не
+// показываются. Места - на дорогах и у входов: не за воротами, которые открывает сюжет.
+class TravelPoints final {
+  public:
+    enum Map : uint8_t {
+      M_Island,     // Хоринис: остров
+      M_City,       // Хоринис: город
+      M_Valley,     // Долина Рудников
+      M_Jharkendar, // Яркендар
+      M_Count
+      };
+
+    struct MapInfo {
+      const char* world;   // файл мира (как World::name, без учёта регистра)
+      const char* texture; // карта игры
+      int32_t     left, top, right, bottom; // как Doc_SetLevelCoords этой карты в скриптах
+      const char* title;   // UTF-8
+      };
+
+    struct Point {
+      Map         map;
+      bool        major;   // главное место - подписано на карте всегда
+      const char* name;    // UTF-8
+      const char* wp[3];
+      };
+
+    struct Spot {
+      const Point*    point = nullptr;
+      const WayPoint* at    = nullptr; // место прибытия
+      const WayPoint* way   = nullptr; // точка сети путей у места - цель пути бегом
+      };
+
+    static const MapInfo&   info(Map m);
+    // Карты текущего мира (у Хориниса - остров и город); пусто - мир без точек
