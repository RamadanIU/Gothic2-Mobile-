+    case C_Jump:    return arc(92*d,  135, 27*d);
+    case C_Block:   return arc(92*d,  180, 27*d);
+    case C_Potion:  return arc(154*d, 102, 22*d);
+    case C_Auto:    return arc(154*d, 128, 22*d);
+    case C_Gather:  return arc(154*d, 154, 22*d);
+    case C_Squad:   return arc(154*d, 180, 22*d);
+    case C_Sneak:   return round(m + 22*d, H*0.5f, 22*d);
+    case C_Bag:     return top(0);
+    case C_Map:     return top(1);
+    case C_Log:     return top(2);
+    case C_Hero:    return top(3);
+    case C_Menu:    return top(4);
+    case C_Back:    return pill(m, H - m - ph, pw*0.9f, ph);
+    case C_Select:  return pill(W - m - pw, H - m - ph, pw, ph);
+    // Над сеткой сундука, рядом с его названием: внизу справа - сетка сумки героя
+    case C_TakeAll: return pill(m + 112*d, 10*d, pw, ph);
+    case C_Skip:    return pill(W - m - pw, 12*d, pw, ph);
+    case C_Up:      return round(m + 26*d, H - m - ph - 16*d - 26*d - 62*d, 26*d);
+    case C_Down:    return round(m + 26*d, H - m - ph - 16*d - 26*d, 26*d);
+    case C_Left:    return round(m + 36*d,         H - m - ph - 20*d - 36*d, 36*d);
+    case C_Right:   return round(m + 36*d + 88*d,  H - m - ph - 20*d - 36*d, 36*d);
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_List:
+    case C_Absorb:
+    case C_Count:
+      break;
+    }
+  return Button();
+  }
