+#pragma once
+
+#include <Tempest/Matrix4x4>
+#include <Tempest/Vec>
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+class Skeleton;
+
+// Gothic II Mobile: раненое тело - слой позы поверх анимации, без физики (как поведения Euphoria «рука к ране» и
+// хромота). Работает и после того, как кукла активного регдолла ушла из физики: держаться за рану и хромать
+// можно десятки секунд, а физика на телефоне - только на время отклика на удар.
+//  - рука к ране: IK руки к точке на кости раны (кисть ложится на тело), до нижних ран (бедро, голень) тянется
+//    наклоном корпуса;
+//  - хромота: на больную ногу тело опускается и заваливается, вес - на здоровую, ступни стоят там же, где в
+//    анимации (IK ног), колени гнутся;
+//  - сгорбиться от боли: корпус и голова чуть вперёд.
+struct Injury final {
+  int8_t        arm    = -1;  // рука к ране: 0 - левая, 1 - правая, -1 - нет
+  uint16_t      bone   = 0;   // кость раны
+  Tempest::Vec3 local  = {};  // точка раны в системе кости, см
+  Tempest::Vec3 normal = {};  // наружу от тела, в системе кости
+  float         reach  = 0;   // 0..1 - насколько рука у раны
+  int8_t        leg    = -1;  // хромает на ногу: 0 - левая, 1 - правая
+  float         limp   = 0;   // 0..1
+  float         hunch  = 0;   // 0..1
+  float         pain   = 0;   // 0..1 - согнулся от боли после удара: корпус и голова вперёд, колени подогнуты
+  float         painSide = 0; // -1..1 - и вбок, к ране (+ - влево)
+
+  // Герой с разбега врезается в человека (Npc::tickShove): заранее подставляет плечо (корпус развёрнут, плечо вперёд,
+  // рука прижата, подбородок вниз) или толкает рукой либо двумя (руки к груди того, локти чуть согнуты; врезался -
+  // руки разгибаются, корпус подаётся вперёд)
+  enum Brace : uint8_t {
+    B_Shoulder = 0,
+    B_Push1    = 1,
+    B_Push2    = 2,
+    };
+  float         brace     = 0;  // 0..1 - готов к удару
+  uint8_t       braceKind = B_Shoulder;
+  int8_t        braceSide = 0;  // ведущая сторона: 0 - левое плечо (левая рука), 1 - правое
+  Tempest::Vec3 braceAt   = {}; // куда руки: грудь того, в кого врезается (мир), см
+  float         braceHit  = 0;  // 0..1 - удар: руки разгибаются (толчок), корпус пружинит
+
+  bool isActive() const {
+    return (arm>=0 && reach>0.001f) || (leg>=0 && limp>0.001f) || hunch>0.001f || pain>0.001f || brace>0.001f;
+    }
+  };
+
+// Рука к ране во времени (Npc::tickInjury): через Delay после удара тянется (Rise), держит, отпускает (Fall). Новая
+// рана, пока рука у старой, - рука сначала плавно уходит от старой и только потом тянется к новой: иначе в драке
+// рука прыгала бы от раны к ране за один кадр. Время - мс игры
+struct WoundReach final {
+  struct Wound final {
+    uint16_t      bone   = 0;
+    int8_t        arm    = -1;
+    uint8_t       zone   = 0;    // InjuryRig::Zone
+    Tempest::Vec3 local  = {};
+    Tempest::Vec3 normal = {};
+    };
+  static constexpr int64_t Delay = 150;
+  static constexpr int64_t Rise  = 650;
+  static constexpr int64_t Fall  = 900;
+  static constexpr int64_t Swap  = 550;  // уйти от старой раны (полностью прижатая рука)
+
+  Wound    cur, next;
+  bool     hasNext     = false;
+  int64_t  at          = 0;    // удар, с которого считается текущая рана
+  int64_t  hold        = 0;
+  int64_t  releaseAt   = -1;   // рука уходит от старой раны к новой
+  float    releaseFrom = 0;
+
+  bool  active() const { return cur.arm>=0; }
+
+  float envelopeAt(int64_t now) const {
+    const float t = float(now-at-Delay);
+    if(t<=0.f)
+      return 0.f;
+    auto smooth = [](float x) { x = x<0.f ? 0.f : (x>1.f ? 1.f : x); return x*x*(3.f-2.f*x); };
+    if(t<float(Rise))
+      return smooth(t/float(Rise));
+    if(t<float(Rise+hold))
+      return 1.f;
+    return 1.f-smooth((t-float(Rise+hold))/float(Fall));
+    }
+
+  void add(const Wound& w, int64_t now, int64_t holdMs) {
+    const float cw = weight(now);
+    if(!active() || cw<0.05f) {
+      cur       = w;
+      at        = now;
+      hold      = holdMs;
+      releaseAt = -1;
+      hasNext   = false;
+      return;
+      }
+    if(w.arm==cur.arm && (w.bone==cur.bone || (w.zone==cur.zone && w.zone==0))) {
+      // та же рана или снова в корпус - рука остаётся на первой ране (держится за самую больную), держит дольше:
+      // иначе в драке, где удар за ударом, рука только перебегала бы от раны к ране и не дотягивалась
+      const int64_t left = at+Delay+Rise+hold-now;
+      hold += std::max<int64_t>(0, holdMs-left);
+      return;
+      }
+    next        = w;
+    hasNext     = true;
+    if(releaseAt<0) {
+      releaseAt   = now;
+      releaseFrom = cw;
+      }
+    hold = holdMs; // для новой раны
+    }
+
+  // Вес руки у раны сейчас (и переход к следующей ране, если старая отпущена)
+  float weight(int64_t now) {
+    if(!active())
+      return 0.f;
+    if(releaseAt>=0) {
+      const int64_t dur = std::max<int64_t>(1, int64_t(float(Swap)*releaseFrom));
+      const float   t   = float(now-releaseAt)/float(dur);
+      if(t<1.f) {
+        const float x = t*t*(3.f-2.f*t);
+        return releaseFrom*(1.f-x);
+        }
+      releaseAt = -1;
+      if(hasNext) {
+        cur     = next;
+        hasNext = false;
+        at      = now-Delay; // тянуться сразу: удар уже был
+        }
+      }
+    return envelopeAt(now);
+    }
+
+  // Снова держаться за ту же рану (встал после падения)
+  void rearm(int64_t now, int64_t holdMs, int64_t delay) {
+    if(!active())
+      return;
+    at        = now+delay-Delay;
+    hold      = holdMs;
+    releaseAt = -1;
+    hasNext   = false;
+    }
+  };
+
+// Дыхание лежащего (Npc; поза - Ragdoll::breathe, без физики): вдох 0..1 во времени. Умирающий, пока корчится,
+// дышит часто и судорожно; потом вдохи всё реже и слабее, последний - судорожный, и дыхание останавливается.
+// Оглушённый дышит ровно и неглубоко (первые вдохи - глубже), пока не встанет. Время - мс игры
+struct Breathing final {
+  enum Kind : uint8_t {
+    None   = 0,
+    Dying  = 1,
+    Steady = 2,
+    };
+  uint8_t  kind    = None;
+  uint32_t seed    = 1;
+  int64_t  cycleAt = 0;     // начало вдоха
+  float    period  = 2000;  // мс: вдох, выдох и пауза
+  float    amp     = 0;     // глубина вдоха 0..1
+  float    gasp    = 0;     // 0..1: судорожный (быстрый вдох, плечи вверх, голова назад)
+  int      left    = -1;    // умирающий: вдохов осталось; -1 - ещё корчится
+  int      n       = 0;     // номер вдоха
+
+  bool active() const { return kind!=None; }
+  void stop()         { kind = None; }
+
+  void start(Kind k, int64_t now, uint32_t s) {
+    kind    = k;
+    seed    = s | 1u;
+    n       = 0;
+    left    = -1;
+    cycleAt = now + (k==Dying ? 250 : 900);
+    next();
+    }
+
+  // struggling - кукла ещё корчится (Ragdoll::inThroes): умирающий дышит часто; кончилась агония - осталось 2-5 вдохов
+  void tick(int64_t now, bool struggling) {
+    if(kind==Dying && !struggling && left<0)
+      left = 2 + int(rnd()*3.99f);
+    while(kind!=None && now>=cycleAt+int64_t(period)) {
+      cycleAt += int64_t(period);
+      n++;
+      if(kind==Dying && left>=0) {
+        if(left==0) {
+          kind = None;
+          return;
+          }
+        left--;
+        }
+      next();
+      }
+    }
+
+  float inhale(int64_t now) const {
+    if(kind==None || now<cycleAt)
+      return 0.f;
+    // вдох (судорожный - быстрее), выдох, пауза
+    const float u  = float(now-cycleAt)/period;
+    const float pi = 0.38f - 0.16f*gasp, pe = 0.78f;
+    auto smooth = [](float x) { x = x<0.f ? 0.f : (x>1.f ? 1.f : x); return x*x*(3.f-2.f*x); };
+    float v = 0;
+    if(u<pi)
+      v = smooth(u/pi); else
+    if(u<pe)
+      v = 1.f-smooth((u-pi)/(pe-pi));
+    return v*amp;
+    }
+
+  private:
+    float rnd() {
+      seed = seed*1664525u + 1013904223u;
+      return float((seed>>8) & 0xFFFFu)/65535.f;
+      }
+
+    void next() {
+      if(kind==Steady) {
+        period = 3400.f + 1200.f*rnd();
+        amp    = (n<3 ? 0.85f : 0.55f) + 0.1f*rnd();
+        gasp   = 0;
+        return;
+        }
+      if(left<0) {
+        // корчится: часто, глубоко, со всхлипом
+        period = 1300.f + 600.f*rnd();
+        amp    = 0.8f + 0.2f*rnd();
+        gasp   = 0.5f + 0.3f*rnd();
+        return;
+        }
+      // угасает: реже и слабее, последний вдох - судорожный
+      period = std::min(period*(1.2f + 0.2f*rnd()), 4500.f);
+      amp    = (left==0) ? 1.f : amp*0.8f;
+      gasp   = (left==0) ? 1.f : gasp*0.8f;
+      }
+  };
+
+// Стойка активного регдолла (Ragdoll::activePose): таз сдвинут поведением (колени пружинят, нога подгибается,
+// тело приседает на шаге), ступни стоят там, куда их поставили шаги пошатывания. Ноги - IK к ступням
+struct Stance final {
+  Tempest::Vec3 shift    = {};  // сдвиг таза в мире, см
+  Tempest::Vec3 rot      = {};  // поворот таза в мире: ось * угол, рад
+  Tempest::Vec3 foot[2]  = {};  // ступни (начало кости стопы) в мире, см
+  float         footW[2] = {};  // 0 - ступня как в анимации (ноги гнутся только из-за сдвига таза)
+  float         weight   = 0;   // доля стойки на экране
+
+  bool isActive() const { return weight>0.001f; }
+  };
+
+class InjuryRig final {
+  public:
+    enum Zone : uint8_t {
+      Z_Torso = 0,
+      Z_Head  = 1,
+      Z_Arm   = 2,
+      Z_Leg   = 3,
+      };
+
+    struct Wound final {
+      uint16_t      bone   = 0;
+      Tempest::Vec3 local  = {};
+      Tempest::Vec3 normal = {};
+      Zone          zone   = Z_Torso;
+      int8_t        side   = -1; // рука или нога: 0 - левая, 1 - правая; корпус и голова - сторона удара
+      };
+
+    // Схема скелета человека (кости Biped); nullptr - не человек (звери, монстры)
+    static const InjuryRig* of(const Skeleton& sk);
+
+    // Ближайшая к точке удара часть тела: точка раны на поверхности тела (в системе кости)
+    bool      woundAt(const Tempest::Matrix4x4* world, size_t count, const Tempest::Vec3& at, Wound& out) const;
+    // Какой рукой держаться за рану (0/1, -1 - нечем): free - свободные руки (бит 0 - левая, бит 1 - правая)
+    int8_t    reachArm(const Wound& w, uint8_t free) const;
+    // Слой позы: world - мировые матрицы всех костей по анимации, obj - матрица объекта (вперёд, вверх)
+    void      apply(const Injury& inj, const Tempest::Matrix4x4& obj, Tempest::Matrix4x4* world, size_t count) const;
+    // Стойка активного регдолла: таз и ноги (поверх анимации и слоя ран)
+    void      applyStance(const Stance& st, const Tempest::Matrix4x4& obj, Tempest::Matrix4x4* world, size_t count) const;
+
+  private:
+    InjuryRig() = default;
+
+    size_t                pelvis = size_t(-1);
+    size_t                head   = size_t(-1);
+    size_t                neck   = size_t(-1);
+    std::vector<size_t>   spine;     // от таза вверх
+    std::vector<size_t>   bendable;  // позвонки выше крепления бёдер - их гнуть, не сдвигая ног
+    size_t                upper[2] = {size_t(-1),size_t(-1)}, fore[2] = {size_t(-1),size_t(-1)}, hand[2] = {size_t(-1),size_t(-1)};
+    size_t                thigh[2] = {size_t(-1),size_t(-1)}, calf[2] = {size_t(-1),size_t(-1)}, foot[2] = {size_t(-1),size_t(-1)};
+    std::vector<size_t>   parent;
+    std::vector<uint16_t> order;     // от корней к концам
+
+    struct Work;
+    void      rebuild(Work& w) const;
+    void      setWorld(Work& w, size_t bone, const Tempest::Matrix4x4& m) const;
+    void      applyLimp (const Injury& inj, Work& w, const Tempest::Vec3& fwd) const;
+    void      applyHunch(float a, Work& w, const Tempest::Vec3& axis) const;
+    void      applyPain (const Injury& inj, Work& w, const Tempest::Vec3& fwd) const;
+    void      applyReach(const Injury& inj, Work& w, const Tempest::Vec3& fwd) const;
+    void      applyBrace(const Injury& inj, Work& w, const Tempest::Vec3& fwd) const;
+  };
diff --git a/common/graphics/mesh/limbik.h b/common/graphics/mesh/limbik.h
new file mode 100644
index 0000000..69d1a10
--- /dev/null
+++ b/common/graphics/mesh/limbik.h
@@ -0,0 +1,147 @@
+#pragma once
+
+#include <Tempest/Matrix4x4>
+#include <Tempest/Vec>
+
+#include <algorithm>
+#include <cmath>
+
+// Gothic II Mobile: двухзвенный IK для рук и ног (активный регдолл: шаги при пошатывании, Ragdoll; хромота и рука
+// к ране, Pose::applyInjury). Работает только с началами костей (плечо/бедро, локоть/колено, запястье/лодыжка) и
+// поворачивает кость наименьшим поворотом - не зависит от того, как в скелете направлены оси костей.
+namespace LimbIk {
+
+using Tempest::Matrix4x4;
+using Tempest::Vec3;
+
+inline Vec3 origin(const Matrix4x4& m) {
+  return Vec3(m.at(3,0),m.at(3,1),m.at(3,2));
+  }
+
+inline void setOrigin(Matrix4x4& m, const Vec3& v) {
+  m.set(3,0,v.x);
+  m.set(3,1,v.y);
+  m.set(3,2,v.z);
+  }
+
+inline Vec3 axis(const Matrix4x4& m, int c) {
+  return Vec3(m.at(c,0),m.at(c,1),m.at(c,2));
+  }
+
+inline Vec3 rotate(const Vec3& v, const Vec3& ax, float cs, float sn) {
+  // поворот вектора вокруг единичной оси (Родриг)
+  return v*cs + Vec3::crossProduct(ax,v)*sn + ax*(Vec3::dotProduct(ax,v)*(1.f-cs));
+  }
+
+// Наименьший поворот, переводящий направление from в направление to, применённый к осям матрицы m (начало - на месте)
+inline void rotateBasis(Matrix4x4& m, const Vec3& from, const Vec3& to) {
+  const float la = from.length(), lb = to.length();
+  if(la<1e-4f || lb<1e-4f)
+    return;
+  const Vec3 a = from/la, b = to/lb;
+  Vec3  ax = Vec3::crossProduct(a,b);
+  float sn = ax.length();
+  float cs = std::clamp(Vec3::dotProduct(a,b),-1.f,1.f);
+  if(sn<1e-6f) {
+    if(cs>0.f)
+      return;
+    // разворот на 180: любая ось, перпендикулярная a
+    ax = std::abs(a.y)<0.9f ? Vec3::crossProduct(a,Vec3(0,1,0)) : Vec3::crossProduct(a,Vec3(1,0,0));
+    ax = Vec3::normalize(ax);
+    sn = 0.f;
+    cs = -1.f;
+    } else {
+    ax = ax/sn;
+    }
+  for(int c=0; c<3; ++c) {
+    const Vec3 v = rotate(axis(m,c),ax,cs,sn);
+    m.set(c,0,v.x);
+    m.set(c,1,v.y);
+    m.set(c,2,v.z);
+    }
+  }
+
+// Поворот осей матрицы m вокруг оси ax (единичной) на угол ang, рад; начало - на месте
+inline void rotateBasis(Matrix4x4& m, const Vec3& ax, float ang) {
+  const float cs = std::cos(ang), sn = std::sin(ang);
+  for(int c=0; c<3; ++c) {
+    const Vec3 v = rotate(axis(m,c),ax,cs,sn);
+    m.set(c,0,v.x);
+    m.set(c,1,v.y);
+    m.set(c,2,v.z);
+    }
+  }
+
+// Поворот матрицы m (и оси, и начало) вокруг точки at
+inline void rotateAround(Matrix4x4& m, const Vec3& at, const Vec3& ax, float ang) {
+  const float cs = std::cos(ang), sn = std::sin(ang);
+  rotateBasis(m,ax,ang);
+  setOrigin(m, at + rotate(origin(m)-at,ax,cs,sn));
+  }
+
+inline Matrix4x4 relative(const Matrix4x4& parent, const Matrix4x4& child) {
+  Matrix4x4 inv = parent;
+  inv.inverse();
+  return inv*child;
+  }
+
+// Двухзвенная цепочка: upper (бедро, плечо) -> lower (голень, предплечье) -> end (стопа, кисть). Начало end
+// ставится в target (если не дотянуться - как можно ближе), сгиб - в плоскости позы (pole - подсказка, куда
+// смотрит колено/локоть, если поза прямая). Возвращает, насколько точно дотянулись (см до цели).
+inline float solve(Matrix4x4& upper, Matrix4x4& lower, Matrix4x4& end, const Vec3& target, const Vec3& pole) {
+  const Vec3  a  = origin(upper), b = origin(lower), c = origin(end);
+  const float l1 = (b-a).length(), l2 = (c-b).length();
+  if(l1<1e-3f || l2<1e-3f)
+    return (c-target).length();
+  const Matrix4x4 lowerInUpper = relative(upper,lower);
+  const Matrix4x4 endInLower   = relative(lower,end);
+
+  Vec3  toT = target-a;
+  float d   = toT.length();
+  if(d<1e-3f)
+    return (c-target).length();
+  const Vec3 u = toT/d;
+  d = std::clamp(d, std::abs(l1-l2)+0.01f*(l1+l2), (l1+l2)*0.999f);
+
+  // плоскость сгиба: где колено сейчас относительно линии бедро-стопа, с подсказкой pole. Почти прямая нога в позе
+  // анимации даёт крошечный и пляшущий изгиб - без подсказки колено перещёлкивало бы назад и вперёд от кадра к кадру
+  const Vec3 poleN = pole.length()>1e-4f ? Vec3::normalize(pole) : Vec3();
+  Vec3 bend = (b-a) - u*Vec3::dotProduct(b-a,u) + (poleN - u*Vec3::dotProduct(poleN,u))*(0.15f*l1);
+  if(bend.length()<0.02f*l1)
+    bend = pole - u*Vec3::dotProduct(pole,u);
+  if(bend.length()<1e-4f)
+    bend = std::abs(u.y)<0.9f ? Vec3::crossProduct(u,Vec3(0,1,0)) : Vec3::crossProduct(u,Vec3(1,0,0));
+  bend = Vec3::normalize(bend);
+
+  const float x  = (l1*l1 - l2*l2 + d*d)/(2.f*d);
+  const float y  = std::sqrt(std::max(l1*l1 - x*x, 0.f));
+  const Vec3  b1 = a + u*x + bend*y;
+
+  rotateBasis(upper, b-a, b1-a);
+  lower = upper*lowerInUpper;
+  Matrix4x4 e = lower*endInLower;
+  rotateBasis(lower, origin(e)-origin(lower), (a+u*d)-origin(lower));
+  end = lower*endInLower;
+  return (origin(end)-target).length();
+  }
+
+// Плавные кривые для огибающих отклика
+inline float smooth(float t) {
+  t = std::clamp(t,0.f,1.f);
+  return t*t*(3.f-2.f*t);
+  }
+
+// Огибающая: нарастает за rise, держится hold, спадает за fall (с, всё плавно)
+inline float envelope(float t, float rise, float hold, float fall) {
+  if(t<0.f)
+    return 0.f;
+  if(t<rise)
+    return smooth(t/rise);
+  t -= rise;
+  if(t<hold)
+    return 1.f;
+  t -= hold;
+  return 1.f - smooth(t/fall);
+  }
+
+}
