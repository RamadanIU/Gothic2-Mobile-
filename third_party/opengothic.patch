+  // Анатомические суставы людей (J_Euler, J_Swing): системы - от нейтральной позы тела (вверх, вперёд по стопам,
+  // наружу от тела), пределы - подвижность суставов человека (средние значения из ортопедии), углы по правилу
+  // правой руки: Z - сгиб (вперёд для позвоночника, бедра, локтя, кисти; назад для колена), Y - отведение или
+  // наклон вбок, X - кручение вокруг кости
+  void anatomy(Ragdoll::Layout& lay, const std::vector<Vec3>& partEnd, const Vec3& F) const {
+    const Vec3   U      = Vec3(0,1,0);
+    const Vec3   L      = Vec3::crossProduct(U,F);
+    const float  nSpine = float(std::max<size_t>(lay.spineChain.size(),1));
+    const bool   neck   = lay.neck!=size_t(-1);
+    const Vec3   chest  = pos[lay.parts[lay.chest].bone];
+    const Vec3   pelvis = pos[lay.parts[0].bone];
+    auto outward = [&](const Vec3& at, const Vec3& from) {
+      Vec3 v = at-from;
+      v = v - U*Vec3::dotProduct(v,U);
+      return v.length()>1e-3f ? Vec3::normalize(v) : L;
+      };
+    for(size_t i=1; i<lay.parts.size(); ++i) {
+      auto&       p   = lay.parts[i];
+      const auto& pp  = lay.parts[p.parent];
+      const Vec3  at  = pos[p.bone];
+      const Vec3  dir = Vec3::normalize(partEnd[i]-at);
+      Matrix4x4   J   = mkFrame(at,U,F,L);
+      auto lim = [&p](float xl, float xh, float yl, float yh, float zl, float zh) {
+        p.joint = J_Euler;
+        p.lo[0] = deg(xl); p.hi[0] = deg(xh);
+        p.lo[1] = deg(yl); p.hi[1] = deg(yh);
+        p.lo[2] = deg(zl); p.hi[2] = deg(zh);
