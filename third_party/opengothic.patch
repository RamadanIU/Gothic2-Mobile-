+        if(ui==Ui::Inventory) {
+          switch(owner.touchInventoryAction()) {
+            case InventoryMenu::TouchAction::Use:  txt = "Применить"; break;
+            case InventoryMenu::TouchAction::Take: txt = "Взять";     break;
+            case InventoryMenu::TouchAction::Put:  txt = "Положить";  break;
+            case InventoryMenu::TouchAction::Buy:  txt = "Купить";    break;
+            case InventoryMenu::TouchAction::Sell: txt = "Продать";   break;
+            case InventoryMenu::TouchAction::None: break;
+            }
+          }
+        drawPill(p,b.rect,TouchIcons::I_Ok,toCp1251(txt),pressed);
+        break;
+        }
+      case C_Back: {
+        const char* txt = "Закрыть";
+        if(ui==Ui::Dialog)
+          txt = "Пропуск";
+        else if(ui==Ui::LockPick)
+          txt = "Отойти";
+        drawPill(p,b.rect,ui==Ui::Dialog ? TouchIcons::I_Skip : TouchIcons::I_Back,toCp1251(txt),pressed);
+        break;
+        }
+      case C_TakeAll:
+        drawPill(p,b.rect,TouchIcons::I_TakeAll,toCp1251("Взять всё"),pressed);
+        break;
+      case C_Skip:
+        drawPill(p,b.rect,TouchIcons::I_Skip,toCp1251("Пропустить"),pressed);
+        break;
+      case C_None:
+      case C_Joy:
+      case C_Look:
+      case C_List:
+      case C_Absorb:
+      case C_Count:
+        break;
+      }
+    }
+
+  // Долгие нажатия: кольцо заполняется, пока держат
+  const uint64_t now = Application::tickCount();
+  for(auto& f:fingers) {
+    if(f.held || f.moved)
+      continue;
+    if(f.ctl==C_Menu && now-f.downAt>150)
+      drawHoldRing(p,buttonOf(C_Menu),float(now-f.downAt-150)/550.f);
+    if(f.ctl==C_Potion && now-f.downAt>150 && ctrl.potionCount(true)>0)
+      drawHoldRing(p,buttonOf(C_Potion),float(now-f.downAt-150)/300.f);
+    }
+
+  if(wheel!=Wheel::None)
+    drawWheel(p);
+  }
