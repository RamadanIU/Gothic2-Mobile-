+bool PlayerControl::isSneak() const {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  return pl!=nullptr && (pl->walkMode()&WalkBit::WM_Sneak)==WalkBit::WM_Sneak;
+  }
