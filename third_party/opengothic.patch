+void GameMenu::drawLoupe(Painter& p) {
+  // Пока палец на меню - выделенное крупно над пальцем: под пальцем строки не видно
+  if(!touchDown || logView!=nullptr || touchDrag==TouchDrag::Text || touchDrag==TouchDrag::List)
+    return;
+  std::string txt;
+  if(logList!=nullptr) {
+    if(auto q = questOf(*logList,logList->value))
+      txt = q->name;
+    }
+  else if(auto sel = selectedItem(); sel!=nullptr && sel->handle!=nullptr) {
+    txt = sel->handle->text[0];
+    // Подпись и переключатель - одна строка: «Субтитры: вкл»
+    if(auto ch = chainOf(*sel,zenkit::MenuItemType::CHOICEBOX); ch!=nullptr && ch!=sel) {
+      std::vector<char> buf;
+      getText(*ch,buf);
+      if(buf.size()>1 && buf[0]!='\0')
+        txt = txt + ": " + buf.data();
+      }
+    }
+  for(auto& c:txt)
+    if(c=='\n')
+      c = ' ';
+  if(txt.empty())
+    return;
+
+  const float scale = Gothic::interfaceScale(this);
+  auto&       fnt   = Resources::font(Resources::FontType::Hi,scale*1.5f);
+  const auto  sz    = fnt.textSize(txt);
+  const int   pad   = int(10*scale);
+  const int   bw    = sz.w+2*pad, bh = fnt.pixelSize()+2*pad;
+  // Над пальцем, в пределах экрана (меню бывает меньше экрана - координаты экрана через x(), y())
+  int bx = touchLast.x-bw/2;
+  int by = touchLast.y-int(70*scale)-bh;
+  bx = std::max(std::min(bx,owner.w()-x()-bw-pad),-x()+pad);
+  if(by<-y()+pad)
+    by = touchLast.y+int(50*scale);
+  p.setBrush(Color(0.36f,0.27f,0.16f,0.95f));
+  p.drawRect(bx-2,by-2,bw+4,bh+4);
+  p.setBrush(Color(0.07f,0.055f,0.045f,0.94f));
+  p.drawRect(bx,by,bw,bh);
+  p.setBrush(Color(1.f));
+  fnt.drawText(p,bx+pad,by+pad+fnt.pixelSize(),txt);
+  }
