+void AiNpc::enterWorld(Npc& npc, Npc& hero, World& w) {
+  if(!isGeraltNpc(npc))
+    return;
+  hero.handle().aivar[AivHeroGeraltAway] = isTargetWorld(w) ? 0 : 1;
+  Log::i("[g2m] ai: Geralt came with hero to ",w.name());
