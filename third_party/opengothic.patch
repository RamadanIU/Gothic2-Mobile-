+int PlayerControl::potionValue(Npc& pl, size_t cls, bool mana) const {
+  // Сколько даёт зелье: строка «Здоровье»/«Мана» (NAME_BONUS_HP/MANA) и число при ней в описании предмета,
+  // как в окне сумки; «Чистое здоровье/мана» (ADDON_04) - всё
+  auto  w  = Gothic::inst().world();
+  auto& sc = w->script();
+  if(cls==sc.findSymbolIndex(mana ? "ITPO_MANA_ADDON_04" : "ITPO_HEALTH_ADDON_04"))
+    return pl.attribute(mana ? ATR_MANAMAX : ATR_HITPOINTSMAX);
+  auto* txt = sc.findSymbol(mana ? "NAME_BONUS_MANA" : "NAME_BONUS_HP");
+  if(txt==nullptr)
+    return 0;
+  for(auto it=pl.inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it) {
+    const Item& itm = *it;
+    if(itm.clsId()!=cls)
+      continue;
+    const auto& h = itm.handle();
+    int v = 0;
+    for(size_t k=0; k<zenkit::IItem::text_count; ++k)
+      if(h.text[k]==txt->get_string())
+        v = std::max(v,h.count[k]);
+    return v;
+    }
+  return 0;
+  }
