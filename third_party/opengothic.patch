+  // кадр; движок считал её для всех NPC мира. Рядом с героем и камерой - каждый кадр, дальше - реже
+  // (через 2/4/8 кадров), вне экрана - ещё вдвое реже. Кадр пропуска у каждого NPC свой, чтобы нагрузка
+  // не собиралась в один кадр. Время пропущенных кадров не теряется: позу задаёт время мира,
+  // звуки и частицы анимации берутся за весь промежуток (Pose::processSfx от прошлого обновления).
+  animLodDt += dt;
+  if(isPlayer())
+    return true;
+
+  const Tempest::Vec3 at   = position();
+  const float         dist = std::sqrt(std::min((at-lod.camera).quadLength(), (at-lod.player).quadLength()));
+  uint32_t step = 1;
+  if(dist<4000)
+    step = 1;
+  else if(dist<8000)
+    step = 2;
+  else if(dist<16000)
+    step = 4;
+  else
+    step = 8;
+  if(dist>=2000 && lod.view!=nullptr && !lod.view->testPoint(at+Tempest::Vec3(0,100,0), 200.f))
+    step = std::min(step*2, 16u);
+  if(lod.viewDist>0 && dist>lod.viewDist+2000)
+    step = 16;
+
+  const uint32_t seed = uint32_t(reinterpret_cast<uintptr_t>(this) >> 4);
+  return step<=1 || (lod.frame+seed)%step==0;
+  }
+
+void Npc::updateAnimationLod() {
+  const uint64_t dt = animLodDt;
+  animLodDt = 0;
+  updateAnimation(dt);
+  }
