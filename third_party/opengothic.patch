+void TouchInput::drawJoystick(Painter& p) {
+  const float d  = dp();
+  const int   R  = int(56*d);
+  const int   ds = int(float(2*R)/0.88f);
+
+  Point center = Point(int(16*d)+R+int(16*d), h()-int(16*d)-R-int(12*d));
+  Point knob   = center;
+  float alpha  = 0.28f;
+  bool  active = false;
+  for(auto& f:fingers) {
+    if(f.ctl!=C_Joy)
+      continue;
+    center = f.start;
+    auto  dv  = f.last-f.start;
+    float len = std::sqrt(float(dv.x*dv.x + dv.y*dv.y));
+    if(len>float(R)) {
+      dv.x = int(float(dv.x)*float(R)/len);
+      dv.y = int(float(dv.y)*float(R)/len);
+      }
+    knob   = center+dv;
+    alpha  = 0.75f;
+    active = true;
+    }
+
+  auto& base = icons.disc(ds);
+  p.setBrush(Brush(base,Color(1.f,1.f,1.f,alpha*0.8f)));
+  p.drawRect(center.x-ds/2, center.y-ds/2, ds, ds, 0,0,base.w(),base.h());
+
+  // Кольцо шага: внутри - шаг, за ним - бег
+  if(active) {
+    const int ws = int(float(R)*1.1f);
+    auto&     g  = icons.glow(ws);
+    p.setBrush(Brush(g,Color(1.f,0.85f,0.55f,0.25f),Painter::Add));
+    const int gs = int(float(ws)*1.3f);
+    p.drawRect(center.x-gs/2, center.y-gs/2, gs, gs, 0,0,g.w(),g.h());
+    }
+
+  const int kr = int(float(R)*0.42f);
+  Button kb;
+  kb.c = knob;
+  kb.r = kr;
+  drawRound(p, kb, TouchIcons::I_Dot, false, active && joyRun, alpha+0.15f);
+  }
