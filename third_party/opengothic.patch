+namespace {
+  // Действия тела: начинаются вне разговора - конец ZS_Talk и смена состояния стирают очередь ИИ
+  bool isBodyAct(std::string_view n) {
+    static const char* list[] = {"go_to_place","go_to_npc","approach","follow_hero","wait_here","stop_following",
+                                 "attack","stop_fight","take_item","activity","use_mob","loot","go_home"};
+    for(auto* i:list)
+      if(n==i)
+        return true;
+    return false;
+    }
+  // Мгновенные из них: итог известен сразу, движение - потом
+  bool isInstantBody(std::string_view n) {
+    return n=="follow_hero" || n=="wait_here" || n=="stop_following" || n=="stop_fight" || n=="activity" ||
+           n=="go_home";
+    }
+  }
+
+void AiNpc::cmdAct(Npc& npc, const std::string& id, const std::string& name, const void* argsPtr) {
+  const auto& args = *reinterpret_cast<const rapidjson::Value*>(argsPtr);
+  auto* w  = world();
+  Npc*  pl = w!=nullptr ? w->player() : nullptr;
+  if(w==nullptr || pl==nullptr)
+    return;
+  const uint64_t now = owner.tickCount();
+
+  Action a;
+  a.actor    = &npc;
+  a.id       = id;
+  a.name     = name;
+  a.started  = now;
+  a.deadline = now+60000;
+
+  auto fail = [&](std::string_view why) { finish(a,false,why); };
+  auto done = [&](std::string_view note) { finish(a,true,note); };
+  auto target = [&]() -> Npc* {
+    const std::string t = str(args,"target");
+    if(t.empty() || t=="hero")
+      return pl;
+    return npcByRef(t);
+    };
+
+  if(npc.isDown()) {
+    fail("ты без сознания");
+    return;
+    }
+
+  // Сначала - проверка и разбор: ошибку модель получит сразу
+  if(name=="follow_hero" && !owner.isPartyMember(npc) && owner.squadFull()) {
+    // Как у найма: в отряде героя не больше шести
+    fail("с героем и так идут шестеро - седьмого отряд не возьмёт");
+    return;
+    }
+  if(name=="go_to_place") {
+    a.wp = placeByName(str(args,"place"));
+    if(a.wp==nullptr) {
+      fail("нет такого места; возьми название из списка мест в обстановке");
+      return;
+      }
+    }
+  else if(name=="go_to_npc" || name=="approach" || name=="attack" || name=="loot") {
+    a.target = target();
+    if(a.target==nullptr || a.target==&npc) {
+      fail("не вижу такого");
+      return;
+      }
+    if(name=="attack" && a.target->isDead()) {
+      fail("цель уже мертва");
+      return;
+      }
+    if(name=="loot" && (a.target==pl || !(a.target->isDead() || a.target->isUnconscious()))) {
+      fail("обыскать можно только мёртвого или без сознания");
+      return;
+      }
+    }
+  else if(name=="take_item") {
+    a.item = itemByRef(str(args,"item"));
+    if(a.item==nullptr) {
+      fail("такого предмета на земле нет");
+      return;
+      }
+    a.text = fromCp1251(a.item->displayName());
+    }
+  else if(name=="activity" && owner.isHired(npc)) {
+    // В отряде занятия - на привале, сами (GameScript::tickSquadIdle): занятие вывело бы из отряда
+    fail("ты в отряде героя: на привале займёшься делом сам; остаться здесь - wait_here, уйти к своим делам - go_home");
+    return;
+    }
+  else if(name=="activity") {
+    static const struct { const char* name; const char* zs; } list[] = {
+      {"stand","ZS_STAND_ARMSCROSSED"}, {"guard","ZS_STAND_GUARDING"}, {"sit","ZS_SIT_CAMPFIRE"},
+      {"practice_sword","ZS_PRACTICE_SWORD"}, {"eat","ZS_STAND_EATING"}, {"drink","ZS_STAND_DRINKING"},
+      {"look_around","ZS_STAND_WP"}, {"smoke","ZS_SMOKE_JOINT"},
+      {"sit_chair","ZS_SIT_CHAIR"}, {"sit_bench","ZS_SIT_BENCH"},
+      };
+    const std::string act = str(args,"name");
+    for(auto& i:list)
+      if(act==i.name && owner.findSymbolIndex(i.zs)!=size_t(-1)) {
+        a.text = i.zs;
+        a.mood = act;
+        }
+    if(a.text.empty()) {
+      fail("нет такого занятия");
+      return;
+      }
+    }
+  else if(name=="use_mob") {
+    a.text = upper(str(args,"scheme"));
+    auto* mob = w->availableMob(npc,a.text);
+    if(mob==nullptr) {
+      fail("рядом нет свободного предмета такого вида");
+      return;
+      }
+    a.mood = fromCp1251(mob->displayName());
+    }
+
+  if(name=="story") {
+    // Сюжетная тема его диалогов (story_topic): скрипт игры исполняется сразу, итог - модели
+    cmdStory(npc,a,str(args,"topic"));
+    return;
+    }
+
+  if(isBodyAct(name)) {
+    cancelBody(&npc,"новое действие");
+    if((&npc==geralt && talking) || npc.isTalk()) {
+      // Сначала договорить: начнётся, когда герой закроет разговор. Сам разговор не обрывает (прежде
+      // закрывал диалог сразу после реплики - разговор не складывался)
+      if(isInstantBody(name)) {
+        done("сделаешь, как только закончится разговор");
+        a.report = false;
+        a.closed = false;
+        }
+      acts.push_back(a);
+      return;
+      }
+    acts.push_back(a);
+    beginBody(acts.back());
+    return;
+    }
+
+  if(name=="equip" || name=="unequip") {
+    const size_t sym = itemSymbol(str(args,"item"));
+    if(sym==size_t(-1) || npc.itemCount(sym)==0) {
+      fail("у тебя нет такого предмета; смотри свой инвентарь в обстановке");
+      return;
+      }
+    bool ok = false;
+    const std::string note = name=="equip" ? equip(npc,sym,ok) : unequip(npc,sym,ok);
+    finish(a,ok,note);
+    return;
+    }
+  if(name=="draw_weapon") {
+    npc.aiPush(AiQueue::aiDrawWeapon());
+    done("оружие наготове");
+    return;
+    }
+  if(name=="holster_weapon") {
+    npc.aiPush(AiQueue::aiRemoveWeapon());
+    done("оружие убрано");
+    return;
+    }
+  if(name=="give_item") {
+    const size_t sym   = itemSymbol(str(args,"item"));
+    const size_t count = size_t(std::clamp<int64_t>(num(args,"count",1),1,1000));
+    Npc* to = target();
+    if(to==nullptr)
+      to = pl;
+    if(sym==size_t(-1) || npc.itemCount(sym)==0) {
+      fail("у тебя нет такого предмета; смотри свой инвентарь в обстановке");
+      return;
+      }
+    const size_t n    = std::min(count,npc.itemCount(sym));
+    const auto   item = itemNameUtf8(npc,sym);
+    if(auto* it = npc.getItem(sym); it!=nullptr && it->isEquipped())
+      npc.unequipItem(sym);
+    to->addItem(sym,npc,n);
+    if(to->isPlayer()) {
+      std::string msg = fromCp1251(npc.displayName())+" дал(а) тебе: "+item+(n>1 ? " x"+std::to_string(n) : std::string());
+      Gothic::inst().onPrint(toCp1251(msg));
+      }
+    done("отдано: "+item+" x"+std::to_string(n));
+    return;
+    }
+  if(name=="use_item") {
+    const size_t sym = itemSymbol(str(args,"item"));
+    if(sym==size_t(-1) || npc.itemCount(sym)==0) {
+      fail("у тебя нет такого предмета");
+      return;
+      }
+    npc.aiPush(AiQueue::aiUseItem(int32_t(sym)));
+    done("использовано: "+itemNameUtf8(npc,sym));
+    return;
+    }
+  if(name=="gesture") {
+    static const struct { const char* name; const char* ani; } gestures[] = {
+      {"nod","T_YES"}, {"no","T_NO"}, {"shrug","T_DONTKNOW"}, {"come_here","T_COMEOVERHERE"},
+      {"greet","T_GREETNOV"}, {"dismiss","T_FORGETIT"}, {"get_lost","T_GETLOST"}, {"salute","T_GREETRIGHT"},
+      // Gothic II Mobile: T_WATCHFIGHT_* - зевака у драки (прыгает и машет кулаками): житель «плясал» вместо удара
+      {"look_around","T_SEARCH"}, {"cheer","T_YES"}, {"angry","T_GETLOST"},
+      };
+    const std::string g = str(args,"name");
+    for(auto& i:gestures)
+      if(g==i.name) {
+        npc.aiPush(AiQueue::aiPlayAnim(i.ani));
+        done("жест");
+        return;
+        }
+    fail("нет такого жеста");
+    return;
+    }
+  if(name=="look_at" || name=="turn_to") {
+    Npc* t = target();
+    if(t==nullptr) {
+      fail("не вижу такого");
+      return;
+      }
+    if(name=="turn_to")
+      npc.aiPush(AiQueue::aiTurnToNpc(t));
+    npc.aiPush(AiQueue::aiLookAtNpc(t));
+    done("смотришь на цель");
+    return;
+    }
+  if(name=="leave_mob") {
+    if(npc.interactive()!=nullptr)
+      npc.aiPush(AiQueue::aiUseMob("",-1));
+    done("встал");
+    return;
+    }
+  if(name=="set_attitude") {
+    const std::string v = str(args,"value");
+    Attitude att = ATT_NEUTRAL;
+    if(v=="friendly")
+      att = ATT_FRIENDLY;
+    else if(v=="angry")
+      att = ATT_ANGRY;
+    else if(v=="hostile")
+      att = ATT_HOSTILE;
+    // «Враждебно» - злость, как у обиженного в скриптах игры (временное ATT_HOSTILE поверх постоянного «сердито»),
+    // а не постоянная вражда: постоянное ATT_HOSTILE у человека - бой насмерть (Npc::checkHealth: упавший умирает, а
+    // не теряет сознание; attackReason - AR_GuildEnemy с добиванием). Так герой убил Рауля, а жители - героя.
+    // Скрипты ставят его только перед AR_KILL (B_Attack)
+    npc.setAttitude(att==ATT_HOSTILE ? ATT_ANGRY : att);
+    npc.setTempAttitude(att);
+    done("отношение к герою: "+v);
+    return;
+    }
+  if(name=="wait") {
+    a.deadline = now+uint64_t(std::clamp<int64_t>(num(args,"seconds",3),1,60))*1000;
+    a.begun    = true;
+    acts.push_back(a);
+    return;
+    }
+  if(name=="end_conversation" && &npc==geralt) {
+    endDialog();
+    done("разговор окончен");
+    return;
+    }
+  fail("нет такого действия");
+  }
+
+std::string AiNpc::equip(Npc& npc, size_t sym, bool& ok) {
+  ok = false;
+  Item* it = npc.getItem(sym);
+  if(it==nullptr)
+    return "у тебя нет такого предмета";
+  const std::string name = fromCp1251(it->displayName());
+  if(!isWearable(*it))
+    return name+" не надеть: это не одежда, не оружие и не украшение (зелье и еду - use_item)";
+  if(it->isEquipped()) {
+    ok = true;
+    return name+" уже на тебе";
+    }
+  int32_t atr = 0, need = 0;
+  if(!it->checkCondUse(npc,atr,need))
+    return "не хватает "+std::string(attrName(atr))+" для «"+name+"»: нужно "+std::to_string(need)+
+           ", у тебя "+std::to_string(npc.attribute(Attribute(atr)));
+  // Меч в руке меняется на другой без анимации: убрать, надеть новый
+  if(isWeapon(*it) && npc.weaponState()!=WeaponState::NoWeapon)
+    npc.closeWeapon(true);
+  npc.useItem(sym,Item::NSLOT,true);
+  if(!it->isEquipped()) {
+    if(uint32_t(it->itemFlag()) & ITM_RING)
+      return "оба кольца уже надеты - сначала сними одно (unequip_item)";
+    return "не вышло надеть «"+name+"»";
+    }
+  ok = true;
+  const char* kind = itemKind(*it);
+  if(isWeapon(*it))
+    return "теперь твоё оружие: "+name+(std::string_view(kind)=="melee" || std::string_view(kind)=="melee2h" ? " (на поясе)" : " (за спиной)");
+  return "надел: "+name;
+  }
+
+std::string AiNpc::unequip(Npc& npc, size_t sym, bool& ok) {
+  ok = false;
+  Item* it = npc.getItem(sym);
+  if(it==nullptr)
+    return "у тебя нет такого предмета";
+  const std::string name = fromCp1251(it->displayName());
+  if(!it->isEquipped()) {
+    ok = true;
+    return name+" и так не надето";
+    }
+  if(isWeapon(*it) && npc.weaponState()!=WeaponState::NoWeapon)
+    npc.closeWeapon(true);
+  npc.unequipItem(sym);
+  ok = !it->isEquipped();
+  return ok ? "снял: "+name : "не вышло снять «"+name+"»";
+  }
+
+void AiNpc::beginBody(Action& a) {
+  Npc& npc = *a.actor;
+  const uint64_t now = owner.tickCount();
+  a.begun   = true;
+  a.started = now;
+  // Заново начатое состояние распорядка (лагерь на месте или ZS_Follow_Player) очищает очередь ИИ -
+  // движение кладётся в неё после. Житель при этом уходит от своего распорядка (запоминается - leaveRoutine)
+  auto restart = [&](bool party) {
+    leaveRoutine(npc);
+    setParty(npc,party);
+    npc.resumeAiRoutine();
+    };
+  // Дело по пути (подойти, подобрать, обыскать, сесть): идущий с героем из отряда не выходит - прежде любое такое
+  // дело (и подход к жителю перед talk_to_npc) выводило его из отряда, и он переставал идти строем. Отряд не ведёт
+  // его, пока дело не кончится (holdTo, снимается в finish), потом - снова в строй
+  const bool inSquad = owner.isHired(npc);
+  auto errand = [&](uint64_t ms) {
+    if(!inSquad) {
+      restart(false);
+      return;
+      }
+    npc.clearAiQueue();
+    npc.companionIdle            = Npc::CompanionIdle();
+    npc.companionFollow.holdTo   = now+ms;
+    npc.companionFollow.driving  = false;
+    };
+
+  if(a.name=="go_to_place") {
+    a.deadline = now+180000;
+    errand(180000);
+    npc.aiPush(AiQueue::aiGoToPoint(*a.wp));
+    }
+  else if(a.name=="go_to_npc" || a.name=="approach") {
+    a.deadline = now+90000;
+    errand(90000);
+    npc.aiPush(AiQueue::aiGoToNpc(a.target));
+    }
+  else if(a.name=="loot") {
+    a.deadline = now+40000;
+    errand(40000);
+    npc.aiPush(AiQueue::aiGoToNpc(a.target));
+    }
+  else if(a.name=="take_item") {
+    a.deadline = now+40000;
+    errand(40000);
+    npc.aiPush(AiQueue::aiGotoItem(*a.item));
+    npc.aiPush(AiQueue::aiTakeItem(*a.item));
+    }
+  else if(a.name=="use_mob") {
+    a.deadline = now+30000;
+    errand(30000);
+    npc.aiPush(AiQueue::aiUseMob(a.text,1));
+    }
+  else if(a.name=="attack") {
+    owner.invokeAttack(npc,*a.target,owner.attackReason(npc,*a.target));
+    a.deadline = now+120000;
+    }
+  else if(a.name=="follow_hero") {
+    restart(true);
+    Log::i("[g2m] ai: follow_hero \"",npc.displayName(),"\" squad=",owner.isHired(npc) ? 1 : 0,
+           " state=",npc.stateName());
+    finish(a,true,"идёшь за героем и защищаешь его (ты в его отряде)");
+    }
+  else if(a.name=="wait_here" || a.name=="stop_following") {
+    if(owner.isHired(npc)) {
+      // В отряде - как приказ «Ждать»: лагерь на месте, остаётся в отряде (полоска слева вверху, «Ко мне»)
+      npc.companionIdle = Npc::CompanionIdle();
+      owner.squadCamp(npc);
+      npc.resumeAiRoutine();
+      finish(a,true,"ждёшь героя здесь (ты в его отряде; позовёт - follow_hero)");
+      } else {
+      restart(false);
+      finish(a,true,"стоишь на месте");
+      }
+    }
+  else if(a.name=="stop_fight" && inSquad) {
+    // В отряде - к тому, что было: идти следом или ждать в лагере (распорядок отряда не трогаем)
+    npc.setTarget(nullptr);
+    npc.resumeAiRoutine();
+    npc.aiPush(AiQueue::aiRemoveWeapon());
+    finish(a,true,"ты прекратил бой");
+    }
+  else if(a.name=="stop_fight") {
+    npc.setTarget(nullptr);
+    if(&npc==geralt || owner.isPartyMember(npc) || npc.hasSavedRoutines())
+      restart(owner.isPartyMember(npc)); else
+      npc.resumeAiRoutine(); // житель - к своему распорядку
+    npc.aiPush(AiQueue::aiRemoveWeapon());
+    finish(a,true,"ты прекратил бой");
+    }
+  else if(a.name=="go_home") {
+    goHome(npc);
+    finish(a,true,&npc==geralt ? "идёшь обратно в кабак Корагона" : "вернулся к своим делам");
+    }
+  else if(a.name=="activity") {
+    leaveRoutine(npc);
+    setParty(npc,false);
+    setActivity(npc,a.text);
+    npc.resumeAiRoutine();
+    // Сидел на скамье или стуле (use_mob), а теперь стоит или занят другим - встать
+    if(npc.interactive()!=nullptr && a.mood!="sit_chair" && a.mood!="sit_bench")
+      npc.aiPush(AiQueue::aiUseMob("",-1));
+    finish(a,true,"занят: "+a.mood);
+    }
+  }
+
+void AiNpc::tickActions(uint64_t now) {
+  auto* w  = world();
+  for(size_t i=0; i<acts.size(); ++i) {
+    auto& a = acts[i];
+    if(a.closed)
+      continue;
+    if(a.actor==nullptr || !npcAlive(a.actor) || a.actor->isDead()) {
+      finish(a,false,"тебя больше нет");
+      continue;
+      }
+    Npc& npc = *a.actor;
+    if(!a.begun) {
+      // Ждёт конца разговора (не дольше 10 минут)
+      const bool inTalk = (&npc==geralt && talking) || npc.isTalk() || (&npc==geralt && w->isInDialog());
+      if(!inTalk)
+        beginBody(a);
+      else if(now>a.started+600000)
+        finish(a,false,"разговор так и не закончился");
+      continue;
+      }
+    if(npc.isDown()) {
+      finish(a,false,"тебя сбили с ног");
+      continue;
+      }
+    if(a.target!=nullptr && !npcAlive(a.target)) {
+      finish(a,false,"цель пропала");
+      continue;
+      }
+    if(a.name=="wait") {
+      if(now>=a.deadline)
+        finish(a,true,"подождал");
+      continue;
+      }
+    if(a.name=="go_to_place") {
+      if(a.wp!=nullptr && npc.qDistTo(a.wp)<300.f*300.f) {
+        npc.companionIdle.campPos = npc.position();
+        float d = 0;
+        finish(a,true,"пришёл: "+placeName(npc.position(),d));
+        }
+      }
+    else if(a.name=="go_to_npc" || a.name=="approach") {
+      if(npc.qDistTo(*a.target)<300.f*300.f) {
+        npc.companionIdle.campPos = npc.position();
+        npc.aiPush(AiQueue::aiTurnToNpc(a.target));
+        if(!a.target->isPlayer() && !a.target->isDown() && a.target->isAiQueueEmpty() && !a.target->isAttack())
+          a.target->aiPush(AiQueue::aiTurnToNpc(&npc));
+        finish(a,true,"подошёл к "+fromCp1251(a.target->displayName()));
+        }
+      }
+    else if(a.name=="attack") {
+      if(a.target->isDead())
+        finish(a,true,fromCp1251(a.target->displayName())+" мёртв(а)");
+      else if(a.target->isUnconscious())
+        finish(a,true,fromCp1251(a.target->displayName())+" без сознания");
+      else if(now>a.started+3000 && !npc.isAttack() && npc.weaponState()==WeaponState::NoWeapon)
+        finish(a,false,"бой прекратился");
+      }
+    else if(a.name=="take_item") {
+      bool still = false;
+      w->detectItem(npc.position(),ItemDist,[&](Item& it){ if(&it==a.item) still = true; });
+      if(!still) {
+        a.item = nullptr;
+        finish(a,true,"поднял: "+a.text);
+        }
+      }
+    else if(a.name=="use_mob") {
+      if(npc.interactive()!=nullptr)
+        finish(a,true,"используешь: "+a.mood);
+      }
+    else if(a.name=="loot") {
+      if(npc.qDistTo(*a.target)<250.f*250.f) {
+        // Забирает всё, что можно взять при обыске
+        std::vector<std::pair<size_t,size_t>> take;
+        for(auto it=a.target->inventory().iterator(Inventory::T_Ransack); it.isValid(); ++it)
+          take.emplace_back(it->clsId(),it.count());
+        std::string got;
+        for(auto& [cls,n]:take) {
+          npc.addItem(cls,*a.target,n);
+          if(got.size()<300)
+            got += (got.empty() ? "" : ", ")+itemNameUtf8(npc,cls)+(n>1 ? " x"+std::to_string(n) : std::string());
+          }
+        npc.aiPush(AiQueue::aiPlayAnim("T_PLUNDER"));
+        finish(a,true,got.empty() ? "ничего не нашёл" : "забрал: "+got);
+        }
+      }
+    if(!a.closed && now>a.deadline)
+      finish(a,false,"не вышло вовремя");
+    }
+  acts.erase(std::remove_if(acts.begin(),acts.end(),[](const Action& a){ return a.closed; }),acts.end());
+  }
+
+std::string AiNpc::refOf(Npc& npc) {
+  if(npc.isPlayer())
+    return "hero";
+  // self - тот, чьими глазами снимок (Геральт или житель); Геральт для жителя - обычный nN
+  if(&npc==(refSelf!=nullptr ? refSelf : geralt))
+    return "self";
+  auto it = npcRefs.find(&npc);
+  if(it!=npcRefs.end())
+    return "n"+std::to_string(it->second);
+  const uint32_t id = nextRef++;
+  npcRefs[&npc] = id;
+  npcByNum[id]  = &npc;
+  return "n"+std::to_string(id);
+  }
+
+std::string AiNpc::refOf(Item& itm) {
+  auto it = itmRefs.find(&itm);
+  if(it!=itmRefs.end())
+    return "i"+std::to_string(it->second);
+  const uint32_t id = nextRef++;
+  itmRefs[&itm] = id;
+  itmByNum[id]  = &itm;
+  return "i"+std::to_string(id);
+  }
+
+Npc* AiNpc::npcByRef(std::string_view ref) {
+  auto* w = world();
+  if(w==nullptr)
+    return nullptr;
+  if(ref=="hero")
+    return w->player();
+  if(ref=="self")
+    return refSelf!=nullptr ? refSelf : geralt;
+  if(ref.size()<2 || ref[0]!='n')
+    return nullptr;
+  const uint32_t id = uint32_t(std::strtoul(std::string(ref.substr(1)).c_str(),nullptr,10));
+  auto it = npcByNum.find(id);
+  if(it==npcByNum.end())
+    return nullptr;
+  // Указатель проверяется по списку мира: NPC мог исчезнуть
+  for(uint32_t i=0; i<w->npcCount(); ++i)
+    if(w->npcById(i)==it->second)
+      return w->npcById(i);
+  return nullptr;
+  }
+
+Item* AiNpc::itemByRef(std::string_view ref) {
+  auto* w = world();
+  Npc* me = refSelf!=nullptr ? refSelf : geralt;
+  if(w==nullptr || me==nullptr || ref.size()<2 || ref[0]!='i')
+    return nullptr;
+  const uint32_t id = uint32_t(std::strtoul(std::string(ref.substr(1)).c_str(),nullptr,10));
+  auto it = itmByNum.find(id);
+  if(it==itmByNum.end())
+    return nullptr;
+  Item* ret = nullptr;
+  w->detectItem(me->position(),ItemDist*2,[&](Item& i){ if(&i==it->second) ret = &i; });
+  return ret;
+  }
+
+std::string AiNpc::guildName(int32_t guild) {
+  auto* s = owner.findSymbol("TXT_GUILDS");
+  if(s==nullptr || guild<0 || uint32_t(guild)>=s->count())
+    return {};
+  return fromCp1251(s->get_string(uint16_t(guild)));
+  }
+
+std::string AiNpc::placeName(const Tempest::Vec3& pos, float& dist) {
+  auto* w = world();
+  dist = 0;
+  if(w==nullptr)
+    return {};
+  std::vector<TravelPoints::Spot> spots;
+  TravelPoints::resolve(*w,spots);
+  const TravelPoints::Spot* best = nullptr;
+  float bestD = 0;
+  for(auto& s:spots) {
+    if(s.at==nullptr || s.point==nullptr)
+      continue;
+    auto  d  = s.at->position() - pos;
+    float qd = d.x*d.x + d.y*d.y + d.z*d.z;
+    if(best==nullptr || qd<bestD) {
+      best  = &s;
+      bestD = qd;
+      }
+    }
+  if(best==nullptr)
+    return {};
+  dist = std::sqrt(bestD);
+  return best->point->name;
+  }
+
+void AiNpc::sendSnapshot(Npc& me, std::string_view reason) {
+  // Метка запроса - только буквы и цифры: вставляется в JSON как есть
+  std::string req;
+  for(char c:reason)
+    if(std::isalnum(uint8_t(c)) || c=='_')
+      req.push_back(c);
+  std::string head = "\"req\":\""+req+"\",";
+  // Снимок жителя - с пометкой, чей он: мозг Геральта не путает его со своим
+  if(&me!=geralt) {
+    refSelf = nullptr;
+    head += "\"actor\":\""+refOf(me)+"\",";
+    refSelf = &me;
+    }
+  AiLink::send(snapshot(me).insert(1,head));
+  }
+
+std::string AiNpc::snapshot(Npc& me) {
+  auto* w  = world();
+  Npc*  pl = w->player();
+
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"ev","snapshot");
+
+  const auto t = w->time();
+  char tm[16] = {};
+  std::snprintf(tm,sizeof(tm),"%02d:%02d",int(t.hour()),int(t.minute()));
+  put(j,"time",tm);
+  put(j,"day",int64_t(t.day()+1));
+  put(j,"talking",talking ? 1 : 0);
+
+  {
+  float d = 0;
+  auto  place = placeName(me.position(),d);
+  put(j,"place",place);
+  putMeters(j,"placeDist",d);
+  if(auto wp = w->findWayPoint(me.position()))
+    put(j,"waypoint",wp->name);
+  }
+
+  // Ближние места - куда можно пойти (go_to_place)
+  {
+  std::vector<TravelPoints::Spot> spots;
+  TravelPoints::resolve(*w,spots);
+  std::vector<std::pair<float,const TravelPoints::Spot*>> near;
+  for(auto& s:spots) {
+    if(s.at==nullptr || s.point==nullptr)
+      continue;
+    near.emplace_back(std::sqrt(me.qDistTo(s.at)),&s);
+    }
+  std::sort(near.begin(),near.end(),[](auto& a, auto& b){ return a.first<b.first; });
+  j.Key("places");
+  j.StartArray();
+  for(size_t i=0; i<near.size() && i<10; ++i) {
+    j.StartObject();
+    put(j,"name",near[i].second->point->name);
+    putMeters(j,"dist",near[i].first);
+    j.EndObject();
+    }
+  j.EndArray();
+  }
+
+  // Сам
+  j.Key("self");
+  j.StartObject();
+  put(j,"id",npcId(me));
+  put(j,"name",fromCp1251(me.displayName()));
+  if(&me!=geralt) {
+    put(j,"guild",guildName(int32_t(me.guild())));
+    put(j,"female",me.handle().voice==16 || me.handle().voice==17 ? 1 : 0);
+    put(j,"voice",me.handle().voice);
+    if(me.hasSavedRoutines())
+      put(j,"away",1); // ушёл от своего распорядка по просьбе (go_home - вернуться)
+    }
+  put(j,"hp",me.attribute(ATR_HITPOINTS));
+  put(j,"hpMax",me.attribute(ATR_HITPOINTSMAX));
+  put(j,"inParty",owner.isPartyMember(me) ? 1 : 0);
+  if(owner.isPartyMember(me) && owner.squadIsWaiting(me))
+    put(j,"waiting",1);
+  put(j,"down",me.isUnconscious() ? 1 : 0);
+  {
+  const char* ws = "убрано";
+  switch(me.weaponState()) {
+    case WeaponState::NoWeapon: ws = "убрано"; break;
+    case WeaponState::Fist:     ws = "кулаки"; break;
+    case WeaponState::W1H:
+    case WeaponState::W2H:      ws = "меч в руке"; break;
+    case WeaponState::Bow:
+    case WeaponState::CBow:     ws = "лук"; break;
+    case WeaponState::Mage:     ws = "магия"; break;
+    }
+  put(j,"weapon",ws);
+  }
+  if(me.isAttack())
+    put(j,"fighting",1);
+  if(auto* mob = me.interactive())
+    put(j,"using",fromCp1251(mob->displayName()));
+  put(j,"str",me.attribute(ATR_STRENGTH));
+  put(j,"dex",me.attribute(ATR_DEXTERITY));
+  j.Key("items");
+  j.StartArray();
+  for(auto it=me.inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it)
+    putItem(j,itemId(*it),*it,it.count(),me);
+  j.EndArray();
+  j.EndObject();
+
+  // Герой
+  j.Key("hero");
+  j.StartObject();
+  putMeters(j,"dist",dist(*pl,me));
+  put(j,"side",sideOf(me,pl->position()));
+  put(j,"hp",pl->attribute(ATR_HITPOINTS));
+  put(j,"hpMax",pl->attribute(ATR_HITPOINTSMAX));
+  put(j,"level",pl->level());
+  put(j,"guild",guildName(int32_t(pl->guild())));
+  if(auto* ar = pl->currentArmor())
+    put(j,"armor",fromCp1251(ar->displayName()));
+  if(auto* mw = pl->currentMeleeWeapon())
+    put(j,"melee",fromCp1251(mw->displayName()));
+  if(auto* rw = pl->currentRangedWeapon())
+    put(j,"ranged",fromCp1251(rw->displayName()));
+  put(j,"weaponDrawn",pl->weaponState()!=WeaponState::NoWeapon ? 1 : 0);
+  put(j,"sees",me.canSeeNpc(*pl,false) ? 1 : 0);
+  {
+  // Злость «враждебно» (set_attitude hostile) - временное отношение поверх постоянного «сердито»
+  auto att = owner.personAttitude(me,*pl);
+  if(att==ATT_ANGRY && me.tempAttitude()==ATT_HOSTILE)
+    att = ATT_HOSTILE;
+  put(j,"attitude",attitudeName(att));
+  }
+  j.EndObject();
+
+  // Кто рядом
+  std::vector<std::pair<float,Npc*>> npcs;
+  w->detectNpc(me.position(),SeeDist,[&](Npc& n){
+    if(&n==&me || n.isPlayer())
+      return;
+    npcs.emplace_back(std::sqrt(me.qDistTo(n)),&n);
+    });
+  std::sort(npcs.begin(),npcs.end(),[](auto& a, auto& b){ return a.first<b.first; });
+  j.Key("npcs");
+  j.StartArray();
+  for(size_t i=0; i<npcs.size() && i<14; ++i) {
+    Npc& n = *npcs[i].second;
+    j.StartObject();
+    put(j,"ref",refOf(n));
+    put(j,"id",npcId(n));
+    put(j,"name",fromCp1251(n.displayName()));
+    if(!n.isMonster()) {
+      put(j,"guild",guildName(int32_t(n.guild())));
+      put(j,"female",n.handle().voice==16 || n.handle().voice==17 ? 1 : 0);
+      put(j,"voice",n.handle().voice);
+      putLooks(j,n);
+      if(!n.isDead())
+        put(j,"att",attitudeName(owner.personAttitude(n,me))); // как он относится к тебе
+      if(owner.isHired(n))
+        put(j,"party",1);
+      } else {
+      put(j,"monster",1);
+      }
+    putMeters(j,"dist",npcs[i].first);
+    put(j,"side",sideOf(me,n.position()));
+    const int32_t hmax = std::max(1,n.attribute(ATR_HITPOINTSMAX));
+    put(j,"hp%",int64_t(n.attribute(ATR_HITPOINTS))*100/hmax);
+    const char* st = "";
+    if(n.isDead())
+      st = "мёртв";
+    else if(n.isUnconscious())
+      st = "без сознания";
+    else if(n.isAttack())
+      st = "дерётся";
+    else if(n.isTalk())
+      st = "разговаривает";
+    else if(n.hasState(BS_SIT))
+      st = "сидит";
+    else if(n.hasState(BS_LIE))
+      st = "лежит";
+    if(*st)
+      put(j,"state",st);
+    if(!n.isDead() && owner.personAttitude(n,me)==ATT_HOSTILE)
+      put(j,"hostile",1);
+    if(auto* tg = n.target(); tg!=nullptr && n.isAttack())
+      put(j,"fights",refOf(*tg));
+    put(j,"seen",me.canSeeNpc(n,false) ? 1 : 0);
+    j.EndObject();
+    }
+  j.EndArray();
+
+  // Предметы на земле
+  std::vector<std::pair<float,Item*>> items;
+  w->detectItem(me.position(),ItemDist,[&](Item& it){
+    items.emplace_back(std::sqrt(me.qDistTo(it)),&it);
+    });
+  std::sort(items.begin(),items.end(),[](auto& a, auto& b){ return a.first<b.first; });
+  j.Key("ground");
+  j.StartArray();
+  for(size_t i=0; i<items.size() && i<10; ++i) {
+    j.StartObject();
+    put(j,"ref",refOf(*items[i].second));
+    put(j,"name",fromCp1251(items[i].second->displayName()));
+    putMeters(j,"dist",items[i].first);
+    j.EndObject();
+    }
+  j.EndArray();
+
+  // Предметы мира: скамьи, костры, сундуки, наковальни (use_mob)
+  j.Key("mobs");
+  j.StartArray();
+  {
+  std::vector<std::pair<float,Interactive*>> mobs;
+  for(uint32_t i=0; ; ++i) {
+    auto* m = w->mobsiById(i);
+    if(m==nullptr)
+      break;
+    auto  d  = m->displayPosition() - me.position();
+    float qd = d.x*d.x+d.y*d.y+d.z*d.z;
+    if(qd<MobDist*MobDist)
+      mobs.emplace_back(std::sqrt(qd),m);
+    }
+  std::sort(mobs.begin(),mobs.end(),[](auto& a, auto& b){ return a.first<b.first; });
+  std::vector<std::string> seen;
+  size_t n = 0;
+  for(auto& [d,m]:mobs) {
+    std::string sc(m->schemeName());
+    if(sc.empty() || std::find(seen.begin(),seen.end(),sc)!=seen.end())
+      continue;
+    seen.push_back(sc);
+    j.StartObject();
+    put(j,"scheme",sc);
+    put(j,"name",fromCp1251(m->displayName()));
+    putMeters(j,"dist",d);
+    if(m->isContainer())
+      put(j,"container",1);
+    j.EndObject();
+    if(++n>=8)
+      break;
+    }
+  }
+  j.EndArray();
+
+  // Сюжет игры: темы диалогов жителя, которые герою доступны сейчас, начатый выбор, задания героя (story_topic)
+  if(&me!=geralt && !me.isMonster() && !me.isDead() && dist(*pl,me)<2000.f) {
+    const std::string story = storyJson(*pl,me);
+    j.Key("story");
+    j.RawValue(story.c_str(),story.size(),rapidjson::kObjectType);
+    }
+
+  j.EndObject();
+  return buf.GetString();
+  }
+
+// ---------------- Сюжет игры в разговоре ----------------
+
+namespace {
+  // Слов жителя в подсказке темы (до того, как её сыграли) - не больше; итог темы - целиком
+  const size_t StoryPreviewMax = 420;
+  const size_t StoryTopicsMax  = 16;
+
+  std::string cutUtf8(std::string s, size_t max) {
+    if(s.size()<=max)
+      return s;
+    size_t n = max;
+    while(n>0 && (uint8_t(s[n]) & 0xC0)==0x80)
+      --n;
+    s.resize(n);
+    return s+"…";
+    }
+  }
