+void TouchInput::onTimer() {
+  const uint64_t now  = Application::tickCount();
+  bool           busy = false;
+  for(size_t i=0; i<fingers.size(); ++i) {
+    auto& f = fingers[i];
+    if(f.ctl==C_None || f.held)
+      continue;
+    // Долгое нажатие: колесо оружия, зелье маны, быстрое сохранение
+    if(f.ctl==C_Weapon && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=300) {
+        f.held = true;
+        if(wheel==Wheel::None)
+          openWheel(Wheel::Weapon, int(i));
+        }
+      }
+    if(f.ctl==C_Potion && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=450 && ctrl.potionCount(true)>0) {
+        f.held = true;
+        ctrl.drinkManaPotion();
+        }
+      }
+    if(f.ctl==C_Menu && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=700) {
+        f.held = true;
+        owner.touchQuickSave();
+        }
+      }
+    }
+
+  if(repeatCtl!=C_None) {
+    busy = true;
+    if(now>=repeatNext) {
+      repeatNext = now+120;
+      sendNav(repeatCtl);
+      }
+    }
+  if(!busy)
+    timer.stop();
+  update();
+  }
+
+void TouchInput::sendNav(Ctl c) {
+  switch(c) {
+    case C_Up:    owner.touchKey(Event::K_Up);    break;
+    case C_Down:  owner.touchKey(Event::K_Down);  break;
+    case C_Left:  owner.touchKey(Event::K_Left);  break;
+    case C_Right: owner.touchKey(Event::K_Right); break;
+    default: break;
+    }
   }
