+// Gothic II Mobile: напарники.
+// В диалоге с безымянным человеком (NPCTYPE_*AMBIENT) - «Пойдём со мной». Нанятый получает флаг
+// AIV_PARTYMEMBER и распорядок TA_Follow_Player на весь день, как напарники из скриптов игры:
+// ZS_Follow_Player сам дерётся с врагами, а опыт за убитых им ZS_Dead отдаёт герою.
+// Цена - 10 золотых за уровень, напарник называет её озвученной фразой ($GOLD_*).
+
+static const size_t MaxHired = 3;
+// Приказ «не нападать» хранится в свободной ячейке aivar (скрипты игры используют 0..80 и 88):
+// сохраняется и загружается вместе с NPC
+static const size_t AivStance = 95;
+
+static bool isAmbient(const zenkit::INpc& h) {
+  switch(h.type) {
+    case zenkit::NpcType::G2_AMBIENT:
+    case zenkit::NpcType::G2_OC_AMBIENT:
+    case zenkit::NpcType::G2_BL_AMBIENT:
+    case zenkit::NpcType::G2_TAL_AMBIENT:
+      return true;
+    default:
+      return false;
+    }
+  }
+
+int32_t GameScript::scriptConst(std::string_view name, int32_t def) {
+  auto* s = vm.find_symbol_by_name(name);
+  return s!=nullptr ? s->get_int() : def;
+  }
+
+bool GameScript::isPartyMember(Npc& npc) {
+  const int32_t id = scriptConst("AIV_PARTYMEMBER",15);
+  return id>=0 && uint32_t(id)<zenkit::INpc::aivar_count && npc.handle().aivar[size_t(id)]!=0;
+  }
+
+bool GameScript::isHired(Npc& npc) {
+  // Призванные монстры и сюжетные напарники - тоже AIV_PARTYMEMBER, но у них свои скрипты
+  auto& h = npc.handle();
+  return isAmbient(h) && h.guild<GIL_SEPERATOR_HUM && isPartyMember(npc);
+  }
+
+size_t GameScript::hiredCount() {
+  auto&  w = world();
+  size_t n = 0;
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc!=nullptr && !npc->isDead() && isHired(*npc))
+      ++n;
+    }
+  return n;
+  }
+
+int32_t GameScript::hirePrice(Npc& npc) const {
+  // Шаг цены - как у озвученных сумм: до 100 - по 10, дальше - по 50
+  int32_t p = std::clamp(npc.handle().level*10, 10, 1000);
+  if(p<=100)
+    p = (p+9)/10*10; else
+    p = (p+49)/50*50;
+  return std::min(p,1000);
+  }
+
+void GameScript::companionSay(Npc& npc, Npc& player, std::string_view svm) {
+  npc.aiPush(AiQueue::aiOutputSvm(player,svm,aiOutOrderId));
+  ++aiOutOrderId;
+  }
+
+void GameScript::companionChoices(Npc& player, Npc& npc, std::vector<DlgChoice>& out) {
+  if(Gothic::inst().version().game!=2 || &player==&npc || npc.isDown())
+    return;
+  auto& h = npc.handle();
+  if(!isAmbient(h) || h.guild>=GIL_SEPERATOR_HUM)
+    return;
+
+  auto add = [&out](uint32_t id, const std::string& title) {
+    DlgChoice ch;
+    ch.title    = title;
+    ch.scriptFn = id;
+    ch.sort     = 998; // перед «Конец» (nr 999)
+    out.push_back(std::move(ch));
+    };
+
+  if(isHired(npc)) {
+    if(npc.hasRoutineState(findSymbolIndex("ZS_FOLLOW_PLAYER")))
+      add(CompanionWait,  toCp1251("Подожди меня здесь."));
+    else
+      add(CompanionFollow,toCp1251("Пойдём дальше вместе."));
+    add(CompanionDismiss, toCp1251("Дальше я сам. Спасибо за помощь!"));
+    return;
+    }
+
+  if(isPartyMember(npc))
+    return;
+  const auto att = personAttitude(npc,player);
+  if(att==ATT_HOSTILE || att==ATT_ANGRY)
+    return;
+  // Стража у прохода остаётся на посту: иначе ворота открылись бы сами
+  if(npc.hasRoutineState(findSymbolIndex("ZS_GUARD_PASSAGE")))
+    return;
+  if(hiredCount()>=MaxHired)
+    return;
+
+  const int32_t price = hirePrice(npc);
+  add(CompanionHire, toCp1251("Пойдём со мной — поможешь в бою? (") + std::to_string(price) + toCp1251(" золотых)"));
+  }
+
+void GameScript::execCompanion(const DlgChoice& dlg, Npc& player, Npc& npc) {
+  auto& h        = npc.handle();
+  const int32_t aivParty  = scriptConst("AIV_PARTYMEMBER",15);
+  const size_t  zsFollow  = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  auto          setParty  = [&](bool v) {
+    if(aivParty>=0 && uint32_t(aivParty)<zenkit::INpc::aivar_count)
+      h.aivar[size_t(aivParty)] = v ? 1 : 0;
+    };
+  auto          follow    = [&]() {
+    if(zsFollow==size_t(-1))
+      return;
+    auto wp = npc.currentTaPoint();
+    npc.setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+    };
+  auto          endTalk   = [&]() {
+    npc.aiPush(AiQueue::aiStopProcessInfo(aiOutOrderId));
+    ++aiOutOrderId;
+    };
+
+  switch(dlg.scriptFn) {
+    case CompanionHire: {
+      const size_t  gold  = findSymbolIndex("ITMI_GOLD");
+      const int32_t price = hirePrice(npc);
+      if(gold==size_t(-1) || player.itemCount(gold)<size_t(price)) {
+        // Называет цену своим голосом и ждёт денег; диалог продолжается
+        companionSay(npc,player,string_frm("$GOLD_",int(price)));
+        return;
+        }
+      npc.addItem(gold,player,size_t(price));
+      companionSay(npc,player,"$ITookYourGold");
+      setParty(true);
+      // Новичок слушает тот же приказ, что и остальной отряд
+      setStance(npc,squadPassive());
+      follow();
+      Tempest::Log::i("[g2m] companion: hired \"",npc.displayName(),"\" level=",h.level," price=",price);
+      endTalk();
+      break;
+      }
+    case CompanionWait: {
+      const size_t zsStand = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+      auto         wp      = world().findWayPoint(npc.position());
+      if(zsStand!=size_t(-1) && wp!=nullptr)
+        npc.setRoutineAllDay(zsStand, wp->name);
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+      }
+    case CompanionFollow:
+      follow();
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+    case CompanionDismiss:
+      setParty(false);
+      h.aivar[AivStance] = 0;
+      if(h.daily_routine>0)
+        npc.excRoutine(size_t(h.daily_routine));
+      companionSay(npc,player,"$ABS_GOOD");
+      Tempest::Log::i("[g2m] companion: dismissed \"",npc.displayName(),"\"");
+      endTalk();
+      break;
+    default:
+      break;
+    }
+  }
+
+bool GameScript::isPassive(Npc& npc) {
+  return npc.handle().aivar[AivStance]!=0;
+  }
+
+void GameScript::setStance(Npc& npc, bool passive) {
+  npc.handle().aivar[AivStance] = passive ? 1 : 0;
+  }
+
+void GameScript::squadMembers(std::vector<Npc*>& out) {
+  out.clear();
+  auto& w = world();
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc!=nullptr && !npc->isDead() && isHired(*npc))
+      out.push_back(npc);
+    }
+  }
+
+bool GameScript::squadPassive() {
+  std::vector<Npc*> sq;
+  squadMembers(sq);
+  for(auto i:sq)
+    if(isPassive(*i))
+      return true;
+  return false;
+  }
+
+bool GameScript::squadIsWaiting(Npc& npc) {
+  return !npc.hasRoutineState(findSymbolIndex("ZS_FOLLOW_PLAYER"));
+  }
+
+bool GameScript::squadCanFight(Npc& enemy) {
+  if(enemy.isDown() || enemy.isPlayer() || isPartyMember(enemy))
+    return false;
+  if(enemy.guild()>GIL_SEPERATOR_HUM)
+    return true;
+  auto& h = enemy.handle();
+  // Арена и поединки из диалога (AR_NONE) герой выигрывает сам: иначе скрипты не засчитают победу
+  // (AIV_DefeatedByPlayer, дуэли наёмников)
+  const int32_t aivArena  = scriptConst("AIV_ARENAFIGHT",45);
+  const int32_t afRunning = scriptConst("AF_RUNNING",1);
+  if(aivArena>=0 && uint32_t(aivArena)<zenkit::INpc::aivar_count && h.aivar[size_t(aivArena)]==afRunning)
+    return false;
+  const int32_t aivReason = scriptConst("AIV_ATTACKREASON",9);
+  if(aivReason>=0 && uint32_t(aivReason)<zenkit::INpc::aivar_count && h.aivar[size_t(aivReason)]==scriptConst("AR_NONE",0))
+    return false;
+  return true;
+  }
+
+int32_t GameScript::attackReason(Npc& npc, Npc& enemy) {
+  // Зверь - как в скриптах (AR_MonsterVsHuman). Враг по гильдии - насмерть (AR_GuildEnemy), остальных
+  // людей напарник только сбивает с ног (AR_GuardStopsFight): сюжетные NPC не погибнут от его руки
+  if(enemy.guild()>GIL_SEPERATOR_HUM)
+    return scriptConst("AR_MONSTERVSHUMAN",4);
+  if(personAttitude(npc,enemy)==ATT_HOSTILE)
+    return scriptConst("AR_GUILDENEMY",14);
+  return scriptConst("AR_GUARDSTOPSFIGHT",12);
+  }
+
+Npc* GameScript::squadEnemy(Npc& npc, Npc& player, bool following) {
+  // Тот, кто бьёт героя или напарника. Следующий за героем вступается в радиусе 15 м,
+  // ждущий на месте - только за тех, кто рядом с ним
+  const float range = following ? 1500.f : 800.f;
+  Npc*        ret   = nullptr;
+  float       best  = 0;
+  world().detectNpc(npc.position(), range, [&](Npc& o) {
+    if(&o==&npc || &o==&player || !o.isAttack())
+      return;
+    auto tg = o.target();
+    if(tg==nullptr || (tg!=&player && !isHired(*tg)))
+      return;
+    if(!squadCanFight(o))
+      return;
+    if(following && player.qDistTo(o)>1500.f*1500.f)
+      return;
+    const float qd = npc.qDistTo(o);
+    if(ret==nullptr || qd<best) {
+      ret  = &o;
+      best = qd;
+      }
+    });
+  return ret;
+  }
+
+void GameScript::tickSquad() {
+  if(Gothic::inst().version().game!=2)
+    return;
+  auto& w  = world();
+  auto* pl = w.player();
+  if(pl==nullptr)
+    return;
+  const uint64_t now = tickCount();
+  if(now<squadTickTime)
+    return;
+  squadTickTime = now+400;
+
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc==nullptr || npc->isDown() || !isHired(*npc))
+      continue;
+    if(isPassive(*npc)) {
+      // Сам не начинает: ни врагов вокруг, ни чужих драк. Перцепции заново включает каждое
+      // новое состояние распорядка - поэтому каждый раз
+      npc->setPerceptionDisable(PERC_ASSESSENEMY);
+      npc->setPerceptionDisable(PERC_ASSESSFIGHTSOUND);
+      continue;
+      }
+    if(npc->isAttack() || npc->isTalk())
+      continue;
+    const bool following = npc->hasRoutineState(zsFollow);
+    if(auto enemy = squadEnemy(*npc,*pl,following)) {
+      const int32_t ar = attackReason(*npc,*enemy);
+      Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" defends against \"",enemy->displayName(),"\" ar=",ar);
+      invokeAttack(*npc,*enemy,ar);
+      }
+    }
+  }
+
+void GameScript::squadOrder(SquadOrder ord, Npc* target) {
+  auto* pl = world().player();
+  if(pl==nullptr)
+    return;
+  std::vector<Npc*> sq;
+  squadMembers(sq);
+  if(sq.empty())
+    return;
+
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  const size_t zsStand  = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+  // Отвечает голосом один - ближайший, а не хор
+  Npc* voice = nullptr;
+  for(auto npc:sq)
+    if(!npc->isDown() && (voice==nullptr || pl->qDistTo(*npc)<pl->qDistTo(*voice)))
+      voice = npc;
+
+  size_t done = 0;
+  for(auto npc:sq) {
+    if(npc->isDown() || npc->isTalk())
+      continue;
+    auto& h = npc->handle();
+    switch(ord) {
+      case SquadOrder::Follow: {
+        if(zsFollow==size_t(-1))
+          break;
+        auto wp = npc->currentTaPoint();
+        npc->setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+        // Бросить бой и идти к герою
+        npc->clearAiQueue();
+        npc->setTarget(nullptr);
+        npc->resumeAiRoutine();
+        ++done;
+        break;
+        }
+      case SquadOrder::Wait: {
+        auto wp = world().findWayPoint(npc->position());
+        if(zsStand==size_t(-1) || wp==nullptr)
+          break;
+        npc->setRoutineAllDay(zsStand, wp->name);
+        if(!npc->isAttack()) {
+          npc->clearAiQueue();
+          npc->resumeAiRoutine();
+          }
+        ++done;
+        break;
+        }
+      case SquadOrder::Attack: {
+        if(target==nullptr || target==npc || target->isDown() || isHired(*target) || target->isPlayer())
+          break;
+        invokeAttack(*npc,*target,attackReason(*npc,*target));
+        ++done;
+        break;
+        }
+      case SquadOrder::Passive: {
+        setStance(*npc,true);
+        npc->setPerceptionDisable(PERC_ASSESSENEMY);
+        npc->setPerceptionDisable(PERC_ASSESSFIGHTSOUND);
+        if(npc->isAttack()) {
+          // Начатый бой бросают
+          npc->clearAiQueue();
+          npc->setTarget(nullptr);
+          npc->resumeAiRoutine();
+          }
+        ++done;
+        break;
+        }
+      case SquadOrder::Defend: {
+        setStance(*npc,false);
+        // Состояние распорядка заново включит перцепции врагов и драк
+        if(!npc->isAttack()) {
+          npc->clearAiQueue();
+          npc->resumeAiRoutine();
+          }
+        ++done;
+        break;
+        }
+      }
+    }
+
+  if(done==0)
+    return;
+  if(voice!=nullptr && ord!=SquadOrder::Attack)
+    companionSay(*voice,*pl,"$ABS_GOOD");
+  static const char* names[] = {"follow", "wait", "attack", "passive", "defend"};
+  Tempest::Log::i("[g2m] squad: order=",names[int(ord)]," members=",int(done),
+                  target!=nullptr ? " target=" : "", target!=nullptr ? target->displayName() : "");
+  }
