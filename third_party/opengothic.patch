+void Ragdoll::breathe(std::vector<Matrix4x4>& bones, float inhale, float gasp) const {
+  // Дыхание лежащего - на выводе позы, без физики: грудь и живот поднимаются (на спине - вверх, на животе - спина),
+  // плечи и голова чуть следом; судорожный вдох умирающего - глубже, плечи к голове, голова запрокидывается.
+  // Кости рук ниже локтя и ноги не двигаются - тело лежит, как лежало
+  if(!lay->humanoid || lay->spineChain.empty() || bones.size()<lay->parts.size() || inhale<=0.f)
+    return;
+  const Matrix4x4& cm  = bones[lay->chest];
+  const Vec3       cf  = chestFront(cm);
+  const Vec3       dir = cf.y>=-0.2f ? cf : cf*-1.f;
+  Vec3             up  = originOf(cm)-originOf(bones[0]);
+  up = up.length()>1e-3f ? Vec3::normalize(up) : Vec3(0,1,0);
+  const float k    = lay->size/180.f;
+  const float amp  = inhale*(1.1f + 1.3f*gasp)*k; // см
+  const float lift = inhale*gasp*1.2f*k;          // плечи к голове, см
+  auto shift = [&bones](size_t i, const Vec3& v) {
+    if(i>=bones.size())
+      return;
+    auto& m = bones[i];
+    m.set(3,0,m.at(3,0)+v.x);
+    m.set(3,1,m.at(3,1)+v.y);
+    m.set(3,2,m.at(3,2)+v.z);
+    };
+  const float n = float(lay->spineChain.size());
+  for(size_t i=0; i<lay->spineChain.size(); ++i) {
+    const float a = float(i+1)/n;
+    shift(lay->spineChain[i], dir*(amp*(0.55f+0.45f*a)) + up*(lift*a));
+    }
+  for(int s=0; s<2; ++s) {
+    shift(lay->upper[s], dir*(amp*0.35f) + up*(lift*0.8f));
+    shift(lay->fore [s], dir*(amp*0.1f)  + up*(lift*0.3f));
+    }
+  if(lay->neck!=size_t(-1))
+    shift(lay->neck, dir*(amp*0.7f) + up*lift);
+  if(lay->head!=size_t(-1)) {
+    shift(lay->head, dir*(amp*0.5f) + up*lift);
+    // судорожный вдох: подбородок вверх
+    const float a = -deg(9.f)*inhale*gasp;
+    if(a!=0.f) {
+      const Vec3 left = Vec3::crossProduct(up,cf);
+      if(left.length()>1e-3f)
+        LimbIk::rotateAround(bones[lay->head], originOf(bones[lay->head]), Vec3::normalize(left), a);
+      }
+    }
+  }
