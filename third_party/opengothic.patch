+void TouchInput::loadLayout() {
+  // Строки: «scale 1.1», «alpha 0.8», «btn potion 12.5 -30 1.2» (сдвиг в dp, размер)
+  std::FILE* f = std::fopen("touch_layout.ini","r");
+  if(f==nullptr)
+    return;
+  char line[128] = {};
+  while(std::fgets(line,sizeof(line),f)!=nullptr) {
+    char  key[32] = {};
+    float a = 0, b = 0, k = 1;
+    if(std::sscanf(line,"scale %f",&a)==1)
+      layScale = std::clamp(a,0.6f,1.6f);
+    else if(std::sscanf(line,"alpha %f",&a)==1)
+      layAlpha = std::clamp(a,0.3f,1.f);
+    else if(std::sscanf(line,"btn %31s %f %f %f",key,&a,&b,&k)==4) {
+      for(uint8_t i=C_Main; i<C_Count; ++i) {
+        if(!isMovable(Ctl(i)) || std::strcmp(key,ctlKey(Ctl(i)))!=0)
+          continue;
+        place[i].dx    = std::clamp(a,-2000.f,2000.f);
+        place[i].dy    = std::clamp(b,-2000.f,2000.f);
+        place[i].scale = std::clamp(k,0.6f,1.8f);
+        }
+      }
+    }
+  std::fclose(f);
+  }
+
+void TouchInput::saveLayout() const {
+  // Во временный файл и замена одним шагом: оборванная запись не портит раскладку
+  std::FILE* f = std::fopen("touch_layout.ini.tmp","w");
+  if(f==nullptr) {
+    Tempest::Log::e("[g2m] touch layout: unable to save");
+    return;
+    }
+  std::fprintf(f,"scale %.3f\nalpha %.3f\n",double(layScale),double(layAlpha));
+  for(uint8_t i=C_Main; i<C_Count; ++i) {
+    const auto& pl = place[i];
