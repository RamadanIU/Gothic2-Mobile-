+void TouchInput::drawWheel(Painter& p) {
+  const auto  c  = wheelCenter();
+  const int   R  = wheelRadius();
+  const float d  = dp();
+  const int   ds = int(float(2*R)/0.88f);
+  auto&       bg = icons.disc(ds);
+  p.setBrush(Brush(bg,Color(1.f,1.f,1.f,0.95f)));
+  p.drawRect(c.x-ds/2, c.y-ds/2, ds, ds, 0,0,bg.w(),bg.h());
+
+  const int ir = int(23*d);
+  for(size_t i=0; i<wheelItems.size(); ++i) {
+    const auto& it  = wheelItems[i];
+    Button      b;
+    b.c = wheelItemPos(i);
+    b.r = ir;
+    const bool sel = int(i)==wheelSel;
+    drawRound(p, b, it.icon, sel, it.current, it.enabled ? 1.f : 0.45f);
+    const auto txt = fit(it.label, int(80*d), 0.8f);
+    drawLabel(p, txt, Point(b.c.x, b.c.y+ir+int(9*d)), sel, 0.8f);
+    }
+
+  // В центре - полное название того, что выберется
+  std::string title;
+  if(wheelSel>=0 && size_t(wheelSel)<wheelItems.size())
+    title = wheelItems[size_t(wheelSel)].label;
+  else
+    title = toCp1251(wheel==Wheel::Weapon ? "Оружие" : "Отряд");
+  drawLabel(p, fit(title, int(float(R)*0.95f), 1.f), c, true, 1.f);
+  }
