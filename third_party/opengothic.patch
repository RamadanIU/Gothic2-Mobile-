+  if(state==State::Closed || state==State::LockPicking)
+    return;
+  for(int i=0; i<rows; ++i)
+    moveDown();
+  for(int i=0; i<-rows; ++i)
+    moveUp();
+  adjustScroll();
+  update();
+  }
