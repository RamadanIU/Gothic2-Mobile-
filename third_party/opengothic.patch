+  ch.handle   = &info;
+  StoryCapture* prevCap    = storyCapture;
+  const Npc*    prevTalker = storyTalker;
+  storyCapture = &cap;
+  storyTalker  = &npc;
+  exec(ch,player,npc);
+  storyCapture = prevCap;
+  storyTalker  = prevTalker;
+  }
