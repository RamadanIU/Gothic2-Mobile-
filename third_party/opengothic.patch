@@ -0,0 +1,73 @@
+#pragma once
+
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <random>
+#include <vector>
+
+class Camera;
+class Npc;
+class WayPoint;
+
+// Gothic II Mobile: камера в пути («Путь» бегом, docs/CONTROLS.md). Герой бежит сам - камера его не ведёт:
+// палец крутит её вокруг героя, а ракурс выбирается кнопкой: свободная, издалека, сверху, сбоку, от первого
+// лица и «кино» - планы сменяются сами, как повторы в гонках (погоня, спереди, сбоку, кран, сверху, низкий
+// план, камера у дороги, мимо которой герой пробегает). Откуда и куда смотреть - в Camera::setDirector.
+class TravelCamera final {
+  public:
+    enum Mode : uint8_t {
+      M_Free,
+      M_Far,
+      M_Bird,
+      M_Side,
+      M_FirstPerson,
+      M_Cinema,
+      M_Count
+      };
+
+    static const char* name(Mode m); // UTF-8
+
+    Mode mode() const { return cur; }
+    void setMode(Mode m);
+    // Новый путь: курс - куда смотрит герой, без поворотов пальцем
+    void start(const Npc& pl);
+    // Снова в кадре после разговора или сумки - склейка, без перелёта
+    void resume();
+    // Палец: поворот вокруг героя, градусы
+    void look(float dx, float dy);
+    // Каждый кадр. path/idx - путь бегом и сколько пройдено (камера у дороги ставится впереди по нему)
+    void tick(Camera& cam, const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, uint64_t dt);
+
+  private:
+    enum Shot : uint8_t {
+      S_Chase,
+      S_Front,
+      S_SideL,
+      S_SideR,
+      S_Crane,
+      S_Bird,
+      S_Low,
+      S_Track,
+      S_Count
+      };
+
+    Mode          cur      = M_Free;
+    float         heading  = 0;     // курс героя, градусы (как Npc::rotation), сглаженный
+    float         yawOff   = 0;     // поворот пальцем
+    float         pitchOff = 0;
+    Tempest::Vec3 lastPos;
+    bool          hasLast  = false;
+    bool          cut      = true;
+
+    Shot          shot     = S_Chase;
+    float         shotT    = 0;     // сколько идёт план, с
+    float         shotLen  = 0;
+    float         shotNear = 1e9f;  // камера у дороги: ближе всего герой подбегал, см
+    Tempest::Vec3 trackPos;
+    std::minstd_rand rng;
+
+    void          nextShot(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx);
+    bool          findTrackside(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, Tempest::Vec3& out);
+    Tempest::Vec3 orbit(const Tempest::Vec3& at, float yaw, float pitch, float dist) const;
+  };
