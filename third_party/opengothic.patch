+  const auto ws = pl->weaponState();
+  if(ws==WeaponState::NoWeapon)
+    return;
+  const zenkit::IFocus* fc = &w->script().focusMelee();
+  if(ws==WeaponState::Bow || ws==WeaponState::CBow)
+    fc = &w->script().focusRange();
+  else if(ws==WeaponState::Mage)
+    fc = &w->script().focusMage();
+  const float range = std::max(fc->npc_range2, 300.f);
+  if(pl->qDistTo(*tg)<=range*range && !tg->isDown())
+    currentFocus = Focus(*tg);
+  }
