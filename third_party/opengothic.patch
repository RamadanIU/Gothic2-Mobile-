+
+const float Pi           = 3.14159265f;
+
+// Время сцены (реальное время, секунды) и замедление мира
+const float HitStopLen   = 0.07f;  // «стоп-кадр» в миг удара: мир почти стоит
+const float HitStopScale = 0.03f;
+const float SlowInLen    = 0.3f;   // после стоп-кадра - плавно к замедлению
+const float ArrowRealLen = 1.5f;   // полёт стрелы на экране (замедление - сразу: камера и так склейкой за стрелой)
+const float MinHoldReal  = 1.2f;   // падение - не короче
+const float MaxHoldReal  = 3.6f;   // и не дольше (с камерой со стороны)
+const float MaxHoldPlain = 2.2f;   // без неё
+const float FxIn         = 0.2f;   // цвет, звук, полосы - нарастают за это время
+
+// Стрела
+const float MaxArrowMs   = 750.f;  // летит дольше (дальше ~45-55 м) - камера за ней не летит
+const float MinArrowDist = 400.f;  // ближе 4 м - лететь нечего
+const float ArrowStepMs  = 20.f;   // шаг расчёта полёта
+const float ArrowBack    = 90.f;   // камера позади стрелы, см
+const float ArrowStop    = 260.f;  // камера останавливается, не долетев до места попадания, см
+const float ArrowSoft    = 120.f;  // ...и тормозит плавно на этом отрезке
+
+const float EnemyRange   = 3000.f; // «последний враг» - других врагов героя и отряда нет ближе 30 м
+
+float ease(float t) {
+  t = std::clamp(t,0.f,1.f);
+  return t*t*(3.f-2.f*t);
+  }
+
+float lerp(float a, float b, float t) {
+  return a+(b-a)*t;
+  }
+
+Vec3 lerp(const Vec3& a, const Vec3& b, float t) {
+  return a+(b-a)*t;
+  }
+
+Vec3 dirOf(float yaw) {
+  return Vec3(std::cos(yaw),0.f,std::sin(yaw));
+  }
+
+}
+
+bool KillCam::valid(Npc* npc) const {
+  if(world==nullptr || npc==nullptr)
+    return false;
+  Focus f;
+  f.npc = npc;
+  return world->validateFocus(f).npc==npc;
+  }
+
+bool KillCam::wants(Npc& v, Npc& hero, bool arrow) const {
+  auto& o = Gothic::options();
+  if(!o.killCam || (arrow && !o.killCamArrow))
+    return false;
+  if(blockedNow || phase!=P_Idle || cooldown>0.f)
+    return false;
+  if(&v==&hero || !hero.isPlayer() || hero.isDown())
+    return false;
+  auto& w = hero.world();
+  // напарники и живой NPC не погибают - их не показывают
+  if(w.script().isHired(v) || w.script().aiNpc().isAiNpc(v))
+    return false;
+  if(o.killCamEvery)
+    return true;
+  // по умолчанию - как в Max Payne 3: последний враг в бою
+  return !w.script().squadEnemyLeft(hero,&v,EnemyRange);
+  }
+
+bool KillCam::predict(Npc& hero, const Vec3& from, const Vec3& vel, Shot& out) const {
+  // Полёт стрелы - та же парабола, что в DynamicWorld::moveBullet; первое, что она заденет: тело NPC (по частям
+  // куклы, как стрела), земля или стена
+  auto&      phys = *hero.world().physic();
+  const float g   = DynamicWorld::gravity;
+  Vec3        prev = from;
+  for(float t=ArrowStepMs; t<=MaxArrowMs+ArrowStepMs; t+=ArrowStepMs) {
+    const Vec3 p  = from + vel*t - Vec3(0.f,0.5f*g*t*t,0.f);
+    const auto rc = phys.aimRay(prev,p,&hero);
+    if(rc.hasCol) {
+      if(rc.npcHit==nullptr)
+        return false;
+      const float seg  = (p-prev).length();
+      const float part = seg>1e-3f ? std::clamp((rc.v-prev).length()/seg,0.f,1.f) : 0.f;
+      out.victim = rc.npcHit;
+      out.at     = rc.v;
+      out.zone   = rc.zone;
+      out.timeMs = t-ArrowStepMs+part*ArrowStepMs;
+      return true;
+      }
+    prev = p;
+    }
+  return false;
+  }
+
+void KillCam::onShot(Npc& hero, const Bullet& b, const Vec3& from, const Vec3& vel) {
+  auto& o = Gothic::options();
+  if(!hero.isPlayer() || !o.killCam || !o.killCamArrow || phase!=P_Idle || blockedNow || cooldown>0.f)
+    return;
+  Shot s;
+  if(!predict(hero,from,vel,s) || s.victim==nullptr)
+    return;
+  Npc& v = *s.victim;
+  if(v.isDown() || v.isPlayer() || (v.isImmortal() && !v.isKnockoutOnly()))
+    return;
+  if(hero.world().script().isFriendlyFire(hero,v))
+    return;
+  if((s.at-from).length()<MinArrowDist || s.timeMs>MaxArrowMs)
+    return;
+  // Победит ли: урон стрелы по месту (DamageCalculator, как при попадании) против здоровья. Стрела не оглушает -
+  // человек падает, только если жизни кончились (Npc::checkHealth)
+  const auto dmg    = DamageCalculator::arrowDamage(hero,v,b,s.zone);
+  const bool hits   = dmg.hasHit && !dmg.invincible && dmg.value>0;
+  const bool lethal = hits && dmg.value>=v.attribute(ATR_HITPOINTS);
+  // «Каждый побеждённый» - и попадание в голову, даже если не свалит
+  const bool head   = hits && s.zone==Ragdoll::Z_Head && o.killCamEvery;
+  if(!(lethal || head) || !wants(v,hero,true))
+    return;
+
+  world      = &hero.world();
+  victim     = &v;
+  bullet     = &b;
+  shot       = s;
+  shotFrom   = from;
+  shotVel    = vel;
+  shotMs     = 0;
+  cinema     = true;
+  cinemaShot = true;
+  shortHold  = !lethal;
+  hasCam     = false;
+  // полёт на экране - около 1,5 с: ближний выстрел замедляется сильнее, дальний - меньше (до 0,3: дальше стрела
+  // летит на экране дольше)
+  arrowSlow  = std::clamp(s.timeMs/1000.f/ArrowRealLen, 0.06f, 0.3f);
+  sideSign   = (rng()&1u) ? 1.f : -1.f;
+  phase      = P_Arrow;
+  phaseT     = 0;
+  worldT     = 0;
+  Log::i("[g2m] killcam: arrow \"",v.displayName(),"\" ",int((s.at-from).length()/100.f),"m zone=",int(s.zone),
+         " dmg=",dmg.value,"/",v.attribute(ATR_HITPOINTS)," slow=",arrowSlow);
+  }
+
+void KillCam::onHit(Npc& v, Npc& hero, const Bullet* b, bool defeated) {
+  if(!hero.isPlayer())
+    return;
+  if(phase==P_Arrow) {
+    // стрела, за которой летит камера, вошла в тело
+    if(&v!=victim || (b!=nullptr && b!=bullet))
+      return;
+    shortHold = !defeated;
+    startVictim(v,hero,true);
+    return;
+    }
+  if(!defeated || !wants(v,hero,false))
+    return;
+  world      = &hero.world();
+  victim     = &v;
+  bullet     = nullptr;
+  cinema     = Gothic::options().killCamCinema;
+  cinemaShot = cinema;
+  shortHold  = false;
+  hasCam     = false;
+  startVictim(v,hero,false);
+  }
+
+void KillCam::startVictim(Npc& v, Npc& hero, bool fromArrow) {
+  phase  = P_Victim;
+  phaseT = 0;
+  worldT = 0;
+  slow   = 0.3f;
+  // падение тела по физике - около 0,8 с времени мира: «каждый побеждённый» - короче
+  holdWorld = shortHold ? 0.35f : (Gothic::options().killCamEvery ? 0.6f : 0.85f);
+  if(cinema) {
+    if(fromArrow && hasCam) {
+      orbitFromCamera(v);
+      }
+    else if(!planVictim(v,hero)) {
+      // не нашлось места, откуда видно (теснота, стены) - только замедление
+      cinema     = fromArrow;
+      cinemaShot = fromArrow;
+      if(fromArrow)
+        orbitFromCamera(v);
+      }
+    }
+  if(!cinema)
+    holdWorld = std::min(holdWorld,0.55f);
+  Log::i("[g2m] killcam: ",(fromArrow ? "arrow hit" : "defeat")," \"",v.displayName(),"\" ",
+         (v.isDead() ? "dead" : (v.isUnconscious() ? "unconscious" : "standing"))," cinema=",int(cinema));
+  }
+
+bool KillCam::planVictim(Npc& v, Npc& hero) {
+  // Ракурс сбоку от линии «герой - побеждённый»: тело падает от героя, и сбоку видно всё падение (как в Max Payne).
+  // Места - по очереди: сбоку, чуть спереди или сзади, со стороны героя, из-за спины побеждённого; камера не в земле,
+  // не за стеной и не под водой
+  auto& phys = *v.world().physic();
+  float size = 180.f;
+  if(auto bb = v.bBox()) {
+    const Vec3 sz = bb[1]-bb[0];
+    size = std::max(sz.y, std::max(sz.x,sz.z));
+    }
+  size = std::clamp(size,60.f,700.f);
+
+  pivot     = v.aimChest();
+  look      = pivot;
+  orbDist   = std::clamp(1.55f*size,220.f,950.f);
+  camZoom   = 1.f;
+  camRoll   = 0.f;
+  Vec3 hv = hero.position()-v.position();
+  hv.y = 0;
+  const float toHero = hv.length()>1.f ? std::atan2(hv.z,hv.x) : hero.rotationRad()+Pi;
+  const float side   = (rng()&1u) ? 1.f : -1.f;
+  sideSign = side;
+
+  auto fits = [&](const Vec3& p) {
+    const auto land = phys.landRay(p+Vec3(0.f,150.f,0.f),800.f);
+    if(land.hasCol && land.v.y>p.y-40.f)
+      return false; // в склоне, под крышей
+    if(phys.ray(p,pivot).hasCol || phys.ray(pivot,p).hasCol)
+      return false; // тело заслонено
+    if(phys.cameraRay(pivot,p).waterCol%2!=0)
+      return false; // камера под водой
+    return true;
+    };
+
+  static const float offs[] = {80.f, 100.f, 60.f, 120.f, 40.f, 140.f, 20.f, 160.f, 0.f, 180.f};
+  const float heights[] = {0.15f*size+5.f, 0.15f*size+70.f};
+  for(float off:offs) {
+    for(int s=0; s<2; ++s) {
+      if(s==1 && (off==0.f || off==180.f))
+        continue;
+      const float yaw = toHero + (s==0 ? side : -side)*off*Pi/180.f;
+      for(float h:heights) {
+        const Vec3 p = pivot + dirOf(yaw)*orbDist + Vec3(0.f,h,0.f);
+        if(!fits(p))
+          continue;
+        orbYaw    = yaw;
+        orbHeight = h;
+        // облёт за сцену - ещё на 18° в ту же сторону (дальше от героя) или обратно
+        orbDrift  = ((rng()&1u) ? 1.f : -1.f)*18.f*Pi/180.f;
+        hasCam    = false;
+        return true;
+        }
+      }
+    }
+  return false;
+  }
+
+void KillCam::orbitFromCamera(Npc& v) {
+  // После стрелы - с того места, где камера остановилась: облёт вокруг тела дальше вбок
+  pivot = v.aimChest();
+  look  = camAt;
+  Vec3 d = camFrom-pivot;
+  orbHeight = d.y;
+  d.y = 0;
+  orbDist  = std::max(d.length(),150.f);
+  orbYaw   = std::atan2(d.z,d.x);
+  orbDrift = sideSign*35.f*Pi/180.f;
+  }
+
+void KillCam::skip() {
+  if(phase==P_Arrow || phase==P_Victim) {
+    Log::i("[g2m] killcam: skipped");
+    beginReturn(0.3f);
+    }
+  }
+
+void KillCam::beginReturn(float len) {
+  phase      = P_Return;
+  phaseT     = 0;
+  returnLen  = len;
+  scaleFrom  = scale;
+  weightFrom = weight;
+  cinema     = false;
+  }
+
+void KillCam::finish() {
+  if(phase!=P_Idle)
+    Log::i("[g2m] killcam: end");
+  phase      = P_Idle;
+  victim     = nullptr;
+  bullet     = nullptr;
+  world      = nullptr;
+  scale      = 1.f;
+  weight     = 0.f;
+  acc        = 0;
+  cinema     = false;
+  cinemaShot = false;
+  // подряд не показывать: «каждый побеждённый» - не чаще раза в 2,5 с
+  cooldown   = Gothic::options().killCamEvery ? 2.5f : 1.f;
+  }
+
+uint64_t KillCam::worldDt(uint64_t realDt) {
+  const float dtR = float(realDt)/1000.f;
+  cooldown = std::max(0.f,cooldown-dtR);
+  if(phase!=P_Idle && Gothic::inst().world()!=world)
+    finish(); // загрузка, другой мир
+  if(phase==P_Idle) {
+    scale  = 1.f;
+    weight = 0.f;
+    acc    = 0;
+    return realDt;
+    }
+
+  phaseT += dtR;
+  switch(phase) {
+    case P_Idle:
+      break;
+    case P_Arrow:
+      scale  = arrowSlow;
+      weight = std::min(1.f,weight+dtR/FxIn);
+      break;
+    case P_Victim: {
+      if(phaseT<HitStopLen)
+        scale = HitStopScale; else
+        scale = lerp(HitStopScale,slow,ease((phaseT-HitStopLen)/SlowInLen));
+      weight = std::min(1.f,weight+dtR/FxIn);
+      const float maxReal = cinema ? MaxHoldReal : MaxHoldPlain;
+      if((worldT>=holdWorld && phaseT>=std::min(MinHoldReal,maxReal)) || phaseT>=maxReal || !valid(victim))
+        beginReturn(cinema ? 0.6f : 0.45f);
+      break;
+      }
+    case P_Return: {
+      const float e = ease(phaseT/returnLen);
+      scale  = lerp(scaleFrom,1.f,e);
+      weight = weightFrom*(1.f-e);
+      if(phaseT>=returnLen)
+        finish();
+      break;
+      }
+    }
+
+  // Шаг мира - доля кадра; остаток (микросекунды) переходит в следующий кадр, время не теряется
+  const uint64_t us  = uint64_t(double(realDt)*1000.0*double(scale)) + acc;
+  const uint64_t wdt = us/1000;
+  acc = us%1000;
+  worldT += float(wdt)/1000.f;
+  if(phase==P_Arrow)
+    shotMs += float(wdt);
+  return wdt;
+  }
+
+bool KillCam::tickCamera(Camera& cam, uint64_t realDt, bool blocked) {
+  blockedNow = blocked;
+  if(phase!=P_Idle && Gothic::inst().world()!=world)
+    finish(); // загрузка (кадр без хода мира), другой мир
+  if(blocked && phase!=P_Idle) {
+    // разговор, сумка, меню игры, «Путь», герой убит - сцена снимается сразу
+    Log::i("[g2m] killcam: interrupted");
+    finish();
+    }
+  const float dtR = float(realDt)/1000.f;
+  if(phase==P_Arrow)
+    tickArrow(cam,dtR);
+  if(phase==P_Victim && cinema)
+    tickVictim(cam,dtR);
+  if(!isCinema()) {
+    if(hasCam) {
+      // обычная камера возвращается перелётом за время возврата (снята сразу - без перелёта)
+      cam.clearDirector(phase==P_Return ? returnLen : 0.f);
+      hasCam = false;
+      }
+    return false;
+    }
+  return true;
+  }
+
+void KillCam::tickArrow(Camera& cam, float dtR) {
+  (void)dtR;
+  // Стрела летит: камера позади и чуть сбоку, смотрит вперёд по полёту; у цели тормозит и уходит вбок - стрела
+  // входит в тело у неё на глазах
+  const bool live = bullet!=nullptr && world!=nullptr && world->isBullet(bullet) && !bullet->isFinished();
+  Vec3 p, vel;
+  if(live) {
+    p   = bullet->position();
+    vel = bullet->direction();
+    } else {
+    const float t = shotMs;
+    p   = shotFrom + shotVel*t - Vec3(0.f,0.5f*DynamicWorld::gravity*t*t,0.f);
+    vel = shotVel - Vec3(0.f,DynamicWorld::gravity*t,0.f);
+    }
+  // промах (цель отошла, стрела ушла в землю) или стрелы нет - досмотреть нечего
+  if((!live && shotMs>ArrowStepMs) || shotMs>shot.timeMs+300.f || !valid(victim)) {
+    Log::i("[g2m] killcam: arrow missed");
+    beginReturn(0.5f);
+    return;
+    }
+
+  Vec3 vd = vel.length()>1e-4f ? Vec3::normalize(vel) : Vec3::normalize(shotVel);
+  Vec3 toHit = shot.at-p;
+  const float r      = toHit.length();
+  const Vec3  dirHit = r>10.f ? toHit/r : vd;
+  // где камера на линии к месту попадания: позади стрелы, но не ближе ArrowStop - тормозит плавно
+  const float rc0 = r+ArrowBack;
+  const float x   = rc0-ArrowStop;
+  const float xs  = x>ArrowSoft ? x : ArrowSoft*std::exp((x-ArrowSoft)/ArrowSoft);
+  const float rc  = ArrowStop+xs;
+  const float k   = 1.f-ease((rc-ArrowStop)/350.f); // 0 - летит со стрелой, 1 - остановилась
+  Vec3 side = Vec3::crossProduct(vd,Vec3(0.f,1.f,0.f));
+  side = side.length()>1e-3f ? Vec3::normalize(side) : Vec3(1.f,0.f,0.f);
+  const Vec3 up = Vec3::crossProduct(side,vd);
+
+  // у лука камера стоит у плеча героя (иначе - в его голове) и сходится за стрелу, пока та отлетает на 2 м
+  const float near = 1.f-ease((p-shotFrom).length()/200.f);
+  const Vec3  base = shot.at-dirHit*rc;
+  const Vec3  from = base + up*(16.f+22.f*k+24.f*near) + side*((12.f+75.f*k+45.f*near)*sideSign);
+  const Vec3 far  = p+vd*700.f;
+  const Vec3 at   = lerp(far,shot.at,ease(k));
+  camRoll = 3.f*sideSign*(1.f-k);
+  camZoom = 1.f+0.15f*k;
+  cam.setDirector(from,at,true,true);
+  cam.setDirectorLens(camRoll,camZoom);
+  camFrom = from;
+  camAt   = at;
+  hasCam  = true;
+  }
+
+void KillCam::tickVictim(Camera& cam, float dtR) {
+  if(!valid(victim)) {
+    beginReturn(0.35f);
+    return;
+    }
+  // Взгляд - за грудью тела (кукла регдолла), сглаженно; облёт - вокруг точки, которая идёт за телом наполовину:
+  // камера не прыгает за телом, но и не теряет его
+  const Vec3 chest = victim->aimChest();
+  look = hasCam ? look+(chest-look)*std::min(1.f,5.f*dtR) : chest;
+  const Vec3  pv  = pivot+(look-pivot)*0.5f;
+  const float u   = ease(holdWorld>0.f ? worldT/holdWorld : 1.f);
+  const float yaw = orbYaw+orbDrift*u;
+  const float d   = orbDist*(1.f-0.1f*u);
+  const float h   = orbHeight*(1.f-0.25f*u);
+  Vec3 from = pv + dirOf(yaw)*d + Vec3(0.f,h,0.f);
+  // над землёй: тело падает, камера опускается вместе с ним, но в склон не уходит (луч - чуть сверху: крона или
+  // навес над камерой его не остановят)
+  const auto land = victim->world().physic()->landRay(from+Vec3(0.f,60.f,0.f),400.f);
+  if(land.hasCol && land.v.y+35.f>from.y)
+    from.y = land.v.y+35.f;
+  const float zoom0 = camZoom;
+  const float zoom  = lerp(std::min(zoom0,1.15f),1.12f,u);
+  cam.setDirector(from,look,true,true);
+  cam.setDirectorLens(camRoll*(1.f-u),zoom);
+  camFrom = from;
+  camAt   = look;
+  hasCam  = true;
+  }
diff --git a/common/game/killcam.h b/common/game/killcam.h
new file mode 100644
index 0000000..35d6b2e
--- /dev/null
+++ b/common/game/killcam.h
@@ -0,0 +1,115 @@
+#pragma once
+
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <random>
+
+class Bullet;
+class Camera;
+class Npc;
+class World;
+
+// Gothic II Mobile: слоумо-добивание, как в Max Payne (docs/CONTROLS.md, «Слоумо-добивание»). Герой победил врага
+// (убил или оглушил; по умолчанию - последнего в бою) - время мира замедляется, камера со стороны показывает, как он
+// падает (регдолл), звук ниже тоном, цвета приглушены, полосы кино; выстрел из лука или арбалета, который победит, -
+// камера летит за стрелой и останавливается перед целью. Касание экрана - пропустить.
+//  - время мира - MainWindow::tick (worldDt): мир, анимации, физика, частицы идут по нему; камера и интерфейс - в
+//    реальном времени;
+//  - ракурс - MainWindow::tickCamera -> tickCamera (Camera::setDirector, возврат - Camera::clearDirector с перелётом);
+//  - события - Npc::shootBow (onShot), Npc::takeDamage (onHit);
+//  - цвет - Renderer (fx), звук - WorldSound (soundPitch), музыка - GameMusic (musicVolume), полосы - MainWindow.
+// Настройки - [CONTROLS] killCam, killCamWhen, killCamCinema, killCamArrow (Gothic::Options).
+class KillCam final {
+  public:
+    // Выстрел героя: стрела bullet вылетела из from со скоростью vel (см/мс). Если долетит и победит - камера за ней
+    void     onShot(Npc& hero, const Bullet& bullet, const Tempest::Vec3& from, const Tempest::Vec3& vel);
+    // Удар героя (меч, кулак, стрела, заклинание) пришёлся по victim; defeated - упал (убит или без сознания)
+    void     onHit (Npc& victim, Npc& hero, const Bullet* bullet, bool defeated);
+
+    // Кадр: сколько времени мира прошло за realDt мс реального времени
+    uint64_t worldDt(uint64_t realDt);
+    // Кадр камеры (реальное время). blocked - разговор, сумка, меню, сцена, «Путь», герой убит: сцена снимается.
+    // true - ракурс задан здесь (обычная камера в этот кадр не ведётся)
+    bool     tickCamera(Camera& cam, uint64_t realDt, bool blocked);
+    // Касание экрана: досмотреть не хотят
+    void     skip();
+
+    bool     isActive()    const { return phase!=P_Idle; }
+    // Ракурс у слоумо: кнопки и полоски скрыты, касание - пропустить
+    bool     isCinema()    const { return (phase==P_Arrow || phase==P_Victim) && cinema; }
+    float    timeScale()   const { return scale; }
+    // Сила эффектов 0..1: цвет (приглушить, контраст, виньетка), звук, полосы кино
+    float    fx()          const { return weight; }
+    float    letterbox()   const { return cinemaShot ? weight : 0.f; }
+    float    soundPitch()  const { return 1.f - 0.38f*weight; }
+    float    musicVolume() const { return 1.f - 0.55f*weight; }
+
+  private:
+    enum Phase : uint8_t {
+      P_Idle,
+      P_Arrow,  // камера за стрелой
+      P_Victim, // побеждённый падает
+      P_Return, // время и камера возвращаются
+      };
+
+    struct Shot {
+      Npc*          victim = nullptr;
+      Tempest::Vec3 at;              // куда войдёт стрела, см
+      uint8_t       zone   = 0;      // Ragdoll::Zone
+      float         timeMs = 0;      // полёт до попадания (время мира)
+      };
+
+    Phase            phase      = P_Idle;
+    World*           world      = nullptr;
+    Npc*             victim     = nullptr;
+    const Bullet*    bullet     = nullptr;
+    bool             cinema     = false; // ракурс у слоумо в этой сцене
+    bool             cinemaShot = false; // ...и был (полосы гаснут вместе с эффектами)
+    bool             blockedNow = false;
+    bool             shortHold  = false; // стрела попала, но не победила - досмотреть попадание и вернуться
+
+    // время
+    float            scale      = 1.f;   // множитель времени мира
+    float            scaleFrom  = 1.f;   // в начале возврата
+    float            weightFrom = 0.f;
+    float            slow       = 0.3f;  // замедление, пока падает
+    float            arrowSlow  = 0.2f;  // замедление полёта стрелы
+    float            phaseT     = 0.f;   // реальное время фазы, с
+    float            worldT     = 0.f;   // время мира фазы, с
+    float            holdWorld  = 0.8f;  // сколько времени мира показывать падение, с
+    float            returnLen  = 0.6f;
+    float            weight     = 0.f;
+    uint64_t         acc        = 0;     // остаток времени мира, мкс
+    float            cooldown   = 0.f;   // реальное время до следующей сцены, с
+
+    // стрела
+    Tempest::Vec3    shotFrom, shotVel;
+    Shot             shot;
+    float            shotMs     = 0.f;   // время мира с выстрела, мс
+    float            sideSign   = 1.f;
+
+    // ракурс
+    Tempest::Vec3    camFrom, camAt;     // последний заданный ракурс
+    float            camRoll    = 0.f;
+    float            camZoom    = 1.f;
+    Tempest::Vec3    pivot;              // вокруг чего облёт, см
+    Tempest::Vec3    look;               // куда смотрит (сглажено), см
+    float            orbYaw     = 0.f;   // начальный угол облёта, радианы
+    float            orbDrift   = 0.f;   // поворот за сцену, радианы
+    float            orbDist    = 300.f;
+    float            orbHeight  = 30.f;  // над точкой взгляда, см
+    bool             hasCam     = false;
+    std::minstd_rand rng;
+
+    bool             wants(Npc& victim, Npc& hero, bool arrow) const;
+    bool             valid(Npc* npc) const;
+    bool             predict(Npc& hero, const Tempest::Vec3& from, const Tempest::Vec3& vel, Shot& out) const;
+    void             startVictim(Npc& victim, Npc& hero, bool fromArrow);
+    bool             planVictim(Npc& victim, Npc& hero);
+    void             orbitFromCamera(Npc& victim);
+    void             beginReturn(float len);
+    void             finish();
+    void             tickArrow (Camera& cam, float dtR);
+    void             tickVictim(Camera& cam, float dtR);
+  };
