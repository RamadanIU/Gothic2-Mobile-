+  const uint64_t LineKeep    = 120000;  // реплика, которую так и не сказали, забывается
+
+  std::string str(const rapidjson::Value& v, const char* key) {
+    if(!v.IsObject())
+      return {};
+    auto it = v.FindMember(key);
+    if(it==v.MemberEnd() || !it->value.IsString())
+      return {};
+    return std::string(it->value.GetString(),it->value.GetStringLength());
+    }
+
+  int64_t num(const rapidjson::Value& v, const char* key, int64_t def) {
+    if(!v.IsObject())
+      return def;
+    auto it = v.FindMember(key);
+    if(it==v.MemberEnd() || !it->value.IsNumber())
+      return def;
+    if(it->value.IsInt64())
+      return it->value.GetInt64();
+    return int64_t(it->value.GetDouble());
+    }
+
+  bool flag(const rapidjson::Value& v, const char* key, bool def) {
+    if(!v.IsObject())
+      return def;
+    auto it = v.FindMember(key);
+    if(it==v.MemberEnd() || !it->value.IsBool())
+      return def;
+    return it->value.GetBool();
+    }
+
+  void put(JsonOut& w, const char* key, std::string_view s) {
+    w.Key(key);
+    w.String(s.data(),rapidjson::SizeType(s.size()));
+    }
+
+  void put(JsonOut& w, const char* key, int64_t v) {
+    w.Key(key);
+    w.Int64(v);
+    }
+
+  void putMeters(JsonOut& w, const char* key, float cm) {
+    // Расстояние в метрах с одним знаком: модели хватает
+    w.Key(key);
+    w.Double(std::round(double(cm)/10.0)/10.0);
+    }
+
+  bool equalsNoCase(std::string_view a, std::string_view b) {
+    if(a.size()!=b.size())
+      return false;
+    for(size_t i=0; i<a.size(); ++i)
+      if(std::tolower(uint8_t(a[i]))!=std::tolower(uint8_t(b[i])))
+        return false;
+    return true;
+    }
+
+  std::string upper(std::string_view s) {
+    std::string r(s);
+    for(auto& c:r)
+      c = char(std::toupper(uint8_t(c)));
+    return r;
+    }
+
+  // Где относительно смотрящего: спереди, сбоку, сзади (лево и право модели не нужны)
+  const char* sideOf(const Npc& from, const Tempest::Vec3& to) {
+    auto  d   = to - from.position();
+    float ang = float(std::atan2(d.z,d.x)*180.0/M_PI) - from.rotation();
+    while(ang>180.f)
+      ang -= 360.f;
+    while(ang<-180.f)
+      ang += 360.f;
+    const float a = std::abs(ang);
+    if(a<50.f)
+      return "спереди";
+    if(a>130.f)
+      return "сзади";
+    return "сбоку";
+    }
+
+  // Вид предмета для модели: что можно надеть (equip_item), что выпить или съесть (use_item)
+  const char* itemKind(const Item& it) {
+    const uint32_t m = uint32_t(it.mainFlag());
+    const uint32_t f = uint32_t(it.itemFlag());
+    if(f & ITM_SHIELD)
+      return "shield";
+    if(m & ITM_CAT_NF)
+      return (f & (ITM_2HD_SWD | ITM_2HD_AXE)) ? "melee2h" : "melee";
+    if(m & ITM_CAT_FF)
+      return (f & ITM_CROSSBOW) ? "crossbow" : "bow";
+    if(m & ITM_CAT_MUN)
+      return "ammo";
+    if(m & ITM_CAT_ARMOR)
+      return "armor";
+    if(f & ITM_RING)
+      return "ring";
+    if(f & ITM_AMULET)
+      return "amulet";
+    if(f & ITM_BELT)
+      return "belt";
+    if(m & ITM_CAT_POTION)
+      return "potion";
+    if(m & ITM_CAT_FOOD)
+      return "food";
+    if(m & ITM_CAT_RUNE)
+      return it.isRune() ? "rune" : "scroll";
+    if(m & ITM_CAT_DOCS)
+      return "doc";
+    if(it.isGold())
+      return "gold";
+    return "other";
+    }
+
+  bool isWearable(const Item& it) {
+    const uint32_t m = uint32_t(it.mainFlag());
+    const uint32_t f = uint32_t(it.itemFlag());
+    return (m & (ITM_CAT_NF | ITM_CAT_FF | ITM_CAT_ARMOR)) || (f & (ITM_RING | ITM_AMULET | ITM_BELT | ITM_SHIELD));
+    }
+
+  bool isWeapon(const Item& it) {
+    return uint32_t(it.mainFlag()) & (ITM_CAT_NF | ITM_CAT_FF);
+    }
+
+  const char* attrName(int32_t atr) {
+    switch(atr) {
+      case ATR_STRENGTH:     return "силы";
+      case ATR_DEXTERITY:    return "ловкости";
+      case ATR_MANAMAX:      return "маны";
+      case ATR_HITPOINTSMAX: return "здоровья";
+      default:               return "умения";
+      }
+    }
+
+  // Дела по пути: идущий с героем делает их и возвращается в строй (отряд ждёт, пока дело не кончится)
+  bool isErrand(std::string_view n) {
+    return n=="go_to_place" || n=="go_to_npc" || n=="approach" || n=="loot" || n=="take_item" || n=="use_mob";
+    }
+
+  const char* attitudeName(Attitude a) {
+    return a==ATT_HOSTILE ? "враждебно" : a==ATT_ANGRY ? "сердито" : a==ATT_FRIENDLY ? "дружески" : "нейтрально";
+    }
+
+  // Как человек выглядит со стороны: одежда, оружие (обнажено ли), уровень - кто он такой, видно сразу
+  void putLooks(JsonOut& j, Npc& n) {
+    if(auto* ar = n.currentArmor())
+      put(j,"armor",fromCp1251(ar->displayName()));
+    if(auto* mw = n.currentMeleeWeapon())
+      put(j,"melee",fromCp1251(mw->displayName()));
+    if(auto* rw = n.currentRangedWeapon())
+      put(j,"ranged",fromCp1251(rw->displayName()));
+    if(n.weaponState()!=WeaponState::NoWeapon)
+      put(j,"drawn",1);
+    put(j,"level",n.level());
+    }
+
+  // Предмет в снимке: id, имя, сколько, вид, надет ли, урон/защита, чего не хватает, чтобы надеть
+  void putItem(JsonOut& j, std::string_view id, const Item& it, size_t count, const Npc& owner) {
+    j.StartObject();
+    put(j,"id",id);
+    put(j,"name",fromCp1251(it.displayName()));
+    put(j,"n",int64_t(count));
+    put(j,"kind",itemKind(it));
+    if(it.isEquipped())
+      put(j,"equipped",1);
+    const auto& h = it.handle();
+    if(isWeapon(it) && h.damage_total>0)
+      put(j,"dmg",h.damage_total);
+    if(uint32_t(it.mainFlag()) & ITM_CAT_ARMOR)
+      put(j,"prot",h.protection[PROT_EDGE]);
+    int32_t atr = 0, need = 0;
+    if(isWearable(it) && !it.checkCondUse(owner,atr,need))
+      put(j,"need",std::string(attrName(atr))+" "+std::to_string(need));
+    j.EndObject();
+    }
+  }
