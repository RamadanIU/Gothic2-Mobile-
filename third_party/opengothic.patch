+void GameMenu::openLogEntry() {
+  if(logList==nullptr)
+    return;
+  auto* view  = selectedContentItem(logList);
+  auto* quest = questOf(*logList,logList->value);
+  if(view==nullptr || quest==nullptr)
+    return;
+  std::string text;
+  for(size_t i=0; i<quest->entry.size(); ++i) {
+    text += quest->entry[i];
+    if(i+1<quest->entry.size())
+      text+="\n---\n";
+    }
+  view->scroll          = 0;
+  view->handle->text[0] = text;
+  view->visible         = true;
+  logView               = view;
+  curItem               = indexOf(*view);
+  update();
+  }
