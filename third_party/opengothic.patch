+const AiNpc::StoryPreview& AiNpc::storyPreview(size_t fnSym) {
+  // Подсказка модели, о чём тема: по байт-коду её функции - слова жителя (AI_Output(self, …)), задание
+  // (Log_CreateTopic), его сдача (Log_SetTopicStatus … LOG_SUCCESS) и запись в дневник (B_LogEntry) с аргументами-
+  // константами перед вызовом. Вложенные функции не разбираются: для подсказки хватает, итог темы - по факту
+  auto found = storyPreviews.find(fnSym);
+  if(found!=storyPreviews.end())
+    return found->second;
+  StoryPreview& pv = storyPreviews[fnSym];
+  auto& vm = owner.vm;
+  auto* fn = vm.find_symbol_by_index(uint32_t(fnSym));
+  if(fn==nullptr || fn->type()!=zenkit::DaedalusDataType::FUNCTION || fn->is_external())
+    return pv;
+
+  struct Arg {
+    const zenkit::DaedalusSymbol* sym   = nullptr;
+    int32_t                       imm   = 0;
+    bool                          isImm = false;
+    };
+  auto strOf = [](const Arg& a) -> std::string {
+    if(a.sym==nullptr || a.sym->is_member() || a.sym->type()!=zenkit::DaedalusDataType::STRING)
+      return {};
+    return a.sym->get_string();
+    };
+  auto intOf = [](const Arg& a) -> int32_t {
+    if(a.isImm)
+      return a.imm;
+    if(a.sym!=nullptr && !a.sym->is_member() && a.sym->is_const() && a.sym->type()==zenkit::DaedalusDataType::INT)
+      return a.sym->get_int();
+    return -1;
+    };
+  const int32_t logMission = owner.scriptConst("LOG_MISSION",0);
+  const int32_t logSuccess = owner.scriptConst("LOG_SUCCESS",2);
+
+  try {
+    std::vector<Arg> stack;
+    uint32_t       pc  = fn->address();
+    const uint32_t end = vm.size();
+    for(size_t step=0; pc<end && step<6000; ++step) {
+      // Конец функции - начало следующего кода (функции, экземпляра)
+      if(step>0)
+        if(auto* next = vm.find_symbol_by_address(pc); next!=nullptr && next!=fn && !next->is_external())
+          break;
+      const auto ins = vm.instruction_at(pc);
+      pc += ins.size;
+      switch(ins.op) {
+        case zenkit::DaedalusOpcode::PUSHV:
+        case zenkit::DaedalusOpcode::PUSHVI:
+        case zenkit::DaedalusOpcode::PUSHVV: {
+          Arg a;
+          a.sym = vm.find_symbol_by_index(ins.symbol);
+          stack.push_back(a);
+          break;
+          }
+        case zenkit::DaedalusOpcode::PUSHI: {
+          Arg a;
+          a.imm   = ins.immediate;
+          a.isImm = true;
+          stack.push_back(a);
+          break;
+          }
+        case zenkit::DaedalusOpcode::BE:
+        case zenkit::DaedalusOpcode::BL: {
+          const zenkit::DaedalusSymbol* callee = ins.op==zenkit::DaedalusOpcode::BE ? vm.find_symbol_by_index(ins.symbol)
+                                                                                     : vm.find_symbol_by_address(ins.address);
+          const std::string_view name = callee!=nullptr ? std::string_view(callee->name()) : std::string_view();
+          const size_t           n    = stack.size();
+          if(name=="AI_OUTPUT" && n>=3) {
+            const Arg& who = stack[n-3];
+            if(who.sym!=nullptr && who.sym->name()=="SELF" && pv.says.size()<StoryPreviewMax) {
+              const auto txt = owner.messageByName(strOf(stack[n-1]));
+              if(!txt.empty())
+                pv.says += (pv.says.empty() ? "" : " ")+fromCp1251(txt);
+              }
+            }
+          else if(name=="LOG_CREATETOPIC" && n>=2) {
+            if(pv.quest.empty() && intOf(stack[n-1])==logMission)
+              pv.quest = fromCp1251(strOf(stack[n-2]));
+            }
+          else if((name=="B_LOGENTRY" || name=="LOG_ADDENTRY") && n>=2) {
+            if(pv.log.empty())
+              pv.log = fromCp1251(strOf(stack[n-1]));
+            }
+          else if(name=="LOG_SETTOPICSTATUS" && n>=2) {
+            if(pv.done.empty() && intOf(stack[n-1])==logSuccess)
+              pv.done = fromCp1251(strOf(stack[n-2]));
+            }
+          stack.clear();
+          break;
+          }
+        default:
+          stack.clear();
+          break;
+        }
+      }
+    }
+  catch(...) {
+    Log::e("[g2m] ai: unable to read dialog function \"",fn->name(),"\"");
+    }
+  pv.says = cutUtf8(pv.says,StoryPreviewMax);
+  return pv;
+  }
+
+std::string AiNpc::storyJson(Npc& player, Npc& npc) {
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+
+  std::vector<zenkit::IInfo*> infos;
+  owner.storyPrepare(player,npc);
+  storyInfos(npc,infos);
+  j.Key("topics");
+  j.StartArray();
+  size_t n = 0;
+  for(auto* info:infos) {
+    if(n>=StoryTopicsMax)
+      break;
+    if(!storyListed(player,npc,*info))
+      continue;
+    auto*       isym = owner.vm.find_symbol_by_instance(*info);
+    const auto& pv   = storyPreview(size_t(info->information));
+    j.StartObject();
+    put(j,"id","t"+std::to_string(isym->index()));
+    if(!info->description.empty())
+      put(j,"hero",fromCp1251(info->description));
+    if(info->important)
+      put(j,"imp",1);
+    if(info->permanent)
+      put(j,"perm",1);
+    if(!pv.says.empty())
+      put(j,"says",pv.says);
+    if(!pv.quest.empty())
+      put(j,"quest",pv.quest);
+    if(!pv.done.empty())
+      put(j,"done",pv.done);
+    if(!pv.log.empty())
+      put(j,"log",pv.log);
+    j.EndObject();
+    ++n;
+    }
+  j.EndArray();
+
+  // Начатая через модель тема ждёт выбора героя (Info_AddChoice)
+  j.Key("choices");
+  j.StartArray();
+  for(auto* info:infos) {
+    auto* isym = owner.vm.find_symbol_by_instance(*info);
+    if(isym==nullptr || info->choices.empty() ||
+       std::find(storyOpen.begin(),storyOpen.end(),isym->index())==storyOpen.end())
+      continue;
+    for(auto& c:info->choices) {
+      j.StartObject();
+      put(j,"id","c"+std::to_string(c.function));
+      put(j,"text",fromCp1251(c.text));
+      put(j,"of","t"+std::to_string(isym->index()));
+      j.EndObject();
+      }
+    }
+  j.EndArray();
+
+  // Задания героя в работе - самые свежие
+  j.Key("quests");
+  j.StartArray();
+  const auto& log = owner.questLog();
+  size_t q = 0;
+  for(size_t i=log.questCount(); i>0 && q<8; --i) {
+    const auto& qu = log.quest(i-1);
+    if(qu.section!=QuestLog::Mission || qu.status!=QuestLog::Status::Running)
+      continue;
+    j.StartObject();
+    put(j,"name",fromCp1251(qu.name));
+    if(!qu.entry.empty())
+      put(j,"entry",cutUtf8(fromCp1251(qu.entry.back()),300));
+    j.EndObject();
+    ++q;
+    }
+  j.EndArray();
+
+  j.EndObject();
+  return buf.GetString();
+  }
+
+void AiNpc::cmdStory(Npc& npc, Action& a, std::string_view topic) {
+  auto* w  = world();
+  Npc*  pl = w->player();
+  if(&npc==geralt) {
+    finish(a,false,"у тебя нет сюжетных тем: ты здесь чужак");
+    return;
+    }
+  if(pl->qDistTo(npc)>SayDist*SayDist*2.25f) {
+    finish(a,false,"герой отошёл - сюжетную тему можно сыграть, только когда он рядом");
+    return;
+    }
+  if(w->isInDialog()) {
+    finish(a,false,"герой сейчас в диалоге игры");
+    return;
+    }
+
+  // Тема (t<экземпляр C_INFO>) или вариант ответа в начатой теме (c<функция>); модель могла передать и слова героя
+  std::vector<zenkit::IInfo*> infos;
+  owner.storyPrepare(*pl,npc);
+  storyInfos(npc,infos);
+  zenkit::IInfo* info = nullptr;
+  uint32_t       fn   = 0;
+  std::string    t;
+  for(char c:topic)
+    if(c!=' ' && c!='"' && c!='\'')
+      t.push_back(c);
+  const bool digits = t.size()>1 && std::all_of(t.begin()+1,t.end(),[](char c){ return std::isdigit(uint8_t(c))!=0; });
+  if(digits && (t[0]=='t' || t[0]=='T')) {
+    const size_t id = size_t(std::strtoull(t.c_str()+1,nullptr,10));
+    for(auto* i:infos)
+      if(auto* isym = owner.vm.find_symbol_by_instance(*i); isym!=nullptr && isym->index()==id) {
+        info = i;
+        fn   = uint32_t(i->information);
+        }
+    }
+  else if(digits && (t[0]=='c' || t[0]=='C')) {
+    const uint32_t id = uint32_t(std::strtoul(t.c_str()+1,nullptr,10));
+    for(auto* i:infos)
+      for(auto& c:i->choices)
+        if(uint32_t(c.function)==id) {
+          info = i;
+          fn   = id;
+          }
+    }
+  else {
+    const std::string want = toCp1251(topic);
+    for(auto* i:infos) {
+      if(!i->description.empty() && equalsNoCase(i->description,want)) {
+        info = i;
+        fn   = uint32_t(i->information);
+        }
+      for(auto& c:i->choices)
+        if(equalsNoCase(c.text,want)) {
+          info = i;
+          fn   = uint32_t(c.function);
+          }
+      }
+    }
+  if(info==nullptr) {
+    finish(a,false,"нет такой темы или варианта; id - из «Темы разговора» в обстановке");
+    return;
+    }
+  auto* isym = owner.vm.find_symbol_by_instance(*info);
+  if(isym==nullptr) {
+    finish(a,false,"тема не найдена в скриптах");
+    return;
+    }
+  const bool choice = fn!=uint32_t(info->information);
+  if(!choice) {
+    if(info->trade) {
+      finish(a,false,"торговля - в диалоге игры: пусть герой заговорит с тобой и выберет торговлю");
+      return;
+      }
+    if(!storyListed(*pl,npc,*info)) {
+      finish(a,false,"эта тема сейчас недоступна: условия игры не выполнены или она уже сыграна");
+      return;
+      }
+    }
+
+  // Что было до темы: вещи и золото героя, опыт, умения, гильдия, дневник, доступные темы
+  const size_t gold = owner.findSymbolIndex("ITMI_GOLD");
+  auto items = [&]() {
+    std::vector<std::pair<size_t,size_t>> v;
+    for(auto it=pl->inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it)
+      v.emplace_back(it->clsId(),it.count());
+    return v;
+    };
+  struct QuestState {
+    std::string       name;
+    QuestLog::Section section;
+    QuestLog::Status  status;
+    size_t            entries;
+    };
+  auto quests = [&]() {
+    std::vector<QuestState> v;
+    const auto& log = owner.questLog();
+    for(size_t i=0; i<log.questCount(); ++i) {
+      const auto& qu = log.quest(i);
+      v.push_back(QuestState{qu.name,qu.section,qu.status,qu.entry.size()});
+      }
+    return v;
+    };
+  auto topics = [&]() {
+    std::vector<size_t> v;
+    for(auto* i:infos)
+      if(storyListed(*pl,npc,*i))
+        if(auto* s = owner.vm.find_symbol_by_instance(*i))
+          v.push_back(s->index());
+    return v;
+    };
+  static const struct { Attribute atr; const char* name; } attrs[] = {
+    {ATR_STRENGTH,"сила"}, {ATR_DEXTERITY,"ловкость"}, {ATR_MANAMAX,"мана"}, {ATR_HITPOINTSMAX,"здоровье"},
+    };
+  const auto    itemsBefore  = items();
+  const auto    questsBefore = quests();
+  const auto    topicsBefore = topics();
+  const int32_t xpBefore     = pl->experience();
+  const uint32_t guildBefore = pl->guild();
+  int32_t       atrBefore[std::size(attrs)] = {};
+  for(size_t i=0; i<std::size(attrs); ++i)
+    atrBefore[i] = pl->attribute(attrs[i].atr);
+
+  // Вариант ответа исполнение убирает из списка - его слова запомнить заранее
+  std::string title = info->description;
+  for(auto& c:info->choices)
+    if(choice && uint32_t(c.function)==fn)
+      title = c.text;
+
+  GameScript::StoryCapture cap;
+  owner.storyExec(*pl,npc,*info,fn,cap);
+  // Герой с ним поговорил - как после родного диалога (ZS_Talk_Loop): скрипты не встречают его как незнакомца
+  const int32_t talked = owner.scriptConst("AIV_TALKEDTOPLAYER",-1);
+  if(talked>=0 && uint32_t(talked)<zenkit::INpc::aivar_count)
+    npc.handle().aivar[size_t(talked)] = 1;
+
+  if(info->choices.empty())
+    storyOpen.erase(std::remove(storyOpen.begin(),storyOpen.end(),isym->index()),storyOpen.end());
+  else if(std::find(storyOpen.begin(),storyOpen.end(),isym->index())==storyOpen.end())
+    storyOpen.push_back(isym->index());
+  const uint64_t now = owner.tickCount();
+  storyRecent.erase(std::remove_if(storyRecent.begin(),storyRecent.end(),[now](const StoryRecent& r){
+    return now>r.at+300000;
+    }),storyRecent.end());
+  storyRecent.push_back(StoryRecent{&npc,isym->index(),now});
+
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"title",fromCp1251(title));
+  j.Key("lines");
+  j.StartArray();
+  size_t total = 0;
+  for(auto& [hero,text]:cap.lines) {
+    if(text.empty() || total>5000)
+      continue;
+    const std::string u = fromCp1251(text);
+    total += u.size();
+    j.StartObject();
+    if(hero)
+      put(j,"hero",1);
+    put(j,"text",u);
+    j.EndObject();
+    }
+  j.EndArray();
+
+  // Дневник: новые задания, смена состояния, новые записи
+  j.Key("quests");
+  j.StartArray();
+  {
+  const auto& log = owner.questLog();
+  for(size_t i=0; i<log.questCount(); ++i) {
+    const auto& qu  = log.quest(i);
+    const QuestState* was = nullptr;
+    for(auto& b:questsBefore)
+      if(b.name==qu.name)
+        was = &b;
+    const char* status = nullptr;
+    if(was==nullptr)
+      status = qu.section==QuestLog::Note ? "note" : "new";
+    else if(was->status!=qu.status)
+      status = qu.status==QuestLog::Status::Success  ? "success"  :
+               qu.status==QuestLog::Status::Failed   ? "failed"   :
+               qu.status==QuestLog::Status::Obsolete ? "obsolete" : "running";
+    else if(qu.entry.size()>was->entries)
+      status = qu.section==QuestLog::Note ? "note" : "running";
+    if(status==nullptr)
+      continue;
+    j.StartObject();
+    put(j,"name",fromCp1251(qu.name));
+    put(j,"status",status);
+    if(!qu.entry.empty() && (was==nullptr || qu.entry.size()>was->entries))
+      put(j,"entry",cutUtf8(fromCp1251(qu.entry.back()),400));
+    j.EndObject();
+    }
+  }
+  j.EndArray();
+
+  // Вещи и золото героя
+  {
+  const auto itemsAfter = items();
+  auto countIn = [](const std::vector<std::pair<size_t,size_t>>& v, size_t cls) {
+    size_t c = 0;
+    for(auto& [k,m]:v)
+      if(k==cls)
+        c += m;
+    return c;
+    };
+  auto name = [&](size_t cls) -> std::string {
+    const Item* it = pl->getItem(cls);
+    if(it==nullptr)
+      it = npc.getItem(cls);
+    if(it!=nullptr)
+      return fromCp1251(it->displayName());
+    auto* sym = owner.findSymbol(cls);
+    return sym!=nullptr ? std::string(sym->name()) : std::string("?");
+    };
+  std::vector<size_t> all;
+  for(auto& [c,k]:itemsBefore)
+    all.push_back(c);
+  for(auto& [c,k]:itemsAfter)
+    all.push_back(c);
+  std::sort(all.begin(),all.end());
+  all.erase(std::unique(all.begin(),all.end()),all.end());
+  std::vector<std::string> got, gave;
+  int64_t goldDiff = 0;
+  for(auto cls:all) {
+    const int64_t b = int64_t(countIn(itemsBefore,cls)), e = int64_t(countIn(itemsAfter,cls));
+    if(b==e)
+      continue;
+    if(cls==gold) {
+      goldDiff = e-b;
+      continue;
+      }
+    const int64_t d = std::abs(e-b);
+    (e>b ? got : gave).push_back(name(cls)+(d>1 ? " x"+std::to_string(d) : std::string()));
+    }
+  j.Key("got");
+  j.StartArray();
+  for(auto& g:got)
+    j.String(g.c_str(),rapidjson::SizeType(g.size()));
+  j.EndArray();
+  j.Key("gave");
+  j.StartArray();
+  for(auto& g:gave)
+    j.String(g.c_str(),rapidjson::SizeType(g.size()));
+  j.EndArray();
+  if(goldDiff!=0)
+    put(j,"gold",goldDiff);
+  }
+
+  if(pl->experience()>xpBefore)
+    put(j,"xp",pl->experience()-xpBefore);
+  j.Key("attrs");
+  j.StartArray();
+  for(size_t i=0; i<std::size(attrs); ++i) {
+    const int32_t d = pl->attribute(attrs[i].atr)-atrBefore[i];
+    if(d==0)
+      continue;
+    const std::string s = std::string(attrs[i].name)+(d>0 ? " +" : " ")+std::to_string(d);
+    j.String(s.c_str(),rapidjson::SizeType(s.size()));
+    }
+  j.EndArray();
+  if(pl->guild()!=guildBefore)
+    put(j,"guild",guildName(int32_t(pl->guild())));
+  if(cap.ended)
+    put(j,"ended",1);
+
+  // Что дальше: варианты ответа героя в этой теме и темы, которые открылись
+  j.Key("choices");
+  j.StartArray();
+  for(auto& c:info->choices) {
+    j.StartObject();
+    put(j,"id","c"+std::to_string(c.function));
+    put(j,"text",fromCp1251(c.text));
+    j.EndObject();
+    }
+  j.EndArray();
+  j.Key("next");
+  j.StartArray();
+  for(auto* i:infos) {
+    auto* s = owner.vm.find_symbol_by_instance(*i);
+    if(s==nullptr || i==info || std::find(topicsBefore.begin(),topicsBefore.end(),s->index())!=topicsBefore.end())
+      continue;
+    if(!storyListed(*pl,npc,*i))
+      continue;
+    j.StartObject();
+    put(j,"id","t"+std::to_string(s->index()));
+    put(j,"hero",i->description.empty() ? std::string("(сам хочешь сказать)") : fromCp1251(i->description));
+    j.EndObject();
+    }
+  j.EndArray();
+  j.EndObject();
+
+  Log::i("[g2m] ai: story ",isym->name(),choice ? " (choice)" : ""," with \"",npc.displayName(),"\": lines=",
+         cap.lines.size()," choices=",info->choices.size(),cap.ended ? " ended" : "");
+  finish(a,true,"тема сыграна",buf.GetString());
+  }
diff --git a/common/game/ainpc.h b/common/game/ainpc.h
new file mode 100644
index 0000000..615eb59
--- /dev/null
+++ b/common/game/ainpc.h
@@ -0,0 +1,253 @@
+#pragma once
+
+#include <Tempest/Painter>
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+#include "gamescript.h"
+
+class Npc;
+class Item;
+class Interactive;
+class World;
+class WayPoint;
+
+// Gothic II Mobile: живой NPC - Геральт из Ривии, сидит в кабаке Корагона в Хоринисе (docs/AI_NPC.md).
+// Думает языковая модель в приложении (Java, gothic2.mobile.og.ai), движок - её глаза и руки: вставляет
+// Геральта в мир, описывает обстановку (снимок в JSON), исполняет действия (идти, следовать, драться,
+// отдать, поднять, надеть, жесты, занятия, говорить с NPC) и показывает реплики - субтитры, лицо и жесты;
+// звук реплики играет приложение. Сказать ему можно кнопкой «Сказать» рядом с ним (без диалога) или в
+// диалоге - «Сказать голосом», «Написать», торговля.
+//
+// Геральт - неиспользуемый в игре NPC Vlk_2000_Thorus (остаток от Gothic 1: без диалогов, нигде не
+// вставляется) с другим именем, внешностью и умениями: сохраняется и загружается как обычный NPC.
+class AiNpc final {
+  public:
+    explicit AiNpc(GameScript& owner);
+    ~AiNpc();
+
+    void tick(uint64_t dt);
+
+    bool isAiNpc(const Npc& npc) const;
+    // Модель думает или игрок говорит: выбор реплик в диалоге с ним ждёт (DialogMenu::haveToWaitOutput)
+    bool isBusy (const Npc& npc) const;
+    // Свои доспехи и оружие: скрипты (ZS_Attack, ...) и вставка не меняют их на «лучшие» - надевает он сам
+    bool keepsOwnGear(const Npc& npc) const;
+    // Пошёл с героем по своей воле (follow_hero: Геральт или живой житель) - напарник, как нанятый
+    // (GameScript::isHired); отпустить - к своим делам
+    bool isAiFollower(Npc& npc) const;
+    void releaseFollower(Npc& npc);
+    // Смена мира (GameScript::squadLeaveWorld/squadEnterWorld): Геральт ушёл с героем из мира или пришёл в мир.
+    // На герое - метка «Геральт не в Хоринисе»: там он не появляется заново, пока не вернётся с героем
+    void leaveWorld(Npc& npc, Npc& hero);
+    void enterWorld(Npc& npc, Npc& hero, World& w);
+
+    // Кнопка «Сказать» (TouchInput): кому герой скажет - выбранному или тому, на кого смотрит (живые жители), иначе
+    // Геральту рядом; nullptr - некому. Сказать без диалога: слова - модели этого жителя
+    Npc* addressee(const Npc& player, Npc* candidate) const;
+    void heroSpeak(Npc& to);
+
+    // Диалог с ним: свой выбор реплик вместо скриптов игры
+    bool dialogChoices(Npc& player, Npc& npc, std::vector<GameScript::DlgChoice>& out);
+    bool exec         (const GameScript::DlgChoice& dlg, Npc& player, Npc& npc);
+    void onDialogStart(Npc& player, Npc& npc);
+    void onDialogEnd  (Npc* player, Npc* npc);
+
+    // Реплики модели: текст (Windows-1251) и длительность для GameScript::messageByName/messageTime
+    bool lineText (std::string_view id, std::string_view& out) const;
+    bool lineTime (std::string_view id, uint32_t& ms) const;
+    // Реплика началась (в диалоге или вне его): звук - в приложении. false - не наша реплика
+    bool lineStart(Npc& speaker, std::string_view id, bool inDialog);
+    // Касание пропустило реплику в диалоге: голос обрывается, реплика считается сказанной
+    void skipLines();
+
+    // Субтитры реплик вне диалога (MainWindow::paintEvent)
+    void paint(Tempest::Painter& p, int w, int h, float scale);
+
+    // Перед записью сохранения: метка памяти модели (память - у приложения, своя у каждого сохранения)
+    void beforeSave();
+    // Удар: кто кого (Npc::takeDamage) - события для модели
+    void onHit(Npc& attacker, Npc& victim);
+
+    enum : uint32_t {
+      ChoiceVoice = 0xFFFFFF20u,
+      ChoiceType  = 0xFFFFFF21u,
+      ChoiceTrade = 0xFFFFFF22u,
+      ChoiceBye   = 0xFFFFFF23u,
+      ChoiceSwap  = 0xFFFFFF24u,
+      };
+
+  private:
+    struct Line {
+      std::string id;
+      std::string text;      // Windows-1251 - для шрифтов игры
+      std::string speaker;   // имя говорящего, Windows-1251
+      uint32_t    ms        = 0;
+      uint64_t    shownTill = 0; // субтитр вне диалога виден до
+      uint64_t    endsAt    = 0; // когда сказать приложению, что реплика кончилась
+      bool        started   = false;
+      bool        overlay   = false;
+      Npc*        npc       = nullptr;
+      };
+
+    struct Action {
+      std::string     id;
+      std::string     name;
+      Npc*            actor    = nullptr; // кто делает: Геральт или житель
+      uint64_t        started  = 0;
+      uint64_t        deadline = 0;
+      Npc*            target   = nullptr;
+      Item*           item     = nullptr;
+      const WayPoint* wp       = nullptr;
+      Tempest::Vec3   pos;
+      std::string     text;    // talk_to_npc: что сказать по приходе
+      std::string     mood;
+      bool            begun    = false; // действие тела ждёт конца разговора
+      bool            report   = true;  // сообщить приложению об итоге
+      bool            closed   = false;
+      };
+
+    struct Known {
+      uint64_t    lastSeen = 0;
+      int32_t     hp       = 0;
+      bool        hostile  = false;
+      bool        dead     = false;
+      std::string hitBy;     // кто ударил последним (UTF-8, конец фразы события смерти): «убил(а) герой»
+      };
+
+    World* world();
+    Npc*   resolve();
+    void   insert(World& w);
+    void   setup(Npc& npc, bool fresh);
+    void   dressArmor(Npc& npc);
+    bool   isTargetWorld(World& w) const;
+    bool   isGeraltNpc(const Npc& npc);
+    const WayPoint* spawnPoint(World& w);
+    void   seat(Npc& npc, World& w);
+    void   moveToSpawn(Npc& npc, World& w);
+
+    void   handle(const std::string& json);
+    void   cmdSay(const std::string& id, const std::string& who, const std::string& text, uint32_t ms,
+                  const std::string& to, const std::string& mood);
+    void   cmdAct(Npc& actor, const std::string& id, const std::string& name, const void* args);
+    Npc*   actorOf(std::string_view who);
+    // Житель уходит от своего распорядка (идёт куда попросили, ждёт, идёт с героем) - распорядок запоминается;
+    // домой - когда попросят (go_home) или когда герой давно далеко (tickResidents)
+    void   leaveRoutine(Npc& npc);
+    void   goHome(Npc& npc);
+    // Постоянная вражда к герою от прежнего set_attitude hostile (бой насмерть) - в злость (сохранения до 2026-10-24)
+    void   calmHostility(Npc& npc, Npc& pl);
+    void   tickResidents(uint64_t now);
+    std::string equip  (Npc& npc, size_t sym, bool& ok);
+    std::string unequip(Npc& npc, size_t sym, bool& ok);
+    void   finish(Action& a, bool ok, std::string_view note, std::string_view story = {});
+    void   beginBody(Action& a);
+    void   tickActions(uint64_t now);
+    void   tickLines(uint64_t now);
+    void   tickEvents(uint64_t now);
+    void   cancelBody(Npc* actor, std::string_view why);
+    void   speakOverlay(Npc& speaker, Npc* to, const std::string& id, const std::string& text, uint32_t ms);
+    void   endDialog();
+
+    void   sendReady();
+    void   rememberInventory();
+    void   reportTrade();
+    void   sendSnapshot(Npc& me, std::string_view reason);
+    void   sendLore(std::string_view req, std::string_view ref);
+    void   sendDescribe(std::string_view req, std::string_view ref, std::string_view viewer);
+    void   sendEvent(std::string_view kind, std::string_view text, Npc* who);
+    std::string snapshot(Npc& me);
+
+    // Сюжет игры в разговоре (docs/AI_NPC.md): темы диалогов жителя из скриптов игры (C_INFO), которые герою доступны
+    // сейчас, - в снимке; story_topic модели исполняет тему скриптом игры (GameScript::storyExec), как выбор реплики
+    // в родном диалоге: задания, дневник, вещи, опыт - настоящие, реплики пересказывает модель
+    struct StoryPreview {
+      std::string says;  // его слова в теме (UTF-8)
+      std::string quest; // задание, которое тема заводит (Log_CreateTopic)
+      std::string done;  // задание, которое тема сдаёт (Log_SetTopicStatus ... LOG_SUCCESS)
+      std::string log;   // запись в дневник (B_LogEntry)
+      };
+    const StoryPreview& storyPreview(size_t fn);
+    void        storyInfos (Npc& npc, std::vector<zenkit::IInfo*>& out);
+    bool        storyListed(Npc& player, Npc& npc, zenkit::IInfo& info);
+    std::string storyJson  (Npc& player, Npc& npc);
+    void        cmdStory   (Npc& npc, Action& a, std::string_view topic);
+
+    // Ссылки на NPC и предметы для модели: n17, i42 - живут, пока живёт объект
+    std::string refOf(Npc& npc);
+    std::string refOf(Item& itm);
+    Npc*        npcByRef(std::string_view ref);
+    Item*       itemByRef(std::string_view ref);
+    bool        npcAlive(const Npc* npc);
+    std::string guildName(int32_t guild);
+    std::string placeName(const Tempest::Vec3& pos, float& dist);
+    size_t      itemSymbol(std::string_view name);
+    std::string itemNameUtf8(Npc& owner, size_t symbol);
+    std::string itemId(const Item& it);
+    std::string npcId(Npc& npc);
+    const WayPoint* placeByName(std::string_view name);
+    void        setParty(Npc& npc, bool on);
+    void        setActivity(Npc& npc, std::string_view zs);
+    bool        inDialogWithHero() const;
+    static float dist(const Npc& a, const Npc& b);
+
+    GameScript&                    owner;
+    size_t                         thorusSym   = size_t(-1);
+    Npc*                           geralt      = nullptr;
+    World*                         geraltWorld = nullptr;
+    bool                           readySent   = false;
+    bool                           sessionReady = false;
+    bool                           wasEnabled  = false;
+    uint64_t                       insertTry   = 0;
+    uint64_t                       searchAt    = 0;
+    bool                           insertFailLogged = false;
+    const World*                   loggedWorld = nullptr;
+
+    bool                           talking     = false;
+    // Вещи Геральта в начале разговора: после торговли или обмена - что герой купил, продал, отдал
+    std::vector<std::pair<size_t,size_t>> tradeBefore;
+    bool                           tradeOpened = false;
+    bool                           busy        = false;
+    uint64_t                       busyUntil   = 0;
+
+    std::vector<Line>              lines;
+    std::vector<Action>            acts;
+    // Кто для ссылок «self»: Геральт или житель, чей ход сейчас разбирается
+    Npc*                           refSelf     = nullptr;
+    struct Resident {
+      Npc*     npc      = nullptr;
+      uint64_t farSince = 0;
+      };
+    std::vector<Resident>          residents;
+    uint64_t                       residentTick = 0;
+    std::vector<std::string>       inbox;
+
+    std::unordered_map<size_t,StoryPreview> storyPreviews; // по функции темы: байт-код не меняется
+    std::vector<size_t>            storyOpen;   // темы с начатым выбором (Info_AddChoice), сыгранные через модель
+    struct StoryRecent {
+      const Npc* npc  = nullptr;
+      size_t     info = 0;
+      uint64_t   at   = 0;
+      };
+    std::vector<StoryRecent>       storyRecent;
+
+    std::unordered_map<const Npc*,uint32_t>  npcRefs;
+    std::unordered_map<uint32_t,const Npc*>  npcByNum;
+    std::unordered_map<const Item*,uint32_t> itmRefs;
+    std::unordered_map<uint32_t,const Item*> itmByNum;
+    uint32_t                       nextRef     = 1;
+
+    std::unordered_map<const Npc*,Known>     known;
+    std::vector<std::string>       pendingEvents;
+    uint64_t                       eventTick   = 0;
+    uint64_t                       snapTick    = 0;
+    uint64_t                       heroNearAt  = 0;
+    bool                           heroNear    = false;
+    int32_t                        lastHp      = -1;
+    bool                           wasDown     = false;
+  };
diff --git a/common/game/companions.cpp b/common/game/companions.cpp
new file mode 100644
index 0000000..11ab465
--- /dev/null
+++ b/common/game/companions.cpp
@@ -0,0 +1,1605 @@
+#include "gamescript.h"
+#include "ainpc.h"
+
+#include <Tempest/Log>
+#include <Tempest/MemReader>
+#include <Tempest/MemWriter>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <iterator>
+
+#include "world/objects/npc.h"
+#include "world/objects/item.h"
+#include "world/aiqueue.h"
