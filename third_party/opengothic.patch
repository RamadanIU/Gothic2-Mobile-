+bool AiNpc::isAiFollower(Npc& npc) const {
+  // Житель - по метке «ушёл от распорядка по просьбе» (сохраняется вместе с NPC); сюжетные напарники из скриптов
+  // её не имеют и идут по своим скриптам
+  return &npc==geralt || npc.handle().aivar[AivRoutine]!=0;
