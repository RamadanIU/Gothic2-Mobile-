+void TouchInput::drawTarget(Painter& p) {
+  auto tg  = ctrl.touchTarget();
+  auto cam = Gothic::inst().camera();
+  if(tg==nullptr || cam==nullptr)
+    return;
+  auto  vp  = cam->viewProj();
+  auto  pos = tg->displayPosition();
+  float pw  = 1.f;
+  vp.project(pos.x,pos.y,pos.z,pw);
+  if(pw<=0.f)
+    return;
+  pos /= pw;
+  const int   ix  = int((0.5f*pos.x+0.5f)*float(w()));
+  const int   iy  = int((0.5f*pos.y+0.5f)*float(h()));
+  const float d   = dp();
+  // Покачивающаяся золотая стрелка над головой выбранной цели
+  const float t   = float(Application::tickCount()%1200)/1200.f;
+  const int   bob = int(3*d*std::sin(t*2.f*Pi));
+  const int   gs  = int(22*d);
+  drawGlyph(p, TouchIcons::I_Down, Point(ix, iy-int(26*d)+bob), gs, GoldBright);
+  if(ctrl.focus().npc!=tg)
+    drawLabel(p, tg->displayName(), Point(ix, iy-int(44*d)+bob), false, 0.85f);
+  }
