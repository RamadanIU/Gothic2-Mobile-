+void GameScript::invokeAttack(Npc& npc, Npc& target, int32_t reason) {
+  // Gothic II Mobile: напасть так же, как это делают скрипты игры (B_Attack -> ZS_Attack): с репликой,
+  // выбором оружия и концом боя по правилам причины нападения
+  auto* fn = vm.find_symbol_by_name("B_ATTACK");
+  if(fn==nullptr || fn->type()!=zenkit::DaedalusDataType::FUNCTION)
+    return;
+  ScopeCtx ctx  (*this, npc.processPolicy());
+  ScopeVar self (*vm.global_self(),  npc.handlePtr());
+  ScopeVar other(*vm.global_other(), target.handlePtr());
+  vm.call_function<void>(fn, npc.handlePtr(), target.handlePtr(), reason, int32_t(0));
+  }
