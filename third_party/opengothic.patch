+int GameMenu::questAt(Item& list, Point pos) {
+  // Та же раскладка строк, что в drawQuestList
+  auto ql = Gothic::inst().questLog();
+  if(ql==nullptr)
+    return -1;
+  const auto& item  = list.handle;
+  const float scale = Gothic::interfaceScale(this);
+  const Rect  r     = itemRect(list);
+  const int   px    = int(float(w()*item->frame_sizex)/scriptDiv);
+  const int   py    = int(float(h()*item->frame_sizey)/scriptDiv);
+  const int   x = r.x+px, y = r.y+py, lw = r.w-2*px, lh = r.h-2*py;
+  if(pos.x<x || pos.x>=x+lw)
+    return -1;
+  const auto  st    = toStatus(item->user_string[0]);
+  auto&       fnt   = Resources::font(item->fontname,Resources::FontType::Normal,scale);
+  int32_t     id    = -1;
+  int         itY   = y;
+  for(size_t i=0; i<ql->questCount(); i++) {
+    auto& quest = ql->quest(ql->questCount()-i-1);
+    if(!isCompatible(quest,st))
+      continue;
+    ++id;
+    if(id<list.scroll)
+      continue;
+    const auto sz = fnt.textSize(lw,quest.name);
+    if(itY+sz.h>lh+y)
+      break;
+    // Строка выше рисуется от itY; немного запаса вверх и вниз - строки тонкие
+    if(pos.y>=itY && pos.y<itY+sz.h+fnt.pixelSize()/2)
+      return id;
+    itY += sz.h;
+    }
+  return -1;
+  }
