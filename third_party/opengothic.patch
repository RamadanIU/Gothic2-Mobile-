+bool Npc::isRagdollFall() const {
+  // падает, лежит после падения, ловит равновесие после толчка или встаёт телом: ИИ и управление ждут
+  if(ragdoll==nullptr)
+    return false;
+  const auto st = ragdoll->state();
+  return st==Ragdoll::S_Fall || st==Ragdoll::S_Balance || st==Ragdoll::S_GetUp;
+  }
+
+bool Npc::ragdollFallAllowed() const {
+  // Живой падает по физике только человеком: встаёт он анимацией подъёма раненого (на спине и на животе)
+  if(!Gothic::options().ragdollFall || isDown())
+    return false;
+  if(ragdoll!=nullptr && !((ragdoll->state()==Ragdoll::S_Active || ragdoll->state()==Ragdoll::S_Balance) &&
+                            ragdoll->isSimulated() && ragFadeStart==0 && ragBlendStart==0))
+    return false; // на ногах по физике (активный регдолл, ловит равновесие) - падает та же кукла
+  if(interactive()!=nullptr || isSwim() || isDive() || mvAlgo.isClimb())
+    return false;
+  if(!ragdollAllowed())
+    return false;
+  for(auto name:{"S_WOUNDED","S_WOUNDEDB","T_WOUNDED_2_STAND","T_WOUNDEDB_2_STAND"})
+    if(visual.findSequence(name)==nullptr)
+      return false;
+  // под ногами вода - нырнёт, как в игре
+  const auto wr = owner.physic()->waterRay(position(), 0.f);
+  if(wr.hasCol)
+    return false;
+  return true;
+  }
+
+void Npc::startRagdollFall() {
+  if(!ragdollFallAllowed())
+    return;
+  // что было в руке (еда, питьё) - на землю; встав, NPC начнёт своё дело заново
+  dropHandItem(true);
+  ragRiseAt     = 0;
+  ragGetUpUntil = 0;
+  if(ragdoll!=nullptr) {
+    // был на ногах по физике: та же кукла падает - без рывка из позы, в которой его застали
+    ragdoll->setState(Ragdoll::S_Fall);
+    applyRagdollHit();
+    ragFadeStart = 0;
+    ragPushedVer = 0;
+    ragFollowVer = 0;
+    ragAirTime   = 0;
+    mvAlgo.clearFall();
+    Log::i("[g2m] ragdoll: \"",displayName(),"\" ",ragKnock ? "knocked down" : "falls alive");
+    return;
+    }
+  ragKnock = false;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+  auto& pose = visual.pose();
+  const auto root = pose.rootBone();
+  if((Vec3(root.at(3,0),root.at(3,1),root.at(3,2))-position()).length()>500.f)
+    return;
+  float dist = 0;
+  bool  keep = false;
+  ragdollViewDistance(dist,keep);
+  ragdoll = Ragdoll::create(*owner.physic(), *sk, pose.transform(), pose.boneCount(), Ragdoll::S_Fall, dist, keep);
+  if(ragdoll==nullptr)
+    return;
+  Vec3 v = ragVelocity*10.f; // см/мс -> м/с
+  if(v.length()>40.f)
+    v = Vec3();
+  ragdoll->setVelocity(v);
+  applyRagdollHit();
+  ragBlendStart = 0;
+  ragPushedVer  = 0;
+  ragFollowVer  = 0;
+  ragAirTime    = 0;
+  // падение ведёт кукла: урон от удара о землю - по ней (tickRagdollFall), у перемещения анимацией - без падения
+  mvAlgo.clearFall();
+  Log::i("[g2m] ragdoll: \"",displayName(),"\" falls alive, ",int(v.length()+0.5f)," m/s");
+  }
+
+void Npc::tickRagdollFall() {
+  followRagdoll();
+  // удар о землю - урон от падения по правилам игры (MoveAlgo на приземлении): разбился - лежит дальше как
+  // убитый или без сознания (onNoHealth -> startRagdoll меняет состояние куклы)
+  if(const float v = ragdoll->takeImpact(); v>0.f) {
+    takeFallDamage(Vec3(0,-v*0.1f,0)); // м/с -> см/мс
+    if(ragdoll==nullptr || ragdoll->state()!=Ragdoll::S_Fall)
+      return;
+    }
+  // лежит не меньше RagdollFallHold, потом встаёт, как только тело улеглось (или застыло: срок, бюджет, дальность)
+  const uint64_t t       = ragdoll->simulatedTime();
+  const bool     settled = !ragdoll->isAirborne() && (ragdoll->isCalm(300) || ragdoll->isResting() || t>=RagdollFallLimit);
+  const uint64_t hold    = ragKnock ? RagdollKnockHold : RagdollFallHold;
+  if(ragdoll->isSimulated() && (t<hold || !settled))
+    return;
+  ragKnock = false;
+  // встаёт: собирается лёжа, потом - анимация подъёма (ragdollRise)
+  ragdollGetUp();
+  }
