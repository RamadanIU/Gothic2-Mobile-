+  const size_t   AivRoutine  = 99;
+  // aivar[94] героя: Геральт ушёл с ним из Хориниса (в другом мире) - в Хоринисе не создавать заново
+  const size_t   AivHeroGeraltAway = 94;
+
+  const float    NearDist    = 800.f;   // герой подошёл (см)
+  const float    LeftDist    = 2000.f;  // герой ушёл
+  const float    SeeDist     = 2500.f;  // кого и что видит в снимке обстановки
+  const float    ItemDist    = 1500.f;
