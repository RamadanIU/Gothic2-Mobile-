+bool AiNpc::lineStart(Npc& speaker, std::string_view id, bool inDialog) {
+  Line* ln = nullptr;
+  for(auto& l:lines)
+    if(l.id==id)
+      ln = &l;
+  if(ln==nullptr)
+    return false;
+  const uint64_t now = owner.tickCount();
+  ln->started   = true;
+  ln->overlay   = !inDialog;
+  ln->endsAt    = now+ln->ms;
+  ln->shownTill = inDialog ? 0 : now+ln->ms+600;
+
+  // Громкость: в диалоге - полная, вне его - по расстоянию до героя
+  float vol = 1.f;
+  if(!inDialog) {
+    auto* w = world();
+    if(w!=nullptr && w->player()!=nullptr) {
+      const float d = std::sqrt(w->player()->qDistTo(speaker));
+      vol = std::clamp(1.f - (d-500.f)/(HearDist-500.f), 0.f, 1.f);
+      }
+    }
+  char buf[64] = {};
+  std::snprintf(buf,sizeof(buf),"%.2f",double(vol));
+  AiLink::send(std::string("{\"ev\":\"line_start\",\"id\":\"")+std::string(id)+"\",\"vol\":"+buf+"}");
+  return true;
+  }
+
+void AiNpc::skipLines() {
+  const uint64_t now = owner.tickCount();
+  bool any = false;
+  for(auto& l:lines)
+    if(l.started && !l.overlay && l.endsAt>now) {
+      l.endsAt = now;
+      any      = true;
+      }
+  if(any)
+    AiLink::send("{\"ev\":\"line_skip\"}");
+  // «Назад», пока модель молчит: выбор реплик возвращается (можно уйти), ответ придёт позже субтитрами
+  if(!any && busy)
+    busy = false;
+  }
+
+void AiNpc::tickLines(uint64_t now) {
+  for(auto& l:lines) {
+    if(l.endsAt==0 || now<l.endsAt)
+      continue;
+    if(l.started)
+      AiLink::send(std::string("{\"ev\":\"line_end\",\"id\":\"")+l.id+"\"}");
+    else
+      AiLink::send(std::string("{\"ev\":\"line_end\",\"id\":\"")+l.id+"\",\"skipped\":true}");
+    l.endsAt = 0;
+    }
+  // Сказанные реплики - ещё немного для субтитров, несказанные - пока не истекут
+  lines.erase(std::remove_if(lines.begin(),lines.end(),[now](const Line& l){
+    return l.endsAt==0 && now>l.shownTill;
+    }),lines.end());
+  if(lines.size()>64)
+    lines.erase(lines.begin(),lines.begin()+long(lines.size()-64));
+  }
+
+void AiNpc::paint(Painter& p, int w, int h, float scale) {
+  // Субтитры и Геральта, и живых жителей - жители говорят и там, где Геральта нет
+  if(lines.empty())
+    return;
+  auto* wrld = world();
+  if(wrld==nullptr || wrld->player()==nullptr)
+    return;
+  const uint64_t now = owner.tickCount();
+  auto& fnt = Resources::font(Resources::FontType::Yellow,scale);
+  const int pad = int(12*scale);
+  const int bw  = std::min(w-2*pad, int(900*scale));
+  int       y   = h - int(float(h)*0.30f);
+  int       shown = 0;
+  for(auto it=lines.rbegin(); it!=lines.rend() && shown<2; ++it) {
+    auto& l = *it;
+    if(!l.overlay || now>l.shownTill || l.npc==nullptr)
+      continue;
+    if(!npcAlive(l.npc) || wrld->player()->qDistTo(*l.npc)>HearDist*HearDist)
+      continue;
+    const std::string txt = l.speaker + ": " + l.text;
+    auto sz = fnt.textSize(bw,txt);
+    fnt.drawText(p,(w-bw)/2,y-sz.h,bw,sz.h,txt,Tempest::AlignHCenter);
+    y -= sz.h + pad/2;
+    ++shown;
+    }
+  }
+
+void AiNpc::onDialogStart(Npc& player, Npc& npc) {
+  (void)player;
+  if(!isAiNpc(npc))
+    return;
+  talking = true;
+  // Сам не заговаривает: выбор реплик - сразу, говорит герой (прежде модель здоровалась, не дожидаясь героя, и
+  // отвечала так, будто он что-то сказал)
+  busy    = false;
+  // Разговор прерывает дело: стоит лицом к герою
+  cancelBody(geralt,"разговор с героем");
+  rememberInventory();
+  AiLink::send("{\"ev\":\"talk_start\"}");
+  sendSnapshot(npc,"talk");
+  }
+
+void AiNpc::onDialogEnd(Npc* player, Npc* npc) {
+  (void)player;
+  if(!talking || npc==nullptr || !isAiNpc(*npc))
+    return;
+  talking = false;
+  busy    = false;
+  AiLink::send("{\"ev\":\"talk_end\"}");
+  reportTrade();
+  }
+
+void AiNpc::rememberInventory() {
+  tradeBefore.clear();
+  tradeOpened = false;
+  if(geralt==nullptr)
+    return;
+  for(auto it=geralt->inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it)
+    tradeBefore.emplace_back(it->clsId(),it.count());
+  }
+
+void AiNpc::reportTrade() {
+  // Торговля и обмен идут в окне игры - модель узнаёт итог по вещам: что пришло, что ушло, золото
+  if(geralt==nullptr || !tradeOpened)
+    return;
+  tradeOpened = false;
+  std::vector<std::pair<size_t,size_t>> now;
+  for(auto it=geralt->inventory().iterator(Inventory::T_Inventory); it.isValid(); ++it)
+    now.emplace_back(it->clsId(),it.count());
+  const size_t gold = owner.findSymbolIndex("ITMI_GOLD");
+  auto countIn = [](const std::vector<std::pair<size_t,size_t>>& v, size_t cls) {
+    size_t n = 0;
+    for(auto& [c,k]:v)
+      if(c==cls)
+        n += k;
+    return n;
+    };
+  std::string got, gave;
+  // Ушедшего у Геральта уже нет - имя по вещи героя
+  Npc* pl = world()!=nullptr ? world()->player() : nullptr;
+  auto name = [&](size_t cls) -> std::string {
+    const Item* it  = geralt->getItem(cls);
+    if(it==nullptr && pl!=nullptr)
+      it = pl->getItem(cls);
+    auto*       sym = owner.findSymbol(cls);
+    std::string id  = sym!=nullptr ? std::string(sym->name()) : std::string();
+    if(it!=nullptr)
+      return fromCp1251(it->displayName())+(id.empty() ? std::string() : " ["+id+"]");
+    return id.empty() ? std::string("?") : id;
+    };
+  std::vector<size_t> all;
+  for(auto& [c,k]:tradeBefore)
+    all.push_back(c);
+  for(auto& [c,k]:now)
+    all.push_back(c);
+  std::sort(all.begin(),all.end());
+  all.erase(std::unique(all.begin(),all.end()),all.end());
+  int64_t goldDiff = 0;
+  for(auto cls:all) {
+    const int64_t a = int64_t(countIn(tradeBefore,cls)), b = int64_t(countIn(now,cls));
+    if(a==b)
+      continue;
+    if(cls==gold) {
+      goldDiff = b-a;
+      continue;
+      }
+    const std::string n = name(cls);
+    auto& out = b>a ? got : gave;
+    if(out.size()<400)
+      out += (out.empty() ? "" : ", ")+n+(std::abs(b-a)>1 ? " x"+std::to_string(std::abs(b-a)) : std::string());
+    }
+  if(got.empty() && gave.empty() && goldDiff==0)
+    return;
+  std::string text = "Обмен с героем закончен.";
+  if(!got.empty())
+    text += " Ты получил: "+got+".";
+  if(!gave.empty())
+    text += " Ты отдал: "+gave+".";
+  if(goldDiff>0)
+    text += " Золота стало больше на "+std::to_string(goldDiff)+".";
+  else if(goldDiff<0)
+    text += " Золота стало меньше на "+std::to_string(-goldDiff)+".";
+  sendEvent("trade",text,nullptr);
+  }
+
+void AiNpc::endDialog() {
+  auto* w = world();
+  if(geralt==nullptr || w==nullptr || !talking)
+    return;
+  // После всех реплик в очереди, как AI_StopProcessInfos скриптов
+  geralt->aiPush(AiQueue::aiStopProcessInfo(owner.aiOutOrderId));
+  ++owner.aiOutOrderId;
+  }
+
+bool AiNpc::dialogChoices(Npc& player, Npc& npc, std::vector<GameScript::DlgChoice>& out) {
+  (void)player;
+  if(!isAiNpc(npc) || !AiLink::enabled())
+    return false;
+  out.clear();
+  auto add = [&out](uint32_t id, const char* title, int32_t sort, bool trade, bool free) {
+    GameScript::DlgChoice ch;
+    ch.title     = toCp1251(title);
+    ch.scriptFn  = id;
+    ch.sort      = sort;
+    ch.isTrade   = trade;
+    ch.freeTrade = free;
+    out.push_back(std::move(ch));
+    };
+  add(ChoiceVoice,"Сказать (голосом)",1,false,false);
+  add(ChoiceType, "Написать",2,false,false);
+  add(ChoiceTrade,"Покажи свои товары.",3,true,false);
+  // Идёт с героем - вещами меняются даром, как с напарниками: отдать ему доспехи, меч, зелья
+  if(owner.isPartyMember(npc))
+    add(ChoiceSwap,"Давай обменяемся вещами.",4,true,true);
+  add(ChoiceBye,  "Пока.",999,false,false);
+  return true;
+  }
+
+bool AiNpc::exec(const GameScript::DlgChoice& dlg, Npc& player, Npc& npc) {
+  (void)player;
+  if(!isAiNpc(npc))
+    return false;
+  switch(dlg.scriptFn) {
+    case ChoiceVoice:
+      busy      = true;
+      busyUntil = owner.tickCount()+BusyMax;
+      AiLink::send("{\"ev\":\"listen\"}");
+      return true;
+    case ChoiceType:
+      busy      = true;
+      busyUntil = owner.tickCount()+BusyMax;
+      AiLink::send("{\"ev\":\"type\"}");
+      return true;
+    case ChoiceTrade:
+    case ChoiceSwap:
+      // Торговлю открывает DialogMenu (isTrade); итог - событием в конце разговора (reportTrade)
+      tradeOpened = true;
+      return true;
+    case ChoiceBye:
+      AiLink::send("{\"ev\":\"bye\"}");
+      endDialog();
+      return true;
+    default:
+      return false;
+    }
+  }
+
+void AiNpc::beforeSave() {
+  if(geralt==nullptr || !AiLink::enabled())
+    return;
+  auto& h = geralt->handle();
+  std::random_device rd;
+  h.aivar[AivToken] = std::max(int32_t(rd() & 0x3FFFFFFFu),1);
+  // Приложение пишет память под этой меткой сразу, в этом же вызове: сохранение и память совпадают
+  AiLink::send(std::string("{\"ev\":\"saving\",\"story\":")+std::to_string(h.aivar[AivStory])+
+               ",\"token\":"+std::to_string(h.aivar[AivToken])+"}");
+  }
+
+void AiNpc::sendReady() {
+  Log::i("[g2m] ai: ready story=",geralt->handle().aivar[AivStory]," token=",geralt->handle().aivar[AivToken]);
+  // load=1 - первый раз за сеанс игры (новая игра или загрузка сохранения): приложение читает память
+  // этого сохранения; потом (смена мира и обратно) - память сеанса остаётся
+  auto& h = geralt->handle();
+  AiLink::send(std::string("{\"ev\":\"ready\",\"story\":")+std::to_string(h.aivar[AivStory])+
+               ",\"token\":"+std::to_string(h.aivar[AivToken])+",\"load\":"+(sessionReady ? "0" : "1")+"}");
+  sessionReady = true;
+  }
