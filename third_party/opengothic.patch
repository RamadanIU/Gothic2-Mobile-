@@ -0,0 +1,135 @@
+#include "gamescript.h"
+
+#include <Tempest/Log>
+
+#include <algorithm>
+#include <string>
+
+#include "world/objects/interactive.h"
+#include "world/objects/npc.h"
+#include "world/aiqueue.h"
+#include "utils/cp1251.h"
+#include "gothic.h"
+
+// Gothic II Mobile: жарка мяса.
+// В игре сковорода (useWithItem = ItFoMuttonRaw) за один подход меняет один сырой кусок на жареный: анимация
+// с событием DEF_EXCHANGE_ITEM. Если сырых кусков несколько, у сковороды открывается диалог героя с собой - как
+// у кузницы и стола рун (AI_ProcessInfos(hero)): «один кусок», «5», «10», «всё мясо». Один кусок по-прежнему
+// жарит анимация, остальные меняются в сумке сразу после неё. Если анимация уже пожарила кусок до выбора -
+// он входит в выбранное число. «Назад» в диалоге - как в игре: один кусок.
+
+static std::string cookTitle(uint32_t n, uint32_t all) {
+  if(n==1)
+    return toCp1251("Пожарить один кусок");
+  if(n==all)
+    return toCp1251("Пожарить всё мясо (") + std::to_string(all) + toCp1251(" шт.)");
+  return toCp1251("Пожарить ") + std::to_string(n) + toCp1251(" кусков");
+  }
+
+void GameScript::cookOffer(Npc& player, Interactive& mob) {
+  const size_t raw = findSymbolIndex("ITFOMUTTONRAW");
+  if(raw==size_t(-1) || findSymbolIndex(mob.useItemName())!=raw)
+    return;
+  if(cooking.mob!=&mob) {
+    cooking     = Cooking();
+    cooking.mob = &mob;
+    cooking.raw = raw;
+    }
+  if(cooking.offered)
+    return;
+  cooking.offered = true;
+
+  const size_t all = player.itemCount(raw) + cooking.exchanged;
+  if(all<2)
+    return;
+  // Прежний выбор у другого места (кузница, алхимия) не должен подмешать свои реплики
+  if(auto s = vm.find_symbol_by_name("PLAYER_MOBSI_PRODUCTION"))
+    s->set_int(scriptConst("MOBSI_NONE",0));
+  player.aiPush(AiQueue::aiProcessInfo(player));
+  }
+
+void GameScript::cookChoices(Npc& player, std::vector<DlgChoice>& out) {
+  if(cooking.mob==nullptr || cooking.chosen || player.interactive()!=cooking.mob)
+    return;
+  const uint32_t all = uint32_t(std::min<size_t>(player.itemCount(cooking.raw) + cooking.exchanged, 0xFFFF));
+  if(all<2)
+    return;
+  auto add = [&out,all](uint32_t n) {
+    DlgChoice ch;
+    ch.title    = cookTitle(n,all);
+    ch.scriptFn = CookChoice + n;
+    ch.sort     = int32_t(n);
+    out.push_back(std::move(ch));
+    };
+  for(uint32_t n:{1u, 5u, 10u})
+    if(n<all)
+      add(n);
+  add(all);
+  }
+
+static uint32_t cookConvert(Npc& player, size_t raw, size_t product, uint32_t n) {
+  n = uint32_t(std::min<size_t>(n, player.itemCount(raw)));
+  if(n==0 || product==size_t(-1))
+    return 0;
+  player.delItem(raw,n);
+  player.addItem(product,n);
+  return n;
+  }
+
+bool GameScript::execCook(const DlgChoice& dlg, Npc& player) {
+  if((dlg.scriptFn & 0xFFFF0000u)!=CookChoice || cooking.mob==nullptr)
+    return false;
+  const uint32_t n = std::max<uint32_t>(dlg.scriptFn & 0xFFFFu, 1);
+  cooking.chosen = true;
+  if(cooking.exchanged>0) {
+    // Анимация уже пожарила свой кусок: остальное - сразу
+    const size_t product = cooking.product!=size_t(-1) ? cooking.product : findSymbolIndex("ITFOMUTTON");
+    if(n>cooking.exchanged)
+      cooking.done += cookConvert(player,cooking.raw,product,n-cooking.exchanged);
+    } else {
+    cooking.extra = n-1;
+    }
+  Tempest::Log::i("[g2m] cooking: ",n," of ",player.itemCount(cooking.raw)+cooking.exchanged);
+  // Конец диалога, как B_ENDPRODUCTIONDIALOG: DialogMenu::close уводит героя от сковороды
+  player.aiPush(AiQueue::aiStopProcessInfo(aiOutOrderId));
+  ++aiOutOrderId;
+  return true;
+  }
+
+void GameScript::cookExchanged(Npc& player, std::string_view product) {
+  auto mob = player.interactive();
+  if(mob==nullptr)
+    return;
+  const size_t raw = findSymbolIndex("ITFOMUTTONRAW");
+  if(raw==size_t(-1) || findSymbolIndex(mob->useItemName())!=raw)
+    return;
+  if(cooking.mob!=mob) {
+    // Кусок пожарен ещё до выбора (событие в анимации подхода)
+    cooking     = Cooking();
+    cooking.mob = mob;
+    cooking.raw = raw;
+    }
+  cooking.exchanged++;
+  cooking.product = findSymbolIndex(product);
+  if(cooking.extra>0) {
+    cooking.done += cookConvert(player,cooking.raw,cooking.product,cooking.extra);
+    cooking.extra = 0;
+    }
+  }
+
+void GameScript::cookFinish(Npc& player) {
+  if(cooking.mob==nullptr)
+    return;
+  if(player.interactive()!=cooking.mob) {
+    cooking = Cooking();
+    return;
+    }
+  if(cooking.chosen && cooking.exchanged==0) {
+    // Анимация кусок так и не поменяла - всё выбранное сразу
+    cooking.done += cookConvert(player,cooking.raw,findSymbolIndex("ITFOMUTTON"),cooking.extra+1);
+    }
+  const uint32_t total = cooking.exchanged + cooking.done;
+  if(cooking.chosen && total>1)
+    Gothic::inst().onPrint(toCp1251("Пожарено мяса: ") + std::to_string(total) + toCp1251(" шт."));
+  cooking = Cooking();
+  }
