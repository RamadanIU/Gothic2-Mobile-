+bool GameMenu::openLogList(Item& list) {
+  const int32_t num = numQuests(Gothic::inst().questLog(),toStatus(list.handle->user_string[0]));
+  if(num<=0)
+    return false;
+  if(logList!=&list) {
+    if(logList==nullptr)
+      logPrev = curItem;
+    logList    = &list;
+    freeScroll = nullptr;
+    curItem    = indexOf(list); // подсветка строки - у выделенного списка (drawQuestList)
+    }
+  list.value = std::clamp(list.value,0,num-1);
+  update();
+  return true;
+  }
