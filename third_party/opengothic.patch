+  // Колесо открыто и ждёт выбора: касание выбирает или закрывает его
+  if(wheel!=Wheel::None && wheelOwner<0) {
+    applyWheel(wheelPickAt(e.pos()));
+    closeWheel();
+    f.ctl = C_Absorb;
+    return;
+    }
+
+  Ctl c = hitTest(e.pos());
+  if(c==C_None) {
+    switch(ui) {
+      case Ui::World: {
+        // Левая часть экрана ниже полосок - джойстик, остальное - обзор
+        const int top = int(64*dp());
+        c = (e.x<w()*45/100 && e.y>top) ? C_Joy : C_Look;
+        break;
+        }
+      case Ui::Dialog:
+        c = C_List;
+        break;
+      case Ui::Inventory:
+        c = owner.touchInventoryGrid(e.pos()) ? C_List : C_Absorb;
+        break;
+      case Ui::Hidden:
+      case Ui::Document:
+      case Ui::LockPick:
+      case Ui::Skip:
+        // Касание мимо кнопок поглощается: случайный тап ничего не сделает
+        c = C_Absorb;
+        break;
+      }
+    }
+
+  f.ctl = c;
+  if(c==C_Joy)
+    joyRun = false;
+  press(c, f);
+  if(c!=C_Joy && c!=C_Look && c!=C_List && c!=C_Absorb)
+    timer.start(40);
+  update();
+  }
+
+void TouchInput::mouseDragEvent(MouseEvent& e) {
+  if(e.mouseID<0 || size_t(e.mouseID)>=fingers.size())
+    return;
+  auto&      f   = fingers[size_t(e.mouseID)];
+  const auto pos = e.pos();
+  const float d  = dp();
+  const int  dx  = pos.x-f.start.x;
+  const int  dy  = pos.y-f.start.y;
+  if(!f.moved && dx*dx+dy*dy>int(12*d)*int(12*d))
+    f.moved = true;
+
+  switch(f.ctl) {
+    case C_Joy:
+      joystick(f, pos);
+      break;
+    case C_Look:
+      owner.touchLook(pos.x-f.last.x, pos.y-f.last.y);
+      break;
+    case C_Main: {
+      // Свайп вбок по главной кнопке: в ближнем бою - боковой удар, с луком и магией - другая цель
+      if(std::abs(dx)>int(36*d) && std::abs(dx)>std::abs(dy)) {
+        auto pl = Gothic::inst().player();
+        const auto ws = pl!=nullptr ? pl->weaponState() : WeaponState::NoWeapon;
+        if(ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H)
+          ctrl.touchSideAttack(dx<0 ? -1 : 1);
+        else if(ws!=WeaponState::NoWeapon)
+          ctrl.touchSwitchTarget(dx<0 ? -1 : 1);
+        f.start = pos;
+        }
+      break;
+      }
+    case C_Weapon:
+    case C_Squad: {
+      // Потянуть кнопку - открыть колесо и выбрать направлением пальца
+      const auto kind = (f.ctl==C_Weapon ? Wheel::Weapon : Wheel::Squad);
+      if(wheel==Wheel::None && f.moved)
+        openWheel(kind, e.mouseID);
+      if(wheel==kind && wheelOwner==e.mouseID)
+        wheelSel = wheelPickDir(pos-f.start);
+      break;
+      }
+    case C_List: {
+      // Палец вверх-вниз по сетке сумки - листать
+      if(currentUi()==Ui::Inventory) {
+        const int row = std::max(1, owner.touchInventoryRow());
+        f.accum += pos.y-f.last.y;
+        while(f.accum<=-row) {
+          owner.touchInventoryScroll(1);
+          f.accum += row;
+          }
+        while(f.accum>=row) {
+          owner.touchInventoryScroll(-1);
+          f.accum -= row;
+          }
+        }
+      break;
+      }
+    default:
+      break;
+    }
+  f.last = pos;
+  update();
+  }
+
+void TouchInput::mouseUpEvent(MouseEvent& e) {
+  if(e.mouseID<0 || size_t(e.mouseID)>=fingers.size())
+    return;
+  auto& f = fingers[size_t(e.mouseID)];
+  release(f.ctl, f, e.pos());
+  f = Finger();
+  update();
+  }
+
+void TouchInput::joystick(Finger& f, Point pos) {
+  // Вперёд/назад и вбок - отдельные оси с мёртвой зоной, как стрелки клавиатуры в Gothic.
+  // Чуть сдвинут - шаг, дальше - бег (с запасом, чтобы не дёргалось на границе)
+  const float R   = 56*dp();
+  float       dx  = float(pos.x-f.start.x)/R;
+  float       dy  = float(pos.y-f.start.y)/R;
+  const float len = std::sqrt(dx*dx+dy*dy);
+  if(len>1.5f) {
+    // Палец ушёл далеко - центр джойстика едет следом: смена направления без возврата пальца
+    const float k = (len-1.5f)/len;
+    f.start.x += int(float(pos.x-f.start.x)*k);
+    f.start.y += int(float(pos.y-f.start.y)*k);
+    dx = float(pos.x-f.start.x)/R;
+    dy = float(pos.y-f.start.y)/R;
+    }
+  if(joyRun && len<0.5f)
+    joyRun = false;
+  else if(!joyRun && len>0.68f)
+    joyRun = true;
+  const int fw = dy<-0.3f ? 1 : (dy>0.3f ? -1 : 0);
+  const int sd = dx<-0.45f ? -1 : (dx>0.45f ? 1 : 0);
+  ctrl.setTouchMove(fw, sd, joyRun);
+  }
+
+void TouchInput::tapWorld(Point p) {
+  // Касание по NPC - выбрать цель (для боя и приказа отряду), мимо - снять выбор
+  auto world = Gothic::inst().world();
+  auto pl    = world!=nullptr ? world->player() : nullptr;
+  auto cam   = Gothic::inst().camera();
+  if(pl==nullptr || cam==nullptr)
+    return;
+  const auto  vp   = cam->viewProj();
+  const float maxD = 48*dp();
+  const float sw   = float(w()), sh = float(h());
+  Npc*        best = nullptr;
+  float       bD   = maxD*maxD;
+  auto toScreen = [&](Vec3 v, Point& out) {
+    float pw = 1.f;
+    vp.project(v.x,v.y,v.z,pw);
+    if(pw<=0.f)
+      return false;
+    v /= pw;
+    out = Point(int((0.5f*v.x+0.5f)*sw), int((0.5f*v.y+0.5f)*sh));
+    return true;
+    };
+  world->detectNpc(pl->position(), 3000, [&](Npc& n) {
+    if(&n==pl || n.isDead())
+      return;
+    Point a, b;
+    if(!toScreen(n.displayPosition(),a) || !toScreen(n.position(),b))
+      return;
+    // расстояние от пальца до отрезка «голова - ноги» на экране
+    const float ex = float(b.x-a.x), ey = float(b.y-a.y);
+    const float ee = ex*ex+ey*ey;
+    float t = ee>0 ? (float(p.x-a.x)*ex+float(p.y-a.y)*ey)/ee : 0.f;
+    t = std::clamp(t,0.f,1.f);
+    const float qx = float(a.x)+ex*t-float(p.x), qy = float(a.y)+ey*t-float(p.y);
+    const float qd = qx*qx+qy*qy;
+    if(qd<bD) {
+      bD   = qd;
+      best = &n;
+      }
+    });
+  if(best!=nullptr && !pl->canSeeNpc(*best,true))
+    best = nullptr;
+  ctrl.setTouchTarget(best);
+  }
+
+void TouchInput::press(Ctl c, Finger& f) {
+  (void)f;
+  switch(c) {
+    case C_Main:
+      ctrl.setTouchAttack(true);
+      break;
+    case C_Block:
+      ctrl.setTouchBlock(true);
+      break;
+    case C_Jump:
+      ctrl.onKeyPressed(KeyCodec::Jump, Event::K_NoKey, KeyCodec::Mapping::Primary);
+      break;
+    case C_Auto:
+      ctrl.setAutoFight(!ctrl.isAutoFight());
+      Gothic::inst().onPrint(toCp1251(ctrl.isAutoFight() ? "Автобой включён" : "Автобой выключен"));
+      break;
+    case C_Gather:
+      if(ctrl.isGathering())
+        ctrl.stopGather(false); else
+        ctrl.startGather();
+      break;
+    case C_Sneak:
+      ctrl.toggleSneak();
+      break;
+    case C_Bag:
+      owner.touchMenu(KeyCodec::Inventory);
+      break;
+    case C_Log:
+      owner.touchMenu(KeyCodec::Log);
+      break;
+    case C_Hero:
+      owner.touchMenu(KeyCodec::Status);
+      break;
+    case C_Up:
+    case C_Down:
+    case C_Left:
+    case C_Right:
+      sendNav(c);
+      // Держать стрелку - листать список
+      if(c==C_Up || c==C_Down) {
+        repeatCtl  = c;
+        repeatNext = Application::tickCount()+400;
+        }
+      break;
+    case C_Select:
+      if(currentUi()==Ui::Inventory)
+        owner.touchInventoryDo(); else
+        owner.touchKey(Event::K_Return);
+      break;
+    case C_Back:
+      // Взлом: «назад» - отойти от замка; иначе - Esc (в диалоге - пропуск реплики)
+      if(currentUi()==Ui::LockPick)
+        owner.touchKey(Event::K_Down); else
+        owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_Skip:
+      owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_TakeAll:
+      owner.touchTakeAll();
+      break;
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_List:
+    case C_Absorb:
+    case C_Weapon:
+    case C_Potion:
+    case C_Squad:
+    case C_Map:
+    case C_Menu:
+    case C_Count:
+      break;
+    }
+  }
+
+void TouchInput::release(Ctl c, Finger& f, Point pos) {
+  const uint64_t dt = Application::tickCount()-f.downAt;
+  switch(c) {
+    case C_Joy:
+      ctrl.setTouchMove(0, 0, true);
+      break;
+    case C_Look:
+      if(!f.moved && dt<300 && currentUi()==Ui::World)
+        tapWorld(pos);
+      break;
+    case C_Main:
+      ctrl.setTouchAttack(false);
+      break;
+    case C_Block:
+      ctrl.setTouchBlock(false);
+      break;
+    case C_Jump:
+      ctrl.onKeyReleased(KeyCodec::Jump, KeyCodec::Mapping::Primary);
+      break;
+    case C_Weapon: {
+      const int id = int(&f-fingers.data());
+      if(wheel==Wheel::Weapon && wheelOwner==id) {
+        if(wheelSel>=0) {
+          applyWheel(wheelSel);
+          closeWheel();
+          }
+        else if(!f.moved) {
+          wheelOwner = -1; // открыли удержанием - колесо ждёт касания
+          }
+        else {
+          closeWheel();
+          }
+        }
+      else if(!f.held) {
+        // Коснуться - достать последнее оружие или убрать
+        ctrl.onKeyPressed (KeyCodec::Weapon, Event::K_NoKey, KeyCodec::Mapping::Primary);
+        ctrl.onKeyReleased(KeyCodec::Weapon, KeyCodec::Mapping::Primary);
+        }
+      break;
+      }
+    case C_Squad: {
+      const int id = int(&f-fingers.data());
+      if(wheel==Wheel::Squad && wheelOwner==id && wheelSel>=0) {
+        applyWheel(wheelSel);
+        closeWheel();
+        }
+      else if(wheel==Wheel::Squad && wheelOwner==id) {
+        wheelOwner = -1;
+        }
+      else if(wheel==Wheel::None) {
+        openWheel(Wheel::Squad, -1);
+        }
+      break;
+      }
+    case C_Potion:
+      if(!f.held && !ctrl.drinkHealPotion())
+        Gothic::inst().onPrint(toCp1251("Нет зелий лечения"));
+      break;
+    case C_Map:
+      ctrl.onKeyPressed (KeyCodec::Map, Event::K_NoKey, KeyCodec::Mapping::Primary);
+      ctrl.onKeyReleased(KeyCodec::Map, KeyCodec::Mapping::Primary);
+      break;
+    case C_Menu:
+      if(!f.held)
+        owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_Up:
+    case C_Down:
+      if(repeatCtl==c)
+        repeatCtl = C_None;
+      break;
+    case C_List:
+      if(currentUi()==Ui::Inventory) {
+        if(!f.moved)
+          owner.touchInventoryDown(pos);
+        owner.touchInventoryUp();
+        }
+      else if(currentUi()==Ui::Dialog && !f.moved) {
+        owner.touchDialogTap(pos);
+        }
+      break;
+    default:
+      break;
+    }
   }
 
