+void MdlVisual::addStuck(MeshObjects::Mesh&& arrow, size_t boneId, const Tempest::Matrix4x4& matrix, uint64_t until) {
+  // Стрела в теле идёт за своей костью (анимация, отклик тела, падение куклы); старые - уступают место
+  if(boneId>=skInst->boneCount() || arrow.isEmpty())
+    return;
+  if(stuck.size()>=RangedAim::MaxStuck)
+    stuck.erase(stuck.begin());
+  StuckSlot s;
+  s.view   = std::move(arrow);
+  s.boneId = boneId;
+  s.local  = skInst->bone(boneId);
+  s.local.inverse();
+  s.local.mul(matrix);
+  s.until  = until;
+  s.view.setObjMatrix(matrix);
+  stuck.push_back(std::move(s));
+  }
+
+void MdlVisual::tickStuck(uint64_t now) {
+  if(stuck.empty())
+    return;
+  stuck.erase(std::remove_if(stuck.begin(),stuck.end(),[now](const StuckSlot& s){ return s.until<=now; }),stuck.end());
+  }
