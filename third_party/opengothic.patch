+  // «Вперёд» модели в позе привязки - куда смотрят носки стоп (у Biped пальцы ног - потомки стопы); без стоп - +Z
+  Vec3 forward() const {
+    Vec3 f = {};
+    for(size_t i=0; i<n; ++i) {
+      if(kind[i]!=K_Foot)
+        continue;
+      for(auto c:child[i]) {
+        std::string nm(sk.nodes[c].name);
+        for(auto& ch:nm)
+          ch = char(std::toupper(static_cast<unsigned char>(ch)));
+        if(!has(nm,"TOE"))
+          continue;
+        const Vec3 d = pos[c]-pos[i];
+        f += Vec3(d.x,0,d.z);
+        }
+      }
+    if(f.length()<0.02f*S)
+      return Vec3(0,0,1);
+    return Vec3::normalize(f);
+    }
