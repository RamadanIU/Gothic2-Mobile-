+bool AiNpc::lineStart(Npc& speaker, std::string_view id, bool inDialog) {
+  Line* ln = nullptr;
+  for(auto& l:lines)
+    if(l.id==id)
+      ln = &l;
+  if(ln==nullptr)
+    return false;
+  const uint64_t now = owner.tickCount();
+  const bool wasStarted = ln->started;
+  ln->started   = true;
+  ln->overlay   = !inDialog;
+  ln->endsAt    = now+ln->ms;
+  ln->shownTill = inDialog ? 0 : now+ln->ms+600;
+  // Сказанное вслух слышат люди рядом (сказанное лично - нет): они запомнят, о чём говорили при них
+  if(!wasStarted && !ln->priv)
+    sendHeard(speaker,ln->to!=nullptr && npcAlive(ln->to) ? ln->to : nullptr,fromCp1251(ln->text),true);
+
+  // Громкость: в диалоге - полная, вне его - по расстоянию до героя
+  float vol = 1.f;
+  if(!inDialog) {
+    auto* w = world();
+    if(w!=nullptr && w->player()!=nullptr) {
+      const float d = std::sqrt(w->player()->qDistTo(speaker));
+      vol = std::clamp(1.f - (d-500.f)/(HearDist-500.f), 0.f, 1.f);
+      }
+    }
+  char buf[64] = {};
+  std::snprintf(buf,sizeof(buf),"%.2f",double(vol));
+  AiLink::send(std::string("{\"ev\":\"line_start\",\"id\":\"")+std::string(id)+"\",\"vol\":"+buf+"}");
+  return true;
+  }
+
+void AiNpc::skipLines() {
+  const uint64_t now = owner.tickCount();
+  bool any = false;
+  for(auto& l:lines)
+    if(l.started && !l.overlay && l.endsAt>now) {
+      l.endsAt = now;
+      any      = true;
+      }
+  if(any)
+    AiLink::send("{\"ev\":\"line_skip\"}");
+  // «Назад», пока модель молчит: выбор реплик возвращается (можно уйти), ответ придёт позже субтитрами
+  if(!any && busy)
+    busy = false;
+  }
+
+void AiNpc::onOutput(Npc& speaker, Npc* target, std::string_view msg) {
+  if(!AiLink::enabled() || msg.empty())
+    return;
+  // Реплики модели - в lineStart: там известно, сказано ли лично
+  if(msg.size()>7 && equalsNoCase(msg.substr(0,7),"G2M_AI_"))
+    return;
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr || w->player()->qDistTo(speaker)>IncidentDist*IncidentDist)
+    return;
+  const auto txt = owner.messageByName(msg);
+  if(txt.empty())
+    return;
+  sendHeard(speaker,target,fromCp1251(txt),false);
+  }
+
+void AiNpc::sendHeard(Npc& speaker, Npc* to, std::string_view text, bool ai) {
+  // Кто что слышал: говорящий, кому сказано и кто ещё рядом (люди в 10 м). Приложение пишет это в память: жителю,
+  // который говорил сам (и в родном диалоге с героем), - в его беседы, остальным - «слышал рядом». Прежде NPC не
+  // знали, о чём говорили у них под носом
+  if(text.empty())
+    return;
+  std::vector<Npc*> near;
+  listeners(speaker,to,HearRange,near);
+  const bool resident = (!speaker.isPlayer() && !speaker.isMonster()) ||
+                        (to!=nullptr && !to->isPlayer() && !to->isMonster());
+  // Реплики модели участники запоминают сами (приложение); родная реплика нужна и без слушателей - её запомнит житель
+  if(near.empty() && (ai || !resident))
+    return;
+  Npc* prevSelf = refSelf;
+  refSelf = nullptr; // self - Геральт
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  auto person = [&](Npc& n) {
+    j.StartObject();
+    put(j,"ref",refOf(n));
+    if(!n.isPlayer()) {
+      put(j,"id",npcId(n));
+      put(j,"name",fromCp1251(n.displayName()));
+      if(n.handle().voice==16 || n.handle().voice==17)
+        put(j,"female",1);
+      } else {
+      put(j,"name","Герой");
+      }
+    j.EndObject();
+    };
+  j.StartObject();
+  put(j,"ev","heard");
+  if(ai)
+    put(j,"ai",1);
+  j.Key("speaker");
+  person(speaker);
+  if(to!=nullptr && to!=&speaker) {
+    j.Key("to");
+    person(*to);
+    }
+  put(j,"text",cutText(text,500));
+  j.Key("near");
+  j.StartArray();
+  for(auto* n:near)
+    person(*n);
+  j.EndArray();
+  j.EndObject();
+  refSelf = prevSelf;
+  AiLink::send(buf.GetString());
+  }
+
+void AiNpc::tickLines(uint64_t now) {
+  for(auto& l:lines) {
+    if(l.endsAt==0 || now<l.endsAt)
+      continue;
+    if(l.started)
+      AiLink::send(std::string("{\"ev\":\"line_end\",\"id\":\"")+l.id+"\"}");
+    else
+      AiLink::send(std::string("{\"ev\":\"line_end\",\"id\":\"")+l.id+"\",\"skipped\":true}");
+    l.endsAt = 0;
+    }
+  // Сказанные реплики - ещё немного для субтитров, несказанные - пока не истекут
+  lines.erase(std::remove_if(lines.begin(),lines.end(),[now](const Line& l){
+    return l.endsAt==0 && now>l.shownTill;
+    }),lines.end());
+  if(lines.size()>64)
+    lines.erase(lines.begin(),lines.begin()+long(lines.size()-64));
+  }
+
+void AiNpc::paint(Painter& p, int w, int h, float scale) {
+  // Субтитры и Геральта, и живых жителей - жители говорят и там, где Геральта нет
+  if(lines.empty())
+    return;
+  auto* wrld = world();
+  if(wrld==nullptr || wrld->player()==nullptr)
+    return;
+  const uint64_t now = owner.tickCount();
+  auto& fnt = Resources::font(Resources::FontType::Yellow,scale);
+  const int pad = int(12*scale);
+  const int bw  = std::min(w-2*pad, int(900*scale));
+  int       y   = h - int(float(h)*0.30f);
+  int       shown = 0;
+  for(auto it=lines.rbegin(); it!=lines.rend() && shown<2; ++it) {
+    auto& l = *it;
+    if(!l.overlay || now>l.shownTill || l.npc==nullptr)
+      continue;
+    if(!npcAlive(l.npc) || wrld->player()->qDistTo(*l.npc)>HearDist*HearDist)
+      continue;
+    const std::string txt = l.speaker + ": " + l.text;
+    auto sz = fnt.textSize(bw,txt);
+    fnt.drawText(p,(w-bw)/2,y-sz.h,bw,sz.h,txt,Tempest::AlignHCenter);
+    y -= sz.h + pad/2;
+    ++shown;
+    }
+  }
