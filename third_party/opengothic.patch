+TouchInput::MainCtx TouchInput::mainContext() const {
+  MainCtx ret;
+  auto pl = Gothic::inst().player();
+  if(pl==nullptr)
+    return ret;
+  switch(pl->weaponState()) {
+    case WeaponState::NoWeapon: {
+      const auto f = pl->world().validateFocus(ctrl.focus());
+      if(f.npc!=nullptr && !f.npc->isDown()) {
+        ret.icon  = TouchIcons::I_Talk;
+        ret.label = toCp1251("Говорить");
+        }
+      else if(f.npc!=nullptr) {
+        ret.icon  = TouchIcons::I_Hand;
+        ret.label = toCp1251("Обыскать");
+        }
+      else if(f.item!=nullptr) {
+        ret.icon  = TouchIcons::I_Hand;
+        ret.label = toCp1251("Взять");
+        }
+      else if(f.interactive!=nullptr) {
+        ret.icon  = f.interactive->isContainer() ? TouchIcons::I_Sack : TouchIcons::I_Use;
+        ret.label = toCp1251(f.interactive->isContainer() ? "Открыть" : "Использовать");
+        }
+      else {
+        ret.icon  = TouchIcons::I_Hand;
+        ret.label = toCp1251("Действие");
+        ret.dim   = true;
+        }
+      break;
+      }
+    case WeaponState::Fist:
+      ret.icon  = TouchIcons::I_Fist;
+      ret.label = toCp1251("Удар");
+      break;
+    case WeaponState::W1H:
+    case WeaponState::W2H:
+      if(auto tg = pl->target(); tg!=nullptr && !pl->isAttackAnim() && pl->canFinish(*tg)) {
+        ret.icon  = TouchIcons::I_Finish;
+        ret.label = toCp1251("Добить");
+        } else {
+        ret.icon  = TouchIcons::I_Sword;
+        ret.label = toCp1251("Удар");
+        }
+      break;
+    case WeaponState::Bow:
+    case WeaponState::CBow:
+      ret.icon  = pl->weaponState()==WeaponState::CBow ? TouchIcons::I_Crossbow : TouchIcons::I_Bow;
+      ret.label = toCp1251(pl->hasAmmunition() ? "Выстрел" : "Нет стрел");
+      ret.dim   = !pl->hasAmmunition();
+      break;
+    case WeaponState::Mage: {
+      auto spl  = pl->inventory().activeWeapon();
+      ret.icon  = (spl!=nullptr && !spl->isRune()) ? TouchIcons::I_Scroll : TouchIcons::I_Rune;
+      ret.label = spl!=nullptr ? std::string(spl->displayName()) : toCp1251("Магия");
+      break;
+      }
+    }
+  return ret;
+  }
