+      float         damage   = 0;        // доля здоровья, снятая ударом (0..1): сила отклика
+      uint8_t       kind     = H_Melee;
+      uint8_t       freeArms = 3;        // свободные руки (бит 0 - левая, бит 1 - правая): прикрыться ими
