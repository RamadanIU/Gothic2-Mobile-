+  gatherOn    = true;
+  gatherTaken = 0;
+  gatherItem  = nullptr;
+  gatherBody  = nullptr;
+  gatherSkip.clear();
+  gatherDeadline = w->tickCount()+7000;
+  Tempest::Log::i("[g2m] gather: start");
