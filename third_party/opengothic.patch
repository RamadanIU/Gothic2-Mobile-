+std::string AiNpc::incidentText(const Incident& in, uint64_t now) {
+  // Для событий самого Геральта: «тебя сбил с ног Мика кулаками»
+  (void)now;
+  std::string by = in.byHero ? std::string("герой") : in.byName;
+  if(by.empty())
+    return {};
+  return by+(in.weapon.empty() ? std::string() : " "+in.weapon);
