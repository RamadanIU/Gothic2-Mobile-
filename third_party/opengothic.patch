+void GameMenu::touchSelect(Item& it) {
+  if(&it==selectedItem())
+    return;
+  Gothic::inst().emitGlobalSound(Gothic::inst().loadSoundFx("MENU_BROWSE"));
+  setSelection(int(indexOf(it)),1);
+  if(auto s = selectedItem())
+    updateSavThumb(*s);
+  }
+
+void GameMenu::onBeginTouch(Point pos) {
+  touchDown  = true;
+  touchMoved = false;
+  touchTap   = false;
+  touchDrag  = TouchDrag::None;
+  touchList  = nullptr;
+  touchAccum = 0;
+  touchStart = pos;
+  touchLast  = pos;
+
+  // Запись журнала: касание только листает
+  if(logView!=nullptr)
+    return;
+
+  // Список заданий справа: строка - выделить (из раздела сразу в список), выделенная - открыть
+  if(auto list = visibleList(); list!=nullptr && itemRect(*list).contains(pos) &&
+     numQuests(Gothic::inst().questLog(),toStatus(list->handle->user_string[0]))>0) {
+    touchList = list;
+    const int row = questAt(*list,pos);
+    if(row<0)
+      return;
+    touchTap = (logList==list && row==list->value);
+    if(!touchTap && openLogList(*list) && list->value!=row) {
+      Gothic::inst().emitGlobalSound(Gothic::inst().loadSoundFx("MENU_BROWSE"));
+      list->value = row;
+      }
+    update();
+    return;
+    }
+
+  // Мимо списка - к разделам и пунктам: список заданий закрывается
+  if(logList!=nullptr)
+    closeSubView();
+  if(auto it = touchItemAt(pos)) {
+    touchTap = (it==selectedItem());
+    touchSelect(*it);
+    }
+  update();
+  }
+
+void GameMenu::onDragTouch(Point pos) {
+  if(!touchDown)
+    return;
+  const float scale = Gothic::interfaceScale(this);
+  const Point d0    = pos-touchStart;
+  if(!touchMoved && std::max(std::abs(d0.x),std::abs(d0.y))>=int(10*scale)) {
+    touchMoved = true;
+    touchTap   = false;
+    const bool hor = std::abs(d0.x)>std::abs(d0.y);
+    auto*      sel = selectedItem();
+    if(logView!=nullptr)
+      touchDrag = TouchDrag::Text;
+    else if(touchList!=nullptr)
+      touchDrag = TouchDrag::List;
+    else if(hor && sel!=nullptr && chainOf(*sel,zenkit::MenuItemType::SLIDER)!=nullptr)
+      touchDrag = TouchDrag::Slider;
+    else if(hor && sel!=nullptr && chainOf(*sel,zenkit::MenuItemType::CHOICEBOX)!=nullptr)
+      touchDrag = TouchDrag::Choice;
+    else
+      touchDrag = TouchDrag::Hover;
+    }
+
+  const Point d = pos-touchLast;
+  switch(touchDrag) {
+    case TouchDrag::None:
+      break;
+    case TouchDrag::Hover:
+      if(auto it = touchItemAt(pos))
+        touchSelect(*it);
+      break;
+    case TouchDrag::Text: {
+      // Палец вверх - текст вверх (дальше по записи), по строке за высоту шрифта
+      auto&     fnt  = Resources::font(logView->handle->fontname,Resources::FontType::Normal,scale);
+      const int step = std::max(1,fnt.pixelSize());
+      touchAccum += d.y;
+      for(; touchAccum<=-step; touchAccum+=step)
+        logView->scroll++;
+      for(; touchAccum>=step; touchAccum-=step)
+        logView->scroll = std::max(logView->scroll-1,0);
+      break;
+      }
+    case TouchDrag::List: {
+      auto&     fnt  = Resources::font(touchList->handle->fontname,Resources::FontType::Normal,scale);
+      const int step = std::max(1,fnt.pixelSize());
+      touchAccum += d.y;
+      for(; touchAccum<=-step; touchAccum+=step) {
+        if(touchList->more) {
+          touchList->scroll++;
+          touchList->more = false; // до следующей отрисовки - по одной строке
+          freeScroll = touchList;
+          }
+        }
+      for(; touchAccum>=step; touchAccum-=step) {
+        if(touchList->scroll>0) {
+          touchList->scroll--;
+          freeScroll = touchList;
+          }
+        }
+      break;
+      }
+    case TouchDrag::Slider: {
+      // Сдвиг пальца на ширину строки - весь ползунок: тянуть можно с любого места строки
+      auto* sl  = selectedItem()!=nullptr ? chainOf(*selectedItem(),zenkit::MenuItemType::SLIDER) : nullptr;
+      if(sl==nullptr)
+        break;
+      const auto& sec = sl->handle->on_chg_set_option_section;
+      const auto& opt = sl->handle->on_chg_set_option;
+      const int   rw  = itemRect(*sl).w;
+      if(rw<=0 || sec.empty() || opt.empty())
+        break;
+      float v   = Gothic::settingsGetF(sec,opt) + float(d.x)/float(rw);
+      float stp = sliderStep(sl->handle);
+      if(stp>0.f && stp<1.f)
+        v = std::round(std::clamp(v,0.f,1.f)/stp)*stp;
+      Gothic::settingsSetF(sec,opt,std::clamp(v,0.f,1.f));
+      break;
+      }
+    case TouchDrag::Choice: {
+      // Вбок на 40 - следующее значение
+      const int step = int(40*scale);
+      touchAccum += d.x;
+      for(; touchAccum>=step; touchAccum-=step)
+        onKeyboard(KeyCodec::Right);
+      for(; touchAccum<=-step; touchAccum+=step)
+        onKeyboard(KeyCodec::Left);
+      break;
+      }
+    }
+  touchLast = pos;
+  update();
+  }
