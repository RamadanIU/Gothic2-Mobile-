+Npc* TouchInput::squadTarget() const {
+  // Цель приказа «Атаковать»: выбранная касанием, иначе та, на которую смотрит герой
+  if(auto tg = ctrl.touchTarget())
+    return tg;
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return nullptr;
+  auto f = w->validateFocus(ctrl.focus());
+  if(f.npc!=nullptr && !f.npc->isDown() && std::find(squad.begin(),squad.end(),f.npc)==squad.end())
+    return f.npc;
+  return nullptr;
+  }
+
+Npc* TouchInput::sayTarget() const {
+  // Кому «Сказать»: выбранный касанием, иначе тот, на кого смотрит герой, иначе Геральт рядом (AiNpc::addressee)
+  auto w  = Gothic::inst().world();
+  auto pl = Gothic::inst().player();
+  if(w==nullptr || pl==nullptr)
+    return nullptr;
+  Npc* cand = ctrl.touchTarget();
+  if(cand==nullptr)
+    cand = w->validateFocus(ctrl.focus()).npc;
+  return w->script().aiNpc().addressee(*pl,cand);
   }
 
