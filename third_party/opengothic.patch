+void TouchInput::drawGlyph(Painter& p, TouchIcons::Icon ic, Point c, int size, const Color& cl) {
+  if(size<4)
+    return;
+  const int x = c.x-size/2, y = c.y-size/2;
+  // Тень под значком - он читается на светлом небе и снегу
+  auto& sh  = icons.shadow(ic,size);
+  const int off = std::max(1, int(1.2f*dp()));
+  p.setBrush(Brush(sh,Color(1.f,1.f,1.f,0.8f*cl.a())));
+  p.drawRect(x+off/2, y+off, size, size, 0,0,sh.w(),sh.h());
+  auto& tx = icons.icon(ic,size);
+  p.setBrush(Brush(tx,cl));
+  p.drawRect(x, y, size, size, 0,0,tx.w(),tx.h());
+  }
+
+void TouchInput::drawGlow(Painter& p, const Rect& r, int size, float k) {
+  // Сложение не смотрит на прозрачность кисти: сила свечения - яркость цвета
+  auto& g = icons.glow(size);
+  p.setBrush(Brush(g,Color(GlowColor.r()*k, GlowColor.g()*k, GlowColor.b()*k, 1.f),Painter::Add));
+  p.drawRect(r.x, r.y, r.w, r.h, 0,0,g.w(),g.h());
+  }
+
+void TouchInput::drawRound(Painter& p, const Button& b, TouchIcons::Icon ic, bool pressed, bool active, float alpha) {
+  alpha *= paintAlpha;
+  // Видимый круг подложки занимает 88% текстуры: по краям - тень
+  const int ds = int(float(2*b.r)/0.88f);
+  if(active || pressed) {
+    const int gs = int(float(ds)*1.3f);
+    drawGlow(p, Rect(b.c.x-gs/2, b.c.y-gs/2, gs, gs), ds, (active ? 0.85f : 0.55f)*alpha);
+    }
+  auto& d = icons.disc(ds);
+  p.setBrush(Brush(d,Color(1.f,1.f,1.f,alpha*(pressed ? 1.f : 0.9f))));
+  p.drawRect(b.c.x-ds/2, b.c.y-ds/2, ds, ds, 0,0,d.w(),d.h());
+
+  Color cl = (pressed || active) ? GoldBright : GoldIdle;
+  cl.set(cl.r(), cl.g(), cl.b(), cl.a()*alpha);
+  drawGlyph(p, ic, b.c, int(float(b.r)*1.12f), cl);
+  }
+
+void TouchInput::drawPill(Painter& p, const Rect& r, TouchIcons::Icon ic, std::string_view label, bool pressed) {
+  if(pressed)
+    drawGlow(p, Rect(r.x-r.h/6, r.y-r.h/6, r.w+r.h/3, r.h+r.h/3), r.h, 0.35f);
+  auto& t = icons.pill(r.w,r.h);
+  p.setBrush(Brush(t,Color(1.f,1.f,1.f,pressed ? 1.f : 0.92f)));
+  p.drawRect(r.x, r.y, r.w, r.h, 0,0,t.w(),t.h());
+
+  const int   gs  = int(float(r.h)*0.48f);
+  auto&       fnt = Resources::font(pressed ? Resources::FontType::Hi : Resources::FontType::Normal, Gothic::interfaceScale(this));
+  const auto  ts  = fnt.textSize(label);
+  const int   gap = int(6*dp());
+  const int   tw  = gs + gap + ts.w;
+  const int   x0  = r.x + (r.w-tw)/2;
+  drawGlyph(p, ic, Point(x0+gs/2, r.y+r.h/2), gs, pressed ? GoldBright : GoldIdle);
+  fnt.drawText(p, x0+gs+gap, r.y+(r.h+ts.h)/2, label);
+  }
