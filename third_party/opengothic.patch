+bool AiNpc::storyListed(Npc& player, Npc& npc, zenkit::IInfo& info) {
+  // Что из тем жителя можно сыграть через модель - как в родном меню реплик, кроме торговли (окно торговли - в диалоге
+  // игры), карманной кражи (это дело героя, а не беседа) и «КОНЕЦ» (просто закрыть диалог). Постоянную тему, которую
+  // житель говорит сам (стража: «Стой!»), - не чаще раза в 3 минуты
+  if(info.trade)
+    return false;
+  if(!info.important && info.description.empty())
+    return false;
+  auto* isym = owner.vm.find_symbol_by_instance(info);
+  if(isym==nullptr || isym->name().find("PICKPOCKET")!=std::string::npos)
+    return false;
+  if(auto* ende = owner.findSymbol("DIALOG_ENDE");
+     ende!=nullptr && ende->type()==zenkit::DaedalusDataType::STRING && !info.description.empty() &&
+     info.description==ende->get_string())
+    return false;
+  if(info.important && info.permanent) {
+    const uint64_t now = owner.tickCount();
+    for(auto& r:storyRecent)
+      if(r.npc==&npc && r.info==isym->index() && now<r.at+180000)
+        return false;
+    }
+  return owner.storyAvailable(player,npc,info);
+  }
