+GameMenu::Item* GameMenu::touchItemAt(Point pos) {
+  // Ближайший пункт: внутри строки - тот, чей центр ближе (строки меню перекрываются), рядом - в пределах запаса
+  const float scale = Gothic::interfaceScale(this);
+  const int   slop  = int(14*scale);
+  Item*       best  = nullptr;
+  int         bestD = slop+1, bestC = 0;
+  for(auto& it:hItems) {
+    if(it.handle==nullptr || !it.visible || !isSelectable(it.handle) || !isEnabled(it.handle))
+      continue;
+    const Rect r  = chainRect(it);
+    const int  dx = std::max({r.x-pos.x, 0, pos.x-(r.x+r.w)});
+    const int  dy = std::max({r.y-pos.y, 0, pos.y-(r.y+r.h)});
+    const int  d  = std::max(dx,dy);
+    const int  c  = std::abs(pos.y-(r.y+r.h/2));
+    if(d<bestD || (d==bestD && c<bestC)) {
+      best  = &it;
+      bestD = d;
+      bestC = c;
+      }
+    }
+  return best;
+  }
