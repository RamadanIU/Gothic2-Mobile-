+Npc* PlayerControl::touchTarget() {
+  if(touchTgt==nullptr)
+    return nullptr;
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  Focus f;
+  f.npc = touchTgt;
+  if(w!=nullptr)
+    f = w->validateFocus(f);
+  // Мёртвый, исчезнувший или далёкий (> 40 м) - выбор снимается
+  if(pl==nullptr || f.npc==nullptr || f.npc->isDead() || pl->qDistTo(*f.npc)>4000.f*4000.f)
+    touchTgt = nullptr;
+  return touchTgt;
+  }
