+void TouchInput::drawHoldRing(Painter& p, const Button& b, float k) {
+  k = std::clamp(k,0.f,1.f);
+  const int   n   = 28;
+  const int   cnt = int(float(n)*k);
+  const float rad = float(b.r)+5*dp();
+  const int   ds  = std::max(4, int(4*dp()));
+  for(int i=0; i<cnt; ++i) {
+    const float a = Pi*0.5f - 2.f*Pi*float(i)/float(n);
+    const auto  c = Point(b.c.x+int(rad*std::cos(a)), b.c.y-int(rad*std::sin(a)));
+    drawGlyph(p, TouchIcons::I_Dot, c, ds, GoldBright);
+    }
+  }
