+Npc* AiNpc::actorOf(std::string_view who) {
+  if(who.empty() || who=="self")
+    return geralt;
+  Npc* n = npcByRef(who);
+  if(n==nullptr || n->isPlayer() || n->isMonster())
+    return nullptr;
+  return n;
+  }
+
+void AiNpc::leaveRoutine(Npc& npc) {
+  if(&npc==geralt || npc.isPlayer())
+    return;
+  // Уже в отряде (нанят в диалоге) - его распорядок сейчас «за героем», не свой: домой - по daily_routine
+  if(!owner.isPartyMember(npc))
+    npc.saveRoutines();
+  npc.handle().aivar[AivRoutine] = 1;
+  for(auto& r:residents)
+    if(r.npc==&npc)
+      return;
+  residents.push_back(Resident{&npc,0});
+  }
+
+void AiNpc::goHome(Npc& npc) {
+  if(&npc==geralt) {
+    // Геральт - обратно за стол в кабаке, пешком (распорядок сам ведёт к точке); из отряда - уходит
+    setParty(npc,false);
+    npc.companionIdle = Npc::CompanionIdle();
+    owner.setStance(npc,false);
+    if(auto* w = world())
+      if(auto* wp = spawnPoint(*w)) {
+        const size_t fn = owner.findSymbolIndex("ZS_SIT_CHAIR");
+        if(fn!=size_t(-1))
+          npc.setRoutineAllDay(fn,wp->name);
+        }
+    npc.resumeAiRoutine();
+    return;
+    }
+  const int32_t aiv = owner.scriptConst("AIV_PARTYMEMBER",15);
+  if(aiv>=0 && uint32_t(aiv)<zenkit::INpc::aivar_count)
+    npc.handle().aivar[size_t(aiv)] = 0;
+  npc.companionIdle = Npc::CompanionIdle();
+  owner.setStance(npc,false);
+  if(!npc.restoreRoutines()) {
+    if(npc.handle().daily_routine>0)
+      npc.excRoutine(size_t(npc.handle().daily_routine));
+    npc.resumeAiRoutine();
+    }
+  npc.handle().aivar[AivRoutine] = 0;
+  residents.erase(std::remove_if(residents.begin(),residents.end(),[&](const Resident& r){ return r.npc==&npc; }),
+                  residents.end());
+  Log::i("[g2m] ai: resident \"",npc.displayName(),"\" back to routine");
+  }
+
+void AiNpc::calmHostility(Npc& npc, Npc& pl) {
+  // Прежде set_attitude hostile ставил постоянное ATT_HOSTILE: житель и герой бились насмерть. Скрипты игры ставят
+  // его человеку только перед AR_KILL (B_Attack) - такие и враги по гильдии (бандиты) остаются как есть
+  if(npc.guild()>=GIL_SEPERATOR_HUM || npc.attitude()!=ATT_HOSTILE || owner.guildAttitude(npc,pl)==ATT_HOSTILE)
+    return;
+  const int32_t aivReason = owner.scriptConst("AIV_ATTACKREASON",9);
+  if(aivReason>=0 && uint32_t(aivReason)<zenkit::INpc::aivar_count &&
+     npc.handle().aivar[size_t(aivReason)]==owner.scriptConst("AR_KILL",19))
+    return;
+  npc.setAttitude(ATT_ANGRY);
+  npc.setTempAttitude(ATT_HOSTILE);
+  Log::i("[g2m] ai: \"",npc.displayName(),"\" hostile -> angry (fights to knockout)");
+  }
+
+void AiNpc::tickResidents(uint64_t now) {
+  // Житель, оставленный ждать или ушедший по делу, возвращается к своей жизни, когда герой минуту далеко
+  // (идущие с героем - нет); после загрузки сохранения - сразу к daily_routine
+  if(now<residentTick)
+    return;
+  residentTick = now+1000;
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr)
+    return;
+  Npc* pl = w->player();
+  for(size_t i=0; i<residents.size(); ) {
+    auto& r = residents[i];
+    if(!npcAlive(r.npc) || r.npc->isDead()) {
+      residents.erase(residents.begin()+long(i));
+      continue;
+      }
+    bool busyHere = owner.isPartyMember(*r.npc);
+    for(auto& a:acts)
+      if(a.actor==r.npc && !a.closed)
+        busyHere = true;
+    if(busyHere || pl->qDistTo(*r.npc)<4000.f*4000.f || r.npc->isTalk()) {
+      r.farSince = 0;
+      ++i;
+      continue;
+      }
+    if(r.farSince==0)
+      r.farSince = now;
+    if(now>r.farSince+60000) {
+      goHome(*r.npc);
+      continue;
+      }
+    ++i;
+    }
+  }
+
+float AiNpc::dist(const Npc& a, const Npc& b) {
+  return std::sqrt(a.qDistTo(b));
+  }
+
+Npc* AiNpc::resolve() {
+  auto* w = world();
+  if(w==nullptr) {
+    geralt      = nullptr;
+    geraltWorld = nullptr;
+    return nullptr;
+    }
+  if(geraltWorld==w) {
+    if(geralt!=nullptr)
+      return geralt;
+    // Ещё не вставлен: искать не каждый кадр
+    if(owner.tickCount()<searchAt)
+      return nullptr;
+    } else {
+    // Другой мир (загрузка, смена мира): всё заново
+    geraltWorld = w;
+    readySent   = false;
+    talking     = false;
+    busy        = false;
+    acts.clear();
+    known.clear();
+    }
+  searchAt = owner.tickCount()+2000;
+  geralt   = nullptr;
+  if(thorusSym==size_t(-1))
+    thorusSym = owner.findSymbolIndex("VLK_2000_THORUS");
+  // Геральт может прийти с героем в любой мир (GameScript::squadEnterWorld); создаётся - только в Хоринисе
+  if(thorusSym==size_t(-1))
+    return nullptr;
+  geralt = w->findNpcByInstance(thorusSym);
+  if(geralt!=nullptr)
+    setup(*geralt,false);
+  return geralt;
+  }
+
+const WayPoint* AiNpc::spawnPoint(World& w) {
+  for(auto* name:SpawnPoints)
+    if(auto* wp = w.findPoint(name,false))
+      return wp;
+  return nullptr;
+  }
+
+void AiNpc::seat(Npc& npc, World& w) {
+  // Точка кабака со свободным стулом рядом (ZS_Sit_Chair ищет его в 10 м от точки), нет стульев - со скамьёй;
+  // распорядок на весь день - сидеть там (дойти до точки, сесть, иногда менять позу). После разговора или
+  // драки он сам возвращается за стол
+  npc.handle().aivar[AivSpawn] = SpawnVersion;
+  const WayPoint* at = nullptr;
+  const char*     zs = "ZS_SIT_CHAIR";
+  for(auto [scheme,state]:{std::pair<const char*,const char*>{"CHAIR","ZS_SIT_CHAIR"},{"BENCH","ZS_SIT_BENCH"}}) {
+    for(auto* name:SpawnPoints) {
+      auto* wp = w.findPoint(name,false);
+      if(wp==nullptr)
+        continue;
+      npc.setPosition(wp->position());
+      if(w.availableMob(npc,scheme)!=nullptr) {
+        at = wp;
+        zs = state;
+        break;
+        }
+      }
+    if(at!=nullptr)
+      break;
+    }
+  if(at==nullptr)
+    at = spawnPoint(w);
+  if(at==nullptr)
+    return;
+  npc.setPosition(at->position());
+  npc.setDirection(at->direction());
+  owner.fixNpcPosition(npc,0,100);
+
+  const size_t fn = owner.findSymbolIndex(zs);
+  if(fn==size_t(-1)) {
+    setActivity(npc,"ZS_STAND_ARMSCROSSED");
+    return;
+    }
+  npc.setRoutineAllDay(fn,at->name);
+  npc.companionIdle.campSet = false;
+  Log::i("[g2m] ai: Geralt sits at ",at->name," (",zs,")");
+  }
+
+void AiNpc::moveToSpawn(Npc& npc, World& w) {
+  // Сохранение, где Геральт ещё стоит в пещере у водопада: переходит в кабак, когда герой его не видит
+  // (дальше 30 м). Идёт с героем или его увели из пещеры - остаётся, где есть: место ему уже выбрали
+  auto& h = npc.handle();
+  if(h.aivar[AivSpawn]>=SpawnVersion || npc.isDead())
+    return;
+  auto* cave = w.findPoint(OldSpawnPoint,false);
+  if(owner.isPartyMember(npc) || cave==nullptr || npc.qDistTo(cave)>5000.f*5000.f) {
+    h.aivar[AivSpawn] = SpawnVersion;
+    return;
+    }
+  auto* pl = w.player();
+  auto* wp = spawnPoint(w);
+  if(pl==nullptr || wp==nullptr || pl->qDistTo(npc)<3000.f*3000.f || pl->qDistTo(wp)<3000.f*3000.f)
+    return;
+  npc.clearAiQueue();
+  seat(npc,w);
+  npc.resumeAiRoutine();
+  const auto pos = npc.position();
+  Log::i("[g2m] ai: Geralt moved from the cave to the tavern (",int(pos.x),", ",int(pos.y),", ",int(pos.z),")");
+  }
+
+void AiNpc::insert(World& w) {
+  // Сразу при загрузке мира, где бы ни был герой
+  auto* wp = spawnPoint(w);
+  if(wp==nullptr) {
+    if(!insertFailLogged)
+      Log::e("[g2m] ai: no spawn point ",SpawnPoints[0]);
+    insertFailLogged = true;
+    return;
+    }
+  // По координатам, а не по имени точки: addNpc(имя) ставит NPC на точку его распорядка из скрипта, а у
+  // Торуса это несуществующая "XXX" - он уходил в список «без точки» (npcInvalid) на точку мёртвых
+  Npc* npc = w.addNpc(thorusSym,wp->position());
+  if(npc!=nullptr)
+    npc->setDirection(wp->direction());
+  if(npc==nullptr) {
+    if(!insertFailLogged)
+      Log::e("[g2m] ai: unable to insert Geralt");
+    insertFailLogged = true;
+    return;
+    }
+  setup(*npc,true);
+  seat(*npc,w);
+  npc->resumeAiRoutine();
+  geralt      = npc;
+  geraltWorld = &w;
+  const auto pos = npc->position();
+  Log::i("[g2m] ai: Geralt inserted near ",wp->name," (",int(pos.x),", ",int(pos.y),", ",int(pos.z),")");
+  }
+
+void AiNpc::setup(Npc& npc, bool fresh) {
+  auto& h = npc.handle();
+  h.name[0] = toCp1251("Геральт");
+  if(!fresh) {
+    dressArmor(npc);
+    return;
+    }
+
+  // Ведьмак: сильный мечник-одиночка, без гильдии; безымянный тип - как нанятые напарники (отряд, не гибнет)
+  h.guild        = GIL_NONE;
+  npc.setTrueGuild(GIL_NONE);
+  h.type         = zenkit::NpcType::G2_AMBIENT;
+  h.level        = 30;
+  // Голос 0 - пустой набор SVM: в бою и при встрече он не кричит чужим озвученным голосом, говорит только модель
+  h.voice        = 0;
+  h.fight_tactic = owner.scriptConst("FAI_HUMAN_MASTER",4);
+  h.attribute[ATR_HITPOINTSMAX] = 900;
+  h.attribute[ATR_HITPOINTS]    = 900;
+  h.attribute[ATR_MANAMAX]      = 60;
+  h.attribute[ATR_MANA]         = 60;
+  h.attribute[ATR_STRENGTH]     = 160;
+  h.attribute[ATR_DEXTERITY]    = 140;
+  for(size_t i=1; i<zenkit::INpc::hitchance_count; ++i)
+    h.hitchance[i] = (i<=2) ? 95 : 70;
+  npc.setTalentSkill(TALENT_1H,2);
+  npc.setTalentSkill(TALENT_2H,2);
+  npc.setTalentSkill(TALENT_BOW,1);
+
+  std::random_device rd;
+  int32_t story = int32_t(rd() & 0x3FFFFFFFu);
+  h.aivar[AivStory] = std::max(story,1);
+  h.aivar[AivToken] = 0;
+
+  // Внешность из моделей игры: голова с хвостом, седое лицо, светлая кожа, доспехи рудного барона
+  const int32_t face = owner.scriptConst("FACE_N_IMPORTANTGREY",59);
+  npc.setVisualBody(face,0,1,0,"hum_body_Naked0","Hum_Head_Pony");
+  npc.delOverlay("Humans_Militia.mds");
+  npc.addOverlay("Humans_Relaxed.mds",0);
+  npc.setFatness(0);
+
+  auto equip = [&](std::string_view name) {
+    const size_t id = owner.findSymbolIndex(name);
+    if(id==size_t(-1))
+      return;
+    if(npc.itemCount(id)==0)
+      npc.addItem(id,1);
+    npc.useItem(id,Item::NSLOT,true);
+    };
+  auto give = [&](std::string_view name, size_t n) {
+    const size_t id = owner.findSymbolIndex(name);
+    if(id!=size_t(-1))
+      npc.addItem(id,n);
+    };
+  // Доспехи ополчения из скрипта Торуса - не его. Убрать до переодевания: скрипт (B_SetNpcVisual) их уже надел,
+  // и dressArmor принимал их за доспехи, надетые им самим, а удаление следом снимало их - Геральт оставался голым
+  if(const size_t mil = owner.findSymbolIndex("ITAR_MIL_M"); mil!=size_t(-1) && npc.itemCount(mil)>0)
+    npc.delItem(mil,uint32_t(npc.itemCount(mil)));
+  dressArmor(npc);
+  equip("ITMW_SCHWERT5");       // «стальной» - на людей
+  give ("ITMW_1H_SPECIAL_01",1); // рудный - вместо серебряного, на нечисть
+  give ("ITPO_HEALTH_02",5);
+  give ("ITPO_HEALTH_03",2);
+  give ("ITFO_MUTTON",2);
+  give ("ITFO_BOOZE",1);
+  give ("ITMI_GOLD",250);
+
+  npc.setAttitude(ATT_FRIENDLY);
+  npc.setTempAttitude(ATT_FRIENDLY);
+  setActivity(npc,"ZS_STAND_ARMSCROSSED");
+  }
+
+void AiNpc::dressArmor(Npc& npc) {
+  // Доспехи рудного барона (аддон) - при появлении и при каждой загрузке: без доспехов или в лёгких доспехах
+  // охотника на драконов (их он носил раньше) - переодеть. Другие доспехи он надел сам (equip_item) - не трогать.
+  // Gothic II без дополнения: доспехов барона в её скриптах нет - запасные, лёгкие доспехи охотника на драконов
+  const size_t baron = owner.findSymbolIndex("ITAR_OREBARON_ADDON");
+  const size_t djg   = owner.findSymbolIndex("ITAR_DJG_L");
+  const size_t want  = baron!=size_t(-1) ? baron : djg;
+  auto*        armor = npc.currentArmor();
+  const size_t was   = armor!=nullptr ? armor->clsId() : size_t(-1);
+  if(want==size_t(-1)) {
+    Log::e("[g2m] ai: Geralt armor - no ITAR_OREBARON_ADDON and ITAR_DJG_L in scripts, wears ",
+           armor!=nullptr ? fromCp1251(armor->displayName()) : std::string("nothing"));
+    return;
+    }
+  if(was==want || (armor!=nullptr && was!=djg)) {
+    Log::i("[g2m] ai: Geralt armor - ",fromCp1251(armor->displayName()));
+    return;
+    }
+  if(npc.itemCount(want)==0)
+    npc.addItem(want,1);
+  npc.useItem(want,Item::NSLOT,true);
+  if(want!=djg && djg!=size_t(-1) && npc.itemCount(djg)>0)
+    npc.delItem(djg,uint32_t(npc.itemCount(djg)));
+  armor = npc.currentArmor();
+  Log::i("[g2m] ai: Geralt armor - ",want==baron ? "ore baron: " : "dragon hunter's (no ore baron's in scripts): ",
+         armor!=nullptr && armor->clsId()==want ? "ok" : "FAILED",
+         " (was ",was==djg ? "dragon hunter's" : (was==size_t(-1) ? "none" : "other"),")");
+  }
