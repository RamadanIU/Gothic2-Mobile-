+  const int   btn = int(64*d);
+  const int   tw  = int(88*d);
+  const int   th  = int(44*d);
+  const int   W   = w();
+  const int   H   = h();
+
+  const Rect atk  = Rect(W-pad-big, H-pad-big, big, big);
+  const int  autoW = int(float(btn)*1.7f);
+  const Rect aut  = Rect(W-pad-autoW, atk.y-2*(pad+btn), autoW, btn);
+
+  // крестовина экранов со списками
+  const int  cx = pad + btn + btn/2 + pad;
+  const int  cy = H - pad - btn - btn/2 - pad;
+
+  switch(c) {
+    case C_Attack:
+    case C_Select:
+      return atk;
+    case C_Block:
+      return Rect(atk.x-pad-btn, H-pad-btn, btn, btn);
+    case C_Jump:
+      return Rect(W-pad-btn, atk.y-pad-btn, btn, btn);
+    case C_Weapon:
+      return Rect(atk.x-pad-btn, atk.y-pad-btn, btn, btn);
+    case C_Auto:
+      return aut;
+    case C_Potion:
+      return Rect(aut.x-pad-btn, aut.y, btn, btn);
+    case C_TakeAll: {
+      // над «Выбрать», шириной с неё
+      return Rect(atk.x, atk.y-pad-btn, atk.w, btn);
+      }
+    case C_Menu:
+    case C_Back:
+      return Rect(pad, pad, tw, th);
+    case C_Bag:
+      return Rect(pad+(tw+pad), pad, tw, th);
+    case C_Log:
+      return Rect(pad+(tw+pad)*2, pad, tw, th);
+    case C_Hero:
+      return Rect(pad+(tw+pad)*3, pad, tw, th);
+    case C_Skip:
+      return Rect(W-pad-int(float(tw)*1.4f), pad, int(float(tw)*1.4f), th);
+    case C_Up:
+      return Rect(cx-btn/2, cy-btn/2-btn-pad/2, btn, btn);
+    case C_Down:
+      return Rect(cx-btn/2, cy+btn/2+pad/2, btn, btn);
+    case C_Left:
+      return Rect(cx-btn/2-btn-pad/2, cy-btn/2, btn, btn);
+    case C_Right:
+      return Rect(cx+btn/2+pad/2, cy-btn/2, btn, btn);
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_Count:
+      break;
+    }
+  return Rect();
+  }
+
+bool TouchInput::isShown(Ctl c) const {
+  using M = MainWindow::TouchMode;
+  const auto m = MainWindow::TouchMode(currentMode());
+  switch(c) {
+    case C_Attack:
+    case C_Block:
+    case C_Jump:
+    case C_Weapon:
+    case C_Auto:
+    case C_Potion:
+    case C_Menu:
+    case C_Bag:
+    case C_Log:
+    case C_Hero:
+      return m==M::World;
+    case C_Up:
+    case C_Down:
+    case C_Left:
+    case C_Right:
+    case C_Select:
+    case C_Back:
+      return m==M::Navigation;
+    case C_TakeAll:
+      return m==M::Navigation && owner.touchCanTakeAll();
+    case C_Skip:
+      return m==M::Skip;
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_Count:
+      break;
+    }
+  return false;
+  }
+
+TouchInput::Ctl TouchInput::hitTest(Point p) const {
+  // Небольшой запас вокруг кнопки: палец крупнее нарисованной рамки
+  const int slop = int(6*dp());
+  for(uint8_t i=C_Attack; i<C_Count; ++i) {
+    const Ctl c = Ctl(i);
+    if(!isShown(c))
+      continue;
+    auto r = rectOf(c);
+    if(Rect(r.x-slop, r.y-slop, r.w+2*slop, r.h+2*slop).contains(p))
+      return c;
+    }
+  return C_None;
+  }
+
+std::string TouchInput::label(Ctl c) const {
+  switch(c) {
+    case C_Attack: return toCp1251("Удар");
+    case C_Block:  return toCp1251("Блок");
+    case C_Jump:   return toCp1251("Прыжок");
+    case C_Weapon: return toCp1251("Оружие");
+    case C_Auto:   return toCp1251(ctrl.isAutoFight() ? "Автобой: вкл" : "Автобой");
+    case C_Potion: return toCp1251("Зелье");
+    case C_Menu:   return toCp1251("Меню");
+    case C_Bag:    return toCp1251("Сумка");
+    case C_Log:    return toCp1251("Журнал");
+    case C_Hero:   return toCp1251("Герой");
+    case C_Up:     return "^";
+    case C_Down:   return "v";
+    case C_Left:   return "<";
+    case C_Right:  return ">";
+    case C_Select: return toCp1251("Выбрать");
+    case C_Back:   return toCp1251("Назад");
+    case C_TakeAll:return toCp1251("Взять всё");
+    case C_Skip:   return toCp1251("Пропустить");
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_Count:
+      break;
+    }
+  return "";
+  }
