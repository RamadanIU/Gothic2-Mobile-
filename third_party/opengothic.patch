+// Gothic II Mobile: регдолл - физика упавшего тела (Ragdoll). Единицы: в игре сантиметры, в Bullet - метры.
+
+namespace {
+
+enum Kind : uint8_t {
+  K_None,
+  K_Root,     // BIP01 - корень, в точке таза
+  K_Slot,     // ZS_* - места для оружия и предметов
+  K_Minor,    // пальцы, глаза, челюсть, волосы, концы цепочек
+  K_Pelvis,
+  K_Spine,
+  K_Neck,
+  K_Head,
+  K_Clavicle,
+  K_UpperArm,
+  K_ForeArm,
+  K_Hand,
+  K_Thigh,
+  K_Calf,
+  K_Foot,
+  K_Tail,
+  K_Other,    // кости зверей без имени из Biped (крылья, лапы насекомых): капсула, если достаточно длинная
+  };
+
+const char* kindName(uint8_t k) {
+  switch(Kind(k)) {
+    case K_Pelvis:   return "pelvis";
+    case K_Spine:    return "spine";
+    case K_Neck:     return "neck";
+    case K_Head:     return "head";
+    case K_UpperArm: return "upperarm";
+    case K_ForeArm:  return "forearm";
+    case K_Hand:     return "hand";
+    case K_Thigh:    return "thigh";
+    case K_Calf:     return "calf";
+    case K_Foot:     return "foot";
+    case K_Tail:     return "tail";
+    case K_Other:    return "other";
+    default:         return "?";
+    }
+  }
+
+bool has(const std::string& s, const char* what) {
+  return s.find(what)!=std::string::npos;
+  }
+
+Kind classify(std::string_view name) {
+  std::string n(name);
+  for(auto& c:n)
+    c = char(std::toupper(static_cast<unsigned char>(c)));
+  if(n.rfind("ZS_",0)==0)
+    return K_Slot;
+  for(auto m:{"FINGER","TOE","NUB","EYE","JAW","TEETH","TONGUE","LIP","BROW","PONYTAIL","FOOTSTEPS","HAIR"})
+    if(has(n,m))
+      return K_Minor;
+  if(n=="BIP01")
+    return K_Root;
+  if(has(n,"PELVIS"))
+    return K_Pelvis;
+  if(has(n,"SPINE"))
+    return K_Spine;
+  if(has(n,"NECK"))
+    return K_Neck;
+  if(has(n,"HEAD"))
+    return K_Head;
+  if(has(n,"CLAVICLE"))
+    return K_Clavicle;
+  if(has(n,"UPPERARM"))
+    return K_UpperArm;
+  if(has(n,"FOREARM"))
+    return K_ForeArm;
+  if(has(n,"HAND"))
+    return K_Hand;
+  if(has(n,"THIGH"))
+    return K_Thigh;
+  if(has(n,"CALF"))
+    return K_Calf;
+  if(has(n,"FOOT"))
+    return K_Foot;
+  if(has(n,"TAIL"))
+    return K_Tail;
+  return K_Other;
+  }
+
+constexpr float deg(float d) { return d*float(M_PI)/180.f; }
+
+Vec3 originOf(const Matrix4x4& m) {
+  return Vec3(m.at(3,0), m.at(3,1), m.at(3,2));
+  }
+
+Vec3 axisOf(const Matrix4x4& m, int c) {
+  return Vec3(m.at(c,0), m.at(c,1), m.at(c,2));
+  }
+
+Matrix4x4 inverseOf(Matrix4x4 m) {
+  m.inverse();
+  return m;
+  }
+
+// Ортонормированная система координат: x - заданное направление, y - ближе всего к подсказке
+Matrix4x4 mkFrame(const Vec3& at, Vec3 x, const Vec3& hintY, const Vec3& hintZ) {
+  x = Vec3::normalize(x);
+  Vec3 y = hintY - x*Vec3::dotProduct(hintY,x);
+  if(y.length()<0.2f*hintY.length() || y.length()<1e-4f)
+    y = hintZ - x*Vec3::dotProduct(hintZ,x);
+  if(y.length()<1e-4f)
+    y = std::abs(x.y)<0.9f ? Vec3(0,1,0) - x*x.y : Vec3(1,0,0) - x*x.x;
+  y = Vec3::normalize(y);
+  Vec3 z = Vec3::crossProduct(x,y);
+
+  Matrix4x4 m = Matrix4x4::mkIdentity();
+  m.set(0,0,x.x);  m.set(0,1,x.y);  m.set(0,2,x.z);
+  m.set(1,0,y.x);  m.set(1,1,y.y);  m.set(1,2,y.z);
+  m.set(2,0,z.x);  m.set(2,1,z.y);  m.set(2,2,z.z);
+  m.set(3,0,at.x); m.set(3,1,at.y); m.set(3,2,at.z);
+  return m;
+  }
+
+btTransform toBt(const Matrix4x4& m) {
+  btVector3 x(m.at(0,0), m.at(0,1), m.at(0,2));
+  btVector3 y(m.at(1,0), m.at(1,1), m.at(1,2));
+  x.normalize();
+  y = y - x*x.dot(y);
+  y.normalize();
+  btVector3 z = x.cross(y);
+  btMatrix3x3 basis(x.x(), y.x(), z.x(),
+                    x.y(), y.y(), z.y(),
+                    x.z(), y.z(), z.z());
+  return btTransform(basis, btVector3(m.at(3,0), m.at(3,1), m.at(3,2))*0.01f);
+  }
+
+Matrix4x4 fromBt(const btTransform& t) {
+  Matrix4x4 m;
+  t.getOpenGLMatrix(reinterpret_cast<btScalar*>(&m));
+  m.set(3,0,m.at(3,0)*100.f);
+  m.set(3,1,m.at(3,1)*100.f);
+  m.set(3,2,m.at(3,2)*100.f);
+  return m;
+  }
+
+float segmentDistance(const Vec3& p1, const Vec3& q1, const Vec3& p2, const Vec3& q2) {
+  // расстояние между отрезками (Ericson, Real-Time Collision Detection, 5.1.9)
+  const Vec3  d1 = q1-p1, d2 = q2-p2, r = p1-p2;
+  const float a  = Vec3::dotProduct(d1,d1), e = Vec3::dotProduct(d2,d2), f = Vec3::dotProduct(d2,r);
+  float s = 0, t = 0;
+  if(a<=1e-6f && e<=1e-6f)
+    return (p1-p2).length();
+  if(a<=1e-6f) {
+    t = std::clamp(f/e, 0.f, 1.f);
+    } else {
+    const float c = Vec3::dotProduct(d1,r);
+    if(e<=1e-6f) {
+      s = std::clamp(-c/a, 0.f, 1.f);
+      } else {
+      const float b     = Vec3::dotProduct(d1,d2);
+      const float denom = a*e-b*b;
+      s = denom>1e-6f ? std::clamp((b*f-c*e)/denom, 0.f, 1.f) : 0.f;
+      t = (b*s+f)/e;
+      if(t<0.f) {
+        t = 0.f;
+        s = std::clamp(-c/a, 0.f, 1.f);
+        }
+      else if(t>1.f) {
+        t = 1.f;
+        s = std::clamp((b-c)/a, 0.f, 1.f);
+        }
+      }
+    }
+  return ((p1+d1*s)-(p2+d2*t)).length();
+  }
+
+// Итерации решателя на сустав: рядом - точнее (руки и ноги не «тянутся» при ударе о землю), вдали - дешевле
+int solverItFor(float viewDist) {
+  if(viewDist<1500.f)
+    return 20;
+  if(viewDist<3000.f)
+    return 12;
+  return 8;
+  }
+
+// Очередь на застывание при нехватке места в физике: дальние и дольше падающие - раньше (1 с - как 5 м);
+// живой падающий и тем более герой - последними
+float evictScore(float viewDist, uint64_t simTime, Ragdoll::State st, bool keep) {
+  float s = viewDist + float(simTime)*0.5f;
+  if(st==Ragdoll::S_Fall)
+    s -= 1e6f;
+  if(keep)
+    s -= 1e7f;
+  return s;
+  }
+
+float pointSegmentDistance(const Vec3& p, const Vec3& a, const Vec3& b) {
+  const Vec3  ab = b-a;
+  const float l2 = Vec3::dotProduct(ab,ab);
+  const float t  = l2>1e-6f ? std::clamp(Vec3::dotProduct(p-a,ab)/l2, 0.f, 1.f) : 0.f;
+  return (p-(a+ab*t)).length();
+  }
+
+}
+
+struct Ragdoll::Layout final {
+  struct Part final {
+    size_t    bone   = size_t(-1);
+    size_t    parent = size_t(-1); // часть-родитель (сустав); у таза нет
+    uint8_t   kind   = K_None;
+
+    float     radius  = 0;  // см
+    float     halfLen = 0;  // половина длины цилиндра капсулы, см
+    float     mass    = 0;  // кг
+
+    Matrix4x4 bodyInBone; // тело (ось капсулы - X) в системе своей кости
+    Matrix4x4 boneInBody;
+    Matrix4x4 bodyBind;   // тело в позе привязки, в системе модели
+
+    // сустав с родителем: шарнир (колено, локоть) или конус
+    bool      hinge = false;
+    Matrix4x4 hingeInParent, hingeInChild; // системы шарнира (ось - Z) в телах, см
+    float     hingeLo = 0, hingeHi = 0;    // пределы сгиба от позы привязки, рад
+    float     swing1 = 0, swing2 = 0, twist = 0;
+    };
+
+  std::vector<Part>                           parts;
+  std::vector<uint8_t>                        driven; // по номеру кости
+  std::vector<std::pair<uint16_t,uint16_t>>   noCollide;
+  size_t                                      chest      = 0;  // часть - грудь (куда смотрит тело)
+  size_t                                      follower   = size_t(-1); // корень скелета над тазом: идёт за тазом
+  Vec3                                        frontLocal = {}; // «вперёд» модели в системе кости груди
+  float                                       size       = 0;  // размер модели, см
+  bool                                        humanoid   = false;
+  };
+
+struct Ragdoll::Body final {
+  std::unique_ptr<btCollisionShape> shape;
+  std::unique_ptr<btRigidBody>      rb;
+  };
+
+struct Ragdoll::Joint final {
+  std::unique_ptr<btTypedConstraint> c;
+  uint16_t                           parent = 0;
+  uint16_t                           child  = 0;
+  };
+
+namespace {
+
+struct Builder final {
+  using Part = Ragdoll::Layout::Part;
+
+  const Skeleton&       sk;
+  size_t                n = 0;
+  std::vector<Kind>     kind;
+  std::vector<Vec3>     pos;
+  std::vector<std::vector<size_t>> child;
+  float                 S = 0;
+
+  explicit Builder(const Skeleton& sk):sk(sk) {
+    n = std::min(sk.nodes.size(), sk.tr.size());
+    kind .resize(n);
+    pos  .resize(n);
+    child.resize(n);
+    for(size_t i=0; i<n; ++i) {
+      kind[i] = classify(sk.nodes[i].name);
+      pos [i] = originOf(sk.tr[i]);
+      const size_t p = sk.nodes[i].parent;
+      if(p<n)
+        child[p].push_back(i);
+      }
+    Vec3 bmin = Vec3(1e9f,1e9f,1e9f), bmax = Vec3(-1e9f,-1e9f,-1e9f);
+    for(size_t i=0; i<n; ++i) {
+      if(kind[i]==K_Slot)
+        continue;
+      bmin = Vec3(std::min(bmin.x,pos[i].x), std::min(bmin.y,pos[i].y), std::min(bmin.z,pos[i].z));
+      bmax = Vec3(std::max(bmax.x,pos[i].x), std::max(bmax.y,pos[i].y), std::max(bmax.z,pos[i].z));
+      }
+    const Vec3 ext = bmax-bmin;
+    S = std::max(ext.x, std::max(ext.y, ext.z));
+    }
+
+  size_t findKind(Kind k) const {
+    for(size_t i=0; i<n; ++i)
+      if(kind[i]==k)
+        return i;
+    return size_t(-1);
+    }
+
+  size_t subtreeSize(size_t i) const {
+    size_t ret = 1;
+    for(auto c:child[i])
+      ret += subtreeSize(c);
+    return ret;
+    }
+
+  void farthest(size_t root, size_t i, float& best, Vec3& at) const {
+    for(auto c:child[i]) {
+      if(kind[c]==K_Slot)
+        continue;
+      const float d = (pos[c]-pos[root]).length();
+      if(d>best) {
+        best = d;
+        at   = pos[c];
+        }
+      farthest(root,c,best,at);
+      }
+    }
+
+  // Конец капсулы кости: начало следующей кости цепочки, кончик пальцев или продолжение кости
+  Vec3 endOf(size_t i) const {
+    std::vector<Kind> pref;
+    switch(kind[i]) {
+      case K_Spine:    pref = {K_Spine, K_Neck, K_Head}; break;
+      case K_Neck:     pref = {K_Neck, K_Head};          break;
+      case K_UpperArm: pref = {K_ForeArm};               break;
+      case K_ForeArm:  pref = {K_Hand};                  break;
+      case K_Thigh:    pref = {K_Calf, K_Other};         break;
+      case K_Calf:     pref = {K_Foot, K_Other};         break;
+      case K_Tail:     pref = {K_Tail};                  break;
+      default: break;
+      }
+    for(auto k:pref)
+      for(auto c:child[i])
+        if(kind[c]==k && (pos[c]-pos[i]).length()>0.01f*S)
+          return pos[c];
+
+    if(kind[i]==K_Other) {
+      size_t best = size_t(-1), bestSz = 0;
+      for(auto c:child[i]) {
+        if(kind[c]==K_Slot || (pos[c]-pos[i]).length()<0.01f*S)
+          continue;
+        const size_t sz = subtreeSize(c);
+        if(sz>bestSz) {
+          best   = c;
+          bestSz = sz;
+          }
+        }
+      if(best!=size_t(-1))
+        return pos[best];
+      }
+
+    if(kind[i]==K_Hand || kind[i]==K_Foot || kind[i]==K_Head || kind[i]==K_Tail || kind[i]==K_Other) {
+      float far = 0;
+      Vec3  at  = pos[i];
+      farthest(i,i,far,at);
+      const float minLen = (kind[i]==K_Head ? 0.06f : 0.025f)*S;
+      if(far>minLen)
+        return at;
+      }
+
+    // продолжение направления от родительской кости
+    float def = 0.06f*S;
+    switch(kind[i]) {
+      case K_Head: def = 0.11f*S; break;
+      case K_Hand: def = 0.08f*S; break;
+      case K_Foot: def = 0.08f*S; break;
+      case K_Tail: def = 0.07f*S; break;
+      default: break;
+      }
+    Vec3 dir = Vec3(0,1,0);
+    const size_t p = sk.nodes[i].parent;
+    if(p<n && (pos[i]-pos[p]).length()>0.005f*S)
+      dir = Vec3::normalize(pos[i]-pos[p]);
+    return pos[i] + dir*def;
+    }
+
+  float radiusOf(Kind k, float len) const {
+    auto r = [this](float v, float lo, float hi) { return std::clamp(v, lo*S, hi*S); };
+    switch(k) {
+      case K_Pelvis:
+      case K_Spine:    return r(0.6f *len, 0.07f,  0.10f);
+      case K_Neck:     return r(0.35f*len, 0.03f,  0.06f);
+      case K_Head:     return r(0.45f*len, 0.04f,  0.075f);
+      case K_UpperArm: return r(0.2f *len, 0.02f,  0.06f);
+      case K_ForeArm:  return r(0.16f*len, 0.018f, 0.05f);
+      case K_Hand:     return r(0.22f*len, 0.012f, 0.03f);
+      case K_Thigh:    return r(0.2f *len, 0.03f,  0.075f);
+      case K_Calf:     return r(0.14f*len, 0.022f, 0.055f);
+      case K_Foot:     return r(0.2f *len, 0.015f, 0.03f);
+      case K_Tail:     return r(0.25f*len, 0.01f,  0.06f);
+      default:         return r(0.2f *len, 0.01f,  0.06f);
+      }
+    }
+
+  bool wantBody(size_t i, float len) const {
+    switch(kind[i]) {
+      case K_Spine:
+      case K_Neck:     return len>=0.06f*S;
+      case K_Head:     return true;
+      case K_UpperArm:
+      case K_ForeArm:
+      case K_Thigh:
+      case K_Calf:     return len>=0.03f*S;
+      case K_Hand:     return len>=0.03f*S;
+      case K_Foot:     return false; // стопа - продолжение голени: лёгкая капсула на пределе голеностопа дрожит
+      case K_Tail:     return len>=0.05f*S;
+      case K_Other:    return len>=0.07f*S;
+      default:         return false;
+      }
+    }
+
+  void limitsOf(Kind k, bool humanoid, Part& p) const {
+    float s1 = 30, s2 = 30, tw = 15;
+    switch(k) {
+      case K_Spine:    s1 = humanoid ? 20 : 15; s2 = s1; tw = humanoid ? 12 : 8; break;
+      case K_Neck:     s1 = 30; s2 = 30; tw = 25; break;
+      case K_Head:     s1 = humanoid ? 35 : 30; s2 = s1; tw = humanoid ? 35 : 20; break;
+      case K_UpperArm: s1 = humanoid ? 70 : 40; s2 = s1; tw = humanoid ? 40 : 15; break;
+      case K_ForeArm:  s1 = 45; s2 = 45; tw = 8;  break;
+      case K_Hand:     s1 = humanoid ? 50 : 30; s2 = humanoid ? 35 : 30; tw = humanoid ? 25 : 8; break;
+      case K_Thigh:    s1 = humanoid ? 55 : 35; s2 = s1; tw = humanoid ? 25 : 10; break;
+      case K_Calf:     s1 = 45; s2 = 45; tw = 8;  break;
+      case K_Foot:     s1 = 30; s2 = humanoid ? 25 : 30; tw = humanoid ? 10 : 8; break;
+      case K_Tail:     s1 = 30; s2 = 30; tw = 15; break;
+      default: break;
+      }
+    p.swing1 = deg(s1);
+    p.swing2 = deg(s2);
+    p.twist  = deg(tw);
+    }
+
+  Matrix4x4 bodyFrame(size_t bone, const Vec3& a, const Vec3& b) const {
+    const auto& m = sk.tr[bone];
+    return mkFrame((a+b)*0.5f, b-a, axisOf(m,1), axisOf(m,2));
+    }
+
+  std::unique_ptr<Ragdoll::Layout> build() {
+    if(n==0 || S<10.f)
+      return nullptr;
+
+    size_t rootBone = findKind(K_Pelvis);
+    if(rootBone==size_t(-1))
+      rootBone = findKind(K_Root);
+    if(rootBone==size_t(-1) && sk.rootNodes.size()>0)
+      rootBone = sk.rootNodes[0];
+    if(rootBone>=n)
+      return nullptr;
+
+    const size_t headBone = findKind(K_Head);
+    bool humanoid = false;
+    if(headBone!=size_t(-1) && findKind(K_Thigh)!=size_t(-1) && findKind(K_UpperArm)!=size_t(-1)) {
+      const Vec3 up = pos[headBone]-pos[rootBone];
+      humanoid = up.length()>0.1f*S && up.y>0.6f*up.length();
+      }
+
+    // кандидаты: кости, у которых будет своё тело
+    struct Cand { size_t bone; Vec3 end; float len; };
+    std::vector<Cand> cand;
+    for(size_t i=0; i<n; ++i) {
+      if(i==rootBone)
+        continue;
+      const Vec3  e   = endOf(i);
+      const float len = (e-pos[i]).length();
+      if(wantBody(i,len))
+        cand.push_back({i,e,len});
+      }
+    // не больше 20 тел: лишние - самые короткие хвосты, крылья и кисти
+    while(cand.size()+1>20) {
+      size_t worst = size_t(-1);
+      for(size_t i=0; i<cand.size(); ++i) {
+        const Kind k = kind[cand[i].bone];
+        if(k!=K_Other && k!=K_Tail && k!=K_Hand && k!=K_Foot)
+          continue;
+        if(worst==size_t(-1) || cand[i].len<cand[worst].len)
+          worst = i;
+        }
+      if(worst==size_t(-1))
+        worst = cand.size()-1;
+      cand.erase(cand.begin()+ptrdiff_t(worst));
+      }
+    if(cand.size()<2)
+      return nullptr;
+
+    auto lay = std::make_unique<Ragdoll::Layout>();
+    lay->size     = S;
+    lay->humanoid = humanoid;
+    lay->driven.assign(n,0);
+
+    std::vector<size_t> partOf(n,size_t(-1));
+    std::vector<Vec3>   partEnd;
+    // часть 0 - таз
+    {
+    Part p;
+    p.bone = rootBone;
+    p.kind = K_Pelvis;
+    lay->parts.push_back(p);
+    partEnd.push_back(pos[rootBone]);
+    partOf[rootBone] = 0;
+    }
+    // остальные - в порядке обхода от корня, чтобы родитель шёл раньше
+    std::vector<size_t> order;
+    {
+    std::vector<size_t> stk(sk.rootNodes.rbegin(), sk.rootNodes.rend());
+    while(!stk.empty()) {
+      const size_t i = stk.back();
+      stk.pop_back();
+      if(i>=n)
+        continue;
+      order.push_back(i);
+      for(auto c=child[i].rbegin(); c!=child[i].rend(); ++c)
+        stk.push_back(*c);
+      }
+    }
+    for(auto i:order) {
+      auto c = std::find_if(cand.begin(),cand.end(),[i](const Cand& x){ return x.bone==i; });
+      if(c==cand.end())
+        continue;
+      // бедро - всегда к тазу, даже если в скелете Biped оно растёт из позвоночника;
+      // плечо - к груди, а не к шее (у Biped ключицы растут из шеи)
+      size_t parent = 0;
+      for(size_t p=sk.nodes[i].parent; p<n && kind[i]!=K_Thigh; p=sk.nodes[p].parent) {
+        if(partOf[p]==size_t(-1))
+          continue;
+        if(kind[i]==K_UpperArm && (kind[p]==K_Neck || kind[p]==K_Head))
+          continue;
+        parent = partOf[p];
+        break;
+        }
+      Part pt;
+      pt.bone   = i;
+      pt.kind   = kind[i];
+      pt.parent = parent;
+      partOf[i] = lay->parts.size();
+      lay->parts.push_back(pt);
+      partEnd.push_back(c->end);
+      }
+
+    // формы тел в позе привязки
+    std::vector<size_t> hips;
+    for(size_t i=1; i<lay->parts.size(); ++i)
+      if(lay->parts[i].kind==K_Thigh && lay->parts[i].parent==0)
+        hips.push_back(i);
+
+    for(size_t i=0; i<lay->parts.size(); ++i) {
+      auto&      p = lay->parts[i];
+      const Vec3 a = pos[p.bone];
+      if(i==0) {
+        if(hips.size()>=2) {
+          const Vec3  l = pos[lay->parts[hips[0]].bone], r = pos[lay->parts[hips[1]].bone];
+          const float w = (l-r).length();
+          const Vec3  c = (l+r)*0.25f + a*0.5f;
+          p.radius  = std::clamp(0.5f*w, 0.05f*S, 0.09f*S);
+          p.halfLen = 0.25f*w;
+          p.bodyBind = mkFrame(c, l-r, axisOf(sk.tr[p.bone],1), axisOf(sk.tr[p.bone],2));
+          } else {
+          // без ног (змеи, мухи): капсула к первой части-потомку
+          Vec3 b = a + Vec3(0,0.1f*S,0);
+          for(size_t r=1; r<lay->parts.size(); ++r)
+            if(lay->parts[r].parent==0) {
+              b = pos[lay->parts[r].bone];
+              break;
+              }
+          if((b-a).length()<0.02f*S)
+            b = a + Vec3(0,0,0.1f*S);
+          const float len = (b-a).length();
+          p.radius   = radiusOf(K_Spine,len);
+          p.halfLen  = std::max(0.5f*len-0.8f*p.radius, 0.15f*len);
+          p.bodyBind = bodyFrame(p.bone,a,b);
+          }
+        } else {
+        const Vec3  b   = partEnd[i];
+        const float len = (b-a).length();
+        p.radius   = radiusOf(Kind(p.kind),len);
+        p.halfLen  = std::max(0.5f*len-0.8f*p.radius, 0.15f*len);
+        p.bodyBind = bodyFrame(p.bone,a,b);
+        }
+      p.bodyInBone = inverseOf(sk.tr[p.bone])*p.bodyBind;
+      p.boneInBody = inverseOf(p.bodyInBone);
+
+      float density = 1050.f;
+      if(p.kind==K_Pelvis || p.kind==K_Spine)
+        density = 900.f;
+      if(p.kind==K_Head)
+        density = 1100.f;
+      const float r = p.radius*0.01f, h = 2.f*p.halfLen*0.01f;
+      const float pi = float(M_PI);
+      p.mass = density*(pi*r*r*h + 4.f/3.f*pi*r*r*r);
+      limitsOf(Kind(p.kind),humanoid,p);
+      lay->driven[p.bone] = 1;
+      }
+
+    float maxMass = 0;
+    for(auto& p:lay->parts)
+      maxMass = std::max(maxMass,p.mass);
+    // большая разница масс соседних тел растягивает суставы при ударах о землю
+    for(auto& p:lay->parts)
+      p.mass = std::max(p.mass, 0.12f*maxMass);
+
+    // колени и локти людей: шарнир, сгиб только вперёд (локоть) или назад (колено)
+    if(humanoid) {
+      for(size_t i=1; i<lay->parts.size(); ++i) {
+        auto&       p  = lay->parts[i];
+        const auto& pp = lay->parts[p.parent];
+        const bool  knee  = (p.kind==K_Calf    && pp.kind==K_Thigh);
+        const bool  elbow = (p.kind==K_ForeArm && pp.kind==K_UpperArm);
+        if(!knee && !elbow)
+          continue;
+        const Vec3 dP   = Vec3::normalize(pos[p.bone]-pos[pp.bone]);
+        const Vec3 dC   = Vec3::normalize(axisOf(p.bodyBind,0));
+        const Vec3 bend = knee ? Vec3(0,0,-1) : Vec3(0,0,1); // модель смотрит вдоль +Z
+        Vec3 ax = Vec3::crossProduct(dP,bend);
+        if(ax.length()<0.35f)
+          continue;
+        ax = Vec3::normalize(ax);
+        const float a0 = std::atan2(Vec3::dotProduct(Vec3::crossProduct(dP,dC),ax), Vec3::dotProduct(dP,dC));
+        Vec3 x = dC - ax*Vec3::dotProduct(dC,ax);
+        if(x.length()<1e-3f)
+          x = dP - ax*Vec3::dotProduct(dP,ax);
+        x = Vec3::normalize(x);
+        const Vec3 y = Vec3::crossProduct(ax,x);
+        const Matrix4x4 j = mkFrame(pos[p.bone], x, y, ax);
+        p.hinge         = true;
+        p.hingeInParent = inverseOf(pp.bodyBind)*j;
+        p.hingeInChild  = inverseOf(p.bodyBind)*j;
+        p.hingeLo       = deg(-3.f)-a0;
+        p.hingeHi       = deg(knee ? 140.f : 145.f)-a0;
+        }
+      }
+
+    // тела, которые касаются друг друга в позе привязки (и соседние), не сталкиваются - иначе дрожат
+    for(size_t i=0; i<lay->parts.size(); ++i)
+      for(size_t r=i+1; r<lay->parts.size(); ++r) {
+        auto& a = lay->parts[i];
+        auto& b = lay->parts[r];
+        const Vec3 ac = originOf(a.bodyBind), ax = Vec3::normalize(axisOf(a.bodyBind,0))*a.halfLen;
+        const Vec3 bc = originOf(b.bodyBind), bx = Vec3::normalize(axisOf(b.bodyBind,0))*b.halfLen;
+        const float d = segmentDistance(ac-ax, ac+ax, bc-bx, bc+bx);
+        // соседи по суставу и через один сустав (братья, «дед») друг друга не толкают
+        const size_t ap  = a.parent, bp = b.parent;
+        const size_t app = ap<lay->parts.size() ? lay->parts[ap].parent : size_t(-1);
+        const size_t bpp = bp<lay->parts.size() ? lay->parts[bp].parent : size_t(-1);
+        const bool   near = (bp==i || ap==r || ap==bp || app==r || bpp==i);
+        if(near || d<(a.radius+b.radius)*1.1f)
+          lay->noCollide.push_back({uint16_t(i),uint16_t(r)});
+        }
+
+    // корень (BIP01) над тазом - за тазом: на него смотрит камера, к нему крепятся слоты
+    {
+    const size_t rp = sk.nodes[rootBone].parent;
+    if(rp<n && partOf[rp]==size_t(-1)) {
+      lay->follower   = rp;
+      lay->driven[rp] = 1;
+      }
+    }
+
+    // грудь: часть, к которой крепится голова, иначе верхняя часть позвоночника
+    lay->chest = 0;
+    for(size_t i=1; i<lay->parts.size(); ++i)
+      if(lay->parts[i].kind==K_Head) {
+        const size_t pp = lay->parts[i].parent;
+        if(lay->parts[pp].kind==K_Spine || lay->parts[pp].kind==K_Neck || lay->parts[pp].kind==K_Pelvis)
+          lay->chest = pp;
+        while(lay->chest!=0 && lay->parts[lay->chest].kind==K_Neck)
+          lay->chest = lay->parts[lay->chest].parent;
+        }
+    if(lay->chest==0)
+      for(size_t i=1; i<lay->parts.size(); ++i)
+        if(lay->parts[i].kind==K_Spine)
+          lay->chest = i;
+    {
+    const auto& m = sk.tr[lay->parts[lay->chest].bone];
+    const Vec3  f = Vec3(0,0,1);
+    Vec3 fl = Vec3(Vec3::dotProduct(Vec3::normalize(axisOf(m,0)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,1)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,2)),f));
+    lay->frontLocal = Vec3::normalize(fl);
+    }
+    return lay;
+    }
+  };
+
+}
+
+const Ragdoll::Layout* Ragdoll::layoutOf(const Skeleton& sk) {
+  static std::mutex                                               sync;
+  static std::map<const Skeleton*, std::unique_ptr<Layout>>       cache;
+  static std::map<const Skeleton*, bool>                          known;
+  std::lock_guard<std::mutex> guard(sync);
+  if(known[&sk])
+    return cache[&sk].get();
+  known[&sk] = true;
+
+  Builder bld(sk);
+  auto    lay = bld.build();
+  if(lay==nullptr) {
+    Log::i("[g2m] ragdoll: skeleton \"",sk.name(),"\" not supported");
+    return nullptr;
+    }
+
+  std::string desc;
+  float total = 0;
+  for(auto& p:lay->parts) {
+    char buf[96] = {};
+    std::snprintf(buf,sizeof(buf)," %s(r%.0f l%.0f %.1fkg%s)", kindName(p.kind), double(p.radius),
+                  double(2.f*(p.halfLen+p.radius)), double(p.mass), p.hinge ? " hinge" : "");
+    desc += buf;
+    total += p.mass;
+    }
+  Log::i("[g2m] ragdoll: \"",sk.name(),"\" ",lay->parts.size()," parts, size ",int(lay->size),"cm, ",
+         int(total),"kg",lay->humanoid ? ", humanoid" : "",":",desc);
+  auto ret = lay.get();
+  cache[&sk] = std::move(lay);
+  return ret;
+  }
+
+Ragdoll::Ragdoll(DynamicWorld& owner, const Skeleton& sk, const Layout& lay, State st)
+  :owner(&owner), sk(&sk), lay(&lay), st(st) {
+  const size_t cnt = lay.parts.size() + (lay.follower!=size_t(-1) ? 1 : 0);
+  boneId.resize(cnt);
+  boneWorld.resize(cnt);
+  for(size_t i=0; i<lay.parts.size(); ++i)
+    boneId[i] = uint16_t(lay.parts[i].bone);
+  if(lay.follower!=size_t(-1))
+    boneId.back() = uint16_t(lay.follower);
+  }
+
+Ragdoll::~Ragdoll() {
+  removeBodies();
+  }
+
+std::unique_ptr<Ragdoll> Ragdoll::create(DynamicWorld& owner, const Skeleton& sk, const Matrix4x4* bones, size_t count, State st,
+                                         float viewDist, bool keep) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || bones==nullptr)
+    return nullptr;
+  for(auto& p:lay->parts)
+    if(p.bone>=count)
+      return nullptr;
+  if(lay->follower!=size_t(-1) && lay->follower>=count)
+    return nullptr;
+  if(!reserve(owner,viewDist,st,keep))
+    return nullptr;
+  std::unique_ptr<Ragdoll> r(new Ragdoll(owner,sk,*lay,st));
+  r->viewDist = viewDist;
+  r->keep     = keep;
+  for(size_t i=0; i<r->boneId.size(); ++i)
+    r->boneWorld[i] = bones[r->boneId[i]];
+  r->setFollower();
+  r->createBodies();
+  r->updateBones();
+  return r;
+  }
+
+std::unique_ptr<Ragdoll> Ragdoll::createFrozen(DynamicWorld& owner, const Skeleton& sk, const std::vector<uint16_t>& bone,
+                                               const std::vector<Matrix4x4>& world, State st) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || world.size()!=bone.size())
+    return nullptr;
+  std::unique_ptr<Ragdoll> r(new Ragdoll(owner,sk,*lay,st));
+  if(bone!=r->boneId)
+    return nullptr; // другая схема (сохранение другой версии) - тело ляжет по анимации
+  r->boneWorld = world;
+  r->setFollower();
+  r->ver++;
+  return r;
+  }
+
+const std::vector<uint8_t>& Ragdoll::driven() const {
+  return lay->driven;
+  }
+
+void Ragdoll::setFollower() {
+  if(lay->follower==size_t(-1))
+    return;
+  Matrix4x4 inv = boneWorld[0];
+  inv.inverse();
+  followerRel = inv*boneWorld.back();
+  }
+
+void Ragdoll::setState(State s) {
+  st = s;
+  }
+
+void Ragdoll::createBodies() {
+  if(!body.empty())
+    return;
+  auto& cw = *owner->world;
+  solverIt = solverItFor(viewDist);
+  body.resize(lay->parts.size());
+  pivot.assign(lay->parts.size(),Vec3());
+
+  std::vector<btTransform> bw(lay->parts.size());
+  for(size_t i=0; i<lay->parts.size(); ++i) {
+    auto& p = lay->parts[i];
+    auto& b = body[i];
+    bw[i] = toBt(boneWorld[i]*p.bodyInBone);
+
+    const float r = p.radius*0.01f, h = 2.f*p.halfLen*0.01f;
+    b.shape.reset(new btCapsuleShapeX(r,h));
+    btVector3 inertia = {};
+    b.shape->calculateLocalInertia(p.mass,inertia);
+    btRigidBody::btRigidBodyConstructionInfo ci(p.mass,nullptr,b.shape.get(),inertia);
+    ci.m_friction           = 0.8f;
+    ci.m_rollingFriction    = 0.06f;
+    ci.m_spinningFriction   = 0.06f;
+    ci.m_restitution        = 0.f;
+    ci.m_linearDamping      = 0.05f;
+    ci.m_angularDamping     = 0.25f;
+    ci.m_linearSleepingThreshold  = 0.1f;
+    ci.m_angularSleepingThreshold = 0.25f;
+    b.rb.reset(new btRigidBody(ci));
+    b.rb->setWorldTransform(bw[i]);
+    b.rb->setUserIndex(DynamicWorld::C_Ragdoll);
+    b.rb->setUserPointer(this);
+    // мелкие части на большой скорости не должны проскакивать сквозь пол
+    b.rb->setCcdMotionThreshold(r*0.5f);
+    b.rb->setCcdSweptSphereRadius(r*0.8f);
+    b.rb->setActivationState(ACTIVE_TAG);
+    }
+
+  for(auto& i:lay->noCollide) {
+    body[i.first ].rb->setIgnoreCollisionCheck(body[i.second].rb.get(),true);
+    body[i.second].rb->setIgnoreCollisionCheck(body[i.first ].rb.get(),true);
+    }
+
+  for(size_t i=1; i<lay->parts.size(); ++i) {
+    auto&        p  = lay->parts[i];
+    const size_t pp = p.parent;
+    auto&        ra = *body[pp].rb;
+    auto&        rb = *body[i ].rb;
+
+    std::unique_ptr<btTypedConstraint> c;
+    if(p.hinge) {
+      const btTransform fa = toBt(p.hingeInParent), fb = toBt(p.hingeInChild);
+      auto h = std::make_unique<btHingeConstraint>(ra,rb,fa,fb,false);
+      // знак угла Bullet: повернуть часть на +0.2 рад в сторону сгиба
+      const btVector3   ax    = bw[pp].getBasis()*fa.getBasis().getColumn(2);
+      const btVector3   pivot = bw[pp]*fa.getOrigin();
+      btTransform toPivot, rot, fromPivot;
+      toPivot  .setIdentity(); toPivot  .setOrigin(-pivot);
+      fromPivot.setIdentity(); fromPivot.setOrigin( pivot);
+      rot      .setIdentity(); rot      .setRotation(btQuaternion(ax,0.2f));
+      const float a0   = h->getHingeAngle(bw[pp],bw[i]);
+      const float a1   = h->getHingeAngle(bw[pp],fromPivot*rot*toPivot*bw[i]);
+      const float sign = (a1>=a0) ? 1.f : -1.f;
+      const float flex = sign*a0;
+      if(p.hingeLo-0.3f<=flex && flex<=p.hingeHi+0.3f) {
+        if(sign>0)
+          h->setLimit(p.hingeLo,p.hingeHi,0.9f,0.3f,1.f); else
+          h->setLimit(-p.hingeHi,-p.hingeLo,0.9f,0.3f,1.f);
+        // жёстче держать ось сустава: при ударе о землю части не расходятся
+        h->setParam(BT_CONSTRAINT_ERP,0.8f);
+        h->setParam(BT_CONSTRAINT_STOP_ERP,0.8f);
+        c = std::move(h);
+        }
+      }
+    if(c==nullptr) {
+      // конус с центром в позе падения: ось - кость-потомок
+      btTransform j = bw[i];
+      j.setOrigin(toBt(boneWorld[i]).getOrigin());
+      const btTransform fa = bw[pp].inverse()*j;
+      const btTransform fb = bw[i ].inverse()*j;
+      auto ct = std::make_unique<btConeTwistConstraint>(ra,rb,fa,fb);
+      ct->setLimit(p.swing1,p.swing2,p.twist,0.9f,0.3f,1.f);
+      for(int ax=0; ax<3; ++ax)
+        ct->setParam(BT_CONSTRAINT_ERP,0.8f,ax);
+      c = std::move(ct);
+      }
+    c->setOverrideNumSolverIterations(solverIt);
+    Joint jt;
+    jt.c      = std::move(c);
+    jt.parent = uint16_t(pp);
+    jt.child  = uint16_t(i);
+    joint.push_back(std::move(jt));
+
+    // где сустав в системе кости-родителя: туда кость-потомок ставится при выводе позы
+    Matrix4x4 inv = boneWorld[pp];
+    inv.inverse();
+    Vec3 piv = originOf(boneWorld[i]);
+    inv.project(piv);
+    pivot[i] = piv;
+    }
+
+  for(auto& b:body)
+    cw.addRagdollBody(b.rb.get());
+  for(auto& j:joint)
+    cw.addConstraint(j.c.get(),true);
+
+  simTime  = 0;
+  calmTime = 0;
+  waterAt  = 0;
+  fallPeak = 0;
+  impact   = 0;
+  inWater  = false;
+  damping  = 0;
+  owner->addRagdoll(this);
+  }
+
+void Ragdoll::removeBodies() {
+  if(body.empty())
+    return;
+  auto& cw = *owner->world;
+  for(auto& j:joint)
+    cw.removeConstraint(j.c.get());
+  for(auto& b:body)
+    cw.removeRagdollBody(b.rb.get());
+  joint.clear();
+  body.clear();
+  owner->delRagdoll(this);
+  }
+
+bool Ragdoll::wake() {
+  if(isSimulated())
+    return true;
+  // застывшее тело оживает от удара, только если в физике есть место
+  if(!reserve(*owner,viewDist,st,keep))
+    return false;
+  createBodies();
+  ver++;
+  return isSimulated();
+  }
+
+void Ragdoll::freeze() {
+  if(!isSimulated())
+    return;
+  updateBones();
+  removeBodies();
+  ver++;
+  }
+
+void Ragdoll::rebase(const Matrix4x4& obj, const std::vector<Matrix4x4>& local) {
+  if(isSimulated())
+    return;
+  for(size_t i=0; i<boneWorld.size() && i<local.size(); ++i)
+    boneWorld[i] = obj*local[i];
+  }
+
+void Ragdoll::setViewDistance(float cm, bool k) {
+  viewDist = cm;
+  keep     = k;
+  const int it = solverItFor(cm);
+  if(it!=solverIt)
+    setSolverIterations(it);
+  }
+
+void Ragdoll::setSolverIterations(int n) {
+  solverIt = n;
+  for(auto& j:joint)
+    j.c->setOverrideNumSolverIterations(n);
+  }
+
+bool Ragdoll::isAirborne() const {
+  if(body.empty())
+    return false;
+  return body[0].rb->getLinearVelocity().y()<-2.f;
+  }
+
+float Ragdoll::takeImpact() {
+  const float v = impact;
+  impact = 0;
+  return v;
+  }
+
+void Ragdoll::setVelocity(const Vec3& v) {
+  const btVector3 bv(v.x,v.y,v.z);
+  for(auto& b:body) {
+    b.rb->setLinearVelocity(bv);
+    b.rb->activate(true);
+    }
+  }
+
+void Ragdoll::hit(const Hit& h) {
+  if(h.power<=0.f || !wake())
+    return;
+
+  Vec3 dir = Vec3::normalize(h.dir);
+  if(dir.y>-0.3f)
+    dir.y = std::max(dir.y,0.f) + 0.25f; // удар немного приподнимает - тело не скользит по земле
+  dir = Vec3::normalize(dir);
+
+  size_t best = 0;
+  float  dist = 1e9f;
+  for(size_t i=0; i<body.size(); ++i) {
+    auto&      p  = lay->parts[i];
+    const auto m  = fromBt(body[i].rb->getWorldTransform());
+    const Vec3 c  = originOf(m), ax = Vec3::normalize(axisOf(m,0))*p.halfLen;
+    const float d = pointSegmentDistance(h.at, c-ax, c+ax) - p.radius;
+    if(d<dist) {
+      dist = d;
+      best = i;
+      }
+    }
+
+  for(size_t i=0; i<body.size(); ++i) {
+    auto&       rb = *body[i].rb;
+    const float k  = (i==best ? 1.f : 0.2f);
+    rb.setLinearVelocity(rb.getLinearVelocity() + btVector3(dir.x,dir.y,dir.z)*(h.power*k));
+    rb.activate(true);
+    }
+  calmTime = 0;
+  }
+
+void Ragdoll::updateBones() {
+  if(body.empty())
+    return;
+  // поворот кости - от её тела, начало - точно в суставе родителя: даже если физика на миг развела
+  // части (удар о землю), на коже щелей и растяжек нет. Родитель всегда раньше потомка (Layout)
+  for(size_t i=0; i<body.size(); ++i) {
+    boneWorld[i] = fromBt(body[i].rb->getWorldTransform())*lay->parts[i].boneInBody;
+    if(i==0)
+      continue;
+    Vec3 at = pivot[i];
+    boneWorld[lay->parts[i].parent].project(at);
+    boneWorld[i].set(3,0,at.x);
+    boneWorld[i].set(3,1,at.y);
+    boneWorld[i].set(3,2,at.z);
+    }
+  if(lay->follower!=size_t(-1))
+    boneWorld.back() = boneWorld[0]*followerRel;
+  ver++;
+  }
+
+void Ragdoll::preStep(float dt) {
+  if(body.empty())
+    return;
+  // «Мышцы»: трение в суставах. Сразу после удара тело ещё держится, затем обмякает;
+  // потерявший сознание оседает мягче убитого
+  const float t = float(simTime);
+  float f = 0;
+  if(st==S_Dead)
+    f = (t<350.f ? 0.35f*(1.f-t/350.f) : 0.f) + 0.08f;
+  else if(st==S_Unconscious)
+    f = (t<700.f ? 0.5f *(1.f-t/700.f) : 0.f) + 0.15f;
+  else
+    f = 0.3f; // живой: напряжён, руки и ноги не болтаются
+  if(inWater)
+    f = std::max(f,0.3f);
+  f = 1.f - std::pow(1.f-std::clamp(f,0.f,0.95f), dt*60.f);
+
+  for(auto& j:joint) {
+    auto& a = *body[j.parent].rb;
+    auto& b = *body[j.child ].rb;
+    if(!a.isActive() && !b.isActive())
+      continue;
+    const float     ma  = lay->parts[j.parent].mass, mb = lay->parts[j.child].mass;
+    const btVector3 rel = b.getAngularVelocity() - a.getAngularVelocity();
+    a.setAngularVelocity(a.getAngularVelocity() + rel*(f*mb/(ma+mb)));
+    b.setAngularVelocity(b.getAngularVelocity() - rel*(f*ma/(ma+mb)));
+    }
+  }
+
+void Ragdoll::afterStep(uint64_t dt) {
+  if(body.empty())
+    return;
+  simTime += dt;
+  updateBones();
+
+  // в воде тело не падает камнем, а медленно погружается. Луч к воде - раз в 100 мс, не каждый кадр
+  if(simTime>=waterAt+100 || waterAt==0) {
+    waterAt = simTime;
+    const auto root  = rootPosition();
+    const auto wr    = owner->waterRay(root, 0.f);
+    const bool water = wr.hasCol && wr.wdepth>root.y;
+    if(water!=inWater) {
+      inWater = water;
+      damping = -1;
+      }
+    }
+  // тело в воде почти ничего не весит - медленно тонет, а не падает камнем.
+  // Сила действует весь следующий шаг физики (Bullet сбрасывает силы в конце stepSimulation)
+  if(inWater)
+    for(size_t i=0; i<body.size(); ++i)
+      body[i].rb->applyCentralForce(btVector3(0,0.85f*DynamicWorld::gravityMS*lay->parts[i].mass,0));
+
+  // скорость поверхности тел: лёгкая кисть, чуть качающаяся на месте, не мешает телу «улечься»
+  float maxV = 0;
+  bool  active = false;
+  for(size_t i=0; i<body.size(); ++i) {
+    auto&       rb = *body[i].rb;
+    const auto& p  = lay->parts[i];
+    active |= rb.isActive();
+    const float v = rb.getLinearVelocity().length() + rb.getAngularVelocity().length()*(p.halfLen+p.radius)*0.01f;
+    maxV = std::max(maxV,v);
+    }
+  // удар о землю после падения: таз резко замедлился - скорость до удара (урон от падения, Npc::tickRagdollFall)
+  {
+  const btVector3 v  = body[0].rb->getLinearVelocity();
+  const float     vy = v.y();
+  if(inWater) {
+    fallPeak = 0; // в воду - без урона, как в игре
+    }
+  else if(vy<-2.f) {
+    fallPeak = std::max(fallPeak, v.length());
+    }
+  else if(fallPeak>0.f && -vy<0.5f*fallPeak) {
+    impact   = std::max(impact, fallPeak);
+    fallPeak = 0;
+    }
+  }
+
+  // почти лёг - сильнее гасить движение, иначе капсулы долго дрожат на пределах суставов;
+  // срок в физике подходит к концу (SettleTime) - ещё сильнее, чтобы тело остановилось само, без рывка
+  int lvl = 0;
+  if(inWater)
+    lvl = 3;
+  else if(st!=S_Fall && simTime>SettleTime && !isAirborne())
+    lvl = 2;
+  else if(maxV<0.4f && simTime>500)
+    lvl = 1;
+  if(lvl!=damping) {
+    damping = lvl;
+    static const float lin[] = {0.05f, 0.4f,  0.8f,  0.9f};
+    static const float ang[] = {0.25f, 0.85f, 0.95f, 0.9f};
+    for(auto& b:body)
+      b.rb->setDamping(lin[lvl], ang[lvl]);
+    }
+  // редкое вздрагивание лёгкой части не отменяет «улеглось», а только отодвигает
+  if(!active || maxV<0.15f)
+    calmTime += dt; else
+    calmTime = (calmTime>2*dt ? calmTime-2*dt : 0);
+#ifdef RAGDOLL_TRACE
+  if(simTime%250<dt) {
+    size_t w = 0; float wv = 0;
+    for(size_t i=0; i<body.size(); ++i) {
+      auto& rb = *body[i].rb; auto& p = lay->parts[i];
+      const float v = rb.getLinearVelocity().length() + rb.getAngularVelocity().length()*(p.halfLen+p.radius)*0.01f;
+      if(v>wv) { wv=v; w=i; }
+      }
+    auto& rb = *body[w].rb;
+    std::printf("     sim=%5d maxV=%.3f %s lin=%.3f ang=%.3f active=%d calm=%d\n",int(simTime),double(maxV),kindName(lay->parts[w].kind),
+                double(rb.getLinearVelocity().length()),double(rb.getAngularVelocity().length()),int(rb.isActive()),int(calmTime));
+    }
+#endif
+  }
+
+bool Ragdoll::isExpired(float minY) const {
+  if(rootPosition().y<minY)
+    return true; // провалилось под мир
+  if(st==S_Fall)
+    return simTime>FallMaxTime; // живой встаёт сам (Npc::tickRagdollFall)
+  if(calmTime>CalmTime)
+    return true;
+  if(simTime>LiveTime && !isAirborne())
+    return true;
+  return simTime>AirTime;
+  }
+
+void Ragdoll::preStepAll(const std::vector<Ragdoll*>& active, float dt) {
+  for(auto r:active)
+    r->preStep(dt);
+  }
+
+void Ragdoll::tickAll(std::vector<Ragdoll*>& active, uint64_t dt, float minY) {
+  // застывшая кукла сама уходит из списка (removeBodies): на её место встаёт последняя - её и смотрим
+  for(size_t i=0; i<active.size();) {
+    auto r = active[i];
+    r->afterStep(dt);
+    if(r->isExpired(minY))
+      r->freeze(); else
+      ++i;
+    }
+  // бюджет (на случай, если reserve обошли): лишние застывают по очереди evictScore; кукла героя - сверх бюджета
+  while(countedIn(active)>MaxSimulated) {
+    Ragdoll* worst = nullptr;
+    float    score = 0;
+    for(auto r:active) {
+      if(r->keep)
+        continue;
+      const float s = evictScore(r->viewDist,r->simTime,r->st,r->keep);
+      if(worst==nullptr || s>score) {
+        worst = r;
+        score = s;
+        }
+      }
+    worst->freeze();
+    }
+  }
+
+bool Ragdoll::reserve(DynamicWorld& owner, float viewDist, State st, bool keep) {
+  // Место в физике для новой куклы. Нет - освободить его может только тело, которое уже упало (в физике
+  // дольше SettleMinTime): застыть посреди падения - значит замереть стоя или на коленях. Иначе новое тело
+  // падает анимацией игры - и первый шаг физики не тратит время на кучу тел разом
+  // Кукла героя - всегда и сверх бюджета (она одна)
+  auto& active = owner.ragdollsActive();
+  if(keep || countedIn(active)<MaxSimulated)
+    return true;
+  const float mine  = evictScore(viewDist,0,st,keep);
+  Ragdoll*    worst = nullptr;
+  float       score = 0;
+  for(auto r:active) {
+    if(r->keep || r->st==S_Fall || r->simTime<SettleMinTime)
+      continue; // живой падающий встал бы посреди полёта
+    const float s = evictScore(r->viewDist,r->simTime,r->st,r->keep);
+    if(s>mine && (worst==nullptr || s>score)) {
+      worst = r;
+      score = s;
+      }
+    }
+  if(worst==nullptr)
+    return false;
+  worst->freeze();
+  return true;
+  }
+
+size_t Ragdoll::countedIn(const std::vector<Ragdoll*>& active) {
+  size_t n = 0;
+  for(auto r:active)
+    if(!r->keep)
+      n++;
+  return n;
+  }
+
+Vec3 Ragdoll::rootPosition() const {
+  return originOf(boneWorld[0]);
+  }
+
+Vec3 Ragdoll::chestPosition() const {
+  return originOf(boneWorld[lay->chest]);
+  }
+
+size_t Ragdoll::rootBone() const {
+  return lay->parts[0].bone;
+  }
+
+size_t Ragdoll::chestBone() const {
+  return lay->parts[lay->chest].bone;
+  }
+
+Vec3 Ragdoll::chestFront() const {
+  return chestFront(boneWorld[lay->chest]);
+  }
+
+Vec3 Ragdoll::chestFront(const Matrix4x4& m) const {
+  const Vec3 f = lay->frontLocal;
+  return Vec3::normalize(Vec3::normalize(axisOf(m,0))*f.x +
+                         Vec3::normalize(axisOf(m,1))*f.y +
+                         Vec3::normalize(axisOf(m,2))*f.z);
+  }
