+void TouchInput::release(Ctl c, Finger& f) {
+  switch(c) {
+    case C_Joy:
+      ctrl.setTouchMove(0, 0);
+      break;
+    case C_Attack:
+      ctrl.setTouchAttack(false);
+      break;
+    case C_Block:
+      ctrl.setTouchBlock(false);
+      break;
+    case C_Jump:
+      ctrl.onKeyReleased(KeyCodec::Jump, KeyCodec::Mapping::Primary);
+      break;
+    case C_Weapon: {
+      // Коснуться - меч (или последнее оружие), подержать - лук
+      const bool longPress = Application::tickCount()-f.downAt>=450;
+      const auto act       = longPress ? KeyCodec::WeaponBow : KeyCodec::Weapon;
+      ctrl.onKeyPressed (act, Event::K_NoKey, KeyCodec::Mapping::Primary);
+      ctrl.onKeyReleased(act, KeyCodec::Mapping::Primary);
+      break;
+      }
+    case C_Up:
+    case C_Down:
+    case C_Left:
+    case C_Right:
+      if(repeatCtl==c) {
+        repeatCtl = C_None;
+        repeatTimer.stop();
+        }
+      break;
+    default:
+      break;
+    }
+  }
+
+void TouchInput::releaseAll() {
