+void PlayerControl::setTouchMove(int forward, int side, bool run) {
+  auto w     = Gothic::inst().world();
+  auto pl    = w ? w->player() : nullptr;
+  // С оружием в руках вбок - шаг в сторону (уклон), без оружия - поворот
+  bool fight = pl!=nullptr && pl->weaponState()!=WeaponState::NoWeapon;
+  // Джойстик чуть сдвинут - шаг, до края - бег. Отпустили - снова бег: так по умолчанию в игре.
+  // Подкрадывание включается своей кнопкой и джойстиком не меняется
+  if(pl!=nullptr && (pl->walkMode()&WalkBit::WM_Sneak)!=WalkBit::WM_Sneak) {
+    const bool walk   = !run && (forward!=0 || side!=0);
+    const bool isWalk = (pl->walkMode()&WalkBit::WM_Walk)==WalkBit::WM_Walk;
+    if(walk!=isWalk)
+      pl->setWalkMode(pl->walkMode()^WalkBit::WM_Walk);
+    }
+  auto fwd   = forward>0 ? Action::Forward : (forward<0 ? Action::Back : Action::Idle);
+  auto sd    = Action::Idle;
+  if(side<0)
+    sd = fight ? Action::Left  : Action::RotateL;
+  if(side>0)
+    sd = fight ? Action::Right : Action::RotateR;
+
+  if(fwd!=touchFwdAct) {
+    if(touchFwdAct!=Action::Idle)
+      onKeyReleased(touchFwdAct,KeyCodec::Mapping::Secondary);
+    touchFwdAct = fwd;
+    if(fwd!=Action::Idle)
+      onKeyPressed(fwd,Tempest::KeyEvent::K_NoKey,KeyCodec::Mapping::Secondary);
+    }
+  if(sd!=touchSideAct) {
+    if(touchSideAct!=Action::Idle)
+      onKeyReleased(touchSideAct,KeyCodec::Mapping::Secondary);
+    touchSideAct = sd;
+    if(sd!=Action::Idle)
+      onKeyPressed(sd,Tempest::KeyEvent::K_NoKey,KeyCodec::Mapping::Secondary);
+    }
+  }
