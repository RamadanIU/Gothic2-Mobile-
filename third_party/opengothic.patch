+  f.last   = e.pos();
+  f.downAt = Application::tickCount();
+
+  if(ui==Ui::Edit) {
+    f.ctl = C_Absorb;
+    editDown(e.mouseID, e.pos());
+    update();
+    return;
+    }
+
+  // Карта «Путь», подтверждение, затемнение: касание - только им (выбор - на отпускание)
+  if(ui==Ui::Travel || ui==Ui::Confirm || ui==Ui::Fade) {
+    f.ctl = C_Absorb;
+    if(ui==Ui::Travel && mapFinger<0) {
+      mapFinger = e.mouseID;
+      mapDownAt = e.pos();
+      mapDrag   = false;
+      }
+    return;
+    }
+
+  // Колесо открыто и ждёт выбора: касание выбирает или закрывает его
+  if(wheel!=Wheel::None && wheelOwner<0) {
+    applyWheel(wheelPickAt(e.pos()));
+    closeWheel();
+    f.ctl = C_Absorb;
+    return;
+    }
+
+  Ctl c = hitTest(e.pos());
+  if(c==C_None && ui==Ui::Menu) {
+    // Меню игры: касание по пунктам, журналу, ползункам - у самого меню (слой под нами)
+    f = Finger();
     e.ignore();
