+  for(auto it = from.iterator(fromChest ? Inventory::T_Inventory : Inventory::T_Ransack); it.isValid(); ++it)
+    items.emplace_back(it->clsId(), it.count());
+  for(auto& [cls,count]:items) {
+    if(fromChest)
+      player->addItem(cls,*chest,count); else
+      player->addItem(cls,*trader,count);
