+#include "touchicons.h"
+
+#include <Tempest/Pixmap>
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+#include "resources.h"
+
+using namespace Tempest;
+
+// Gothic II Mobile: значки сенсорных кнопок.
+// Каждый значок - набор фигур в квадрате 0..1 (y вниз): отрезки со скруглёнными концами, круги, кольца,
+// дуги и многоугольники. Покрытие пикселя считается по расстоянию до фигуры - края сглажены на любом
+// размере. Фигуры «выреза» стирают уже нарисованное: так делаются прожилки клинка, пальцы, страницы.
+
+namespace {
+
+struct P {
+  float x = 0, y = 0;
+  };
+
+static P     operator + (P a, P b)     { return P{a.x+b.x, a.y+b.y}; }
+static P     operator - (P a, P b)     { return P{a.x-b.x, a.y-b.y}; }
+static P     operator * (P a, float k) { return P{a.x*k, a.y*k}; }
+static float dot(P a, P b)             { return a.x*b.x + a.y*b.y; }
+static float len(P a)                  { return std::sqrt(dot(a,a)); }
+
+static const float Pi = 3.14159265f;
+
+struct Shape {
+  enum Kind : uint8_t {
+    Seg,
+    Disc,
+    Ring,
+    Arc,
+    Poly,
+    };
+  Kind           kind  = Seg;
+  bool           erase = false;
+  float          w     = 0;
+  P              a, b;
+  float          r     = 0;
+  float          a0    = 0;
+  float          a1    = 0;
+  std::vector<P> pts;
+  };
+
+float distSeg(P p, P a, P b) {
+  const P     e  = b-a;
+  const float ee = dot(e,e);
+  const float t  = ee>0 ? std::clamp(dot(p-a,e)/ee, 0.f, 1.f) : 0.f;
+  return len(p-(a+e*t));
+  }
+
+float sdf(const Shape& s, P p) {
+  switch(s.kind) {
+    case Shape::Seg:
+      return distSeg(p,s.a,s.b) - s.w*0.5f;
+    case Shape::Disc:
+      return len(p-s.a) - s.r;
+    case Shape::Ring:
+      return std::abs(len(p-s.a) - s.r) - s.w*0.5f;
+    case Shape::Arc: {
+      // углы в градусах, против часовой стрелки, 0 - вправо (как в математике, y вверх)
+      const P     d   = p-s.a;
+      float       ang = std::atan2(-d.y, d.x)*180.f/Pi;
+      const float t   = std::fmod(ang-s.a0+720.f, 360.f);
+      if(t<=s.a1-s.a0)
+        return std::abs(len(d)-s.r) - s.w*0.5f;
+      const float r0 = s.a0*Pi/180.f, r1 = s.a1*Pi/180.f;
+      const P     e0 = s.a + P{std::cos(r0), -std::sin(r0)}*s.r;
+      const P     e1 = s.a + P{std::cos(r1), -std::sin(r1)}*s.r;
+      return std::min(len(p-e0), len(p-e1)) - s.w*0.5f;
+      }
+    case Shape::Poly: {
+      float d      = 1e9f;
+      bool  inside = false;
+      for(size_t i=0, j=s.pts.size()-1; i<s.pts.size(); j=i++) {
+        const P a = s.pts[j], b = s.pts[i];
+        d = std::min(d, distSeg(p,a,b));
+        if(((a.y>p.y)!=(b.y>p.y)) && (p.x < (b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x))
+          inside = !inside;
+        }
+      return inside ? -d : d;
+      }
+    }
+  return 1e9f;
+  }
+
+// Построитель значка: текущее преобразование (поворот по часовой стрелке, масштаб, сдвиг относительно
+// центра) применяется к фигурам при добавлении.
+class Glyph {
+  public:
+    Glyph& seg(P a, P b, float w) {
+      Shape s; s.kind = Shape::Seg; s.a = tr(a); s.b = tr(b); s.w = w*sc;
+      return put(std::move(s));
+      }
+    Glyph& line(std::initializer_list<P> pts, float w) {
+      const P* prev = nullptr;
+      for(auto& i:pts) {
+        if(prev!=nullptr)
+          seg(*prev,i,w);
+        prev = &i;
+        }
+      return *this;
+      }
+    Glyph& disc(P c, float r) {
+      Shape s; s.kind = Shape::Disc; s.a = tr(c); s.r = r*sc;
+      return put(std::move(s));
+      }
+    Glyph& ring(P c, float r, float w) {
+      Shape s; s.kind = Shape::Ring; s.a = tr(c); s.r = r*sc; s.w = w*sc;
+      return put(std::move(s));
+      }
+    Glyph& arc(P c, float r, float a0, float a1, float w) {
+      Shape s; s.kind = Shape::Arc; s.a = tr(c); s.r = r*sc; s.w = w*sc;
+      s.a0 = a0-rot; s.a1 = a1-rot;
+      return put(std::move(s));
+      }
+    Glyph& poly(std::initializer_list<P> pts) {
+      Shape s; s.kind = Shape::Poly;
+      for(auto& i:pts)
+        s.pts.push_back(tr(i));
+      return put(std::move(s));
+      }
+    // Наконечник стрелки: острие tip, направление dir
+    Glyph& head(P tip, P dir, float l, float w) {
+      const float k = len(dir);
+      const P     d = dir*(1.f/k);
+      const P     n = P{-d.y, d.x};
+      const P     b = tip-d*l;
+      return poly({tip, b+n*(w*0.5f), b-n*(w*0.5f)});
+      }
+    Glyph& cut() { erase = true;  return *this; }
+    Glyph& add() { erase = false; return *this; }
+
+    Glyph& push(float angle, float scale = 1.f, P offset = P{}) {
+      stk.push_back({rot,sc,off});
+      rot += angle;
+      sc  *= scale;
+      off  = off + offset;
+      return *this;
+      }
+    Glyph& pop() {
+      rot = stk.back().rot;
+      sc  = stk.back().sc;
+      off = stk.back().off;
+      stk.pop_back();
+      return *this;
+      }
+
+    std::vector<Shape> shapes;
+
+  private:
+    struct Tr {
+      float rot = 0, sc = 1;
+      P     off;
+      };
+    float           rot   = 0;
+    float           sc    = 1;
+    P               off;
+    bool            erase = false;
+    std::vector<Tr> stk;
+
+    P tr(P p) const {
+      const float r = rot*Pi/180.f;
+      const float c = std::cos(r), s = std::sin(r);
+      const P     d = (p-P{0.5f,0.5f})*sc;
+      return P{0.5f + d.x*c - d.y*s, 0.5f + d.x*s + d.y*c} + off;
+      }
+    Glyph& put(Shape&& s) {
+      s.erase = erase;
+      shapes.push_back(std::move(s));
+      return *this;
+      }
+  };
+
+void swordShape(Glyph& g) {
