+    const float q = std::sqrt(1.f+r(2,2)-r(0,0)-r(1,1))*2.f;
+    w = (r(1,0)-r(0,1))/q;
+    x = (r(0,2)+r(2,0))/q;
+    y = (r(1,2)+r(2,1))/q;
+    z = 0.25f*q;
+    }
+  s.rotation   = zenkit::Quat(w,x,y,z);
+  s.position.x = m.at(3,0);
+  s.position.y = m.at(3,1);
+  s.position.z = m.at(3,2);
+  return s;
+  }
+
+void Pose::setRagdoll(const std::vector<uint8_t>& driven, const std::vector<uint16_t>& bones,
+                      const std::vector<Tempest::Matrix4x4>& local, float weight) {
+  if(ragFrozen.empty() && skeleton!=nullptr) {
+    // поза в момент падения: анимация смерти под куклой идёт дальше, а ключицы, пальцы, шея между
+    // суставами куклы не должны от неё двигаться - иначе плечо «отрывается» от груди
+    ragFrozen.resize(numBones);
+    for(size_t i=0; i<numBones; ++i)
+      ragFrozen[i] = hasSamples[i] ? base[i] : toSample(skeleton->nodes[i].tr);
+    }
+  if(ragBone.size()!=driven.size())
+    ragBone = driven;
+  if(ragLocal.size()<driven.size())
+    ragLocal.resize(driven.size());
+  for(size_t i=0; i<bones.size() && i<local.size(); ++i)
+    if(bones[i]<ragLocal.size())
+      ragLocal[bones[i]] = local[i];
+  ragWeight = std::clamp(weight,0.f,1.f);
+  ragDirty  = true;
+  }
+
+void Pose::clearRagdoll() {
+  if(ragWeight<=0.f && ragBone.empty())
+    return;
+  ragBone.clear();
+  ragLocal.clear();
+  ragFrozen.clear();
+  ragWeight    = 0;
+  ragDirty     = true;
+  needToUpdate = true;
+  }
+
+Matrix4x4 Pose::localOf(size_t i) const {
+  const auto& n = skeleton->nodes[i];
+  if(ragWeight<=0.f || i>=ragFrozen.size() || (i<ragBone.size() && ragBone[i]!=0))
+    return hasSamples[i] ? mkMatrix(base[i]) : n.tr;
+  if(ragWeight>=1.f)
+    return mkMatrix(ragFrozen[i]);
+  const auto anim = hasSamples[i] ? base[i] : toSample(n.tr);
+  return mkMatrix(mix(anim,ragFrozen[i],ragWeight));
+  }
+
+void Pose::applyRagdoll(size_t i) {
+  if(ragWeight>=1.f) {
+    tr[i] = pos*ragLocal[i];
+    return;
+    }
+  // смешивание в системе объекта: поворот - по дуге, сдвиг - по прямой
+  const auto a = toSample(ragPosInv*tr[i]);
+  const auto b = toSample(ragLocal[i]);
+  tr[i] = pos*mkMatrix(mix(a,b,ragWeight));
+  }
+
+void Pose::sampleObjectPose(const Skeleton& sk, const Animation::Sequence& sq, uint64_t time, std::vector<Tempest::Matrix4x4>& out) {
+  const auto&  nodes = sk.nodes;
+  const auto&  d     = *sq.data;
+  const size_t idSz  = d.nodeIndex.size();
+  out.resize(nodes.size());
+
+  std::vector<int32_t> sampleOf(nodes.size(),-1);
+  for(size_t i=0; i<idSz; ++i)
+    if(d.nodeIndex[i]<nodes.size())
+      sampleOf[d.nodeIndex[i]] = int32_t(i);
+
+  size_t frame = 0;
+  if(d.numFrames>0 && idSz>0 && d.samples.size()>=d.numFrames*idSz) {
+    frame = size_t(float(time)*d.fpsRate/1000.f);
+    frame = std::min<size_t>(frame, d.numFrames-1);
+    if(sq.reverse)
+      frame = d.numFrames-1-frame;
+    }
+
+  auto local = [&](size_t i) {
+    const int32_t id = sampleOf[i];
+    if(id<0 || d.samples.size()<(frame+1)*idSz)
+      return nodes[i].tr;
+    auto smp = d.samples[frame*idSz+size_t(id)];
+    if(nodes[i].parent==size_t(-1)) {
+      smp.position.x = 0;
+      smp.position.z = 0;
+      }
+    return mkMatrix(smp);
+    };
+
+  std::vector<uint8_t> done(nodes.size(),0);
+  for(size_t pass=0; pass<nodes.size(); ++pass) {
+    bool progress = false;
+    for(size_t i=0; i<nodes.size(); ++i) {
+      if(done[i])
+        continue;
+      const size_t p = nodes[i].parent;
+      if(p<nodes.size() && !done[p])
+        continue;
+      out[i]  = (p<nodes.size() ? out[p]*local(i) : local(i));
+      done[i] = 1;
+      progress = true;
+      }
+    if(!progress)
+      break;
+    }
+  }
+
+bool Pose::replaceLayer(const Animation::Sequence* sq, uint64_t tickCount) {
+  if(sq==nullptr)
+    return false;
+  for(auto& i:lay)
+    if(i.seq->layer==sq->layer) {
+      if(i.seq==sq)
+        return true;
+      onRemoveLayer(i);
+      i.seq    = sq;
+      i.sAnim  = tickCount;
+      i.sBlend = 0;
+      i.comb   = 0;
+      onAddLayer(i);
+      return true;
+      }
+  return false;
+  }
