+
+// Gothic II Mobile: регдолл. Убитый или оглушённый падает по физике (physics/ragdoll.h): кукла начинается
+// с позы, в которой его застал удар, удар толкает задетую часть тела, разбег несёт тело дальше. Пока тело
+// лежит по физике, позиция NPC идёт за тазом (обыск, фокус, подъём - там, где лежит тело), перемещение
+// анимацией выключено. Состояние тела для скриптов (BS_DEAD, BS_UNCONSCIOUS) даёт анимация под куклой.
+bool Npc::ragdollAllowed() const {
+  if(!Gothic::options().ragdoll)
+    return false;
+  if(isSwim() || isDive())
+    return false; // в воде - тонет по анимации
+  if(owner.version().game==2) {
+    switch(guild()) {
+      // каменные и огромные: големы и стражи рассыпаются, драконы и мясные жуки - по анимации
+      case GIL_DRAGON:
+      case GIL_STONEGOLEM:
+      case GIL_FIREGOLEM:
+      case GIL_ICEGOLEM:
+      case GIL_SUMMONED_GOLEM:
+      case GIL_SWAMPGOLEM:
+      case GIL_Stoneguardian:
+      case GIL_Gargoyle:
+      case GIL_MEATBUG:
+        return false;
+      default:
+        break;
+      }
+    }
+  // далеко от героя и камеры падение никто не разглядит - по анимации, физика не бесплатна;
+  // без камеры (мир ещё загружается, убитые скриптом при старте) - тоже
+  float dist = 0;
+  bool  keep = false;
+  if(!ragdollViewDistance(dist,keep) || dist>Ragdoll::StartDist)
+    return false;
+  return true;
+  }
+
+bool Npc::ragdollViewDistance(float& dist, bool& keep) const {
+  // ближнее из расстояний до камеры и до героя; кукла героя - в бюджете физики последней
+  auto camera = Gothic::inst().camera();
+  if(camera==nullptr)
+    return false;
+  dist = (camera->originLwc()-position()).length();
+  if(auto pl = owner.player())
+    dist = std::min(dist, (pl->position()-position()).length());
+  keep = isPlayer();
+  return true;
+  }
+
+bool Npc::isRagdollFall() const {
+  return ragdoll!=nullptr && ragdoll->state()==Ragdoll::S_Fall;
+  }
+
+bool Npc::ragdollFallAllowed() const {
+  // Живой падает по физике только человеком: встаёт он анимацией подъёма раненого (на спине и на животе)
+  if(!Gothic::options().ragdollFall || ragdoll!=nullptr || isDown())
+    return false;
+  if(interactive()!=nullptr || isSwim() || isDive() || mvAlgo.isClimb())
+    return false;
+  if(!ragdollAllowed())
+    return false;
+  for(auto name:{"S_WOUNDED","S_WOUNDEDB","T_WOUNDED_2_STAND","T_WOUNDEDB_2_STAND"})
+    if(visual.findSequence(name)==nullptr)
+      return false;
+  // под ногами вода - нырнёт, как в игре
+  const auto wr = owner.physic()->waterRay(position(), 0.f);
+  if(wr.hasCol)
+    return false;
+  return true;
+  }
+
+void Npc::startRagdollFall() {
+  if(!ragdollFallAllowed())
+    return;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+  auto& pose = visual.pose();
+  const auto root = pose.rootBone();
+  if((Vec3(root.at(3,0),root.at(3,1),root.at(3,2))-position()).length()>500.f)
+    return;
+  float dist = 0;
+  bool  keep = false;
+  ragdollViewDistance(dist,keep);
+  ragdoll = Ragdoll::create(*owner.physic(), *sk, pose.transform(), pose.boneCount(), Ragdoll::S_Fall, dist, keep);
+  if(ragdoll==nullptr)
+    return;
+  Vec3 v = ragVelocity*10.f; // см/мс -> м/с
+  if(v.length()>40.f)
+    v = Vec3();
+  ragdoll->setVelocity(v);
+  applyRagdollHit();
+  ragBlendStart = 0;
+  ragPushedVer  = 0;
+  ragFollowVer  = 0;
+  ragAirTime    = 0;
+  // падение ведёт кукла: урон от удара о землю - по ней (tickRagdollFall), у перемещения анимацией - без падения
+  mvAlgo.clearFall();
+  Log::i("[g2m] ragdoll: \"",displayName(),"\" falls alive, ",int(v.length()+0.5f)," m/s");
+  }
+
+void Npc::tickRagdollFall() {
+  followRagdoll();
+  // удар о землю - урон от падения по правилам игры (MoveAlgo на приземлении): разбился - лежит дальше как
+  // убитый или без сознания (onNoHealth -> startRagdoll меняет состояние куклы)
+  if(const float v = ragdoll->takeImpact(); v>0.f) {
+    takeFallDamage(Vec3(0,-v*0.1f,0)); // м/с -> см/мс
+    if(ragdoll==nullptr || ragdoll->state()!=Ragdoll::S_Fall)
+      return;
+    }
+  // лежит не меньше RagdollFallHold, потом встаёт, как только тело улеглось (или застыло: срок, бюджет, дальность)
+  const uint64_t t       = ragdoll->simulatedTime();
+  const bool     settled = !ragdoll->isAirborne() && (ragdoll->isCalm(300) || t>=RagdollFallLimit);
+  if(ragdoll->isSimulated() && (t<RagdollFallHold || !settled))
+    return;
+  ragdollGetUp();
+  setAnim(Anim::Idle);
+  if(!isPlayer())
+    implAniWait(visual.pose().animationTotalTime());
+  }
+
+void Npc::applyRagdollHit() {
+  if(ragdoll==nullptr || ragHit.time!=owner.tickCount() || ragHit.power<=0.f)
+    return;
+  Ragdoll::Hit h;
+  h.at    = ragHit.at;
+  h.dir   = ragHit.dir;
+  h.power = ragHit.power;
+  ragdoll->hit(h);
+  ragHit.power = 0;
+  }
+
+void Npc::startRagdoll(bool death) {
+  const auto st = death ? Ragdoll::S_Dead : Ragdoll::S_Unconscious;
+  if(ragdoll!=nullptr && ragBlendStart!=0) {
+    // сбили, пока вставал: новая кукла - из той позы, в которой он сейчас
+    ragdoll.reset();
+    ragBlendStart = 0;
+    visual.clearRagdollPose();
+    }
+  if(ragdoll!=nullptr) {
+    // уже лежит: оглушённого добили, лежащего ударили - тело снова двигается
+    ragdoll->setState(st);
+    applyRagdollHit();
+    return;
+    }
+  if(!ragdollAllowed())
+    return;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+
+  auto& pose = visual.pose();
+  // скелет ещё ни разу не считался (NPC только появился) - кукле не с чего начать
+  const auto root = pose.rootBone();
+  if((Vec3(root.at(3,0),root.at(3,1),root.at(3,2))-position()).length()>500.f)
+    return;
+  float dist = 0;
+  bool  keep = false;
+  ragdollViewDistance(dist,keep);
+  // в физике нет места (большая драка) - падает анимацией игры, как без регдолла
+  ragdoll = Ragdoll::create(*owner.physic(), *sk, pose.transform(), pose.boneCount(), st, dist, keep);
+  if(ragdoll==nullptr)
+    return;
+
+  Vec3 v = ragVelocity*10.f; // см/мс -> м/с
+  if(v.length()>20.f)
+    v = Vec3(); // телепорт, а не бег
+  ragdoll->setVelocity(v);
+  applyRagdollHit();
+  ragBlendStart = 0;
+  ragPushedVer  = 0;
+  ragFollowVer  = 0;
+  }
+
+void Npc::tickRagdoll() {
+  if(ragdoll==nullptr)
+    return;
+  if(ragBlendStart==0) {
+    // дальние куклы считаются проще; ушли от тела далеко - оно застывает (но не посреди падения: замерло бы стоя)
+    if(ragdoll->isSimulated()) {
+      float dist = 0;
+      bool  keep = false;
+      if(ragdollViewDistance(dist,keep)) {
+        ragdoll->setViewDistance(dist,keep);
+        if(!keep && dist>Ragdoll::FreezeDist &&
+           (ragdoll->simulatedTime()>=Ragdoll::SettleMinTime || dist>2.f*Ragdoll::FreezeDist))
+          ragdoll->freeze();
+        }
+      }
+    if(ragdoll->state()==Ragdoll::S_Fall) {
+      tickRagdollFall();
+      return;
+      }
+    const auto bs = bodyStateMasked();
+    if(!isDown() && bs!=BS_DEAD && bs!=BS_UNCONSCIOUS && bs!=BS_LIE) {
+      // ожил не через AI_StandUp (скрипт, превращение): поза куклы просто переходит в анимацию
+      ragdoll->freeze();
+      ragBlendStart = owner.tickCount();
+      ragPushedVer  = 0;
+      return;
+      }
+    followRagdoll();
+    return;
+    }
+  if(owner.tickCount()>=ragBlendStart+RagdollBlendTime) {
+    ragdoll.reset();
+    ragBlendStart = 0;
+    visual.clearRagdollPose();
+    }
+  }
+
+void Npc::followRagdoll() {
+  if(!ragdoll->isSimulated() && ragdoll->version()==ragFollowVer)
+    return;
+  ragFollowVer = ragdoll->version();
+
+  const Vec3 p = ragdoll->rootPosition();
+  auto       g = owner.physic()->landRay(p+Vec3(0,50,0), 600);
+  const float ny = g.hasCol ? g.v.y : p.y-20.f;
+  if(std::abs(p.x-x)+std::abs(p.z-z)+std::abs(ny-y)>1.f)
+    setPosition(p.x,ny,p.z);
+  }
+
+void Npc::ragdollGetUp() {
+  ragdoll->freeze();
+  ragBlendStart = owner.tickCount();
+  ragPushedVer  = 0;
+
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+
+  // Лежит на спине или на животе - подъём из той же позы. Какая анимация какая, видно по её первому кадру
+  const bool onBack = ragdoll->chestFront().y>0.f;
+  static const char* lie[] = {"S_WOUNDED",         "S_WOUNDEDB"};
+  static const char* up [] = {"T_WOUNDED_2_STAND", "T_WOUNDEDB_2_STAND"};
+  std::vector<Matrix4x4> frame;
+  int chosen = -1;
+  for(int i=0; i<2; ++i) {
+    auto sqUp = visual.findSequence(up[i]);
+    if(sqUp==nullptr || visual.findSequence(lie[i])==nullptr)
+      continue;
+    Pose::sampleObjectPose(*sk,*sqUp,0,frame);
+    if(ragdoll->chestBone()>=frame.size())
+      continue;
+    const bool back = ragdoll->chestFront(frame[ragdoll->chestBone()]).y>0.f;
+    if(back==onBack) {
+      chosen = i;
+      break;
+      }
+    }
+  if(chosen<0)
+    return;
+  visual.replaceLayer(visual.findSequence(lie[chosen]),owner.tickCount());
+
+  // Повернуть и поставить NPC так, чтобы таз и грудь первого кадра подъёма легли на тело
+  auto objToWorld = [this](float ang, Vec3 v) {
+    Matrix4x4 m = Matrix4x4::mkIdentity();
+    m.rotateOY(90-ang);
+    v = Vec3(v.x*sz[0], v.y*sz[1], v.z*sz[2]);
+    return Vec3(m.at(0,0)*v.x + m.at(1,0)*v.y + m.at(2,0)*v.z,
+                m.at(0,1)*v.x + m.at(1,1)*v.y + m.at(2,1)*v.z,
+                m.at(0,2)*v.x + m.at(1,2)*v.y + m.at(2,2)*v.z);
+    };
+  auto heading = [](const Vec3& v) {
+    return std::atan2(v.z,v.x)*180.f/float(M_PI);
+    };
+  const auto& fr     = frame;
+  const Vec3  pelA   = Vec3(fr[ragdoll->rootBone()].at(3,0),  fr[ragdoll->rootBone()].at(3,1),  fr[ragdoll->rootBone()].at(3,2));
+  const Vec3  chestA = Vec3(fr[ragdoll->chestBone()].at(3,0), fr[ragdoll->chestBone()].at(3,1), fr[ragdoll->chestBone()].at(3,2));
+  const Vec3  pelR   = ragdoll->rootPosition();
+  const Vec3  chestR = ragdoll->chestPosition();
+  const Vec3  hA     = Vec3(chestA.x-pelA.x, 0, chestA.z-pelA.z);
+  const Vec3  hR     = Vec3(chestR.x-pelR.x, 0, chestR.z-pelR.z);
+
+  float ang = angle;
+  if(hA.length()>5.f && hR.length()>5.f)
+    ang = heading(hR) - heading(objToWorld(0,hA));
+  const Vec3  off = objToWorld(ang,pelA);
+  const Vec3  at  = Vec3(pelR.x-off.x, pelR.y, pelR.z-off.z);
+  auto        g   = owner.physic()->landRay(at+Vec3(0,50,0), 600);
+  setDirection(ang);
+  setPosition(at.x, g.hasCol ? g.v.y : y, at.z);
+  // мировая поза куклы не меняется - пересчитать её относительно нового места NPC
+  ragdoll->touch();
+  }
+
+void Npc::pushRagdollPose() {
+  if(ragdoll==nullptr)
+    return;
+  const auto& pos   = visual.transform();
+  const bool  fresh = (ragPushedVer!=ragdoll->version());
+  if(fresh) {
+    Matrix4x4 inv = pos;
+    inv.inverse();
+    auto& world = ragdoll->world();
+    ragLocal.resize(world.size());
+    for(size_t i=0; i<world.size(); ++i)
+      ragLocal[i] = inv*world[i];
+    }
+  else if(pos!=ragPushedPos) {
+    // застывшее тело перенесли вместе с NPC (скрипт, распорядок): кости идут за ним
+    ragdoll->rebase(pos,ragLocal);
+    }
+  else if(ragBlendStart==0) {
+    return;
+    }
+  ragPushedVer = ragdoll->version();
+  ragPushedPos = pos;
+
+  float w = 1.f;
+  if(ragBlendStart!=0) {
+    const uint64_t t = owner.tickCount()-ragBlendStart;
+    w = 1.f - std::min(float(t)/float(RagdollBlendTime), 1.f);
+    // плавно: медленнее в начале и в конце
+    w = w*w*(3.f-2.f*w);
+    }
+  visual.setRagdollPose(ragdoll->driven(),ragdoll->bones(),ragLocal,w);
+  }
+
+void Npc::saveRagdoll(Serialize& fout, size_t id, std::string_view directory) const {
+  // живой падающий в сохранение не пишется: после загрузки стоит там, где лежал
+  if(ragdoll==nullptr || ragBlendStart!=0 || ragdoll->state()==Ragdoll::S_Fall)
+    return;
+  // поза тела - относительно NPC; при загрузке тело лежит так же, без физики, пока его не толкнут
+  fout.setEntry("worlds/",fout.worldName(),directory,id,"/ragdoll");
+  Matrix4x4 inv = visual.transform();
+  inv.inverse();
+  const auto& bones = ragdoll->bones();
+  const auto& world = ragdoll->world();
+  fout.write(uint8_t(1),uint8_t(ragdoll->state()),uint16_t(bones.size()));
+  for(size_t i=0; i<bones.size(); ++i)
+    fout.write(bones[i],inv*world[i]);
+  }
+
+void Npc::loadRagdoll(Serialize& fin, size_t id, std::string_view directory) {
+  ragdoll.reset();
+  ragBlendStart = 0;
+  if(!fin.setEntry("worlds/",fin.worldName(),directory,id,"/ragdoll"))
+    return;
+  uint8_t  ver = 0, st = 0;
+  uint16_t cnt = 0;
+  fin.read(ver,st,cnt);
+  if(ver!=1)
+    return;
+  std::vector<uint16_t>  bones(cnt);
+  std::vector<Matrix4x4> world(cnt);
+  const Matrix4x4 pos = mkPositionMatrix();
+  for(size_t i=0; i<cnt; ++i) {
+    Matrix4x4 local;
+    fin.read(bones[i],local);
+    world[i] = pos*local;
+    }
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr || !Gothic::options().ragdoll)
+    return;
+  ragdoll = Ragdoll::createFrozen(*owner.physic(), *sk, bones, world, st==Ragdoll::S_Unconscious ? Ragdoll::S_Unconscious : Ragdoll::S_Dead);
+  ragPushedVer = 0;
+  ragFollowVer = ragdoll!=nullptr ? ragdoll->version() : 0;
+  }
