+GameMenu::Item* GameMenu::visibleList() {
+  for(auto& it:hItems)
+    if(it.handle!=nullptr && it.visible && it.handle->type==zenkit::MenuItemType::LISTBOX)
+      return &it;
+  return nullptr;
+  }
