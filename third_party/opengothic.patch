+  else if(wheel==Wheel::Squad) {
+    auto w = Gothic::inst().world();
+    if(w==nullptr)
+      return;
+    const auto ord = GameScript::SquadOrder(it.action);
+    w->script().squadOrder(ord, ord==GameScript::SquadOrder::Attack ? squadTarget() : nullptr);
+    Gothic::inst().onPrint(toCp1251("Отряд: ") + it.label);
+    }
+  }
