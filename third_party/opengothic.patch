+static const char* const healPotions[] = {"ITPO_HEALTH_01", "ITPO_HEALTH_02", "ITPO_HEALTH_03", "ITPO_HEALTH_ADDON_04"};
+static const char* const manaPotions[] = {"ITPO_MANA_01",   "ITPO_MANA_02",   "ITPO_MANA_03",   "ITPO_MANA_ADDON_04"};
