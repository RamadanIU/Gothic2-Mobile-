+void AiNpc::teachReport() {
+  // Чему герой научился за этот разговор - модели событием (как итог торговли): Геральт помнит, чему учил
+  if(!teachStarted)
+    return;
+  teachStarted = false;
+  auto* w = world();
+  Npc*  pl = w!=nullptr ? w->player() : nullptr;
+  if(pl==nullptr || geralt==nullptr)
+    return;
+  std::string done;
+  auto note = [&](const std::string& s) {
+    done += (done.empty() ? "" : ", ")+s;
+    };
+  for(size_t i=0; i<std::size(Attrs); ++i) {
+    const int32_t now = pl->attribute(Attrs[i].atr);
+    if(now>teachBefore.atr[i])
+      note(std::string(Attrs[i].name)+" "+num(teachBefore.atr[i])+" -> "+num(now));
+    }
+  for(size_t i=0; i<std::size(Weapons); ++i) {
+    const int32_t now = pl->hitChance(Weapons[i].talent);
+    if(now>teachBefore.hit[i])
+      note(std::string(Weapons[i].name)+" "+num(teachBefore.hit[i])+"% -> "+num(now)+"%");
+    }
+  if(pl->talentSkill(TALENT_MAGE)>teachBefore.circle)
+    note("круг магии "+num(teachBefore.circle)+" -> "+num(pl->talentSkill(TALENT_MAGE)));
+  if(hackChance()>teachBefore.hack && teachBefore.hack>=0)
+    note("добыча золота "+num(teachBefore.hack)+"% -> "+num(hackChance())+"%");
+  if(!teachLearned.empty()) {
+    std::string skills;
+    size_t      shown = 0;
+    for(auto& s:teachLearned) {
+      if(skills.size()>300)
+        break;
+      skills += (skills.empty() ? "" : ", ")+s;
+      ++shown;
+      }
+    if(shown<teachLearned.size())
+      skills += " и еще "+num(int32_t(teachLearned.size()-shown));
+    note("умения: "+skills);
+    }
+  teachLearned.clear();
+  if(done.empty())
+    return;
+  Log::i("[g2m] ai: Geralt taught: ",done);
+  sendEvent("teach","Ты обучил героя (даром): "+done+".",nullptr);
+  }
