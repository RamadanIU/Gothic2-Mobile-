+struct InjuryRig::Work final {
+  Matrix4x4*             w = nullptr;
+  std::vector<Matrix4x4> local;
+  float                  scale = 1; // рост в позе к росту в позе привязки
+  };
+
+const InjuryRig* InjuryRig::of(const Skeleton& sk) {
+  static std::mutex                                           sync;
+  static std::map<const Skeleton*,std::unique_ptr<InjuryRig>> cache;
+  static std::map<const Skeleton*,bool>                       known;
+  std::lock_guard<std::mutex> guard(sync);
+  if(known[&sk])
+    return cache[&sk].get();
+  known[&sk] = true;
+
+  const size_t n = std::min(sk.nodes.size(), sk.tr.size());
+  auto r = std::unique_ptr<InjuryRig>(new InjuryRig());
+  r->parent.resize(n);
+  std::vector<size_t> spine;
+  for(size_t i=0; i<n; ++i) {
+    r->parent[i] = sk.nodes[i].parent<n ? sk.nodes[i].parent : size_t(-1);
+    const std::string nm = upperName(sk.nodes[i].name);
+    if(nm.rfind("ZS_",0)==0 || has(nm,"NUB") || has(nm,"FINGER") || has(nm,"TOE"))
+      continue;
+    const int side = has(nm," L ") ? 0 : (has(nm," R ") ? 1 : -1);
+    if(has(nm,"PELVIS"))
+      r->pelvis = i;
+    else if(has(nm,"SPINE"))
+      spine.push_back(i);
+    else if(has(nm,"NECK"))
+      r->neck = i;
+    else if(has(nm,"HEAD"))
+      r->head = i;
+    else if(side>=0 && has(nm,"UPPERARM"))
+      r->upper[side] = i;
+    else if(side>=0 && has(nm,"FOREARM"))
+      r->fore[side] = i;
+    else if(side>=0 && has(nm,"HAND"))
+      r->hand[side] = i;
+    else if(side>=0 && has(nm,"THIGH"))
+      r->thigh[side] = i;
+    else if(side>=0 && has(nm,"CALF"))
+      r->calf[side] = i;
+    else if(side>=0 && has(nm,"FOOT"))
+      r->foot[side] = i;
+    }
+  auto ok = [n](size_t i) { return i<n; };
+  bool human = ok(r->pelvis) && ok(r->head) && !spine.empty();
+  for(int s=0; s<2; ++s)
+    human &= ok(r->upper[s]) && ok(r->fore[s]) && ok(r->hand[s]) && ok(r->thigh[s]) && ok(r->calf[s]) && ok(r->foot[s]);
+  if(human) {
+    // цепочки должны быть цепочками: предплечье - потомок плеча, голень - бедра и т. д.
+    auto isAncestor = [&](size_t a, size_t b) {
+      for(size_t p=r->parent[b]; p<n; p=r->parent[p])
+        if(p==a)
+          return true;
+      return false;
+      };
+    for(int s=0; s<2; ++s)
+      human &= isAncestor(r->upper[s],r->fore[s]) && isAncestor(r->fore[s],r->hand[s]) &&
+               isAncestor(r->thigh[s],r->calf[s]) && isAncestor(r->calf[s],r->foot[s]);
+    const Vec3 up = origin(sk.tr[r->head]) - origin(sk.tr[r->pelvis]);
+    human &= up.y>0.6f*up.length() && up.length()>10.f;
+    }
+  if(!human)
+    return nullptr;
+
+  // позвоночник - от таза вверх (по глубине в иерархии)
+  auto depth = [&](size_t i) { int d = 0; for(size_t p=r->parent[i]; p<n; p=r->parent[p]) ++d; return d; };
+  std::sort(spine.begin(),spine.end(),[&](size_t a, size_t b){ return depth(a)<depth(b); });
+  r->spine = spine;
+  for(auto s:spine) {
+    bool legs = false;
+    for(int k=0; k<2; ++k)
+      for(size_t p=r->parent[r->thigh[k]]; p<n; p=r->parent[p])
+        if(p==s)
+          legs = true;
+    if(!legs)
+      r->bendable.push_back(s);
+    }
+  if(r->bendable.empty())
+    r->bendable.push_back(spine.back());
+
+  // от корней к концам: родитель раньше потомка
+  std::vector<size_t> stk(sk.rootNodes.rbegin(), sk.rootNodes.rend());
+  while(!stk.empty()) {
+    const size_t i = stk.back();
+    stk.pop_back();
+    if(i>=n)
+      continue;
+    r->order.push_back(uint16_t(i));
+    for(size_t c=n; c>0; --c)
+      if(r->parent[c-1]==i)
+        stk.push_back(c-1);
+    }
+  auto ret = r.get();
+  cache[&sk] = std::move(r);
+  return ret;
+  }
