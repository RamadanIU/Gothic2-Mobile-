+Npc* PlayerControl::touchTarget() {
+  if(touchTgt==nullptr)
+    return nullptr;
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  Focus f;
+  f.npc = touchTgt;
+  if(w!=nullptr)
+    f = w->validateFocus(f);
+  // Мёртвый, исчезнувший или далёкий (> 40 м) - выбор снимается
+  if(pl==nullptr || f.npc==nullptr || f.npc->isDead() || pl->qDistTo(*f.npc)>4000.f*4000.f)
+    touchTgt = nullptr;
+  return touchTgt;
+  }
+
+void PlayerControl::applyTouchTarget() {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  auto tg = touchTarget();
+  if(pl==nullptr || tg==nullptr || autoFightOn)
+    return;
+  // Разговор, подбор и обыск - по обычному фокусу; выбранная цель - для боя
+  const auto ws = pl->weaponState();
+  if(ws==WeaponState::NoWeapon)
+    return;
+  const zenkit::IFocus* fc = &w->script().focusMelee();
+  if(ws==WeaponState::Bow || ws==WeaponState::CBow)
+    fc = &w->script().focusRange();
+  else if(ws==WeaponState::Mage)
+    fc = &w->script().focusMage();
+  const float range = std::max(fc->npc_range2, 300.f);
+  if(pl->qDistTo(*tg)<=range*range && !tg->isDown())
+    currentFocus = Focus(*tg);
+  }
