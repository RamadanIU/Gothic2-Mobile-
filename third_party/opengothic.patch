+void TouchInput::joystick(Finger& f, Point pos) {
+  // Вперёд/назад и вбок - отдельные оси с мёртвой зоной, как стрелки клавиатуры в Gothic.
+  // Чуть сдвинут - шаг, дальше - бег (с запасом, чтобы не дёргалось на границе)
+  const float R   = 56*dp();
+  float       dx  = float(pos.x-f.start.x)/R;
+  float       dy  = float(pos.y-f.start.y)/R;
+  const float len = std::sqrt(dx*dx+dy*dy);
+  if(len>1.5f) {
+    // Палец ушёл далеко - центр джойстика едет следом: смена направления без возврата пальца
+    const float k = (len-1.5f)/len;
+    f.start.x += int(float(pos.x-f.start.x)*k);
+    f.start.y += int(float(pos.y-f.start.y)*k);
+    dx = float(pos.x-f.start.x)/R;
+    dy = float(pos.y-f.start.y)/R;
+    }
+  if(joyRun && len<0.5f)
+    joyRun = false;
+  else if(!joyRun && len>0.68f)
+    joyRun = true;
+  const int fw = dy<-0.3f ? 1 : (dy>0.3f ? -1 : 0);
+  const int sd = dx<-0.45f ? -1 : (dx>0.45f ? 1 : 0);
+  ctrl.setTouchMove(fw, sd, joyRun);
+  }
+
+void TouchInput::tapWorld(Point p) {
+  // Касание по NPC - выбрать цель (для боя и приказа отряду), мимо - снять выбор
+  auto world = Gothic::inst().world();
+  auto pl    = world!=nullptr ? world->player() : nullptr;
+  auto cam   = Gothic::inst().camera();
+  if(pl==nullptr || cam==nullptr)
+    return;
+  const auto  vp   = cam->viewProj();
+  const float maxD = 48*dp();
+  const float sw   = float(w()), sh = float(h());
+  Npc*        best = nullptr;
+  float       bD   = maxD*maxD;
+  auto toScreen = [&](Vec3 v, Point& out) {
+    float pw = 1.f;
+    vp.project(v.x,v.y,v.z,pw);
+    if(pw<=0.f)
+      return false;
+    v /= pw;
+    out = Point(int((0.5f*v.x+0.5f)*sw), int((0.5f*v.y+0.5f)*sh));
+    return true;
+    };
+  world->detectNpc(pl->position(), 3000, [&](Npc& n) {
+    if(&n==pl || n.isDead())
+      return;
+    Point a, b;
+    if(!toScreen(n.displayPosition(),a) || !toScreen(n.position(),b))
+      return;
+    // расстояние от пальца до отрезка «голова - ноги» на экране
+    const float ex = float(b.x-a.x), ey = float(b.y-a.y);
+    const float ee = ex*ex+ey*ey;
+    float t = ee>0 ? (float(p.x-a.x)*ex+float(p.y-a.y)*ey)/ee : 0.f;
+    t = std::clamp(t,0.f,1.f);
+    const float qx = float(a.x)+ex*t-float(p.x), qy = float(a.y)+ey*t-float(p.y);
+    const float qd = qx*qx+qy*qy;
+    if(qd<bD) {
+      bD   = qd;
+      best = &n;
+      }
+    });
+  if(best!=nullptr && !pl->canSeeNpc(*best,true))
+    best = nullptr;
+  ctrl.setTouchTarget(best);
+  }
+
+void TouchInput::press(Ctl c, Finger& f) {
+  (void)f;
+  // Игрок сам взялся за героя - путь бегом прерывается
+  if(c==C_Joy || c==C_Main || c==C_Block || c==C_Jump || c==C_Weapon)
+    stopTravelByHand();
+  switch(c) {
+    case C_Main:
+      ctrl.setTouchAttack(true);
+      break;
+    case C_Block:
+      ctrl.setTouchBlock(true);
+      break;
+    case C_Jump:
+      ctrl.onKeyPressed(KeyCodec::Jump, Event::K_NoKey, KeyCodec::Mapping::Primary);
+      break;
+    case C_Auto:
+      ctrl.setAutoFight(!ctrl.isAutoFight());
+      Gothic::inst().onPrint(toCp1251(ctrl.isAutoFight() ? "Автобой включён" : "Автобой выключен"));
+      break;
+    case C_Gather:
+      if(ctrl.isGathering())
+        ctrl.stopGather(false); else
+        ctrl.startGather();
+      break;
+    case C_Sneak:
+      ctrl.toggleSneak();
+      break;
+    case C_Bag:
+      owner.touchMenu(KeyCodec::Inventory);
+      break;
+    case C_Log:
+      owner.touchMenu(KeyCodec::Log);
+      break;
+    case C_Hero:
+      owner.touchMenu(KeyCodec::Status);
+      break;
+    case C_Up:
+    case C_Down:
+    case C_Left:
+    case C_Right:
+      sendNav(c);
+      // Держать стрелку - листать список; в меню влево-вправо - двигать ползунок
+      if(c==C_Up || c==C_Down || currentUi()==Ui::Menu) {
+        repeatCtl  = c;
+        repeatNext = Application::tickCount()+400;
+        }
+      break;
+    case C_Select:
+      if(currentUi()==Ui::Inventory)
+        owner.touchInventoryDo(); else
+        owner.touchKey(Event::K_Return);
+      break;
+    case C_Back:
+      // Взлом: «назад» - отойти от замка; иначе - Esc (в диалоге - пропуск реплики)
+      if(currentUi()==Ui::LockPick)
+        owner.touchKey(Event::K_Down); else
+        owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_Skip:
+      owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_TakeAll:
+      owner.touchTakeAll();
+      break;
+    case C_App:
+    case C_Edit:
+      // по отпусканию: палец не попадёт на экран запуска
+      break;
+    case C_None:
+    case C_Joy:
+    case C_Look:
+    case C_List:
+    case C_Absorb:
+    case C_Weapon:
+    case C_Potion:
+    case C_Squad:
+    case C_Say:
+    case C_Map:
+    case C_Menu:
+    case C_Travel:
+    case C_Save:
+    case C_Camera:
+    case C_Count:
+      break;
+    }
+  }
+
+void TouchInput::release(Ctl c, Finger& f, Point pos) {
+  const uint64_t dt = Application::tickCount()-f.downAt;
+  switch(c) {
+    case C_Joy:
+      ctrl.setTouchMove(0, 0, true);
+      break;
+    case C_Look:
+      if(!f.moved && dt<300 && currentUi()==Ui::World)
+        tapWorld(pos);
+      break;
+    case C_Main:
+      ctrl.setTouchAttack(false);
+      break;
+    case C_Block:
+      ctrl.setTouchBlock(false);
+      break;
+    case C_Jump:
+      ctrl.onKeyReleased(KeyCodec::Jump, KeyCodec::Mapping::Primary);
+      break;
+    case C_Weapon: {
+      const int id = int(&f-fingers.data());
+      if(wheel==Wheel::Weapon && wheelOwner==id) {
+        if(wheelSel>=0) {
+          applyWheel(wheelSel);
+          closeWheel();
+          }
+        else if(!f.moved) {
+          wheelOwner = -1; // открыли удержанием - колесо ждёт касания
+          }
+        else {
+          closeWheel();
+          }
+        }
+      else if(!f.held) {
+        // Коснуться - достать последнее оружие или убрать
+        ctrl.onKeyPressed (KeyCodec::Weapon, Event::K_NoKey, KeyCodec::Mapping::Primary);
+        ctrl.onKeyReleased(KeyCodec::Weapon, KeyCodec::Mapping::Primary);
+        }
+      break;
+      }
+    case C_Camera: {
+      // Коснуться - следующий ракурс; потянуть или подержать - колесо ракурсов
+      const int id = int(&f-fingers.data());
+      if(wheel==Wheel::Camera && wheelOwner==id) {
+        if(wheelSel>=0) {
+          applyWheel(wheelSel);
+          closeWheel();
+          }
+        else if(!f.moved) {
+          wheelOwner = -1;
+          }
+        else {
+          closeWheel();
+          }
+        }
+      else if(!f.held) {
+        auto&      tc   = owner.touchTravelCamera();
+        const auto next = TravelCamera::Mode((tc.mode()+1)%TravelCamera::M_Count);
+        tc.setMode(next);
+        Gothic::inst().onPrint(toCp1251("Камера: ") + toCp1251(TravelCamera::name(next)));
+        }
+      break;
+      }
+    case C_Squad: {
+      const int id = int(&f-fingers.data());
+      if(wheel==Wheel::Squad && wheelOwner==id && wheelSel>=0) {
+        applyWheel(wheelSel);
+        closeWheel();
+        }
+      else if(wheel==Wheel::Squad && wheelOwner==id) {
+        wheelOwner = -1;
+        }
+      else if(wheel==Wheel::None) {
+        openWheel(Wheel::Squad, -1);
+        }
+      break;
+      }
+    case C_Say:
+      // Голосом или текстом - как выбрано в настройках; в панели можно переключиться
+      if(auto w = Gothic::inst().world())
+        if(auto* to = sayTarget())
+          w->script().aiNpc().heroSpeak(*to);
+      break;
+    case C_Potion:
+      if(!f.held)
+        ctrl.touchDrinkPotion(false);
+      break;
+    case C_Map:
+      ctrl.onKeyPressed (KeyCodec::Map, Event::K_NoKey, KeyCodec::Mapping::Primary);
+      ctrl.onKeyReleased(KeyCodec::Map, KeyCodec::Mapping::Primary);
+      break;
+    case C_Menu:
+      owner.touchKey(Event::K_ESCAPE);
+      break;
+    case C_App:
+      // Игра встаёт на паузу (окно уходит), вернуться - кнопкой экрана запуска или «Назад»
+      AppLink::openAppMenu();
+      break;
+    case C_Edit:
+      if(!f.moved)
+        openEditor();
+      break;
+    case C_Travel:
+      // В пути - остановиться; иначе - карта с местами
+      if(ctrl.travelMode()==PlayerControl::TravelMode::Run)
+        ctrl.stopTravel("Путь остановлен"); else
+        openTravelMap();
+      break;
+    case C_Save:
+      // Коснуться - быстрое сохранение; подержать - быстрая загрузка (с подтверждением)
+      if(!f.held) {
+        if(auto why = owner.touchQuickSave())
+          Gothic::inst().onPrint(toCp1251(why));
+        }
+      break;
+    case C_Up:
+    case C_Down:
+    case C_Left:
+    case C_Right:
+      if(repeatCtl==c)
+        repeatCtl = C_None;
+      break;
+    case C_List:
+      if(currentUi()==Ui::Inventory) {
+        if(!f.moved)
+          owner.touchInventoryDown(pos);
+        owner.touchInventoryUp();
+        }
+      else if(currentUi()==Ui::Dialog && !f.moved) {
+        owner.touchDialogTap(pos);
+        }
+      break;
+    default:
+      break;
+    }
+  }
+
+void TouchInput::releaseAll() {
+  for(size_t i=0; i<fingers.size(); ++i) {
+    auto& f = fingers[i];
+    // Кнопки с действием на отпускание при смене экрана не срабатывают
+    switch(f.ctl) {
+      case C_Weapon:
+      case C_Squad:
+      case C_Say:
+      case C_Potion:
+      case C_Map:
+      case C_Menu:
+      case C_Travel:
+      case C_Save:
+      case C_Camera:
+      case C_Look:
+      case C_List:
+      case C_App:
+      case C_Edit:
+        break;
+      default:
+        release(f.ctl, f, f.last);
+        break;
+      }
+    f = Finger();
+    }
+  repeatCtl = C_None;
+  timer.stop();
+  if(wheel!=Wheel::None)
+    closeWheel();
+  }
+
+void TouchInput::onTimer() {
+  const uint64_t now  = Application::tickCount();
+  bool           busy = false;
+  for(size_t i=0; i<fingers.size(); ++i) {
+    auto& f = fingers[i];
+    if(f.ctl==C_None || f.held)
+      continue;
+    // Долгое нажатие: колесо оружия и камеры, зелье маны, быстрая загрузка
+    if(f.ctl==C_Weapon && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=300) {
+        f.held = true;
+        if(wheel==Wheel::None)
+          openWheel(Wheel::Weapon, int(i));
+        }
+      }
+    if(f.ctl==C_Camera && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=300) {
+        f.held = true;
+        if(wheel==Wheel::None)
+          openWheel(Wheel::Camera, int(i));
+        }
+      }
+    if(f.ctl==C_Potion && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=450 && ctrl.potionCount(true)>0) {
+        f.held = true;
+        ctrl.touchDrinkPotion(true);
+        }
+      }
+    if(f.ctl==C_Save && !f.moved) {
+      busy = true;
+      if(now-f.downAt>=700) {
+        f.held = true;
+        openConfirm();
+        }
+      }
+    }
+
+  if(repeatCtl!=C_None) {
+    busy = true;
+    if(now>=repeatNext) {
+      repeatNext = now+120;
+      sendNav(repeatCtl);
+      }
+    }
+  if(!busy)
+    timer.stop();
+  update();
+  }
+
+void TouchInput::sendNav(Ctl c) {
+  switch(c) {
+    case C_Up:    owner.touchKey(Event::K_Up);    break;
+    case C_Down:  owner.touchKey(Event::K_Down);  break;
+    case C_Left:  owner.touchKey(Event::K_Left);  break;
+    case C_Right: owner.touchKey(Event::K_Right); break;
+    default: break;
+    }
+  }
