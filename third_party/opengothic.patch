+bool InventoryMenu::touchIsGrid(Tempest::Point p) const {
+  if(player==nullptr || state==State::Closed || state==State::LockPicking)
+    return false;
+  const int  padd = 43;
+  const int  iy   = 30+34+70;
+  const auto sz   = slotSize();
+  const int  gw   = int(columsCount)*sz.w;
+  const int  gh   = int(rowsCount())*sz.h;
+  if(p.y<iy || p.y>=iy+gh)
+    return false;
+  const bool oth  = (chest!=nullptr || trader!=nullptr) && p.x>=padd && p.x<padd+gw;
+  const bool own  = state!=State::Ransack && p.x>=w()-padd-gw && p.x<w()-padd;
+  return oth || own;
+  }
+
+bool InventoryMenu::touchDown(Tempest::Point p) {
+  // Та же раскладка, что в drawAll
+  if(!touchIsGrid(p))
+    return false;
+  const int  padd = 43;
+  const int  iy   = 30+34+70;
+  const auto sz   = slotSize();
+  const int  gw   = int(columsCount)*sz.w;
+
+  uint8_t pg = 1;
+  int     x0 = w()-padd-gw;
+  if((chest!=nullptr || trader!=nullptr) && p.x>=padd && p.x<padd+gw) {
+    pg = 0;
+    x0 = padd;
+    }
+  if(pg==0 && pageOth==nullptr)
+    return false;
+
+  auto&        loc = (pg==0 ? pageLocal[0] : pageLocal[1]);
+  const size_t col = size_t((p.x-x0)/sz.w);
+  const size_t row = size_t((p.y-iy)/sz.h);
+  const size_t id  = (loc.scroll+row)*columsCount+col;
+  const auto&  pgr = (pg==0 ? *pageOth : *pagePl);
+  if(id>=pgr.size())
+    return true;
+
+  if(page==pg && loc.sel==id) {
+    onItemAction(Item::NSLOT);
+    } else {
+    page    = pg;
+    loc.sel = id;
+    }
+  adjustScroll();
+  update();
+  return true;
+  }
+
+InventoryMenu::TouchAction InventoryMenu::touchActionKind() {
+  if(player==nullptr || state==State::Closed || state==State::LockPicking)
+    return TouchAction::None;
+  auto& pg  = activePage();
+  auto& sel = activePageSel();
+  if(!pg.get(sel.sel).isValid())
+    return TouchAction::None;
+  const bool own = pg.is(&player->inventory());
+  switch(state) {
+    case State::Equip:   return TouchAction::Use;
+    case State::Chest:   return own ? TouchAction::Put  : TouchAction::Take;
+    case State::Ransack: return own ? TouchAction::None : TouchAction::Take;
+    case State::Trade:   return own ? TouchAction::Sell : TouchAction::Buy;
+    case State::Closed:
+    case State::LockPicking:
+      break;
+    }
+  return TouchAction::None;
+  }
+
+void InventoryMenu::touchAction() {
+  const auto act = touchActionKind();
+  if(act==TouchAction::None)
+    return;
+  if(act==TouchAction::Take || act==TouchAction::Put) {
+    lootMode = LootMode::Stack;
+    onTakeStuff();
+    lootMode = LootMode::Normal;
+    } else {
+    onItemAction(Item::NSLOT);
+    takeTimer.stop();
+    takeCount = 0;
+    }
+  adjustScroll();
+  update();
+  }
+
+void InventoryMenu::touchUp() {
+  takeTimer.stop();
+  takeCount = 0;
+  }
+
+void InventoryMenu::touchScroll(int rows) {
+  if(state==State::Closed || state==State::LockPicking)
+    return;
+  for(int i=0; i<rows; ++i)
+    moveDown();
+  for(int i=0; i<-rows; ++i)
+    moveUp();
+  adjustScroll();
+  update();
+  }
