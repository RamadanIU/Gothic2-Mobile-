diff --git a/common/utils/cp1251.h b/common/utils/cp1251.h
new file mode 100644
index 0000000..e0f2d62
--- /dev/null
+++ b/common/utils/cp1251.h
@@ -0,0 +1,98 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+// Gothic II Mobile: строки наших кнопок и реплик. Шрифты и тексты русской Gothic II -
+// в кодировке Windows-1251, а исходники - в UTF-8: кириллица переводится, прочее - '?'.
+// В шрифтах игры нет «ё», длинного тире и кавычек-«ёлочек»: они заменяются на «е», «-» и '"'.
+inline std::string toCp1251(std::string_view utf8) {
+  std::string ret;
+  for(size_t i=0; i<utf8.size(); ++i) {
+    const uint8_t c = uint8_t(utf8[i]);
+    if(c<0x80) {
+      ret.push_back(char(c));
+      continue;
+      }
+    // длина последовательности UTF-8 по первому байту
+    size_t   n  = 0;
+    uint32_t cp = 0;
+    if((c & 0xE0u)==0xC0u) {
+      n  = 1;
+      cp = c & 0x1Fu;
+      }
+    else if((c & 0xF0u)==0xE0u) {
+      n  = 2;
+      cp = c & 0x0Fu;
+      }
+    else if((c & 0xF8u)==0xF0u) {
+      n  = 3;
+      cp = c & 0x07u;
+      }
+    if(n==0 || i+n>=utf8.size()) {
+      ret.push_back('?');
+      continue;
+      }
+    for(size_t k=1; k<=n; ++k)
+      cp = (cp<<6) | (uint8_t(utf8[i+k]) & 0x3Fu);
+    i += n;
+    if(cp>=0x410 && cp<=0x44F)
+      ret.push_back(char(0xC0 + (cp-0x410)));
+    else if(cp==0x401)
+      ret.push_back(char(0xC5)); // Ё -> Е
+    else if(cp==0x451)
+      ret.push_back(char(0xE5)); // ё -> е
+    else if(cp==0x2013 || cp==0x2014)
+      ret.push_back('-');        // тире
+    else if(cp==0xAB || cp==0xBB || cp==0x201C || cp==0x201D || cp==0x201E)
+      ret.push_back('"');        // кавычки
+    else if(cp==0x2026)
+      ret.append("...");
+    else
+      ret.push_back('?');
+    }
+  return ret;
+  }
+
+// Gothic II Mobile: обратно - строки игры (имена, предметы) для приложения и языковой модели (docs/AI_NPC.md)
+inline std::string fromCp1251(std::string_view cp) {
+  std::string ret;
+  ret.reserve(cp.size()*2);
+  auto put = [&ret](uint32_t u) {
+    if(u<0x80) {
+      ret.push_back(char(u));
+      }
+    else if(u<0x800) {
+      ret.push_back(char(0xC0u | (u>>6)));
+      ret.push_back(char(0x80u | (u & 0x3Fu)));
+      }
+    else {
+      ret.push_back(char(0xE0u | (u>>12)));
+      ret.push_back(char(0x80u | ((u>>6) & 0x3Fu)));
+      ret.push_back(char(0x80u | (u & 0x3Fu)));
+      }
+    };
+  for(char ch:cp) {
+    const uint8_t c = uint8_t(ch);
+    if(c<0x80)
+      put(c);
+    else if(c>=0xC0)
+      put(0x410u + uint32_t(c-0xC0));
+    else if(c==0xA8)
+      put(0x401);   // Ё
+    else if(c==0xB8)
+      put(0x451);   // ё
+    else if(c==0x96 || c==0x97)
+      put(0x2014);  // тире
+    else if(c==0x85)
+      put(0x2026);  // многоточие
+    else if(c==0xAB || c==0xBB || c==0x93 || c==0x94)
+      put('"');
+    else if(c==0xA0)
+      put(' ');
+    else
+      put('?');
+    }
+  return ret;
+  }
