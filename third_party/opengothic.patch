+Point TouchInput::wheelCenter() const {
+  // Левее кнопок под правым пальцем: колесо их не закрывает. Колесо камеры - выше, над её кнопкой внизу
+  if(wheel==Wheel::Camera)
+    return Point(w()/2, h()*40/100);
