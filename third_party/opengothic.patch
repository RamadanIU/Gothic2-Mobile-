+Point TouchInput::wheelCenter() const {
+  // Левее кнопок под правым пальцем: колесо их не закрывает
+  return Point(w()*52/100, h()*47/100);
+  }
+
+int TouchInput::wheelRadius() const {
+  return int(std::min(float(h())*0.37f, 150*dp()));
+  }
+
+Point TouchInput::wheelItemPos(size_t i) const {
+  const size_t n = std::max<size_t>(wheelItems.size(),1);
+  // по часовой стрелке от верха
+  const float  a = Pi*0.5f - 2.f*Pi*float(i)/float(n);
+  const float  r = float(wheelRadius())*0.68f;
+  const auto   c = wheelCenter();
+  return Point(c.x+int(r*std::cos(a)), c.y-int(r*std::sin(a)));
+  }
+
+int TouchInput::wheelPickDir(Point dv) const {
+  const float len = std::sqrt(float(dv.x*dv.x+dv.y*dv.y));
+  if(len<28*dp() || wheelItems.empty())
+    return -1;
+  // угол от верха по часовой стрелке
+  float a = std::atan2(float(dv.x), float(-dv.y));
+  if(a<0)
+    a += 2.f*Pi;
+  const float  step = 2.f*Pi/float(wheelItems.size());
+  const size_t id   = size_t(int(std::floor(a/step+0.5f)))%wheelItems.size();
+  return wheelItems[id].enabled ? int(id) : -1;
+  }
+
+int TouchInput::wheelPickAt(Point p) const {
+  const auto  c   = wheelCenter();
+  const auto  dv  = p-c;
+  const float len = std::sqrt(float(dv.x*dv.x+dv.y*dv.y));
+  if(len>float(wheelRadius())*1.15f || len<float(wheelRadius())*0.25f)
+    return -1;
+  return wheelPickDir(dv);
+  }
