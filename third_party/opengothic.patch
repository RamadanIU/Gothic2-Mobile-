+bool GameScript::storyAvailable(Npc& player, Npc& npc, zenkit::IInfo& info) {
+  // Gothic II Mobile: как в dialogChoices - тема этого жителя, не сказана (или постоянная), условие скрипта выполнено.
+  // Житель для условий - в разговоре (ZS_Talk): с ним говорят через модель
+  if(info.npc!=int32_t(npc.handle().symbol_index()))
+    return false;
+  auto* isym = vm.find_symbol_by_instance(info);
+  if(isym==nullptr)
+    return false;
+  if(doesNpcKnowInfo(player.handle(),isym->index()) && !info.permanent)
+    return false;
+  if(!info.condition)
+    return true;
+  auto* cond = vm.find_symbol_by_index(uint32_t(info.condition));
+  if(cond==nullptr)
+    return true;
+  ScopeVar self (*vm.global_self(),  npc.handlePtr());
+  ScopeVar other(*vm.global_other(), player.handlePtr());
+  const Npc* prev = storyTalker;
+  storyTalker = &npc;
+  const bool ok = vm.call_function<int>(cond)!=0;
+  storyTalker = prev;
+  return ok;
+  }
+
+void GameScript::storyExec(Npc& player, Npc& npc, zenkit::IInfo& info, uint32_t fn, StoryCapture& cap) {
+  // Gothic II Mobile: тот же exec, что у выбора реплики в диалоге (знание темы, выбор варианта, скрипт), но реплики
