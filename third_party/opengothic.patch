+bool PlayerControl::touchDrinkPotion(bool mana) {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr || pl->isDown())
+    return false;
+  const char* const* names = mana ? manaPotions : healPotions;
+  size_t cls = size_t(-1);
+  for(size_t i=0; i<std::size(healPotions) && cls==size_t(-1); ++i) {
+    const size_t id = w->script().findSymbolIndex(names[i]);
+    if(id!=size_t(-1) && pl->itemCount(id)>0)
+      cls = id;
+    }
+  if(cls==size_t(-1)) {
+    Gothic::inst().onPrint(toCp1251(mana ? "Нет зелий маны" : "Нет зелий лечения"));
+    return false;
+    }
+  const int cur  = pl->attribute(mana ? ATR_MANA : ATR_HITPOINTS);
+  const int max  = pl->attribute(mana ? ATR_MANAMAX : ATR_HITPOINTSMAX);
+  const int need = max-cur;
+  if(need<=0) {
+    // Полное - никогда: тут и второе касание - случайность
+    Gothic::inst().onPrint(toCp1251(mana ? "Мана полная - зелье не нужно" : "Здоровье полное - лечение не нужно"));
+    return false;
+    }
+  // Больше половины зелья пропадёт зря (лечит 50, а не хватает 20) - сначала предупредить
+  const uint64_t now   = w->tickCount();
+  const int      value = potionValue(*pl,cls,mana);
+  const bool     again = potionConfirmMana==mana && now<potionConfirmUntil;
+  if(value>0 && need*2<value && !again) {
+    potionConfirmUntil = now+3000;
+    potionConfirmMana  = mana;
+    Gothic::inst().onPrint(toCp1251(mana ? "Мана почти полная - зелье пропадёт зря. Ещё раз - выпить всё равно"
+                                         : "Ты сейчас не нуждаешься в лечении. Ещё раз - выпить всё равно"));
+    return false;
+    }
+  potionConfirmUntil = 0;
+  pl->useItem(cls);
+  return true;
+  }
