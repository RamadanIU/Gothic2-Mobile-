+void TouchInput::drawSquad(Painter& p) {
+  if(squad.empty())
+    return;
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return;
+  // Под полосками героя: имя, здоровье, приказ
+  const float d    = dp();
+  const int   x    = 10; // как полоски игры
+  int         y    = owner.touchHudBottom() + int(8*d);
+  const int   rowH = int(22*d);
+  const int   gs   = int(13*d);
+  const int   barW = int(70*d);
+  const int   barH = std::max(2, int(3*d));
+  auto& sc = w->script();
+  for(auto npc:squad) {
+    TouchIcons::Icon ic = sc.squadIsWaiting(*npc) ? TouchIcons::I_Wait : TouchIcons::I_Follow;
+    if(sc.isPassive(*npc) && !sc.squadIsWaiting(*npc))
+      ic = TouchIcons::I_Passive;
+    drawGlyph(p, ic, Point(x+gs/2, y+gs/2), gs, GoldIdle);
+
+    auto&      fnt  = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this)*0.8f);
+    const auto name = fit(std::string(npc->displayName()), barW+int(30*d), 0.8f);
+    const auto ts   = fnt.textSize(name);
+    fnt.drawText(p, x+gs+int(5*d), y+ts.h-int(2*d), name);
+
+    const float hp = float(npc->attribute(ATR_HITPOINTS))/float(std::max(1,npc->attribute(ATR_HITPOINTSMAX)));
+    const int   by = y+ts.h+int(1*d);
+    p.setBrush(Color(0.f,0.f,0.f,0.5f));
+    p.drawRect(x+gs+int(5*d), by, barW, barH);
+    p.setBrush(Color(0.78f,0.16f,0.10f,0.9f));
+    p.drawRect(x+gs+int(5*d), by, int(float(barW)*std::clamp(hp,0.f,1.f)), barH);
+    y += rowH;
+    }
+  }
