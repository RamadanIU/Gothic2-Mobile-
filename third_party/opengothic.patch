+// Gothic II Mobile: лук и арбалет - настоящий прицел вместо броска кубика (docs/CONTROLS.md, «Лук и арбалет»).
+// В игре попадание решал бросок: шанс - умение стрелка на 15 м (ближе - выше, дальше - ниже, до нуля на 45 м), а
+// стрела всё равно летела в цель. Теперь стрела летит туда, куда целятся, и попадает, если задела тело
+// (Ragdoll::rayTest). Умение - круг прицела: стрела уходит в случайную точку внутри него; 100 % - точка, 10 % -
+// радиус SpreadAt10, между ними круг сужается быстрее к мастерству (степень SpreadPow). При 10-60 % это почти тот же
+// шанс, что у броска игры на 15 м (в человека: 10 % - одна стрела из 9, 45 % - одна из 3, 60 % - две из 3), вблизи и у
+// мастера - выше: стрела летит, куда целились. Стрелы быстрые (лук 60 м/с, арбалет 75 м/с) и летят по параболе:
+// выстрел считается по ней же (launch) - прицел попадает в точку и вдали. Урон - по месту попадания (zoneMul).
+namespace RangedAim {
+  constexpr float    SpreadAt10    = 5.5f;   // градусы: радиус круга при умении 10 %
+  constexpr float    SpreadPow     = 1.5f;
+  constexpr float    BowSpeed      = 6.0f;   // см/мс
+  constexpr float    CrossbowSpeed = 7.5f;
+  constexpr float    BowImpact     = 4.2f;   // сила толчка тела (Ragdoll::Hit::power): у прежних медленных стрел - 3
+  constexpr float    CrossbowImpact= 4.8f;
+  constexpr float    MaxAimDist    = 8000;   // см: дальше прицел точку не ищет
+  constexpr uint64_t StuckTime     = 5000;   // мс: стрела торчит в теле, потом исчезает
+  constexpr size_t   MaxStuck      = 8;      // стрел в одном теле, лишние - старые исчезают
+  // Плавная смена цели (настройка aimSmooth, PlayerControl::tickRangedAim): цель упала - прицел ещё держится на ней
+  // (видно попадание и падение), потом за GlideMs переходит к новой цели; герой поворачивается вслед за прицелом
+  constexpr uint64_t LingerMs      = 900;    // мс времени мира
+  constexpr uint64_t LingerFireMs  = 350;    // «Выстрел» держат - короче: следующая цель ждёт
+  constexpr float    GlideMs       = 380;    // переход к новой цели, мс времени мира
+
+  // Радиус круга прицела, градусы: умение 100 % - 0 (точка), 10 % - SpreadAt10; меньше 10 % - шире
+  inline float spreadDeg(int skill) {
+    const float s = float(std::clamp(skill,0,100));
+    return SpreadAt10*std::pow((100.f-s)/90.f, SpreadPow);
+    }
+
+  // Плавный ход 0..1: без рывка в начале и в конце (скорость и ускорение - ноль)
+  inline float glide(float t) {
+    t = std::clamp(t,0.f,1.f);
+    return t*t*t*(t*(t*6.f-15.f)+10.f);
+    }
+
+  // Направление между единичными a и b по дуге: t=0 - a, t=1 - b
+  inline Tempest::Vec3 slerpDir(const Tempest::Vec3& a, const Tempest::Vec3& b, float t) {
+    const float c = std::clamp(Tempest::Vec3::dotProduct(a,b), -1.f, 1.f);
+    const float w = std::acos(c);
+    const float s = std::sin(w);
+    if(s<1e-3f) {
+      const Tempest::Vec3 v = a+(b-a)*t;
+      return v.length()>1e-4f ? Tempest::Vec3::normalize(v) : b;
+      }
+    return a*(std::sin((1.f-t)*w)/s) + b*(std::sin(t*w)/s);
+    }
+
+  // Множитель урона по месту попадания (Ragdoll::Zone): тело - 1, голова - 2, ноги - 0,5
+  inline float zoneMul(uint8_t zone) {
+    switch(zone) {
+      case 1:  return 2.f;
+      case 2:  return 0.5f;
+      default: return 1.f;
+      }
+    }
+
+  // Куда уйдёт стрела: случайная точка круга углового радиуса spread (градусы) вокруг at, как видно из from;
+  // u1, u2 - случайные 0..1 (равномерно по площади круга)
+  inline Tempest::Vec3 scatter(const Tempest::Vec3& from, const Tempest::Vec3& at, float spread, float u1, float u2) {
+    const Tempest::Vec3 d = at-from;
+    const float         l = d.length();
+    if(spread<=0.f || l<1.f)
+      return at;
+    const Tempest::Vec3 f    = d/l;
+    Tempest::Vec3       side = Tempest::Vec3::crossProduct(f, Tempest::Vec3(0,1,0));
+    if(side.length()<1e-3f)
+      side = Tempest::Vec3(1,0,0);
+    side = Tempest::Vec3::normalize(side);
+    const Tempest::Vec3 up  = Tempest::Vec3::crossProduct(side, f);
+    const float         rad = spread*float(M_PI)/180.f*std::sqrt(std::clamp(u1,0.f,1.f));
+    const float         ph  = 2.f*float(M_PI)*u2;
+    const float         r   = l*std::tan(rad);
+    return at + side*(r*std::cos(ph)) + up*(r*std::sin(ph));
+    }
+
+  // Скорость вылета (см/мс), чтобы стрела со скоростью speed (см/мс) по параболе с ускорением g (см/мс2, вниз) пришла
+  // в to: из двух решений - пологое. Не долетит при любом угле - под 45 градусов
+  inline Tempest::Vec3 launch(const Tempest::Vec3& from, const Tempest::Vec3& to, float speed, float g) {
+    const Tempest::Vec3 d  = to-from;
+    const float         dx = std::sqrt(d.x*d.x + d.z*d.z);
+    if(dx<1.f) {
+      const float s = d.y>=0.f ? 1.f : -1.f;
+      return Tempest::Vec3(0,speed*s,0);
+      }
+    const float v2   = speed*speed;
+    const float disc = v2*v2 - g*(g*dx*dx + 2.f*d.y*v2);
+    const float ang  = disc>=0.f ? std::atan2(v2 - std::sqrt(disc), g*dx) : float(M_PI)*0.25f;
+    const float c    = std::cos(ang), s = std::sin(ang);
+    return Tempest::Vec3(d.x/dx*c*speed, s*speed, d.z/dx*c*speed);
+    }
+  }
diff --git a/common/game/travelcamera.cpp b/common/game/travelcamera.cpp
new file mode 100644
index 0000000..5c9686f
--- /dev/null
+++ b/common/game/travelcamera.cpp
@@ -0,0 +1,271 @@
+#include "travelcamera.h"
+
+#include <Tempest/Application>
+
+#include <algorithm>
+#include <cmath>
+#include <iterator>
+
+#include "physics/dynamicworld.h"
+#include "world/objects/npc.h"
+#include "world/waypoint.h"
+#include "world/world.h"
+#include "camera.h"
+#include "gothic.h"
+
+using namespace Tempest;
+
+static const float Pi = 3.14159265f;
+
+static float angleMod(float a) {
+  a = std::fmod(a,360.f);
+  if(a<-180.f)
+    a += 360.f;
+  if(a>180.f)
+    a -= 360.f;
+  return a;
+  }
+
+// Направление взгляда по курсу (градусы, как Npc::rotation)
+static Vec3 dirOf(float yaw) {
+  const float a = yaw*Pi/180.f;
+  return Vec3(std::cos(a),0.f,std::sin(a));
+  }
+
+// Высокая камера не цепляется за кроны у героя, но и не уходит в гору: над землёй (крышей, кроной) в своей
+// точке - не ниже clearance
+static Vec3 aboveGround(Vec3 p, float clearance) {
+  auto w = Gothic::inst().world();
+  if(w==nullptr)
+    return p;
+  const auto top = w->physic()->landRay(Vec3(p.x, p.y+5000.f, p.z), 10000.f);
+  if(top.hasCol && top.v.y+clearance>p.y)
+    p.y = top.v.y+clearance;
+  return p;
+  }
+
+static float distXZ(const Vec3& a, const Vec3& b) {
+  const float dx = a.x-b.x, dz = a.z-b.z;
+  return std::sqrt(dx*dx+dz*dz);
+  }
+
+const char* TravelCamera::name(Mode m) {
+  switch(m) {
+    case M_Free:        return "Свободная";
+    case M_Far:         return "Издалека";
+    case M_Bird:        return "С высоты";
+    case M_Side:        return "Сбоку";
+    case M_FirstPerson: return "От первого лица";
+    case M_Cinema:      return "Кино";
+    case M_Count:       break;
+    }
+  return "";
+  }
+
+void TravelCamera::setMode(Mode m) {
+  cur      = (m<M_Count) ? m : M_Free;
+  yawOff   = 0;
+  pitchOff = 0;
+  shotLen  = 0; // «кино» - с нового плана
+  cut      = true;
+  }
+
+void TravelCamera::start(const Npc& pl) {
+  heading  = pl.rotation();
+  yawOff   = 0;
+  pitchOff = 0;
+  hasLast  = false;
+  shotLen  = 0;
+  cut      = true;
+  rng.seed(uint32_t(Application::tickCount()));
+  }
+
+void TravelCamera::resume() {
+  hasLast = false;
+  cut     = true;
+  }
+
+void TravelCamera::look(float dx, float dy) {
+  // Как обычная камера: палец вбок - поворот, вниз - выше и взгляд вниз
+  yawOff   = angleMod(yawOff-dx);
+  pitchOff = std::clamp(pitchOff+dy, -60.f, 75.f);
+  }
+
+Vec3 TravelCamera::orbit(const Vec3& at, float yaw, float pitch, float dist) const {
+  // Камера смотрит на at по курсу yaw, сверху вниз под углом pitch (меньше нуля - снизу вверх)
+  const float p = pitch*Pi/180.f;
+  return at - dirOf(yaw)*(dist*std::cos(p)) + Vec3(0.f, dist*std::sin(p), 0.f);
+  }
+
+void TravelCamera::tick(Camera& cam, const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, uint64_t dt) {
+  const float dtF = float(dt)/1000.f;
+  const Vec3  pos = pl.position();
+  // Курс - по движению героя и плавно: на поворотах дороги камера не дёргается, в бою (на месте) - как был
+  if(hasLast && dtF>0.f) {
+    Vec3 dv = pos-lastPos;
+    dv.y = 0;
+    if(dv.length()>60.f*dtF) {
+      const float a = std::atan2(dv.z,dv.x)*180.f/Pi;
+      heading = angleMod(heading + angleMod(a-heading)*std::min(1.f, 2.5f*dtF));
+      }
+    }
+  lastPos = pos;
+  hasLast = true;
+
+  const Vec3 chest   = pos+Vec3(0.f,130.f,0.f);
+  Vec3       from    = chest;
+  Vec3       at      = chest;
+  bool       collide = true;
+  bool       rigid   = false;
+  auto       pitch   = [this](float base, float lo, float hi) {
+    return std::clamp(base+pitchOff, lo, hi);
+    };
+
+  switch(cur) {
+    case M_Free:
+      from = orbit(chest, heading+yawOff, pitch(14.f,-20.f,85.f), 380.f);
+      break;
+    case M_Far:
+      from = orbit(chest, heading+yawOff, pitch(26.f,-10.f,85.f), 1100.f);
+      break;
+    case M_Bird:
+      // Над кронами: столкновения с деревьями опустили бы камеру в листву
+      at      = pos+Vec3(0.f,60.f,0.f);
+      from    = aboveGround(orbit(at, heading+yawOff, pitch(68.f,35.f,89.f), 2400.f), 400.f);
+      collide = false;
+      break;
+    case M_Side:
+      from = orbit(chest, heading+90.f+yawOff, pitch(6.f,-20.f,85.f), 560.f);
+      break;
+    case M_FirstPerson: {
+      // Глаза героя: чуть впереди головы, как первое лицо движка; смотреть по сторонам - пальцем
+      const float yaw = heading+yawOff;
+      const float p   = std::clamp(pitchOff,-60.f,60.f)*Pi/180.f;
+      const Vec3  dir = dirOf(yaw)*std::cos(p) - Vec3(0.f,std::sin(p),0.f);
+      from    = pl.cameraBone(true) + Vec3(0.f,8.f,0.f) + dirOf(yaw)*22.f;
+      at      = from+dir*1000.f;
+      collide = false;
+      rigid   = true;
+      break;
+      }
+    case M_Cinema: {
+      shotT += dtF;
+      bool next = (shotT>=shotLen);
+      if(shot==S_Track) {
+        // Камера у дороги: держится, пока герой не пробежит мимо и не удалится
+        const float d = distXZ(pos,trackPos);
+        shotNear = std::min(shotNear,d);
+        next = next || (shotNear<1500.f && d>shotNear+700.f) || d>5000.f;
+        }
+      if(next)
+        nextShot(pl,path,idx);
+      const float t = shotT;
+      switch(shot) {
+        case S_Chase: from = orbit(chest, heading+yawOff,                            8.f,  330.f); break;
+        case S_Front: from = orbit(chest, heading+180.f+25.f*std::sin(t*0.35f)+yawOff, 10.f, 470.f); break;
+        case S_SideL: from = orbit(chest, heading+90.f+yawOff,                       5.f,  540.f); break;
+        case S_SideR: from = orbit(chest, heading-90.f+yawOff,                       5.f,  540.f); break;
+        case S_Crane: from = orbit(chest, heading+30.f+t*7.f+yawOff,                 34.f, 950.f); break;
+        case S_Low:   from = orbit(chest, heading+150.f+yawOff,                      -10.f, 270.f); break;
+        case S_Bird:
+          at      = pos+Vec3(0.f,60.f,0.f);
+          from    = aboveGround(orbit(at, heading+t*6.f+yawOff, 66.f, 2100.f), 400.f);
+          collide = false;
+          break;
+        case S_Track:
+          from    = trackPos;
+          collide = false;
+          break;
+        case S_Count:
+          break;
+        }
+      break;
+      }
+    case M_Count:
+      break;
+    }
+
+  cam.setDirector(from, at, cut || rigid, collide);
+  cut = false;
+  }
+
+void TravelCamera::nextShot(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx) {
+  // Следующий план - по долям, не тот же, что сейчас; камера у дороги - если нашлось место, откуда видно путь
+  static const uint8_t weight[S_Count] = {2, 2, 1, 1, 2, 1, 1, 3};
+  uint32_t total = 0;
+  for(auto w:weight)
+    total += w;
+  Shot s  = S_Chase;
+  bool ok = false;
+  for(int attempt=0; attempt<8 && !ok; ++attempt) {
+    uint32_t r = uint32_t(rng()%total);
+    for(uint8_t i=0; i<S_Count; ++i) {
+      if(r<weight[i]) {
+        s = Shot(i);
+        break;
+        }
+      r -= weight[i];
+      }
+    if(s==shot && shotLen>0)
+      continue;
+    if(s==S_Track && !findTrackside(pl,path,idx,trackPos))
+      continue;
+    ok = true;
+    }
+  if(!ok)
+    s = (shot==S_Chase) ? S_Crane : S_Chase;
+  shot     = s;
+  shotT    = 0;
+  shotNear = 1e9f;
+  shotLen  = (s==S_Track) ? 14.f : 6.f+float(rng()%40)/10.f;
+  yawOff   = 0;
+  pitchOff = 0;
+  cut      = true;
+  }
+
+bool TravelCamera::findTrackside(const Npc& pl, const std::vector<const WayPoint*>& path, size_t idx, Vec3& out) {
+  auto w = Gothic::inst().world();
+  if(w==nullptr || idx>=path.size())
+    return false;
+  // Точка пути в 20 м впереди по дороге и направление дороги там
+  Vec3            prev = pl.position();
+  float           acc  = 0;
+  const WayPoint* wp   = nullptr;
+  Vec3            dir;
+  for(size_t i=idx; i<path.size(); ++i) {
+    const Vec3 p = path[i]->position();
+    Vec3       d = p-prev;
+    d.y = 0;
+    const float l = d.length();
+    acc += l;
+    if(acc>=2000.f && l>1.f) {
+      wp  = path[i];
+      dir = d/l;
+      break;
+      }
+    prev = p;
+    }
+  if(wp==nullptr)
+    return false;
+
+  // Сбоку от дороги на 5 м, на высоте глаз над землёй; дорогу оттуда должно быть видно
+  const Vec3  p     = wp->position();
+  const Vec3  side  = Vec3(-dir.z,0.f,dir.x);
+  const bool  first = (rng()&1u)!=0;
+  auto&       phys  = *w->physic();
+  for(int k=0; k<2; ++k) {
+    const float s = ((k==0)==first) ? 1.f : -1.f;
+    Vec3 c = p + side*(s*500.f) + dir*150.f;
+    const auto land = phys.landRay(c+Vec3(0.f,400.f,0.f), 1500.f);
+    if(!land.hasCol)
+      continue;
+    c.y = land.v.y+160.f;
+    if(std::abs(c.y-p.y)>500.f)
+      continue; // обрыв или скала
+    if(phys.ray(c, p+Vec3(0.f,120.f,0.f)).hasCol)
+      continue;
+    out = c;
+    return true;
+    }
+  return false;
+  }
diff --git a/common/game/travelcamera.h b/common/game/travelcamera.h
new file mode 100644
