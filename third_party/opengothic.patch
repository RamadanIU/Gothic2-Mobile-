+bool AiNpc::dialogChoices(Npc& player, Npc& npc, std::vector<GameScript::DlgChoice>& out) {
+  if(!isAiNpc(npc) || !AiLink::enabled())
+    return false;
+  out.clear();
+  auto add = [&out](uint32_t id, const char* title, int32_t sort, bool trade, bool free) {
+    GameScript::DlgChoice ch;
+    ch.title     = toCp1251(title);
+    ch.scriptFn  = id;
+    ch.sort      = sort;
+    ch.isTrade   = trade;
+    ch.freeTrade = free;
+    out.push_back(std::move(ch));
+    };
+  // Уроки (aiteach.cpp): страница меню обучения вместо реплик, пока герой не вернётся «Назад»
+  if(teachPage!=TeachPage::None) {
+    teachChoices(player,out);
+    if(!out.empty())
+      return true;
+    teachPage = TeachPage::None;
+    }
+  add(ChoiceVoice,"Сказать (голосом)",1,false,false);
+  add(ChoiceType, "Написать",2,false,false);
+  add(ChoiceTeach,"Научи меня.",3,false,false);
+  // Обмен даром, а у Геральта на время окна - запасы всех вещей мира (aiteach.cpp): бери что хочешь
+  add(ChoiceTrade,"Покажи свои товары.",4,true,true);
+  // Идёт с героем - вещами меняются даром, как с напарниками: отдать ему доспехи, меч, зелья (без запасов)
+  if(owner.isPartyMember(npc))
+    add(ChoiceSwap,"Давай обменяемся вещами.",5,true,true);
+  add(ChoiceBye,  "Пока.",999,false,false);
+  return true;
+  }
+
+bool AiNpc::exec(const GameScript::DlgChoice& dlg, Npc& player, Npc& npc) {
+  if(!isAiNpc(npc))
+    return false;
+  if((dlg.scriptFn & 0xFFFF0000u)==TeachChoice) {
+    // «Все сразу» - десятки уроков за одно касание: каждый их звук - один раз (GameScript::snd_play)
+    std::vector<std::string> once;
+    owner.soundOnce = &once;
+    const bool ret = execTeach(dlg.scriptFn & 0xFFFFu,player);
+    owner.soundOnce = nullptr;
+    return ret;
+    }
+  switch(dlg.scriptFn) {
+    case ChoiceVoice:
+      busy      = true;
+      busyUntil = owner.tickCount()+BusyMax;
+      AiLink::send("{\"ev\":\"listen\"}");
+      return true;
+    case ChoiceType:
+      busy      = true;
+      busyUntil = owner.tickCount()+BusyMax;
+      AiLink::send("{\"ev\":\"type\"}");
+      return true;
+    case ChoiceTeach:
+      teachBegin(player);
+      return true;
+    case ChoiceTrade:
+    case ChoiceSwap:
+      // Торговлю открывает DialogMenu (isTrade); итог - событием в конце разговора (reportTrade). «Покажи свои товары.» -
+      // с запасами (onTradeOpen)
+      tradeOpened  = true;
+      stockPending = (dlg.scriptFn==ChoiceTrade);
+      return true;
+    case ChoiceBye:
+      AiLink::send("{\"ev\":\"bye\"}");
+      endDialog();
+      return true;
+    default:
+      return false;
+    }
+  }
+
+void AiNpc::beforeSave() {
+  // Запасы окна торговли - не его вещи: в сохранение не идут
+  stockRemove();
+  if(geralt==nullptr || !AiLink::enabled())
+    return;
+  auto& h = geralt->handle();
+  std::random_device rd;
+  h.aivar[AivToken] = std::max(int32_t(rd() & 0x3FFFFFFFu),1);
+  // Приложение пишет память под этой меткой сразу, в этом же вызове: сохранение и память совпадают
+  AiLink::send(std::string("{\"ev\":\"saving\",\"story\":")+std::to_string(h.aivar[AivStory])+
+               ",\"token\":"+std::to_string(h.aivar[AivToken])+"}");
+  }
