+        case K_Thigh: {
+          if(p.parent!=0)
+            break;
+          // бедро: вперёд 115°, назад 15°; наружу 40°, внутрь 20°; кручение внутрь 30°, наружу 40°
+          J = mkFrame(at,dir,F,L);
+          const bool left = Vec3::dotProduct(L,outward(at,pelvis))>0.f; // +Y уводит бедро к L
+          if(left)
+            lim(-40,30, -20,40, -15,115); else
+            lim(-30,40, -40,20, -15,115);
+          break;
+          }
+        case K_Calf:
+          if(pp.kind!=K_Thigh)
+            break;
+          // колено - шарнир: сгиб назад до 145°, чуть-чуть кручения и ни в сторону
+          J = mkFrame(at,dir,F*-1.f,L);
+          lim(-4,4, -2,2, -3,145);
+          break;
+        case K_ForeArm:
+          if(pp.kind!=K_UpperArm)
+            break;
+          // локоть - шарнир: сгиб вперёд до 150° (в T-позе Biped ладони вниз - локтевой сгиб смотрит вперёд)
+          J = mkFrame(at,dir,F,U);
+          lim(-10,10, -3,3, -5,150);
+          break;
+        case K_Hand: {
+          if(pp.kind!=K_ForeArm)
+            break;
+          // кисть: к ладони 70°, к тыльной стороне 60°, вбок 25°; кручение предплечья (у Biped оно в кисти) - 80°.
+          // Ладонь - вниз (T-поза Biped); большой палец вверх или вниз - ладонь вперёд или назад
+          Vec3 palm = U*-1.f;
+          for(auto c:child[p.bone]) {
+            std::string nm(sk.nodes[c].name);
+            for(auto& ch:nm)
+              ch = char(std::toupper(static_cast<unsigned char>(ch)));
+            if(!has(nm,"FINGER0"))
+              continue;
+            Vec3 th = pos[c]-at;
+            th = th - dir*Vec3::dotProduct(th,dir);
+            if(th.length()>0.005f*S && std::abs(Vec3::dotProduct(Vec3::normalize(th),U))>0.7f)
+              palm = F*(Vec3::dotProduct(th,U)>0.f ? 1.f : -1.f);
+            }
+          J = mkFrame(at,dir,palm,F);
+          lim(-80,80, -25,25, -60,70);
+          break;
+          }
+        case K_UpperArm: {
+          // плечо (с лопаткой и ключицей): эллиптический конус вокруг середины размаха - рука вперёд, наружу и
+          // чуть вниз; вверх и вниз 100° от середины (почти над головой и чуть за спину), по горизонтали 80° (40°
+          // за спину и 30° через грудь), кручение 60°
+          const Vec3 o = outward(at,chest);
+          const Vec3 c = Vec3::normalize(o*0.55f + F*0.45f - U*0.25f);
+          J = mkFrame(at,c,U,F);
+          Matrix4x4 Jb = J;
+          LimbIk::rotateBasis(Jb,c,dir);
+          p.joint = J_Swing;
+          p.hi[0] = deg(60);
+          p.hi[1] = deg(80);
+          p.hi[2] = deg(100);
+          p.jointInParent = inverseOf(pp.bodyBind)*J;
+          p.jointInChild  = inverseOf(p.bodyBind)*Jb;
+          continue;
+          }
+        default:
+          break;
+        }
+      if(p.joint!=J_Euler)
+        continue;
+      p.jointInParent = inverseOf(pp.bodyBind)*J;
+      p.jointInChild  = inverseOf(p.bodyBind)*J;
+      }
+    }
+
+  std::unique_ptr<Ragdoll::Layout> build() {
+    if(n==0 || S<10.f)
+      return nullptr;
+
+    size_t rootBone = findKind(K_Pelvis);
+    if(rootBone==size_t(-1))
+      rootBone = findKind(K_Root);
+    if(rootBone==size_t(-1) && sk.rootNodes.size()>0)
+      rootBone = sk.rootNodes[0];
+    if(rootBone>=n)
+      return nullptr;
+
+    const size_t headBone = findKind(K_Head);
+    bool humanoid = false;
+    if(headBone!=size_t(-1) && findKind(K_Thigh)!=size_t(-1) && findKind(K_UpperArm)!=size_t(-1)) {
+      const Vec3 up = pos[headBone]-pos[rootBone];
+      humanoid = up.length()>0.1f*S && up.y>0.6f*up.length();
+      }
+
+    // кандидаты: кости, у которых будет своё тело
+    struct Cand { size_t bone; Vec3 end; float len; };
+    std::vector<Cand> cand;
+    for(size_t i=0; i<n; ++i) {
+      if(i==rootBone)
+        continue;
+      const Vec3  e   = endOf(i);
+      const float len = (e-pos[i]).length();
+      if(wantBody(i,len))
+        cand.push_back({i,e,len});
+      }
+    // не больше 20 тел: лишние - самые короткие хвосты, крылья и кисти
+    while(cand.size()+1>20) {
+      size_t worst = size_t(-1);
+      for(size_t i=0; i<cand.size(); ++i) {
+        const Kind k = kind[cand[i].bone];
+        if(k!=K_Other && k!=K_Tail && k!=K_Hand && k!=K_Foot)
+          continue;
+        if(worst==size_t(-1) || cand[i].len<cand[worst].len)
+          worst = i;
+        }
+      if(worst==size_t(-1))
+        worst = cand.size()-1;
+      cand.erase(cand.begin()+ptrdiff_t(worst));
+      }
+    if(cand.size()<2)
+      return nullptr;
+
+    auto lay = std::make_unique<Ragdoll::Layout>();
+    lay->size     = S;
+    lay->humanoid = humanoid;
+    lay->driven.assign(n,0);
+
+    std::vector<size_t> partOf(n,size_t(-1));
+    std::vector<Vec3>   partEnd;
+    // часть 0 - таз
+    {
+    Part p;
+    p.bone = rootBone;
+    p.kind = K_Pelvis;
+    lay->parts.push_back(p);
+    partEnd.push_back(pos[rootBone]);
+    partOf[rootBone] = 0;
+    }
+    // остальные - в порядке обхода от корня, чтобы родитель шёл раньше
+    std::vector<size_t> order;
+    {
+    std::vector<size_t> stk(sk.rootNodes.rbegin(), sk.rootNodes.rend());
+    while(!stk.empty()) {
+      const size_t i = stk.back();
+      stk.pop_back();
+      if(i>=n)
+        continue;
+      order.push_back(i);
+      for(auto c=child[i].rbegin(); c!=child[i].rend(); ++c)
+        stk.push_back(*c);
+      }
+    }
+    for(auto i:order) {
+      auto c = std::find_if(cand.begin(),cand.end(),[i](const Cand& x){ return x.bone==i; });
+      if(c==cand.end())
+        continue;
+      // бедро - всегда к тазу, даже если в скелете Biped оно растёт из позвоночника;
+      // плечо - к груди, а не к шее (у Biped ключицы растут из шеи)
+      size_t parent = 0;
+      for(size_t p=sk.nodes[i].parent; p<n && kind[i]!=K_Thigh; p=sk.nodes[p].parent) {
+        if(partOf[p]==size_t(-1))
+          continue;
+        if(kind[i]==K_UpperArm && (kind[p]==K_Neck || kind[p]==K_Head))
+          continue;
+        parent = partOf[p];
+        break;
+        }
+      Part pt;
+      pt.bone   = i;
+      pt.kind   = kind[i];
+      pt.parent = parent;
+      partOf[i] = lay->parts.size();
+      lay->parts.push_back(pt);
+      partEnd.push_back(c->end);
+      }
+
+    // формы тел в позе привязки
+    std::vector<size_t> hips, arms;
+    for(size_t i=1; i<lay->parts.size(); ++i) {
+      if(lay->parts[i].kind==K_Thigh && lay->parts[i].parent==0)
+        hips.push_back(i);
+      if(lay->parts[i].kind==K_UpperArm)
+        arms.push_back(i);
+      }
+    // анатомические оси (поза привязки): вверх, вперёд - по носкам стоп, влево
+    const Vec3 fwd   = forward();
+    const Vec3 lft   = Vec3::crossProduct(Vec3(0,1,0),fwd);
+    // корпус человека плоский: позвонки - капсулы поперёк тела (от плеча к плечу у груди, от бедра к бедру внизу),
+    // а не круглые вдоль позвоночника - иначе лежащее тело перекатывается бревном и ложится на бок
+    const bool  flat     = humanoid && hips.size()>=2 && arms.size()>=2;
+    const float shoulder = flat ? 0.85f*(pos[lay->parts[arms[0]].bone]-pos[lay->parts[arms[1]].bone]).length() : 0.f;
+    const float shoulderY= flat ? 0.5f*(pos[lay->parts[arms[0]].bone].y+pos[lay->parts[arms[1]].bone].y) : 0.f;
+    float       hipW     = 0;
+
+    for(size_t i=0; i<lay->parts.size(); ++i) {
+      auto&      p = lay->parts[i];
+      const Vec3 a = pos[p.bone];
+      if(i==0) {
+        if(hips.size()>=2) {
+          const Vec3  l = pos[lay->parts[hips[0]].bone], r = pos[lay->parts[hips[1]].bone];
+          const float w = (l-r).length();
+          const Vec3  c = (l+r)*0.25f + a*0.5f;
+          p.radius  = std::clamp(0.5f*w, 0.05f*S, 0.09f*S);
+          p.halfLen = 0.25f*w;
+          p.bodyBind = mkFrame(c, l-r, axisOf(sk.tr[p.bone],1), axisOf(sk.tr[p.bone],2));
+          hipW       = 2.f*(p.halfLen+p.radius);
+          } else {
+          // без ног (змеи, мухи): капсула к первой части-потомку
+          Vec3 b = a + Vec3(0,0.1f*S,0);
+          for(size_t r=1; r<lay->parts.size(); ++r)
+            if(lay->parts[r].parent==0) {
+              b = pos[lay->parts[r].bone];
+              break;
+              }
+          if((b-a).length()<0.02f*S)
+            b = a + Vec3(0,0,0.1f*S);
+          const float len = (b-a).length();
+          p.radius   = radiusOf(K_Spine,len);
+          p.halfLen  = std::max(0.5f*len-0.8f*p.radius, 0.15f*len);
+          p.bodyBind = bodyFrame(p.bone,a,b);
+          }
+        }
+      else if(flat && p.kind==K_Spine) {
+        const Vec3  b   = partEnd[i];
+        const Vec3  c   = (a+b)*0.5f;
+        const float t   = std::clamp((c.y-pos[rootBone].y)/std::max(shoulderY-pos[rootBone].y,1.f), 0.f, 1.f);
+        const float w   = hipW + (shoulder-hipW)*t;
+        p.radius   = 0.06f*S;
+        p.halfLen  = std::max(0.5f*w-p.radius, 0.2f*p.radius);
+        p.segHalf  = 0.5f*(b-a).length();
+        p.bodyBind = mkFrame(c, lft, Vec3(0,1,0), fwd);
+        }
+      else {
+        const Vec3  b   = partEnd[i];
+        const float len = (b-a).length();
+        p.radius   = radiusOf(Kind(p.kind),len);
+        p.halfLen  = std::max(0.5f*len-0.8f*p.radius, 0.15f*len);
+        p.segHalf  = 0.5f*len;
+        p.bodyBind = bodyFrame(p.bone,a,b);
+        }
+      // Gothic II Mobile: тело на экране - с одеждой и доспехами, капсула по кости тоньше его: руки проходили
+      // сквозь тела, тело ложилось «в землю». У людей капсулы - по видимому телу (одежда, доспехи, мышцы);
+      // плоский корпус шире не становится (ширина - от плеч и бёдер), только толще
+      p.bare = p.radius;
+      if(flat) {
+        float cloth = 0;
+        switch(Kind(p.kind)) {
+          case K_Pelvis:    cloth = 0.009f; break;
+          case K_Spine:     cloth = 0.009f; break;
+          case K_Neck:      cloth = 0.004f; break;
+          case K_Head:      cloth = 0.005f; break;
+          case K_UpperArm:  cloth = 0.009f; break;
+          case K_ForeArm:   cloth = 0.008f; break;
+          case K_Hand:      cloth = 0.002f; break;
+          case K_Thigh:     cloth = 0.007f; break;
+          // голень - без прибавки: по видимой ноге, а толще - её низ упирается в землю у щиколотки и подпирает шаг
+          // (тело после толчка не падает там, где должно)
+          default: break;
+          }
+        cloth *= S;
+        if(i==0 || p.kind==K_Spine) {
+          // поперёк тела: ширина та же, капсула толще
+          const float w = p.halfLen + p.radius;
+          p.radius  = p.radius + cloth;
+          p.halfLen = std::max(w - p.radius, 0.2f*p.radius);
+          } else {
+          // вдоль кости: длина та же (концы - полусферы)
+          const float l = p.halfLen + p.radius;
+          p.radius  = p.radius + cloth;
+          p.halfLen = std::max(l - p.radius, 0.15f*p.segHalf);
+          }
+        }
+      p.bodyInBone = inverseOf(sk.tr[p.bone])*p.bodyBind;
+      p.boneInBody = inverseOf(p.bodyInBone);
+
+      float density = 1050.f;
+      if(p.kind==K_Pelvis || p.kind==K_Spine)
+        density = 900.f;
+      if(p.kind==K_Head)
+        density = 1100.f;
+      const float r = p.bare*0.01f, h = 2.f*(p.halfLen+p.radius-p.bare)*0.01f;
+      const float pi = float(M_PI);
+      p.mass = density*(pi*r*r*h + 4.f/3.f*pi*r*r*r);
+      limitsOf(Kind(p.kind),humanoid,p);
+      strengthOf(Kind(p.kind),p);
+      lay->driven[p.bone] = 1;
+      }
+
+    // массы людей - доли тела человека (антропометрия, de Leva 1996): таз 14 %, позвонки 36 %, голова с шеей 8 %,
+    // плечо 2,8 %, предплечье 1,7 %, кисть 0,7 %, бедро 10 %, голень со стопой 6 %; вес - по росту модели
+    if(flat) {
+      const float M = 75.f*std::pow(S/180.f, 3.f);
+      size_t nSp = 0, nNeck = 0;
+      for(auto& p:lay->parts) {
+        nSp   += (p.kind==K_Spine);
+        nNeck += (p.kind==K_Neck);
+        }
+      for(auto& p:lay->parts) {
+        float f = 0;
+        switch(Kind(p.kind)) {
+          case K_Pelvis:   f = 0.14f; break;
+          case K_Spine:    f = 0.36f/float(std::max<size_t>(nSp,1)); break;
+          case K_Neck:     f = 0.025f/float(nNeck); break;
+          case K_Head:     f = nNeck>0 ? 0.056f : 0.081f; break;
+          case K_UpperArm: f = 0.028f; break;
+          case K_ForeArm:  f = 0.017f; break;
+          case K_Hand:     f = 0.007f; break;
+          case K_Thigh:    f = 0.10f;  break;
+          case K_Calf:     f = 0.06f;  break;
+          default: break;
+          }
+        if(f>0.f)
+          p.mass = f*M;
+        }
+      }
+
+    float maxMass = 0, total = 0;
+    for(auto& p:lay->parts)
+      maxMass = std::max(maxMass,p.mass);
+    // большая разница масс соседних тел растягивает суставы при ударах о землю
+    for(auto& p:lay->parts) {
+      p.mass = std::max(p.mass, 0.1f*maxMass);
+      total += p.mass;
+      }
+    // сила мышц и вязкость - по размеру тела (у человека 75 кг - как в strengthOf): вес частей растёт как M*L,
+    // их инерция - как M*L^2
+    {
+    const float k = total/75.f;
+    for(auto& p:lay->parts) {
+      p.torque *= std::pow(k, 4.f/3.f);
+      p.damp   *= std::pow(k, 5.f/3.f);
+      }
+    }
+
+    // тела, которые касаются друг друга в позе привязки (и соседние), не сталкиваются - иначе дрожат
+    for(size_t i=0; i<lay->parts.size(); ++i)
+      for(size_t r=i+1; r<lay->parts.size(); ++r) {
+        auto& a = lay->parts[i];
+        auto& b = lay->parts[r];
+        const Vec3 ac = originOf(a.bodyBind), ax = Vec3::normalize(axisOf(a.bodyBind,0))*a.halfLen;
+        const Vec3 bc = originOf(b.bodyBind), bx = Vec3::normalize(axisOf(b.bodyBind,0))*b.halfLen;
+        const float d = segmentDistance(ac-ax, ac+ax, bc-bx, bc+bx);
+        // соседи по суставу и через один сустав (братья, «дед») друг друга не толкают
+        const size_t ap  = a.parent, bp = b.parent;
+        const size_t app = ap<lay->parts.size() ? lay->parts[ap].parent : size_t(-1);
+        const size_t bpp = bp<lay->parts.size() ? lay->parts[bp].parent : size_t(-1);
+        const bool   near = (bp==i || ap==r || ap==bp || app==r || bpp==i);
+        // Gothic II Mobile: у людей предплечье и кисть упираются в корпус, голову и ноги (кроме своего сустава):
+        // через сустав «плечо» предплечье с грудью раньше не сталкивалось - руки проходили сквозь своё тело
+        if(flat && bp!=i && ap!=r) {
+          const auto arm   = [](uint8_t k) { return k==K_ForeArm || k==K_Hand; };
+          const auto trunk = [](uint8_t k) { return k==K_Pelvis || k==K_Spine || k==K_Neck || k==K_Head ||
+                                                    k==K_Thigh  || k==K_Calf; };
+          if((arm(a.kind) && trunk(b.kind)) || (arm(b.kind) && trunk(a.kind)))
+            continue;
+          }
+        if(near || d<(a.radius+b.radius)*1.1f)
+          lay->noCollide.push_back({uint16_t(i),uint16_t(r)});
+        }
+    if(flat)
+      for(size_t i=0; i<lay->parts.size(); ++i)
+        for(size_t r=0; r<lay->parts.size(); ++r) {
+          const uint8_t a = lay->parts[i].kind, b = lay->parts[r].kind;
+          if((a==K_ForeArm || a==K_Hand) && (b==K_Pelvis || b==K_Spine || b==K_Neck || b==K_Head))
+            lay->armTrunk.push_back({uint16_t(i),uint16_t(r)});
+          }
+
+    // корень (BIP01) над тазом - за тазом: на него смотрит камера, к нему крепятся слоты
+    {
+    const size_t rp = sk.nodes[rootBone].parent;
+    if(rp<n && partOf[rp]==size_t(-1)) {
+      lay->follower   = rp;
+      lay->driven[rp] = 1;
+      }
+    }
+
+    // грудь: часть, к которой крепится голова, иначе верхняя часть позвоночника
+    lay->chest = 0;
+    for(size_t i=1; i<lay->parts.size(); ++i)
+      if(lay->parts[i].kind==K_Head) {
+        const size_t pp = lay->parts[i].parent;
+        if(lay->parts[pp].kind==K_Spine || lay->parts[pp].kind==K_Neck || lay->parts[pp].kind==K_Pelvis)
+          lay->chest = pp;
+        while(lay->chest!=0 && lay->parts[lay->chest].kind==K_Neck)
+          lay->chest = lay->parts[lay->chest].parent;
+        }
+    if(lay->chest==0)
+      for(size_t i=1; i<lay->parts.size(); ++i)
+        if(lay->parts[i].kind==K_Spine)
+          lay->chest = i;
+    {
+    const auto& m = sk.tr[lay->parts[lay->chest].bone];
+    const Vec3  f = Vec3(0,0,1);
+    Vec3 fl = Vec3(Vec3::dotProduct(Vec3::normalize(axisOf(m,0)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,1)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,2)),f));
+    lay->frontLocal = Vec3::normalize(fl);
+    }
+    // активный регдолл: что закреплено за анимацией. У людей - таз и ноги (руки и тело откликаются на удары),
+    // у зверей - таз и все лапы (откликаются тело, шея, голова, хвост). На экране закреплённые - анимация со
+    // стойкой поведения (B_Pinned: сдвиг таза, IK ног, ступни шагов), остальные части - физика (B_Rel)
+    lay->activeMode.assign(n,Ragdoll::B_Anim);
+    for(size_t i=0; i<lay->parts.size(); ++i) {
+      auto&      p = lay->parts[i];
+      const Kind k = Kind(p.kind);
+      if(i==0 || k==K_Thigh || k==K_Calf || k==K_Foot)
+        p.pinned = true;
+      else if(!humanoid && k!=K_Spine && k!=K_Neck && k!=K_Head && k!=K_Tail)
+        p.pinned = true;
+      lay->activeMode[p.bone] = p.pinned ? Ragdoll::B_Pinned : Ragdoll::B_Rel;
+      const float x = Vec3::dotProduct(pos[p.bone]-pos[rootBone], Vec3(1,0,0));
+      if(k==K_UpperArm || k==K_ForeArm || k==K_Hand || k==K_Thigh || k==K_Calf)
+        p.side = (std::abs(x)<0.01f*S) ? 0.f : (x>0 ? 1.f : -1.f);
+      }
+    if(lay->follower!=size_t(-1))
+      lay->activeMode[lay->follower] = Ragdoll::B_Pinned;
+
+    // руки и ноги по сторонам (по именам костей Biped), стопы, позвоночник от таза к груди
+    for(size_t i=1; i<lay->parts.size(); ++i) {
+      auto&     p    = lay->parts[i];
+      const int side = sideOfName(sk.nodes[p.bone].name);
+      if(side<0)
+        continue;
+      switch(Kind(p.kind)) {
+        case K_UpperArm: lay->upper[side] = i; break;
+        case K_ForeArm:  lay->fore [side] = i; break;
+        case K_Hand:     lay->hand [side] = i; break;
+        case K_Thigh:    lay->thigh[side] = i; break;
+        case K_Calf: {
+          lay->calf[side] = i;
+          for(auto c:child[p.bone])
+            if(kind[c]==K_Foot)
+              lay->foot[side] = c;
+          break;
+          }
+        default: break;
+        }
+      if(p.kind==K_Neck && lay->neck==size_t(-1))
+        lay->neck = i;
+      }
+    for(size_t i=1; i<lay->parts.size(); ++i)
+      if(lay->parts[i].kind==K_Head)
+        lay->head = i;
+    for(size_t i=lay->chest; i!=0 && i<lay->parts.size(); i=lay->parts[i].parent)
+      lay->spineChain.insert(lay->spineChain.begin(), i);
+    {
+    const auto& m = sk.tr[lay->parts[0].bone];
+    const Vec3  f = Vec3(0,0,1);
+    Vec3 fl = Vec3(Vec3::dotProduct(Vec3::normalize(axisOf(m,0)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,1)),f),
+                   Vec3::dotProduct(Vec3::normalize(axisOf(m,2)),f));
+    lay->pelvisFrontLocal = Vec3::normalize(fl);
+    }
+    bool limbs = humanoid && InjuryRig::of(sk)!=nullptr;
+    for(int s=0; s<2; ++s)
+      limbs &= lay->upper[s]!=size_t(-1) && lay->fore[s]!=size_t(-1) && lay->thigh[s]!=size_t(-1) &&
+               lay->calf[s]!=size_t(-1) && lay->foot[s]!=size_t(-1) &&
+               lay->parts[lay->thigh[s]].parent==0 && lay->parts[lay->calf[s]].parent==lay->thigh[s];
+    lay->stance = limbs;
+    if(flat)
+      anatomy(*lay,partEnd,fwd);
+
+    // части каждого поддерева (часть и все её потомки)
+    for(size_t k=0; k<lay->parts.size(); ++k)
+      for(size_t a=k; a<lay->parts.size(); a=(a==0 ? size_t(-1) : lay->parts[a].parent))
+        lay->parts[a].subtree |= (1u<<k);
+    return lay;
+    }
+  };
+
+}
+
+const Ragdoll::Layout* Ragdoll::layoutOf(const Skeleton& sk) {
+  static std::mutex                                               sync;
+  static std::map<const Skeleton*, std::unique_ptr<Layout>>       cache;
+  static std::map<const Skeleton*, bool>                          known;
+  std::lock_guard<std::mutex> guard(sync);
+  if(known[&sk])
+    return cache[&sk].get();
+  known[&sk] = true;
+
+  Builder bld(sk);
+  auto    lay = bld.build();
+  if(lay==nullptr) {
+    Log::i("[g2m] ragdoll: skeleton \"",sk.name(),"\" not supported");
+    return nullptr;
+    }
+
+  std::string desc;
+  float total = 0;
+  for(auto& p:lay->parts) {
+    char buf[96] = {};
+    std::snprintf(buf,sizeof(buf)," %s(r%.0f l%.0f %.1fkg%s)", kindName(p.kind), double(p.radius),
+                  double(2.f*(p.halfLen+p.radius)), double(p.mass), p.joint==J_Euler ? " anat" : (p.joint==J_Swing ? " ball" : ""));
+    desc += buf;
+    total += p.mass;
+    }
+  Log::i("[g2m] ragdoll: \"",sk.name(),"\" ",lay->parts.size()," parts, size ",int(lay->size),"cm, ",
+         int(total),"kg",lay->humanoid ? ", humanoid" : "",":",desc);
+  auto ret = lay.get();
+  cache[&sk] = std::move(lay);
+  return ret;
+  }
