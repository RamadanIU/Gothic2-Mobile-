+void PlayerControl::touchSwitchTarget(int dir) {
+  // Лук, арбалет, магия: следующая цель слева/справа на экране, как стрелки при прицеливании
+  moveFocus(dir<0 ? ActLeft : ActRight);
+  if(touchTgt!=nullptr && currentFocus.npc!=nullptr)
+    touchTgt = currentFocus.npc;
+  }
+
+void PlayerControl::touchDrawWeapon(uint8_t slot) {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr)
+    return;
+  const auto ws    = pl->weaponState();
+  const bool melee = (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+  const bool bow   = (ws==WeaponState::Bow  || ws==WeaponState::CBow);
+  std::memset(wctrl,0,sizeof(wctrl));
+  if(slot==0) {
+    if(ws!=WeaponState::NoWeapon)
+      wctrl[WeaponClose] = true;
+    }
+  else if(slot==1) {
+    if(!melee)
+      wctrl[WeaponMele] = true;
+    }
+  else if(slot==2) {
+    if(!bow)
+      wctrl[WeaponBow] = true;
+    }
+  else if(slot>=3 && slot<=10) {
+    if(!(ws==WeaponState::Mage && pl->inventory().currentSpellSlot()==slot))
+      wctrl[slot] = true;
+    }
+  }
