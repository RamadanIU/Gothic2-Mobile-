+bool GameMenu::closeSubView() {
+  if(logView!=nullptr) {
+    logView->visible = false;
+    logView          = nullptr;
+    curItem          = logList!=nullptr ? indexOf(*logList) : logPrev;
+    update();
+    return true;
+    }
+  if(logList!=nullptr) {
+    logList    = nullptr;
+    freeScroll = nullptr;
+    curItem    = logPrev;
+    update();
+    return true;
+    }
+  return false;
+  }
