+void GameScript::companionChoices(Npc& player, Npc& npc, std::vector<DlgChoice>& out) {
+  if(Gothic::inst().version().game!=2 || &player==&npc || npc.isDown())
+    return;
+  auto& h = npc.handle();
+
+  // Перед «Конец» (nr 999), в этом порядке
+  auto add = [&out](uint32_t id, const std::string& title, int32_t sort) {
+    DlgChoice ch;
+    ch.title    = title;
+    ch.scriptFn = id;
+    ch.sort     = sort;
+    out.push_back(std::move(ch));
+    };
+
+  if(isHired(npc)) {
+    // Обмен как торговля, но даром: взять его вещи или отдать свои; деньги не переходят
+    DlgChoice ch;
+    ch.title     = toCp1251("Покажи, что у тебя есть.");
+    ch.scriptFn  = CompanionTrade;
+    ch.sort      = 995;
+    ch.isTrade   = true;
+    ch.freeTrade = true;
+    out.push_back(std::move(ch));
+    if(npc.hasRoutineState(findSymbolIndex("ZS_FOLLOW_PLAYER")))
+      add(CompanionWait,  toCp1251("Подожди меня здесь."), 996);
+    else
+      add(CompanionFollow,toCp1251("Пойдём дальше вместе."), 996);
+    add(CompanionDismiss, toCp1251("Дальше я сам. Спасибо за помощь!"), 997);
+    return;
+    }
+
+  // Нанять можно только безымянного; именной житель идёт с героем, если сам согласится (кнопка «Сказать»)
+  if(!isAmbient(h) || h.guild>=GIL_SEPERATOR_HUM)
+    return;
+
+  if(isPartyMember(npc))
+    return;
+  const auto att = personAttitude(npc,player);
+  if(att==ATT_HOSTILE || att==ATT_ANGRY)
+    return;
+  // Стража у прохода остаётся на посту: иначе ворота открылись бы сами
+  if(npc.hasRoutineState(findSymbolIndex("ZS_GUARD_PASSAGE")))
+    return;
+  if(hiredCount()>=MaxHired)
+    return;
+
+  const int32_t price = hirePrice(npc);
+  add(CompanionHire, toCp1251("Пойдём со мной — поможешь в бою? (") + std::to_string(price) + toCp1251(" золотых)"), 998);
+  }
+
+void GameScript::execCompanion(const DlgChoice& dlg, Npc& player, Npc& npc) {
+  auto& h        = npc.handle();
+  const int32_t aivParty  = scriptConst("AIV_PARTYMEMBER",15);
+  const size_t  zsFollow  = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  auto          setParty  = [&](bool v) {
+    if(aivParty>=0 && uint32_t(aivParty)<zenkit::INpc::aivar_count)
+      h.aivar[size_t(aivParty)] = v ? 1 : 0;
+    };
+  auto          follow    = [&]() {
+    if(zsFollow==size_t(-1))
+      return;
+    auto wp = npc.currentTaPoint();
+    npc.setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+    };
+  auto          endTalk   = [&]() {
+    npc.aiPush(AiQueue::aiStopProcessInfo(aiOutOrderId));
+    ++aiOutOrderId;
+    };
+
+  // Разговор прервал занятие на привале: после него - заново
+  npc.companionIdle.act  = IdleNone;
+  npc.companionIdle.peer = nullptr;
+
+  switch(dlg.scriptFn) {
+    case CompanionHire: {
+      const size_t  gold  = findSymbolIndex("ITMI_GOLD");
+      const int32_t price = hirePrice(npc);
+      if(gold==size_t(-1) || player.itemCount(gold)<size_t(price)) {
+        // Называет цену своим голосом и ждёт денег; диалог продолжается
+        companionSay(npc,player,string_frm("$GOLD_",int(price)));
+        return;
+        }
+      npc.addItem(gold,player,size_t(price));
+      companionSay(npc,player,"$ITookYourGold");
+      squadJoin(npc);
+      Tempest::Log::i("[g2m] companion: hired \"",npc.displayName(),"\" level=",h.level," price=",price);
+      endTalk();
+      break;
+      }
+    case CompanionTrade:
+      // Окно обмена откроет диалог (DlgChoice::isTrade), когда он договорит
+      companionSay(npc,player,"$ABS_GOOD");
+      Tempest::Log::i("[g2m] companion: exchange with \"",npc.displayName(),"\"");
+      break;
+    case CompanionWait: {
+      squadCamp(npc);
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+      }
+    case CompanionFollow:
+      follow();
+      companionSay(npc,player,"$ABS_GOOD");
+      endTalk();
+      break;
+    case CompanionDismiss:
+      setParty(false);
+      h.aivar[AivStance] = 0;
+      npc.companionIdle  = Npc::CompanionIdle();
+      // Пошедший по своей воле - к своим делам (свой распорядок, Геральт - в кабак)
+      if(aiNpcPtr->isAiFollower(npc))
+        aiNpcPtr->releaseFollower(npc);
+      else if(h.daily_routine>0)
+        npc.excRoutine(size_t(h.daily_routine));
+      companionSay(npc,player,"$ABS_GOOD");
+      Tempest::Log::i("[g2m] companion: dismissed \"",npc.displayName(),"\"");
+      endTalk();
+      break;
+    default:
+      break;
+    }
+  }
+
+void GameScript::supplyPotions(Npc& npc) {
+  // У напарника всегда есть зелья: перед лечением (ZS_HealSelf пьёт ItPo_Health_03..01, пока не вылечится)
+  // докладываем столько, сколько не хватает до полного здоровья. Запас появляется в момент нужды,
+  // поэтому вынести через обмен бесконечные зелья нельзя
+  const int32_t need = npc.attribute(ATR_HITPOINTSMAX)-npc.attribute(ATR_HITPOINTS);
+  if(need<=0)
+    return;
+  struct Potion { const char* item; const char* hp; int32_t def; };
+  static const Potion potions[] = {
+    {"ITPO_HEALTH_03", "HP_ELIXIER", 100},
+    {"ITPO_HEALTH_02", "HP_EXTRAKT", 70},
+    {"ITPO_HEALTH_01", "HP_ESSENZ",  50},
+    };
+  int32_t have = 0;
+  for(auto& p:potions) {
+    const size_t id = findSymbolIndex(p.item);
+    if(id!=size_t(-1))
+      have += int32_t(npc.itemCount(id))*std::max(1,scriptConst(p.hp,p.def));
+    }
+  if(have>=need)
+    return;
+  const size_t  id   = findSymbolIndex("ITPO_HEALTH_02");
+  const int32_t heal = std::max(1,scriptConst("HP_EXTRAKT",70));
+  if(id==size_t(-1))
+    return;
+  const int32_t n = (need-have+heal-1)/heal;
+  npc.addItem(id,size_t(n));
+  Tempest::Log::i("[g2m] companion: \"",npc.displayName(),"\" potions +",n);
+  }
+
+bool GameScript::isSquadSide(Npc& npc) {
+  return npc.isPlayer() || isHired(npc);
+  }
+
+bool GameScript::companionPerceives(Npc& npc, Npc& other, Npc* victim, PercType perc) {
+  // Нанятый не обижается на героя и на других напарников: не видит «кражи» (своего оружия, вещей в
+  // доме), урона от своих, входа в дом, оружия в руках, убийств, шума, тревоги стражи. Иначе по скриптам
+  // он нападает, запоминает преступление (B_MemorizePlayerCrime: лорд Андре, Парлан, Ли) и потом в
+  // разговоре сразу обрывает его укором (DIA_Ambient_NEWS)
+  switch(perc) {
+    case PERC_ASSESSTHEFT:
+    case PERC_ASSESSUSEMOB:
+    case PERC_ASSESSENTERROOM:
+    case PERC_ASSESSTHREAT:
+    case PERC_DRAWWEAPON:
+    case PERC_ASSESSDAMAGE:
+    case PERC_ASSESSMURDER:
+    case PERC_ASSESSQUIETSOUND:
+    case PERC_ASSESSWARN:
+    case PERC_ASSESSDEFEAT:
+    case PERC_ASSESSOTHERSDAMAGE:
+    case PERC_ASSESSFIGHTSOUND:
+      break;
+    default:
+      return true;
+    }
+  if(!isHired(npc))
+    return true;
+  if(perc==PERC_ASSESSWARN)
+    return false; // тревога стражи - всегда о герое
+  if(!isSquadSide(other))
+    return true;  // чужой бьёт или ворует - как обычно
+  if(perc==PERC_ASSESSFIGHTSOUND || perc==PERC_ASSESSOTHERSDAMAGE || perc==PERC_ASSESSDEFEAT) {
+    // Герой бьёт врага - помочь; бьёт кого-то другого - не вступаться за него
+    return victim!=nullptr && victim!=&npc && !isSquadSide(*victim) && personAttitude(npc,*victim)==ATT_HOSTILE;
+    }
+  return false;
+  }
+
+void GameScript::companionCalm(Npc& npc) {
+  // Сразу в распорядок, без конца ZS_Attack (там реплики, «жалоба» и обыск). Если состояние то же
+  // (B_Attack уже снял перцепции), оно начнётся заново и включит их
+  const size_t zs = findSymbolIndex(squadIsWaiting(npc) ? "ZS_STAND_ARMSCROSSED" : "ZS_FOLLOW_PLAYER");
+  if(zs==size_t(-1))
+    return;
+  auto wp = npc.currentTaPoint();
+  npc.setTarget(nullptr);
+  npc.startState(zs, wp!=nullptr ? std::string_view(wp->name) : std::string_view(), gtime::endOfTime(), !npc.isInState(zs));
+  }
+
+void GameScript::companionForgive(Npc& npc, Npc& player) {
+  auto& h = npc.handle();
+  // Запомненное «преступление» героя: откатить его вклад в счётчики (как скрипты при смерти NPC,
+  // B_DeletePetzCrime) и забыть - иначе он не даёт поговорить и грозит лордом Андре
+  const int32_t aivCrime = scriptConst("AIV_NPCSAWPLAYERCOMMIT",1);
+  const int32_t none     = scriptConst("CRIME_NONE",0);
+  if(aivCrime>=0 && uint32_t(aivCrime)<zenkit::INpc::aivar_count && h.aivar[size_t(aivCrime)]!=none) {
+    invokeNpcFn("B_DELETEPETZCRIME",npc,player);
+    Tempest::Log::i("[g2m] companion: \"",npc.displayName(),"\" forgives crime ",h.aivar[size_t(aivCrime)]);
+    h.aivar[size_t(aivCrime)] = none;
+    }
+  // Обида (ATT_ANGRY/HOSTILE после драки) - прощена
+  if(npc.attitude()==ATT_ANGRY || npc.attitude()==ATT_HOSTILE)
+    npc.setAttitude(ATT_FRIENDLY);
+  if(npc.tempAttitude()==ATT_ANGRY || npc.tempAttitude()==ATT_HOSTILE)
+    npc.setTempAttitude(npc.attitude());
+  // Дерётся с героем или с другим напарником - перестать
+  if(npc.isAttack() && npc.target()!=nullptr && isSquadSide(*npc.target())) {
+    Tempest::Log::i("[g2m] companion: \"",npc.displayName(),"\" stops fighting \"",npc.target()->displayName(),"\"");
+    companionCalm(npc);
+    }
+  }
+
+ScriptFn GameScript::companionState(Npc& npc, ScriptFn fn, Npc* other) {
+  if(!fn.isValid() || Gothic::inst().version().game!=2)
+    return fn;
+  const bool self   = isHired(npc);
+  const bool victim = other!=nullptr && other!=&npc && isHired(*other);
+  if(!self && !victim)
+    return fn;
+
+  if(self && other!=nullptr && other!=&npc && isSquadSide(*other)) {
+    // Напасть на героя или на своего, выгнать из дома, следить, отшатнуться - нет: обратно в распорядок
+    static const char* hostile[] = {"ZS_ATTACK", "ZS_REACTTOWEAPON", "ZS_REACTTODAMAGE", "ZS_OBSERVEPLAYER",
+                                    "ZS_CLEARROOM", "ZS_FLEE"};
+    for(auto name:hostile) {
+      if(fn.ptr!=findSymbolIndex(name))
+        continue;
+      Tempest::Log::i("[g2m] companion: \"",npc.displayName(),"\" won't ",name," \"",other->displayName(),"\"");
+      companionCalm(npc);
+      return ScriptFn();
+      }
+    }
+
+  if(fn.ptr==findSymbolIndex("ZS_RANSACKBODY")) {
+    // Победитель обирает побеждённого: забирает золото и подбирает его оружие (конец ZS_Attack).
+    // Напарник никого не обирает, и самого напарника, лежащего без сознания, не обирают
+    Tempest::Log::i("[g2m] companion: no ransack \"",npc.displayName(),"\" -> \"",
+                    other!=nullptr ? other->displayName() : "","\"");
+    const size_t zsHeal = findSymbolIndex("ZS_HEALSELF");
+    if(self && zsHeal!=size_t(-1) && npc.attribute(ATR_HITPOINTS)*2<npc.attribute(ATR_HITPOINTSMAX)) {
+      // Как в конце ZS_Attack, когда обыскивать некого: подлечиться
+      supplyPotions(npc);
+      return ScriptFn(zsHeal);
+      }
+    return ScriptFn();
+    }
+  if(!self)
+    return fn;
+  if(fn.ptr==findSymbolIndex("ZS_DEAD") && !npc.isDead())
+    return ScriptFn(); // ZS_Unconscious в воде сразу переводит в ZS_Dead: напарник не погибает
+  if(fn.ptr==findSymbolIndex("ZS_HEALSELF"))
+    supplyPotions(npc);
+  return fn;
+  }
+
+bool GameScript::isPassive(Npc& npc) {
+  return npc.handle().aivar[AivStance]!=0;
+  }
+
+void GameScript::setStance(Npc& npc, bool passive) {
+  npc.handle().aivar[AivStance] = passive ? 1 : 0;
+  }
+
+void GameScript::squadMembers(std::vector<Npc*>& out) {
+  out.clear();
+  auto& w = world();
+  for(uint32_t i=0; i<w.npcCount(); ++i) {
+    auto npc = w.npcById(i);
+    if(npc!=nullptr && !npc->isDead() && isHired(*npc))
+      out.push_back(npc);
+    }
+  }
+
+bool GameScript::squadPassive() {
+  std::vector<Npc*> sq;
+  squadMembers(sq);
+  for(auto i:sq)
+    if(isPassive(*i))
+      return true;
+  return false;
+  }
+
+bool GameScript::squadIsWaiting(Npc& npc) {
+  return !npc.hasRoutineState(findSymbolIndex("ZS_FOLLOW_PLAYER"));
+  }
+
+int32_t GameScript::attackReason(Npc& npc, Npc& enemy) {
+  // Зверь - как в скриптах (AR_MonsterVsHuman). Враг по гильдии - насмерть (AR_GuildEnemy), остальных
+  // людей напарник только сбивает с ног (AR_GuardStopsFight): сюжетные NPC не погибнут от его руки
+  if(enemy.guild()>GIL_SEPERATOR_HUM)
+    return scriptConst("AR_MONSTERVSHUMAN",4);
+  if(personAttitude(npc,enemy)==ATT_HOSTILE)
+    return scriptConst("AR_GUILDENEMY",14);
+  return scriptConst("AR_GUARDSTOPSFIGHT",12);
+  }
+
+void GameScript::squadNoteHit(Npc& attacker, Npc& victim) {
+  // Герой кого-то ударил - отряд нападает на него же, кто бы это ни был (людей только сбивает с ног).
+  // Кто-то ударил героя или напарника - тоже враг, даже если не в ZS_Attack (стрелок, маг)
+  if(Gothic::inst().version().game!=2 || &attacker==&victim)
+    return;
+  Npc* foe = nullptr;
+  if(attacker.isPlayer() && !isSquadSide(victim))
+    foe = &victim;
+  else if(!isSquadSide(attacker) && isSquadSide(victim))
+    foe = &attacker;
+  if(foe==nullptr || foe->isDead())
+    return;
+  const uint64_t until = tickCount()+30000;
+  for(auto& m:squadMarks)
+    if(m.npc==foe) {
+      m.until = until;
+      return;
+      }
+  if(squadMarks.size()>=16)
+    squadMarks.erase(squadMarks.begin());
+  squadMarks.push_back({foe,until});
+  Tempest::Log::i("[g2m] squad: mark \"",foe->displayName(),"\"",attacker.isPlayer() ? " (hit by hero)" : "");
+  }
+
+bool GameScript::squadMarked(const Npc& npc, uint64_t now) const {
+  // Указатель только сравнивается: отметка могла пережить NPC
+  for(auto& m:squadMarks)
+    if(m.npc==&npc && m.until>now)
+      return true;
+  return false;
+  }
+
+bool GameScript::squadThreat(Npc& o, uint64_t now) {
+  // Враг отряда: бьёт героя или напарника, монстр угрожает им перед броском (ZS_MM_ThreatenEnemy),
+  // или отмечен ударом (squadNoteHit)
+  if(o.isDead() || o.isDown() || isSquadSide(o) || isPartyMember(o))
+    return false;
+  auto& h = o.handle();
+  // Арена и поединки из диалога (AR_NONE) герой выигрывает сам: иначе скрипты не засчитают победу
+  // (AIV_DefeatedByPlayer, дуэли наёмников)
+  const int32_t aivArena  = scriptConst("AIV_ARENAFIGHT",45);
+  if(aivArena>=0 && uint32_t(aivArena)<zenkit::INpc::aivar_count && h.aivar[size_t(aivArena)]==scriptConst("AF_RUNNING",1))
+    return false;
+  if(o.isAttack()) {
+    auto tg = o.target();
+    if(tg!=nullptr && isSquadSide(*tg)) {
+      const int32_t aivReason = scriptConst("AIV_ATTACKREASON",9);
+      const bool    duel      = o.guild()<GIL_SEPERATOR_HUM && tg->isPlayer() && aivReason>=0 &&
+                                uint32_t(aivReason)<zenkit::INpc::aivar_count &&
+                                h.aivar[size_t(aivReason)]==scriptConst("AR_NONE",0);
+      return !duel;
+      }
+    }
+  if(o.isInState(findSymbolIndex("ZS_MM_THREATENENEMY")) && o.stateOther()!=nullptr && isSquadSide(*o.stateOther()))
+    return true;
+  return squadMarked(o,now);
+  }
+
+Npc* GameScript::squadEnemy(Npc& npc, Npc& player, bool following, uint64_t now) {
+  // Враг отряда рядом. Следующий за героем вступается в радиусе 20 м от героя (и за стрелков),
+  // ждущий на месте - только за тех, кто рядом с ним
+  const float range = following ? 2000.f : 800.f;
+  Npc*        ret   = nullptr;
+  float       best  = 0;
+  world().detectNpc(npc.position(), range, [&](Npc& o) {
+    if(&o==&npc || &o==&player || !squadThreat(o,now))
+      return;
+    if(following && player.qDistTo(o)>2000.f*2000.f)
+      return;
+    const float qd = npc.qDistTo(o);
+    if(ret==nullptr || qd<best) {
+      ret  = &o;
+      best = qd;
+      }
+    });
+  return ret;
+  }
+
+bool GameScript::squadInFight(Npc& player) {
+  // Кто-то рядом дерётся с героем или с напарником - не до отдыха
+  bool fight = false;
+  world().detectNpc(player.position(), 2000.f, [&](Npc& o) {
+    if(fight || o.isDown() || !o.isAttack())
+      return;
+    auto tg = o.target();
+    if(tg!=nullptr && (tg==&player || isHired(*tg) || isHired(o)))
+      fight = true;
+    });
+  return fight;
+  }
+
+bool GameScript::tickSquadHeal(Npc& npc, uint64_t now) {
+  // После боя напарник лечится сам (ZS_HealSelf), как NPC игры, - зелья у него найдутся всегда
+  auto& st = npc.companionIdle;
+  if(now<st.healAt || npc.attribute(ATR_HITPOINTS)*2>=npc.attribute(ATR_HITPOINTSMAX))
+    return false;
+  const size_t zsHeal   = findSymbolIndex("ZS_HEALSELF");
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  const size_t zsStand  = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+  if(zsHeal==size_t(-1) || !(npc.isInState(zsFollow) || npc.isInState(zsStand)))
+    return false; // в бою, в разговоре, без сознания - потом
+  st.healAt = now+20000;
+  npc.clearAiQueue();
+  npc.companionFollow.driving = false;
+  npc.companionFollow.holdTo  = now+1000; // не сбить запуск лечения своим ходом
+  npc.aiPush(AiQueue::aiStartState(zsHeal,1,nullptr,nullptr,""));
+  Tempest::Log::i("[g2m] squad: \"",npc.displayName(),"\" heals, hp=",npc.attribute(ATR_HITPOINTS),"/",npc.attribute(ATR_HITPOINTSMAX));
+  return true;
+  }
+
+// В пути. Скрипт следования (ZS_Follow_Player) ведёт напарника к герою AI_GotoNpc - по прямой, без поиска
+// пути: за парой поворотов он упирается в стену, а вдали от героя движок его почти не обрабатывает, и он
+// «пропадает». Все сбегались в одну точку у героя и толкались. Поэтому дорогу выбирает отряд:
+//  - строй: у каждого своё место тесной группой позади героя (по направлению его хода, между соседями около
+//    полуметра), в тесноте - цепочкой по следу;
+//  - за угол - по следу героя (точки, где он прошёл: там точно можно пройти), следа не видно - по сети
+//    точек пути игры (AI_GoToPoint ищет путь);
+//  - отстал дальше 35 м, 8 с не видит героя дальше 12 м или застрял на 6 с - переносится на след героя за его
+//    спиной (там земля и камера туда не смотрит).
+
+static float qDistXZ(const Tempest::Vec3& a, const Tempest::Vec3& b) {
+  const float dx = a.x-b.x, dz = a.z-b.z;
+  return dx*dx+dz*dz;
+  }
+
+// Места в строю: сколько позади героя и сколько вбок (см). Центры соседей - в 1,1 м: между плечами около
+// полуметра, как идут люди. Первый ряд - двое, второй - трое, третий - один
+static const float SlotBack[] = {140.f, 140.f, 240.f, 240.f, 240.f, 340.f};
+static const float SlotSide[] = {-55.f,  55.f, -110.f, 110.f,  0.f,   0.f};
+
+bool GameScript::squadTrailBehind(float dist, Tempest::Vec3& out) const {
+  // Точка следа в dist см (по следу) позади героя
+  float acc  = 0;
+  auto  prev = squadHeroLast;
+  for(size_t i=squadTrail.size(); i>0; --i) {
+    const auto& p = squadTrail[i-1];
+    acc += std::sqrt(qDistXZ(p,prev));
+    prev = p;
+    if(acc>=dist) {
+      out = p;
+      return true;
+      }
+    }
+  return false;
+  }
+
+const Tempest::Vec3* GameScript::squadTrailVisible(Npc& npc, size_t skip) const {
+  // Самая свежая точка следа, которую напарник видит, не дальше 25 м. k-й в строю не берёт k последних -
+  // по следу идут цепочкой, а не толпой
+  const auto np = npc.position();
+  size_t     n  = 0;
+  for(size_t i=squadTrail.size(); i>skip && n<40; --i, ++n) {
+    const auto& p = squadTrail[i-1-skip];
+    if(qDistXZ(p,np)>2500.f*2500.f)
+      continue;
+    if(npc.canRayHitPoint(p+Tempest::Vec3(0.f,60.f,0.f),true,1500.f))
+      return &p;
+    }
+  return nullptr;
+  }
+
+void GameScript::squadTeleport(Npc& npc, Npc& player, size_t slot, uint64_t now, const char* why) {
+  auto& fs = npc.companionFollow;
+  const auto hp = player.position();
+  Tempest::Vec3 p;
+  if(!squadTrailBehind(300.f+150.f*float(slot),p)) {
+    // Следа нет (герой сам перенёсся): точка пути в 10 м от героя, которую он видит
+    auto wp = world().findWayPoint(hp,[&](const WayPoint& w) {
+      return qDistXZ(w.position(),hp)<1000.f*1000.f && player.canRayHitPoint(w.position()+Tempest::Vec3(0.f,60.f,0.f),true,1000.f);
+      });
+    if(wp==nullptr)
+      return; // некуда - позже
+    p = wp->position();
+    }
+  npc.clearAiQueue();
+  npc.setPosition(p);
+  npc.setDirection(hp-p);
+  fs.lastPos  = p;
+  fs.movedAt  = now;
+  fs.hiddenAt = 0;
+  fs.teleAt   = now+5000;
+  fs.driving  = false;
+  Tempest::Log::i("[g2m] squad: \"",npc.displayName(),"\" teleported (",why,")");
+  }
+
+void GameScript::squadArrive() {
+  auto* pl = world().player();
+  if(pl==nullptr)
+    return;
+  squadMembers(squadTmp);
+  // След героя остался там, откуда он ушёл
+  squadTrail.clear();
+  squadHeroAt = 0;
+  const uint64_t now      = tickCount();
+  const size_t   zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  const auto     hp       = pl->position();
+  const float    a        = pl->rotationRad();
+  squadDir = Tempest::Vec3(std::cos(a),0.f,std::sin(a));
+  const Tempest::Vec3 back  = -squadDir;
+  const Tempest::Vec3 right = Tempest::Vec3(-squadDir.z,0.f,squadDir.x);
+  size_t k = 0;
+  for(auto npc:squadTmp) {
+    if(!npc->hasRoutineState(zsFollow) || npc->isDown())
+      continue;
+    const size_t slot = std::min<size_t>(k++, std::size(SlotBack)-1);
+    // Место в строю за спиной героя - если там земля и его видно от героя; иначе - точка пути рядом
+    const Tempest::Vec3 goal = hp + back*SlotBack[slot] + right*SlotSide[slot];
+    const auto ray = world().physic()->landRay(goal+Tempest::Vec3(0.f,150.f,0.f));
+    if(!ray.hasCol || std::abs(ray.v.y-hp.y)>150.f || !pl->canRayHitPoint(ray.v+Tempest::Vec3(0.f,60.f,0.f),true,1000.f)) {
+      npc->companionFollow.teleAt = 0;
+      squadTeleport(*npc,*pl,slot,now,"travel");
+      continue;
+      }
+    auto& fs = npc->companionFollow;
+    npc->clearAiQueue();
+    npc->setPosition(ray.v);
+    npc->setDirection(hp-ray.v);
+    npc->updateTransform();
+    fs.lastPos  = ray.v;
+    fs.movedAt  = now;
+    fs.hiddenAt = 0;
+    fs.teleAt   = now+5000;
+    fs.driving  = false;
+    Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" arrived with hero");
+    }
+  }
+
+std::vector<std::vector<uint8_t>> GameScript::squadLeaveWorld() {
+  std::vector<std::vector<uint8_t>> ret;
+  auto& w  = world();
+  auto* pl = w.player();
+  if(pl==nullptr)
+    return ret;
+  squadMembers(squadTmp);
+  const std::vector<Npc*> squad    = squadTmp;
+  const size_t            zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  for(auto npc:squad) {
+    // Только безымянные нанятые и Геральт: сюжетные NPC, пошедшие с героем по своей воле, нужны скриптам своего мира
+    const bool carry = isAmbient(npc->handle()) && npc->hasRoutineState(zsFollow) && !npc->isCompanionCamp() &&
+                       !npc->isDown() && pl->qDistTo(*npc)<SquadCarryDist*SquadCarryDist;
+    if(!carry) {
+      Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" stays in ",w.name());
+      continue;
+      }
+    npc->clearAiQueue();
+    std::vector<uint8_t> data;
+    {
+    Tempest::MemWriter wr{data};
+    Serialize          sr{wr};
+    sr.setEntry("squad");
+    npc->save(sr,0,"/npc/");
+    }
+    aiNpcPtr->leaveWorld(*npc,*pl);
+    Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" leaves ",w.name()," with hero");
+    w.removeNpc(*npc);
+    ret.push_back(std::move(data));
+    }
+  return ret;
+  }
+
+void GameScript::squadEnterWorld(const std::vector<std::vector<uint8_t>>& squad, std::string_view wayPoint) {
+  auto& w  = world();
+  auto* pl = w.player();
+  if(pl==nullptr || squad.empty())
+    return;
+  for(auto& data:squad) {
+    Npc* npc = nullptr;
+    try {
+      Tempest::MemReader rd{data};
+      Serialize          sr{rd};
+      sr.setEntry("squad");
+      auto ptr = std::make_unique<Npc>(w,size_t(-1),wayPoint);
+      ptr->load(sr,0,"/npc/");
+      npc = w.insertNpc(std::move(ptr),wayPoint);
+      }
+    catch(...) {
+      Tempest::Log::e("[g2m] squad: unable to bring a companion to ",w.name());
+      continue;
+      }
+    if(npc==nullptr)
+      continue;
+    // Ссылки на NPC и точки прежнего мира в записи пусты: распорядок «следовать» и строй - заново, точка - прибытия
+    npc->handle().wp = std::string(wayPoint);
+    npc->clearAiQueue();
+    squadJoin(*npc);
+    npc->resumeAiRoutine();
+    aiNpcPtr->enterWorld(*npc,*pl,w);
+    Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" came to ",w.name()," with hero");
+    }
+  squadArrive();
+  }
+
+void GameScript::tickSquadFollow(Npc& player, uint64_t now) {
+  const auto hp     = player.position();
+  const bool ground = !player.isInAir() && !player.isFalling() && !player.isSwim() && !player.isDive() &&
+                      player.interactive()==nullptr;
+
+  // Скорость и след героя; рывок больше 15 м за такт - перенос или другой мир: след заново
+  Tempest::Vec3 vel;
+  if(squadHeroAt!=0 && now>squadHeroAt)
+    vel = (hp-squadHeroLast)*(1000.f/float(now-squadHeroAt));
+  if(!squadTrail.empty() && qDistXZ(squadTrail.back(),hp)>1500.f*1500.f) {
+    squadTrail.clear();
+    vel = Tempest::Vec3();
+    }
+  vel.y          = 0;
+  squadHeroLast  = hp;
+  squadHeroAt    = now;
+  if(ground && (squadTrail.empty() || qDistXZ(squadTrail.back(),hp)>=150.f*150.f)) {
+    squadTrail.push_back(hp);
+    if(squadTrail.size()>64)
+      squadTrail.erase(squadTrail.begin());
+    }
+  const float speed = vel.length();
+
+  // Куда идёт герой: по следу (2 м назад); стоит - прежнее направление, иначе - куда смотрит
+  for(size_t i=squadTrail.size(); i>0; --i) {
+    auto d = hp-squadTrail[i-1];
+    d.y = 0;
+    if(d.length()>=200.f) {
+      squadDir = Tempest::Vec3::normalize(d);
+      break;
+      }
+    }
+  if(squadDir.length()<0.5f) {
+    const float a = player.rotationRad();
+    squadDir = Tempest::Vec3(std::cos(a),0.f,std::sin(a));
+    }
+  const Tempest::Vec3 back  = -squadDir;
+  const Tempest::Vec3 right = Tempest::Vec3(-squadDir.z,0.f,squadDir.x);
+
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  const int32_t aivDist = scriptConst("AIV_FOLLOWDIST",80);
+  size_t k = 0;
+  for(auto npc:squadTmp) {
+    auto& fs = npc->companionFollow;
+    // Почему отряд его сейчас не ведёт - в журнал, не чаще раза в 10 с на каждого
+    auto notLed = [&](const char* why) {
+      if(now<fs.logAt)
+        return;
+      fs.logAt = now+10000;
+      Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" not led: ",why," (state ",npc->stateName(),")");
+      };
+    if(!npc->hasRoutineState(zsFollow))
+      continue; // ждёт
+    const size_t slot = std::min<size_t>(k++, std::size(SlotBack)-1);
+    const auto   np   = npc->position();
+    if(fs.movedAt==0 || qDistXZ(np,fs.lastPos)>70.f*70.f) {
+      fs.lastPos = np;
+      fs.movedAt = now;
+      }
+    // Свой ход - только в состоянии следования: бой, разговор, лечение, без сознания, дело на привале - не трогаем
+    if(npc->isDown() || !npc->isInState(zsFollow) || npc->companionIdle.act!=0 || now<fs.holdTo) {
+      notLed(npc->isDown() ? "down" : !npc->isInState(zsFollow) ? "not in ZS_FOLLOW_PLAYER" :
+             npc->companionIdle.act!=0 ? "rest activity" : "busy with an errand");
+      fs.driving  = false;
+      fs.movedAt  = now;
+      fs.hiddenAt = 0;
+      continue;
+      }
+    // Сидит на скамье (дело на привале кончилось) - сначала встать: цель движения раньше очереди не дала бы
+    if(npc->interactive()!=nullptr) {
+      if(npc->isAiQueueEmpty())
+        npc->aiPush(AiQueue::aiUseMob("",-1));
+      fs.driving = false;
+      fs.movedAt = now;
+      continue;
+      }
+    // Скрипт ведёт к герою, только если отстал дальше 8 м - ближе держим строй сами
+    if(aivDist>=0 && uint32_t(aivDist)<zenkit::INpc::aivar_count)
+      npc->handle().aivar[size_t(aivDist)] = 800;
+
+    const float dHero = std::sqrt(qDistXZ(np,hp));
+    const bool  see   = npc->canRayHitPoint(hp+Tempest::Vec3(0.f,100.f,0.f),true,2000.f);
+    if(see)
+      fs.hiddenAt = 0;
+    else if(fs.hiddenAt==0)
+      fs.hiddenAt = now;
+
+    // Место в строю; не видно от героя (стена, дерево) - место на следе, цепочкой через 1,1 м
+    Tempest::Vec3 goal = hp + back*SlotBack[slot] + right*SlotSide[slot];
+    if(!player.canRayHitPoint(goal+Tempest::Vec3(0.f,60.f,0.f),true,1000.f)) {
+      if(!squadTrailBehind(150.f+110.f*float(slot),goal))
+        goal = hp;
+      }
+    const float dGoal = std::sqrt(qDistXZ(np,goal));
+    if(dGoal<=250.f)
+      fs.movedAt = now; // идти некуда - не «застрял», сколько бы ни стоял
+
+    // Отстал, потерялся, застрял - на след героя за его спиной
+    if(ground && now>=fs.teleAt) {
+      const char* why = nullptr;
+      if(dHero>3500.f)
+        why = "far";
+      else if(fs.hiddenAt!=0 && now-fs.hiddenAt>8000 && dHero>1200.f)
+        why = "lost";
+      else if(dHero>600.f && dGoal>250.f && now-fs.movedAt>6000)
+        why = "stuck";
+      if(why!=nullptr) {
+        squadTeleport(*npc,player,slot,now,why);
+        continue;
+        }
+      }
+
+    // На месте и герой стоит - стоять (повернуться к герою - дело скрипта)
+    if(dGoal<=50.f && speed<50.f) {
+      if(fs.driving && npc->isGoingToPos())
+        npc->clearAiQueue();
+      fs.driving = false;
+      continue;
+      }
+
+    // Цель видна - прямо к ней (с упреждением по ходу героя); нет - по следу; нет следа - по точкам пути
+    Tempest::Vec3 to;
+    if(npc->canRayHitPoint(goal+Tempest::Vec3(0.f,60.f,0.f),true,2000.f)) {
+      to = goal + vel*0.3f;
+      }
+    else if(auto tp = squadTrailVisible(*npc,slot)) {
+      to = *tp;
+      }
+    else {
+      if(now>=fs.wayAt) {
+        fs.wayAt = now+4000;
+        if(auto wp = world().findWayPoint(hp)) {
+          npc->clearAiQueue();
+          npc->setWalkMode(WalkBit::WM_Run);
+          npc->aiPush(AiQueue::aiGoToPoint(*wp));
+          fs.driving = true;
+          }
+        }
+      continue;
+      }
+    if(!fs.driving)
+      npc->clearAiQueue(); // убрать AI_GotoNpc скрипта - он по прямой
+    // Далеко или герой бежит - бегом, у места и герой идёт шагом - шагом; между - как было (без дёрганья)
+    bool run = (npc->walkMode()&WalkBit::WM_Walk)!=WalkBit::WM_Walk;
+    if(dGoal>350.f || speed>250.f)
+      run = true;
+    else if(dGoal<250.f && speed<200.f)
+      run = false;
+    npc->setWalkMode(run ? WalkBit::WM_Run : WalkBit::WM_Walk);
+    npc->goToPos(to);
+    fs.driving = true;
+    }
+  }
+
+void GameScript::tickSquad() {
+  if(Gothic::inst().version().game!=2)
+    return;
+  auto& w  = world();
+  auto* pl = w.player();
+  if(pl==nullptr)
+    return;
+  const uint64_t now = tickCount();
+  if(now<squadTickTime)
+    return;
+  squadTickTime = now+400;
+
+  squadMembers(squadTmp);
+  if(squadTmp.size()!=squadLogged) {
+    // Кто в отряде - в журнал при каждой перемене: видно, признал ли отряд пошедшего с героем
+    squadLogged = squadTmp.size();
+    std::string names;
+    for(auto npc:squadTmp)
+      names += std::string(names.empty() ? "" : ", ")+"\""+std::string(npc->displayName())+"\""+
+               (isAmbient(npc->handle()) ? "" : " (по своей воле)");
+    Tempest::Log::i("[g2m] squad: members=",int(squadTmp.size())," ",names);
+    }
+  squadMarks.erase(std::remove_if(squadMarks.begin(),squadMarks.end(),[now](const SquadMark& m){ return m.until<=now; }),
+                   squadMarks.end());
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  for(auto npc:squadTmp) {
+    if(npc->isDown())
+      continue;
+    companionForgive(*npc,*pl);
+    tickSquadHeal(*npc,now);
+    if(isPassive(*npc)) {
+      // Сам не начинает: ни врагов вокруг, ни чужих драк. Перцепции заново включает каждое
+      // новое состояние распорядка - поэтому каждый раз
+      npc->setPerceptionDisable(PERC_ASSESSENEMY);
+      npc->setPerceptionDisable(PERC_ASSESSFIGHTSOUND);
+      continue;
+      }
+    if(npc->isAttack() || npc->isTalk())
+      continue;
+    const bool following = npc->hasRoutineState(zsFollow);
+    if(auto enemy = squadEnemy(*npc,*pl,following,now)) {
+      const int32_t ar = attackReason(*npc,*enemy);
+      Tempest::Log::i("[g2m] squad: \"",npc->displayName(),"\" defends against \"",enemy->displayName(),"\" ar=",ar);
+      invokeAttack(*npc,*enemy,ar);
+      }
+    }
+  tickSquadFollow(*pl,now);
+  tickSquadIdle(*pl,now);
+  }
+
+void GameScript::squadOrder(SquadOrder ord, Npc* target) {
+  auto* pl = world().player();
+  if(pl==nullptr)
+    return;
+  std::vector<Npc*> sq;
+  squadMembers(sq);
+  if(sq.empty())
+    return;
+
+  const size_t zsFollow = findSymbolIndex("ZS_FOLLOW_PLAYER");
+  const size_t zsStand  = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+  // Отвечает голосом один - ближайший, а не хор
+  Npc* voice = nullptr;
+  for(auto npc:sq)
+    if(!npc->isDown() && (voice==nullptr || pl->qDistTo(*npc)<pl->qDistTo(*voice)))
+      voice = npc;
+
+  size_t done = 0;
+  for(auto npc:sq) {
+    if(npc->isDown() || npc->isTalk())
+      continue;
+    auto& h = npc->handle();
+    switch(ord) {
+      case SquadOrder::Follow: {
+        if(zsFollow==size_t(-1))
+          break;
+        auto wp = npc->currentTaPoint();
+        npc->setRoutineAllDay(zsFollow, wp!=nullptr ? std::string_view(wp->name) : std::string_view(h.wp));
+        // Бросить бой (и занятие на привале) и идти к герою
+        npc->clearAiQueue();
+        npc->setTarget(nullptr);
+        npc->resumeAiRoutine();
+        idleStop(*npc);
+        ++done;
+        break;
+        }
+      case SquadOrder::Wait: {
+        if(zsStand==size_t(-1))
+          break;
+        squadCamp(*npc);
+        if(!npc->isAttack()) {
+          npc->clearAiQueue();
+          npc->resumeAiRoutine();
+          npc->clearAiQueue(); // без «T_LGUARD_2_STAND» из конца прежнего состояния
+          idleStop(*npc);
+          // Лагерем: лицом к ближайшему товарищу
+          Npc* mate = nullptr;
+          for(auto o:sq)
+            if(o!=npc && !o->isDown() && (mate==nullptr || npc->qDistTo(*o)<npc->qDistTo(*mate)))
+              mate = o;
+          if(mate!=nullptr && npc->qDistTo(*mate)<800.f*800.f)
+            npc->aiPush(AiQueue::aiTurnToNpc(mate));
+          }
+        ++done;
+        break;
+        }
+      case SquadOrder::Attack: {
+        if(target==nullptr || target==npc || target->isDown() || isHired(*target) || target->isPlayer())
+          break;
+        invokeAttack(*npc,*target,attackReason(*npc,*target));
+        ++done;
+        break;
+        }
+      case SquadOrder::Passive: {
+        setStance(*npc,true);
+        npc->setPerceptionDisable(PERC_ASSESSENEMY);
+        npc->setPerceptionDisable(PERC_ASSESSFIGHTSOUND);
+        if(npc->isAttack()) {
+          // Начатый бой бросают
+          npc->clearAiQueue();
+          npc->setTarget(nullptr);
+          npc->resumeAiRoutine();
+          }
+        ++done;
+        break;
+        }
+      case SquadOrder::Defend: {
+        setStance(*npc,false);
+        // Состояние распорядка заново включит перцепции врагов и драк
+        if(!npc->isAttack()) {
+          npc->clearAiQueue();
+          npc->resumeAiRoutine();
+          idleStop(*npc);
+          }
+        ++done;
+        break;
+        }
+      }
+    }
+
+  if(done==0)
+    return;
+  if(voice!=nullptr && ord!=SquadOrder::Attack)
+    companionSay(*voice,*pl,"$ABS_GOOD");
+  static const char* names[] = {"follow", "wait", "attack", "passive", "defend"};
+  Tempest::Log::i("[g2m] squad: order=",names[int(ord)]," members=",int(done),
+                  target!=nullptr ? " target=" : "", target!=nullptr ? target->displayName() : "");
+  }
+
+void GameScript::squadCamp(Npc& npc) {
+  // «Ждать здесь» - лагерь там, где стоит: распорядок ZS_Stand_ArmsCrossed с точкой-меткой (такой точки нет -
+  // скрипт никуда не ведёт, а прежде все шли к одной ближайшей точке пути). Цикл распорядка в лагере молчит
+  // (Npc::isCompanionCamp), делами занимается отряд
+  const size_t zsStand = findSymbolIndex("ZS_STAND_ARMSCROSSED");
+  if(zsStand==size_t(-1))
+    return;
+  npc.setRoutineAllDay(zsStand, CompanionCamp);
+  npc.companionIdle.campPos = npc.position();
+  npc.companionIdle.campSet = true;
+  }
+
+// Привал: ждущие напарники и отряд рядом с долго стоящим героем заняты случайными делами - с долями
+// вероятности, без повторов подряд. Цикл распорядка на время занятия молчит (Npc::isCompanionIdle),
+// анимации и предметы - те же, что в распорядках игры. Любая перемена (бой, разговор, герой пошёл,
+// новый приказ) прерывает занятие: напарник встаёт, убирает предмет и оружие тем же движением, что
+// и скрипты (..._End).
+
+bool GameScript::idleAllowed(Npc& npc, Npc& player, bool heroIdle, bool& waiting) {
+  waiting = squadIsWaiting(npc);
+  if(npc.isDown() || npc.isAttack() || npc.isTalk() || npc.isSwim() || npc.isDive() || npc.isInWater())
+    return false;
+  if(npc.processPolicy()!=NpcProcessPolicy::AiNormal)
+    return false; // далеко от героя: его всё равно никто не видит
+  if(!npc.isInState(findSymbolIndex(waiting ? "ZS_STAND_ARMSCROSSED" : "ZS_FOLLOW_PLAYER")))
+    return false;
+  if(waiting)
+    return true;
+  return heroIdle && player.qDistTo(npc)<700.f*700.f;
+  }
+
+void GameScript::idlePose(Npc& npc) {
+  // Выйти из позы тем же движением, что и концы распорядков игры (ZS_Sit_Campfire_End, ZS_Sit_Bench_End...)
+  if(npc.interactive()!=nullptr)
+    npc.aiPush(AiQueue::aiUseMob("",-1));
+  else if(npc.isInAnim("S_SIT"))
+    npc.aiPush(AiQueue::aiPlayAnimBs("T_SIT_2_STAND",BS_STAND));
+  else if(npc.isInAnim("S_PEE"))
+    npc.aiPush(AiQueue::aiPlayAnim("T_PEE_2_STAND"));
+  else if(npc.isInAnim("S_LGUARD"))
+    npc.aiPush(AiQueue::aiPlayAnim("T_LGUARD_2_STAND"));
+  else if(npc.isInAnim("S_HGUARD"))
+    npc.aiPush(AiQueue::aiPlayAnim("T_HGUARD_2_STAND"));
+  }
+
+void GameScript::idleExit(Npc& npc) {
+  auto& st = npc.companionIdle;
+  if(st.act==IdleEat && st.item!=0)
+    npc.aiPush(AiQueue::aiPlayAnimBs("T_POTION_RANDOM_2",BS_ITEMINTERACT)); // вытереть рот
+  idlePose(npc);
+  if(st.item!=0)
+    npc.aiPush(AiQueue::aiUseItemToState(int32_t(st.item),-1));
+  if(npc.weaponState()!=WeaponState::NoWeapon)
+    npc.aiPush(AiQueue::aiRemoveWeapon());
+  st.item = 0;
+  }
+
+void GameScript::idleStop(Npc& npc) {
+  // Новый приказ: распорядок уже перезапущен (resumeAiRoutine очищает очередь), выход из позы - перед ним
+  auto& st = npc.companionIdle;
+  if(st.act==IdleNone)
+    return;
+  idleExit(npc);
+  st.last = st.act;
+  st.act  = IdleNone;
+  st.peer = nullptr;
+  st.away = false;
+  st.next = 0;
+  npc.companionFollow.holdTo = tickCount()+1500; // дать встать, потом вести
+  }
+
+void GameScript::idleEnd(Npc& npc, bool graceful, uint64_t now) {
+  auto& st   = npc.companionIdle;
+  Npc*  peer = (st.act==IdleTalk ? st.peer : nullptr);
+  if(graceful) {
+    npc.clearAiQueue();
+    idleExit(npc);
+    npc.companionFollow.holdTo = now+1500; // дать встать и убрать предмет, потом вести
+    // Отдыхал на скамье или у костра - вернуться на своё место в лагере, когда встанет (цель движения
+    // раньше очереди не дала бы встать)
+    if(st.waiting && st.away && st.campSet)
+      st.goHome = true;
+    }
+  st.last   = st.act;
+  st.act    = IdleNone;
+  st.peer   = nullptr;
+  st.lead   = false;
+  st.away   = false;
+  st.item   = 0;
+  st.next   = now+2500+rand(5000);
+  st.propAt = now+3000;
+
+  // Собеседник заканчивает вместе с ним
+  if(peer!=nullptr) {
+    for(auto o:squadTmp) {
+      if(o!=peer || o->companionIdle.act!=IdleTalk || o->companionIdle.peer!=&npc)
+        continue;
+      idleEnd(*o,o->isInState(ScriptFn(o->companionIdle.state)),now);
+      break;
+      }
+    }
+  }
+
+size_t GameScript::idleProp(Npc& npc, std::string_view name) {
+  // Предмет для занятия (косяк, еда, лютня): если своего нет - создаётся и потом убирается
+  const size_t id = findSymbolIndex(name);
+  if(id==size_t(-1))
+    return 0;
+  if(npc.itemCount(id)==0) {
+    npc.addItem(id,1);
+    npc.companionIdle.prop = id;
+    }
+  return id;
+  }
+
+Npc* GameScript::idleNeighbour(Npc& npc, float dist, bool sitting) {
+  // Ближайший товарищ в dist см; sitting - только сидящий (на земле или на скамье)
+  Npc*  ret  = nullptr;
+  float best = dist*dist;
+  for(auto o:squadTmp) {
+    if(o==&npc || o->isDown())
+      continue;
+    if(sitting && o->companionIdle.act!=IdleSit && o->companionIdle.act!=IdleBench)
+      continue;
+    const float qd = npc.qDistTo(*o);
+    if(qd<best) {
+      ret  = o;
+      best = qd;
+      }
+    }
+  return ret;
+  }
+
+void GameScript::idleDropProp(Npc& npc) {
+  auto& st = npc.companionIdle;
+  if(st.prop==0)
+    return;
+  if(npc.itemCount(st.prop)>0)
+    npc.delItem(st.prop,1);
+  st.prop = 0;
+  }
+
+const WayPoint* GameScript::idleAside(Npc& npc, Npc& player, bool waiting) {
+  // В сторонку: точка пути в 4-10 м от напарника, не ближе 5 м к герою; на отдыхе рядом с героем -
+  // не дальше 9 м от него, чтобы не отстать
+  const auto pos  = npc.position();
+  const auto ppos = player.position();
+  return world().findWayPoint(pos,[&](const WayPoint& wp) {
+    const auto  p = wp.position();
+    const float d = (p-pos).quadLength();
+    if(d<400.f*400.f || d>1000.f*1000.f || std::abs(p.y-pos.y)>200.f)
+      return false;
+    const float dp = (p-ppos).quadLength();
+    if(dp<500.f*500.f || (!waiting && dp>900.f*900.f))
+      return false;
+    return npc.canRayHitPoint(p+Tempest::Vec3(0.f,50.f,0.f));
+    });
+  }
+
+std::string GameScript::smalltalkSvm(Npc& npc) {
+  // Как B_Say_Smalltalk: общие реплики 01-24, у святош свои 28-30, у наёмников и бандитов - 25-27
+  const int32_t g = int32_t(npc.guild());
+  uint32_t      n = 1+rand(24);
+  if(rand(6)==0) {
+    if(g==scriptConst("GIL_NOV",5) || g==scriptConst("GIL_PAL",1) || g==scriptConst("GIL_KDF",4))
+      n = 28+rand(3);
+    else if(g==scriptConst("GIL_BDT",9) || g==scriptConst("GIL_SLD",7) || g==scriptConst("GIL_DJG",6) ||
+            g==scriptConst("GIL_PIR",13))
+      n = 25+rand(3);
+    }
+  char buf[24] = {};
+  std::snprintf(buf,sizeof(buf),"$SMALLTALK%02u",n);
+  return buf;
+  }
+
+void GameScript::idleBegin(Npc& npc, Npc& player, bool waiting, bool heroIdle, uint64_t now) {
+  auto& st = npc.companionIdle;
+  idleDropProp(npc);
+
+  // Собеседник: другой свободный напарник рядом и в том же положении (оба ждут или оба отдыхают)
+  Npc* peer = nullptr;
+  for(auto o:squadTmp) {
+    bool ow = false;
+    if(o==&npc || o->companionIdle.act!=IdleNone || !idleAllowed(*o,player,heroIdle,ow) || ow!=waiting)
+      continue;
+    if(npc.qDistTo(*o)>800.f*800.f || !o->isAiQueueEmpty() || o->isAiBusy())
+      continue;
+    peer = o;
+    break;
+    }
+
+  const int32_t gil   = int32_t(npc.guild());
+  const bool    mage  = gil==scriptConst("GIL_NOV",5) || gil==scriptConst("GIL_KDF",4) || gil==scriptConst("GIL_KDW",14);
+  Item*         melee = npc.currentMeleeWeapon();
+  // Махать мечом - только если никого нет в 2 м (в строю и в лагере стоят тесно)
+  const bool    room  = idleNeighbour(npc,200.f,false)==nullptr;
+  // Скамья или стул рядом (ждущий - до 8 м, на отдыхе у героя - до 5 м)
+  const float   benchDist = waiting ? 800.f : 500.f;
+  std::string_view bench;
+  float            benchQd = benchDist*benchDist;
+  for(std::string_view scheme:{"BENCH","CHAIR"}) {
+    auto m = world().availableMob(npc,scheme);
+    if(m!=nullptr && npc.qDistTo(*m)<benchQd) {
+      bench   = scheme;
+      benchQd = npc.qDistTo(*m);
+      }
+    }
+
+  // Доли вероятности
+  struct Choice { uint8_t act; uint32_t w; };
+  Choice   list[IdleCount] = {};
+  size_t   cnt = 0;
+  uint32_t sum = 0;
+  auto add = [&](uint8_t act, uint32_t w) {
+    if(w==0 || act==st.last)
+      return;
+    list[cnt++] = {act,w};
+    sum += w;
+    };
+  // Лагерь: больше сидят и беседуют, никуда не уходят (разве что сесть на скамью рядом). На отдыхе у героя -
+  // разнообразнее и можно отойти пописать. Танцев и молитв нет - выглядели несуразно
+  add(IdleArms,    waiting ? 5u : 7u);
+  add(IdleGuard,   waiting ? 3u : 5u);
+  add(IdleLook,    waiting ? 3u : 4u);
+  add(IdleSmoke,   7);
+  add(IdleEat,     6);
+  add(IdleApple,   waiting ? 4u : 5u);
+  add(IdleDrink,   waiting ? 6u : 5u);
+  add(IdleLute,    waiting ? 4u : 3u);
+  add(IdleSword,   room && melee!=nullptr && isOneHanded(*melee) ? (waiting ? 3u : 4u) : 0u);
+  add(IdleInspect, room && melee!=nullptr ? (waiting ? 3u : 4u) : 0u);
+  add(IdleMagic,   mage ? (waiting ? 4u : 5u) : 0u);
+  add(IdleSit,     waiting ? 14u : 8u);
+  add(IdleBench,   !bench.empty() ? (waiting ? 12u : 6u) : 0u);
+  add(IdlePee,     waiting ? 0u : 3u);
+  add(IdleTalk,    peer!=nullptr ? (waiting ? 18u : 14u) : 0u);
+  if(sum==0)
+    return;
+  uint32_t r   = rand(sum);
+  uint8_t  act = list[0].act;
+  for(size_t i=0; i<cnt; ++i) {
+    if(r<list[i].w) {
+      act = list[i].act;
+      break;
+      }
+    r -= list[i].w;
+    }
+
+  auto during = [this](uint64_t from, uint64_t to) {
+    return from+rand(uint32_t(to-from));
+    };
+
+  const size_t zsState = findSymbolIndex(waiting ? "ZS_STAND_ARMSCROSSED" : "ZS_FOLLOW_PLAYER");
+  st.act     = act;
+  st.state   = zsState;
+  st.waiting = waiting;
+  st.item    = 0;
+  st.away    = false;
+  st.lead    = false;
+  st.peer    = nullptr;
+  st.until   = now+during(15000,30000);
+
+  npc.clearAiQueue();
+  idlePose(npc);
+  switch(act) {
+    case IdleArms:
+      npc.aiPush(AiQueue::aiPlayAnim("T_STAND_2_LGUARD"));
+      break;
+    case IdleGuard:
+      npc.aiPush(AiQueue::aiPlayAnim("T_STAND_2_HGUARD"));
+      break;
+    case IdleLook:
+      npc.aiPush(AiQueue::aiPlayAnim("T_SEARCH"));
+      npc.aiPush(AiQueue::aiWait(1500));
+      npc.aiPush(AiQueue::aiPlayAnim("R_SCRATCHHEAD"));
+      st.until = now+during(7000,10000);
+      break;
+    case IdleSmoke:
+      st.item  = idleProp(npc,"ITMI_JOINT");
+      st.until = now+during(20000,40000);
+      break;
+    case IdleEat: {
+      static const char* food[] = {"ITFO_APPLE", "ITFO_CHEESE", "ITFO_BACON", "ITFO_BREAD", "ITFOMUTTON"};
+      st.item = idleProp(npc,food[rand(uint32_t(std::size(food)))]);
+      break;
+      }
+    case IdleApple:
+      st.item = idleProp(npc,"ITFO_APPLE");
+      break;
+    case IdleDrink:
+      st.item = idleProp(npc,rand(2)==0 ? "ITFO_BOOZE" : "ITFO_WINE");
+      break;
+    case IdleLute:
+      st.item  = idleProp(npc,"ITMI_LUTE");
+      st.until = now+during(20000,40000);
+      break;
+    case IdleSword:
+    case IdleInspect:
+      npc.aiPush(AiQueue::aiReadyMeleeWeapon());
+      if(act==IdleInspect) {
+        // Подержать оружие перед глазами; если такой анимации нет - просто постоит с ним
+        npc.aiPush(AiQueue::aiPlayAnim(isOneHanded(*melee) ? "T_1HSINSPECT" : "T_2HSINSPECT"));
+        npc.aiPush(AiQueue::aiWait(2500));
+        st.until = now+during(8000,11000);
+        }
+      break;
+    case IdleMagic:
+      break;
+    case IdleSit: {
+      // Ждущий садится у костра, если он в 8 м; иначе - на землю там, где стоит
+      const WayPoint* fp = waiting ? world().findFreePoint(npc,"CAMPFIRE") : nullptr;
+      if(fp!=nullptr && npc.qDistTo(fp)<800.f*800.f) {
+        npc.aiPush(AiQueue::aiSetWalkMode(WalkBit::WM_Walk));
+        npc.aiPush(AiQueue::aiGoToPoint(*fp));
+        npc.aiPush(AiQueue::aiAlignToFp());
+        st.away = true;
+        }
+      npc.aiPush(AiQueue::aiPlayAnimBs("T_STAND_2_SIT",BS_SIT));
+      st.until = now+(waiting ? during(40000,90000) : during(25000,50000));
+      break;
+      }
+    case IdleBench:
+      // Как ZS_Sit_Bench: AI_UseMob сам подведёт к ближайшей свободной и усадит
+      npc.aiPush(AiQueue::aiSetWalkMode(WalkBit::WM_Walk));
+      npc.aiPush(AiQueue::aiUseMob(bench,1));
+      st.away  = true;
+      st.until = now+(waiting ? during(40000,80000) : during(25000,50000));
+      break;
+    case IdlePee: {
+      if(auto wp = idleAside(npc,player,waiting)) {
+        npc.aiPush(AiQueue::aiSetWalkMode(WalkBit::WM_Walk));
+        npc.aiPush(AiQueue::aiGoToPoint(*wp));
+        st.away = true;
+        }
+      npc.aiPush(AiQueue::aiTurnAway(&player));
+      npc.aiPush(AiQueue::aiPlayAnim("T_STAND_2_PEE"));
+      st.until = now+(st.away ? during(18000,24000) : during(9000,13000));
+      break;
+      }
+    case IdleTalk: {
+      auto& ps   = peer->companionIdle;
+      st.peer    = peer;
+      st.lead    = true;
+      st.turn    = (rand(2)==0);
+      st.lines   = uint8_t(waiting ? 5+rand(6) : 4+rand(5));
+      st.lineAt  = 0;
+      st.until   = now+70000;
+      ps.act     = IdleTalk;
+      ps.state   = zsState;
+      ps.waiting = waiting;
+      ps.item    = 0;
+      ps.away    = false;
+      ps.lead    = false;
+      ps.peer    = &npc;
+      ps.until   = st.until;
+      peer->clearAiQueue();
+      idlePose(*peer);
+      peer->aiPush(AiQueue::aiTurnToNpc(&npc));
+      npc.aiPush(AiQueue::aiTurnToNpc(peer));
+      break;
+      }
+    default:
+      break;
+    }
+  if(st.item!=0)
+    npc.aiPush(AiQueue::aiUseItemToState(int32_t(st.item),act==IdleLute ? 1 : 0));
+  if(act==IdleApple)
+    npc.aiPush(AiQueue::aiPlayAnimBs("T_FOOD_RANDOM_2",BS_ITEMINTERACT));
+
+  static const char* names[] = {"none", "arms", "guard", "look", "smoke", "eat", "apple", "drink", "lute",
+                                "sword", "inspect", "magic", "sit", "bench", "pee", "talk"};
+  Tempest::Log::i("[g2m] squad: \"",npc.displayName(),"\" idle=",names[act],
+                  peer!=nullptr && act==IdleTalk ? " with " : "", peer!=nullptr && act==IdleTalk ? peer->displayName() : "");
+  }
+
+void GameScript::idlePulse(Npc& npc) {
+  // Очередное движение занятия, когда прошлое доиграно (как циклы распорядков: раз в несколько секунд)
+  auto& st   = npc.companionIdle;
+  auto  wait = [&](uint32_t from, uint32_t to) {
+    npc.aiPush(AiQueue::aiWait(uint64_t(from+rand(to-from))));
+    };
+  switch(st.act) {
+    case IdleArms: {
+      static const char* ani[] = {"T_LGUARD_SCRATCH", "T_LGUARD_STRETCH", "T_LGUARD_CHANGELEG"};
+      if(rand(2)==0)
+        npc.aiPush(AiQueue::aiPlayAnim(ani[rand(3)]));
+      wait(4000,8000);
+      break;
+      }
+    case IdleGuard:
+      if(rand(3)==0)
+        npc.aiPush(AiQueue::aiPlayAnim("T_HGUARD_LOOKAROUND"));
+      wait(4000,8000);
+      break;
+    case IdleSmoke:
+      npc.aiPush(AiQueue::aiPlayAnimBs("T_JOINT_RANDOM_1",BS_ITEMINTERACT));
+      wait(4000,8000);
+      break;
+    case IdleEat: {
+      // Откусить - своей анимацией для каждого вида еды (как ZS_Stand_Eating)
+      const char* ani = "T_FOODHUGE_RANDOM_1";
+      if(auto s = findSymbol(st.item)) {
+        if(s->name()=="ITFO_APPLE")
+          ani = "T_FOOD_RANDOM_1";
+        else if(s->name()=="ITFOMUTTON")
+          ani = "T_MEAT_RANDOM_1";
+        }
+      npc.aiPush(AiQueue::aiPlayAnimBs(ani,BS_ITEMINTERACT));
+      wait(4000,7000);
+      break;
+      }
+    case IdleApple:
+      npc.aiPush(AiQueue::aiPlayAnimBs(rand(10)<7 ? "T_FOOD_RANDOM_2" : "T_FOOD_RANDOM_1",BS_ITEMINTERACT));
+      wait(1500,4000);
+      break;
+    case IdleDrink: {
+      // Как ZS_Stand_Drinking: глотнуть; иногда посмотреть на бутылку или вытереть рот
+      const uint32_t r = rand(10);
+      if(r==0)
+        npc.aiPush(AiQueue::aiPlayAnimBs("T_POTION_RANDOM_3",BS_ITEMINTERACT));
+      npc.aiPush(AiQueue::aiPlayAnimBs("T_POTION_RANDOM_1",BS_ITEMINTERACT));
+      if(r==1)
+        npc.aiPush(AiQueue::aiPlayAnimBs("T_POTION_RANDOM_2",BS_ITEMINTERACT));
+      wait(5000,8000);
+      break;
+      }
+    case IdleSword:
+      npc.aiPush(AiQueue::aiPlayAnim("T_1HSFREE"));
+      wait(500,2500);
+      break;
+    case IdleMagic: {
+      static const char* ani[] = {"T_PRACTICEMAGIC", "T_PRACTICEMAGIC2", "T_PRACTICEMAGIC3", "T_PRACTICEMAGIC4", "R_SCRATCHHEAD"};
+      npc.aiPush(AiQueue::aiPlayAnim(ani[rand(uint32_t(std::size(ani)))]));
+      wait(4000,7000);
+      break;
+      }
+    case IdleSit:
+    case IdleBench: {
+      // Сидя - перекинуться словом с соседом, который тоже сидит рядом (как у костра; сидя - без жестов и
+      // поворотов)
+      if(rand(3)==0) {
+        auto nb = idleNeighbour(npc,500.f,true);
+        if(nb!=nullptr && !npc.haveOutput() && !nb->haveOutput())
+          companionSay(npc,*nb,smalltalkSvm(npc));
+        }
+      wait(5000,11000);
+      break;
+      }
+    default:
+      // Писает, играет на лютне, осматривается: поза держится сама
+      break;
+    }
+  }
+
+void GameScript::idleTalk(Npc& npc, uint64_t now) {
+  auto& st   = npc.companionIdle;
+  Npc*  peer = nullptr;
+  for(auto o:squadTmp)
+    if(o==st.peer)
+      peer = o;
+  if(peer==nullptr || peer->companionIdle.act!=IdleTalk || peer->companionIdle.peer!=&npc) {
+    idleEnd(npc,true,now);
+    return;
+    }
+  if(!st.lead)
+    return; // беседу ведёт собеседник
+  if(now>=st.until || st.lines==0) {
+    idleEnd(npc,true,now);
+    return;
+    }
+  // По очереди, как ZS_Smalltalk: реплика - пауза - ответ
+  if(npc.haveOutput() || peer->haveOutput() || !npc.isAiQueueEmpty() || !peer->isAiQueueEmpty() ||
+     npc.isAiBusy() || peer->isAiBusy()) {
+    st.lineAt = 0;
+    return;
+    }
+  if(st.lineAt==0) {
+    st.lineAt = now+300+rand(1200);
+    return;
+    }
+  if(now<st.lineAt)
+    return;
+  st.lineAt = 0;
+  Npc& who  = st.turn ? npc   : *peer;
+  Npc& to   = st.turn ? *peer : npc;
+  st.turn   = !st.turn;
+  --st.lines;
+  who.aiPush(AiQueue::aiTurnToNpc(&to));
+  companionSay(who,to,smalltalkSvm(who));
+  if(rand(5)==0)
+    to.aiPush(AiQueue::aiPlayAnim("T_YES"));
+  }
+
+void GameScript::tickSquadIdle(Npc& player, uint64_t now) {
+  // Герой стоит на месте, не дерётся и оружие убрано - через HeroIdleDelay отряд отдыхает рядом
+  const auto pos = player.position();
+  if((pos-squadHeroPos).quadLength()>150.f*150.f || player.weaponState()!=WeaponState::NoWeapon ||
+     player.isDown() || squadInFight(player)) {
+    squadHeroPos   = pos;
+    squadHeroStill = now;
+    }
+  const bool heroIdle = (now>=squadHeroStill+HeroIdleDelay);
+
+  for(auto npc:squadTmp) {
+    auto& st      = npc->companionIdle;
+    bool  waiting = false;
+    const bool ok = idleAllowed(*npc,player,heroIdle,waiting);
+    if(st.act!=IdleNone) {
+      const bool same = npc->isInState(ScriptFn(st.state));
+      if(!ok || !same || st.waiting!=waiting) {
+        // Бой, разговор, новый приказ - состояние уже другое, оно всё убрало само. Герой пошёл -
+        // встать и догонять
+        idleEnd(*npc,same && !npc->isDown(),now);
+        continue;
+        }
+      if(st.act==IdleTalk) {
+        idleTalk(*npc,now);
+        continue;
+        }
+      if(now>=st.until) {
+        idleEnd(*npc,true,now);
+        continue;
+        }
+      if(npc->isAiQueueEmpty() && !npc->isAiBusy())
+        idlePulse(*npc);
+      continue;
+      }
+
+    // Созданный для занятия предмет (косяк, еда, лютня) убрать, когда руки уже свободны
+    if(now>=st.propAt && npc->isAiQueueEmpty() && !npc->isAiBusy())
+      idleDropProp(*npc);
+    // Лагерь: место запомнено при приказе; после загрузки - где стоит
+    if(waiting && !st.campSet) {
+      st.campPos = npc->position();
+      st.campSet = true;
+      }
+    // Встал со скамьи или от костра - вернуться на своё место
+    if(st.goHome && ok && npc->isAiQueueEmpty() && !npc->isAiBusy() && npc->interactive()==nullptr) {
+      st.goHome = false;
+      npc->setWalkMode(WalkBit::WM_Walk);
+      npc->goToPos(st.campPos);
+      continue;
+      }
+    if(!ok) {
+      st.next = 0;
+      continue;
+      }
+    if(st.next==0) {
+      // Первое занятие - вразнобой, а не всем отрядом сразу
+      st.next = now+1500+rand(6000);
+      continue;
+      }
+    if(now<st.next || !npc->isAiQueueEmpty() || npc->isAiBusy())
+      continue;
+    idleBegin(*npc,player,waiting,heroIdle,now);
+    }
+  }
