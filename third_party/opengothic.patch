+void AiNpc::setParty(Npc& npc, bool on) {
+  if(on) {
+    // Тем же кодом, что найм в диалоге (GameScript::squadJoin): дальше им ведёт отряд (tickSquad: строй, след
+    // героя, телепорт отставших, зелья, без смерти)
+    owner.squadJoin(npc);
+    return;
+    }
+  const int32_t aiv = owner.scriptConst("AIV_PARTYMEMBER",15);
+  if(aiv>=0 && uint32_t(aiv)<zenkit::INpc::aivar_count)
+    npc.handle().aivar[size_t(aiv)] = 0;
+  setActivity(npc,"ZS_STAND_ARMSCROSSED");
+  }
