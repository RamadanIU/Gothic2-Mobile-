+bool Npc::isCompanionErrand() const {
+  // Прежде цикл ZS_Follow_Player раз в секунду поворачивал напарника к герою (B_TurnToNpc), а дальше 8 м вёл назад:
+  // Геральт, посланный поговорить с жителем, говорил с ним, стоя к нему спиной, или уходил посреди беседы
+  // Только цикл следования: бой, лечение и разговор с героем идут своим чередом
+  return companionFollow.errand && owner.tickCount()<companionFollow.holdTo &&
+         aiState.funcIni.ptr==owner.script().findSymbolIndex("ZS_FOLLOW_PLAYER");
+  }
+
+bool Npc::isCompanionCamp() const {
+  // Лагерь «Ждать здесь»: распорядок ZS_Stand_ArmsCrossed с точкой-меткой - стоять там, где сказали, не
+  // уходить к точкам «STAND» и не скрещивать руки каждую минуту
+  return hnpc->wp==GameScript::CompanionCamp &&
+         aiState.funcIni.ptr==owner.script().findSymbolIndex("ZS_STAND_ARMSCROSSED");
+  }
