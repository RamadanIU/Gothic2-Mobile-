+// Gothic II Mobile: матрица -> поворот и сдвиг (обратное к mkMatrix: m[i][j] - элемент R[i][j] кватерниона)
+static zenkit::AnimationSample toSample(const Matrix4x4& m) {
+  zenkit::AnimationSample s = {};
+  float sx = Vec3(m.at(0,0),m.at(0,1),m.at(0,2)).length();
+  float sy = Vec3(m.at(1,0),m.at(1,1),m.at(1,2)).length();
+  float sz = Vec3(m.at(2,0),m.at(2,1),m.at(2,2)).length();
+  sx = sx>0 ? sx : 1.f;
+  sy = sy>0 ? sy : 1.f;
+  sz = sz>0 ? sz : 1.f;
+  auto r = [&](int i, int j) {
+    const float k = (i==0 ? sx : (i==1 ? sy : sz));
+    return m.at(i,j)/k;
+    };
+  const float tr = r(0,0)+r(1,1)+r(2,2);
+  float x=0, y=0, z=0, w=1;
+  if(tr>0.f) {
+    const float q = std::sqrt(tr+1.f)*2.f;
+    w = 0.25f*q;
+    x = (r(2,1)-r(1,2))/q;
+    y = (r(0,2)-r(2,0))/q;
+    z = (r(1,0)-r(0,1))/q;
+    }
+  else if(r(0,0)>r(1,1) && r(0,0)>r(2,2)) {
+    const float q = std::sqrt(1.f+r(0,0)-r(1,1)-r(2,2))*2.f;
+    w = (r(2,1)-r(1,2))/q;
+    x = 0.25f*q;
+    y = (r(0,1)+r(1,0))/q;
+    z = (r(0,2)+r(2,0))/q;
+    }
+  else if(r(1,1)>r(2,2)) {
+    const float q = std::sqrt(1.f+r(1,1)-r(0,0)-r(2,2))*2.f;
+    w = (r(0,2)-r(2,0))/q;
+    x = (r(0,1)+r(1,0))/q;
+    y = 0.25f*q;
+    z = (r(1,2)+r(2,1))/q;
+    }
+  else {
+    const float q = std::sqrt(1.f+r(2,2)-r(0,0)-r(1,1))*2.f;
+    w = (r(1,0)-r(0,1))/q;
+    x = (r(0,2)+r(2,0))/q;
+    y = (r(1,2)+r(2,1))/q;
+    z = 0.25f*q;
+    }
+  s.rotation   = zenkit::Quat(w,x,y,z);
+  s.position.x = m.at(3,0);
+  s.position.y = m.at(3,1);
+  s.position.z = m.at(3,2);
+  return s;
+  }
+
+void Pose::setRagdoll(const std::vector<uint8_t>& driven, const std::vector<uint16_t>& bones,
+                      const std::vector<Tempest::Matrix4x4>& local, float weight) {
+  if(ragActive) {
+    // живой упал (или умер) из активного регдолла: дальше - как у тряпичной куклы, поза момента падения - сейчас
+    ragActive = false;
+    ragBone.clear();
+    ragFrozen.clear();
+    }
+  if(ragFrozen.empty() && skeleton!=nullptr) {
+    // поза в момент падения: анимация смерти под куклой идёт дальше, а ключицы, пальцы, шея между
+    // суставами куклы не должны от неё двигаться - иначе плечо «отрывается» от груди
+    ragFrozen.resize(numBones);
+    for(size_t i=0; i<numBones; ++i)
+      ragFrozen[i] = hasSamples[i] ? base[i] : toSample(skeleton->nodes[i].tr);
+    }
+  if(ragBone.size()!=driven.size())
+    ragBone = driven;
+  if(ragLocal.size()<driven.size())
+    ragLocal.resize(driven.size());
+  for(size_t i=0; i<bones.size() && i<local.size(); ++i)
+    if(bones[i]<ragLocal.size())
+      ragLocal[bones[i]] = local[i];
+  ragWeight = std::clamp(weight,0.f,1.f);
+  ragDirty  = true;
+  }
+
+void Pose::clearRagdoll() {
+  if(ragWeight<=0.f && ragBone.empty() && !ragActive)
+    return;
+  ragBone.clear();
+  ragLocal.clear();
+  ragFrozen.clear();
+  ragMode.clear();
+  ragStance    = Stance();
+  ragActive    = false;
+  ragWeight    = 0;
+  ragDirty     = true;
+  needToUpdate = true;
+  }
+
+void Pose::setInjury(const Injury& inj) {
+  const bool same = inj.arm==injury.arm && inj.bone==injury.bone && inj.leg==injury.leg &&
+                    std::abs(inj.reach-injury.reach)<0.002f && std::abs(inj.limp-injury.limp)<0.002f &&
+                    std::abs(inj.hunch-injury.hunch)<0.002f && inj.local.x==injury.local.x && inj.local.y==injury.local.y &&
+                    std::abs(inj.pain-injury.pain)<0.002f && std::abs(inj.brace-injury.brace)<0.002f &&
+                    std::abs(inj.braceHit-injury.braceHit)<0.002f && inj.braceKind==injury.braceKind &&
+                    (inj.brace<=0.f || (inj.braceAt-injury.braceAt).length()<0.5f);
+  if(same)
+    return;
+  injury   = inj;
+  ragDirty = true;
+  }
+
+void Pose::setRagdollActive(const std::vector<uint8_t>& modes, const std::vector<uint16_t>& bones,
+                            const std::vector<Tempest::Matrix4x4>& rel, size_t root, float weight,
+                            const Stance& stance) {
+  if(skeleton==nullptr || modes.size()<numBones || root>=numBones)
+    return;
+  if(!ragActive) {
+    ragBone.clear();
+    ragFrozen.clear();
+    ragOrder.clear();
+    if(!skeleton->ordered)
+      boneOrder(ragOrder);
+    }
+  ragActive = true;
+  ragMode   = modes;
+  ragRoot   = root;
+  if(ragLocal.size()<numBones)
+    ragLocal.resize(numBones);
+  for(size_t i=0; i<bones.size() && i<rel.size(); ++i)
+    if(bones[i]<ragLocal.size())
+      ragLocal[bones[i]] = rel[i];
+  ragWeight = std::clamp(weight,0.f,1.f);
+  ragStance = stance;
+  ragDirty  = true;
+  }
+
+void Pose::boneOrder(std::vector<uint16_t>& out) const {
+  // от корней к концам: родитель всегда раньше потомка (для скелетов без упорядочения)
+  out.clear();
+  std::vector<size_t> stk(skeleton->rootNodes.rbegin(), skeleton->rootNodes.rend());
+  while(!stk.empty()) {
+    const size_t i = stk.back();
+    stk.pop_back();
+    if(i>=numBones)
+      continue;
+    out.push_back(uint16_t(i));
+    for(size_t c=numBones; c>0; --c)
+      if(skeleton->nodes[c-1].parent==i)
+        stk.push_back(c-1);
+    }
+  }
+
+void Pose::animChain(const Matrix4x4& mt, Matrix4x4* out, const std::vector<uint16_t>& order) const {
+  // поза одной анимации: локальные матрицы кадра по иерархии, как implMkSkeleton без регдолла
+  auto&        nodes = skeleton->nodes;
+  const size_t head  = skeleton->BIP01_HEAD;
+  auto one = [&](size_t i) {
+    const size_t parent = nodes[i].parent;
+    const auto   mat    = hasSamples[i] ? mkMatrix(base[i]) : nodes[i].tr;
+    out[i] = (parent<numBones) ? out[parent]*mat : mt*mat;
+    if(i==head && (headRotX!=0 || headRotY!=0)) {
+      out[i].rotateOY(headRotY);
+      out[i].rotateOX(headRotX);
+      }
+    };
+  if(skeleton->ordered) {
+    for(size_t i=0; i<numBones && i<nodes.size(); ++i)
+      one(i);
+    } else {
+    for(auto i:order)
+      one(i);
+    }
+  // Gothic II Mobile: раненое тело - и в позе, к которой тянется кукла
+  if(injRig!=nullptr && injury.isActive())
+    injRig->apply(injury,pos,out,numBones);
+  }
+
+void Pose::animPose(std::vector<Matrix4x4>& out) const {
+  out.resize(numBones);
+  if(skeleton==nullptr || numBones==0)
+    return;
+  Matrix4x4 m = pos;
+  m.translate(baseTranslation());
+  if(skeleton->ordered || !ragOrder.empty()) {
+    animChain(m,out.data(),ragOrder);
+    } else {
+    std::vector<uint16_t> order;
+    boneOrder(order);
+    animChain(m,out.data(),order);
+    }
+  }
+
+void Pose::implMkSkeletonActive(const Matrix4x4& mt) {
+  // Активный регдолл: сначала поза одной анимации (со слоем ран), затем таз и ноги - со стойкой поведения (сдвиг
+  // таза, IK ног к ступням шагов), корпус, голова и руки - физика относительно таза (бег, разворот, замах -
+  // анимация, отклик на удар - физика), кости под ними - от родителя
+  ragAnim.resize(numBones);
+  animChain(mt,ragAnim.data(),ragOrder);
+  ragLow = ragAnim;
+  if(injRig!=nullptr && ragStance.isActive())
+    injRig->applyStance(ragStance,pos,ragLow.data(),numBones);
+  ragUnder.assign(numBones,0);
+  auto&       nodes = skeleton->nodes;
+  const float w     = ragWeight;
+  auto one = [&](size_t i) {
+    const uint8_t md     = i<ragMode.size() ? ragMode[i] : 0;
+    const size_t  parent = nodes[i].parent;
+    if(md==3) {
+      ragUnder[i] = 1;
+      if(w<=0.f) {
+        tr[i] = ragLow[i];
+        return;
+        }
+      const Matrix4x4 target = ragLow[ragRoot]*ragLocal[i];
+      if(w>=1.f) {
+        tr[i] = target;
+        } else {
+        tr[i] = pos*mkMatrix(mix(toSample(ragPosInv*ragLow[i]),toSample(ragPosInv*target),w));
+        }
+      return;
+      }
+    if(md==2 || parent>=numBones || ragUnder[parent]==0) {
+      tr[i] = ragLow[i];
+      return;
+      }
+    ragUnder[i] = 1;
+    const auto mat = hasSamples[i] ? mkMatrix(base[i]) : nodes[i].tr;
+    tr[i] = tr[parent]*mat;
+    };
+  if(skeleton->ordered) {
+    for(size_t i=0; i<numBones && i<nodes.size(); ++i)
+      one(i);
+    } else {
+    for(auto i:ragOrder)
+      one(i);
+    }
+  }
+
+Matrix4x4 Pose::localOf(size_t i) const {
+  const auto& n = skeleton->nodes[i];
+  if(ragWeight<=0.f || i>=ragFrozen.size() || (i<ragBone.size() && ragBone[i]!=0))
+    return hasSamples[i] ? mkMatrix(base[i]) : n.tr;
+  if(ragWeight>=1.f)
+    return mkMatrix(ragFrozen[i]);
+  const auto anim = hasSamples[i] ? base[i] : toSample(n.tr);
+  return mkMatrix(mix(anim,ragFrozen[i],ragWeight));
+  }
+
+void Pose::applyRagdoll(size_t i) {
+  if(ragWeight>=1.f) {
+    tr[i] = pos*ragLocal[i];
+    return;
+    }
+  // смешивание в системе объекта: поворот - по дуге, сдвиг - по прямой
+  const auto a = toSample(ragPosInv*tr[i]);
+  const auto b = toSample(ragLocal[i]);
+  tr[i] = pos*mkMatrix(mix(a,b,ragWeight));
+  }
+
+void Pose::sampleObjectPose(const Skeleton& sk, const Animation::Sequence& sq, uint64_t time, std::vector<Tempest::Matrix4x4>& out) {
+  const auto&  nodes = sk.nodes;
+  const auto&  d     = *sq.data;
+  const size_t idSz  = d.nodeIndex.size();
+  out.resize(nodes.size());
+
+  std::vector<int32_t> sampleOf(nodes.size(),-1);
+  for(size_t i=0; i<idSz; ++i)
+    if(d.nodeIndex[i]<nodes.size())
+      sampleOf[d.nodeIndex[i]] = int32_t(i);
+
+  size_t frame = 0;
+  if(d.numFrames>0 && idSz>0 && d.samples.size()>=d.numFrames*idSz) {
+    frame = size_t(float(time)*d.fpsRate/1000.f);
+    frame = std::min<size_t>(frame, d.numFrames-1);
+    if(sq.reverse)
+      frame = d.numFrames-1-frame;
+    }
+
+  auto local = [&](size_t i) {
+    const int32_t id = sampleOf[i];
+    if(id<0 || d.samples.size()<(frame+1)*idSz)
+      return nodes[i].tr;
+    auto smp = d.samples[frame*idSz+size_t(id)];
+    if(nodes[i].parent==size_t(-1)) {
+      smp.position.x = 0;
+      smp.position.z = 0;
+      }
+    return mkMatrix(smp);
+    };
+
+  std::vector<uint8_t> done(nodes.size(),0);
+  for(size_t pass=0; pass<nodes.size(); ++pass) {
+    bool progress = false;
+    for(size_t i=0; i<nodes.size(); ++i) {
+      if(done[i])
+        continue;
+      const size_t p = nodes[i].parent;
+      if(p<nodes.size() && !done[p])
+        continue;
+      out[i]  = (p<nodes.size() ? out[p]*local(i) : local(i));
+      done[i] = 1;
+      progress = true;
+      }
+    if(!progress)
+      break;
+    }
+  }
+
+bool Pose::replaceLayer(const Animation::Sequence* sq, uint64_t tickCount) {
+  if(sq==nullptr)
+    return false;
+  for(auto& i:lay)
+    if(i.seq->layer==sq->layer) {
+      if((i.bs & BS_MAX)==(BS_ITEMINTERACT & BS_MAX)) {
+        i.bs      = BS_LIE;
+        itemUseSt = itemUseDestSt = 0;
+        }
+      if(i.seq==sq)
+        return true;
+      onRemoveLayer(i);
+      i.seq    = sq;
+      i.sAnim  = tickCount;
+      i.sBlend = 0;
+      i.comb   = 0;
+      onAddLayer(i);
+      return true;
+      }
+  addLayer(sq,BS_LIE,0,tickCount);
+  return true;
+  }
+
+void Pose::cancelItemState() {
+  size_t ret = 0;
+  for(size_t i=0; i<lay.size(); ++i) {
+    if((lay[i].bs & BS_MAX)==(BS_ITEMINTERACT & BS_MAX)) {
+      onRemoveLayer(lay[i]);
+      needToUpdate = true;
+      continue;
+      }
+    if(ret!=i)
+      lay[ret] = lay[i];
+    ret++;
+    }
+  lay.resize(ret);
+  itemUseSt     = 0;
+  itemUseDestSt = 0;
+  }
