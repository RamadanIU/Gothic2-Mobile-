+bool MainWindow::touchQuickSaveInfo(std::string& out) const {
+  const std::string slot = CommandLine::inst().saveFile("save_slot_0.sav");
+  if(!FileUtil::exists(TextCodec::toUtf16(slot)))
+    return false;
+  SaveGameHeader hdr;
+  try {
+    RFile     fin(slot);
+    Serialize reader(fin);
+    reader.setEntry("header");
+    reader.read(hdr);
+    }
+  catch(...) {
+    return false;
+    }
+  char buf[128] = {};
+  std::snprintf(buf,sizeof(buf),"День %d, %d:%02d  (записано %d.%02d в %d:%02d)",
+                int(hdr.wrldTime.day()),int(hdr.wrldTime.hour()),int(hdr.wrldTime.minute()),
+                int(hdr.pcTime.tm_mday),int(hdr.pcTime.tm_mon+1),int(hdr.pcTime.tm_hour),int(hdr.pcTime.tm_min));
+  out = buf;
+  return true;
+  }
