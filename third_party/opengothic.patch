+void AiNpc::leaveWorld(Npc& npc, Npc& hero) {
+  if(!isGeraltNpc(npc))
+    return;
+  hero.handle().aivar[AivHeroGeraltAway] = 1;
+  geralt      = nullptr;
+  geraltWorld = nullptr;
+  }
