+TouchInput::Ctl TouchInput::hitTest(Point p) const {
+  // Запас вокруг кнопки: палец крупнее нарисованного круга
+  const int slop = int(8*dp());
+  for(uint8_t i=C_Main; i<C_Count; ++i) {
+    const Ctl c = Ctl(i);
+    if(!isShown(c))
+      continue;
+    const auto b = buttonOf(c);
+    if(b.r>0) {
+      const int dx = p.x-b.c.x, dy = p.y-b.c.y, r = b.r+slop;
+      if(dx*dx+dy*dy<=r*r)
+        return c;
+      } else {
+      const auto& r = b.rect;
+      if(Rect(r.x-slop, r.y-slop, r.w+2*slop, r.h+2*slop).contains(p))
+        return c;
+      }
+    }
+  return C_None;
+  }
