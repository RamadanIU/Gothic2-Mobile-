+
+// Gothic II Mobile: рисованные значки и подложки сенсорных кнопок.
+// Всё рисуется на процессоре со сглаживанием (поле расстояний) один раз под нужный размер в пикселях
+// и хранится текстурой: значки белые (цвет задаёт кисть), подложки - тёмная кожа с кольцом старой бронзы.
+class TouchIcons {
+  public:
+    enum Icon : uint8_t {
+      I_Sword,
+      I_Fist,
+      I_Bow,
+      I_Crossbow,
+      I_Rune,
+      I_Scroll,
+      I_Talk,
+      I_Hand,
+      I_Use,
+      I_Sack,
+      I_Shield,
+      I_Jump,
+      I_Weapons,
+      I_Potion,
+      I_Auto,
+      I_Gather,
+      I_Squad,
+      I_Sneak,
+      I_Menu,
+      I_Map,
+      I_Log,
+      I_Hero,
+      I_Up,
+      I_Down,
+      I_Left,
+      I_Right,
+      I_Ok,
+      I_Back,
+      I_Skip,
+      I_TakeAll,
+      I_Follow,
+      I_Wait,
+      I_Target,
+      I_Passive,
+      I_Finish,
+      I_Stop,
+      I_Dot,
+      I_Save,
+      I_Load,
+      I_Travel,
+      I_Run,
+      I_Teleport,
+      I_City,
+      I_Pin,
+      I_Camera,
+      I_CamFar,
+      I_CamBird,
+      I_CamSide,
+      I_Eye,
+      I_Film,
+      I_BoxOn,
+      I_BoxOff,
+      I_Mic,
+      I_Count
+      };
+
+    const Tempest::Texture2d& icon (Icon i, int size);
+    // Круглая подложка кнопки диаметром size
+    const Tempest::Texture2d& disc (int size);
+    // Мягкое свечение вокруг круга диаметром size; холст в 1,3 раза больше круга. Цвет умножен на
+    // прозрачность - рисовать только со сложением (Painter::Add), силу задаёт цвет кисти
+    const Tempest::Texture2d& glow (int size);
+    // Подложка-«пилюля» w×h для кнопок с подписью
+    const Tempest::Texture2d& pill (int w, int h);
+    // Тень значка: тот же значок, размытый
+    const Tempest::Texture2d& shadow(Icon i, int size);
+
+  private:
+    using Cache = std::unordered_map<uint64_t,std::unique_ptr<Tempest::Texture2d>>;
+    Cache cache;
+
+    const Tempest::Texture2d& cached(uint64_t key, const std::function<Tempest::Texture2d()>& make);
+  };
