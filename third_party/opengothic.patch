+bool Npc::ragdollActiveAllowed() const {
+  // Живой откликается телом на удары рядом с героем или камерой: на ногах, не в воде, не за станком
+  if(!Gothic::options().ragdollActive || isDown())
+    return false;
+  if(interactive()!=nullptr || isSwim() || isDive() || mvAlgo.isClimb() || mvAlgo.isInAir() || mvAlgo.isFalling())
+    return false;
+  if(!ragdollAllowed())
+    return false;
+  float dist = 0;
+  bool  keep = false;
+  return ragdollViewDistance(dist,keep) && dist<=Ragdoll::ActiveDist;
+  }
