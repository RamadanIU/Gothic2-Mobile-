+void TouchInput::openWheel(Wheel wh, int finger) {
+  auto pl = Gothic::inst().player();
+  if(pl==nullptr)
+    return;
+  wheelItems.clear();
+  wheelSel   = -1;
+  wheelOwner = finger;
+  wheel      = wh;
+
+  if(wh==Wheel::Weapon) {
+    const auto ws = pl->weaponState();
+    auto&      in = pl->inventory();
+    WheelItem melee;
+    melee.action = 1;
+    if(auto it = pl->currentMeleeWeapon()) {
+      melee.icon  = TouchIcons::I_Sword;
+      melee.label = std::string(it->displayName());
+      } else {
+      melee.icon  = TouchIcons::I_Fist;
+      melee.label = toCp1251("Кулаки");
+      }
+    melee.current = (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+    wheelItems.push_back(melee);
+
+    if(auto it = pl->currentRangedWeapon()) {
+      WheelItem rng;
+      rng.action  = 2;
+      rng.icon    = it->isCrossbow() ? TouchIcons::I_Crossbow : TouchIcons::I_Bow;
+      rng.label   = std::string(it->displayName());
+      rng.current = (ws==WeaponState::Bow || ws==WeaponState::CBow);
+      wheelItems.push_back(rng);
+      }
+    for(uint8_t i=0; i<8; ++i) {
+      auto spl = in.currentSpell(i);
+      if(spl==nullptr)
+        continue;
+      WheelItem sp;
+      sp.action  = uint8_t(3+i);
+      sp.icon    = spl->isRune() ? TouchIcons::I_Rune : TouchIcons::I_Scroll;
+      sp.label   = std::string(spl->displayName());
+      sp.current = (ws==WeaponState::Mage && in.currentSpellSlot()==3+i);
+      wheelItems.push_back(sp);
+      }
+    if(ws!=WeaponState::NoWeapon) {
+      WheelItem off;
+      off.action = 0;
+      off.icon   = TouchIcons::I_Hand;
+      off.label  = toCp1251("Убрать");
+      wheelItems.push_back(off);
+      }
+    }
+  else if(wh==Wheel::Squad) {
+    auto w = Gothic::inst().world();
+    bool waiting = !squad.empty(), passive = false;
+    for(auto npc:squad) {
+      waiting = waiting && w->script().squadIsWaiting(*npc);
+      passive = passive || w->script().isPassive(*npc);
+      }
+    WheelItem fl;
+    fl.action  = uint8_t(GameScript::SquadOrder::Follow);
+    fl.icon    = TouchIcons::I_Follow;
+    fl.label   = toCp1251("Ко мне");
+    fl.current = !waiting;
+    wheelItems.push_back(fl);
+
+    WheelItem at;
+    at.action  = uint8_t(GameScript::SquadOrder::Attack);
+    at.icon    = TouchIcons::I_Target;
+    auto tg    = squadTarget();
+    at.enabled = tg!=nullptr;
+    at.label   = tg!=nullptr ? toCp1251("Атаковать: ") + std::string(tg->displayName()) : toCp1251("Нет цели");
+    wheelItems.push_back(at);
+
+    WheelItem st;
+    st.action = uint8_t(passive ? GameScript::SquadOrder::Defend : GameScript::SquadOrder::Passive);
+    st.icon   = passive ? TouchIcons::I_Shield : TouchIcons::I_Passive;
+    st.label  = toCp1251(passive ? "Защищать" : "Не нападать");
+    wheelItems.push_back(st);
+
+    WheelItem wt;
+    wt.action  = uint8_t(GameScript::SquadOrder::Wait);
+    wt.icon    = TouchIcons::I_Wait;
+    wt.label   = toCp1251("Ждать здесь");
+    wt.current = waiting;
+    wheelItems.push_back(wt);
+    }
+  if(wheelItems.empty())
+    closeWheel();
+  update();
+  }
+
+void TouchInput::closeWheel() {
+  wheel      = Wheel::None;
+  wheelSel   = -1;
+  wheelOwner = -1;
+  wheelItems.clear();
+  update();
+  }
