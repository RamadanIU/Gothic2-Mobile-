+    std::vector<size_t>              parent;
+    std::vector<Tempest::Matrix4x4>  bind;    // поза привязки, система модели
+    std::vector<Tempest::Matrix4x4>  local;   // относительно родителя (в позе привязки)
+    std::vector<std::vector<uint16_t>> desc;  // потомки (без самой кости), от родителя к потомку
+    std::vector<uint16_t>            order;
+
+    size_t                pelvis = size_t(-1), neck = size_t(-1), head = size_t(-1);
+    std::vector<size_t>   spine, bendable;
+    size_t                clav[2]  = {size_t(-1),size_t(-1)};
+    size_t                upper[2] = {size_t(-1),size_t(-1)}, fore[2] = {size_t(-1),size_t(-1)}, hand[2] = {size_t(-1),size_t(-1)};
+    size_t                slot[2]  = {size_t(-1),size_t(-1)};
+    size_t                thigh[2] = {size_t(-1),size_t(-1)}, calf[2] = {size_t(-1),size_t(-1)}, foot[2] = {size_t(-1),size_t(-1)};
