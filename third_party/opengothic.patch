+#include "bodyrig.h"
+
+#include "limbik.h"
+#include "skeleton.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+
+using namespace Tempest;
+using namespace LimbIk;
+
+// Gothic II Mobile: поза человека без анимации (bodyrig.h)
+
+namespace {
+
+std::string upperName(std::string_view s) {
+  std::string n(s);
+  for(auto& c:n)
+    c = char(std::toupper(static_cast<unsigned char>(c)));
+  return n;
+  }
+
+bool has(const std::string& s, const char* what) {
+  return s.find(what)!=std::string::npos;
+  }
+
+Vec3 horizontal(Vec3 v) {
+  v.y = 0;
+  const float l = v.length();
+  return l>1e-4f ? v/l : Vec3();
+  }
+
+Vec3 unitAxis(const Matrix4x4& m, int c) {
+  const Vec3 v = axis(m,c);
+  const float l = v.length();
+  return l>1e-6f ? v/l : v;
+  }
+
+// направление из системы кости в мир и обратно (оси могут быть с масштабом)
+Vec3 dirToWorld(const Matrix4x4& m, const Vec3& v) {
+  return unitAxis(m,0)*v.x + unitAxis(m,1)*v.y + unitAxis(m,2)*v.z;
+  }
+
+Vec3 dirToLocal(const Matrix4x4& m, const Vec3& v) {
+  return Vec3(Vec3::dotProduct(v,unitAxis(m,0)), Vec3::dotProduct(v,unitAxis(m,1)), Vec3::dotProduct(v,unitAxis(m,2)));
+  }
+
+void setAxis(Matrix4x4& m, int c, const Vec3& v) {
+  m.set(c,0,v.x);
+  m.set(c,1,v.y);
+  m.set(c,2,v.z);
+  }
+
+float signedAngle(const Vec3& from, const Vec3& to, const Vec3& ax) {
+  const Vec3 c = Vec3::crossProduct(from,to);
+  return std::atan2(Vec3::dotProduct(c,ax), Vec3::dotProduct(from,to));
+  }
+
+}
+
+const BodyRig* BodyRig::of(const Skeleton& sk) {
+  static std::mutex                                         sync;
+  static std::map<const Skeleton*,std::unique_ptr<BodyRig>> cache;
+  static std::map<const Skeleton*,bool>                     known;
+  std::lock_guard<std::mutex> guard(sync);
+  if(known[&sk])
+    return cache[&sk].get();
+  known[&sk] = true;
+
+  const size_t n = std::min(sk.nodes.size(), sk.tr.size());
+  auto r = std::unique_ptr<BodyRig>(new BodyRig());
+  r->n = n;
+  r->parent.resize(n);
+  r->bind.assign(sk.tr.begin(), sk.tr.begin()+ptrdiff_t(n));
+  size_t toe[2] = {size_t(-1),size_t(-1)};
+  for(size_t i=0; i<n; ++i) {
+    r->parent[i] = sk.nodes[i].parent<n ? sk.nodes[i].parent : size_t(-1);
+    const std::string nm   = upperName(sk.nodes[i].name);
+    const int         side = has(nm," L ") ? 0 : (has(nm," R ") ? 1 : -1);
+    if(nm=="ZS_LEFTHAND")
+      r->slot[0] = i;
+    else if(nm=="ZS_RIGHTHAND")
+      r->slot[1] = i;
+    if(nm.rfind("ZS_",0)==0 || has(nm,"NUB") || has(nm,"FINGER"))
+      continue;
+    if(has(nm,"TOE")) {
+      if(side>=0 && toe[side]==size_t(-1))
+        toe[side] = i;
+      continue;
+      }
+    if(has(nm,"PELVIS"))
+      r->pelvis = i;
+    else if(has(nm,"SPINE"))
+      r->spine.push_back(i);
+    else if(has(nm,"NECK"))
+      r->neck = i;
+    else if(has(nm,"HEAD"))
+      r->head = i;
+    else if(side>=0 && has(nm,"CLAVICLE"))
+      r->clav[side] = i;
+    else if(side>=0 && has(nm,"UPPERARM"))
+      r->upper[side] = i;
+    else if(side>=0 && has(nm,"FOREARM"))
+      r->fore[side] = i;
+    else if(side>=0 && has(nm,"HAND"))
+      r->hand[side] = i;
+    else if(side>=0 && has(nm,"THIGH"))
+      r->thigh[side] = i;
+    else if(side>=0 && has(nm,"CALF"))
+      r->calf[side] = i;
+    else if(side>=0 && has(nm,"FOOT"))
+      r->foot[side] = i;
+    }
+  auto ok = [n](size_t i) { return i<n; };
+  bool human = ok(r->pelvis) && ok(r->head) && !r->spine.empty();
+  for(int s=0; s<2; ++s)
+    human &= ok(r->upper[s]) && ok(r->fore[s]) && ok(r->hand[s]) && ok(r->thigh[s]) && ok(r->calf[s]) && ok(r->foot[s]);
+  auto isAncestor = [&](size_t a, size_t b) {
+    for(size_t p=r->parent[b]; p<n; p=r->parent[p])
+      if(p==a)
+        return true;
+    return false;
+    };
+  if(human) {
+    for(int s=0; s<2; ++s)
+      human &= isAncestor(r->upper[s],r->fore[s]) && isAncestor(r->fore[s],r->hand[s]) &&
+               isAncestor(r->thigh[s],r->calf[s]) && isAncestor(r->calf[s],r->foot[s]);
+    const Vec3 up = origin(r->bind[r->head]) - origin(r->bind[r->pelvis]);
+    human &= up.y>0.6f*up.length() && up.length()>10.f;
+    }
+  if(!human)
+    return nullptr;
+  for(int s=0; s<2; ++s) {
+    if(r->slot[s]<n && !isAncestor(r->hand[s],r->slot[s]))
+      r->slot[s] = size_t(-1);
+    if(r->clav[s]<n && !isAncestor(r->clav[s],r->upper[s]))
+      r->clav[s] = size_t(-1);
+    }
+
+  // порядок: родитель раньше потомка; потомки каждой кости - в том же порядке
+  {
+  std::vector<size_t> stk(sk.rootNodes.rbegin(), sk.rootNodes.rend());
+  while(!stk.empty()) {
+    const size_t i = stk.back();
+    stk.pop_back();
+    if(i>=n)
+      continue;
+    r->order.push_back(uint16_t(i));
+    for(size_t c=n; c>0; --c)
+      if(r->parent[c-1]==i)
+        stk.push_back(c-1);
+    }
+  if(r->order.size()!=n)
+    return nullptr;
+  }
+  r->local.resize(n);
+  r->desc.resize(n);
+  for(auto i:r->order) {
+    const size_t p = r->parent[i];
+    if(p<n)
+      r->local[i] = relative(r->bind[p], r->bind[i]); else
+      r->local[i] = r->bind[i];
+    for(size_t a=p; a<n; a=r->parent[a])
+      r->desc[a].push_back(i);
+    }
+
+  // позвоночник от таза вверх; гнутся позвонки выше крепления бёдер
+  auto depth = [&](size_t i) { int d = 0; for(size_t p=r->parent[i]; p<n; p=r->parent[p]) ++d; return d; };
+  std::sort(r->spine.begin(),r->spine.end(),[&](size_t a, size_t b){ return depth(a)<depth(b); });
+  for(auto s:r->spine) {
+    bool legs = false;
+    for(int k=0; k<2; ++k)
+      legs |= isAncestor(s,r->thigh[k]);
+    if(!legs)
+      r->bendable.push_back(s);
+    }
+  if(r->bendable.empty())
+    r->bendable.push_back(r->spine.back());
+
+  // вперёд модели - по стопам (к носкам), влево - вверх x вперёд
+  Vec3 f = {};
+  for(int s=0; s<2; ++s) {
+    Vec3 tip = origin(r->bind[r->foot[s]]);
+    if(toe[s]<n)
+      tip = origin(r->bind[toe[s]]);
+    f += horizontal(tip-origin(r->bind[r->foot[s]]));
+    }
+  if(horizontal(f).length()<0.5f)
+    f = Vec3(0,0,1);
+  r->Fm = horizontal(f);
+  r->Lm = Vec3::normalize(Vec3::crossProduct(Vec3(0,1,0),r->Fm));
+
+  // размеры
+  float ground = 1e9f;
+  for(int s=0; s<2; ++s) {
+    const float fy = origin(r->bind[r->foot[s]]).y;
+    ground = std::min(ground, toe[s]<n ? std::min(origin(r->bind[toe[s]]).y, fy-4.f) : fy-8.f);
+    }
+  const Vec3 pel = origin(r->bind[r->pelvis]);
+  r->pelH  = pel.y-ground;
+  r->ankH  = std::max(origin(r->bind[r->foot[0]]).y-ground, 2.f);
+  r->legL  = (origin(r->bind[r->calf[0]])-origin(r->bind[r->thigh[0]])).length() +
+             (origin(r->bind[r->foot[0]])-origin(r->bind[r->calf[0]])).length();
+  r->armL  = (origin(r->bind[r->fore[1]])-origin(r->bind[r->upper[1]])).length() +
+             (origin(r->bind[r->hand[1]])-origin(r->bind[r->fore[1]])).length();
+  r->shH   = 0.5f*(origin(r->bind[r->upper[0]]).y+origin(r->bind[r->upper[1]]).y) - pel.y;
+  r->shW   = 0.5f*std::abs(Vec3::dotProduct(origin(r->bind[r->upper[0]])-origin(r->bind[r->upper[1]]),r->Lm));
+  r->hipW  = 0.5f*std::abs(Vec3::dotProduct(origin(r->bind[r->thigh[0]])-origin(r->bind[r->thigh[1]]),r->Lm));
+  r->gripL = r->slot[1]<n ? (origin(r->bind[r->slot[1]])-origin(r->bind[r->hand[1]])).length() : 0.f;
+  r->headH = origin(r->bind[r->head]).y-ground + 0.1f*(origin(r->bind[r->head]).y-pel.y);
+
+  // ладонь: в T-позе Biped - вниз; ось хвата - от кулака к большому пальцу, вперёд
+  for(int s=0; s<2; ++s) {
+    r->palmLocal[s] = dirToLocal(r->bind[r->hand[s]], Vec3(0,-1,0));
+    r->gripDef[s]   = dirToLocal(r->bind[r->hand[s]], r->Fm);
+    const Vec3 fa   = origin(r->bind[r->hand[s]])-origin(r->bind[r->fore[s]]);
+    r->foreLocal[s] = dirToLocal(r->bind[r->hand[s]], Vec3::normalize(fa));
+    r->foreLen[s]   = fa.length();
+    }
+  cache[&sk] = std::move(r);
+  return cache[&sk].get();
+  }
+
+Vec3 BodyRig::gripAxisInHand(int a, const Vec3& slotLocalAxis) const {
+  if(slot[a]>=n)
+    return gripDef[a];
+  const Vec3 w = dirToWorld(bind[slot[a]], slotLocalAxis);
+  return dirToLocal(bind[hand[a]], w);
+  }
+
+void BodyRig::rebuild(std::vector<Matrix4x4>& W, size_t b) const {
+  for(auto d:desc[b])
+    W[d] = W[parent[d]]*local[d];
+  }
+
+void BodyRig::rotateTree(std::vector<Matrix4x4>& W, size_t b, const Vec3& at, const Vec3& ax, float ang) const {
+  if(std::abs(ang)<1e-6f)
+    return;
+  rotateAround(W[b],at,ax,ang);
+  for(auto d:desc[b])
+    rotateAround(W[d],at,ax,ang);
+  }
+
+void BodyRig::solveArm(std::vector<Matrix4x4>& W, int a, const Arm& s) const {
+  const size_t u = upper[a], f = fore[a], h = hand[a];
+  const Vec3   axL = (s.axisLocal.length()>1e-4f) ? Vec3::normalize(s.axisLocal) : gripDef[a];
+  auto rebuildArm = [&]() {
+    // всё под плечом - от родителя, кроме самих предплечья и кисти (их поставил IK)
+    for(auto d:desc[u]) {
+      if(d==f || d==h)
+        continue;
+      W[d] = W[parent[d]]*local[d];
+      }
+    };
+  Vec3 off  = (slot[a]<n) ? origin(W[slot[a]])-origin(W[h]) : Vec3();
+  Vec3 pole = s.pole;
+  for(int it=0; it<2; ++it) {
+    if(s.axis.length()>1e-4f) {
+      // Ось хвата задана: предплечье - так, чтобы кисть была почти прямой. При прямой кисти предплечье лежит на конусе
+      // вокруг оси хвата (угол - как в позе привязки, кручение кисти свободно); из конуса - ближайшее к линии от плеча
+      // к кисти направление, локоть - позади запястья по нему, подсказка IK - к этому локтю
+      const Vec3  bd  = Vec3::normalize(s.axis);
+      const float cs  = std::clamp(Vec3::dotProduct(axL,foreLocal[a]), -1.f, 1.f);
+      const float sn  = std::sqrt(std::max(0.f,1.f-cs*cs));
+      const Vec3  wr  = s.grip-off;
+      Vec3        nat = Vec3::normalize(wr-origin(W[u]));
+      Vec3        pp  = nat - bd*Vec3::dotProduct(nat,bd);
+      if(pp.length()<1e-3f)
+        pp = s.pole - bd*Vec3::dotProduct(s.pole,bd);
+      if(pp.length()>1e-3f) {
+        const Vec3 fd    = bd*cs + Vec3::normalize(pp)*sn;
+        const Vec3 elbow = wr - fd*foreLen[a];
+        const Vec3 mid   = (origin(W[u])+wr)*0.5f;
+        const Vec3 pl    = elbow-mid;
+        if(pl.length()>1e-3f)
+          pole = Vec3::normalize(pl) + s.pole*0.15f;
+        }
+      }
+    LimbIk::solve(W[u],W[f],W[h],s.grip-off,pole);
+    rebuildArm();
+    if(s.axis.length()>1e-4f) {
+      const Vec3 want = Vec3::normalize(s.axis);
+      const Vec3 cur  = dirToWorld(W[h],axL);
+      rotateBasis(W[h],cur,want);
+      if(s.palm.length()>1e-4f) {
+        // поворот кисти вокруг оси хвата: ладонь - как можно ближе к нужной
+        const Vec3 pc = dirToWorld(W[h],palmLocal[a]);
+        Vec3 p0 = pc   - want*Vec3::dotProduct(pc,want);
+        Vec3 p1 = s.palm - want*Vec3::dotProduct(s.palm,want);
+        if(p0.length()>1e-3f && p1.length()>1e-3f)
+          rotateBasis(W[h],want,signedAngle(Vec3::normalize(p0),Vec3::normalize(p1),want));
+        }
+      rebuild(W,h);
+      }
+    off = (slot[a]<n) ? origin(W[slot[a]])-origin(W[h]) : Vec3();
+    }
+  }
+
+void BodyRig::solveLeg(std::vector<Matrix4x4>& W, int k, const Leg& s, const Vec3& pelFwd, float scale) const {
+  const size_t t = thigh[k], c = calf[k], f = foot[k];
+  LimbIk::solve(W[t],W[c],W[f],s.ankle,s.pole);
+  // стопа: носок по направлению, подошва - к земле (наклон носка и ребро - поверх)
+  Vec3 T = horizontal(s.toe.length()>1e-4f ? s.toe : pelFwd);
+  if(T.length()<0.5f)
+    T = Fm;
+  Vec3 U = Vec3(0,1,0);
+  Vec3 L = Vec3::normalize(Vec3::crossProduct(U,T));
+  if(std::abs(s.pitch)>1e-5f) {
+    const float cs = std::cos(s.pitch), sn = std::sin(s.pitch);
+    T = rotate(T,L,cs,sn);
+    U = rotate(U,L,cs,sn);
+    }
+  if(std::abs(s.roll)>1e-5f) {
+    const float r  = (k==0 ? 1.f : -1.f)*s.roll;
+    const float cs = std::cos(r), sn = std::sin(r);
+    U = rotate(U,T,cs,sn);
+    L = rotate(L,T,cs,sn);
+    }
+  auto R = [&](const Vec3& v) {
+    return L*Vec3::dotProduct(v,Lm) + U*v.y + T*Vec3::dotProduct(v,Fm);
+    };
+  for(int col=0; col<3; ++col)
+    setAxis(W[f],col,R(axis(bind[f],col))*scale);
+  for(auto d:desc[t]) {
+    if(d==c || d==f)
+      continue;
+    W[d] = W[parent[d]]*local[d];
+    }
+  }
+
+void BodyRig::build(const Spec& s, float scale, std::vector<Matrix4x4>& out) const {
+  std::vector<Matrix4x4>& W = out;
+  W.resize(n);
+  if(scale<=0.f)
+    scale = 1.f;
+
+  // таз: поворот, который переводит оси модели (влево, вверх, вперёд) в оси таза
+  Vec3 Up = s.up.length()>1e-4f ? Vec3::normalize(s.up) : Vec3(0,1,0);
+  Vec3 Fp = s.fwd - Up*Vec3::dotProduct(s.fwd,Up);
+  if(Fp.length()<1e-3f) {
+    Fp = Vec3::crossProduct(Up, std::abs(Up.x)<0.9f ? Vec3(1,0,0) : Vec3(0,0,1));
+    }
+  Fp = Vec3::normalize(Fp);
+  Vec3 Lp = Vec3::normalize(Vec3::crossProduct(Up,Fp));
+  auto R = [&](const Vec3& v) {
+    return Lp*Vec3::dotProduct(v,Lm) + Up*v.y + Fp*Vec3::dotProduct(v,Fm);
+    };
+  const Vec3 pel0 = origin(bind[pelvis]);
+  for(size_t i=0; i<n; ++i) {
+    Matrix4x4 m = bind[i];
+    for(int c=0; c<3; ++c)
+      setAxis(m,c,R(axis(bind[i],c))*scale);
+    setOrigin(m, s.pelvis + R(origin(bind[i])-pel0)*scale);
+    W[i] = m;
+    }
+
+  // корпус: поровну на позвонки выше бёдер - поворот, сгиб, наклон
+  Vec3 Lc = Lp, Uc = Up, Fc = Fp;
+  const float nb = float(bendable.size());
+  for(auto v:bendable) {
+    const Vec3 at = origin(W[v]);
+    const float tw = s.twist/nb, fl = s.flex/nb, sd = -s.side/nb;
+    rotateTree(W,v,at,Uc,tw);
+    Lc = rotate(Lc,Uc,std::cos(tw),std::sin(tw));
+    Fc = rotate(Fc,Uc,std::cos(tw),std::sin(tw));
+    rotateTree(W,v,at,Lc,fl);
+    Uc = rotate(Uc,Lc,std::cos(fl),std::sin(fl));
+    Fc = rotate(Fc,Lc,std::cos(fl),std::sin(fl));
+    rotateTree(W,v,at,Fc,sd);
+    Lc = rotate(Lc,Fc,std::cos(sd),std::sin(sd));
+    Uc = rotate(Uc,Fc,std::cos(sd),std::sin(sd));
+    }
+
+  // голова: к направлению взгляда, не больше 70° от корпуса; шея - 40 %, голова - остальное
+  if(s.look.length()>1e-4f) {
+    const Vec3 lk = Vec3::normalize(s.look);
+    Vec3 ax = Vec3::crossProduct(Fc,lk);
+    const float sn = ax.length();
+    if(sn>1e-4f) {
+      ax = ax/sn;
+      const float ang = std::min(std::atan2(sn,Vec3::dotProduct(Fc,lk)), 70.f*float(M_PI)/180.f);
+      if(neck<n) {
+        rotateTree(W,neck,origin(W[neck]),ax,ang*0.4f);
+        rotateTree(W,head,origin(W[head]),ax,ang*0.6f);
+        } else {
+        rotateTree(W,head,origin(W[head]),ax,ang);
+        }
+      }
+    }
+
+  // плечи вверх (замах над головой)
+  for(int a=0; a<2; ++a) {
+    if(clav[a]>=n || s.shrug[a]<=0.f)
+      continue;
+    const float ang = std::clamp(s.shrug[a],0.f,1.f)*0.35f*(a==0 ? 1.f : -1.f);
+    rotateTree(W,clav[a],origin(W[clav[a]]),Fc,ang);
+    }
+
+  for(int a=0; a<2; ++a)
+    solveArm(W,a,s.arm[a]);
+  for(int k=0; k<2; ++k)
+    solveLeg(W,k,s.leg[k],Fp,scale);
+  }
