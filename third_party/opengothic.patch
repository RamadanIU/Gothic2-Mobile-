+
+void AiNpc::tick(uint64_t dt) {
+  (void)dt;
+  const bool on = AiLink::enabled();
+  if(!on) {
+    wasEnabled = false;
+    return;
+    }
+  if(!wasEnabled) {
+    wasEnabled = true;
+    readySent  = false;
+    }
+
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr)
+    return;
+  const uint64_t now = owner.tickCount();
+
+  Npc* npc = resolve();
+  if(w!=loggedWorld) {
+    loggedWorld = w;
+    Log::i("[g2m] ai: on, world \"",w->name(),"\", target=",isTargetWorld(*w) ? 1 : 0,
+           ", base npc=",thorusSym!=size_t(-1) ? 1 : 0,", geralt=",npc!=nullptr ? "found" : "absent");
+    if(thorusSym==size_t(-1) && isTargetWorld(*w))
+      Log::e("[g2m] ai: no VLK_2000_THORUS in scripts - Geralt can not be created");
+    // Жители, которых герой куда-то увёл (aivar[99]), после загрузки или смены мира - к своему распорядку:
+    // прежний распорядок в сохранение не пишется (Npc::saveRoutines). Идущие с героем - остаются с ним
+    residents.clear();
+    for(uint32_t i=0; i<w->npcCount(); ++i) {
+      Npc* n = w->npcById(i);
+      if(n==nullptr || n->isPlayer() || n->isDead())
+        continue;
+      calmHostility(*n,*w->player());
+      if(n==npc)
+        continue;
+      if(n->handle().aivar[AivRoutine]!=0 && !owner.isPartyMember(*n))
+        goHome(*n);
+      }
+    }
+  // Ушёл с героем в другой мир и там остался - в Хоринисе второго не создавать
+  const bool away = w->player()->handle().aivar[AivHeroGeraltAway]!=0;
+  if(npc==nullptr && isTargetWorld(*w) && !away && thorusSym!=size_t(-1) && now>=insertTry) {
+    insertTry = now+5000;
+    insert(*w);
+    npc = geralt;
+    }
+  else if(npc!=nullptr && now>=insertTry) {
+    insertTry = now+2000;
+    moveToSpawn(*npc,*w);
+    }
+
+  std::vector<std::string> cmds;
+  AiLink::poll(cmds);
+  for(auto& c:cmds)
+    handle(c);
+
+  // Дела и реплики жителей идут и там, где Геральта нет
+  tickActions(now);
+  tickLines(now);
+  tickResidents(now);
+
+  if(geralt==nullptr)
+    return;
+  if(!readySent) {
+    readySent = true;
+    sendReady();
+    }
+
+  if(busy && now>busyUntil)
+    busy = false;
+  // Диалог мог закрыться сам (герой отошёл, бой) - без DialogMenu::close
+  if(talking && !geralt->isTalk() && !w->isInDialog())
+    onDialogEnd(nullptr,geralt);
+
+  tickEvents(now);
+  }
+
+void AiNpc::handle(const std::string& json) {
+  rapidjson::Document d;
+  d.Parse(json.c_str(),json.size());
+  if(d.HasParseError() || !d.IsObject())
+    return;
+  const std::string cmd = str(d,"cmd");
+
+  if(cmd=="snapshot") {
+    // who - чьими глазами: Геральт (self) или житель (n12)
+    if(Npc* me = actorOf(str(d,"who"))) {
+      refSelf = me;
+      sendSnapshot(*me,str(d,"req"));
+      refSelf = nullptr; // по умолчанию self - Геральт (указатель не хранится: мир может смениться)
+      }
+    return;
+    }
+  if(cmd=="lore") {
+    sendLore(str(d,"req"),str(d,"target"));
+    return;
+    }
+  if(cmd=="describe") {
+    sendDescribe(str(d,"req"),str(d,"target"),str(d,"viewer"));
+    return;
+    }
+
+  if(cmd=="say") {
+    cmdSay(str(d,"id"),str(d,"who"),str(d,"text"),uint32_t(std::clamp<int64_t>(num(d,"ms",2000),300,60000)),
+           str(d,"to"),str(d,"mood"));
+    }
+  else if(cmd=="act") {
+    auto it = d.FindMember("args");
+    static const rapidjson::Value empty(rapidjson::kObjectType);
+    Npc* actor = actorOf(str(d,"who"));
+    if(actor==nullptr) {
+      Action a;
+      a.id   = str(d,"id");
+      a.name = str(d,"name");
+      finish(a,false,"тебя здесь нет");
+      return;
+      }
+    refSelf = actor;
+    cmdAct(*actor,str(d,"id"),str(d,"name"),it!=d.MemberEnd() ? &it->value : &empty);
+    refSelf = nullptr; // по умолчанию self - Геральт (указатель не хранится: мир может смениться)
+    }
+  else if(cmd=="think") {
+    busy      = flag(d,"on",false);
+    busyUntil = owner.tickCount()+BusyMax;
+    }
+  else if(cmd=="end_talk") {
+    endDialog();
+    }
+  else if(cmd=="hush") {
+    // Обрыв: реплики, которые ещё не начались, не скажутся
+    lines.erase(std::remove_if(lines.begin(),lines.end(),[](const Line& l){ return !l.started; }),lines.end());
+    }
+  }
+
+void AiNpc::cmdSay(const std::string& id, const std::string& who, const std::string& text, uint32_t ms,
+                   const std::string& to, const std::string& mood) {
+  auto* w = world();
+  if(w==nullptr || id.empty() || text.empty())
+    return;
+  Npc* pl      = w->player();
+  Npc* speaker = nullptr;
+  if(who.empty() || who=="self")
+    speaker = geralt;
+  else if(who=="hero")
+    speaker = pl;
+  else
+    speaker = npcByRef(who);
+  if(speaker==nullptr || speaker->isDead()) {
+    AiLink::send(std::string("{\"ev\":\"line_end\",\"id\":\"")+id+"\",\"skipped\":true}");
+    return;
+    }
+
+  Npc* target = nullptr;
+  if(to=="hero")
+    target = pl;
+  else if(to=="self")
+    target = geralt;
+  else if(!to.empty())
+    target = npcByRef(to);
+  if(target==nullptr)
+    target = (speaker==pl) ? geralt : pl;
+
+  Line ln;
+  ln.id      = id;
+  ln.text    = toCp1251(text);
+  ln.speaker = std::string(speaker->displayName());
+  ln.ms      = ms;
+  ln.npc     = speaker;
+  ln.endsAt  = owner.tickCount()+LineKeep;
+  lines.push_back(ln);
+
+  const bool dialog = talking && (speaker==geralt || speaker==pl) && (target==geralt || target==pl);
+  if(dialog) {
+    // В диалоге - очередью ИИ, как AI_Output скриптов: субтитр, камера, жесты и лицо, по очереди с героем
+    speaker->aiPush(AiQueue::aiOutput(*target,id,owner.aiOutOrderId));
+    ++owner.aiOutOrderId;
+    } else {
+    speakOverlay(*speaker,target,id,text,ms);
+    }
+
+  // Настроение - лицо на время реплики
+  static const struct { const char* mood; const char* ani; } faces[] = {
+    {"angry","S_ANGRY"}, {"friendly","S_FRIENDLY"}, {"hostile","S_HOSTILE"}, {"afraid","S_FRIGHTENED"},
+    };
+  for(auto& f:faces)
+    if(mood==f.mood)
+      speaker->startFaceAnim(f.ani,1,ms+2000);
+  }
+
+void AiNpc::speakOverlay(Npc& speaker, Npc* to, const std::string& id, const std::string& text, uint32_t ms) {
+  (void)text;
+  // Вне диалога: говорит на ходу, не останавливаясь (как реплики отряда в бою); стоящий - поворачивается
+  if(to!=nullptr && to!=&speaker && speaker.isAiQueueEmpty() && !speaker.isAttack() && speaker.interactive()==nullptr &&
+     speaker.bodyStateMasked()==BS_STAND && !speaker.isPlayer()) {
+    speaker.aiPush(AiQueue::aiTurnToNpc(to));
+    speaker.aiPush(AiQueue::aiLookAtNpc(to));
+    }
+  if(!speaker.isPlayer())
+    speaker.startFaceAnim("VISEME",1,ms);
+  lineStart(speaker,id,false);
+  }
