+void AiNpc::buildStock() {
+  // Список запасов - один раз за сеанс (скрипты не меняются): всё, что создаёт себе PC_Rockefeller (тестовый герой
+  // разработчиков со всеми вещами), - по байт-коду его экземпляра, с его количеством; сверх того - всё оружие,
+  // доспехи, боеприпасы, руны и свитки, кольца, амулеты, пояса, зелья, еда, травы и трофеи из скриптов игры (в том
+  // числе аддона, которого у Рокфеллера нет), кроме квестовых вещей
+  if(stockBuilt)
+    return;
+  stockBuilt = true;
+  stockList.clear();
+  auto& vm = owner.vm;
+
+  auto isItem = [&](const zenkit::DaedalusSymbol* s) {
+    if(s==nullptr || s->type()!=zenkit::DaedalusDataType::INSTANCE)
+      return false;
+    for(int depth=0; s!=nullptr && depth<8; ++depth) {
+      if(s->name()=="C_ITEM")
+        return true;
+      if(s->parent()==uint32_t(-1))
+        return false;
+      s = vm.find_symbol_by_index(s->parent());
+      }
+    return false;
+    };
+
+  std::unordered_map<size_t,size_t> rock;   // экземпляр - сколько у Рокфеллера
+  std::vector<size_t>               order;
+  if(auto* pc = vm.find_symbol_by_name("PC_ROCKEFELLER");
+     pc!=nullptr && pc->type()==zenkit::DaedalusDataType::INSTANCE && pc->address()!=0) {
+    struct Arg {
+      const zenkit::DaedalusSymbol* sym   = nullptr;
+      int32_t                       imm   = 0;
+      bool                          isImm = false;
+      };
+    // Экземпляр предмета в аргументе: CreateInvItems(self, ItMw_…, n) кладёт его номером (PUSHI), иногда - PUSHVI
+    auto itemOf = [&](const Arg& a) -> size_t {
+      const zenkit::DaedalusSymbol* s = a.isImm ? vm.find_symbol_by_index(uint32_t(a.imm)) : a.sym;
+      return isItem(s) ? size_t(s->index()) : size_t(-1);
+      };
+    try {
+      std::vector<Arg> stack;
+      uint32_t       at  = pc->address();
+      const uint32_t end = vm.size();
+      for(size_t step=0; at<end && step<40000; ++step) {
+        const auto ins = vm.instruction_at(at);
+        at += ins.size;
+        if(ins.op==zenkit::DaedalusOpcode::RSR)
+          break;
+        switch(ins.op) {
+          case zenkit::DaedalusOpcode::PUSHV:
+          case zenkit::DaedalusOpcode::PUSHVI:
+          case zenkit::DaedalusOpcode::PUSHVV: {
+            Arg a;
+            a.sym = vm.find_symbol_by_index(ins.symbol);
+            stack.push_back(a);
+            break;
+            }
+          case zenkit::DaedalusOpcode::PUSHI: {
+            Arg a;
+            a.imm   = ins.immediate;
+            a.isImm = true;
+            stack.push_back(a);
+            break;
+            }
+          case zenkit::DaedalusOpcode::BE: {
+            auto*             callee = vm.find_symbol_by_index(ins.symbol);
+            const std::string name   = callee!=nullptr ? callee->name() : std::string();
+            const size_t      n      = stack.size();
+            size_t            cls    = size_t(-1), cnt = 1;
+            if((name=="CREATEINVITEM" || name=="EQUIPITEM") && n>=2) {
+              cls = itemOf(stack[n-1]);
+              }
+            else if(name=="CREATEINVITEMS" && n>=3) {
+              cls = itemOf(stack[n-2]);
+              cnt = stack[n-1].isImm && stack[n-1].imm>0 ? size_t(stack[n-1].imm) : 1;
+              }
+            if(cls!=size_t(-1)) {
+              if(rock.find(cls)==rock.end())
+                order.push_back(cls);
+              rock[cls] += cnt;
+              }
+            stack.clear();
+            break;
+            }
+          default:
+            stack.clear();
+            break;
+          }
+        }
+      }
+    catch(...) {
+      Log::e("[g2m] ai: unable to read PC_ROCKEFELLER");
+      }
+    }
+  const size_t fromRock = order.size();
+
+  // Всё снаряжение мира из скриптов: экземпляры C_Item по виду предмета (поля - из инициализации экземпляра)
+  std::vector<size_t> all;
+  vm.enumerate_instances_by_class_name("C_ITEM",[&](zenkit::DaedalusSymbol& s) {
+    all.push_back(s.index());
+    });
+  struct Info {
+    uint32_t main  = 0;
+    uint32_t flags = 0;
+    bool     ok    = false;
+    };
+  std::unordered_map<size_t,Info> info;
+  auto infoOf = [&](size_t cls) -> const Info& {
+    auto found = info.find(cls);
+    if(found!=info.end())
+      return found->second;
+    Info& in = info[cls];
+    try {
+      auto h = std::make_shared<zenkit::IItem>();
+      owner.initializeInstanceItem(h,cls);
+      in.main  = uint32_t(h->main_flag);
+      in.flags = uint32_t(h->flags);
+      in.ok    = !h->visual.empty();
+      }
+    catch(...) {
+      in.ok = false;
+      }
+    return in;
+    };
+  const uint32_t gear = ITM_CAT_NF | ITM_CAT_FF | ITM_CAT_MUN | ITM_CAT_ARMOR | ITM_CAT_RUNE | ITM_CAT_MAGIC |
+                        ITM_CAT_POTION | ITM_CAT_FOOD | ITM_CAT_LIGHT;
+  for(auto cls:all) {
+    if(rock.find(cls)!=rock.end())
+      continue;
+    auto* s = vm.find_symbol_by_index(uint32_t(cls));
+    if(s==nullptr)
+      continue;
+    const Info& in = infoOf(cls);
+    if(!in.ok)
+      continue;
+    if((in.main & gear) || startsWith(s->name(),"ITAT_")) {
+      order.push_back(cls);
+      rock[cls] = 0;
+      }
+    }
+
+  const size_t gold = owner.goldId()!=nullptr ? size_t(owner.goldId()->index()) : size_t(-1);
+  for(auto cls:order) {
+    auto* s = vm.find_symbol_by_index(uint32_t(cls));
+    if(s==nullptr || cls==gold || notInStock(s->name()))
+      continue;
+    const Info& in = infoOf(cls);
+    if(!in.ok || (in.flags & ITM_MISSION))
+      continue;
+    // Сколько: штучное - одно, стопками - на несколько походов (окно открылось снова - запасы снова полные)
+    size_t n = 1;
+    if(in.flags & ITM_MULTI) {
+      size_t def = 10;
+      if(in.main & ITM_CAT_MUN)
+        def = 500;
+      else if(in.main & ITM_CAT_POTION)
+        def = 20;
+      n = std::max(rock[cls],def);
+      }
+    stockList.push_back({cls,n});
+    }
+  Log::i("[g2m] ai: Geralt's stock - ",stockList.size()," kinds (",fromRock," from PC_ROCKEFELLER)");
+  }
+
+void AiNpc::onTradeOpen(Npc& trader) {
+  if(!isAiNpc(trader) || !stockPending)
+    return;
+  stockPending = false;
+  stockRemove();
+  buildStock();
+  stockNpc = &trader;
+  for(auto& s:stockList) {
+    StockAdded a;
+    a.cls   = s.cls;
+    a.own   = trader.itemCount(s.cls);
+    a.added = s.count;
+    if(trader.addItem(s.cls,s.count)!=nullptr)
+      stockAdded.push_back(a);
+    }
+  }
+
+void AiNpc::onTradeClose(Npc& trader) {
+  if(&trader==stockNpc)
+    stockRemove();
+  }
+
+void AiNpc::stockRemove() {
+  // Своё остаётся: взятое героем уходит из запасов первым, отданное им - Геральту
+  Npc* npc = stockNpc;
+  stockNpc = nullptr;
+  if(npc==nullptr || npc!=geralt || !npcAlive(npc)) {
+    stockAdded.clear();
+    return;
+    }
+  for(auto& a:stockAdded) {
+    const size_t now  = npc->itemCount(a.cls);
+    const size_t left = std::min(now>a.own ? now-a.own : 0, a.added);
+    if(left>0)
+      npc->delItem(a.cls,uint32_t(left));
+    if(a.added>left)
+      stockTaken.emplace_back(a.cls,a.added-left);
+    }
+  stockAdded.clear();
+  }
+
+size_t AiNpc::stockShare(const Npc& npc, size_t cls) const {
+  if(&npc!=stockNpc)
+    return 0;
+  for(auto& a:stockAdded)
+    if(a.cls==cls) {
+      const size_t now = npc.itemCount(cls);
+      return std::min(now>a.own ? now-a.own : 0, a.added);
+      }
+  return 0;
+  }
