+void AiNpc::onHit(Npc& attacker, Npc& victim) {
+  if(!AiLink::enabled())
+    return;
+  noteHit(attacker,victim);
+  if(geralt==nullptr)
+    return;
+  auto* w = world();
+  if(w==nullptr)
+    return;
+  // Кто кого бьёт рядом - чтобы знать, кто убил (событие death)
+  if(&victim!=geralt && victim.qDistTo(*geralt)<SeeDist*SeeDist) {
+    auto& k    = known[&victim];
+    if(attacker.isPlayer())
+      k.hitBy = "убил(а) герой";
+    else if(&attacker==geralt)
+      k.hitBy = "от твоей руки";
+    else
+      k.hitBy = "убил(а) "+fromCp1251(attacker.displayName());
+    k.lastSeen = owner.tickCount();
+    }
+  if(&victim==geralt) {
+    if(attacker.isPlayer())
+      sendEvent("hero_hit_me","Герой ударил тебя.",&attacker);
+    else
+      sendEvent("hit","Тебя ударил(а) "+fromCp1251(attacker.displayName())+".",&attacker);
+    return;
+    }
+  if(attacker.isPlayer() && victim.qDistTo(*geralt)<SeeDist*SeeDist && !victim.isMonster())
+    sendEvent("hero_attacks","Герой напал на "+fromCp1251(victim.displayName())+".",&victim);
+  else if(&attacker==geralt)
+    return;
+  else if(victim.isPlayer() && attacker.qDistTo(*geralt)<SeeDist*SeeDist)
+    sendEvent("hero_attacked","На героя напал(а) "+fromCp1251(attacker.displayName())+".",&attacker);
+  }
+
+void AiNpc::noteHit(Npc& attacker, Npc& victim) {
+  // Кто бьёт людей рядом с героем (и самого героя) и чем: очнувшийся узнает, кто его избил, соседи - что случилось
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr || victim.isMonster() || &attacker==&victim)
+    return;
+  if(w->player()->qDistTo(victim)>IncidentDist*IncidentDist)
+    return;
+  const uint64_t now = owner.tickCount();
+  auto& in = incidents[&victim];
+  if(!in.tracked) {
+    in.tracked = true;
+    in.down    = victim.isUnconscious();
+    in.dead    = victim.isDead();
+    }
+  // Другой обидчик или давняя драка - новая драка
+  if(in.hitBy!=&attacker || now>in.hitAt+60000)
+    in.hits = 0;
+  in.hitBy    = &attacker;
+  in.byHero   = attacker.isPlayer();
+  in.byFemale = attacker.handle().voice==16 || attacker.handle().voice==17;
+  in.byName   = attacker.isPlayer() ? std::string("герой") : fromCp1251(attacker.displayName());
+  in.weapon   = weaponOf(attacker);
+  in.hitAt    = now;
+  in.seenAt   = now;
+  ++in.hits;
+  }
+
+void AiNpc::tickIncidents(uint64_t now) {
+  // Сбит с ног, очнулся, погиб - переходы у людей рядом с героем, которых кто-то бил (incidents): событие с тем, кто
+  // это видел. Лежавших ещё до прихода героя событием не трогаем - их состояние и так видно в снимке
+  if(now<incidentTick)
+    return;
+  incidentTick = now+500;
+  auto* w  = world();
+  Npc*  pl = w!=nullptr ? w->player() : nullptr;
+  if(pl==nullptr || incidents.empty())
+    return;
+  std::vector<std::pair<const char*,Npc*>> fired;
+  w->detectNpc(pl->position(),IncidentDist,[&](Npc& n) {
+    auto it = incidents.find(&n);
+    if(it==incidents.end() || n.isMonster())
+      return;
+    auto&      in   = it->second;
+    const bool dead = n.isDead();
+    const bool down = !dead && n.isUnconscious();
+    in.seenAt = now;
+    if(dead && !in.dead) {
+      in.dead   = true;
+      in.down   = false;
+      in.deadAt = now;
+      fired.emplace_back("dead",&n);
+      }
+    else if(down && !in.down) {
+      in.down   = true;
+      in.downAt = now;
+      in.upAt   = 0;
+      fired.emplace_back("down",&n);
+      }
+    else if(!down && !dead && in.down) {
+      in.down = false;
+      in.upAt = now;
+      fired.emplace_back("up",&n);
+      }
+    });
+  for(auto& [k,n]:fired)
+    sendIncident(k,*n,incidents[n],now);
+  for(auto it=incidents.begin(); it!=incidents.end();) {
+    auto& in = it->second;
+    const uint64_t last = std::max(std::max(in.hitAt,in.downAt),std::max(in.upAt,in.deadAt));
+    if(!in.down && now>last+IncidentKeep && now>in.seenAt+60000)
+      it = incidents.erase(it); else
+      ++it;
+    }
+  }
+
+void AiNpc::sendIncident(std::string_view kind, Npc& victim, const Incident& in, uint64_t now) {
+  // Кто это видел: люди в 15 м, которые видят его (и сам обидчик). Приложение пишет им в память, очнувшемуся жителю
+  // рядом с героем - ход модели: кто его избил, чем, кто вокруг
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr)
+    return;
+  std::vector<Npc*> near, seen;
+  listeners(victim,nullptr,WitnessDist,near);
+  for(auto* n:near)
+    if(n->canSeeNpc(victim,false))
+      seen.push_back(n);
+  Npc* prevSelf = refSelf;
+  refSelf = nullptr; // self - Геральт
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  auto person = [&](Npc& n) {
+    j.StartObject();
+    put(j,"ref",refOf(n));
+    if(!n.isPlayer()) {
+      put(j,"id",npcId(n));
+      put(j,"name",fromCp1251(n.displayName()));
+      put(j,"voice",n.handle().voice);
+      }
+    if(n.handle().voice==16 || n.handle().voice==17)
+      put(j,"female",1);
+    j.EndObject();
+    };
+  j.StartObject();
+  put(j,"ev","incident");
+  put(j,"kind",kind);
+  j.Key("victim");
+  person(victim);
+  j.Key("by");
+  j.StartObject();
+  if(in.hitBy!=nullptr && npcAlive(in.hitBy))
+    put(j,"ref",refOf(*const_cast<Npc*>(in.hitBy)));
+  put(j,"name",in.byName);
+  if(in.byHero)
+    put(j,"hero",1);
+  if(in.byFemale)
+    put(j,"female",1);
+  j.EndObject();
+  if(!in.weapon.empty())
+    put(j,"weapon",in.weapon);
+  put(j,"hits",int64_t(in.hits));
+  if(kind=="up" && in.downAt!=0)
+    put(j,"lay",int64_t((now-in.downAt)/1000));
+  putMeters(j,"heroDist",dist(*w->player(),victim));
+  j.Key("witnesses");
+  j.StartArray();
+  for(auto* n:seen)
+    person(*n);
+  j.EndArray();
+  j.EndObject();
+  refSelf = prevSelf;
+  AiLink::send(buf.GetString());
+  Log::i("[g2m] ai: incident ",kind," \"",victim.displayName(),"\" by ",in.byHero ? "hero" : "npc",
+         ", witnesses=",int(seen.size()));
+  }
+
+std::string AiNpc::incidentJson(Npc& n, uint64_t now) {
+  // Происшествие в снимке: кто бил (ref - глазами того, чей снимок), чем, сколько секунд назад, сбит ли с ног и
+  // очнулся ли. Модель узнаёт, что человек с низким здоровьем уже на ногах, и кто его избил
+  auto it = incidents.find(&n);
+  if(it==incidents.end() || it->second.hitAt==0)
+    return {};
+  const auto& in = it->second;
+  const uint64_t last = std::max(in.hitAt,std::max(in.upAt,in.deadAt));
+  if(!in.down && now>last+IncidentKeep)
+    return {};
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  if(in.hitBy!=nullptr && npcAlive(in.hitBy))
+    put(j,"by",refOf(*const_cast<Npc*>(in.hitBy)));
+  put(j,"byName",in.byName);
+  if(in.byHero)
+    put(j,"byHero",1);
+  if(in.byFemale)
+    put(j,"byFemale",1);
+  if(!in.weapon.empty())
+    put(j,"weapon",in.weapon);
+  put(j,"hits",int64_t(in.hits));
+  put(j,"ago",int64_t((now-in.hitAt)/1000));
+  if(in.downAt!=0)
+    put(j,"downAgo",int64_t((now-in.downAt)/1000));
+  if(in.upAt!=0 && in.upAt>=in.downAt) {
+    put(j,"upAgo",int64_t((now-in.upAt)/1000));
+    put(j,"lay",int64_t((in.upAt-in.downAt)/1000));
+    }
+  if(in.deadAt!=0)
+    put(j,"deadAgo",int64_t((now-in.deadAt)/1000));
+  j.EndObject();
+  return buf.GetString();
+  }
