+bool Npc::startRagdollActive() {
+  // активная кукла (живой на ногах): из позы кадра, цель - поза анимации; в физике нет места - нет
+  if(!ragdollActiveAllowed())
+    return false;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return false;
+  auto& pose = visual.pose();
+  const auto root = pose.rootBone();
+  if((Vec3(root.at(3,0),root.at(3,1),root.at(3,2))-position()).length()>500.f)
+    return false;
+  float dist = 0;
+  bool  keep = false;
+  ragdollViewDistance(dist,keep);
+  ragdoll = Ragdoll::create(*owner.physic(), *sk, pose.transform(), pose.boneCount(), Ragdoll::S_Active, dist, keep);
+  if(ragdoll==nullptr)
+    return false;
+  Vec3 v = ragVelocity*10.f;
+  if(v.length()>20.f)
+    v = Vec3();
+  ragdoll->setVelocity(v);
+  pose.animPose(ragTarget);
+  ragdoll->setTarget(ragTarget,0);
+  ragTargetAt   = owner.tickCount();
+  ragBlendStart = 0;
+  ragPushedVer  = 0;
+  ragShown      = -1;
+  ragKnock      = false;
+  return true;
