+void TouchInput::drawMain(Painter& p) {
+  const auto b       = buttonOf(C_Main);
+  const auto ctx     = mainContext();
+  const bool pressed = isPressed(C_Main);
+  const int  ds      = int(float(2*b.r)/0.88f);
+  if(pressed) {
+    const int gs = int(float(ds)*1.3f);
+    drawGlow(p, Rect(b.c.x-gs/2, b.c.y-gs/2, gs, gs), ds, 0.6f);
+    }
+  auto& d = icons.disc(ds);
+  p.setBrush(Brush(d,Color(1.f,1.f,1.f,(pressed ? 1.f : 0.92f)*paintAlpha)));
+  p.drawRect(b.c.x-ds/2, b.c.y-ds/2, ds, ds, 0,0,d.w(),d.h());
+
+  // Значок выше центра, подпись - внизу круга: что кнопка сделает сейчас
+  Color cl = ctx.dim ? GoldDim : (pressed ? GoldBright : GoldIdle);
+  cl.set(cl.r(), cl.g(), cl.b(), cl.a()*paintAlpha);
+  drawGlyph(p, ctx.icon, Point(b.c.x, b.c.y-int(float(b.r)*0.16f)), int(float(b.r)*0.95f), cl);
+  if(!ctx.label.empty()) {
+    const auto txt = fit(ctx.label, int(float(b.r)*1.6f), 0.85f);
+    drawLabel(p, txt, Point(b.c.x, b.c.y+int(float(b.r)*0.52f)), pressed, 0.85f);
+    }
+  }
