+#pragma once
+
+#include <Tempest/Matrix4x4>
+#include <Tempest/Vec>
+
+#include <cstdint>
+#include <vector>
+
+class Skeleton;
+
+// Gothic II Mobile: поза человека без анимации - из нескольких чисел (бой телом, подъём телом). Таз - точка и
+// ориентация, корпус - сгиб, наклон и поворот (поровну на позвонки выше бёдер), голова - куда смотреть, ключицы -
+// плечи вверх, руки - IK к точке хвата (кисть или слот оружия) с подсказкой локтя, кисть - так, чтобы ось хвата
+// (клинок) смотрела, куда надо, ноги - IK к лодыжкам, стопы - носком по направлению. Остальные кости (пальцы,
+// слоты, корень) - как в позе привязки относительно родителя. Всё - в мире, см.
+//
+// Такую позу не показывают как есть: это цель мышц куклы (Ragdoll::setTarget) - удар, блок, шаги, подъём делает
+// физика тела, а поза только говорит, куда тянуться. Скелет должен быть человеческим (кости Biped).
+class BodyRig final {
+  public:
+    // Рука: хват - начало кости слота (ZS_RIGHTHAND/ZS_LEFTHAND; нет слота - запястье) в мире
+    struct Arm final {
+      Tempest::Vec3 grip  = {};
+      Tempest::Vec3 pole  = {};  // куда смотрит локоть (мир)
+      Tempest::Vec3 axis  = {};  // куда смотрит ось хвата - клинок (мир); 0 - кисть прямо по предплечью
+      Tempest::Vec3 palm  = {};  // куда смотрит ладонь (мир); 0 - как выйдет с наименьшим поворотом кисти
+      Tempest::Vec3 axisLocal = {}; // ось хвата в системе кости кисти (gripAxisInHand); 0 - defaultGripAxis
+      };
+    struct Leg final {
+      Tempest::Vec3 ankle = {};  // начало кости стопы, мир
+      Tempest::Vec3 pole  = {};  // куда смотрит колено (мир)
+      Tempest::Vec3 toe   = {};  // куда носок (по горизонтали, мир); 0 - вперёд таза
+      float         pitch = 0;   // носок вниз (+) или вверх (-), рад
+      float         roll  = 0;   // стопа на ребро (+ - наружу), рад
+      };
+    struct Spec final {
+      Tempest::Vec3 pelvis = {};            // начало кости таза, мир
+      Tempest::Vec3 fwd    = {0,0,1};       // вперёд таза (мир)
+      Tempest::Vec3 up     = {0,1,0};       // вверх таза (мир)
+      float         flex   = 0;             // корпус вперёд (+), рад - всего по позвоночнику
+      float         side   = 0;             // корпус влево (+)
+      float         twist  = 0;             // корпус поворотом влево (+) - вокруг позвоночника
+      Tempest::Vec3 look   = {};            // куда смотрит голова (мир); 0 - как корпус
+      float         shrug[2] = {0,0};       // плечо вверх (0..1): левое, правое
+      Arm           arm[2];                 // 0 - левая, 1 - правая
+      Leg           leg[2];
+      };
+
+    // Схема скелета человека; nullptr - не человек
+    static const BodyRig* of(const Skeleton& sk);
+
+    // Поза: мировые матрицы всех костей скелета; scale - масштаб модели (Npc: размер), позиции в Spec - уже в мире
+    void build(const Spec& s, float scale, std::vector<Tempest::Matrix4x4>& out) const;
+
+    // Размеры в позе привязки (см, масштаб 1)
+    float         pelvisHeight() const { return pelH; }   // таз над землёй стоя (ноги прямые)
+    float         ankleHeight()  const { return ankH; }   // лодыжка над землёй
+    float         legLength()    const { return legL; }   // бедро + голень
+    float         armLength()    const { return armL; }   // плечо + предплечье (до запястья)
+    float         shoulderHeight() const { return shH; }  // плечо над тазом
+    float         shoulderWidth()  const { return shW; }  // от середины до плеча
+    float         hipWidth()       const { return hipW; } // от середины до бедра
+    float         gripReach()      const { return gripL; }// от запястья до слота
+    float         height()         const { return headH; }// макушка над землёй (примерно)
+
+    // Кости (номера в скелете)
+    size_t        pelvisBone() const { return pelvis; }
+    size_t        chestBone()  const { return spine.empty() ? pelvis : spine.back(); }
+    size_t        headBone()   const { return head; }
+    size_t        handBone(int a) const { return hand[a]; }
+    size_t        slotBone(int a) const { return slot[a]; }
+    size_t        footBone(int k) const { return foot[k]; }
+    size_t        upperArmBone(int a) const { return upper[a]; }
+
+    // Оси модели (вперёд, влево) в позе привязки - для своих систем отсчёта
+    Tempest::Vec3 modelForward() const { return Fm; }
+    Tempest::Vec3 modelLeft()    const { return Lm; }
+
+    // Ось хвата (клинка) в системе кости кисти, если оружие висит в слоте slotLocalAxis (в системе слота)
+    Tempest::Vec3 gripAxisInHand(int a, const Tempest::Vec3& slotLocalAxis) const;
+    // Ось хвата по умолчанию: от кулака в сторону большого пальца (в T-позе Biped - вперёд)
+    Tempest::Vec3 defaultGripAxis(int a) const { return gripDef[a]; }
+
+  private:
+    BodyRig() = default;
+
+    void   rebuild(std::vector<Tempest::Matrix4x4>& W, size_t b) const;
+    void   rotateTree(std::vector<Tempest::Matrix4x4>& W, size_t b, const Tempest::Vec3& at, const Tempest::Vec3& ax, float ang) const;
+    void   solveArm(std::vector<Tempest::Matrix4x4>& W, int a, const Arm& s) const;
+    void   solveLeg(std::vector<Tempest::Matrix4x4>& W, int k, const Leg& s, const Tempest::Vec3& pelFwd, float scale) const;
