+struct Ragdoll::Proxy::Part final {
+  size_t                            part = 0;
+  std::unique_ptr<btCollisionShape> shape;
+  std::unique_ptr<btRigidBody>      rb;
+  };
+
+Ragdoll::Proxy::~Proxy() {
+  if(owner==nullptr)
+    return;
+  for(auto& p:parts)
+    if(p.rb->getBroadphaseHandle()!=nullptr)
+      owner->world->removeRagdollProxy(p.rb.get());
+  }
+
+std::unique_ptr<Ragdoll::Proxy> Ragdoll::Proxy::create(DynamicWorld& owner, const Skeleton& sk, uint32_t id, bool pinnedOnly) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr)
+    return nullptr;
+  std::unique_ptr<Proxy> px(new Proxy());
+  px->owner  = &owner;
+  px->sk     = &sk;
+  px->lay    = lay;
+  px->pid    = id;
+  px->pinned = pinnedOnly;
+  for(size_t i=0; i<lay->parts.size(); ++i) {
+    auto& lp = lay->parts[i];
+    if(pinnedOnly && !lp.pinned)
+      continue;
+    Part p;
+    p.part = i;
+    p.shape.reset(new btCapsuleShapeX(lp.radius*0.01f, 2.f*lp.halfLen*0.01f));
+    btRigidBody::btRigidBodyConstructionInfo ci(0.f,nullptr,p.shape.get(),btVector3(0,0,0));
+    ci.m_friction    = 0.6f;
+    ci.m_restitution = 0.f;
+    p.rb.reset(new btRigidBody(ci));
+    p.rb->setCollisionFlags(p.rb->getCollisionFlags() | btCollisionObject::CF_KINEMATIC_OBJECT);
+    p.rb->setActivationState(DISABLE_DEACTIVATION);
+    p.rb->setUserIndex(DynamicWorld::C_RagdollProxy);
+    p.rb->setUserPointer(px.get());
+    px->parts.push_back(std::move(p));
+    }
+  return px;
+  }
+
+void Ragdoll::Proxy::update(const Matrix4x4* bones, size_t count) {
+  auto& cw = *owner->world;
+  for(auto& p:parts) {
+    auto& lp = lay->parts[p.part];
+    if(lp.bone>=count)
+      continue;
+    const btTransform t = toBt(bones[lp.bone]*lp.bodyInBone);
+    p.rb->setWorldTransform(t);
+    p.rb->setInterpolationWorldTransform(t);
+    if(p.rb->getBroadphaseHandle()==nullptr)
+      cw.addRagdollProxy(p.rb.get()); else
+      cw.updateSingleAabb(p.rb.get());
+    }
+  }
+
+bool Ragdoll::holdsWith(const btCollisionObject* part, uint32_t other) const {
+  // кисть, которая держится за этого человека или тянется к нему, в него не упирается: ладонь лежит на нём (точка
+  // хвата - на поверхности его тела), а он двигается - упор и сустав хвата спорили бы. Плечо и предплечье упираются
+  if(beh==nullptr || other==0)
+    return false;
+  for(int a=0; a<2; ++a) {
+    auto& hd = beh->bal.hand[a];
+    if(hd.src!=1 || hd.id!=other)
+      continue;
+    const size_t i = lay->hand[a]<body.size() ? lay->hand[a] : lay->fore[a];
+    if(i<body.size() && body[i].rb.get()==part)
+      return true;
+    }
+  return false;
+  }
+
+Ragdoll::ProxyContact& Ragdoll::contactOf(uint32_t other) {
+  for(auto& c:proxyContact)
+    if(c.id==other)
+      return c;
+  ProxyContact c;
+  c.id        = other;
+  c.firstStep = stepNo;
+  c.lastTouch = stepNo;
+  proxyContact.push_back(c);
+  return proxyContact.back();
+  }
+
+void Ragdoll::nearCallback(btBroadphasePair& pair, btCollisionDispatcher& disp, const btDispatcherInfo& info) {
+  auto a = static_cast<btCollisionObject*>(pair.m_pProxy0->m_clientObject);
+  auto b = static_cast<btCollisionObject*>(pair.m_pProxy1->m_clientObject);
+  if(a->getUserIndex()!=DynamicWorld::C_Ragdoll)
+    std::swap(a,b);
+  const int cb = b->getUserIndex();
+  if(a->getUserIndex()!=DynamicWorld::C_Ragdoll || (cb!=DynamicWorld::C_Ragdoll && cb!=DynamicWorld::C_RagdollProxy)) {
+    btCollisionDispatcher::defaultNearCallback(pair,disp,info);
+    return;
+    }
+  // пара не считается: и контакты, что уже были, - прочь (иначе решатель толкает по старым точкам)
+  auto skip = [&pair]() {
+    if(pair.m_algorithm==nullptr)
+      return;
+    btManifoldArray arr;
+    pair.m_algorithm->getAllContactManifolds(arr);
+    for(int i=0; i<arr.size(); ++i)
+      arr[i]->clearManifold();
+    };
+  auto r = static_cast<Ragdoll*>(a->getUserPointer());
+  if(cb==DynamicWorld::C_Ragdoll) {
+    // кукла с куклой: рука, которая держится за того человека, в него не упирается
+    auto r2 = static_cast<Ragdoll*>(b->getUserPointer());
+    if(r2!=r && (r->holdsWith(a,r2->rid) || r2->holdsWith(b,r->rid))) {
+      skip();
+      return;
+      }
+    btCollisionDispatcher::defaultNearCallback(pair,disp,info);
+    return;
+    }
+  const uint32_t other = static_cast<Proxy*>(b->getUserPointer())->id();
+  // своё тело (кукла только что ожила, Proxy ещё не убрана) - не упор
+  if((other!=0 && other==r->rid) || r->holdsWith(a,other)) {
+    skip();
+    return;
+    }
+  btCollisionDispatcher::defaultNearCallback(pair,disp,info);
+  // уже вошёл в куклу в первый шаг, как появился рядом (удар вплотную, толчок, ожившее тело на другом), -
+  // «призрак», пока не разойдутся на ~0,15 с: иначе решатель выталкивает куклу рывком
+  bool touching = false;
+  if(pair.m_algorithm!=nullptr) {
+    btManifoldArray arr;
+    pair.m_algorithm->getAllContactManifolds(arr);
+    for(int i=0; i<arr.size() && !touching; ++i)
+      for(int k=0; k<arr[i]->getNumContacts(); ++k)
+        if(arr[i]->getContactPoint(k).getDistance()<0.f) {
+          touching = true;
+          break;
+          }
+    }
+  auto& c = r->contactOf(other);
+  c.lastSeen = r->stepNo;
+  // рука упёрлась в человека, к которому тянется, - схватится там, где коснулась (tickGrab)
+  if(touching && !c.ghost)
+    for(int s=0; s<2; ++s)
+      for(size_t i:{r->lay->hand[s], r->lay->fore[s]})
+        if(i<r->body.size() && r->body[i].rb.get()==a) {
+          r->armTouch  [s] = other;
+          r->armTouchAt[s] = r->stepNo;
+          }
+  if(touching && c.firstStep+1>=r->stepNo)
+    c.ghost = true;
+  if(!c.ghost)
+    return;
+  if(touching)
+    c.lastTouch = r->stepNo; else
+  if(r->stepNo>c.lastTouch+9)
+    c.ghost = false;
+  if(c.ghost)
+    skip();
+  }
+
+void Ragdoll::gripPoints(const Skeleton& sk, const Matrix4x4* bones, size_t count, const Vec3& from, std::vector<Vec3>& out) {
+  // точка хвата - не кость (она внутри тела: рука тянулась бы в него), а поверхность части со стороны хватающего
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || bones==nullptr)
+    return;
+  for(size_t i=0; i<lay->parts.size(); ++i) {
+    const auto& p = lay->parts[i];
+    const bool  arm = (i==lay->upper[0] || i==lay->upper[1] || i==lay->fore[0] || i==lay->fore[1]);
+    if((!arm && i!=lay->chest) || p.bone>=count)
+      continue;
+    const Matrix4x4 m  = bones[p.bone]*p.bodyInBone;
+    const Vec3      c  = originOf(m);
+    const Vec3      ax = Vec3::normalize(axisOf(m,0));
+    // на оси: середина руки, у груди - ближе к хватающему по ширине
+    float t = 0;
+    if(!arm)
+      t = std::clamp(Vec3::dotProduct(from-c,ax), -p.halfLen, p.halfLen);
+    const Vec3 q = c + ax*t;
+    Vec3       d = from-q;
+    d -= ax*Vec3::dotProduct(d,ax);
+    if(d.length()<1e-3f)
+      continue;
+    out.push_back(q + Vec3::normalize(d)*p.radius);
+    }
+  }
+
+bool Ragdoll::insideSelf(const btVector3& at, float margin) const {
+  // точка в своём теле (или ближе margin к нему), м
+  for(size_t i=0; i<body.size(); ++i) {
+    const btTransform& t  = body[i].rb->getWorldTransform();
+    const btVector3    ax = t.getBasis().getColumn(0)*(lay->parts[i].halfLen*0.01f);
+    const float        d  = pointSegmentDistance(cmv(at), cmv(t.getOrigin()-ax), cmv(t.getOrigin()+ax))*0.01f;
+    if(d<lay->parts[i].radius*0.01f+margin)
+      return true;
+    }
+  return false;
+  }
+
+bool Ragdoll::reachesThroughSelf(const btVector3& from, const btVector3& to) const {
+  // рука от плеча к точке прошла бы сквозь свой корпус или голову: туда не тянуться
+  const btVector3 a = from + (to-from)*0.2f;
+  for(size_t i=0; i<body.size(); ++i) {
+    const auto k = lay->parts[i].kind;
+    if(k!=K_Pelvis && k!=K_Spine && k!=K_Neck && k!=K_Head)
+      continue;
+    const btTransform& t  = body[i].rb->getWorldTransform();
+    const btVector3    ax = t.getBasis().getColumn(0)*(lay->parts[i].halfLen*0.01f);
+    btVector3 ca, cb;
+    closestOnSegments(a, to, t.getOrigin()-ax, t.getOrigin()+ax, ca, cb);
+    if(float((ca-cb).length())<lay->parts[i].radius*0.01f-0.01f)
+      return true;
+    }
+  return false;
+  }
+
+void Ragdoll::pushOut(float dt) {
+  // Мягкий упор (softContact) у людей на ногах (S_Active: свои части Bullet там не сталкивает): предплечья и кисти -
+  // в свой корпус и голову. Тела людей рядом - в физике сами (Proxy), в них упирается решатель
+  if(dt<=0.f || body.empty())
+    return;
+  auto capsule = [this](size_t i, btVector3& a, btVector3& b) {
+    const btTransform& t  = body[i].rb->getWorldTransform();
+    const btVector3    ax = t.getBasis().getColumn(0)*(lay->parts[i].halfLen*0.01f);
+    a = t.getOrigin()-ax;
+    b = t.getOrigin()+ax;
+    };
+
+  // на экране физика рук - только в отклике на удар (show): без него рука лишь догоняет анимацию, упор её зря тормозит
+  if(st==S_Active && hasTarget && show>0.f) {
+    for(auto& pr:lay->armTrunk) {
+      const size_t i  = pr.first, r = pr.second;
+      const auto&  pa = lay->parts[i];
+      const auto&  pb = lay->parts[r];
+      const float  R  = (pa.radius+pb.radius)*0.01f;
+      btVector3 a0, a1, b0, b1, ca, cb;
+      capsule(i,a0,a1);
+      capsule(r,b0,b1);
+      closestOnSegments(a0,a1,b0,b1,ca,cb);
+      btVector3   n = ca-cb;
+      const float d = float(n.length());
+      if(d>=R)
+        continue;
+      // анимация сама кладёт руку к телу (скрещены, на поясе) - упор только сверх того, на сколько входит она
+      const btTransform& ta = drive[i].target;
+      const btTransform& tb = drive[r].target;
+      const btVector3    xa = ta.getBasis().getColumn(0)*(pa.halfLen*0.01f);
+      const btVector3    xb = tb.getBasis().getColumn(0)*(pb.halfLen*0.01f);
+      btVector3 qa, qb;
+      closestOnSegments(ta.getOrigin()-xa, ta.getOrigin()+xa, tb.getOrigin()-xb, tb.getOrigin()+xb, qa, qb);
+      const float allowed = std::max(0.f, R-float((qa-qb).length()));
+      const float depth   = (R-d) - allowed - 0.005f;
+      if(depth<=0.f || d<1e-5f)
+        continue;
+      n /= d;
+      softContact(*body[i].rb, pb.pinned ? nullptr : body[r].rb.get(), cb + n*(pb.radius*0.01f), n, depth, dt);
+      }
+    }
+  }
+
+bool Ragdoll::isGripping() const {
+  if(beh==nullptr)
+    return false;
+  for(auto& h:beh->bal.hand)
+    if(h.gripAt>=0.f)
+      return true;
+  return false;
+  }
