+// Настройки активного регдолла (подобраны на стенде tools/ragdoll-test, ragtest vis)
+constexpr float ToneLowW     = 3.5f;   // рад/с: собственная частота мышцы без тонуса (оглушена ударом) - медленно, тяжело
+constexpr float ToneHighW    = 34.f;   // рад/с: мышца в полной силе - тело идёт за анимацией
+constexpr float ToneZeta     = 1.25f;  // демпфирование мышцы: больше 1 - без перелёта и дрожи, тело «вязкое»
+constexpr float ImpulseMass  = 2.2f;   // кг: импульс удара = масса * сила удара (м/с)
+constexpr float StepThresh   = 0.09f;  // м: ступня дальше от своего места - шаг
+constexpr float StepLead     = 0.22f;  // с: ступня ставится туда, где тело будет через столько
+constexpr float StaggerDecel = 1.9f;   // м/с2: толчок гаснет (тело тормозит шагами)
+constexpr float StaggerFall  = 1.9f;   // м/с: толчок сильнее - не устоит, упадёт после первого шага
+constexpr float StaggerMax   = 2.1f;   // м/с: быстрее тело не толкается
+constexpr float MissileStagger = 1.5f; // м/с: стрела шатает, но с ног не сбивает (меньше StaggerFall)
+constexpr float LimitReturn  = 1.0f;   // рад/с: расширенный предел сустава сходится к анатомическому
+constexpr float DeadImpulse  = 7.f;    // кг: импульс удара по упавшему или убитому = масса * сила удара (м/с)
+
+// Предел скорости отклонения части от цели относительно родителя, рад/с: «тряска» - как бы ни ударили, корпус и
+// руки уходят от позы не быстрее этого (человек весом и мышцами гасит рывок), анимацию это не замедляет
+float devSpeedMax(uint8_t kind) {
+  switch(Kind(kind)) {
+    case K_Spine:    return 0.9f;
+    case K_Neck:
+    case K_Head:     return 1.8f;
+    case K_UpperArm: return 1.5f;
+    case K_ForeArm:
+    case K_Hand:     return 2.f;
+    default:         return 2.f;
+    }
+  }
+
+// IK руки (лёжа): направления плеча и предплечья в мире, чтобы начало кисти было в to; pole - куда смотрит локоть
+void armDirs(const btVector3& sh, const btVector3& to, float l1, float l2, const btVector3& pole, btVector3& du, btVector3& df) {
+  btVector3 toW = to-sh;
+  float     d   = toW.length();
+  du = toW;
+  df = toW;
+  if(d<1e-3f || l1<1e-3f || l2<1e-3f)
+    return;
+  const btVector3 dir = toW/d;
+  d = std::clamp(d, std::abs(l1-l2)+0.01f, (l1+l2)*0.98f);
+  btVector3 bend = pole - dir*pole.dot(dir);
+  if(bend.length()<1e-3f)
+    return;
+  bend.normalize();
+  const float     x  = (l1*l1 - l2*l2 + d*d)/(2.f*d);
+  const float     y  = std::sqrt(std::max(l1*l1-x*x, 0.f));
+  const btVector3 el = sh + dir*x + bend*y;
+  du = el-sh;
+  df = sh + dir*d - el;
+  }
+
+// Опора на земле (по горизонтали X, Z): выпуклая оболочка точек pts, расширенная на r. Возвращает ближайшую к p
+// точку опоры (центр давления) и out - насколько p вне опоры, м (0 - внутри)
+btVector3 supportPoint(const btVector3* pts, size_t n, const btVector3& p, float r, float& out) {
+  out = 0;
+  if(n==0)
+    return p;
+  // оболочка - монотонной цепью (Эндрю), точек мало
+  btVector3 s[8];
+  n = std::min<size_t>(n,8);
+  std::copy(pts,pts+n,s);
+  std::sort(s,s+n,[](const btVector3& a, const btVector3& b){
+    return a.x()<b.x() || (a.x()==b.x() && a.z()<b.z());
+    });
+  auto cross = [](const btVector3& o, const btVector3& a, const btVector3& b) {
+    return float((a.x()-o.x())*(b.z()-o.z()) - (a.z()-o.z())*(b.x()-o.x()));
+    };
+  btVector3 h[16];
+  size_t    k = 0;
+  for(size_t i=0; i<n; ++i) {
+    while(k>=2 && cross(h[k-2],h[k-1],s[i])<=0.f)
+      --k;
+    h[k++] = s[i];
+    }
+  for(size_t i=n-1, t=k+1; i>0; --i) {
+    while(k>=t && cross(h[k-2],h[k-1],s[i-1])<=0.f)
+      --k;
+    h[k++] = s[i-1];
+    }
+  if(k>1)
+    --k;
+  // внутри оболочки (обход против часовой в X-Z: cross > 0 слева)
+  bool inside = k>=3;
+  for(size_t i=0; i<k && inside; ++i)
+    if(cross(h[i],h[(i+1)%k],p)<0.f)
+      inside = false;
+  btVector3 q = p;
+  if(!inside) {
+    float best = 1e9f;
+    for(size_t i=0; i<std::max<size_t>(k,1); ++i) {
+      const btVector3 a  = h[i], b = h[k>1 ? (i+1)%k : i];
+      btVector3       ab = b-a;
+      ab.setY(0);
+      btVector3       ap = p-a;
+      ap.setY(0);
+      const float     l2 = float(ab.length2());
+      const float     t  = l2>1e-8f ? std::clamp(float(ap.dot(ab))/l2, 0.f, 1.f) : 0.f;
+      btVector3       c  = a + ab*t;
+      c.setY(p.y());
+      const float     d  = float((p-c).length());
+      if(d<best) {
+        best = d;
+        q    = c;
+        }
+      }
+    }
+  btVector3 d = p-q;
+  d.setY(0);
+  const float dl = float(d.length());
+  if(dl<=r)
+    return p;
+  out = dl-r;
+  return q + d*(r/dl);
+  }
+
