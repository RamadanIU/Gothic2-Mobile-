+void TouchInput::mouseDragEvent(MouseEvent& e) {
+  if(e.mouseID<0 || size_t(e.mouseID)>=fingers.size())
+    return;
+  auto&      f   = fingers[size_t(e.mouseID)];
+  const auto pos = e.pos();
+  const float d  = dp();
+  const int  dx  = pos.x-f.start.x;
+  const int  dy  = pos.y-f.start.y;
+  if(!f.moved && dx*dx+dy*dy>int(12*d)*int(12*d))
+    f.moved = true;
+
+  if(editOpen) {
+    editDrag(e.mouseID, pos);
+    f.last = pos;
+    update();
+    return;
+    }
+
+  if(mapOpen && e.mouseID==mapFinger) {
+    // Палец вверх-вниз по списку мест - листать
+    const auto l = mapLayout();
+    if(f.moved && l.list.contains(mapDownAt))
+      mapDrag = true;
+    if(mapDrag) {
+      const int total = int(mapRows().size())*l.rowH;
+      mapScroll = std::clamp(mapScroll-(pos.y-f.last.y), 0, std::max(0,total-l.list.h));
+      }
+    f.last = pos;
+    update();
+    return;
+    }
+
+  switch(f.ctl) {
+    case C_Joy:
+      joystick(f, pos);
+      break;
+    case C_Look:
+      owner.touchLook(pos.x-f.last.x, pos.y-f.last.y);
+      break;
+    case C_Main: {
+      // Свайп вбок по главной кнопке: в ближнем бою - боковой удар, с луком и магией - другая цель
+      if(std::abs(dx)>int(36*d) && std::abs(dx)>std::abs(dy)) {
+        auto pl = Gothic::inst().player();
+        const auto ws = pl!=nullptr ? pl->weaponState() : WeaponState::NoWeapon;
+        if(ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H)
+          ctrl.touchSideAttack(dx<0 ? -1 : 1);
+        else if(ws!=WeaponState::NoWeapon)
+          ctrl.touchSwitchTarget(dx<0 ? -1 : 1);
+        f.start = pos;
+        }
+      break;
+      }
+    case C_Weapon:
+    case C_Squad:
+    case C_Camera: {
+      // Потянуть кнопку - открыть колесо и выбрать направлением пальца
+      const auto kind = (f.ctl==C_Weapon ? Wheel::Weapon : (f.ctl==C_Camera ? Wheel::Camera : Wheel::Squad));
+      if(wheel==Wheel::None && f.moved)
+        openWheel(kind, e.mouseID);
+      if(wheel==kind && wheelOwner==e.mouseID)
+        wheelSel = wheelPickDir(pos-f.start);
+      break;
+      }
+    case C_List: {
+      // Палец вверх-вниз по сетке сумки - листать
+      if(currentUi()==Ui::Inventory) {
+        const int row = std::max(1, owner.touchInventoryRow());
+        f.accum += pos.y-f.last.y;
+        while(f.accum<=-row) {
+          owner.touchInventoryScroll(1);
+          f.accum += row;
+          }
+        while(f.accum>=row) {
+          owner.touchInventoryScroll(-1);
+          f.accum -= row;
+          }
+        }
+      break;
+      }
+    default:
+      break;
+    }
+  f.last = pos;
+  update();
+  }
+
+void TouchInput::mouseUpEvent(MouseEvent& e) {
+  if(e.mouseID<0 || size_t(e.mouseID)>=fingers.size())
+    return;
+  auto& f = fingers[size_t(e.mouseID)];
+  if(editOpen) {
+    if(f.ctl==C_Absorb)
+      editUp(e.mouseID, e.pos(), f.moved);
+    f = Finger();
+    update();
+    return;
+    }
+  if(mapOpen && e.mouseID==mapFinger) {
+    mapFinger = -1;
+    if(!f.moved)
+      mapTap(e.pos());
+    f = Finger();
+    update();
+    return;
+    }
+  if(confirmOpen && f.ctl==C_Absorb) {
+    if(!f.moved)
+      confirmTap(e.pos());
+    f = Finger();
+    update();
+    return;
+    }
+  release(f.ctl, f, e.pos());
+  f = Finger();
+  update();
+  }
