+const QuestLog::Quest* GameMenu::questOf(const Item& list, int32_t id) const {
+  auto ql = Gothic::inst().questLog();
+  if(ql==nullptr || list.handle==nullptr)
+    return nullptr;
+  const auto st  = toStatus(list.handle->user_string[0]);
+  int32_t    num = 0;
+  for(size_t i=0; i<ql->questCount(); ++i) {
+    auto& quest = ql->quest(ql->questCount()-i-1);
+    if(!isCompatible(quest,st))
+      continue;
+    if(num==id)
+      return &quest;
+    ++num;
+    }
+  return nullptr;
+  }
