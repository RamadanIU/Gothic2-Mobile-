+static std::string distText(float cm) {
+  // «340 м», «1,4 км»
+  char buf[32] = {};
+  const int m = int(cm/100.f+0.5f);
+  if(m<1000)
+    std::snprintf(buf,sizeof(buf),"%d м",std::max(m,1)); else
+    std::snprintf(buf,sizeof(buf),"%d,%d км",m/1000,(m%1000)/100);
+  return toCp1251(buf);
+  }
