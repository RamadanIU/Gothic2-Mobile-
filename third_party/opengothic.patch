+// Gothic II Mobile: «Путь» - карта с местами быстрого перемещения (docs/CONTROLS.md, «Путь»)
+
+bool TouchInput::isModal() const {
+  return editOpen || mapOpen || confirmOpen || ctrl.travelMode()==PlayerControl::TravelMode::Instant;
+  }
