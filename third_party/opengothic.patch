+// Поворот from -> to вектором «ось * угол» (рад) в той системе, где заданы оба (кратчайший путь)
+btVector3 rotErr(const btQuaternion& from, const btQuaternion& to) {
+  btQuaternion d = to*from.inverse();
+  if(d.getW()<0)
+    d = btQuaternion(-d.getX(),-d.getY(),-d.getZ(),-d.getW());
+  const btVector3 v(d.getX(),d.getY(),d.getZ());
+  const float     sn = v.length();
+  if(sn<1e-6f)
+    return v*2.f;
+  const float ang = 2.f*std::atan2(sn, float(d.getW()));
+  return v*(ang/sn);
+  }
+
+btQuaternion rotOf(const btVector3& rv) {
+  const float a = rv.length();
+  if(a<1e-6f)
+    return btQuaternion::getIdentity();
+  return btQuaternion(rv/a, a);
+  }
+
+// Углы анатомического сустава J_Euler: поворот потомка = Z(z)*Y(y)*X(x) в системе сустава родителя, рад
+btVector3 eulerOf(const btQuaternion& rel) {
+  const btMatrix3x3 m(rel);
+  const float y = std::asin(std::clamp(-float(m[2][0]), -1.f, 1.f));
+  const float x = std::atan2(float(m[2][1]), float(m[2][2]));
+  const float z = std::atan2(float(m[1][0]), float(m[0][0]));
+  return btVector3(x,y,z);
+  }
+
+// J_Swing: кручение вокруг X (x) и размах - повороты вокруг Y (y) и Z (z), рад
+btVector3 swingOf(btQuaternion q) {
+  if(q.getW()<0)
+    q = btQuaternion(-q.getX(),-q.getY(),-q.getZ(),-q.getW());
+  const float        tw = 2.f*std::atan2(float(q.getX()), float(q.getW()));
+  const btQuaternion qs = q*btQuaternion(btVector3(1,0,0),tw).inverse();
+  const btVector3    v(qs.getX(),qs.getY(),qs.getZ());
+  const float        sn = v.length();
+  if(sn<1e-6f)
+    return btVector3(tw,0,0);
+  const float ang = 2.f*std::atan2(sn, std::abs(float(qs.getW())));
+  const float sg  = qs.getW()<0 ? -1.f : 1.f;
+  return btVector3(tw, sg*ang*float(qs.getY())/sn, sg*ang*float(qs.getZ())/sn);
+  }
