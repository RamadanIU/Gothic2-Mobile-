+constexpr float deg(float d) { return d*float(M_PI)/180.f; }
+
+std::string upperName(std::string_view s) {
+  std::string n(s);
+  for(auto& c:n)
+    c = char(std::toupper(static_cast<unsigned char>(c)));
+  return n;
+  }
+
+bool has(const std::string& s, const char* what) {
+  return s.find(what)!=std::string::npos;
+  }
+
+Vec3 horizontal(Vec3 v) {
+  v.y = 0;
+  const float l = v.length();
+  return l>1e-4f ? v/l : Vec3();
+  }
+
+Vec3 closestOnSegment(const Vec3& p, const Vec3& a, const Vec3& b) {
+  const Vec3  ab = b-a;
+  const float l2 = Vec3::dotProduct(ab,ab);
+  const float t  = l2>1e-6f ? std::clamp(Vec3::dotProduct(p-a,ab)/l2, 0.f, 1.f) : 0.f;
+  return a+ab*t;
+  }
+
+Vec3 transformDir(const Matrix4x4& m, const Vec3& v) {
+  return axis(m,0)*v.x + axis(m,1)*v.y + axis(m,2)*v.z;
+  }
+
