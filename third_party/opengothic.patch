+std::string TouchInput::fit(std::string txt, int maxW, float scale) const {
+  auto& fnt = Resources::font(Resources::FontType::Normal, Gothic::interfaceScale(this)*scale);
+  if(fnt.textSize(txt).w<=maxW)
+    return txt;
+  while(txt.size()>1 && fnt.textSize(txt+"..").w>maxW)
+    txt.pop_back();
+  return txt+"..";
