+void Ragdoll::obstaclesOf(const Skeleton& sk, const Matrix4x4* bones, size_t count, uint32_t id, bool pinnedOnly,
+                          std::vector<Obstacle>& out) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || bones==nullptr)
+    return;
+  for(auto& p:lay->parts) {
+    if(p.bone>=count || (pinnedOnly && !p.pinned))
+      continue;
+    const Matrix4x4 m  = bones[p.bone]*p.bodyInBone;
+    const Vec3      c  = originOf(m);
+    const Vec3      ax = Vec3::normalize(axisOf(m,0))*p.halfLen;
+    Obstacle o;
+    o.a  = c-ax;
+    o.b  = c+ax;
+    o.r    = p.radius;
+    o.id   = id;
+    o.bone = uint16_t(p.bone);
+    out.push_back(o);
+    }
+  }
