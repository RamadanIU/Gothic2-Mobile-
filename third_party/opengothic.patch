+void AiNpc::onHit(Npc& attacker, Npc& victim) {
+  if(geralt==nullptr || !AiLink::enabled())
+    return;
+  auto* w = world();
+  if(w==nullptr)
+    return;
+  // Кто кого бьёт рядом - чтобы знать, кто убил (событие death)
+  if(&victim!=geralt && victim.qDistTo(*geralt)<SeeDist*SeeDist) {
+    auto& k    = known[&victim];
+    if(attacker.isPlayer())
+      k.hitBy = "убил(а) герой";
+    else if(&attacker==geralt)
+      k.hitBy = "от твоей руки";
+    else
+      k.hitBy = "убил(а) "+fromCp1251(attacker.displayName());
+    k.lastSeen = owner.tickCount();
+    }
+  if(&victim==geralt) {
+    if(attacker.isPlayer())
+      sendEvent("hero_hit_me","Герой ударил тебя.",&attacker);
+    else
+      sendEvent("hit","Тебя ударил(а) "+fromCp1251(attacker.displayName())+".",&attacker);
+    return;
+    }
+  if(attacker.isPlayer() && victim.qDistTo(*geralt)<SeeDist*SeeDist && !victim.isMonster())
+    sendEvent("hero_attacks","Герой напал на "+fromCp1251(victim.displayName())+".",&victim);
+  else if(&attacker==geralt)
+    return;
+  else if(victim.isPlayer() && attacker.qDistTo(*geralt)<SeeDist*SeeDist)
+    sendEvent("hero_attacked","На героя напал(а) "+fromCp1251(attacker.displayName())+".",&attacker);
+  }
+
+void AiNpc::sendEvent(std::string_view kind, std::string_view text, Npc* who) {
+  // События одного рода - не чаще раза в 4 с: удар за ударом - одно событие
+  const uint64_t now = owner.tickCount();
+  static std::unordered_map<std::string,uint64_t> lastAt;
+  auto& t = lastAt[std::string(kind)];
+  if(t!=0 && now<t+4000 && now>=t)
+    return;
+  t = now;
+
+  rapidjson::StringBuffer buf;
+  JsonOut w(buf);
+  w.StartObject();
+  put(w,"ev","event");
+  put(w,"kind",kind);
+  put(w,"text",text);
+  if(who!=nullptr)
+    put(w,"who",refOf(*who));
+  w.EndObject();
+  AiLink::send(buf.GetString());
+  }
+
+void AiNpc::tickEvents(uint64_t now) {
+  if(now<eventTick)
+    return;
+  eventTick = now+300;
+  auto* w  = world();
+  Npc*  pl = w->player();
+  if(pl==nullptr)
+    return;
+
+  // Герой подошёл или ушёл
+  const float d = dist(*pl,*geralt);
+  if(!heroNear && d<NearDist && !talking) {
+    heroNear = true;
+    if(now>heroNearAt+90000 || heroNearAt==0)
+      sendEvent("hero_near","Герой подошёл к тебе.",pl);
+    heroNearAt = now;
+    }
+  else if(heroNear && d>LeftDist) {
+    heroNear = false;
+    sendEvent("hero_left","Герой ушёл.",pl);
+    }
+
+  // Сам без сознания / очнулся
+  const bool down = geralt->isUnconscious();
+  if(down && !wasDown)
+    sendEvent("down","Тебя сбили с ног, ты без сознания.",nullptr);
+  else if(!down && wasDown)
+    sendEvent("up","Ты пришёл в себя.",nullptr);
+  wasDown = down;
+
+  // Враги рядом и смерти: каждого - один раз
+  w->detectNpc(geralt->position(),SeeDist,[&](Npc& n) {
+    if(&n==geralt || n.isPlayer())
+      return;
+    auto& k = known[&n];
+    const bool dead = n.isDead();
+    if(dead && !k.dead && k.lastSeen!=0)
+      sendEvent("death",fromCp1251(n.displayName())+" погиб(ла) неподалёку"+
+                (k.hitBy.empty() ? std::string(".") : " - "+k.hitBy+"."),&n);
+    k.dead = dead;
+    if(dead)
+      return;
+    const bool hostile = (owner.personAttitude(n,*geralt)==ATT_HOSTILE) && !n.isUnconscious();
+    if(hostile && !k.hostile && n.qDistTo(*geralt)<1500.f*1500.f && geralt->canSeeNpc(n,false))
+      sendEvent("enemy","Враг рядом: "+fromCp1251(n.displayName())+".",&n);
+    k.hostile  = hostile;
+    k.lastSeen = now;
+    });
+  for(auto it=known.begin(); it!=known.end();) {
+    if(now>it->second.lastSeen+60000)
+      it = known.erase(it); else
+      ++it;
+    }
+  }
+
+void AiNpc::cancelBody(Npc* actor, std::string_view why) {
+  for(auto& a:acts)
+    if(!a.closed && a.actor==actor)
+      finish(a,false,std::string("прервано: ")+std::string(why));
+  acts.erase(std::remove_if(acts.begin(),acts.end(),[](const Action& a){ return a.closed; }),acts.end());
+  }
+
+void AiNpc::finish(Action& a, bool ok, std::string_view note, std::string_view story) {
+  if(a.closed)
+    return;
+  a.closed = true;
+  Log::i("[g2m] ai: act ",a.name,ok ? " ok: " : " fail: ",note);
+  // Дело в отряде кончилось - отряд снова ведёт его строем (GameScript::tickSquadFollow). Подошёл поговорить
+  // (talk_to_npc) - ещё 15 с на беседу, не уходить посреди фразы
+  if(a.begun && a.actor!=nullptr && isErrand(a.name) && npcAlive(a.actor))
+    a.actor->companionFollow.holdTo = (a.name=="approach" && ok) ? owner.tickCount()+15000 : 0;
+  if(!a.report || a.id.empty())
+    return;
+  a.report = false;
+  rapidjson::StringBuffer buf;
+  JsonOut w(buf);
+  w.StartObject();
+  put(w,"ev","act_done");
+  put(w,"id",a.id);
+  put(w,"name",a.name);
+  w.Key("ok");
+  w.Bool(ok);
+  put(w,"note",note);
+  if(!story.empty()) {
+    // Итог сюжетной темы (cmdStory) - готовый объект JSON
+    w.Key("story");
+    w.RawValue(story.data(),story.size(),rapidjson::kObjectType);
+    }
+  w.EndObject();
+  AiLink::send(buf.GetString());
+  }
+
+const WayPoint* AiNpc::placeByName(std::string_view name) {
+  auto* w = world();
+  if(w==nullptr || name.empty())
+    return nullptr;
+  std::vector<TravelPoints::Spot> spots;
+  TravelPoints::resolve(*w,spots);
+  for(auto& s:spots)
+    if(s.point!=nullptr && name==s.point->name)
+      return s.way!=nullptr ? s.way : s.at;
+  // Похожее имя: модель могла сократить («башня Ксардаса» вместо «У башни Ксардаса»)
+  for(auto& s:spots)
+    if(s.point!=nullptr && std::string_view(s.point->name).find(name)!=std::string_view::npos)
+      return s.way!=nullptr ? s.way : s.at;
+  // Имя точки мира
+  if(auto wp = w->findPoint(upper(name),false))
+    return wp;
+  return nullptr;
+  }
