+void Camera::setDirector(const Tempest::Vec3& from, const Tempest::Vec3& at, bool cut, bool collide) {
+  if(!director.on)
+    cut = true; // первый ракурс - без перелёта от обычной камеры
+  director.on      = true;
+  director.cut     = director.cut || cut;
+  director.collide = collide;
+  director.from    = from;
+  director.at      = at;
+  }
+
+void Camera::clearDirector() {
+  if(!director.on)
+    return;
+  director.on = false;
+  // Обычная камера продолжает отсюда: цель - герой (а не место, где она была до пути), за спиной героя
+  if(auto pl = Gothic::inst().player()) {
+    const auto& def = cameraDef();
+    state.target = pl->cameraBone(false);
+    inter.target = state.target;
+    veloTrans    = Vec3();
+    state.spin   = Vec3(def.best_elevation, pl->rotation()+def.best_azimuth, def.best_rot_z);
+    }
+  }
+
+void Camera::tickDirector(float dtF) {
+  // Gothic II Mobile: откуда и куда смотреть - от TravelCamera; стена между героем и камерой - камера ближе
+  auto dest = director.from;
+  if(director.collide)
+    dest = director.at + calcCameraColision(director.at, director.from-director.at);
+  if(director.cut || dtF<=0.f)
+    origin = dest; else
+    origin = origin + (dest-origin)*std::min(1.f, 5.f*dtF);
+  director.cut = false;
+  inter.target = director.at;
+  angles       = calcLookAtAngles(origin, director.at, Vec3(0), state.spin);
+  }
