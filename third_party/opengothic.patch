+void InventoryMenu::takeAll() {
+  if(!canTakeAll())
+    return;
+  // Сначала список: перенос меняет инвентарь, по которому идём
+  const bool       fromChest = (state==State::Chest);
+  const Inventory& from      = fromChest ? chest->inventory() : trader->inventory();
+  std::vector<std::pair<size_t,size_t>> items;
+  for(auto it = from.iterator(fromChest ? Inventory::T_Inventory : Inventory::T_Ransack); it.isValid(); ++it)
