+Vec3 Npc::aimChest() const {
+  // Куда целиться в этого NPC (прицел с автонаведением, стрелы NPC): середина груди - часть груди куклы в позе
+  // кадра; без схемы тела - середина габаритов
+  if(auto sk = visual.visualSkeleton()) {
+    auto& pose = visual.pose();
+    Vec3  at;
+    if(Ragdoll::chestPoint(*sk, pose.transform(), pose.boneCount(), at))
+      return at;
+    }
+  return collosionCenter();
+  }
+
+bool Npc::rangedHitTest(const Vec3& a, const Vec3& b, float coarse, DynamicWorld::BulletHit& hit) const {
+  // Стрела пролетела a-b: задела ли тело - по капсулам частей куклы в позе кадра (Ragdoll::rayTest); у скелета
+  // без схемы - по габаритам, как в игре (coarse < 0 - мимо них)
+  if(auto sk = visual.visualSkeleton(); sk!=nullptr && Ragdoll::hasLayout(*sk)) {
+    auto&           pose = visual.pose();
+    Ragdoll::RayHit rh;
+    if(!Ragdoll::rayTest(*sk, pose.transform(), pose.boneCount(), a, b, rh))
+      return false;
+    hit.t    = rh.t;
+    hit.at   = rh.at;
+    hit.bone = rh.bone;
+    hit.zone = rh.zone;
+    return true;
+    }
+  if(coarse<0.f)
+    return false;
+  hit.t    = coarse;
+  hit.at   = a+(b-a)*coarse;
+  hit.bone = size_t(-1);
+  hit.zone = Ragdoll::Z_Body;
+  return true;
+  }
+
+void Npc::stickArrow(MeshObjects::Mesh&& view, const Vec3& at, const Vec3& dir, size_t bone) {
+  // Стрела остаётся в теле, куда вошла (RangedAim::StuckTime): наконечник чуть глубже точки входа, древко - по
+  // полёту. Модель летящей стрелы смотрит наконечником в -X (DynamicWorld::BulletBody::matrix)
+  if(bone==size_t(-1) || view.isEmpty() || dir.length()<1e-4f)
+    return;
+  Vec3  tip = {};
+  float len = 60.f;
+  if(auto proto = view.protoMesh()) {
+    auto bb = proto->bbox();
+    tip = Vec3(bb[0].x, (bb[0].y+bb[1].y)*0.5f, (bb[0].z+bb[1].z)*0.5f);
+    len = std::max(bb[1].x-bb[0].x, 1.f);
+    }
+  const Vec3  d     = Vec3::normalize(dir);
+  const float depth = std::clamp(len*0.15f, 4.f, 12.f);
+  const Vec3  tipW  = at + d*depth;
+  const float a2    = std::asin(std::clamp(d.y,-1.f,1.f))*float(180/M_PI);
+  const float ang   = std::atan2(d.z,d.x)*float(180/M_PI)+180.f;
+  Matrix4x4 m = Matrix4x4::mkIdentity();
+  m.translate(tipW);
+  m.rotateOY(-ang);
+  m.rotateOZ(-a2);
+  m.translate(-tip.x,-tip.y,-tip.z);
+  visual.addStuck(std::move(view), bone, m, owner.tickCount()+RangedAim::StuckTime);
+  }
+
+float Npc::rangedSpread() {
+  // Разброс по умению стрелка: в Gothic II - умение «Лук»/«Арбалет», в Gothic I шанс попадания был ловкостью
+  auto       rgn = currentRangedWeapon();
+  const bool cb  = rgn!=nullptr && rgn->isCrossbow();
+  int skill = 0;
+  if(Gothic::inst().version().game==1)
+    skill = hnpc->attribute[ATR_DEXTERITY]; else
+    skill = hnpc->hitchance[cb ? TALENT_CROSSBOW : TALENT_BOW];
+  return RangedAim::spreadDeg(skill);
+  }
+
+void Npc::setRangedAim(const Vec3& at) {
+  rangedAimAt   = at;
+  rangedAimTick = owner.tickCount();
+  }
+
+Vec3 Npc::rangedLaunch(const Vec3& from, Interactive* focOverride, bool crossbow) {
+  // Куда летит стрела: герой - в точку прицела (PlayerControl::tickRangedAim, задаётся каждый кадр с луком в руках),
+  // NPC - в грудь своей цели, иначе - в предмет мира или прямо перед собой; разброс - случайная точка в круге
+  // прицела. Скорость вылета - чтобы по параболе прийти в эту точку
+  const uint64_t now = owner.tickCount();
+  Vec3 at;
+  if(isPlayer() && rangedAimTick!=uint64_t(-1) && now>=rangedAimTick && now-rangedAimTick<=250) {
+    at = rangedAimAt;
+    }
+  else if(currentTarget!=nullptr) {
+    at = currentTarget->aimChest();
+    }
+  else if(focOverride!=nullptr) {
+    at = focOverride->position();
+    }
+  else {
+    const float a = rotationRad();
+    at = from + Vec3(std::cos(a), 0, std::sin(a))*3000.f;
+    }
+  auto&       sc = owner.script();
+  const float u1 = float(sc.rand(10000))/10000.f;
+  const float u2 = float(sc.rand(10000))/10000.f;
+  at = RangedAim::scatter(from, at, rangedSpread(), u1, u2);
+  return RangedAim::launch(from, at, crossbow ? RangedAim::CrossbowSpeed : RangedAim::BowSpeed, DynamicWorld::gravity);
+  }
+
+float Npc::limpNow(uint64_t now) const {
+  // хромота слабеет к концу срока (последние 40 %)
+  if(limpLeg<0 || now>=limpUntil || limpUntil<=limpFrom)
+    return 0.f;
+  const float t = float(now-limpFrom)/float(limpUntil-limpFrom);
+  return limpPower*(t<0.6f ? 1.f : 1.f-LimbIk::smooth((t-0.6f)/0.4f));
+  }
+
+void Npc::tickInjury() {
+  // Слой ран для позы (Pose::setInjury): рука к ране - через 0,2 с после удара, подносит за 0,65 с, держит, убирает
+  // за 0,8 с (WoundReach); хромота; здоровья меньше четверти - горбится. Лёжа, в воде, за станком и у героя - нет
+  Injury         inj;
+  const uint64_t now = owner.tickCount();
+  const bool     can = !isPlayer() && !isDown() && interactive()==nullptr && !isSwim() && !isDive() &&
+                       (ragdoll==nullptr || ragdoll->state()==Ragdoll::S_Active);
+  if(wound.active()) {
+    // рана прошла - рука убрана, но рана помнится: встав после падения, снова за неё схватится (ragdollGetUp)
+    const float w = wound.weight(int64_t(now));
+    if(can && w>0.f) {
+      inj.arm    = wound.cur.arm;
+      inj.bone   = wound.cur.bone;
+      inj.local  = wound.cur.local;
+      inj.normal = wound.cur.normal;
+      inj.reach  = w;
+      }
+    }
+  if(limpLeg>=0) {
+    const float hpMax = float(std::max(attribute(ATR_HITPOINTSMAX),1));
+    // вылечился - хромота проходит за пару секунд
+    if(float(attribute(ATR_HITPOINTS))>=0.95f*hpMax && limpUntil>now+2000)
+      limpUntil = now+2000;
+    if(now>=limpUntil) {
+      limpLeg = -1;
+      }
+    else if(can) {
+      inj.leg  = limpLeg;
+      inj.limp = limpNow(now);
+      }
+    }
+  if(can && !isDead()) {
+    const float hp = float(attribute(ATR_HITPOINTS))/float(std::max(attribute(ATR_HITPOINTSMAX),1));
+    if(hp<0.25f)
+      inj.hunch = (0.25f-hp)/0.25f*0.7f;
+    inj.pain     = painNow(now);
+    inj.painSide = painSide;
+    }
+  // герой с разбега: плечо вперёд или руки - толкнуть (tickShove)
+  if(isPlayer() && shoveBrace>0.f) {
+    inj.brace     = shoveBrace;
+    inj.braceKind = shoveKind;
+    inj.braceSide = shoveSide;
+    inj.braceAt   = shoveAt;
+    inj.braceHit  = shoveHitAt!=0 ? LimbIk::envelope(float(now-shoveHitAt)/1000.f, 0.06f, 0.12f, 0.3f) : 0.f;
+    }
+  // дальние - без слоя: его не разглядеть, а кости считать надо
+  float dist = 0;
+  bool  keep = false;
+  if(inj.isActive() && (!ragdollViewDistance(dist,keep) || dist>Ragdoll::StartDist))
+    inj = Injury();
+  if(!inj.isActive() && !injuryShown)
+    return;
+  visual.setInjury(inj);
+  injuryShown = inj.isActive();
+  }
+
+bool Npc::isStandingPose() const {
+  // стоит на ногах (а не летит, не лежит, не плывёт): таз выше земли под ногами
+  if(mvAlgo.isInAir() || mvAlgo.isFalling() || isSwim() || isDive() || interactive()!=nullptr)
+    return false;
+  const auto root = visual.pose().rootBone();
+  return root.at(3,1)-y > 50.f*sz[1];
+  }
+
+void Npc::tickRagdollActive() {
+  const uint64_t now = owner.tickCount();
+  float dist = 0;
+  bool  keep = false;
+  const bool seen = ragdollViewDistance(dist,keep);
+  // ушёл из физики (место отдано падающим), в воду, к станку, телепорт, далеко - сразу в анимацию
+  if(!ragdoll->isSimulated() || !seen || dist>1.5f*Ragdoll::ActiveDist || isSwim() || isDive() ||
+     interactive()!=nullptr || mvAlgo.isClimb() || ragVelocity.length()>2.f || !Gothic::options().ragdollActive) {
+    endRagdollActive(true);
+    return;
+    }
+  ragdoll->setViewDistance(dist,keep);
+
+  // сбит с ног: центр масс ушёл за ступни, пока тело шаталось - падает та же кукла, встаёт сам
+  if(ragdoll->lostBalance() && Gothic::options().ragdollKnockdown && !isDown()) {
+    ragKnock = true;
+    startRagdollFall();
+    if(isRagdollFall())
+      return;
+    ragKnock = false;
+    }
+  // в полёте (прыжок, обрыв) кукла идёт за анимацией; дольше RagdollFallDelay - та же кукла падает (Npc::tick)
+
+  // толчок уводит NPC: ступни переступают (кукла), сам NPC двигается с проверкой столкновений; упёрся - стоит
+  if(const Vec3 rm = ragdoll->takeRootMotion(); rm.x!=0.f || rm.z!=0.f) {
+    if(!tryMove(Vec3(rm.x,0,rm.z)))
+      ragdoll->rootBlocked();
+    }
+
+  // цель мышц - поза анимации этого кадра; поза прошлого обновления - со сдвигом NPC с тех пор (толчок, шаг):
+  // иначе ступни и таз отставали бы на кадр перемещения
+  visual.pose().animPose(ragTarget);
+  {
+  const auto& tr = visual.transform();
+  const Vec3  d  = position() - Vec3(tr.at(3,0),tr.at(3,1),tr.at(3,2));
+  if(d.x!=0.f || d.y!=0.f || d.z!=0.f)
+    for(auto& m:ragTarget) {
+      m.set(3,0,m.at(3,0)+d.x);
+      m.set(3,1,m.at(3,1)+d.y);
+      m.set(3,2,m.at(3,2)+d.z);
+      }
+  }
+  ragdoll->setTarget(ragTarget, now-ragTargetAt);
+  ragTargetAt = now;
+
+  if(ragFadeStart==0 && now>=ragReactUntil && ragdoll->reaction()<0.05f && !ragdoll->isStaggering())
+    ragFadeStart = now;
+  if(ragFadeStart!=0 && now>=ragFadeStart+RagdollFadeTime)
+    endRagdollActive(true);
+  }
+
+void Npc::endRagdollActive(bool now) {
+  if(ragdoll==nullptr || ragdoll->state()!=Ragdoll::S_Active)
+    return;
+  if(!now) {
+    if(ragFadeStart==0)
+      ragFadeStart = owner.tickCount();
+    return;
+    }
+  ragdoll.reset();
+  ragFadeStart = 0;
+  ragShown     = -1;
+  visual.clearRagdollPose();
+  }
+
+void Npc::applyRagdollHit() {
+  if(ragdoll==nullptr || ragHit.time!=owner.tickCount() || ragHit.power<=0.f)
+    return;
+  Ragdoll::Hit h;
+  h.at    = ragHit.at;
+  h.dir   = ragHit.dir;
+  h.power = ragHit.power;
+  ragdoll->hit(h);
+  ragHit.power = 0;
+  }
+
+void Npc::startRagdoll(bool death) {
+  const auto st = death ? Ragdoll::S_Dead : Ragdoll::S_Unconscious;
+  // собирался встать - уже нет
+  ragRiseAt     = 0;
+  ragGetUpUntil = 0;
+  if(ragdoll!=nullptr && ragBlendStart!=0) {
+    // сбили, пока вставал: новая кукла - из той позы, в которой он сейчас
+    ragdoll.reset();
+    ragBlendStart = 0;
+    visual.clearRagdollPose();
+    }
+  if(ragdoll!=nullptr && ragdoll->state()==Ragdoll::S_Active && !ragdoll->isSimulated()) {
+    // активная кукла уже ушла из физики (место отдано другим) - падает новая
+    endRagdollActive(true);
+    }
+  if(ragdoll!=nullptr) {
+    // уже лежит: оглушённого добили, лежащего ударили - тело снова двигается; на ногах по физике
+    // (активный регдолл) - та же кукла падает, из позы, в которой его застал удар: сначала оседает
+    const bool wasActive = ragdoll->state()==Ragdoll::S_Active || ragdoll->state()==Ragdoll::S_Balance;
+    ragdoll->setState(st);
+    if(wasActive)
+      ragdoll->startSag();
+    startRagdollThroes(death);
+    applyRagdollHit();
+    ragFadeStart = 0;
+    ragPushedVer = 0;
+    ragFollowVer = 0;
+    return;
+    }
+  if(!ragdollAllowed())
+    return;
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr)
+    return;
+
+  auto& pose = visual.pose();
+  // скелет ещё ни разу не считался (NPC только появился) - кукле не с чего начать
+  const auto root = pose.rootBone();
+  if((Vec3(root.at(3,0),root.at(3,1),root.at(3,2))-position()).length()>500.f)
+    return;
+  float dist = 0;
+  bool  keep = false;
+  ragdollViewDistance(dist,keep);
+  // в физике нет места (большая драка) - падает анимацией игры, как без регдолла
+  const bool standing = isStandingPose();
+  ragdoll = Ragdoll::create(*owner.physic(), *sk, pose.transform(), pose.boneCount(), st, dist, keep);
+  if(ragdoll==nullptr)
+    return;
+
+  Vec3 v = ragVelocity*10.f; // см/мс -> м/с
+  if(v.length()>20.f)
+    v = Vec3(); // телепорт, а не бег
+  ragdoll->setVelocity(v);
+  // стоял - сначала оседает: ноги подгибаются, рука к ране, потом тело падает
+  if(standing)
+    ragdoll->startSag();
+  // легло - агония (рана - от этого удара)
+  startRagdollThroes(death);
+  applyRagdollHit();
+  ragBlendStart = 0;
+  ragPushedVer  = 0;
+  ragFollowVer  = 0;
+  }
+
+void Npc::startRagdollThroes(bool death) {
+  // Агония убитого и оглушение (Ragdoll::startThroes): легло - корчится, держится за рану, пытается встать и падает;
+  // дышит (ragBreath) - умирающий часто и судорожно, потом всё реже, оглушённый - ровно, пока не встанет. Добитый
+  // умирает сразу; далеко от героя и камеры агонии нет (её никто не разглядит, а физика не бесплатна)
+  const uint64_t now = owner.tickCount();
+  ragBreath.stop();
+  if(ragdoll==nullptr || (ragdoll->state()!=Ragdoll::S_Dead && ragdoll->state()!=Ragdoll::S_Unconscious))
+    return;
+  const bool finish = ragHit.time==now && ragHit.finish;
+  if(!Gothic::options().ragdollThroes || finish) {
+    ragdoll->stopThroes();
+    return;
+    }
+  auto&          sc   = owner.script();
+  const uint32_t seed = uint32_t(hnpc->id)*2654435761u ^ uint32_t(now) ^ uint32_t(sc.rand(65536));
+  // дышит и вдали (видно, когда подойдут ближе RagdollBreathDist - pushRagdollPose)
+  ragBreath.start(death ? Breathing::Dying : Breathing::Steady, int64_t(now), seed);
+  float dist = 0;
+  bool  keep = false;
+  if(isPlayer() || !ragdollViewDistance(dist,keep) || dist>Ragdoll::ThroesDist) {
+    ragdoll->stopThroes();
+    return;
+    }
+  // сил тем меньше, чем сильнее убивший удар (разбился, сгорел - как от среднего удара); герой агонии не играет -
+  // его тело ведёт игрок, но и он дышит
+  const float luck = float(sc.rand(1000))/1000.f;
+  const float dmg  = (ragHit.time==now) ? ragHit.damage : 0.3f;
+  const float life = death ? std::clamp(1.1f - 1.4f*dmg, 0.05f, 1.f)*(0.7f + 0.5f*luck) : 0.6f + 0.4f*luck;
+  ragdoll->startThroes(life, true, seed);
+  }
+
+void Npc::tickRagdoll() {
+  // собрался лёжа и поза куклы перешла в позу начала подъёма - встаёт анимацией
+  if(ragRiseAt!=0 && owner.tickCount()>=ragRiseAt && (ragdoll==nullptr || ragBlendStart!=0))
+    ragdollRise();
+  if(ragdoll==nullptr)
+    return;
+  ragdoll->setId(gripId());
+  // кукла в физике: люди рядом (живые, застывшие тела) нужны ей телами - упираться в них (Ragdoll::Proxy)
+  if(ragdoll->isSimulated()) {
+    const uint64_t now = owner.tickCount();
+    owner.detectNpc(position(), 350.f, [&](Npc& n) {
+      if(&n!=this)
+        n.ragProxyWant = now;
+      });
+    }
+  if(ragBlendStart==0) {
+    // дальние куклы считаются проще; ушли от тела далеко - оно застывает (но не посреди падения: замерло бы стоя)
+    if(ragdoll->isSimulated()) {
+      float dist = 0;
+      bool  keep = false;
+      if(ragdollViewDistance(dist,keep)) {
+        ragdoll->setViewDistance(dist,keep);
+        if(!keep && dist>Ragdoll::FreezeDist &&
+           (ragdoll->simulatedTime()>=Ragdoll::SettleMinTime || dist>2.f*Ragdoll::FreezeDist))
+          ragdoll->freeze();
+        }
+      }
+    if(ragdoll->state()==Ragdoll::S_Active) {
+      tickRagdollActive();
+      return;
+      }
+    if(ragdoll->state()==Ragdoll::S_Balance) {
+      tickRagdollBalance();
+      return;
+      }
+    if(ragdoll->state()==Ragdoll::S_GetUp) {
+      tickRagdollGetUp();
+      return;
+      }
+    // мышцы упавшего тянут к анимации под куклой: убитый оседает по анимации смерти, падающий живой напряжён
+    if(ragdoll->isSimulated()) {
+      visual.pose().animPose(ragTarget);
+      ragdoll->setTarget(ragTarget, ragTargetAt!=0 ? owner.tickCount()-ragTargetAt : 0);
+      ragTargetAt = owner.tickCount();
+      }
+    if(ragdoll->state()==Ragdoll::S_Fall) {
+      tickRagdollFall();
+      return;
+      }
+    const auto bs = bodyStateMasked();
+    if(!isDown() && bs!=BS_DEAD && bs!=BS_UNCONSCIOUS && bs!=BS_LIE) {
+      // ожил не через AI_StandUp (скрипт, превращение): поза куклы просто переходит в анимацию
+      ragdoll->freeze();
+      ragBlendStart = owner.tickCount();
+      ragPushedVer  = 0;
+      ragBreath.stop();
+      return;
+      }
+    // дыхание: умирающий дышит часто, пока корчится, потом всё реже
+    if(ragBreath.active())
+      ragBreath.tick(int64_t(owner.tickCount()), ragdoll->inThroes());
+    followRagdoll();
+    return;
+    }
+  if(owner.tickCount()>=ragBlendStart+ragBlendTime) {
+    ragdoll.reset();
+    ragBlendStart = 0;
+    ragBlendTime  = RagdollBlendTime;
+    visual.clearRagdollPose();
+    }
+  }
+
+void Npc::tickSeparate(uint64_t dt) {
+  // Gothic II Mobile: двое вошли друг в друга - их поставили без проверки столкновений (телепорт отставшего напарника,
+  // расстановка после «Пути», подъём после регдолла, скрипт). Движок разрешает стоящему внутри другого двигаться, лишь
+  // бы не глубже (DynamicWorld::NpcItem::implTryMove) - так они и ходили слипшись, напарник внутри героя. Вошедшие
+  // расходятся сами: каждый от другого, не быстрее 1 м/с; герой стоит - отходит NPC
+  if(dt==0 || isPlayer() || isDown() || interactive()!=nullptr || isInAir() || isSwim())
+    return;
+  if(ragdoll!=nullptr && ragdoll->isSimulated() && ragdoll->state()!=Ragdoll::S_Active)
+    return;
+  auto pl = owner.player();
+  if(pl!=nullptr && qDistTo(*pl)>4000.f*4000.f)
+    return;
+  DynamicWorld::CollisionTest out;
+  if(!physic.hasCollision(out) || out.npc==nullptr || out.npc==this || out.npcCol<0.5f)
+    return;
+  Vec3 dir = position()-out.npc->position();
+  dir.y = 0;
+  if(dir.length()<1.f) {
+    // стоят в одной точке - в разные стороны (у каждого свой угол)
+    const float a = float(reinterpret_cast<uintptr_t>(this)%360u)*float(M_PI)/180.f;
+    dir = Vec3(std::cos(a),0,std::sin(a));
+    }
+  const float step = std::min(2.f*out.npcCol, 100.f*float(dt)/1000.f);
+  tryMove(Vec3::normalize(dir)*step);
+  }
+
+void Npc::tickRagdollProxy() {
+  // Тело этого NPC для кукол рядом (Ragdoll::Proxy): капсулы частей тела в позе кадра. Только пока кукла рядом
+  // просит (ragProxyWant) и своей куклы в физике нет; у активной куклы (отклик на удар) - только таз и ноги (руки и
+  // корпус у неё сами в физике). Падающее тело и руки упираются в живых и в лежащих, а не проходят насквозь
+  const uint64_t now  = owner.tickCount();
+  const bool     act  = ragdoll!=nullptr && ragdoll->isSimulated() && ragdoll->state()==Ragdoll::S_Active;
+  const bool     own  = ragdoll!=nullptr && ragdoll->isSimulated() && !act;
+  auto           sk   = visual.visualSkeleton();
+  if(own || ragProxyWant==0 || now>ragProxyWant+300 || sk==nullptr || isInWater() || owner.physic()==nullptr) {
+    ragProxy.reset();
+    return;
+    }
+  if(ragProxy==nullptr || &ragProxy->skeleton()!=sk || ragProxy->isPinnedOnly()!=act || ragProxy->id()!=gripId())
+    ragProxy = Ragdoll::Proxy::create(*owner.physic(), *sk, gripId(), act);
+  if(ragProxy==nullptr)
+    return;
+  auto& pose = visual.pose();
+  ragProxy->update(pose.transform(), pose.boneCount());
+  }
+
+void Npc::followRagdoll() {
+  if(!ragdoll->isSimulated() && ragdoll->version()==ragFollowVer)
+    return;
+  ragFollowVer = ragdoll->version();
+
+  const Vec3 p = ragdoll->rootPosition();
+  auto       g = owner.physic()->landRay(p+Vec3(0,50,0), 600);
+  const float ny = g.hasCol ? g.v.y : p.y-20.f;
+  if(std::abs(p.x-x)+std::abs(p.z-z)+std::abs(ny-y)>1.f)
+    setPosition(p.x,ny,p.z);
+  }
+
+void Npc::ragdollGetUp() {
+  // Встаёт, как человек, - анимацией подъёма игры, с той стороны, как лежит (на спине - T_WOUNDED_2_STAND, на животе -
+  // T_WOUNDEDB_2_STAND). Перед ней тело собирается лёжа в позу её первого кадра: по физике (S_GetUp - руки и ноги
+  // подтягиваются по земле, RagdollGatherTime), затем поза куклы за RagdollRiseBlend переходит в эту позу, и только
+  // потом анимация поднимает тело (ragdollRise). Поза куклы не смешивается с уже поднимающейся анимацией: иначе тело
+  // «всплывает» целиком, будто его тянут вверх за голову. Нет места в физике или выключено - сразу переход позы
+  const uint64_t now = owner.tickCount();
+  ragBreath.stop();
+  ragGetUpUntil = 0;
+  ragRiseAt     = 0;
+  auto blend = [this,now](uint64_t ms) {
+    ragdoll->freeze();
+    ragBlendStart = now;
+    ragBlendTime  = ms;
+    ragPushedVer  = 0;
+    };
+
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr) {
+    blend(RagdollBlendTime);
+    return;
+    }
+
+  // Лежит на спине или на животе - подъём из той же позы. Какая анимация какая, видно по её первому кадру
+  const bool onBack = ragdoll->chestFront().y>0.f;
+  static const char* lie[] = {"S_WOUNDED",         "S_WOUNDEDB"};
+  static const char* up [] = {"T_WOUNDED_2_STAND", "T_WOUNDEDB_2_STAND"};
+  std::vector<Matrix4x4> frame;
+  int chosen = -1;
+  for(int i=0; i<2; ++i) {
+    auto sqUp = visual.findSequence(up[i]);
+    if(sqUp==nullptr || visual.findSequence(lie[i])==nullptr)
+      continue;
+    Pose::sampleObjectPose(*sk,*sqUp,0,frame);
+    if(ragdoll->chestBone()>=frame.size())
+      continue;
+    const bool back = ragdoll->chestFront(frame[ragdoll->chestBone()]).y>0.f;
+    if(back==onBack) {
+      chosen = i;
+      break;
+      }
+    }
+  if(chosen<0) {
+    blend(RagdollBlendTime);
+    return;
+    }
+  // лежит в позе начала подъёма, пока не начнёт вставать (ragdollRise)
+  visual.replaceLayer(visual.findSequence(lie[chosen]),now);
+
+  // Повернуть и поставить NPC так, чтобы таз и грудь первого кадра подъёма легли на тело
+  auto objToWorld = [this](float ang, Vec3 v) {
+    Matrix4x4 m = Matrix4x4::mkIdentity();
+    m.rotateOY(90-ang);
+    v = Vec3(v.x*sz[0], v.y*sz[1], v.z*sz[2]);
+    return Vec3(m.at(0,0)*v.x + m.at(1,0)*v.y + m.at(2,0)*v.z,
+                m.at(0,1)*v.x + m.at(1,1)*v.y + m.at(2,1)*v.z,
+                m.at(0,2)*v.x + m.at(1,2)*v.y + m.at(2,2)*v.z);
+    };
+  auto heading = [](const Vec3& v) {
+    return std::atan2(v.z,v.x)*180.f/float(M_PI);
+    };
+  const auto& fr     = frame;
+  const Vec3  pelA   = Vec3(fr[ragdoll->rootBone()].at(3,0),  fr[ragdoll->rootBone()].at(3,1),  fr[ragdoll->rootBone()].at(3,2));
+  const Vec3  chestA = Vec3(fr[ragdoll->chestBone()].at(3,0), fr[ragdoll->chestBone()].at(3,1), fr[ragdoll->chestBone()].at(3,2));
+  const Vec3  pelR   = ragdoll->rootPosition();
+  const Vec3  chestR = ragdoll->chestPosition();
+  const Vec3  hA     = Vec3(chestA.x-pelA.x, 0, chestA.z-pelA.z);
+  const Vec3  hR     = Vec3(chestR.x-pelR.x, 0, chestR.z-pelR.z);
+
+  float ang = angle;
+  if(hA.length()>5.f && hR.length()>5.f)
+    ang = heading(hR) - heading(objToWorld(0,hA));
+  const Vec3  off = objToWorld(ang,pelA);
+  const Vec3  at  = Vec3(pelR.x-off.x, pelR.y, pelR.z-off.z);
+  auto        g   = owner.physic()->landRay(at+Vec3(0,50,0), 600);
+  setDirection(ang);
+  setPosition(at.x, g.hasCol ? g.v.y : y, at.z);
+
+  // собирается лёжа по физике: мышцы и опора о землю ведут тело к позе лёжа (tickRagdollGetUp); нет места в физике
+  // или выключено - поза куклы переходит в эту позу дольше
+  if(Gothic::options().ragdollRise && ragdoll->startGetUp(float(RagdollGatherTime)/1000.f)) {
+    ragGetUpUntil = now + RagdollGatherTime;
+    ragRiseAt     = ragGetUpUntil + RagdollRiseBlend;
+    ragBlendStart = 0;
+    } else {
+    blend(RagdollRiseBlend+200);
+    ragRiseAt = now + RagdollRiseBlend + 200;
+    }
+  ragTargetAt  = 0;
+  ragPushedVer = 0;
+  // мировая поза куклы не меняется - пересчитать её относительно нового места NPC
+  ragdoll->touch();
+  // встав, снова держится за свежую рану
+  if(wound.active() && int64_t(now)<wound.at+15000)
+    wound.rearm(int64_t(now), 1800, int64_t(ragRiseAt-now));
+  // ИИ ждёт, пока не начнёт вставать (дальше ждёт анимацию подъёма - ragdollRise)
+  if(!isPlayer())
+    implAniWait(ragRiseAt-now);
+  }
+
+void Npc::tickRagdollGetUp() {
+  // Собирается лёжа (S_GetUp): цель мышц и опоры - поза лёжа, с которой начинается анимация подъёма (её держит слой
+  // S_WOUNDED / S_WOUNDEDB). Время вышло - кукла уходит из физики, поза переходит в эту позу (endRagdollGetUp)
+  const uint64_t now = owner.tickCount();
+  if(!ragdoll->isSimulated() || isSwim() || isDive() || ragGetUpUntil==0 || now>=ragGetUpUntil) {
+    endRagdollGetUp();
+    return;
+    }
+  float dist = 0;
+  bool  keep = false;
+  if(ragdollViewDistance(dist,keep))
+    ragdoll->setViewDistance(dist,keep);
+  visual.pose().animPose(ragTarget);
+  ragdoll->setTarget(ragTarget, ragTargetAt!=0 ? now-ragTargetAt : 0);
+  ragTargetAt = now;
+  }
+
+void Npc::endRagdollGetUp() {
+  // собрался: поза куклы переходит в позу лёжа начала подъёма, потом - анимация подъёма (ragdollRise)
+  const uint64_t now = owner.tickCount();
+  ragdoll->freeze();
+  ragBlendStart = now;
+  ragBlendTime  = RagdollRiseBlend;
+  ragPushedVer  = 0;
+  ragGetUpUntil = 0;
+  ragRiseAt     = now + RagdollRiseBlend;
+  if(!isPlayer())
+    implAniWait(RagdollRiseBlend);
+  }
+
+void Npc::ragdollRise() {
+  // поза куклы уже в позе лёжа начала подъёма - встаёт анимацией игры; ИИ ждёт её конца
+  ragRiseAt = 0;
+  if(isDead())
+    return;
+  if(setAnim(Anim::Idle) && !isPlayer())
+    implAniWait(visual.pose().animationTotalTime());
+  }
+
+void Npc::tickShove() {
+  // Герой бежит на человека (как в жизни): за ~0,35 с до столкновения готовится - подставляет плечо или выставляет руки
+  // (слой позы, tickInjury); врезался - толчок по импульсу: массы почти равны, удар не упругий - тот получает около
+  // половины скорости сближения (плечом и руками - чуть больше) и ловит равновесие всем телом (ragdollShove). Бегом -
+  // устоит или упадёт, смотря откуда толкнули; шагом - просто упрётся, как в игре
+  const uint64_t now = owner.tickCount();
+  const float    dt  = shoveTick!=0 ? float(now-shoveTick)/1000.f : 0.f;
+  shoveTick = now;
+  Vec3 v = ragVelocity*1000.f; // см/с
+  v.y = 0;
+  // скорость бега - с памятью 0,15 с: упёрся в человека - перемещение встало, а толчок - от скорости бега
+  if(v.length()>=shoveVel.length() || dt<=0.f)
+    shoveVel = v; else
+    shoveVel = v + (shoveVel-v)*std::exp(-dt/0.15f);
+  v = shoveVel;
+  const float speed = v.length()/100.f;
+  const bool  can   = Gothic::options().ragdollShove && ragdoll==nullptr && !isDown() && interactive()==nullptr &&
+                      !isSwim() && !isDive() && !mvAlgo.isInAir() && !mvAlgo.isFalling() && !mvAlgo.isClimb() &&
+                      speed>=2.2f && !isAttackAnim();
+  Npc*  target = nullptr;
+  float tau    = 1e9f, along = 0, vc = 0;
+  Vec3  u, dTo;
+  if(can) {
+    u = v/(speed*100.f);
+    owner.detectNpc(position(), 280.f, [&](Npc& n) {
+      if(&n==this || n.isDown() || (now<shoveCool && n.gripId()==shoveId))
+        return;
+      Vec3 d = n.position()-position();
+      d.y = 0;
+      const float al = Vec3::dotProduct(d,u);
+      if(al<=0.f || al>260.f || (d-u*al).length()>48.f)
+        return;
+      Vec3 vn = n.ragVelocity*1000.f;
+      vn.y = 0;
+      const float c = Vec3::dotProduct(v-vn,u)/100.f; // м/с
+      if(c<1.8f || !n.ragdollShoveAllowed())
+        return;
+      // касание - когда сойдутся капсулы (дальше перемещение игры не пустит)
+      const float touch = std::max(physic.radiusXZ()+n.physic.radiusXZ()+12.f, 55.f);
+      const float t = (al-touch)/(c*100.f);
+      if(t<tau) {
+        tau    = t;
+        target = &n;
+        along  = al-touch;
+        vc     = c;
+        dTo    = d;
+        }
+      });
+    }
+  const bool hold = shoveHitAt!=0 && now<shoveHitAt+260;
+  if(target!=nullptr && tau<0.38f) {
+    if(target->gripId()!=shoveId) {
+      // чем: без оружия - чаще руками (двумя или одной), с одноручным - плечом или свободной левой, с двуручным,
+      // луком, магией - плечом. Плечо - со стороны, куда смещён тот (или левое, если в правой оружие)
+      shoveId = target->gripId();
+      const int  r     = int(owner.script().rand(100));
+      const Vec3 left  = Vec3(-u.z, 0, u.x);
+      const int  near  = Vec3::dotProduct(dTo,left)>=0.f ? 0 : 1;
+      switch(weaponState()) {
+        case WeaponState::NoWeapon:
+          shoveKind = r<45 ? Injury::B_Push2 : (r<70 ? Injury::B_Push1 : Injury::B_Shoulder);
+          shoveSide = int8_t(shoveKind==Injury::B_Push1 ? (r%2) : near);
+          break;
+        case WeaponState::Fist:
+          shoveKind = r<50 ? Injury::B_Push2 : Injury::B_Shoulder;
+          shoveSide = int8_t(near);
+          break;
+        case WeaponState::W1H:
+          shoveKind = r<55 ? Injury::B_Shoulder : Injury::B_Push1;
+          shoveSide = 0;
+          break;
+        default:
+          shoveKind = Injury::B_Shoulder;
+          shoveSide = 0;
+          break;
+        }
+      }
+    shoveAt    = target->aimChest();
+    shoveBrace = std::min(1.f, shoveBrace + dt/0.2f);
+    if(along<=0.f) {
+      // врезался: толчок в точку касания - плечом на высоте плеча, руками - в грудь
+      static const float bonus[] = {0.15f, 0.25f, 0.35f}; // плечо, рука, две руки: м/с сверх импульса бега
+      // удар не всегда одинаков: как пришёлся, насколько тот был готов (0,92..1,22)
+      const float luck = 0.92f + 0.3f*float(owner.script().rand(1000))/1000.f;
+      const float dv   = std::clamp((0.45f*vc + bonus[std::min<uint8_t>(shoveKind,2)])*luck, 0.f, 3.2f);
+      Vec3        at  = shoveAt - u*12.f;
+      if(shoveKind==Injury::B_Shoulder) {
+        if(auto sk = visual.visualSkeleton()) {
+          const size_t id = sk->findNode(shoveSide==0 ? "BIP01 L UPPERARM" : "BIP01 R UPPERARM");
+          if(id!=size_t(-1))
+            at.y = std::clamp(visual.mapBone(id).y, target->position().y+60.f, shoveAt.y+25.f);
+          }
+        }
+      Vec3 dir = u*0.8f + Vec3::normalize(dTo)*0.2f;
+      dir.y = 0;
+      if(target->ragdollShove(*this, at, Vec3::normalize(dir), dv)) {
+        shoveHitAt = now;
+        shoveCool  = now+1200;
+        }
+      }
+    }
+  else if(!hold) {
+    shoveBrace = std::max(0.f, shoveBrace - dt/0.35f);
+    if(shoveBrace<=0.f)
+      shoveHitAt = 0;
+    }
+  }
+
+bool Npc::ragdollShoveAllowed() const {
+  // Толкнуть с разбега можно человека на ногах рядом с героем или камерой (он ловит равновесие всем телом и, если не
+  // устоит, падает и встаёт - как сбитый с ног)
+  if(!Gothic::options().ragdollShove || isPlayer() || isDown())
+    return false;
+  if(ragdoll!=nullptr && !(ragdoll->state()==Ragdoll::S_Active && ragdoll->isSimulated() && ragFadeStart==0 && ragBlendStart==0))
+    return false; // лежит, встаёт, уже ловит равновесие
+  return ragdollActiveAllowed() && ragdollFallAllowed();
+  }
+
+bool Npc::ragdollShove(Npc& by, const Vec3& at, const Vec3& dir, float speed) {
+  if(!ragdollShoveAllowed())
+    return false;
+  if(ragdoll==nullptr && !startRagdollActive())
+    return false;
+  ragFadeStart = 0;
+  Ragdoll::Shove s;
+  s.at       = at;
+  s.dir      = dir;
+  s.speed    = speed;
+  s.freeArms = ragdollFreeArms();
+  // как крепко стоит на ногах: сильный (стражник, наёмник) гасит толчок шагами лучше, слабый (горожанин, крестьянин)
+  // скорее упадёт; и у каждого - немного по-своему
+  {
+  const float str = float(attribute(ATR_STRENGTH));
+  const float r   = float(owner.script().rand(1000))/1000.f;
+  s.steady = 0.78f + 0.32f*std::clamp((str-10.f)/80.f, 0.f, 1.f) + 0.12f*(r-0.5f);
+  }
+  ragdoll->shove(s);
+  if(ragdoll->state()!=Ragdoll::S_Balance)
+    return false;
+  // от толчка выронил, что было в руке (еда, питьё): руки нужны для равновесия; дело распорядка - заново
+  dropHandItem(true);
+  // стоит (цель мышц корпуса - стойка); ИИ и перемещение ждут, пока тело ловит равновесие (Npc::tick)
+  setAnim(Anim::Idle);
+  ragTargetAt = owner.tickCount();
+  ragGripped  = 0;
+  Log::i("[g2m] ragdoll: \"",displayName(),"\" shoved by \"",by.displayName(),"\" ",int(speed*100.f+0.5f)," cm/s, steady ",
+         int(s.steady*100.f+0.5f),"%");
+  return true;
+  }
+
+uint32_t Npc::gripId() const {
+  return uint32_t(reinterpret_cast<uintptr_t>(this)>>3) | 1u;
+  }
+
+void Npc::ragdollGrips(std::vector<Ragdoll::Grip>& out) const {
+  // За кого рядом можно схватиться: плечи, грудь, предплечья людей на ногах в 2,2 м (и героя) - точки на поверхности
+  // их тела со стороны этого NPC (Ragdoll::gripPoints). Не за себя и не за того, кто сам держится за этого NPC:
+  // двое, держась друг за друга, держали бы сами себя
+  out.clear();
+  const Vec3 from = aimChest();
+  std::vector<Vec3> pts;
+  owner.detectNpc(position(), 220.f, [&](Npc& n) {
+    if(&n==this || n.gripId()==gripId() || n.isDown() || out.size()>=15)
+      return;
+    if(n.ragdoll!=nullptr && n.ragGripped==gripId())
+      return;
+    auto sk = n.visual.visualSkeleton();
+    if(sk==nullptr || InjuryRig::of(*sk)==nullptr)
+      return;
+    const Vec3 vel = n.ragVelocity*1000.f; // см/мс -> см/с
+    auto& pose = n.visual.pose();
+    pts.clear();
+    Ragdoll::gripPoints(*sk, pose.transform(), pose.boneCount(), from, pts);
+    for(auto& p:pts) {
+      Ragdoll::Grip g;
+      g.at  = p;
+      g.vel = vel;
+      g.id  = n.gripId();
+      out.push_back(g);
+      }
+    });
+  }
+
+void Npc::tickRagdollBalance() {
+  // Ловит равновесие после толчка (Ragdoll::S_Balance): NPC стоит там, где таз; люди рядом - опора для руки; схватился
+  // за человека - того дёргает к себе; не устоял - падает (сбит с ног: лежит, встаёт), устоял - поза в анимацию
+  const uint64_t now = owner.tickCount();
+  if(!ragdoll->isSimulated() || isSwim() || isDive()) {
+    finishRagdollBalance();
+    return;
+    }
+  float dist = 0;
+  bool  keep = false;
+  if(ragdollViewDistance(dist,keep))
+    ragdoll->setViewDistance(dist,keep);
+  followRagdoll();
+  ragdollGrips(ragGrips);
+  ragdoll->setGrips(ragGrips);
+  if(const uint32_t g = ragdoll->grippedId(); g!=ragGripped) {
+    ragGripped = g;
+    if(g!=0) {
+      // схватился за человека: того дёргает - он тоже ловит равновесие (герой - нет: его тело ведёт игрок)
+      owner.detectNpc(position(), 250.f, [&](Npc& n) {
+        if(n.gripId()!=g || n.isPlayer() || &n==this)
+          return;
+        Vec3 d = position()-n.position();
+        d.y = 0;
+        if(d.length()<1.f)
+          return;
+        n.ragdollShove(*this, n.aimChest(), Vec3::normalize(d), 0.55f);
+        });
+      }
+    }
+  visual.pose().animPose(ragTarget);
+  ragdoll->setTarget(ragTarget, ragTargetAt!=0 ? now-ragTargetAt : 0);
+  ragTargetAt = now;
+  if(ragdoll->lostBalance() && !isDown()) {
+    ragKnock = true;
+    startRagdollFall();
+    if(isRagdollFall() && ragdoll!=nullptr && ragdoll->state()==Ragdoll::S_Fall)
+      return;
+    ragKnock = false;
+    finishRagdollBalance();
+    return;
+    }
+  if(ragdoll->balanceRecovered())
+    finishRagdollBalance();
+  }
+
+void Npc::finishRagdollBalance() {
+  // устоял: NPC - там, где стоит тело, и смотрит, куда оно; кукла уходит из физики, поза переходит в анимацию
+  const Vec3 f = ragdoll->bodyFront();
+  setDirection(angleDir(f.x,f.z));
+  followRagdoll();
+  ragdoll->freeze();
+  ragdoll->touch();
+  ragBlendStart = owner.tickCount();
+  ragBlendTime  = 450;
+  ragPushedVer  = 0;
+  ragGripped    = 0;
+  // ИИ - дальше, когда поза вернётся в анимацию
+  implAniWait(ragBlendTime);
+  Log::i("[g2m] ragdoll: \"",displayName(),"\" kept balance");
+  }
+
+void Npc::pushRagdollPose() {
+  if(ragdoll==nullptr)
+    return;
+  if(ragdoll->state()==Ragdoll::S_Active) {
+    // активный регдолл: тело и руки - физика относительно таза, таз и ноги - анимация (Pose::setRagdollActive);
+    // на экране физика - пока тело откликается на удар (Ragdoll::showWeight), уход в анимацию - плавно
+    float w = ragdoll->isSimulated() ? ragdoll->showWeight() : 0.f;
+    if(ragFadeStart!=0)
+      w *= 1.f - std::min(float(owner.tickCount()-ragFadeStart)/float(RagdollFadeTime), 1.f);
+    w = w*w*(3.f-2.f*w);
+    if(ragPushedVer==ragdoll->version() && w==ragShown && ragFadeStart==0)
+      return;
+    ragPushedVer = ragdoll->version();
+    ragShown     = w;
+    Stance stance;
+    ragdoll->activePose(ragRel,stance);
+    // уходит в анимацию - и стойка (таз, ступни) вместе с телом
+    if(ragFadeStart!=0)
+      stance.weight *= 1.f - std::min(float(owner.tickCount()-ragFadeStart)/float(RagdollFadeTime), 1.f);
+    if(!ragdoll->isSimulated())
+      stance.weight = 0;
+    visual.setRagdollActivePose(ragdoll->activeModes(),ragdoll->bones(),ragRel,ragdoll->rootBone(),w,stance);
+    return;
+    }
+  const auto& pos   = visual.transform();
+  const bool  fresh = (ragPushedVer!=ragdoll->version());
+  // дыхание лежащего - на выводе позы, только рядом: дальше его не разглядеть, а поза пересчитывается каждый кадр
+  float inhale = 0;
+  if(ragBreath.active() && ragBlendStart==0) {
+    float dist = 0;
+    bool  keep = false;
+    if(ragdollViewDistance(dist,keep) && dist<=RagdollBreathDist)
+      inhale = ragBreath.inhale(int64_t(owner.tickCount()));
+    }
+  const bool breath = std::abs(inhale-ragBreathShown)>0.004f;
+  if(fresh) {
+    Matrix4x4 inv = pos;
+    inv.inverse();
+    auto& world = ragdoll->world();
+    ragLocal.resize(world.size());
+    for(size_t i=0; i<world.size(); ++i)
+      ragLocal[i] = inv*world[i];
+    }
+  else if(pos!=ragPushedPos) {
+    // застывшее тело перенесли вместе с NPC (скрипт, распорядок): кости идут за ним
+    ragdoll->rebase(pos,ragLocal);
+    }
+  else if(ragBlendStart==0 && !breath) {
+    return;
+    }
+  ragPushedVer = ragdoll->version();
+  ragPushedPos = pos;
+
+  float w = 1.f;
+  if(ragBlendStart!=0) {
+    const uint64_t t = owner.tickCount()-ragBlendStart;
+    w = 1.f - std::min(float(t)/float(ragBlendTime), 1.f);
+    // плавно: медленнее в начале и в конце
+    w = w*w*(3.f-2.f*w);
+    }
+  ragBreathShown = inhale;
+  if(inhale>0.f) {
+    ragBreathBones = ragdoll->world();
+    ragdoll->breathe(ragBreathBones,inhale,ragBreath.gasp);
+    Matrix4x4 inv = pos;
+    inv.inverse();
+    for(auto& m:ragBreathBones)
+      m = inv*m;
+    visual.setRagdollPose(ragdoll->driven(),ragdoll->bones(),ragBreathBones,w);
+    return;
+    }
+  visual.setRagdollPose(ragdoll->driven(),ragdoll->bones(),ragLocal,w);
+  }
+
+void Npc::saveRagdoll(Serialize& fout, size_t id, std::string_view directory) const {
+  // живой падающий в сохранение не пишется: после загрузки стоит там, где лежал
+  if(ragdoll==nullptr || ragBlendStart!=0 || ragdoll->state()==Ragdoll::S_Fall || ragdoll->state()==Ragdoll::S_Active ||
+     ragdoll->state()==Ragdoll::S_Balance || ragdoll->state()==Ragdoll::S_GetUp)
+    return;
+  // поза тела - относительно NPC; при загрузке тело лежит так же, без физики, пока его не толкнут
+  fout.setEntry("worlds/",fout.worldName(),directory,id,"/ragdoll");
+  Matrix4x4 inv = visual.transform();
+  inv.inverse();
+  const auto& bones = ragdoll->bones();
+  const auto& world = ragdoll->world();
+  fout.write(uint8_t(1),uint8_t(ragdoll->state()),uint16_t(bones.size()));
+  for(size_t i=0; i<bones.size(); ++i)
+    fout.write(bones[i],inv*world[i]);
+  }
+
+void Npc::loadRagdoll(Serialize& fin, size_t id, std::string_view directory) {
+  ragdoll.reset();
+  ragBlendStart = 0;
+  if(!fin.setEntry("worlds/",fin.worldName(),directory,id,"/ragdoll"))
+    return;
+  uint8_t  ver = 0, st = 0;
+  uint16_t cnt = 0;
+  fin.read(ver,st,cnt);
+  if(ver!=1)
+    return;
+  std::vector<uint16_t>  bones(cnt);
+  std::vector<Matrix4x4> world(cnt);
+  const Matrix4x4 pos = mkPositionMatrix();
+  for(size_t i=0; i<cnt; ++i) {
+    Matrix4x4 local;
+    fin.read(bones[i],local);
+    world[i] = pos*local;
+    }
+  auto sk = visual.visualSkeleton();
+  if(sk==nullptr || !Gothic::options().ragdoll)
+    return;
+  ragdoll = Ragdoll::createFrozen(*owner.physic(), *sk, bones, world, st==Ragdoll::S_Unconscious ? Ragdoll::S_Unconscious : Ragdoll::S_Dead);
+  ragPushedVer = 0;
+  ragFollowVer = ragdoll!=nullptr ? ragdoll->version() : 0;
+  // без сознания - дышит, пока не встанет
+  ragBreath.stop();
+  if(ragdoll!=nullptr && ragdoll->state()==Ragdoll::S_Unconscious && Gothic::options().ragdollThroes)
+    ragBreath.start(Breathing::Steady, int64_t(owner.tickCount()), uint32_t(id)*2654435761u);
+  }
