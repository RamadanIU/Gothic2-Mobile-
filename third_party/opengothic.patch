+bool PlayerControl::tickAutoFight(Npc& pl) {
+  // Палец на джойстике или кнопке боя - герой слушается игрока; отпустил - автобой продолжает
+  const bool manual = touchAttack || touchBlock || touchFwdAct!=Action::Idle || touchSideAct!=Action::Idle ||
