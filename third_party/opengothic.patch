+void GameMenu::onEndTouch(bool activate) {
+  const bool tap  = activate && touchDown && !touchMoved && touchTap;
+  const bool list = touchList!=nullptr;
+  touchDown = false;
+  touchDrag = TouchDrag::None;
+  touchList = nullptr;
+  update();
+  if(!tap)
+    return;
+  // Выбор может закрыть меню - последним действием
+  if(list) {
+    Gothic::inst().emitGlobalSound(Gothic::inst().loadSoundFx("MENU_SELECT"));
+    openLogEntry();
+    } else {
+    onKeyboard(KeyCodec::ActionGeneric);
+    }
+  }
