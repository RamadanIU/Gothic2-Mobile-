+btVector3 Ragdoll::anklePos(int k) const {
+  // конец голени - голеностоп (капсула голени от колена к стопе, ось X)
+  const size_t ca = lay->calf[k];
+  return body[ca].rb->getWorldTransform()*btVector3(lay->parts[ca].segHalf*0.01f,0,0);
+  }
+
+btVector3 Ragdoll::handPos(int a) const {
+  // ладонь: середина кисти ближе к пальцам; без кисти - конец предплечья
+  if(lay->hand[a]<body.size()) {
+    const size_t h = lay->hand[a];
+    return body[h].rb->getWorldTransform()*btVector3(lay->parts[h].halfLen*0.004f,0,0);
+    }
+  const size_t f = lay->fore[a];
+  return body[f].rb->getWorldTransform()*btVector3(lay->parts[f].segHalf*0.01f,0,0);
+  }
+
+void Ragdoll::setAnchor(int k, const btVector3& at) {
+  // ступня стоит: голеностоп держится на месте (трение подошвы о землю, предел силы - в driveBalance)
+  freeAnchor(k);
+  auto&           lg = beh->bal.leg[k];
+  auto&           rb = *body[lay->calf[k]].rb;
+  const btVector3 local(lay->parts[lay->calf[k]].segHalf*0.01f,0,0);
+  auto c = std::make_unique<btPoint2PointConstraint>(rb, local);
+  c->setPivotB(at);
+  c->setOverrideNumSolverIterations(solverIt);
+  owner->world->addConstraint(c.get(),true);
+  lg.pin     = std::move(c);
+  lg.anchor  = at;
+  lg.planted = true;
+  lg.swing   = -1;
+  }
+
+void Ragdoll::freeAnchor(int k) {
+  if(beh==nullptr)
+    return;
+  auto& lg = beh->bal.leg[k];
+  if(lg.pin!=nullptr) {
+    owner->world->removeConstraint(lg.pin.get());
+    lg.pin.reset();
+    }
+  lg.planted = false;
+  }
+
+void Ragdoll::removeAnchors() {
+  for(int k=0; k<2; ++k)
+    freeAnchor(k);
+  }
+
+void Ragdoll::releaseGrip(int a) {
+  if(beh==nullptr)
+    return;
+  auto& hd = beh->bal.hand[a];
+  if(hd.c!=nullptr) {
+    owner->world->removeConstraint(hd.c.get());
+    hd.c.reset();
+    }
+  if(hd.gripAt>=0.f)
+    hd.cool = beh->now+0.5f;
+  hd.gripAt  = -1;
+  hd.src     = -1;
+  hd.id      = 0;
+  hd.reach   = 0;
+  hd.reachAt = -1;
+  }
+
+void Ragdoll::startBalance() {
+  // активная кукла (таз и ноги за анимацией) становится полным регдоллом: ступни стоят там, где стояли
+  if(beh==nullptr)
+    beh = std::make_unique<Behave>();
+  setState(S_Balance);
+  auto& b  = *beh;
+  auto& bl = b.bal;
+  for(int k=0; k<2; ++k)
+    bl.leg[k] = Behave::Leg();
+  for(int a=0; a<2; ++a)
+    bl.hand[a] = Behave::Hand();
+  bl.on        = true;
+  bl.at        = b.now;
+  bl.risk      = 0;
+  bl.landEx    = -1;
+  bl.diverge   = 0;
+  bl.recovered = false;
+  bl.steps     = 0;
+  bl.calm      = 0;
+  bl.support   = 1;
+  bl.exceed    = 0;
+  bl.armsW     = 0;
+  bl.flail     = 0;
+  bl.heading   = horizontal(btv(bodyFront()));
+  if(bl.heading.length()<0.5f)
+    bl.heading = b.fwd;
+
+  // ноги друг о друга не цепляются (шаг через другую ногу обходит её дугой)
+  for(size_t x:{lay->thigh[0],lay->calf[0]})
+    for(size_t y:{lay->thigh[1],lay->calf[1]}) {
+      body[x].rb->setIgnoreCollisionCheck(body[y].rb.get(),true);
+      body[y].rb->setIgnoreCollisionCheck(body[x].rb.get(),true);
+      }
+  btVector3 com, vel;
+  massCenter(com,vel);
+  float ay = 0;
+  for(int k=0; k<2; ++k) {
+    const btVector3 a = anklePos(k);
+    setAnchor(k,a);
+    ay += float(a.y())*0.5f;
+    }
+  const btVector3 pel = body[0].rb->getCenterOfMassPosition();
+  const float     gy  = groundAt(pel, ay-0.08f*lay->size/180.f);
+  bl.ankleH = std::clamp(ay-gy, 0.02f, 0.2f);
+  bl.pelH   = std::max(float(pel.y())-gy, 0.3f);
+  bl.comH   = std::max(float(com.y())-gy, 0.4f);
+  bl.com    = com;
+  bl.vel    = vel;
+  }
+
+void Ragdoll::shove(const Shove& s) {
+  // Толчок телом (плечо, руки): центр масс получает скорость s.speed; верх тела - больше (корпус уходит первым и
+  // откидывается), таз - меньше, ступни стоят на земле. Дальше тело ловит равновесие само (tickBalance)
+  if(!isSimulated() || !lay->stance || drive.size()!=body.size() || s.speed<=0.f)
+    return;
+  if(st!=S_Active && st!=S_Balance)
+    return;
+  btVector3 dir = horizontal(btv(s.dir));
+  if(dir.length()<0.5f)
+    return;
+  if(st==S_Active)
+    startBalance();
+  auto& b  = *beh;
+  auto& bl = b.bal;
+  bl.freeArms  = s.freeArms;
+  bl.steady    = std::clamp(s.steady, 0.5f, 1.5f);
+  bl.at        = b.now;
+  bl.recovered = false;
+  bl.calm      = 0;
+
+  float M = 0, MK = 0;
+  auto share = [](uint8_t k) {
+    switch(Kind(k)) {
+      case K_Pelvis:   return 0.95f;
+      case K_Thigh:    return 0.7f;
+      case K_Calf:     return 0.f;
+      default:         return 1.08f;
+      }
+    };
+  for(size_t i=0; i<body.size(); ++i) {
+    M  += lay->parts[i].mass;
+    MK += lay->parts[i].mass*share(lay->parts[i].kind);
+    }
+  if(MK<=0.f)
+    return;
+  const float scale = M*s.speed/MK;
+  for(size_t i=0; i<body.size(); ++i) {
+    auto& rb = *body[i].rb;
+    rb.setLinearVelocity(rb.getLinearVelocity() + dir*(share(lay->parts[i].kind)*scale));
+    rb.activate(true);
+    }
+  // у места касания - толчок в точке (без изменения общей скорости): удар в плечо разворачивает корпус
+  {
+  const size_t    part = hitPart(s.at);
+  auto&           rb   = *body[part].rb;
+  const float     mp   = lay->parts[part].mass;
+  const btVector3 J    = dir*(mp*std::min(0.7f*s.speed, 2.f));
+  rb.applyImpulse(J, btv(s.at)-rb.getCenterOfMassPosition());
+  auto& ch = *body[lay->chest].rb;
+  if(part!=lay->chest)
+    ch.applyCentralImpulse(-J*0.5f);
+  body[0].rb->applyCentralImpulse(-J*(part!=lay->chest ? 0.5f : 1.f));
+  // мышцы у места касания на миг слабеют - тело поддаётся удару
+  for(size_t i=0; i<body.size(); ++i) {
+    const auto& p    = lay->parts[i];
+    const bool  near = (i==part || p.parent==part || lay->parts[part].parent==i);
+    auto&       d    = drive[i];
+    d.dip0   = std::max(1.f-toneOf(i), near ? 0.45f : 0.2f);
+    d.dipAt  = b.now;
+    d.dipRec = 0.9f;
+    }
+  // рана не держится: толчок не ранит
+  }
+  Log::i("[g2m] ragdoll: shoved ",int(s.speed*100.f+0.5f)," cm/s");
+  }
+
+// Досягаемость шага, ловя равновесие (доля роста 180 см): вперёд - выпад, назад и вбок короче, но спотыкаясь
+// человек шагает шире, чем идя: назад - до ~60 см, вбок - до ~50 см
+static constexpr float ReachFwd  = 0.8f;
+static constexpr float ReachBack = 0.44f;
+static constexpr float ReachSide = 0.45f;
+
+void Ragdoll::tickBalance(float dt) {
+  // Равновесие (каждый кадр): точка захвата, центр давления в опоре, шаги, вес на ногах, устоял или падает; цели
+  // мышц - корпус в позе анимации с наклоном против хода (тазобедренная стратегия), ноги - IK к ступням, руки -
+  // для равновесия или к опоре
+  auto&           b  = *beh;
+  auto&           bl = b.bal;
+  const btVector3 up(0,1,0);
+  const float     g  = DynamicWorld::gravityMS;
+  const float     k  = lay->size/180.f;
+  b.now += dt;
+
+  // направление тела - по тазу
+  {
+  const btVector3 f = horizontal(btv(bodyFront()));
+  if(f.length()>0.5f) {
+    b.fwd  = f;
+    b.left = up.cross(f);
+    }
+  }
+  btVector3 com, vel;
+  massCenter(com,vel);
+  btVector3 vh = vel;
+  vh.setY(0);
+  const btVector3 pel = body[0].rb->getCenterOfMassPosition();
+  float ankleY = 0;
+  int   nPl    = 0;
+  for(auto& lg:bl.leg)
+    if(lg.planted) {
+      ankleY += float(lg.anchor.y());
+      nPl++;
+      }
+  const float gy = groundAt(pel, nPl>0 ? ankleY/float(nPl)-bl.ankleH : float(pel.y())-bl.pelH);
+  const float w  = std::sqrt(g/std::max(bl.comH,0.5f));
+  bl.com = com;
+  bl.vel = vel;
+  btVector3 xi = com + vh/w;
+  xi.setY(gy);
+  bl.xi  = xi;
+  const float t  = b.now-bl.at;
+
+  // ---- шагающая нога: доля шага, место уточняется по ходу, поставлена - стоит. Встала по ходу тела - тело теряет
+  // часть скорости: удар ступни о землю и сгиб колена гасят её, как у колеса со спицами («rimless wheel»: v' = v*cos 2a,
+  // a - угол ноги от вертикали, sin a = полшага / длина ноги). Длинный шаг тормозит сильнее: спотыкаясь, человек
+  // гасит толчок за несколько шагов, а не одним
+  for(int s=0; s<2; ++s) {
+    auto& lg = bl.leg[s];
+    if(lg.planted || lg.swing<0.f)
+      continue;
+    lg.swing += dt/lg.dur;
+    if(lg.swing<1.f)
+      continue;
+    setAnchor(s, anklePos(s));
+    lg.landAt = b.now;
+    bl.steps++;
+    const float sp = float(vh.length());
+    btVector3   st = lg.anchor - (bl.leg[1-s].planted ? bl.leg[1-s].anchor : lg.from);
+    st.setY(0);
+    const float sl = float(st.length());
+    if(sp>0.05f && sl>0.05f) {
+      const float L     = 2.f*(lay->parts[lay->thigh[0]].segHalf+lay->parts[lay->calf[0]].segHalf)*0.01f;
+      const float sa    = std::min(sl/(2.f*L), 0.6f);
+      const float along = std::clamp(float(st.dot(vh))/(sl*sp), 0.f, 1.f);
+      // с каждым шагом ноги гасят хуже: тело уже не собрано, шаги сбиты (без этого и сильный толчок гасится всегда)
+      const float tired = std::max(0.35f, 1.f - 0.13f*float(bl.steps-1));
+      const float f     = std::min((1.4f*sa*sa + 0.03f)*bl.steady*tired, 0.25f)*along;
+      const btVector3 dv = -vh*f;
+      for(auto& bd:body)
+        bd.rb->setLinearVelocity(bd.rb->getLinearVelocity()+dv);
+      vel += dv;
+      vh  += dv;
+      xi   = com + vh/w;
+      xi.setY(gy);
+      bl.vel = vel;
+      bl.xi  = xi;
+      }
+    }
+  const float lastLand = std::max(bl.leg[0].landAt, bl.leg[1].landAt);
+
+  // нога вытянулась до конца и далеко отстала (тело ушло дальше, чем она достаёт) - ступня не держит: волочится, а
+  // не тянет тело назад
+  {
+  const float L = 2.f*(lay->parts[lay->thigh[0]].segHalf+lay->parts[lay->calf[0]].segHalf)*0.01f;
+  for(int s=0; s<2; ++s) {
+    auto& lg = bl.leg[s];
+    if(!lg.planted)
+      continue;
+    const btVector3 hip = body[lay->thigh[s]].rb->getWorldTransform()*pivotOf(lay->thigh[s]);
+    btVector3       hd  = hip-lg.anchor;
+    hd.setY(0);
+    if((hip-lg.anchor).length()>0.95f*L && hd.length()>0.45f*L) {
+      if(bl.leg[1-s].planted) {
+        // другая стоит - эта отрывается и сразу шагает (ниже)
+        freeAnchor(s);
+        lg.swing = -1;
+        } else {
+        // единственная опора, пока другая в шаге: ступня проскальзывает следом (носок), а не держит тело
+        btVector3 a = lg.anchor + hd*(1.f - 0.55f*L/float(hd.length()));
+        lg.anchor = a;
+        if(auto c = static_cast<btPoint2PointConstraint*>(lg.pin.get()))
+          c->setPivotB(a);
+        }
+      }
+    }
+  nPl = int(bl.leg[0].planted) + int(bl.leg[1].planted);
+  }
+
+  // ---- опора: стоящие ступни (пятка - носок, по направлению тела), держащая рука
+  auto footPts = [&](int s, btVector3* out) {
+    const btVector3 a = bl.leg[s].anchor;
+    out[0] = a - b.fwd*(0.05f*k);
+    out[1] = a + b.fwd*(0.13f*k);
+    };
+  btVector3 pts[8];
+  size_t    n = 0;
+  for(int s=0; s<2; ++s)
+    if(bl.leg[s].planted) {
+      footPts(s,pts+n);
+      n += 2;
+      }
+  const size_t nFeet = n;
+  for(auto& hd:bl.hand)
+    if(hd.gripAt>=0.f && n<8)
+      pts[n++] = hd.at;
+  // спиной или плечом упёрлось в стену - стена держит: опора до неё (раз в 0,1 с - луч от груди и таза по ходу)
+  if(b.now-bl.wallAt>0.1f) {
+    bl.wallAt = b.now;
+    bl.wallOn = false;
+    const btVector3 dir = bl.fall.length()>0.5f ? bl.fall : (vh.length()>0.1f ? vh.normalized() : btVector3(0,0,0));
+    if(dir.length()>0.5f)
+      for(size_t pi:{lay->chest,size_t(0)}) {
+        const btVector3 c  = body[pi].rb->getCenterOfMassPosition();
+        const float     rr = lay->parts[pi].radius*0.01f + 0.06f*k;
+        const auto      r  = owner->ray(cmv(c), cmv(c+dir*rr));
+        if(r.hasCol && std::abs(r.n.y)<0.6f) {
+          bl.wallOn = true;
+          bl.wall   = btv(r.v);
+          bl.wallT  = up.cross(dir).normalized();
+          break;
+          }
+        }
+    }
+  if(bl.wallOn && n+2<=8) {
+    pts[n++] = bl.wall + bl.wallT*(0.2f*k);
+    pts[n++] = bl.wall - bl.wallT*(0.2f*k);
+    }
+  // наткнулось на человека (живые NPC для физики куклы - не тела): он держит, как стена, - тело упирается в него
+  {
+  const btVector3 ch = body[lay->chest].rb->getCenterOfMassPosition();
+  for(auto& gp:grips) {
+    if(n+1>8)
+      break;
+    btVector3 rel = btv(gp.at)-ch;
+    rel.setY(0);
+    const float d = float(rel.length());
+    if(d<0.36f*k && d>1e-3f && float(rel.dot(bl.fall))>0.f)
+      pts[n++] = btv(gp.at);
+    }
+  }
+  // опора - ступня (пятка - носок, 9 см в ширину) и немного сверх неё: тазом и руками человек сдвигает центр давления
+  // за край ступни (стратегия бедра), пока толчок мал
+  // Держащая рука и стена - тоже опора: тело не валится (сила маятника и решение о падении - по всей опоре), но
+  // шаги - по ступням: держась, человек подшагивает, чтобы встать на ноги, а не висит на руке
+  const float footR = 0.045f*k + 0.04f*k*bl.support;
+  float       exceed = 0, exceedAll = 0;
+  btVector3   cop    = nFeet>0 ? supportPoint(pts,nFeet,xi,footR,exceed) : btVector3(pel.x(),gy,pel.z());
+  if(nFeet==0)
+    exceed = float((xi-cop).length());
+  btVector3   copAll = cop;
+  exceedAll = exceed;
+  if(n>nFeet)
+    copAll = supportPoint(pts,n,xi,footR,exceedAll);
+  bl.cop    = copAll;
+  bl.exceed = exceedAll;
+  {
+  btVector3 f = xi-cop;
+  f.setY(0);
+  if(f.length()>0.01f)
+    bl.fall = f.normalized(); else
+  if(vh.length()>0.1f)
+    bl.fall = vh.normalized();
+  }
+
+  // ---- новый шаг: точка захвата вне опоры, ни одна нога не в воздухе. Реакция - через 0,06 с после толчка.
+  // Шаг - туда, где окажется точка захвата к концу шага (над одной ступнёй она уходит дальше), со своей стороны
+  // (ширина шага), не дальше, чем шагает человек: вперёд дальше, назад и вбок короче, через другую ногу - чуть
+  // Стороны шага - в системе направления тела до толчка (bl.heading), а не нынешнего таза: ноги, разошедшиеся вперёд
+  // и назад, разворачивают таз на десятки градусов, и шаг «назад» в его системе уходит вбок - тело кружит и
+  // заваливается боком. Таз возвращается к этому направлению (driveBalance)
+  const btVector3 hf = bl.heading;
+  const btVector3 hl = up.cross(hf);
+  const bool swinging = (bl.leg[0].swing>=0.f && !bl.leg[0].planted) || (bl.leg[1].swing>=0.f && !bl.leg[1].planted);
+  auto stepTarget = [&](int s, float dur, float& cost, bool* crossOut = nullptr) {
+    const int  o = 1-s;
+    btVector3  po[2];
+    footPts(o,po);
+    float      ex = 0;
+    const btVector3 p  = supportPoint(po,2,xi,footR,ex);
+    btVector3  xl = p + (xi-p)*std::exp(w*dur);
+    // чуть дальше точки захвата: тело остановится, не доходя до ступни, и не потянет за собой следующий шаг
+    {
+    btVector3 ov = xl-p;
+    ov.setY(0);
+    if(ov.length()>1e-3f)
+      xl += ov.normalized()*(0.05f*k);
+    }
+    const float sideS = (s==0 ? 1.f : -1.f);
+    xl += hl*(sideS*0.06f*k);
+    btVector3 rel = xl - bl.leg[o].anchor;
+    rel.setY(0);
+    float f = float(rel.dot(hf)), l = float(rel.dot(hl))*sideS;
+    f = std::clamp(f, -ReachBack*k, ReachFwd*k);
+    l = std::clamp(l, -0.26f*k, ReachSide*k);
+    // эллипс досягаемости
+    const float fm = f>0.f ? ReachFwd*k : ReachBack*k, lm = ReachSide*k;
+    const float e  = std::sqrt((f*f)/(fm*fm) + (l*l)/(lm*lm));
+    if(e>1.f) {
+      f /= e;
+      l /= e;
+      }
+    // шаг через другую ногу (толкнули вбок, другая нога далеко) - чуть впереди неё, чтобы ноги разошлись
+    const bool cross = l<0.07f*k;
+    if(cross)
+      f = std::max(f, 0.1f*k);
+    if(crossOut!=nullptr)
+      *crossOut = cross;
+    btVector3 to = bl.leg[o].anchor + hf*f + hl*(l*sideS);
+    // в другого человека не наступает (живые NPC для куклы - не тела): ступня - рядом с ним
+    for(auto& gp:grips) {
+      btVector3 d = to-btv(gp.at);
+      d.setY(0);
+      const float r = 0.24f*k, dl = float(d.length());
+      if(dl<r)
+        to += (dl>1e-3f ? d/dl : -hf)*(r-dl);
+      }
+    btVector3 miss = to-xl;
+    miss.setY(0);
+    cost = float(miss.length()) + (cross ? 0.06f*k : 0.f);
+    to.setY(groundAt(to, gy) + bl.ankleH);
+    return to;
+    };
+  auto startStep = [&](int s, const btVector3& to, bool cross) {
+    auto& lg = bl.leg[s];
+    lg.from  = anklePos(s);
+    lg.to    = to;
+    lg.bulge = cross ? hf*(0.16f*k) : btVector3(0,0,0);
+    btVector3 d = lg.to-lg.from;
+    d.setY(0);
+    const float len = float(d.length());
+    // торопится: чем дальше точка захвата, тем быстрее шаг
+    lg.dur   = std::clamp(0.14f + 0.13f*len/k - 0.06f*std::min(exceed/(0.3f*k),1.f), 0.14f, 0.25f);
+    lg.lift  = std::clamp(0.04f + 0.08f*len, 0.035f, 0.09f)*k;
+    lg.swing = 0;
+    freeAnchor(s);
+#ifdef RAGDOLL_TRACE
+    if(std::getenv("BTRACE"))
+      std::printf("     step %d t=%.2f fwd (%.2f %.2f) from (%.0f %.0f) to (%.0f %.0f) cross %d xi (%.0f %.0f) other (%.0f %.0f) dur %.2f\n",s,double(t),
+                  double(b.fwd.x()),double(b.fwd.z()),
+                  double(lg.from.x()*100),double(lg.from.z()*100),double(to.x()*100),double(to.z()*100),int(cross),
+                  double(xi.x()*100),double(xi.z()*100),double(bl.leg[1-s].anchor.x()*100),double(bl.leg[1-s].anchor.z()*100),double(lg.dur));
+#endif
+    };
+  // нога сорвалась с опоры (вытянулась) - сразу шагает ею, пока другая стоит
+  int freeLeg = -1;
+  for(int s=0; s<2; ++s)
+    if(!bl.leg[s].planted && bl.leg[s].swing<0.f && bl.leg[1-s].planted)
+      freeLeg = s;
+  if(freeLeg>=0 && !bl.recovered) {
+    float c  = 0;
+    bool  cr = false;
+    const btVector3 to = stepTarget(freeLeg,0.25f,c,&cr);
+    startStep(freeLeg, to, cr);
+    }
+  else if(!swinging && !bl.recovered && t>0.08f && b.now-lastLand>0.04f && exceed>0.03f*k && nPl==2) {
+    float     c0 = 0, c1 = 0;
+    bool      x0 = false, x1 = false;
+    const float durGuess = 0.28f;
+    const btVector3 t0 = stepTarget(0,durGuess,c0,&x0);
+    const btVector3 t1 = stepTarget(1,durGuess,c1,&x1);
+    const int s  = (c0<=c1) ? 0 : 1;
+    startStep(s, s==0 ? t0 : t1, s==0 ? x0 : x1);
+    }
+  else if(swinging) {
+    // место шага уточняется: тело ушло дальше - нога тянется дальше (не быстрее 3 м/с)
+    for(int s=0; s<2; ++s) {
+      auto& lg = bl.leg[s];
+      if(lg.planted || lg.swing<0.f)
+        continue;
+      float c = 0;
+      const btVector3 to = stepTarget(s, std::max(lg.dur*(1.f-lg.swing),0.02f), c);
+      btVector3 d = to-lg.to;
+      const float mx = 3.f*dt;
+      if(d.length()>mx)
+        d = d.normalized()*mx;
+      lg.to += d;
+      }
+    }
+
+  // ---- вес на ногах: таз над опорой, корпус не завалился, колени не подломились
+  {
+  const float L   = 2.f*(lay->parts[lay->thigh[0]].segHalf+lay->parts[lay->calf[0]].segHalf)*0.01f;
+  btVector3   dp  = pel - cop;
+  dp.setY(0);
+  const float sL  = 1.f - smooth((float(dp.length())-0.6f*L)/(0.3f*L));
+  btVector3   ub  = body[lay->chest].rb->getCenterOfMassPosition()-pel;
+  ub = ub.length()>1e-3f ? ub.normalized() : up;
+  // корпус склонился - ноги ещё держат, пока он не лёг (спотыкаясь вперёд, человек бежит, наклонившись)
+  const float sT  = smooth((float(ub.y())-0.2f)/0.35f);
+  const float hp  = float(pel.y())-gy;
+  const float sH  = smooth((hp/bl.pelH-0.4f)/0.25f);
+  const float want= std::min(std::min(sL,sT),sH)*(nPl>0 ? 1.f : 0.4f);
+  bl.support = approach(bl.support, want, dt, want<bl.support ? 0.04f : 0.15f);
+  }
+
+#ifdef RAGDOLL_TRACE
+  // BTRACE=1: равновесие по ходу - центр масс, скорость, точка захвата, опора, ступни
+  if(std::getenv("BTRACE")) {
+    static float last = -1;
+    static const float every = std::getenv("BTRACE_DT") ? float(std::atof(std::getenv("BTRACE_DT"))) : 0.099f;
+    if(b.now-last>=every || b.now<last) {
+      last = b.now;
+      std::printf("   t=%.2f yaw=%.0f com=(%.0f %.0f %.0f) v=(%.2f %.2f %.2f) xi=(%.0f %.0f) cop=(%.0f %.0f) ex=%.0f sup=%.2f calm=%.2f steps=%d"
+                  " L[%s %.2f (%.0f %.0f)>(%.0f %.0f)] R[%s %.2f (%.0f %.0f)>(%.0f %.0f)] pelY=%.0f\n",
+                  double(t),double(std::atan2(float(b.fwd.x()),float(b.fwd.z()))*180.f/float(M_PI)),double(com.x()*100),double(com.y()*100),double(com.z()*100),double(vel.x()),double(vel.y()),double(vel.z()),
+                  double(xi.x()*100),double(xi.z()*100),double(cop.x()*100),double(cop.z()*100),double(exceed*100),double(bl.support),
+                  double(bl.calm),bl.steps,
+                  bl.leg[0].planted ? "st" : "sw",double(bl.leg[0].swing),double(bl.leg[0].anchor.x()*100),double(bl.leg[0].anchor.z()*100),
+                  double(bl.leg[0].to.x()*100),double(bl.leg[0].to.z()*100),
+                  bl.leg[1].planted ? "st" : "sw",double(bl.leg[1].swing),double(bl.leg[1].anchor.x()*100),double(bl.leg[1].anchor.z()*100),
+                  double(bl.leg[1].to.x()*100),double(bl.leg[1].to.z()*100),
+                  double((pel.y()-gy)*100));
+      }
+    }
+#endif
+  // ---- устоял или падает
+  if(!bl.recovered) {
+    const bool still = !swinging && exceed<0.015f*k && vh.length()<0.3f && b.now-lastLand>0.2f && t>0.5f;
+    bl.calm = still ? bl.calm+dt : 0.f;
+    if(bl.calm>0.35f)
+      bl.recovered = true;
+    // шаги не догоняют - тело валится. Человек борется: шагает снова и снова, пока каждый шаг хоть немного
+    // приближает опору к точке захвата; падает, когда два шага подряд она уходила дальше, когда она далеко за
+    // пределом шага или долго вне опоры (пятится, а тело уходит быстрее шагов), когда ноги не держат (support).
+    // По направлению: вперёд человек шагает дальше, назад и вбок - короче
+    const float fw      = float(bl.fall.dot(hf));
+    const float stepMax = (fw>0.3f ? ReachFwd : (fw<-0.3f ? ReachBack : ReachSide))*k;
+    if(t>0.12f)
+      bl.risk = exceedAll>0.3f*k ? bl.risk + (exceedAll-0.3f*k)/stepMax*dt : std::max(0.f, bl.risk - 0.6f*dt);
+    const bool landed = lastLand>=b.now-1e-4f && bl.steps>0;
+    if(landed) {
+      if(bl.landEx>=0.f && exceedAll>bl.landEx+0.02f*k && exceedAll>0.6f*stepMax)
+        bl.diverge++; else
+        bl.diverge = std::max(0, bl.diverge-1);
+      bl.landEx = exceedAll;
+      }
+    // рука вот-вот схватится за опору (стена, человек рядом) - падение ещё не решено (не дольше 0,4 с)
+    bool reaching = false;
+    for(auto& hd:bl.hand)
+      if(hd.src>=0 && hd.gripAt<0.f && hd.reachAt>=0.f && b.now-hd.reachAt<0.4f)
+        reaching = true;
+    // нога в шаге - сначала поставит её (споткнулся шагом и упал), если только тело не ушло совсем далеко
+    const bool beyond = exceedAll>2.f*stepMax && t>0.15f && (!swinging || t>0.5f || exceedAll>2.8f*stepMax);
+    // нога встала, а точка захвата всё ещё куда дальше, чем достанет следующий шаг, - не поймать
+    const bool hopeless = landed && bl.steps>=2 && exceedAll>(0.95f+0.4f*bl.steady)*stepMax;
+    // борется долго, а тело всё не встаёт над ногами - выбился из сил
+    const bool tired    = t>1.8f && exceedAll>0.12f*k && !swinging;
+    if(bl.support<0.25f || (!reaching && (bl.diverge>=2 || hopeless || beyond || bl.risk>1.2f || tired))) {
+#ifdef RAGDOLL_TRACE
+      if(std::getenv("BTRACE") && !balanceLost)
+        std::printf("   LOST t=%.2f support %.2f landed %d exceed %.0f stepMax %.0f risk %.2f diverge %d steps %d reaching %d hands %d/%.2f/%.2f %d/%.2f/%.2f now %.2f\n",double(t),double(bl.support),
+                    int(landed),double(exceed*100),double(stepMax*100),double(bl.risk),bl.diverge,bl.steps,int(reaching),
+                    int(bl.hand[0].src),double(bl.hand[0].reachAt),double(bl.hand[0].gripAt),int(bl.hand[1].src),double(bl.hand[1].reachAt),double(bl.hand[1].gripAt),double(b.now));
+#endif
+      balanceLost = true;
+      }
+    if(float(simTime)>float(BalanceMaxTime)) {
+      if(exceed<0.05f*k && vh.length()<0.6f)
+        bl.recovered = true; else
+        balanceLost = true;
+      }
+    }
+
+  // ---- цели мышц. Корпус - поза анимации с наклоном против хода: уходит назад - сгибается вперёд (центр масс
+  // вперёд), вперёд - чуть выпрямляется, вбок - к другой стороне; голова держит горизонт
+  {
+  const float     sp   = float(vh.length());
+  const btVector3 vdir = sp>0.05f ? vh/sp : btVector3(0,0,0);
+  const float     back = std::max(0.f, -float(vdir.dot(b.fwd)));
+  const float     ang  = deg(std::clamp(10.f*sp*(1.f+0.6f*back), 0.f, 24.f))*smooth((t-0.08f)/0.25f);
+  btVector3       bendW(0,0,0);
+  if(sp>0.05f)
+    bendW = up.cross(-vdir).normalized()*ang;
+  // наклон - тазом (держит driveBalance) и немного позвоночником
+  bl.lean = bendW*0.6f;
+  bendW  *= 0.4f;
+  const float nSpine = float(std::max<size_t>(lay->spineChain.size(),1));
+  drive[0].goal = drive[0].target;
+  for(size_t i=1; i<lay->parts.size(); ++i) {
+    const auto& p = lay->parts[i];
+    if(p.kind==K_Thigh || p.kind==K_Calf)
+      continue;
+    auto&       d   = drive[i];
+    const auto& dp  = drive[p.parent];
+    btTransform cur = dp.goal*(dp.target.inverse()*d.target);
+    btQuaternion q  = btQuaternion::getIdentity();
+    if(std::find(lay->spineChain.begin(),lay->spineChain.end(),i)!=lay->spineChain.end())
+      q = rotOf(bendW*(1.f/nSpine));
+    else if(i==lay->neck || i==lay->head)
+      q = rotOf(bendW*(-0.35f));
+    rotateAbout(cur, cur*pivotOf(i), q);
+    d.goal = cur;
+    }
+  }
+  for(auto& d:drive) {
+    d.hasOverride = false;
+    d.overrideW   = 0;
+    d.hold        = 0;
+    }
+  // ноги: IK от бедра к ступне (стоит - к месту опоры, шагает - к точке дуги), колено вперёд
+  for(int s=0; s<2; ++s) {
+    const size_t th = lay->thigh[s], ca = lay->calf[s];
+    const auto&  lg = bl.leg[s];
+    const btVector3 hip = body[th].rb->getWorldTransform()*pivotOf(th);
+    btVector3 to = lg.anchor;
+    if(!lg.planted && lg.swing>=0.f) {
+      const float u  = std::clamp(lg.swing+0.08f, 0.f, 1.f);
+      const float sm = smooth(u);
+      to = lg.from + (lg.to-lg.from)*sm + lg.bulge*std::sin(float(M_PI)*u);
+      to.setY(to.y() + lg.lift*std::sin(float(M_PI)*u));
+      }
+    const float l1 = 2.f*lay->parts[th].segHalf*0.01f, l2 = 2.f*lay->parts[ca].segHalf*0.01f;
+    // колено - вперёд по направлению тела до толчка: по повёрнутому тазу колени крутили бы таз дальше
+    const btVector3 pole = hf + hl*(0.15f*(s==0 ? 1.f : -1.f));
+    btVector3 du, df;
+    armDirs(hip, to, l1, l2, pole, du, df);
+    // стоящая нога - мягко: её положение задают ступня и таз (вес и равновесие держит driveBalance), мышцы только
+    // ведут колено вперёд; шагающая - сильнее (несёт ногу)
+    const float str = (lg.planted ? 0.18f : 0.55f)*(0.5f+0.5f*bl.support);
+    aimPart(th, du, str, 14.f);
+    aimPart(ca, df, str, 14.f);
+    }
+  tickGrab(dt);
+  balanceArms(dt);
+  }
+
+void Ragdoll::balanceArms(float dt) {
+  // Руки для равновесия (не держатся за опору и не тянутся к ней): разведены в стороны («крылья») и чуть вперёд, тем
+  // выше, чем дальше тело от опоры; когда валится - машут по кругу («мельница» в плоскости падения: вверху рука идёт
+  // против падения - отдача наклоняет тело обратно), каждая в своей фазе; выровнялось - опускаются. Валится вбок -
+  // рука с той стороны выставлена туда, другая поднята противовесом
+  auto&           b    = *beh;
+  auto&           bl   = b.bal;
+  const btVector3 up(0,1,0);
+  const float     k    = lay->size/180.f;
+  btVector3       vh   = bl.vel;
+  vh.setY(0);
+  const float     urge = std::clamp(bl.exceed/(0.22f*k) + float(vh.length())/2.6f, 0.f, 1.f);
+  const float     want = urge>0.15f ? std::clamp(0.3f+urge, 0.f, 1.f) : 0.f;
+  bl.armsW = approach(bl.armsW, want, dt, want>bl.armsW ? 0.12f : 0.45f);
+  bl.flail += dt*(4.f + 3.5f*urge);
+  if(bl.armsW<=0.01f)
+    return;
+  const btVector3 fall = bl.fall.length()>0.5f ? bl.fall : btVector3(0,0,0);
+  const float     mill = std::clamp(urge-0.5f, 0.f, 0.35f)/0.35f;
+  for(int a=0; a<2; ++a) {
+    if(bl.hand[a].src>=0)
+      continue; // тянется к опоре или держится
+    const size_t u = lay->upper[a], f = lay->fore[a];
+    if(u>=body.size() || f>=body.size())
+      continue;
+    const btVector3 sideV = b.left*(a==0 ? 1.f : -1.f);
+    // вбок: >0 - валится в сторону этой руки
+    const float     side  = float(fall.dot(sideV));
+    const float     ph    = bl.flail + (a==0 ? 0.f : 2.4f);
+    btVector3 wantU = sideV*0.8f + b.fwd*0.25f - fall*(0.3f*urge) - up*(0.6f-0.55f*urge);
+    // вбок: эта рука - туда (ниже, к земле), другая - вверх противовесом
+    wantU += up*(-0.35f*std::max(side,0.f) + 0.55f*std::max(-side,0.f))*urge;
+    wantU = wantU.normalized() + (up*std::cos(ph) - fall*std::sin(ph))*(0.55f*mill);
+    // «мельница» внизу круга уводила руку назад за спину: не дальше ~20° назад от плоскости тела
+    wantU.normalize();
+    if(const float bk = float(wantU.dot(b.fwd)); bk<-0.35f)
+      wantU = (wantU + b.fwd*(-0.35f-bk)).normalized();
+    btVector3 wantF = wantU.normalized()*0.6f + b.fwd*0.4f + up*0.1f;
+    aimPart(u, wantU, 0.6f*bl.armsW, 8.f);
+    aimPart(f, wantF, 0.5f*bl.armsW, 8.f);
+    }
+  }
+
+void Ragdoll::tickGrab(float dt) {
+  // Рука к опоре (как в Euphoria и у Gripper active-ragdolls): тело не держит равновесие само - свободная рука ищет
+  // ближайшую опору в пределах руки (стена, край, человек рядом), тянется к ней (IK плеча и локтя; мышцы и
+  // анатомические пределы суставов решают, куда она реально дойдёт) и хватается: сустав «кисть - опора» с пределом
+  // силы хвата. Устоял - отпускает; растянулась, сорвалась - отпускает
+  auto&           b  = *beh;
+  auto&           bl = b.bal;
+  const btVector3 up(0,1,0);
+  const float     k  = lay->size/180.f;
+  btVector3       vh = bl.vel;
+  vh.setY(0);
+  const bool trouble = bl.exceed>0.04f*k || bl.support<0.85f || (vh.length()>0.7f && b.now-bl.at<1.2f);
+  const btVector3 chest = body[lay->chest].rb->getCenterOfMassPosition();
+  for(int a=0; a<2; ++a) {
+    auto& hd = bl.hand[a];
+    const size_t u = lay->upper[a], f = lay->fore[a];
+    if(((bl.freeArms>>a)&1)==0 || u>=body.size() || f>=body.size())
+      continue;
+    const float     l1 = 2.f*lay->parts[u].segHalf*0.01f, l2 = 2.f*lay->parts[f].segHalf*0.01f;
+    const float     lh = lay->hand[a]<body.size() ? 2.f*lay->parts[lay->hand[a]].segHalf*0.01f*0.4f : 0.f;
+    const float     reach = l1+l2+lh;
+    const btVector3 sh = body[u].rb->getWorldTransform()*pivotOf(u);
+    const btVector3 sideV = b.left*(a==0 ? 1.f : -1.f);
+
+    if(hd.gripAt>=0.f) {
+      // держится: опора-человек двигается - рука с ним; устоял - отпускает
+      if(hd.src==1) {
+        // та же точка, за которую схватилась (k-я этого человека), и ладонь там же относительно неё: раньше рука
+        // тянулась к последней его точке в списке - к чужому предплечью, сквозь тело
+        const Grip* g = nullptr;
+        int         n = 0;
+        for(auto& gp:grips)
+          if(gp.id==hd.id && n++==hd.k)
+            g = &gp;
+        if(g==nullptr) {
+          releaseGrip(a);
+          continue;
+          }
+        btVector3 to = btv(g->at) + hd.off;
+        btVector3 d  = to-hd.at;
+        if(d.length()>1.5f*dt)
+          d = d.normalized()*(1.5f*dt);
+        hd.at += d;
+        if(auto c = static_cast<btPoint2PointConstraint*>(hd.c.get()))
+          c->setPivotB(hd.at);
+        }
+      const bool broke = hd.c!=nullptr && !hd.c->isEnabled();
+      if(broke || (sh-hd.at).length()>reach*1.2f || (bl.recovered && b.now-hd.gripAt>0.3f) ||
+         (bl.calm>0.2f && b.now-hd.gripAt>0.5f)) {
+        releaseGrip(a);
+        continue;
+        }
+      btVector3 du, df;
+      armDirs(sh, hd.at, l1, l2+lh, -up*0.5f + sideV*0.6f - b.fwd*0.2f, du, df);
+      aimPart(u, du, 0.6f, 12.f);
+      aimPart(f, df, 0.6f, 12.f);
+      continue;
+      }
+    if(b.now<hd.cool || (!trouble && hd.src<0) || bl.recovered) {
+      hd.src     = -1;
+      hd.reach   = 0;
+      hd.reachAt = -1;
+      continue;
+      }
+
+    // ищет опору (раз в 0,12 с): люди рядом (Npc::ragdollGrips) и стены - лучами от плеча туда, куда валится тело
+    if(hd.src<0 || b.now-hd.scanAt>0.12f) {
+      hd.scanAt = b.now;
+      float     best = 1e9f;
+      int8_t    src  = -1;
+      uint32_t  id   = 0;
+      int       kk   = -1;
+      uint32_t  pid  = 0;
+      int       pn   = 0;
+      btVector3 at   = btVector3(0,0,0), vel = btVector3(0,0,0);
+      // тело летит к опоре - рука тянется заранее (что окажется в пределах руки за 0,35 с)
+      const float ahead = std::min(float(vh.length())*0.35f, 0.6f);
+      const auto& other = bl.hand[1-a];
+      for(auto& gp:grips) {
+        // порядковый номер точки у этого человека (точки одного человека - подряд)
+        if(gp.id!=pid) {
+          pid = gp.id;
+          pn  = 0;
+          }
+        const int       ord = pn++;
+        const btVector3 p = btv(gp.at);
+        const float     d = float((p-sh).length());
+        // слишком близко к плечу (рука так не сложится) или за плечом (плечо назад почти не разгибается) - не достать
+        if(d>reach*1.1f+ahead || d<0.3f*reach || float(((p-sh)/d).dot(b.fwd))<-0.35f)
+          continue;
+        // другая рука уже тянется сюда - эта берётся рядом (за другое плечо, за руку)
+        if(other.src==1 && (other.at-p).length()<0.12f)
+          continue;
+        btVector3 rel = p-chest;
+        rel.setY(0);
+        // не за спиной и со своей стороны тела
+        if(float(rel.dot(b.fwd))<-0.12f || float(rel.dot(sideV))<-0.15f)
+          continue;
+        // своё тело - не опора: точка в своём теле или рука дотянулась бы до неё только сквозь свой корпус -
+        // держаться было бы за самого себя (человек вплотную - можно: точка на его теле, у своего)
+        if(insideSelf(p, 0.f) || reachesThroughSelf(sh,p))
+          continue;
+        const float score = d - 0.25f*std::max(0.f, float(((p-sh)/d).dot(bl.fall)));
+        if(score<best) {
+          best = score;
+          src  = 1;
+          id   = gp.id;
+          kk   = ord;
+          at   = p;
+          vel  = btv(gp.vel);
+          }
+        }
+      const btVector3 fall = bl.fall.length()>0.5f ? bl.fall : b.fwd;
+      const btVector3 dirs[4] = {
+        fall,
+        (fall*0.75f + sideV*0.65f).normalized(),
+        (sideV*0.85f + fall*0.35f).normalized(),
+        (fall*0.8f - up*0.6f).normalized(),
+        };
+      for(auto& d:dirs) {
+        const Vec3 from = cmv(sh);
+        const Vec3 to   = cmv(sh + d*(reach + ahead*std::max(0.f, float(d.dot(vh.normalized())))));
+        const auto r    = owner->ray(from,to);
+        if(!r.hasCol)
+          continue;
+        btVector3 nrm(r.n.x,r.n.y,r.n.z);
+        if(nrm.length()<1e-3f)
+          nrm = -d;
+        nrm.normalize();
+        btVector3 p = btv(r.v) + nrm*0.025f;
+        // земля под ногами - не опора для хвата (падая, руки к ней выставляет tickFallPose)
+        const float groundY = float(bl.cop.y());
+        if(nrm.y()>0.7f && p.y()<groundY+0.5f*k)
+          continue;
+        // стена за спиной: до точки за плечами рука не достанет (плечо назад не разгибается) - ладонь на стену ниже
+        // и сбоку, у бедра, как у человека, прислонившегося к стене
+        if(std::abs(float(nrm.y()))<0.6f && float((p-chest).dot(b.fwd))<-0.05f) {
+          p += sideV*(0.18f*k) - up*(0.42f*k);
+          p.setY(std::max(float(p.y()), groundY+0.55f*k));
+          // у самой стены ладонь у бедра оказалась бы на своём теле - дальше в сторону, по стене
+          for(int n=0; n<3 && insideSelf(p, 0.05f*k); ++n)
+            p += sideV*(0.08f*k);
+          }
+        // своё тело - не опора (стена вплотную к телу: точка на нём самом, или рука - сквозь корпус)
+        if(insideSelf(p, 0.05f*k) || reachesThroughSelf(sh,p))
+          continue;
+        const float dd    = float((p-sh).length());
+        const float score = dd + (d.y()<-0.3f ? 0.08f : 0.f);
+        if(score<best) {
+          best = score;
+          src  = 0;
+          id   = 0;
+          at   = p;
+          vel  = btVector3(0,0,0);
+          }
+        }
+      hd.src = src;
+      hd.id  = id;
+      hd.k   = kk;
+      if(src>=0) {
+        hd.at  = at;
+        hd.vel = vel;
+        }
+      }
+    if(hd.src<0) {
+      hd.reach   = 0;
+      hd.reachAt = -1;
+      continue;
+      }
+    // тянется: рефлекс быстрый (~0,15 с)
+    if(hd.reachAt<0.f)
+      hd.reachAt = b.now;
+    hd.reach = approach(hd.reach, 1.f, dt, 0.08f);
+    if(hd.src==1)
+      hd.at += hd.vel*dt;
+    btVector3 du, df;
+    armDirs(sh, hd.at, l1, l2+lh, -up*0.5f + sideV*0.6f - b.fwd*0.2f, du, df);
+    aimPart(u, du, 0.9f*hd.reach, 14.f);
+    aimPart(f, df, 0.9f*hd.reach, 14.f);
+    if(lay->hand[a]<body.size())
+      aimPart(lay->hand[a], df, 0.5f*hd.reach, 12.f);
+    // схватилась: ладонь у опоры - держится там, где коснулась (без рывка к точке)
+    const btVector3 hp = handPos(a);
+#ifdef RAGDOLL_TRACE
+    if(std::getenv("BTRACE"))
+      std::printf("     hand %d src %d reach %.2f to (%.0f %.0f %.0f) dist %.0f cm, shoulder dist %.0f (reach %.0f)\n",a,int(hd.src),double(hd.reach),
+                  double(hd.at.x()*100),double(hd.at.y()*100),double(hd.at.z()*100),double((hp-hd.at).length()*100),
+                  double((sh-hd.at).length()*100),double(reach*100));
+#endif
+    // ладонь у опоры - или рука упёрлась в того человека у точки хвата (дальше его тело не пускает)
+    const bool touched = hd.src==1 && armTouch[a]==hd.id && armTouchAt[a]+3>=stepNo && (hp-hd.at).length()<0.32f*k;
+    if((hp-hd.at).length()<0.12f*k || touched) {
+      const size_t hb = lay->hand[a]<body.size() ? lay->hand[a] : f;
+      auto&        rb = *body[hb].rb;
+      auto c = std::make_unique<btPoint2PointConstraint>(rb, rb.getWorldTransform().inverse()*hp);
+      c->setPivotB(hp);
+      c->setOverrideNumSolverIterations(solverIt);
+      owner->world->addConstraint(c.get(),true);
+      hd.c      = std::move(c);
+      hd.off    = btVector3(0,0,0);
+      if(hd.src==1) {
+        int n = 0;
+        for(auto& gp:grips)
+          if(gp.id==hd.id && n++==hd.k)
+            hd.off = hp-btv(gp.at);
+        }
+      hd.at     = hp;
+      hd.gripAt = b.now;
+      Log::i("[g2m] ragdoll: grabs ",hd.src==1 ? "a person" : "a wall");
+      }
+    }
+  }
+
+void Ragdoll::driveBalance(float dt) {
+  // Каждый шаг физики. Вес тела держат ноги (на долю опоры тяжесть уравновешена - сила земли через ступни); по
+  // горизонтали - перевёрнутый маятник: центр масс уходит от центра давления с ускорением w^2*(com - cop) - точка
+  // захвата в опоре, и тело плавно останавливается над ней, вне опоры - валится, пока шаг не поймает; ноги держат
+  // таз на высоте стойки; корпус - к вертикали (как SIMBICON держит корпус в мире); стоящие ступни держит трение,
+  // шагающая идёт по дуге к месту шага
+  auto&           b  = *beh;
+  auto&           bl = b.bal;
+  const btVector3 up(0,1,0);
+  const float     g  = DynamicWorld::gravityMS;
+  const float     s  = bl.support;
+  const float     k  = lay->size/180.f;
+  btVector3 com, vel;
+  massCenter(com,vel);
+  btVector3 vh = vel;
+  vh.setY(0);
+  const float w  = std::sqrt(g/std::max(bl.comH,0.5f));
+  const float gy = float(bl.cop.y());
+  float M = 0;
+  for(auto& p:lay->parts)
+    M += p.mass;
+
+  // центр давления: точка захвата в опоре - она сама (по нынешней скорости), иначе край опоры
+  btVector3 cop = bl.cop;
+  if(bl.exceed<=0.f) {
+    cop = com + vh/w;
+    cop.setY(gy);
+    }
+  btVector3 aH = (com-cop)*(w*w);
+  aH.setY(0);
+  // точка захвата в опоре: голеностопы и бёдра гасят остаток скорости (стратегии голеностопа и бедра) - тело
+  // останавливается быстрее, чем точечная опора маятника
+  if(bl.exceed<=0.f)
+    aH -= vh*2.5f;
+  if(aH.length()>0.9f*g)
+    aH = aH.normalized()*(0.9f*g);
+  // высота таза: колени чуть согнуты, на шаге и при сильном толчке - ниже
+  const btVector3 pel   = body[0].rb->getCenterOfMassPosition();
+  const float     crouch= (0.03f + 0.04f*std::min(float(vh.length())/1.5f,1.f))*k;
+  const float     hT    = bl.pelH - crouch;
+  const float     hp    = float(pel.y())-gy;
+  const float     vy    = float(body[0].rb->getLinearVelocity().y());
+  const float     aY    = std::clamp(40.f*(hT-hp) - 9.f*vy, -7.f, 7.f);
+  const btVector3 dv    = (aH + btVector3(0, g+aY, 0))*(dt*s);
+  for(auto& bd:body) {
+    auto& rb = *bd.rb;
+    rb.setLinearVelocity(rb.getLinearVelocity()+dv);
+    }
+
+  // корпус к вертикали (как SIMBICON держит корпус в мире, а не относительно ног): таз - так, чтобы «вверх» его кадра
+  // анимации смотрел вверх, с наклоном против хода (tickBalance: bl.lean); поворот вокруг вертикали гасится. Мышцы
+  // бёдер в опоре таз не крутят: иначе тело с закреплёнными ступнями падает целиком, как столб
+  {
+  auto&              rb  = *body[0].rb;
+  const btQuaternion qT  = drive[0].target.getRotation();
+  const btVector3    uL  = quatRotate(qT.inverse(), up);
+  const btVector3    uC  = quatRotate(rb.getWorldTransform().getRotation(), uL);
+  const btVector3    uW  = quatRotate(rotOf(bl.lean), up);
+  btVector3          ax  = uC.cross(uW);
+  const float        sn  = float(ax.length());
+  const float        ang = std::atan2(sn, float(uC.dot(uW)));
+  const btVector3    wv  = rb.getAngularVelocity();
+  const btVector3    wy  = up*wv.dot(up);
+  const btVector3    wt  = wv-wy;
+  constexpr float    Wn  = 16.f;
+  btVector3 acc = -wt*(2.f*Wn);
+  if(sn>1e-5f)
+    acc += ax*(ang/sn)*(Wn*Wn);
+  const float mx = 120.f;
+  if(acc.length()>mx)
+    acc = acc.normalized()*mx;
+  // направление тела: к тому, куда смотрело до толчка (удар в плечо разворачивает - потом тело возвращается).
+  // Отдельно от наклона и сильнее: ноги, разошедшиеся вперёд и назад, крутят таз, и без этого тело на шагах
+  // поворачивается на полоборота
+  {
+  const btVector3 f  = horizontal(btv(bodyFront()));
+  const float     yw = std::atan2(float(f.cross(bl.heading).dot(up)), float(f.dot(bl.heading)));
+  btVector3       ay = up*(150.f*yw) - wy*24.f;
+  if(ay.length()>80.f)
+    ay = ay.normalized()*80.f;
+  acc += ay;
+  }
+  // момент - тазу и корпусу вместе, поворотом вокруг их общего центра масс (импульс тела не меняется): иначе
+  // позвоночник гнётся, а корпус не выпрямляется
+  // в первые мгновения после толчка корпус держится в полную силу (человек напрягается всем телом), потом - по опоре
+  const float     sw = (b.now-bl.at<0.8f) ? std::max(s,0.7f) : std::max(s,0.3f);
+  const btVector3 dw = acc*(dt*sw);
+  btVector3 c0 = rb.getCenterOfMassPosition()*lay->parts[0].mass;
+  float     m0 = lay->parts[0].mass;
+  for(auto i:lay->spineChain) {
+    c0 += body[i].rb->getCenterOfMassPosition()*lay->parts[i].mass;
+    m0 += lay->parts[i].mass;
+    }
+  c0 /= m0;
+  auto turn = [&](btRigidBody& r2, float w) {
+    r2.setAngularVelocity(r2.getAngularVelocity()+dw*w);
+    r2.setLinearVelocity (r2.getLinearVelocity() +(dw*w).cross(r2.getCenterOfMassPosition()-c0));
+    };
+  turn(rb,1.f);
+  for(auto i:lay->spineChain)
+    turn(*body[i].rb,0.7f);
+  }
+
+  // ступни
+  const float hold = 1.3f*M*g*dt; // трение подошвы: больше точка опоры не удержит - ступня скользит
+  for(int sd=0; sd<2; ++sd) {
+    auto& lg = bl.leg[sd];
+    if(lg.planted) {
+      if(auto c = static_cast<btPoint2PointConstraint*>(lg.pin.get()))
+        c->m_setting.m_impulseClamp = hold;
+      // подошва и вокруг вертикали держится трением: стоящая нога не крутится на месте, иначе взмах шагающей ноги
+      // разворачивает таз, и шаги «назад» уходят вбок
+      auto&           cr = *body[lay->calf[sd]].rb;
+      const btVector3 cw = cr.getAngularVelocity();
+      cr.setAngularVelocity(cw - up*(float(cw.dot(up))*std::min(1.f, dt/0.03f)));
+      continue;
+      }
+    if(lg.swing<0.f)
+      continue;
+    auto arc = [&](float u) {
+      u = std::clamp(u,0.f,1.f);
+      const float sm = smooth(u);
+      btVector3 p = lg.from + (lg.to-lg.from)*sm + lg.bulge*std::sin(float(M_PI)*u);
+      p.setY(p.y() + lg.lift*std::sin(float(M_PI)*u));
+      return p;
+      };
+    const float     u    = lg.swing;
+    const btVector3 P    = arc(u);
+    const btVector3 P2   = arc(u + dt/lg.dur);
+    const btVector3 vArc = (P2-P)/std::max(dt,1e-4f);
+    auto&           rb   = *body[lay->calf[sd]].rb;
+    const btVector3 ank  = anklePos(sd);
+    const btVector3 r    = ank-rb.getCenterOfMassPosition();
+    const btVector3 vA   = rb.getVelocityInLocalPoint(r);
+    btVector3       dvA  = vArc + (P-ank)/0.05f - vA;
+    if(dvA.length()>8.f)
+      dvA = dvA.normalized()*8.f;
+    const btVector3 J = dvA*(0.6f*lay->parts[lay->calf[sd]].mass);
+    rb.applyImpulse(J, r);
+    rb.activate(true);
+    // ногу несут мышцы бедра: отдача - тазу в тазобедренном суставе (сила внутри тела). Иначе толчок ноги снаружи
+    // упирается в точку опоры другой ступни сбоку от центра масс и крутит всё тело вокруг вертикали
+    {
+    auto&           pr  = *body[0].rb;
+    const btVector3 hip = body[lay->thigh[sd]].rb->getWorldTransform()*pivotOf(lay->thigh[sd]);
+    btVector3       Jh  = -J;
+    Jh.setY(0);
+    pr.applyImpulse(Jh, hip-pr.getCenterOfMassPosition());
+    }
+    }
+  // хват: предел силы - как держит кисть (сорвётся - отпустит, tickGrab)
+  for(auto& hd:bl.hand)
+    if(auto c = static_cast<btPoint2PointConstraint*>(hd.c.get()))
+      c->m_setting.m_impulseClamp = 450.f*k*k*dt;
+  }
+
+// ---- Подъём телом (S_GetUp)
+
+bool Ragdoll::startGetUp(float riseAt) {
+  if(!lay->humanoid || !lay->stance)
+    return false;
+  if(st!=S_Fall && st!=S_Unconscious)
+    return false;
+  if(!isSimulated()) {
+    // застывшее тело оживает, если в физике есть место
+    const State was = st;
+    st = S_Fall;
+    const bool ok = wake();
+    if(!ok) {
+      st = was;
+      return false;
+      }
+    }
+  if(beh==nullptr)
+    beh = std::make_unique<Behave>();
+  auto& b = *beh;
+  b.throes = Behave::Throes();
+  b.sag    = false;
+  b.reflex.clear();
+  for(auto& d:drive) {
+    d.hasOverride = false;
+    d.overrideW   = 0;
+    d.hold        = 0;
+    d.dip         = 0;
+    d.dip0        = 0;
+    }
+  for(int s=0; s<2; ++s) {
+    body[lay->thigh[s]].rb->setFriction(0.8f);
+    body[lay->calf [s]].rb->setFriction(0.8f);
+    }
+  st = S_GetUp;
+  removeJoints();
+  createJoints();
+  setActiveCollisions(false);
+  for(auto& bd:body) {
+    bd.rb->setDamping(0.05f,0.25f);
+    bd.rb->setActivationState(DISABLE_DEACTIVATION);
+    }
+  setSolverIterations(solverIt);
+  b.getUp         = Behave::GetUp();
+  b.getUp.on      = true;
+  b.getUp.riseAt  = riseAt;
+  simTime    = 0;
+  calmTime   = 0;
+  damping    = 0;
+  fallPeak   = 0;
+  impact     = 0;
+  groundTime = 0;
+  airTime    = 0;
+  hasTarget  = false;
+  Log::i("[g2m] ragdoll: gets up by itself");
+  return true;
+  }
+
+void Ragdoll::tickGetUp(float dt) {
+  // опора: руки, колени, ступни (и таз) касаются земли - на них тело поднимается; ошибка - таз и грудь от кадра
+  auto& gu = beh->getUp;
+  const btVector3 pel = body[0].rb->getCenterOfMassPosition();
+  const float     gy  = groundAt(pel, float(pel.y())-0.15f);
+  float n = 0;
+  bool  hand[2] = {}, knee[2] = {};
+  for(size_t i=0; i<body.size(); ++i) {
+    const auto&        p  = lay->parts[i];
+    const btTransform& tr = body[i].rb->getWorldTransform();
+    const btVector3    ax = tr.getBasis().getColumn(0);
+    const float        lo = float(tr.getOrigin().y()) - std::abs(float(ax.y()))*p.halfLen*0.01f - p.radius*0.01f;
+    if(lo>gy+0.06f)
+      continue;
+    for(int s=0; s<2; ++s) {
+      if(i==lay->fore[s] || i==lay->hand[s] || i==lay->upper[s])
+        hand[s] = true;
+      if(i==lay->calf[s] || i==lay->thigh[s])
+        knee[s] = true;
+      }
+    }
+  for(int s=0; s<2; ++s)
+    n += (hand[s] ? 1.f : 0.f) + (knee[s] ? 1.f : 0.f);
+  // таз у земли - опирается и им (сидя, лёжа)
+  if(float(pel.y())-gy<0.35f*lay->size/180.f)
+    n += 1.f;
+  gu.contact = approach(gu.contact, std::clamp(n/2.f, 0.f, 1.f), dt, 0.08f);
+  if(drive.size()==body.size()) {
+    const float e0 = float((pel - drive[0].goal.getOrigin()).length());
+    const float e1 = float((body[lay->chest].rb->getCenterOfMassPosition() - drive[lay->chest].goal.getOrigin()).length());
+    gu.err = 50.f*(e0+e1);
+    }
+  }
+
+void Ragdoll::driveGetUp(float dt) {
+  // Опора о землю поднимает тело (как pin weight PuppetMaster): каждая часть тянется к своему месту в кадре анимации
+  // подъёма (таз и корпус - сильнее, руки и ноги - слабее, их ведут и мышцы), вес держится - с силой, которая
+  // нарастает к riseAt..riseAt+0,6 с и только пока тело на земле или опирается на неё (подбросили, сбили - опоры
+  // нет, тело падает). Ускорение части - с пределом: тело не прыгает к кадру, а поднимается
+  auto&       gu  = beh->getUp;
+  const float t   = float(simTime)/1000.f;
+  // собирается (поза лёжа, из которой начинается подъём) - опора слабая, поднимается - нарастает
+  const float pin = (0.3f + 0.7f*smooth((t-gu.riseAt+0.1f)/0.6f))*smooth(t/0.25f)*gu.contact;
+  if(pin<=0.f || !hasTarget)
+    return;
+  const float g = DynamicWorld::gravityMS;
+  for(size_t i=0; i<body.size(); ++i) {
+    auto&              rb = *body[i].rb;
+    const auto&        d  = drive[i];
+    const auto&        p  = lay->parts[i];
+    float              w  = 0.4f;
+    switch(Kind(p.kind)) {
+      case K_Pelvis:
+      case K_Spine:    w = 1.f;  break;
+      case K_Neck:
+      case K_Head:     w = 0.6f; break;
+      case K_Thigh:    w = 0.7f; break;
+      case K_Calf:     w = 0.6f; break;
+      default:         w = 0.4f; break;
+      }
+    w *= pin;
+    const btVector3    tp = d.goal.getOrigin() + d.tLin*targetAge;
+    const btQuaternion tq = rotOf(d.tAng*targetAge)*d.goal.getRotation();
+    btVector3 a = (tp-rb.getCenterOfMassPosition())*80.f + (d.tLin-rb.getLinearVelocity())*16.f;
+    if(a.length()>18.f)
+      a = a.normalized()*18.f;
+    rb.setLinearVelocity(rb.getLinearVelocity() + (a + btVector3(0,0.9f*g,0))*(dt*w));
+    if(p.kind==K_Pelvis || p.kind==K_Spine || p.kind==K_Head) {
+      btVector3 aw = rotErr(rb.getWorldTransform().getRotation(),tq)*60.f + (d.tAng-rb.getAngularVelocity())*14.f;
+      if(aw.length()>40.f)
+        aw = aw.normalized()*40.f;
+      rb.setAngularVelocity(rb.getAngularVelocity() + aw*(dt*w));
+      }
+    rb.activate(true);
+    }
+  }
+
+void Ragdoll::createBodies() {
+  if(!body.empty())
+    return;
+  auto& cw = *owner->world;
+  solverIt = solverItFor(viewDist);
+  body.resize(lay->parts.size());
+  pivot.assign(lay->parts.size(),Vec3());
+
+  std::vector<btTransform> bw(lay->parts.size());
+  for(size_t i=0; i<lay->parts.size(); ++i) {
+    auto& p = lay->parts[i];
+    auto& b = body[i];
+    bw[i] = toBt(boneWorld[i]*p.bodyInBone);
+
+    const float r = p.radius*0.01f, h = 2.f*p.halfLen*0.01f;
+    b.shape.reset(new btCapsuleShapeX(r,h));
+    // инерция - по капсуле кости (bare): одежда толщиной тело не тяжелит и не делает неповоротливым
+    btVector3 inertia = {};
+    btCapsuleShapeX(p.bare*0.01f, 2.f*(p.halfLen+p.radius-p.bare)*0.01f).calculateLocalInertia(p.mass,inertia);
+    btRigidBody::btRigidBodyConstructionInfo ci(p.mass,nullptr,b.shape.get(),inertia);
+    ci.m_friction           = 0.8f;
+    ci.m_rollingFriction    = 0.06f;
+    ci.m_spinningFriction   = 0.06f;
+    ci.m_restitution        = 0.f;
+    ci.m_linearDamping      = 0.05f;
+    ci.m_angularDamping     = 0.25f;
+    ci.m_linearSleepingThreshold  = 0.1f;
+    ci.m_angularSleepingThreshold = 0.25f;
+    b.rb.reset(new btRigidBody(ci));
+    b.rb->setWorldTransform(bw[i]);
+    b.rb->setUserIndex(DynamicWorld::C_Ragdoll);
+    b.rb->setUserPointer(this);
+    // мелкие части на большой скорости не должны проскакивать сквозь пол
+    b.rb->setCcdMotionThreshold(r*0.5f);
+    b.rb->setCcdSweptSphereRadius(r*0.8f);
+    b.rb->setActivationState(ACTIVE_TAG);
+    }
+
+  // где сустав в системе кости-родителя: туда кость-потомок ставится при выводе позы
+  for(size_t i=1; i<lay->parts.size(); ++i) {
+    Matrix4x4 inv = boneWorld[lay->parts[i].parent];
+    inv.inverse();
+    Vec3 piv = originOf(boneWorld[i]);
+    inv.project(piv);
+    pivot[i] = piv;
+    }
+
+  for(auto& b:body)
+    cw.addRagdollBody(b.rb.get());
+  drive.assign(lay->parts.size(),Drive());
+  for(size_t i=0; i<body.size(); ++i) {
+    drive[i].target = body[i].rb->getWorldTransform();
+    drive[i].goal   = drive[i].target;
+    }
+  createJoints();
+  setActiveCollisions(st==S_Active);
+  if(st==S_Active && beh==nullptr)
+    beh = std::make_unique<Behave>();
+
+  simTime  = 0;
+  calmTime = 0;
+  waterAt  = 0;
+  fallPeak = 0;
+  impact   = 0;
+  inWater  = false;
+  damping  = 0;
+  show     = 0;
+  owner->addRagdoll(this);
+  }
+
+void Ragdoll::createJoints() {
+  // Суставы - по нынешнему положению тел. У людей - анатомические (Layout::Part::joint): системы и пределы от
+  // нейтральной позы тела; если тело сейчас за пределом (поза анимации, удар), предел сначала шире и сходится к
+  // анатомическому плавно (fitLimits, tickLimits). На ногах (активный регдолл) - те же суставы, пределы
+  // расширяются до цели анимации (setTarget); у зверей на ногах - без пределов. У зверей упавших - конусы вокруг
+  // позы в момент падения
+  auto& cw = *owner->world;
+  std::vector<btTransform> bw(body.size());
+  for(size_t i=0; i<body.size(); ++i)
+    bw[i] = body[i].rb->getWorldTransform();
+  updateBones();
+
+  for(size_t i=1; i<lay->parts.size(); ++i) {
+    auto&        p  = lay->parts[i];
+    const size_t pp = p.parent;
+    auto&        ra = *body[pp].rb;
+    auto&        rb = *body[i ].rb;
+    if(st==S_Active && p.pinned)
+      continue; // на ногах таз и ноги - каждый за своей целью: сустав между ними только дёргал бы таз
+
+    // сустав - начало кости-потомка в кости-родителе (в нынешней позе)
+    Vec3 piv = pivot[i];
+    boneWorld[pp].project(piv);
+    const btVector3 pw = btv(piv);
+
+    Joint jt;
+    jt.parent = uint16_t(pp);
+    jt.child  = uint16_t(i);
+    if(p.joint==J_Euler || p.joint==J_Swing) {
+      btTransform fa = toBt(p.jointInParent), fb = toBt(p.jointInChild);
+      fa.setOrigin(bw[pp].inverse()*pw);
+      fb.setOrigin(bw[i ].inverse()*pw);
+      jt.type = p.joint;
+      if(p.joint==J_Euler) {
+        auto g = std::make_unique<btGeneric6DofSpring2Constraint>(ra,rb,fa,fb,RO_XYZ);
+        for(int ax=0; ax<3; ++ax) {
+          g->setParam(BT_CONSTRAINT_STOP_ERP,0.8f,ax);   // сустав не расходится
+          g->setParam(BT_CONSTRAINT_STOP_ERP,0.45f,ax+3); // упор в предел - мягко, без отскока и дрожи
+          }
+        jt.c = std::move(g);
+        } else {
+        auto ct = std::make_unique<btConeTwistConstraint>(ra,rb,fa,fb);
+        for(int ax=0; ax<3; ++ax)
+          ct->setParam(BT_CONSTRAINT_ERP,0.8f,ax);
+        jt.c = std::move(ct);
+        }
+      // поза сейчас - внутри пределов (с запасом 3°): падение начинается без рывка
+      fitLimits(jt, bw[pp].getRotation(), bw[i].getRotation(), deg(3));
+      applyLimits(jt);
+      }
+    else if(st==S_Active) {
+      // зверь на ногах: суставы без пределов - позу держат мышцы
+      jt.c = std::make_unique<btPoint2PointConstraint>(ra,rb,bw[pp].inverse()*pw,bw[i].inverse()*pw);
+      }
+    else {
+      // конус с центром в позе падения: ось - кость-потомок; сустав - там, где кость-потомок начинается.
+      // Упал с ног (активный регдолл) - центр ближе к позе анимации
+      btTransform j = bw[i];
+      if(hasTarget && drive.size()==body.size()) {
+        const btQuaternion relCur  = bw[pp].getRotation().inverse()*bw[i].getRotation();
+        const btQuaternion relAnim = drive[pp].target.getRotation().inverse()*drive[i].target.getRotation();
+        const float        off     = rotErr(relAnim,relCur).length();
+        const float        lim     = 0.75f*std::min(std::min(p.swing1,p.swing2), std::max(p.twist,deg(20.f)));
+        const float        k       = off>lim ? 1.f-lim/off : 0.f;
+        j.setRotation(bw[pp].getRotation()*relAnim.slerp(relCur,k));
+        }
+      j.setOrigin(pw);
+      const btTransform fa = bw[pp].inverse()*j;
+      const btTransform fb = bw[i ].inverse()*j;
+      auto ct = std::make_unique<btConeTwistConstraint>(ra,rb,fa,fb);
+      ct->setLimit(p.swing1,p.swing2,p.twist,0.9f,0.3f,1.f);
+      for(int ax=0; ax<3; ++ax)
+        ct->setParam(BT_CONSTRAINT_ERP,0.8f,ax);
+      jt.c = std::move(ct);
+      }
+    jt.c->setOverrideNumSolverIterations(jointIterations());
+    joint.push_back(std::move(jt));
+    }
+
+  for(auto& j:joint)
+    cw.addConstraint(j.c.get(),true);
+  }
+
+btQuaternion Ragdoll::jointRel(const Joint& j, const btQuaternion& qa, const btQuaternion& qb) const {
+  // поворот системы сустава потомка относительно системы сустава родителя (тела повёрнуты на qa, qb)
+  const auto&        p  = lay->parts[j.child];
+  const btQuaternion fa = toBt(p.jointInParent).getRotation();
+  const btQuaternion fb = toBt(p.jointInChild ).getRotation();
+  return (qa*fa).inverse()*(qb*fb);
+  }
+
+void Ragdoll::fitLimits(Joint& j, const btQuaternion& qa, const btQuaternion& qb, float margin) {
+  // пределы сустава - не уже позы (qa, qb - повороты тел): расширение ext с запасом margin
+  if(j.type!=J_Euler && j.type!=J_Swing)
+    return;
+  const auto&        p   = lay->parts[j.child];
+  const btQuaternion rel = jointRel(j,qa,qb);
+  if(j.type==J_Euler) {
+    const btVector3 e = eulerOf(rel);
+    for(int k=0; k<3; ++k) {
+      const float v = float(e[k]);
+      if(v<p.lo[k]-j.ext[k][0])
+        j.ext[k][0] = p.lo[k]-v+margin;
+      if(v>p.hi[k]+j.ext[k][1])
+        j.ext[k][1] = v-p.hi[k]+margin;
+      }
+    // средняя ось (Y) Эйлера - не дальше 80°: там углы вырождаются
+    j.ext[1][0] = std::min(j.ext[1][0], std::max(deg(80)+p.lo[1], 0.f));
+    j.ext[1][1] = std::min(j.ext[1][1], std::max(deg(80)-p.hi[1], 0.f));
+    return;
+    }
+  const btVector3 sw = swingOf(rel);
+  const float     tw = std::abs(float(sw.x()));
+  if(tw>p.hi[0]+j.ext[0][1])
+    j.ext[0][1] = std::min(tw-p.hi[0]+margin, float(M_PI)-p.hi[0]);
+  const float ry = float(sw.y())/p.hi[1], rz = float(sw.z())/p.hi[2];
+  const float r  = std::sqrt(ry*ry+rz*rz);
+  const float mx = std::max(p.hi[1],p.hi[2]);
+  if(r>1.f+j.ext[1][1])
+    j.ext[1][1] = std::min(r-1.f+margin/mx, deg(170)/mx-1.f);
+  }
+
+float Ragdoll::overLimit(bool arms) const {
+  float ret = 0;
+  for(auto& j:joint) {
+    if(j.type!=J_Euler && j.type!=J_Swing)
+      continue;
+    const auto& p = lay->parts[j.child];
+    if(arms && p.kind!=K_UpperArm)
+      continue;
+    const btQuaternion rel = jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),
+                                        body[j.child ].rb->getWorldTransform().getRotation());
+    if(j.type==J_Euler) {
+      const btVector3 e = eulerOf(rel);
+      for(int k=0; k<3; ++k)
+        ret = std::max(ret, std::max(p.lo[k]-float(e[k]), float(e[k])-p.hi[k]));
+      continue;
+      }
+    const btVector3 sw = swingOf(rel);
+    ret = std::max(ret, std::abs(float(sw.x()))-p.hi[0]);
+    const float ry = float(sw.y())/p.hi[1], rz = float(sw.z())/p.hi[2];
+    const float r  = std::sqrt(ry*ry+rz*rz);
+    // за эллипсом: угол сверх предела в этом направлении
+    if(r>1.f)
+      ret = std::max(ret, float(std::sqrt(sw.y()*sw.y()+sw.z()*sw.z()))*(1.f-1.f/r));
+    }
+  return ret*180.f/float(M_PI);
+  }
+
+void Ragdoll::applyLimits(Joint& j) {
+  // пределы с расширением - в Bullet, если заметно изменились. У 6DOF Bullet угол - с обратным знаком
+  if(j.type!=J_Euler && j.type!=J_Swing)
+    return;
+  const auto& p = lay->parts[j.child];
+  float want[3][2] = {};
+  if(j.type==J_Euler) {
+    for(int k=0; k<3; ++k) {
+      want[k][0] = p.lo[k]-j.ext[k][0];
+      want[k][1] = p.hi[k]+j.ext[k][1];
+      }
+    } else {
+    const float s = 1.f+j.ext[1][1];
+    want[0][1] = p.hi[0]+j.ext[0][1];
+    want[1][1] = p.hi[1]*s;
+    want[2][1] = p.hi[2]*s;
+    }
+  bool changed = j.fresh;
+  for(int k=0; k<3; ++k)
+    for(int e=0; e<2; ++e)
+      changed |= std::abs(want[k][e]-j.shown[k][e])>deg(0.4f);
+  if(!changed)
+    return;
+  std::memcpy(j.shown,want,sizeof(want));
+  j.fresh = false;
+  if(j.type==J_Euler) {
+    auto& g = static_cast<btGeneric6DofSpring2Constraint&>(*j.c);
+    g.setAngularLowerLimit(btVector3(-want[0][1],-want[1][1],-want[2][1]));
+    g.setAngularUpperLimit(btVector3(-want[0][0],-want[1][0],-want[2][0]));
+    } else {
+    auto& ct = static_cast<btConeTwistConstraint&>(*j.c);
+    ct.setLimit(want[2][1],want[1][1],want[0][1],0.9f,0.3f,1.f);
+    }
+  }
+
+void Ragdoll::tickLimits(float dt) {
+  // расширение пределов сходится к анатомическому: сустав возвращается не быстрее LimitReturn
+  for(auto& j:joint) {
+    if(j.type!=J_Euler && j.type!=J_Swing)
+      continue;
+    const float d = LimitReturn*dt;
+    for(auto& a:j.ext)
+      for(auto& e:a)
+        e = std::max(0.f, e-d);
+    applyLimits(j);
+    }
+  }
+
+void Ragdoll::removeJoints() {
+  auto& cw = *owner->world;
+  for(auto& j:joint)
+    cw.removeConstraint(j.c.get());
+  joint.clear();
+  }
+
+void Ragdoll::setActiveCollisions(bool active) {
+  // На ногах части тела друг друга не толкают (руки в анимации проходят у тела), а закреплённые за анимацией таз и
+  // ноги ни с чем не сталкиваются: где стоять, решает перемещение NPC. Упал - как у тряпичной куклы
+  for(size_t i=0; i<body.size(); ++i)
+    for(size_t r=i+1; r<body.size(); ++r) {
+      body[i].rb->setIgnoreCollisionCheck(body[r].rb.get(),active);
+      body[r].rb->setIgnoreCollisionCheck(body[i].rb.get(),active);
+      }
+  if(!active)
+    for(auto& i:lay->noCollide) {
+      body[i.first ].rb->setIgnoreCollisionCheck(body[i.second].rb.get(),true);
+      body[i.second].rb->setIgnoreCollisionCheck(body[i.first ].rb.get(),true);
+      }
+
+  for(size_t i=0; i<body.size(); ++i) {
+    auto& rb = *body[i].rb;
+    int   fl = rb.getCollisionFlags() & ~btCollisionObject::CF_NO_CONTACT_RESPONSE;
+    if(active && lay->parts[i].pinned)
+      fl |= btCollisionObject::CF_NO_CONTACT_RESPONSE;
+    rb.setCollisionFlags(fl);
+    if(active)
+      rb.setActivationState(DISABLE_DEACTIVATION); else
+      rb.forceActivationState(ACTIVE_TAG);
+    }
+  }
+
+void Ragdoll::removeBodies() {
+  if(body.empty())
+    return;
+  auto& cw = *owner->world;
+  removeAnchors();
+  releaseGrip(0);
+  releaseGrip(1);
+  if(beh!=nullptr) {
+    beh->bal.on   = false;
+    beh->getUp.on = false;
+    }
+  removeJoints();
+  for(auto& b:body)
+    cw.removeRagdollBody(b.rb.get());
+  body.clear();
+  drive.clear();
+  hasTarget = false;
+  if(beh!=nullptr) {
+    beh->pushAt   = -1;
+    beh->pushVel  = 0;
+    beh->stepping = false;
+    beh->stance   = false;
+    beh->sag      = false;
+    beh->reflex.clear();
+    // застыло посреди агонии (бюджет, далеко) - агония кончилась: поза остаётся, дыхание - у Npc
+    auto& th = beh->throes;
+    if(th.want && !th.done) {
+      if(th.on) {
+        th.done   = true;
+        th.doneAt = 0;
+        } else {
+        th.want = false;
+        }
+      }
+    th.raised = false;
+    }
+  owner->delRagdoll(this);
+  }
+
+bool Ragdoll::wake() {
+  if(isSimulated())
+    return true;
+  // застывшее тело оживает от удара, только если в физике есть место
+  if(!reserve(*owner,viewDist,st,keep))
+    return false;
+  createBodies();
+  ver++;
+  return isSimulated();
+  }
+
+void Ragdoll::freeze() {
+  if(!isSimulated())
+    return;
+  updateBones();
+  removeBodies();
+  ver++;
+  }
+
+void Ragdoll::rebase(const Matrix4x4& obj, const std::vector<Matrix4x4>& local) {
+  if(isSimulated())
+    return;
+  for(size_t i=0; i<boneWorld.size() && i<local.size(); ++i)
+    boneWorld[i] = obj*local[i];
+  }
+
+void Ragdoll::setViewDistance(float cm, bool k) {
+  viewDist = cm;
+  keep     = k;
+  const int it = solverItFor(cm);
+  if(it!=solverIt)
+    setSolverIterations(it);
+  }
+
+void Ragdoll::setSolverIterations(int n) {
+  solverIt = n;
+  for(auto& j:joint)
+    j.c->setOverrideNumSolverIterations(jointIterations());
+  }
+
+int Ragdoll::jointIterations() const {
+  // на ногах позу держат мышцы, а кости выводятся точно в суставы - суставу хватает половины итераций
+  return st==S_Active ? std::max(6, solverIt/2) : solverIt;
+  }
+
+bool Ragdoll::isAirborne() const {
+  if(body.empty())
+    return false;
+  return body[0].rb->getLinearVelocity().y()<-2.f;
+  }
+
+bool Ragdoll::isResting() const {
+  if(body.empty())
+    return true;
+  return !isAirborne() && body[0].rb->getLinearVelocity().length()<0.3f && simTime>600;
+  }
+
+float Ragdoll::takeImpact() {
+  const float v = impact;
+  impact = 0;
+  return v;
+  }
+
+void Ragdoll::setVelocity(const Vec3& v) {
+  const btVector3 bv(v.x,v.y,v.z);
+  for(auto& b:body) {
+    b.rb->setLinearVelocity(bv);
+    b.rb->activate(true);
+    }
+  }
+
+void Ragdoll::hit(const Hit& h) {
+  // Удар по падающему, убитому или лежащему: импульс в точке удара (масса * сила удара) - тело получает его своим
+  // весом: от меча человек не отлетает, а валится, лёгкая рука не взлетает. Часть берёт не больше, чем ей
+  // сообщает HitPartMax, остальное уходит по цепочке к корпусу (рука прижата к телу). Отбрасывающий удар (тролль)
+  // бросает всё тело
+  if(h.power<=0.f || !wake())
+    return;
+
+  btVector3 dir = btv(h.dir);
+  if(dir.length()<1e-4f)
+    return;
+  dir.normalize();
+  const size_t best = hitPart(h.at);
+
+  if(h.kind==H_Fly) {
+    const btVector3 v = horizontal(dir)*(0.5f*h.power) + btVector3(0,0.15f*h.power,0);
+    for(auto& b:body) {
+      b.rb->setLinearVelocity(b.rb->getLinearVelocity()+v);
+      b.rb->activate(true);
+      }
+    }
+  else if(beh!=nullptr && beh->sag) {
+    // убит стоя: тело валится прочь от удара - корпус уходит по удару, ноги подгибаются на месте
+    const btVector3 hp = horizontal(dir);
+    for(size_t i=0; i<body.size(); ++i) {
+      const auto& p = lay->parts[i];
+      const float k = (p.kind==K_Thigh || p.kind==K_Calf) ? 0.03f : (i==0 ? 0.1f : 0.2f);
+      body[i].rb->setLinearVelocity(body[i].rb->getLinearVelocity() + hp*(k*h.power*(h.kind==H_Missile ? 0.5f : 1.f)));
+      }
+    }
+
+  constexpr float HitPartMax = 1.6f; // м/с: больше удар части не сообщает - остальное телу
+  // стрела толкает мало; отбрасывающий удар уже бросил всё тело - в точке удара толчок слабее
+  const float kind = (h.kind==H_Missile ? 0.4f : (h.kind==H_Fly ? 0.5f : 1.f));
+  btVector3 J  = dir*(DeadImpulse*h.power*kind);
+  btVector3 at = btv(h.at);
+  for(size_t i=best; i<body.size() && J.length()>1e-4f; i=(i==0 ? size_t(-1) : lay->parts[i].parent)) {
+    auto&       rb = *body[i].rb;
+    const auto& p  = lay->parts[i];
+    btVector3   Jp = J;
+    if(Jp.length()>HitPartMax*p.mass)
+      Jp = Jp*(HitPartMax*p.mass/Jp.length());
+    // точка удара - на теле части (оружие задевает поверхность), не дальше её размера от центра
+    btVector3   r  = at-rb.getWorldTransform().getOrigin();
+    const float rl = (p.halfLen+p.radius)*0.01f;
+    if(r.length()>rl)
+      r = r*(rl/r.length());
+    rb.applyImpulse(Jp,r);
+    rb.activate(true);
+    J  -= Jp;
+    at  = rb.getWorldTransform()*pivotOf(i); // дальше - через сустав
+    }
+
+  // рана - держаться за неё, лёжа
+  if(beh==nullptr && st==S_Fall)
+    beh = std::make_unique<Behave>();
+  if(beh!=nullptr) {
+    beh->woundPart  = int(best);
+    beh->woundLocal = body[best].rb->getWorldTransform().inverse()*btv(h.at);
+    }
+  calmTime = 0;
+  }
+
+void Ragdoll::startSag() {
+  // Убит или без сознания стоя (как в Euphoria): мышцы сдают не сразу - ноги подгибаются под весом, бёдра и
+  // корпус уходят вперёд, голова падает на грудь, рука тянется к ране (driveMuscles, tickFallPose), и тело валится
+  // туда, куда его толкнул удар и куда оно оседает. Ничего не закреплено: тело падает своим весом
+  if(!isSimulated() || !lay->humanoid || (st!=S_Dead && st!=S_Unconscious))
+    return;
+  if(isAirborne() || body[0].rb->getLinearVelocity().length()>3.f)
+    return; // летит или с разбега - сразу кукла
+  if(beh==nullptr)
+    beh = std::make_unique<Behave>();
+  auto& b = *beh;
+  b.sag     = true;
+  b.sagAt   = float(simTime)/1000.f;
+  b.sagTime = (st==S_Dead) ? 0.55f : 0.8f;
+  }
+
+void Ragdoll::updateBones() {
+  if(body.empty())
+    return;
+  // поворот кости - от её тела, начало - точно в суставе родителя: даже если физика на миг развела
+  // части (удар о землю), на коже щелей и растяжек нет. Родитель всегда раньше потомка (Layout)
+  for(size_t i=0; i<body.size(); ++i) {
+    boneWorld[i] = fromBt(body[i].rb->getWorldTransform())*lay->parts[i].boneInBody;
+    if(i==0)
+      continue;
+    Vec3 at = pivot[i];
+    boneWorld[lay->parts[i].parent].project(at);
+    boneWorld[i].set(3,0,at.x);
+    boneWorld[i].set(3,1,at.y);
+    boneWorld[i].set(3,2,at.z);
+    }
+  if(lay->follower!=size_t(-1))
+    boneWorld.back() = boneWorld[0]*followerRel;
+  ver++;
+  }
+
+void Ragdoll::preStep(float dt) {
+  if(body.empty())
+    return;
+  // шаги физики - время для «призраков» (nearCallback); люди, которых давно нет рядом, забываются
+  ++stepNo;
+  if(stepNo%64==0)
+    proxyContact.erase(std::remove_if(proxyContact.begin(), proxyContact.end(),
+                                      [this](const ProxyContact& c) { return stepNo>c.lastSeen+120; }), proxyContact.end());
+  tickLimits(dt);
+  if(st==S_Active) {
+    if(!hasTarget)
+      return;
+    // на ногах мышцы держат и вес частей (как у kickback - gravity_scale): привод сам по себе вес не держит,
+    // руки и голова провисали бы. Ослабла мышца от удара - часть тяжелеет. Упавшее тело весит как есть
+    const float g = DynamicWorld::gravityMS*dt;
+    for(size_t i=0; i<body.size(); ++i) {
+      // корпус и голову держит и оглушённый (иначе тело заваливается назад), руки от удара тяжелеют
+      const auto& p  = lay->parts[i];
+      const bool  ax = (p.kind==K_Spine || p.kind==K_Neck || p.kind==K_Head || p.kind==K_Tail);
+      const float c  = p.pinned ? 1.f : std::clamp(ax ? 0.8f + 0.4f*toneOf(i) : 0.4f + 0.8f*toneOf(i), 0.f, 1.f);
+      auto&       rb = *body[i].rb;
+      rb.setLinearVelocity(rb.getLinearVelocity()+btVector3(0,g*c,0));
+      }
+    drivePins(dt);
+    driveActive(dt);
+    pushOut(dt);
+    targetAge += dt;
+    return;
+    }
+  if(st==S_Balance && beh!=nullptr && beh->bal.on)
+    driveBalance(dt);
+  if(st==S_GetUp && beh!=nullptr && beh->getUp.on)
+    driveGetUp(dt);
+  // упавшее тело: мышцы с пределом силы и вязкость тканей (и без цели - тогда только ткани)
+  driveMuscles(dt);
+  limitVelocity();
+  pushOut(dt);
+  if(hasTarget)
+    targetAge += dt;
+  // провал силы от удара проходит за ~0,2 с
+  const float k = std::exp(-dt/0.2f);
+  for(auto& d:drive)
+    d.dip *= k;
+  }
+
+void Ragdoll::afterStep(uint64_t dt) {
+  if(body.empty())
+    return;
+  simTime += dt;
+  updateBones();
+  if(st==S_Active) {
+    // На экране физика - только пока тело откликается на удар: появляется за 120 мс, уходит за 500 мс, когда мышцы
+    // снова в силе и рефлексы прошли. Без ударов - чистая анимация игры. В бою телом - всегда физика
+    const float want = (fight || reaction()>0.05f) ? 1.f : 0.f;
+    const float step = float(dt)/(want>show ? 120.f : 500.f);
+    show = (want>show) ? std::min(want,show+step) : std::max(want,show-step);
+    return;
+    }
+  if(st==S_Balance || st==S_GetUp) {
+    // на ногах или встаёт: своё (tickBalance, tickGetUp); не застывает и не гасится
+    calmTime = 0;
+    return;
+    }
+  if(beh!=nullptr && beh->sag && float(simTime)/1000.f-beh->sagAt>beh->sagTime+0.2f) {
+    beh->sag = false;
+    for(auto& d:drive)
+      d.hasOverride = false;
+    }
+  if(st==S_Fall || (beh!=nullptr && beh->sag))
+    tickFallPose(dt); else
+  if(beh!=nullptr && beh->throes.want)
+    tickThroes(dt);
+
+  // в воде тело не падает камнем, а медленно погружается. Луч к воде - раз в 100 мс, не каждый кадр
+  if(simTime>=waterAt+100 || waterAt==0) {
+    waterAt = simTime;
+    const auto root  = rootPosition();
+    const auto wr    = owner->waterRay(root, 0.f);
+    const bool water = wr.hasCol && wr.wdepth>root.y;
+    if(water!=inWater) {
+      inWater = water;
+      damping = -1;
+      }
+    }
+  // тело в воде почти ничего не весит - медленно тонет, а не падает камнем.
+  // Сила действует весь следующий шаг физики (Bullet сбрасывает силы в конце stepSimulation)
+  if(inWater)
+    for(size_t i=0; i<body.size(); ++i)
+      body[i].rb->applyCentralForce(btVector3(0,0.85f*DynamicWorld::gravityMS*lay->parts[i].mass,0));
+
+  // скорость поверхности тел: лёгкая кисть, чуть качающаяся на месте, не мешает телу «улечься»
+  float maxV = 0;
+  bool  active = false;
+  for(size_t i=0; i<body.size(); ++i) {
+    auto&       rb = *body[i].rb;
+    const auto& p  = lay->parts[i];
+    active |= rb.isActive();
+    const float v = rb.getLinearVelocity().length() + rb.getAngularVelocity().length()*(p.halfLen+p.radius)*0.01f;
+    maxV = std::max(maxV,v);
+    }
+  // удар о землю после падения: таз резко замедлился - скорость до удара (урон от падения, Npc::tickRagdollFall)
+  {
+  const btVector3 v  = body[0].rb->getLinearVelocity();
+  const float     vy = v.y();
+  if(inWater) {
+    fallPeak = 0; // в воду - без урона, как в игре
+    }
+  else if(vy<-2.f) {
+    fallPeak = std::max(fallPeak, v.length());
+    }
+  else if(fallPeak>0.f && -vy<0.5f*fallPeak) {
+    impact   = std::max(impact, fallPeak);
+    fallPeak = 0;
+    }
+  }
+
+  // почти лёг - сильнее гасить движение, иначе капсулы долго дрожат на пределах суставов;
+  // срок в физике подходит к концу (SettleTime) - ещё сильнее, чтобы тело остановилось само, без рывка
+  // Корчится - движение не гасить (тело ведут мышцы, гасит вязкость тканей); обмякло после агонии - срок
+  // «улечься» считается с этого мига
+  const bool     throes = inThroes();
+  const uint64_t since  = (beh!=nullptr && beh->throes.done) ? simTime - std::min(simTime, uint64_t(beh->throes.doneAt*1000.f)) : simTime;
+  const uint64_t settle = (beh!=nullptr && beh->throes.done) ? 1200 : SettleTime;
+  int lvl = 0;
+  if(inWater)
+    lvl = 3;
+  else if(throes)
+    lvl = 0;
+  else if(st!=S_Fall && since>settle && !isAirborne())
+    lvl = 2;
+  else if(maxV<0.4f && since>500)
+    lvl = 1;
+  if(lvl!=damping) {
+    damping = lvl;
+    static const float lin[] = {0.05f, 0.4f,  0.8f,  0.9f};
+    static const float ang[] = {0.25f, 0.85f, 0.95f, 0.9f};
+    for(auto& b:body)
+      b.rb->setDamping(lin[lvl], ang[lvl]);
+    }
+  // редкое вздрагивание лёгкой части не отменяет «улеглось», а только отодвигает
+  if(!active || maxV<0.15f)
+    calmTime += dt; else
+    calmTime = (calmTime>2*dt ? calmTime-2*dt : 0);
+#ifdef RAGDOLL_TRACE
+  // JTRACE=1: углы анатомических суставов (X - кручение, Y - отведение, Z - сгиб), град
+  if(std::getenv("JTRACE") && simTime%100<dt) {
+    std::printf("   t=%4d",int(simTime));
+    for(auto& j:joint) {
+      if(j.type!=J_Euler && j.type!=J_Swing) continue;
+      const btVector3 e = j.type==J_Euler ? eulerOf(jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),body[j.child].rb->getWorldTransform().getRotation()))
+                                          : swingOf(jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),body[j.child].rb->getWorldTransform().getRotation()));
+      std::printf(" %s(%.0f %.0f %.0f)",kindName(lay->parts[j.child].kind),double(e.x()*57.3f),double(e.y()*57.3f),double(e.z()*57.3f));
+      }
+    std::printf("\n");
+    }
+  if(simTime%250<dt) {
+    size_t w = 0; float wv = 0;
+    for(size_t i=0; i<body.size(); ++i) {
+      auto& rb = *body[i].rb; auto& p = lay->parts[i];
+      const float v = rb.getLinearVelocity().length() + rb.getAngularVelocity().length()*(p.halfLen+p.radius)*0.01f;
+      if(v>wv) { wv=v; w=i; }
+      }
+    auto& rb = *body[w].rb;
+    std::printf("     sim=%5d maxV=%.3f %s lin=%.3f ang=%.3f active=%d calm=%d\n",int(simTime),double(maxV),kindName(lay->parts[w].kind),
+                double(rb.getLinearVelocity().length()),double(rb.getAngularVelocity().length()),int(rb.isActive()),int(calmTime));
+    }
+#endif
+  }
+
+void Ragdoll::reachWound(size_t arm, float str) {
+  reachWound(arm,str,btVector3(0,0,0));
+  }
+
+void Ragdoll::reachWound(size_t arm, float str, const btVector3& shift) {
+  // рука к ране (лёжа, оседая): IK плеча и предплечья к точке раны - направления частей, мышцы тянут к ним;
+  // shift - ладонь рядом с раной (вторая рука), м
+  if(beh==nullptr || beh->woundPart<0 || size_t(beh->woundPart)>=body.size() || str<=0.f)
+    return;
+  const size_t u = lay->upper[arm], f = lay->fore[arm];
+  if(u>=body.size() || f>=body.size())
+    return;
+  const btTransform& tu = body[u].rb->getWorldTransform();
+  const btTransform& tf = body[f].rb->getWorldTransform();
+  const btVector3    sh = tu*pivotOf(u);
+  const btVector3    el = tf*pivotOf(f);
+  const btVector3    w  = body[size_t(beh->woundPart)].rb->getWorldTransform()*beh->woundLocal + shift;
+  const float        l1 = 2.f*lay->parts[u].segHalf*0.01f, l2 = 2.f*lay->parts[f].segHalf*0.01f;
+  btVector3 toW = w-sh;
+  float     d   = toW.length();
+  if(d<1e-3f || l1<1e-3f || l2<1e-3f)
+    return;
+  const btVector3 dirW = toW/d;
+  d = std::clamp(d, std::abs(l1-l2)+0.01f, (l1+l2)*0.98f);
+  // локоть - наружу от тела, к земле и за спину (как у человека, прижимающего ладонь к ране), а не туда,
+  // где рука оказалась после падения
+  const btVector3 chest = body[lay->chest].rb->getWorldTransform().getOrigin();
+  const Vec3      cf    = chestFront();
+  const btVector3 pole  = (sh-chest).normalized()*0.8f - btVector3(cf.x,cf.y,cf.z)*0.3f + btVector3(0,-0.4f,0);
+  btVector3 bend = pole - dirW*pole.dot(dirW);
+  if(bend.length()<1e-3f)
+    bend = (el-sh) - dirW*(el-sh).dot(dirW);
+  if(bend.length()<1e-3f)
+    return;
+  bend.normalize();
+  const float     x   = (l1*l1 - l2*l2 + d*d)/(2.f*d);
+  const float     y   = std::sqrt(std::max(l1*l1-x*x, 0.f));
+  const btVector3 el1 = sh + dirW*x + bend*y;
+  const btVector3 want[2] = {(el1-sh).normalized(), (sh+dirW*d-el1).normalized()};
+  const size_t    part[2] = {u, f};
+  for(int k=0; k<2; ++k) {
+    auto&              dr = drive[part[k]];
+    const btTransform& t  = body[part[k]].rb->getWorldTransform();
+    const btVector3    ax = t.getBasis().getColumn(0).normalized();
+    btQuaternion       qd = shortestArcQuat(ax,want[k])*t.getRotation();
+    qd.normalize();
+    dr.relOverride = body[lay->parts[part[k]].parent].rb->getWorldTransform().getRotation().inverse()*qd;
+    dr.hasOverride = true;
+    dr.overrideStr = str;
+    }
+  }
+
+void Ragdoll::tickFallPose(uint64_t dt) {
+  // Живой падает (как Euphoria и Overgrowth): земля близко по ходу падения - руки выставлены к ней, чуть согнуты;
+  // долго летит без опоры - машет руками и перебирает ногами; лёжа - держится за рану, поджимает ноги и
+  // медленно шевелится, пока не встанет. Оседая стоя - рука к ране. Цели - направления частей в мире
+  if(!lay->humanoid || drive.size()!=body.size())
+    return;
+  for(auto& d:drive) {
+    d.hasOverride = false;
+    d.overrideW   = 0;
+    d.hold        = 0;
+    }
+  if(st!=S_Fall) {
+    // оседает: рука к ране, всё слабее
+    if(beh!=nullptr && beh->sag && lay->stance && beh->woundPart>=0) {
+      const float t = std::clamp((float(simTime)/1000.f-beh->sagAt)/beh->sagTime, 0.f, 1.f);
+      const btVector3 w   = body[size_t(beh->woundPart)].rb->getWorldTransform()*beh->woundLocal;
+      const btVector3 chL = body[lay->upper[0]].rb->getWorldTransform().getOrigin();
+      const btVector3 chR = body[lay->upper[1]].rb->getWorldTransform().getOrigin();
+      size_t arm = ((w-chL).length()<(w-chR).length()) ? 0 : 1;
+      const size_t wp = size_t(beh->woundPart);
+      if(wp==lay->upper[arm] || wp==lay->fore[arm] || lay->parts[wp].parent==lay->fore[arm])
+        arm = 1-arm;
+      reachWound(arm, 0.5f*(1.f-t));
+      }
+    return;
+    }
+  if(isAirborne())
+    airTime += dt; else
+    airTime = 0;
+  // лежит: таз у земли (луч вниз) и не летит - группировка отпущена, тело обмякает, хоть и скользит ещё
+  {
+  const btVector3 pv = body[0].rb->getWorldTransform().getOrigin();
+  const Vec3      at = cmv(pv);
+  const auto      gr = owner->ray(at, at-Vec3(0,80,0));
+  const bool      low = gr.hasCol && at.y-gr.v.y < lay->parts[0].radius+18.f;
+  if(low && !isAirborne() && body[0].rb->getLinearVelocity().length()<3.f)
+    groundTime += dt; else
+    groundTime = 0;
+  }
+
+  const btTransform& pel = body[0].rb->getWorldTransform();
+  const btTransform& che = body[lay->chest].rb->getWorldTransform();
+  btVector3 up = che.getOrigin()-pel.getOrigin();
+  if(up.length()<1e-3f)
+    return;
+  up.normalize();
+  const Vec3 cf = chestFront();
+  btVector3 front(cf.x,cf.y,cf.z);
+  front = (front - up*front.dot(up));
+  if(front.length()<1e-3f)
+    return;
+  front.normalize();
+  const btVector3 right = up.cross(front);
+
+  // лежит: держится за рану, поджимает ноги, медленно шевелится
+  if(groundTime>500) {
+    const float t = float(groundTime-500)*0.001f;
+    const float e = smooth(t/0.8f);
+    if(lay->stance && beh!=nullptr && beh->woundPart>=0) {
+      const btVector3 w   = body[size_t(beh->woundPart)].rb->getWorldTransform()*beh->woundLocal;
+      const btVector3 chL = body[lay->upper[0]].rb->getWorldTransform().getOrigin();
+      const btVector3 chR = body[lay->upper[1]].rb->getWorldTransform().getOrigin();
+      size_t arm = ((w-chL).length()<(w-chR).length()) ? 0 : 1;
+      const size_t wp = size_t(beh->woundPart);
+      if(wp==lay->upper[arm] || wp==lay->fore[arm] || lay->parts[wp].parent==lay->fore[arm])
+        arm = 1-arm;
+      reachWound(arm, 0.35f*e);
+      }
+    for(size_t i=1; i<body.size(); ++i) {
+      auto&       d = drive[i];
+      const auto& p = lay->parts[i];
+      if(p.kind!=K_Thigh && p.kind!=K_Calf)
+        continue;
+      // колени к груди, по очереди и медленно
+      const float wave = 0.5f + 0.5f*std::sin(t*1.7f + (p.side<0 ? 1.6f : 0.f));
+      btVector3 want = (p.kind==K_Thigh) ? (-up*0.75f + front*(0.15f+0.3f*wave)) : (-up*0.9f - front*0.25f);
+      want.normalize();
+      const btTransform& tt = body[i].rb->getWorldTransform();
+      const btVector3    ax = tt.getBasis().getColumn(0).normalized();
+      btQuaternion       qd = shortestArcQuat(ax,want)*tt.getRotation();
+      qd.normalize();
+      d.relOverride = body[p.parent].rb->getWorldTransform().getRotation().inverse()*qd;
+      d.hasOverride = true;
+      d.overrideStr = 0.18f*e;
+      }
+    return;
+    }
+
+  // куда падаем и далеко ли земля: луч от груди по скорости (или вниз), не дальше 4 м - руки к земле человек
+  // выставляет, едва потеряв опору, а не у самой земли
+  btVector3 v   = body[0].rb->getLinearVelocity();
+  btVector3 dir = (v.length()>2.f) ? v.normalized() : btVector3(0,-1,0);
+  if(dir.y()>-0.2f)
+    dir = (dir + btVector3(0,-0.6f,0)).normalized();
+  const btVector3 from = che.getOrigin();
+  const auto      ray  = owner->ray(Vec3(from.x(),from.y(),from.z())*100.f, Vec3(from.x()+dir.x()*4.f,from.y()+dir.y()*4.f,from.z()+dir.z()*4.f)*100.f);
+  float     protect = 0;
+  btVector3 land    = from + dir*2.f;
+  if(ray.hasCol) {
+    const float d = (ray.v - Vec3(from.x(),from.y(),from.z())*100.f).length()*0.01f;
+    protect = std::clamp((3.6f-d)/1.6f, 0.f, 1.f);
+    land    = btv(ray.v);
+    }
+
+  const float phase = float(airTime)*0.006f;
+  // в коротком полёте группируется, в долгом (обрыв) - машет руками
+  const float flail = (protect<0.5f && airTime>550) ? 1.f : 0.f;
+  for(size_t i=1; i<body.size(); ++i) {
+    auto&       d = drive[i];
+    const auto& p = lay->parts[i];
+    const bool arm = (p.kind==K_UpperArm || p.kind==K_ForeArm);
+    const bool leg = (p.kind==K_Thigh);
+    if(!arm && !leg)
+      continue;
+    btVector3 want;
+    float     str = 0;
+    if(arm && protect>0.f) {
+      // руки - к месту на земле, куда падает тело (в мире, а не относительно корпуса: падая навзничь, руки идут
+      // назад и вниз, а не за голову), чуть в стороны; предплечья чуть согнуты
+      const btVector3 sh = body[p.kind==K_UpperArm ? i : p.parent].rb->getWorldTransform()*
+                           pivotOf(p.kind==K_UpperArm ? i : p.parent);
+      btVector3 to = land-sh;
+      if(to.length()<1e-3f)
+        to = dir;
+      want = (to.normalized() + right*(0.3f*p.side)).normalized();
+      if(p.kind==K_ForeArm)
+        want = (want + front*0.2f).normalized();
+      str  = 0.9f*protect;
+      }
+    else if(flail>0.f) {
+      const float ph = phase + (p.side<0 ? float(M_PI) : 0.f);
+      if(arm)
+        want = (up*std::cos(ph) + front*std::sin(ph) + right*(0.4f*p.side)).normalized(); else
+        want = (-up*std::cos(ph*0.8f)*0.8f + front*(0.6f*std::sin(ph*0.8f)) - up*0.4f).normalized();
+      str  = 0.8f;
+      }
+    if(str<=0.f)
+      continue;
+    // вращение, которое переводит ось части (X капсулы) в нужное направление, - относительно родителя
+    const btTransform& t   = body[i].rb->getWorldTransform();
+    const btVector3    ax  = t.getBasis().getColumn(0).normalized();
+    btQuaternion       qd  = shortestArcQuat(ax,want)*t.getRotation();
+    qd.normalize();
+    d.relOverride = body[p.parent].rb->getWorldTransform().getRotation().inverse()*qd;
+    d.hasOverride = true;
+    d.overrideStr = str;
+    }
+  }
+
+void Ragdoll::startThroes(float life, bool rise, uint32_t seed) {
+  if(!lay->humanoid || !lay->stance || (st!=S_Dead && st!=S_Unconscious) || lay->head==size_t(-1))
+    return;
+  // цели агонии - углы анатомических суставов: корпус, голова, бёдра, колени
+  for(auto i:lay->spineChain)
+    if(lay->parts[i].joint!=J_Euler)
+      return;
+  if(lay->parts[lay->head].joint!=J_Euler)
+    return;
+  for(int s=0; s<2; ++s)
+    if(lay->parts[lay->thigh[s]].joint!=J_Euler || lay->parts[lay->calf[s]].joint!=J_Euler)
+      return;
+  if(beh==nullptr)
+    beh = std::make_unique<Behave>();
+  auto& th = beh->throes;
+  th         = Behave::Throes();
+  th.want    = true;
+  th.dead    = (st==S_Dead);
+  th.life    = std::clamp(life,0.f,1.f);
+  th.canRise = rise;
+  th.seed    = seed | 1u;
+  groundTime = 0;
+  }
+
+void Ragdoll::stopThroes() {
+  if(beh==nullptr || !beh->throes.want || beh->throes.done)
+    return;
+  auto& th = beh->throes;
+  if(!th.on) {
+    th.want = false;
+    return;
+    }
+  // обрывается (добили): мышцы сдают за 0,4 с
+  const float t = float(simTime)/1000.f - th.at;
+  if(t<th.end) {
+    th.end   = t;
+    th.relax = 0.4f;
+    }
+  }
+
+bool Ragdoll::inThroes() const {
+  return isSimulated() && beh!=nullptr && beh->throes.want && !beh->throes.done;
+  }
+
+bool Ragdoll::isRaised() const {
+  return inThroes() && beh->throes.raised;
+  }
+
+void Ragdoll::jointGoal(size_t i, float twist, float abd, float flex, float str, float w, float hold) {
+  // цель мышцы - углы анатомического сустава (град): Z - сгиб, Y - отведение (вбок), X - кручение
+  if(i>=drive.size() || str<=0.001f)
+    return;
+  const auto& p = lay->parts[i];
+  if(p.joint!=J_Euler)
+    return;
+  const float x = std::clamp(deg(twist), p.lo[0], p.hi[0]);
+  const float y = std::clamp(deg(abd),   p.lo[1], p.hi[1]);
+  const float z = std::clamp(deg(flex),  p.lo[2], p.hi[2]);
+  const btQuaternion e = btQuaternion(btVector3(0,0,1),z)*btQuaternion(btVector3(0,1,0),y)*btQuaternion(btVector3(1,0,0),x);
+  auto& d = drive[i];
+  d.relOverride = toBt(p.jointInParent).getRotation()*e*toBt(p.jointInChild).getRotation().inverse();
+  d.relOverride.normalize();
+  d.hasOverride = true;
+  d.overrideStr = str;
+  d.overrideW   = w;
+  d.hold        = hold;
+  }
+
+void Ragdoll::aimPart(size_t i, const btVector3& want, float str, float w, float hold) {
+  // цель мышцы - направление части (оси капсулы, от сустава к концу) в мире
+  if(i>=body.size() || i==0 || str<=0.001f || want.length()<1e-4f)
+    return;
+  const btTransform& t  = body[i].rb->getWorldTransform();
+  const btVector3    ax = t.getBasis().getColumn(0).normalized();
+  btQuaternion       qd = shortestArcQuat(ax,want.normalized())*t.getRotation();
+  qd.normalize();
+  auto& d = drive[i];
+  d.relOverride = body[lay->parts[i].parent].rb->getWorldTransform().getRotation().inverse()*qd;
+  d.hasOverride = true;
+  d.overrideStr = str;
+  d.overrideW   = w;
+  d.hold        = hold;
+  }
+
+void Ragdoll::planThroes() {
+  // Тело легло: какой будет агония. Сколько сил (life) - столько и корчится; пытается встать тот, у кого силы есть
+  // (рана на руке или ноге - чаще, в голову - реже); оглушённый - то встать пробует, то лежит и стонет
+  auto&    b  = *beh;
+  auto&    th = b.throes;
+  uint32_t s  = th.seed;
+  auto rnd = [&s]() {
+    s = s*1664525u + 1013904223u;
+    return float((s>>8) & 0xFFFFu)/65535.f;
+    };
+  th.on   = true;
+  th.at   = float(simTime)/1000.f;
+  th.back = chestFront().y>0.f;
+  // ноги скользят: корчась, человек сучит ногами по земле (на животе - колено в сторону), а не упирается намертво
+  for(int k=0; k<2; ++k) {
+    body[lay->thigh[k]].rb->setFriction(0.4f);
+    body[lay->calf [k]].rb->setFriction(0.3f);
+    }
+
+  const btTransform& pel = body[0].rb->getWorldTransform();
+  const btTransform& che = body[lay->chest].rb->getWorldTransform();
+  btVector3 up = che.getOrigin()-pel.getOrigin();
+  up = up.length()>1e-3f ? up.normalized() : btVector3(0,1,0);
+  const Vec3 cf = chestFront();
+  btVector3  front(cf.x,cf.y,cf.z);
+
+  // рана: удара не было (разбился, сгорел) - держится за живот
+  if(b.woundPart<0 || size_t(b.woundPart)>=body.size()) {
+    const size_t       sp = lay->spineChain.empty() ? 0 : lay->spineChain.front();
+    const btTransform& t  = body[sp].rb->getWorldTransform();
+    b.woundPart  = int(sp);
+    b.woundLocal = t.inverse()*(t.getOrigin() + front*(lay->parts[sp].radius*0.01f));
+    }
+  const size_t    wp = size_t(b.woundPart);
+  const btVector3 w  = body[wp].rb->getWorldTransform()*b.woundLocal;
+  const uint8_t   wk = lay->parts[wp].kind;
+  const bool      head = (wk==K_Head || wk==K_Neck);
+  int woundArm = -1, woundLeg = -1;
+  for(int k=0; k<2; ++k) {
+    if(wp==lay->upper[k] || wp==lay->fore[k] || lay->parts[wp].parent==lay->fore[k])
+      woundArm = k;
+    if(wp==lay->thigh[k] || wp==lay->calf[k])
+      woundLeg = k;
+    }
+  // рана слева или справа (0 - левая сторона тела, лево - up x front, как у суставов)
+  const btVector3 left  = up.cross(front - up*front.dot(up));
+  const int       wSide = (w-pel.getOrigin()).dot(left)>=0.f ? 0 : 1;
+
+  th.rate = 0.22f + 0.2f*rnd();
+  for(auto& p:th.ph)
+    p = 6.2832f*rnd();
+
+  // руки к ране: рана на руке - другой рукой; иначе обеими (вторая ладонь рядом) или одной - ближней
+  if(woundArm>=0) {
+    th.clutch = uint8_t(1u<<(1-woundArm));
+    } else if(rnd()<0.6f) {
+    th.clutch = 3;
+    } else {
+    const btVector3 sh0 = body[lay->upper[0]].rb->getWorldTransform().getOrigin();
+    const btVector3 sh1 = body[lay->upper[1]].rb->getWorldTransform().getOrigin();
+    th.clutch = uint8_t((w-sh0).length()<(w-sh1).length() ? 1 : 2);
+    }
+
+  const float L = th.life;
+  float pRise = 0;
+  if(th.canRise)
+    pRise = th.dead ? std::clamp(0.2f + 0.55f*L + ((woundArm>=0 || woundLeg>=0) ? 0.15f : 0.f) - (head ? 0.25f : 0.f), 0.f, 0.85f)
+                    : 0.5f;
+  if(th.dead && (L<0.12f || (head && L<0.4f)))
+    th.plan = Behave::Throes::P_Twitch; else
+  if(rnd()<pRise)
+    th.plan = Behave::Throes::P_Rise; else
+    th.plan = Behave::Throes::P_Clutch;
+
+  // на спине опирается на локоть с другой стороны от раны (рукой со стороны раны держится за неё); на животе
+  // подтягивает под себя здоровую ногу, первой подламывается рука со стороны раны
+  th.prop    = int8_t(woundArm>=0 ? 1-woundArm : 1-wSide);
+  th.knee    = int8_t(woundLeg>=0 ? 1-woundLeg : (rnd()<0.5f ? 0 : 1));
+  th.giveArm = int8_t(woundArm>=0 ? woundArm : wSide);
+  th.both    = woundArm>=0 || rnd()<0.5f;
+
+  // приходит в себя после удара о землю; оглушённый сначала лежит без памяти
+  float t = th.dead ? 0.25f + 0.45f*rnd() : 1.f + 1.5f*rnd();
+  if(th.plan==Behave::Throes::P_Rise) {
+    th.nRise = (rnd() < (th.dead ? 0.2f+0.4f*L : 0.45f)) ? 2 : 1;
+    for(int k=0; k<th.nRise; ++k) {
+      th.riseAt  [k] = t + 0.45f; // руки ставит 0,45 с
+      th.riseUp  [k] = (0.95f + 0.55f*rnd())*(k==0 ? 1.f : 1.3f);
+      th.riseHold[k] = (0.45f + 0.75f*rnd())*(k==0 ? 1.f : 0.6f);
+      th.riseH   [k] = (k==0) ? (0.65f + 0.35f*rnd())*(th.dead ? 0.75f+0.25f*L : 1.f)
+                              : th.riseH[0]*(0.45f + 0.25f*rnd());
+      // упал, полежал, собрался с силами
+      t = th.riseAt[k] + th.riseUp[k] + th.riseHold[k] + 0.9f + 0.7f + 0.9f*rnd();
+      }
+    }
+  if(th.plan==Behave::Throes::P_Twitch) {
+    th.end   = 0.45f + 0.4f*rnd();
+    th.relax = 0.5f;
+    } else if(th.dead) {
+    th.end   = t + 1.f + (1.5f + 4.5f*rnd())*(0.4f + 0.6f*L);
+    th.relax = 1.2f + 0.8f*rnd();
+    } else {
+    th.end   = t + 1.f + 2.f*rnd();
+    th.relax = 1.5f;
+    }
+  // в физике - не дольше ThroesMaxTime вместе с тем, как обмякнет и уляжется
+  th.end = std::min(th.end, float(ThroesMaxTime)/1000.f - th.at - th.relax - 2.5f);
+  static const char* plan[] = {"twitch","clutch","rise"};
+  Log::i("[g2m] ragdoll: throes ",plan[th.plan]," ",th.dead ? "dead" : "unconscious"," life ",int(L*100.f),"% ",
+         th.back ? "back" : "belly"," end ",int(th.end*1000.f),"ms rises ",th.nRise);
+  }
+
+void Ragdoll::tickThroes(uint64_t dt) {
+  // Агония (как «корчи» в Euphoria и Overgrowth): цели мышц - углы суставов и направления рук, мышцы - с пределом
+  // силы, поэтому тело движется своим весом: поднимается с трудом, руки подламываются, ноги падают набок
+  auto& b  = *beh;
+  auto& th = b.throes;
+  for(auto& d:drive) {
+    d.hasOverride = false;
+    d.overrideW   = 0;
+    d.hold        = 0;
+    }
+  th.raised = false;
+  if(th.done || drive.size()!=body.size())
+    return;
+  if(!th.on) {
+    // легло: таз у земли (луч вниз) и почти не движется
+    const Vec3 at  = cmv(body[0].rb->getWorldTransform().getOrigin());
+    const auto gr  = owner->ray(at, at-Vec3(0,80,0));
+    const bool low = gr.hasCol && at.y-gr.v.y < lay->parts[0].radius+18.f;
+    if(low && !isAirborne() && body[0].rb->getLinearVelocity().length()<1.2f)
+      groundTime += dt; else
+      groundTime = 0;
+    if(groundTime>=250 && simTime>=600)
+      planThroes(); else
+    if(simTime>4000)
+      th.want = false; // не легло (застряло, повисло) - без агонии
+    if(!th.on)
+      return;
+    }
+  const float t = float(simTime)/1000.f - th.at;
+  if(t>th.end+th.relax) {
+    th.done   = true;
+    th.doneAt = float(simTime)/1000.f;
+    calmTime  = 0;
+    for(int k=0; k<2; ++k) {
+      body[lay->thigh[k]].rb->setFriction(0.8f);
+      body[lay->calf [k]].rb->setFriction(0.8f);
+      }
+    return;
+    }
+
+  // система тела: к голове, грудью вперёд, влево
+  const btTransform& pel = body[0].rb->getWorldTransform();
+  const btTransform& che = body[lay->chest].rb->getWorldTransform();
+  btVector3 up = che.getOrigin()-pel.getOrigin();
+  if(up.length()<1e-3f)
+    return;
+  up.normalize();
+  const Vec3 cf = chestFront();
+  btVector3  front(cf.x,cf.y,cf.z);
+  front = front - up*front.dot(up);
+  if(front.length()<1e-3f)
+    return;
+  front.normalize();
+  const btVector3 Y(0,1,0);
+  btVector3 headH = horizontal(up); // к голове вдоль земли
+  if(headH.length()<1e-3f)
+    headH = horizontal(th.back ? -front : front);
+
+  const float g    = 1.f - smooth((t-th.end)/th.relax);              // обмякает
+  const float weak = th.dead ? 1.f - 0.4f*std::clamp(t/std::max(th.end,0.5f), 0.f, 1.f) : 1.f; // умирающий слабеет
+  const float w2   = 6.2832f*th.rate*t;
+
+  if(th.plan==Behave::Throes::P_Twitch) {
+    // смерть сразу: тело вздрогнет - колено к животу, голова в сторону - и обмякнет
+    const float e = LimbIk::envelope(t, 0.12f, 0.08f, 0.35f)*g;
+    const int   k = th.knee;
+    jointGoal(lay->thigh[k], 0, 0, 35, 0.35f*e, 10);
+    jointGoal(lay->calf [k], 0, 0, 55, 0.35f*e, 10);
+    jointGoal(lay->head, 30.f*std::sin(th.ph[3]), 0, 15, 0.3f*e, 10);
+    return;
+    }
+
+  // попытка встать: руки ставит (prep), поднимается (rise), держится из последних сил, сдаётся - опора (sup) и
+  // тело (give) обмякают, тело падает своим весом; потом лежит, корчится и пробует снова
+  float rise = 0, prep = 0, sup = 1, supGive = 1, give = 1, since = 1e3f;
+  for(int k=0; k<th.nRise; ++k) {
+    const float s0 = th.riseAt[k]-0.45f, s = th.riseAt[k];
+    const float u  = th.riseUp[k], f = s+u+th.riseHold[k];
+    if(t<s0)
+      continue;
+    if(t>f+0.9f) {
+      since = std::min(since, t-(f+0.9f));
+      continue;
+      }
+    since = 0;
+    prep  = smooth((t-s0)/0.45f);
+    float r = th.riseH[k]*smooth((t-s)/u);
+    // держится из последних сил: оседает и снова тянется
+    if(t>s+u)
+      r *= 1.f - 0.08f*(0.5f-0.5f*std::cos(6.2832f*(t-s-u)/0.8f));
+    rise = r;
+    if(t>f-0.12f)
+      supGive = 1.f-smooth((t-(f-0.12f))/0.15f); // первая подламывается одна рука - тело валится набок
+    if(t>f) {
+      sup  = 1.f-smooth((t-f)/0.15f);
+      give = 1.f-smooth((t-f)/0.45f);
+      }
+    th.raised = (t<f+0.5f) && r>0.12f;
+    }
+  const float wR = prep;                                          // занято подъёмом
+  const float wC = (1.f-wR)*smooth(t/0.7f)*smooth(since/0.8f);    // корчится
+  if(wR+wC<=0.001f || g<=0.f)
+    return;
+
+  // рана и её сторона
+  const size_t    wp     = size_t(std::max(b.woundPart,0));
+  const btVector3 wound  = body[wp].rb->getWorldTransform()*b.woundLocal;
+  const btVector3 left   = up.cross(front);
+  const float     wLeft  = (wound-pel.getOrigin()).dot(left)>=0.f ? 1.f : -1.f;
+  int             woundLeg = -1;
+  for(int k=0; k<2; ++k)
+    if(wp==lay->thigh[k] || wp==lay->calf[k])
+      woundLeg = k;
+
+  // земля под грудью (м): руки ставятся на неё, упор держит грудь
+  const btVector3 chest = che.getOrigin();
+  float groundY = chest.y() - lay->parts[lay->chest].radius*0.01f;
+  {
+  const Vec3 at = cmv(chest);
+  const auto gr = owner->ray(at+Vec3(0,60,0), at-Vec3(0,150,0));
+  if(gr.hasCol)
+    groundY = gr.v.y*0.01f;
+  }
+  const float size = lay->size/180.f;
+  auto onGround = [&](const btVector3& p, float liftCm) {
+    return btVector3(p.x(), groundY+liftCm*0.01f*size, p.z());
+    };
+
+  // ноги: на спине корчась - колени к животу и обратно, по очереди и не в такт (больная - выше), поднимаясь -
+  // колени вверх, ступни упираются в землю; на животе корчась - колено в сторону, к груди (как ползком),
+  // поднимаясь - одно колено под себя
+  for(int s=0; s<2; ++s) {
+    const float wave = 0.5f + 0.5f*std::sin(w2 + th.ph[0] + (s==0 ? 0.f : 2.4f));
+    const bool  hurt = (woundLeg==s);
+    const float outS = (s==0 ? 1.f : -1.f); // отведение наружу: у левой ноги +, у правой -
+    // подтянутое колено - чуть наружу: ноги не ложатся одна на другую (придавленная нога не поднимется)
+    // пятка - у ягодицы: колено сгибается сильнее бедра, стопа скользит по земле, а не висит в воздухе
+    float cHf = 20.f + 55.f*wave + (hurt ? 15.f : 0.f), cKf = 55.f + 65.f*wave + (hurt ? 15.f : 0.f);
+    float cAb = outS*(4.f + 10.f*wave);
+    if(!th.back) {
+      cHf = 10.f + 40.f*wave;
+      cKf = 15.f + 45.f*wave;
+      cAb = outS*15.f*wave;
+      }
+    float rHf = 5, rKf = 15, rAb = 0;
+    if(th.back) {
+      rHf = 55; rKf = 95;
+      } else if(s==th.knee) {
+      rHf = 15.f + 60.f*rise; rKf = 35.f + 75.f*rise; rAb = outS*25.f*rise;
+      }
+    const float w    = wC+wR;
+    const float hf   = (cHf*wC + rHf*wR)/w, ab = (cAb*wC + rAb*wR)/w;
+    // колено - следом за бедром: согнутое раньше бедра давит голенью в землю, стопа держится трением, и нога
+    // заклинивает (не поднимется, а упёршаяся - не даст и другой)
+    float kf = (cKf*wC + rKf*wR)/w;
+    for(auto& j:joint)
+      if(j.child==lay->thigh[s]) {
+        const float cur = float(eulerOf(jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),
+                                                  body[j.child].rb->getWorldTransform().getRotation())).z())*57.3f;
+        kf = std::min(kf, 25.f + 1.6f*std::max(cur,0.f));
+        }
+    float       str  = (0.45f*wC*weak + 0.5f*wR*give)*g;
+    float hold = 0.6f*(wC + wR);
+    jointGoal(lay->thigh[s], 0, ab, hf, str, 10, hold);
+    jointGoal(lay->calf [s], 0, 0,  kf, str, 10, 0.4f*hold);
+#ifdef RAGDOLL_TRACE
+    if(std::getenv("TLEG") && simTime%100<dt)
+      for(auto& j:joint)
+        if(j.child==lay->thigh[s] || j.child==lay->calf[s]) {
+          const btVector3 e = eulerOf(jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),body[j.child].rb->getWorldTransform().getRotation()));
+          auto& gc = static_cast<btGeneric6DofSpring2Constraint&>(*j.c);
+          gc.calculateTransforms();
+          std::printf("     leg%d %s flex %.0f (want %.0f) ab %.0f (want %.0f) tw %.0f str %.2f bullet(%.0f %.0f %.0f) lim x[%.0f %.0f] y[%.0f %.0f] z[%.0f %.0f]\n",s,kindName(lay->parts[j.child].kind),
+                      double(e.z()*57.3f),double(j.child==lay->thigh[s] ? hf : kf),double(e.y()*57.3f),double(j.child==lay->thigh[s] ? ab : 0.f),double(e.x()*57.3f),double(str),
+                      double(gc.getAngle(0)*57.3f),double(gc.getAngle(1)*57.3f),double(gc.getAngle(2)*57.3f),
+                      double(-j.shown[0][1]*57.3f),double(-j.shown[0][0]*57.3f),double(-j.shown[1][1]*57.3f),double(-j.shown[1][0]*57.3f),double(-j.shown[2][1]*57.3f),double(-j.shown[2][0]*57.3f));
+          }
+#endif
+    }
+
+  // корпус: на спине корчась - сгибается к ране и перекатывается, поднимаясь на локтях - чуть сгибается; на
+  // животе корчась - вбок к поджатому колену, поднимаясь - прогибается, грудь вверх. Нижний позвонок на спине вес
+  // не держит: его отдача подбросила бы таз с ногами (без упора рук с пресса не сесть)
+  {
+  const float n   = float(std::max<size_t>(lay->spineChain.size(),1));
+  // сжимается волнами: то скрючится к ране, то обмякнет
+  float cFl = 8.f + 30.f*smooth(0.5f+0.5f*std::sin(0.7f*w2 + th.ph[1]));
+  float cSd = -15.f*wLeft;                       // + - вбок вправо
+  float cTw = 18.f*std::sin(0.55f*w2 + th.ph[2]);
+  if(!th.back) {
+    cFl = -8.f;
+    cSd = 10.f*std::sin(w2 + th.ph[0]);
+    cTw = 6.f*std::sin(0.55f*w2 + th.ph[2]);
+    }
+  float rFl = -25.f*rise, rTw = 0;
+  if(th.back) {
+    rFl = 35.f*rise;
+    rTw = th.both ? 0.f : (th.prop==0 ? -20.f : 20.f)*rise;
+    }
+  const float w   = wC+wR;
+  float str = (0.35f*wC*weak + 0.9f*wR*give)*g;
+  for(size_t k=0; k<lay->spineChain.size(); ++k) {
+    const float hold = (th.back && k==0) ? 0.f : 0.35f*wC + wR;
+    jointGoal(lay->spineChain[k], (cTw*wC + rTw*wR)/w/n, cSd*wC/w/n, (cFl*wC + rFl*wR)/w/n, str, 12, hold);
+    }
+  }
+
+  // голова: на спине корчась - к груди и из стороны в сторону, на животе - приподнята и вертится; поднимаясь - на
+  // спине к груди (смотрит на рану), на животе - вверх
+  {
+  float cFl = 5.f + 30.f*smooth(0.5f+0.5f*std::sin(0.7f*w2 + th.ph[1]));
+  float cTw = 30.f*std::sin(0.4f*w2 + th.ph[3]);
+  if(!th.back) {
+    cFl = -15.f - 10.f*(0.5f+0.5f*std::sin(0.7f*w2 + th.ph[1]));
+    cTw = 40.f*std::sin(0.4f*w2 + th.ph[3]);
+    }
+  const float rFl = th.back ? 10.f + 35.f*rise : -40.f*rise;
+  const float w   = wC+wR;
+  const float str = (0.3f*wC*weak + 0.7f*wR*give)*g;
+  const float tw  = cTw*wC/w, fl = (cFl*wC + rFl*wR)/w;
+  if(lay->neck!=size_t(-1) && lay->parts[lay->neck].joint==J_Euler) {
+    jointGoal(lay->neck, tw*0.5f, 0, fl*0.5f, str, 10, 1);
+    jointGoal(lay->head, tw*0.5f, 0, fl*0.5f, str, 10, 1);
+    } else {
+    jointGoal(lay->head, tw, 0, fl, str, 10, 1);
+    }
+  }
+
+  // руки. Опора при подъёме: на спине - локти под плечами, предплечья по земле к ногам (одной рукой или обеими),
+  // на животе - ладони под плечами, локти назад; на земле опора держит грудь (упор). Корчась: на спине - к ране, на
+  // животе - скребут землю, подтягиваясь вперёд
+  float contact = 0;
+  for(int s=0; s<2; ++s) {
+    const size_t    u  = lay->upper[s], f = lay->fore[s];
+    const btVector3 sh = body[u].rb->getWorldTransform()*pivotOf(u);
+    btVector3 out = sh - chest;
+    out = out - up*out.dot(up);
+    out = out.length()>1e-3f ? out.normalized() : left*(s==0 ? 1.f : -1.f);
+    const float l1 = 2.f*lay->parts[u].segHalf*0.01f, l2 = 2.f*lay->parts[f].segHalf*0.01f;
+    const bool  support = wR>0.f && (!th.back || th.both || th.prop==s);
+    if(support) {
+      const float k   = (!th.back && s==th.giveArm) ? supGive : sup;
+      const float str = 0.95f*prep*k*g;
+      btVector3 du, df;
+      if(th.back) {
+        // садится, опираясь ладонью о землю у бедра (локоть назад): плечо разгибается не дальше, чем у человека
+        const btVector3 hip  = pel.getOrigin() + out*0.24f*size + headH*0.04f*size;
+        const btVector3 hand = onGround(hip, 2);
+        armDirs(sh, hand, l1, l2, -front*0.6f + out*0.4f, du, df);
+        } else {
+        const btVector3 hand = onGround(sh + headH*0.06f + out*0.1f, 2);
+        armDirs(sh, hand, l1, l2, -headH*0.6f + out*0.5f + Y*0.4f, du, df);
+        }
+      aimPart(u, du, str, 14);
+      aimPart(f, df, str, 14);
+      // опирается: кисть у земли
+      const btVector3 tip = body[f].rb->getWorldTransform()*pivotOf(f) +
+                            body[f].rb->getWorldTransform().getBasis().getColumn(0).normalized()*l2;
+      if(tip.y()-groundY < 0.12f*size)
+        contact = std::max(contact, k);
+      continue;
+      }
+    // за рану: на спине корчась - руками из th.clutch, поднимаясь на одном локте - другой рукой; на животе -
+    // только до раны на руке, ноге, голове (рана на груди - под телом)
+    float str = 0;
+    const bool reach = th.back || b.woundPart==int(lay->head) || woundLeg>=0 ||
+                       (b.woundPart>=0 && (size_t(b.woundPart)==lay->upper[1-s] || size_t(b.woundPart)==lay->fore[1-s]));
+    if(reach && (th.clutch & (1u<<s)))
+      str = 0.45f*wC*weak;
+    if(wR>0.f && th.back)
+      str = std::max(str, 0.4f*wR*give);
+    str *= g;
+    if(str>0.001f) {
+      // вторая ладонь ложится рядом с первой (ближе к голове и к своей стороне)
+      btVector3 shift(0,0,0);
+      if(th.clutch==3 && s!=(wLeft>0.f ? 0 : 1))
+        shift = up*0.07f + out*0.03f;
+      reachWound(size_t(s), str, shift);
+      drive[u].overrideW = 9;
+      drive[f].overrideW = 9;
+      continue;
+      }
+    if(!th.back && wC>0.f) {
+      // скребёт землю: ладонь тянется вперёд и подтягивает, руки по очереди
+      const float     cl   = 0.5f + 0.5f*std::sin(0.8f*w2 + th.ph[2] + (s==0 ? 0.f : 3.1f));
+      const btVector3 hand = onGround(sh + headH*(0.12f + 0.25f*cl) + out*0.18f, 3);
+      btVector3 du, df;
+      armDirs(sh, hand, l1, l2, out*0.6f + Y*0.5f - headH*0.2f, du, df);
+      const float str2 = 0.5f*wC*weak*g;
+      aimPart(u, du, str2, 9);
+      aimPart(f, df, str2, 9);
+      }
+    }
+
+  // упор: рука на земле передаёт груди силу земли (мышцы куклы с пределом силы такой упор сами не держат) -
+  // грудь поднимается до высоты подъёма; рука подломилась или не достала до земли - упора нет, тело падает
+  if(wR>0.f && rise>0.f && contact>0.f) {
+    float M = 0;
+    for(size_t k=1; k<body.size(); ++k) {
+      const uint8_t kd = lay->parts[k].kind;
+      if(kd==K_Spine || kd==K_Neck || kd==K_Head || kd==K_UpperArm || kd==K_ForeArm || kd==K_Hand)
+        M += lay->parts[k].mass;
+      }
+    const float h    = chest.y() - groundY;
+    const float hT   = lay->parts[lay->chest].radius*0.01f + rise*(th.back ? (th.both ? 0.24f : 0.2f) : 0.36f)*size;
+    const float vy   = float(body[lay->chest].rb->getLinearVelocity().y());
+    const float g0   = DynamicWorld::gravityMS;
+    const float acc  = 0.55f*g0 + 30.f*(hT-h) - 7.f*vy;
+    const float F    = std::clamp(M*acc, 0.f, 1.2f*M*g0)*contact*prep*g;
+    body[lay->chest].rb->applyCentralForce(btVector3(0,F,0));
+    body[lay->chest].rb->activate(true);
+#ifdef RAGDOLL_TRACE
+    if(std::getenv("TTRACE") && simTime%100<dt)
+      std::printf("     support contact=%.2f h=%.0f hT=%.0f F=%.0fN M=%.0fkg\n",double(contact),double(h*100.f),double(hT*100.f),double(F),double(M));
+#endif
+    }
+#ifdef RAGDOLL_TRACE
+  else if(wR>0.f && std::getenv("TTRACE") && simTime%100<dt)
+    std::printf("     support contact=%.2f rise=%.2f\n",double(contact),double(rise));
+#endif
+#ifdef RAGDOLL_TRACE
+  // TONLY=spine,head,thigh,calf,upperarm,forearm: цели только у этих частей
+  if(const char* only = std::getenv("TONLY"))
+    for(size_t i=0; i<drive.size(); ++i)
+      if(std::string(only).find(kindName(lay->parts[i].kind))==std::string::npos &&
+         std::string(only).find("p"+std::to_string(i)+",")==std::string::npos)
+        drive[i].hasOverride = false;
+  // TTRACE=1: агония по ходу - подъём, веса, высоты таза, груди, головы, локтей; сгиб позвоночника
+  if(std::getenv("TTRACE") && simTime%100<dt) {
+    float flex = 0;
+    for(auto& j:joint)
+      if(lay->parts[j.child].kind==K_Spine)
+        flex += float(eulerOf(jointRel(j,body[j.parent].rb->getWorldTransform().getRotation(),body[j.child].rb->getWorldTransform().getRotation())).z());
+    auto hy = [&](size_t i) { return double(body[i].rb->getWorldTransform().getOrigin().y()*100.f); };
+    std::printf("   t=%.2f rise=%.2f wR=%.2f wC=%.2f g=%.2f pel=%.0f chest=%.0f head=%.0f elbL=%.0f elbR=%.0f knee=%.0f/%.0f spineFlex=%.0f front.y=%+.2f\n",
+                double(t),double(rise),double(wR),double(wC),double(g),hy(0),hy(lay->chest),hy(lay->head),
+                double((body[lay->fore[0]].rb->getWorldTransform()*pivotOf(lay->fore[0])).y()*100.f),
+                double((body[lay->fore[1]].rb->getWorldTransform()*pivotOf(lay->fore[1])).y()*100.f),
+                double((body[lay->calf[0]].rb->getWorldTransform()*pivotOf(lay->calf[0])).y()*100.f),
+                double((body[lay->calf[1]].rb->getWorldTransform()*pivotOf(lay->calf[1])).y()*100.f),
+                double(flex*57.3f),double(cf.y));
+    }
+#endif
+  }
