@@ -0,0 +1,77 @@
+#include "applink.h"
+
+#include <Tempest/Log>
+
+#include <atomic>
+
+#ifdef __ANDROID__
+#include <jni.h>
+#include <pthread.h>
+#endif
+
+namespace {
+  std::atomic_bool editRequest{false};
+#ifdef __ANDROID__
+  JavaVM*   jvm      = nullptr;
+  jclass    jcls     = nullptr;
+  jmethodID openMenu = nullptr;
+  // Поток, подключённый к Java, обязан отключиться перед концом - иначе ART роняет процесс (как в AiLink)
+  pthread_key_t  detachKey;
+  pthread_once_t detachOnce = PTHREAD_ONCE_INIT;
+
+  void detachThread(void*) {
+    if(jvm!=nullptr)
+      jvm->DetachCurrentThread();
+    }
+
+  void makeDetachKey() {
+    pthread_key_create(&detachKey,detachThread);
+    }
+
+  JNIEnv* attach() {
+    if(jvm==nullptr)
+      return nullptr;
+    JNIEnv* env = nullptr;
+    if(jvm->GetEnv(reinterpret_cast<void**>(&env),JNI_VERSION_1_6)==JNI_OK)
+      return env;
+    if(jvm->AttachCurrentThread(&env,nullptr)!=JNI_OK)
+      return nullptr;
+    pthread_once(&detachOnce,makeDetachKey);
+    pthread_setspecific(detachKey,env);
+    return env;
+    }
+#endif
+  }
+
+void AppLink::openAppMenu() {
+#ifdef __ANDROID__
+  JNIEnv* env = attach();
+  if(env==nullptr || jcls==nullptr || openMenu==nullptr) {
+    Tempest::Log::e("[g2m] app menu: no link to the application");
+    return;
+    }
+  env->CallStaticVoidMethod(jcls,openMenu);
+  if(env->ExceptionCheck())
+    env->ExceptionClear();
+#endif
+  }
+
+bool AppLink::takeEditRequest() {
+  return editRequest.exchange(false);
+  }
+
+#ifdef __ANDROID__
+extern "C" JNIEXPORT void JNICALL Java_gothic2_mobile_og_GameActivity_nativeEditControls(JNIEnv*, jclass) {
+  editRequest = true;
+  }
+
+// Java-методы движка находятся только после System.loadLibrary в GameActivity
+extern "C" JNIEXPORT void JNICALL Java_gothic2_mobile_og_GameActivity_nativeAttachApp(JNIEnv* env, jclass cls) {
+  env->GetJavaVM(&jvm);
+  if(jcls==nullptr)
+    jcls = reinterpret_cast<jclass>(env->NewGlobalRef(cls));
+  openMenu = env->GetStaticMethodID(jcls,"openAppMenu","()V");
+  if(openMenu==nullptr)
+    env->ExceptionClear();
+  }
+#endif
