+bool PlayerControl::drinkPotion(const char* const* names, size_t count) {
+  auto w  = Gothic::inst().world();
+  auto pl = w ? w->player() : nullptr;
+  if(pl==nullptr || pl->isDown())
+    return false;
+  for(size_t i=0; i<count; ++i) {
+    const size_t id = w->script().findSymbolIndex(names[i]);
+    if(id==size_t(-1) || pl->itemCount(id)==0)
+      continue;
+    pl->useItem(id);
+    return true;
+    }
+  return false;
+  }
