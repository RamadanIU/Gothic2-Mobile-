+void AiNpc::sendLore(std::string_view req, std::string_view ref) {
+  // Кто такой житель - из игры самого игрока: темы его диалогов (выбор реплик героя) и его собственные реплики
+  // из библиотеки озвучки (OU), по порядку диалогов. Реплики героя (голос 15) не берутся. Текста игры в
+  // приложении нет - только то, что есть в копии игрока
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"ev","lore");
+  std::string r;
+  for(char c:req)
+    if(std::isalnum(uint8_t(c)) || c=='_')
+      r.push_back(c);
+  put(j,"req",r);
+  Npc* npc = npcByRef(ref);
+  if(npc!=nullptr && npc!=geralt && !npc->isPlayer()) {
+    put(j,"id",npcId(*npc));
+    put(j,"name",fromCp1251(npc->displayName()));
+    put(j,"guild",guildName(int32_t(npc->guild())));
+
+    const int32_t inst = int32_t(npc->handle().symbol_index());
+    std::vector<const zenkit::IInfo*> infos;
+    for(auto& i:owner.dialogsInfo)
+      if(i!=nullptr && i->npc==inst)
+        infos.push_back(i.get());
+    std::stable_sort(infos.begin(),infos.end(),[](auto* a, auto* b){ return a->nr<b->nr; });
+
+    j.Key("topics");
+    j.StartArray();
+    size_t topics = 0;
+    std::vector<std::string> prefix;
+    for(auto* i:infos) {
+      if(!i->description.empty() && topics<20) {
+        std::string t = fromCp1251(i->description);
+        j.String(t.c_str(),rapidjson::SizeType(t.size()));
+        ++topics;
+        }
+      auto* fn = owner.findSymbol(size_t(i->information));
+      if(fn==nullptr)
+        continue;
+      std::string p = upper(fn->name());
+      if(p.size()>5 && p.compare(p.size()-5,5,"_INFO")==0)
+        p.resize(p.size()-5);
+      prefix.push_back(p+"_");
+      }
+    j.EndArray();
+
+    // Реплики: имя блока - <функция диалога>_<голос>_<номер>; голос 15 - герой
+    std::vector<std::vector<std::pair<std::string,std::string>>> byInfo(prefix.size());
+    for(auto& blk:owner.dialogs.blocks) {
+      if(blk==nullptr || blk->name.size()<8)
+        continue;
+      const std::string name = upper(blk->name);
+      if(name.compare(0,4,"DIA_")!=0)
+        continue;
+      for(size_t k=0; k<prefix.size(); ++k) {
+        if(name.compare(0,prefix[k].size(),prefix[k])!=0)
+          continue;
+        const size_t last = name.rfind('_');
+        const size_t prev = last==std::string::npos || last==0 ? std::string::npos : name.rfind('_',last-1);
+        if(prev==std::string::npos || name.compare(prev+1,last-prev-1,"15")==0)
+          break;
+        auto msg = blk->get_message();
+        if(msg!=nullptr && !msg->text.empty())
+          byInfo[k].emplace_back(name,fromCp1251(msg->text));
+        break;
+        }
+      }
+    j.Key("lines");
+    j.StartArray();
+    size_t total = 0;
+    for(auto& lines:byInfo) {
+      std::sort(lines.begin(),lines.end());
+      for(auto& [n,t]:lines) {
+        if(total+t.size()>3000)
+          break;
+        total += t.size();
+        j.String(t.c_str(),rapidjson::SizeType(t.size()));
+        }
+      if(total>=3000)
+        break;
+      }
+    j.EndArray();
+    }
+  j.EndObject();
+  AiLink::send(buf.GetString());
+  }
+
+void AiNpc::sendDescribe(std::string_view req, std::string_view ref, std::string_view viewer) {
+  // Кто говорит - глазами того, к кому обращаются: имя, гильдия, одежда, оружие, здоровье, как слушающий к
+  // нему относится. Для бесед жителей между собой (talk_to_npc): слушающий видит, бандит перед ним или стражник
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"ev","describe");
+  std::string r;
+  for(char c:req)
+    if(std::isalnum(uint8_t(c)) || c=='_')
+      r.push_back(c);
+  put(j,"req",r);
+  Npc* n = npcByRef(ref);
+  Npc* v = npcByRef(viewer);
+  if(n!=nullptr) {
+    put(j,"id",npcId(*n));
+    put(j,"name",fromCp1251(n->displayName()));
+    put(j,"guild",guildName(int32_t(n->guild())));
+    put(j,"female",n->handle().voice==16 || n->handle().voice==17 ? 1 : 0);
+    putLooks(j,*n);
+    const int32_t hmax = std::max(1,n->attribute(ATR_HITPOINTSMAX));
+    put(j,"hp%",int64_t(n->attribute(ATR_HITPOINTS))*100/hmax);
+    if(n==geralt)
+      put(j,"geralt",1);
+    if(owner.isHired(*n))
+      put(j,"party",1);
+    if(v!=nullptr && v!=n) {
+      put(j,"myAtt",attitudeName(owner.personAttitude(*v,*n))); // как слушающий относится к нему
+      putMeters(j,"dist",std::sqrt(v->qDistTo(*n)));
+      }
+    }
+  j.EndObject();
+  AiLink::send(buf.GetString());
+  }
