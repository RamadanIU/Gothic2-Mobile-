+    return TouchAction::None;
+  const bool own = pg.is(&player->inventory());
+  switch(state) {
+    case State::Equip:   return TouchAction::Use;
+    case State::Chest:   return own ? TouchAction::Put  : TouchAction::Take;
+    case State::Ransack: return own ? TouchAction::None : TouchAction::Take;
+    case State::Trade:
+      if(freeTrade) {
+        // Обмен с напарником: деньги не отдаются (его деньги в окне не показаны)
