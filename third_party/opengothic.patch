+void PlayerControl::tickRangedAim(Npc& pl, uint64_t dt) {
+  // Лук и арбалет (game/rangedaim.h): куда целится герой. С автонаведением (настройка, по умолчанию) - в грудь цели в
+  // фокусе; иначе - куда смотрит камера: первое, во что упрётся луч из середины экрана (земля, стена, тело NPC), или
+  // RangedAim::MaxAimDist вперёд. Луч начинается у героя: то, что между камерой и героем, не мешает
+  const bool wasOn = aim.on;
+  aim = AimState();
+  const auto ws = pl.weaponState();
+  auto       w  = Gothic::inst().world();
+  if((ws!=WeaponState::Bow && ws!=WeaponState::CBow) || w==nullptr) {
+    glide = AimGlide();
+    return;
+    }
+  aim.on     = true;
+  aim.from   = pl.mapWeaponBone();
+  aim.spread = pl.rangedSpread();
+  Npc* src = nullptr;
+  if(Gothic::options().aimAssist) {
+    if(auto tg = pl.target(); tg!=nullptr && !tg->isDown()) {
+      aim.locked = true;
+      src        = tg;
+      }
+    }
+
