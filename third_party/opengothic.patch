+Npc* AiNpc::addressee(const Npc& player, Npc* candidate) const {
+  if(!AiLink::enabled())
+    return nullptr;
+  // Gothic II Mobile: живые жители выключены в настройках - «Сказать» только Геральту
+  const bool anyone = AiLink::residents();
+  // Выбранный касанием или тот, на кого смотрит герой: человек в сознании рядом - живой житель
+  if(candidate!=nullptr && (anyone || candidate==geralt) && candidate!=&player && !candidate->isMonster() && !candidate->isDead() &&
+     !candidate->isUnconscious() && player.qDistTo(*candidate)<SayDist*SayDist) {
+    if(candidate!=geralt || !talking)
+      return candidate;
+    }
+  // Мир сменился, а tick ещё не нашёл Геральта заново - указатель от прежнего мира
+  const bool geraltHere = geralt!=nullptr && geraltWorld==Gothic::inst().world() && !talking &&
+                          !geralt->isDead() && !geralt->isUnconscious();
+  if(geraltHere && player.qDistTo(*geralt)<SayDist*SayDist)
+    return geralt;
+  // Никого не выбрал и ни на кого не смотрит (или смотрит на зверя) - сказать вслух ближнему человеку (слышат все
+  // рядом): «Сказать» есть везде, где есть люди, а не только у Геральта
+  auto* w = Gothic::inst().world();
+  if(w==nullptr || !anyone)
+    return nullptr;
+  Npc*  best  = nullptr;
+  float bestD = SayDist*SayDist;
+  w->detectNpc(player.position(),SayDist,[&](Npc& n) {
+    if(&n==&player || n.isPlayer() || n.isMonster() || n.isDown() || isAsleep(n) || (&n==geralt && !geraltHere))
+      return;
+    const float d = player.qDistTo(n);
+    if(d<bestD) {
+      best  = &n;
+      bestD = d;
+      }
+    });
+  return best;
+  }
+
+void AiNpc::listeners(Npc& speaker, const Npc* to, float range, std::vector<Npc*>& out) const {
+  out.clear();
+  auto* w = Gothic::inst().world();
+  if(w==nullptr)
+    return;
+  std::vector<std::pair<float,Npc*>> near;
+  w->detectNpc(speaker.position(),range,[&](Npc& n) {
+    if(&n==&speaker || &n==to || n.isPlayer() || n.isMonster() || n.isDown() || isAsleep(n))
+      return;
+    const float d = speaker.qDistTo(n);
+    if(d<range*range)
+      near.emplace_back(d,&n);
+    });
+  std::sort(near.begin(),near.end(),[](auto& a, auto& b){ return a.first<b.first; });
+  for(size_t i=0; i<near.size() && i<HearMax; ++i)
+    out.push_back(near[i].second);
+  }
+
+int AiNpc::hearersOf(const Npc& player, const Npc* to) const {
+  std::vector<Npc*> l;
+  listeners(const_cast<Npc&>(player),to,HearRange,l);
+  return int(l.size());
+  }
+
+void AiNpc::heroSpeak(Npc& to, bool priv) {
+  auto* w = world();
+  if(w==nullptr || w->player()==nullptr)
+    return;
+  // Слушает: стоящий без дела поворачивается к герою (на ходу, в бою и сидя - как есть)
+  Npc* pl = w->player();
+  if(to.isAiQueueEmpty() && !to.isAttack() && to.interactive()==nullptr && to.bodyStateMasked()==BS_STAND)
+    to.aiPush(AiQueue::aiTurnToNpc(pl));
+  to.aiPush(AiQueue::aiLookAtNpc(pl));
+  // free - без диалога: слова героя и ответ - субтитрами над миром; target - кому (self - Геральт).
+  // private - выбран касанием: слышит только он. Иначе near - кто ещё слышит (в 10 м): приложение отдаёт слова тому,
+  // кого герой назвал по имени («Мика, ...»), а остальные запоминают услышанное
+  rapidjson::StringBuffer buf;
+  JsonOut j(buf);
+  j.StartObject();
+  put(j,"ev","listen");
+  put(j,"free",1);
+  put(j,"target",&to==geralt ? std::string("self") : refOf(to));
+  put(j,"name",fromCp1251(to.displayName()));
+  put(j,"id",npcId(to));
+  if(priv) {
+    put(j,"private",1);
+    } else {
+    std::vector<Npc*> near;
+    listeners(*pl,&to,HearRange,near);
+    j.Key("near");
+    j.StartArray();
+    for(auto* n:near) {
+      j.StartObject();
+      put(j,"ref",n==geralt ? std::string("self") : refOf(*n));
+      put(j,"id",npcId(*n));
+      put(j,"name",fromCp1251(n->displayName()));
+      putMeters(j,"dist",dist(*pl,*n));
+      j.EndObject();
+      }
+    j.EndArray();
+    }
+  j.EndObject();
+  AiLink::send(buf.GetString());
+  }
