+Point TouchInput::wheelCenter() const {
+  // Левее кнопок под правым пальцем: колесо их не закрывает. Колесо камеры - выше, над её кнопкой внизу
+  if(wheel==Wheel::Camera)
+    return Point(w()/2, h()*40/100);
+  return Point(w()*52/100, h()*47/100);
+  }
+
+int TouchInput::wheelRadius() const {
+  if(wheel==Wheel::Camera)
+    return int(std::min(float(h())*0.30f, 130*dp()));
+  return int(std::min(float(h())*0.37f, 150*dp()));
+  }
+
+Point TouchInput::wheelItemPos(size_t i) const {
+  const size_t n = std::max<size_t>(wheelItems.size(),1);
+  // по часовой стрелке от верха
+  const float  a = Pi*0.5f - 2.f*Pi*float(i)/float(n);
+  const float  r = float(wheelRadius())*0.68f;
+  const auto   c = wheelCenter();
+  return Point(c.x+int(r*std::cos(a)), c.y-int(r*std::sin(a)));
+  }
+
+int TouchInput::wheelPickDir(Point dv) const {
+  const float len = std::sqrt(float(dv.x*dv.x+dv.y*dv.y));
+  if(len<28*dp() || wheelItems.empty())
+    return -1;
+  // угол от верха по часовой стрелке
+  float a = std::atan2(float(dv.x), float(-dv.y));
+  if(a<0)
+    a += 2.f*Pi;
+  const float  step = 2.f*Pi/float(wheelItems.size());
+  const size_t id   = size_t(int(std::floor(a/step+0.5f)))%wheelItems.size();
+  return wheelItems[id].enabled ? int(id) : -1;
+  }
+
+int TouchInput::wheelPickAt(Point p) const {
+  const auto  c   = wheelCenter();
+  const auto  dv  = p-c;
+  const float len = std::sqrt(float(dv.x*dv.x+dv.y*dv.y));
+  if(len>float(wheelRadius())*1.15f || len<float(wheelRadius())*0.25f)
+    return -1;
+  return wheelPickDir(dv);
+  }
+
+void TouchInput::openWheel(Wheel wh, int finger) {
+  auto pl = Gothic::inst().player();
+  if(pl==nullptr)
+    return;
+  wheelItems.clear();
+  wheelSel   = -1;
+  wheelOwner = finger;
+  wheel      = wh;
+
+  if(wh==Wheel::Weapon) {
+    const auto ws = pl->weaponState();
+    auto&      in = pl->inventory();
+    WheelItem melee;
+    melee.action = 1;
+    if(auto it = pl->currentMeleeWeapon()) {
+      melee.icon  = TouchIcons::I_Sword;
+      melee.label = std::string(it->displayName());
+      } else {
+      melee.icon  = TouchIcons::I_Fist;
+      melee.label = toCp1251("Кулаки");
+      }
+    melee.current = (ws==WeaponState::Fist || ws==WeaponState::W1H || ws==WeaponState::W2H);
+    wheelItems.push_back(melee);
 
-  p.setBrush(Color(1,1,1, 0.2f));
-  p.drawRect(10, h()-10 - 100, 100, 100);
+    if(auto it = pl->currentRangedWeapon()) {
+      WheelItem rng;
+      rng.action  = 2;
+      rng.icon    = it->isCrossbow() ? TouchIcons::I_Crossbow : TouchIcons::I_Bow;
+      rng.label   = std::string(it->displayName());
+      rng.current = (ws==WeaponState::Bow || ws==WeaponState::CBow);
+      wheelItems.push_back(rng);
+      }
+    for(uint8_t i=0; i<8; ++i) {
+      auto spl = in.currentSpell(i);
+      if(spl==nullptr)
+        continue;
+      WheelItem sp;
+      sp.action  = uint8_t(3+i);
+      sp.icon    = spl->isRune() ? TouchIcons::I_Rune : TouchIcons::I_Scroll;
+      sp.label   = std::string(spl->displayName());
+      sp.current = (ws==WeaponState::Mage && in.currentSpellSlot()==3+i);
+      wheelItems.push_back(sp);
+      }
+    if(ws!=WeaponState::NoWeapon) {
+      WheelItem off;
+      off.action = 0;
+      off.icon   = TouchIcons::I_Hand;
+      off.label  = toCp1251("Убрать");
+      wheelItems.push_back(off);
+      }
+    }
+  else if(wh==Wheel::Camera) {
+    // Ракурсы камеры в пути
+    const auto cur = owner.touchTravelCamera().mode();
+    for(uint8_t i=0; i<TravelCamera::M_Count; ++i) {
+      WheelItem it;
+      it.action  = i;
+      it.icon    = cameraIcon(TravelCamera::Mode(i));
+      it.label   = toCp1251(TravelCamera::name(TravelCamera::Mode(i)));
+      it.current = (i==cur);
+      wheelItems.push_back(it);
+      }
+    }
+  else if(wh==Wheel::Squad) {
+    auto w = Gothic::inst().world();
+    bool waiting = !squad.empty(), passive = false;
+    for(auto npc:squad) {
+      waiting = waiting && w->script().squadIsWaiting(*npc);
+      passive = passive || w->script().isPassive(*npc);
+      }
+    WheelItem fl;
+    fl.action  = uint8_t(GameScript::SquadOrder::Follow);
+    fl.icon    = TouchIcons::I_Follow;
+    fl.label   = toCp1251("Ко мне");
+    fl.current = !waiting;
+    wheelItems.push_back(fl);
+
+    WheelItem at;
+    at.action  = uint8_t(GameScript::SquadOrder::Attack);
+    at.icon    = TouchIcons::I_Target;
+    auto tg    = squadTarget();
+    at.enabled = tg!=nullptr;
+    at.label   = tg!=nullptr ? toCp1251("Атаковать: ") + std::string(tg->displayName()) : toCp1251("Нет цели");
+    wheelItems.push_back(at);
+
+    WheelItem st;
+    st.action = uint8_t(passive ? GameScript::SquadOrder::Defend : GameScript::SquadOrder::Passive);
+    st.icon   = passive ? TouchIcons::I_Shield : TouchIcons::I_Passive;
+    st.label  = toCp1251(passive ? "Защищать" : "Не нападать");
+    wheelItems.push_back(st);
