+// Луч ro + rd*t (rd - единичный) и капсула pa-pb радиуса r: расстояние до входа, <0 - мимо (Inigo Quilez, capIntersect)
+float rayCapsule(const Vec3& ro, const Vec3& rd, const Vec3& pa, const Vec3& pb, float r) {
+  if(pointSegmentDistance(ro,pa,pb)<=r)
+    return 0.f; // начало внутри
+  const Vec3  ba   = pb-pa;
+  const Vec3  oa   = ro-pa;
+  const float baba = Vec3::dotProduct(ba,ba);
+  const float bard = Vec3::dotProduct(ba,rd);
+  const float baoa = Vec3::dotProduct(ba,oa);
+  const float rdoa = Vec3::dotProduct(rd,oa);
+  const float oaoa = Vec3::dotProduct(oa,oa);
+  const float a    = baba - bard*bard;
+  const float b    = baba*rdoa - baoa*bard;
+  const float c    = baba*oaoa - baoa*baoa - r*r*baba;
+  float       y    = baoa<=0.f ? -1.f : baba+1.f; // луч вдоль оси - сразу в полусферы
+  if(a>1e-6f) {
+    const float h = b*b - a*c;
+    if(h<0.f)
+      return -1.f;
+    const float t = (-b-std::sqrt(h))/a;
+    y = baoa + t*bard;
+    if(y>0.f && y<baba)
+      return t;
+    }
+  // полусферы на концах
+  const Vec3  oc = (y<=0.f) ? oa : ro-pb;
+  const float bc = Vec3::dotProduct(rd,oc);
+  const float cc = Vec3::dotProduct(oc,oc) - r*r;
+  const float hc = bc*bc - cc;
+  if(hc<0.f)
+    return -1.f;
+  return -bc - std::sqrt(hc);
+  }
+
+}
+
+bool Ragdoll::hasLayout(const Skeleton& sk) {
+  return layoutOf(sk)!=nullptr;
+  }
+
+bool Ragdoll::rayTest(const Skeleton& sk, const Matrix4x4* bones, size_t count, const Vec3& a, const Vec3& b, RayHit& hit) {
+  auto lay = layoutOf(sk);
+  if(lay==nullptr || bones==nullptr)
+    return false;
+  const Vec3  ab  = b-a;
+  const float len = ab.length();
+  if(len<1e-3f)
+    return false;
+  const Vec3 rd = ab/len;
+  // по кости, без одежды и доспехов (bare): попадание - чуть шире (2,5 см). Капсулы физики у людей толще (по
+  // одежде) - круг прицела подобран под эти: попадания стрел не меняются
+  const float pad  = 2.5f;
+  float       best = len;
+  size_t      part = size_t(-1);
+  for(size_t i=0; i<lay->parts.size(); ++i) {
+    auto& p = lay->parts[i];
+    if(p.bone>=count)
+      continue;
+    const Matrix4x4 m  = bones[p.bone]*p.bodyInBone;
+    const Vec3      c  = originOf(m);
+    const float     hl = p.halfLen + p.radius - p.bare;
+    const Vec3      ax = Vec3::normalize(axisOf(m,0))*hl;
+    const float     t  = rayCapsule(a, rd, c-ax, c+ax, p.bare+pad);
+    if(t>=0.f && t<best) {
+      best = t;
+      part = i;
+      }
+    }
+  if(part==size_t(-1))
+    return false;
+  const auto& p = lay->parts[part];
+  hit.t    = best/len;
+  hit.at   = a + rd*best;
+  hit.bone = p.bone;
+  switch(Kind(p.kind)) {
+    case K_Head:
+      hit.zone = Z_Head;
+      break;
+    case K_Thigh:
+    case K_Calf:
+    case K_Foot:
+      hit.zone = Z_Legs;
+      break;
+    case K_UpperArm:
+    case K_ForeArm:
+    case K_Hand:
+      // у людей и человекоподобных - руки, у зверей - передние лапы
+      hit.zone = lay->humanoid ? Z_Arms : Z_Legs;
+      break;
+    default:
+      hit.zone = Z_Body;
+      break;
+    }
+  return true;
+  }
