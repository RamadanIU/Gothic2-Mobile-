<?xml version="1.0" encoding="utf-8"?>
<!-- Заголовок раздела настроек: золотая капитель и линия, гаснущая вправо. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingTop="8dp"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="4dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alegreya_sc_bold"
        android:letterSpacing="0.1"
        android:shadowColor="#D0000000"
        android:shadowDy="1.5"
        android:shadowRadius="4"
        android:textAlignment="viewStart"
        android:textColor="@color/gothic_gold"
        android:textSize="17sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/gothic_category_rule" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gothic_ash"
        android:visibility="gone" />
</LinearLayout>
