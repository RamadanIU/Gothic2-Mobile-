<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Экраны вне игры: тёмная кожа, золото, пергамент; шрифт Alegreya. -->
    <style name="Base.Theme.Gothic2" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/gothic_bronze</item>
        <item name="colorPrimaryDark">@color/gothic_ink</item>
        <item name="colorAccent">@color/gothic_gold</item>
        <item name="colorControlNormal">@color/gothic_bronze</item>
        <item name="colorControlActivated">@color/gothic_gold</item>
        <item name="colorControlHighlight">@color/gothic_highlight</item>
        <item name="colorButtonNormal">@color/gothic_leather</item>
        <item name="android:colorBackground">@color/gothic_ink</item>
        <item name="android:windowBackground">@color/gothic_ink</item>
        <item name="android:statusBarColor">@color/gothic_ink</item>
        <item name="android:navigationBarColor">@color/gothic_ink</item>
        <item name="android:textColorPrimary">@color/gothic_parchment</item>
        <item name="android:textColorSecondary">@color/gothic_ash</item>
        <item name="android:textColorHint">@color/gothic_ash</item>
        <item name="android:fontFamily">@font/gothic_text</item>
        <item name="fontFamily">@font/gothic_text</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Gothic2.ListItem</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextAppearance.Gothic2.ListItemSecondary</item>
        <item name="android:listDivider">@drawable/gothic_divider</item>
        <item name="preferenceTheme">@style/PreferenceTheme.Gothic2</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Gothic2.Dialog</item>
    </style>

    <!-- Заставка Android 12+ задаётся в values-v31. -->
    <style name="Theme.Gothic2" parent="Base.Theme.Gothic2" />

    <!--
        Экран игры наследует тему Winlator (её атрибуты нужны X-серверу и его окнам), но с нашими
        цветами и шрифтом. GameActivity подменяет ею тему, которую ставит Winlator.
    -->
    <style name="Theme.Gothic2.Game" parent="AppThemeDark">
        <item name="colorPrimary">@color/gothic_bronze</item>
        <item name="colorPrimaryDark">@color/gothic_ink</item>
        <item name="colorAccent">@color/gothic_gold</item>
        <item name="colorControlNormal">@color/gothic_bronze</item>
        <item name="colorControlActivated">@color/gothic_gold</item>
        <item name="android:colorBackground">@color/gothic_ink</item>
        <item name="android:windowBackground">@color/gothic_ink</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/gothic_text</item>
        <item name="fontFamily">@font/gothic_text</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Gothic2.Dialog</item>
    </style>

    <!-- Системные диалоги, если где-то останутся: та же кожа и золото. -->
    <style name="ThemeOverlay.Gothic2.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/gothic_dialog_background</item>
        <item name="colorAccent">@color/gothic_gold</item>
        <item name="android:textColorPrimary">@color/gothic_parchment</item>
        <item name="android:textColorSecondary">@color/gothic_ash</item>
        <item name="android:fontFamily">@font/gothic_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Gothic2.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Gothic2.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Gothic2.DialogButton</item>
    </style>

    <style name="Widget.Gothic2.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:fontFamily">@font/alegreya_sc_medium</item>
        <item name="android:textColor">@color/gothic_gold_light</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Заголовки разделов — своя разметка (layout/gothic_preference_category). -->
    <style name="PreferenceTheme.Gothic2" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextColor">@color/gothic_gold</item>
    </style>

    <!--
        Шрифт темы (android:fontFamily) перекрывает шрифт из textAppearance, поэтому здесь —
        только насыщенность: 500 из того же семейства gothic_text — Alegreya Medium.
    -->
    <style name="TextAppearance.Gothic2.ListItem" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gothic_parchment</item>
    </style>

    <style name="TextAppearance.Gothic2.ListItemSecondary" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gothic_ash</item>
    </style>
</resources>
