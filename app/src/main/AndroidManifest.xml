<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Доступ к файлам: игра запускается прямо из папки игрока (Wine работает с путями, а не с
         content://). При targetSdk 28 это обычное разрешение «Файлы», как у Winlator; без него
         игру можно только скопировать в приложение через системный выбор папки. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.distinct" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:name=".GothicApplication"
        android:allowBackup="false"
        android:icon="@mipmap/gothic_icon"
        android:roundIcon="@mipmap/gothic_icon_round"
        android:label="@string/game_title"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Gothic2">

        <activity
            android:name=".ui.LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Gothic2.Game" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.LicensesActivity"
            android:exported="false"
            android:label="@string/licenses_title"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
